def counted_lmove(+db: R.Db, +s: String, +dk: String, +e: R.LEnds) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.db.lmove(db, s, dk, e))) == True{} : Bool}:
  counted_mv_of(R.db.ent(db, s), KV.str_eq(s, dk), R.mv.dst.ent(R.ends.fresh(e), R.db.ent(db, dk)), e, s, dk, db)({==})({==})({==})

# every command keeps a database counted
def counted_exec(c: R.Cmd, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.exec(c, db))) == True{} : Bool}:
  match c:
    case R.Ping{}:
      ok => ok
    case R.Echo{m}:
      ok => ok
    case R.Get{k}:
      ok => ok
    case R.Set{+k, +v}:
      counted_set(db, k, v)
    case R.Del{ks}:
      counted_del(db, ks)
    case R.Exists{ks}:
      ok => ok
    case R.IncrBy{+k, +by}:
      counted_incr(db, k, by)
    case R.MGet{ks}:
      ok => ok
    case R.MSet{ps}:
      counted_mset(ps, db)
    case R.DbSize{}:
      ok => ok
    case R.FlushDb{}:
      ok => counted_flush(db)
    case R.Keys{p}:
      ok => ok
    case R.Sort{k, o}:
      ok => ok
    case R.Scan{a}:
      ok => ok
    case R.Peek{k, o}:
      ok => ok
    case R.Upd{+k, +op}:
      counted_upd_db(db, k, op)
    case R.MSetNx{+ps}:
      counted_msetnx_of(R.pairs.live(ps, R.db.now(db), R.db.trie(db)), ps, db)
    case R.Rename{+src, +dst, +nx}:
      counted_rename(db, src, dst, nx)
    case R.BitOp{+op, +d, +srcs}:
      counted_bitop_do(R.bitop.wrong(srcs, R.db.now(db), R.db.trie(db)), op, d, srcs, db)
    case R.Own{o}:
      ok => ok
    case R.Bad{r}:
      ok => ok
    case R.LMove{+s, +dk, +e}:
      counted_lmove(db, s, dk, e)
    case R.LMPop{+ks, +left, +c}:
      counted_lmpop_at(R.lmpop.first(ks, R.lmpop.head(ks, db), db), left, c, db)
    case R.SOp{op, ks}:
      ok => ok
    case R.SStore{+op, +d, +ks}:
      counted_sstore_do(R.sets.at(ks, R.db.now(db), R.db.trie(db)), op, ks, d, db)
    case R.SMv{+s, +d, +w}:
      counted_smove_do(R.smv.of(db, s, d, w), s, d, w, db)
    case R.ZOp{op, ks}:
      ok => ok
    case R.ZStore{+op, +d, +ks}:
      counted_zstore_do(R.zsrcs.at(ks, R.db.now(db), R.db.trie(db)), op, d, db)
    case R.ZRangeStore{+d, +s, +q}:
      counted_zrs_of(R.db.read(db, s), q, d, db)
    case R.ZMPop{+ks, +max, +c}:
      counted_zmpop_at(R.lmpop.first(ks, R.lmpop.head(ks, db), db), max, c, db)

# Several databases
# -----------------
# a database, or databases, that may not be there, counted when they are

def counted_mdb(m: Maybe<&2, R.Db>) -> Bool:
  match m:
    case Some{+y}:
      Laws.counted(y)
    case None{}:
      True{}

def counted_or(m: Maybe<&2, R.Ds>) -> Bool:
  match m:
    case Some{+y}:
      Laws.counted_ds(y)
    case None{}:
      True{}

def counted_at(+now: Nat, db: R.Db) -> {Laws.counted(R.db.at(now, db)) == Laws.counted(db) : Bool}:
  match db:
    case R.Db{t, n, x, old, rr}:
      {==}

def counted_rev(pre: List<&2, R.Db>, +acc: List<&2, R.Db>) -> {Laws.counted_list(pre) == True{} : Bool} -> {Laws.counted_list(acc) == True{} : Bool} -> {Laws.counted_list(List.reverse.go(&2, R.Db, pre, acc)) == True{} : Bool}:
  match pre:
    case Nil{}:
      e1 => e2 => e2
    case Con{+x, rest}:
      +e1 => e2 => counted_rev(rest, x <> acc)(and_r(Laws.counted(x), Laws.counted_list(rest))(e1))(and_true(Laws.counted(x), Laws.counted_list(acc))(and_l(Laws.counted(x), Laws.counted_list(rest))(e1))(e2))

def counted_ds_list(ds: R.Ds) -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_list(R.ds.list(ds)) == True{} : Bool}:
  match ds:
    case R.Ds{+d, +pre, +post}:
      +e => counted_rev(pre, d <> post)(and_l(Laws.counted_list(pre), Laws.counted_list(post))(and_r(Laws.counted(d), Bool.and(Laws.counted_list(pre), Laws.counted_list(post)))(e)))(and_true(Laws.counted(d), Laws.counted_list(post))(and_l(Laws.counted(d), Bool.and(Laws.counted_list(pre), Laws.counted_list(post)))(e))(and_r(Laws.counted_list(pre), Laws.counted_list(post))(and_r(Laws.counted(d), Bool.and(Laws.counted_list(pre), Laws.counted_list(post)))(e))))

def counted_pick(j: Nat, +now: Nat, +acc: List<&2, R.Db>, xs: List<&2, R.Db>) -> {Laws.counted_list(acc) == True{} : Bool} -> {Laws.counted_list(xs) == True{} : Bool} -> {counted_or(R.ds.pick(j, now, acc, xs)) == True{} : Bool}:
  match j xs:
    case 0n Con{+x, +rest}:
      ea => +ex => %Equal.sym(Bool, Laws.counted(R.db.at(now, x)), Laws.counted(x), counted_at(now, x)) : {Bool.and(_, Bool.and(Laws.counted_list(acc), Laws.counted_list(rest))) == True{} : Bool}
                   and_true(Laws.counted(x), Bool.and(Laws.counted_list(acc), Laws.counted_list(rest)))(and_l(Laws.counted(x), Laws.counted_list(rest))(ex))(and_true(Laws.counted_list(acc), Laws.counted_list(rest))(ea)(and_r(Laws.counted(x), Laws.counted_list(rest))(ex)))
    case 1n+i Con{+x, +rest}:
      ea => +ex => counted_pick(i, now, x <> acc, rest)(and_true(Laws.counted(x), Laws.counted_list(acc))(and_l(Laws.counted(x), Laws.counted_list(rest))(ex))(ea))(and_r(Laws.counted(x), Laws.counted_list(rest))(ex))
    case 0n Nil{}:
      ea => ex => {==}
    case 1n+i Nil{}:
      ea => ex => {==}

def counted_or_ds(m: Maybe<&2, R.Ds>, ds: R.Ds) -> {counted_or(m) == True{} : Bool} -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds.or(m, ds)) == True{} : Bool}:
  match m:
    case Some{y}:
      e1 => e2 => e1
    case None{}:
      e1 => e2 => e2

def counted_with(+xs: List<&2, R.Db>, +ds: R.Ds) -> {Laws.counted_list(xs) == True{} : Bool} -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds.with(xs, ds)) == True{} : Bool}:
  ex => ed => counted_or_ds(R.ds.pick(R.ds.index(ds), R.ds.now(ds), Nil{}, xs), ds)(counted_pick(R.ds.index(ds), R.ds.now(ds), Nil{}, xs)({==})(ex))(ed)

def counted_dput(j: Nat, +y: R.Db, xs: List<&2, R.Db>) -> {Laws.counted(y) == True{} : Bool} -> {Laws.counted_list(xs) == True{} : Bool} -> {Laws.counted_list(R.ds.put(j, y, xs)) == True{} : Bool}:
  match j xs:
    case 0n Con{x, +rest}:
