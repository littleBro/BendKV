def dst_ent_some(f: Bool, m: Maybe<&2, KV.Item<KV.Val>>, -y: KV.Item<KV.Val>) -> {Some{y} == R.mv.dst.ent(f, m) : Maybe<&2, KV.Item<KV.Val>>} -> {m == Some{y} : Maybe<&2, KV.Item<KV.Val>>}:
  match f:
    case True{}:
      g => Empty.absurd({m == Some{y} : Maybe<&2, KV.Item<KV.Val>>}, some_none(y, g))
    case False{}:
      g => Equal.sym(Maybe<&2, KV.Item<KV.Val>>, Some{y}, m, g)


def counted_mv_of(ms: Maybe<&2, KV.Item<KV.Val>>, same: Bool, md: Maybe<&2, KV.Item<KV.Val>>, +e: R.LEnds, +s: String, +dk: String, +db: R.Db) -> {ms == R.db.ent(db, s) : Maybe<&2, KV.Item<KV.Val>>} -> {same == KV.str_eq(s, dk) : Bool} -> {md == R.mv.dst.ent(R.ends.fresh(e), R.db.ent(db, dk)) : Maybe<&2, KV.Item<KV.Val>>} -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.mv.do(R.mv.of(ms, same, md), e, s, dk, db))) == True{} : Bool}:
  match ms same md:
    case Some{KV.Item{KV.VColl{KV.CList{l}}, +se}} True{} _:
      ems => es => emd => counted_mv_self(KV.deq.pop(R.ends.from(e), l), e, s, db, KV.VColl{KV.CList{l}}, se)(Equal.sym(Maybe<&2, KV.Item<KV.Val>>, Some{KV.Item{KV.VColl{KV.CList{l}}, se}}, R.db.ent(db, s), ems))
    case Some{KV.Item{KV.VColl{KV.CList{+l}}, +se}} False{} None{}:
      ems => es => emd => counted_mv_new(KV.deq.pop(R.ends.from(e), l), e, s, dk, db, KV.VColl{KV.CList{l}}, se)(Equal.sym(Maybe<&2, KV.Item<KV.Val>>, Some{KV.Item{KV.VColl{KV.CList{l}}, se}}, R.db.ent(db, s), ems))
    case Some{KV.Item{KV.VColl{KV.CList{+l}}, +se}} False{} Some{KV.Item{KV.VColl{KV.CList{+dl}}, +de}}:
      ems => es => emd => counted_mv_onto(KV.deq.pop(R.ends.from(e), l), e, s, dk, dl, db, KV.VColl{KV.CList{l}}, se, KV.VColl{KV.CList{dl}}, de)(Equal.sym(Maybe<&2, KV.Item<KV.Val>>, Some{KV.Item{KV.VColl{KV.CList{l}}, se}}, R.db.ent(db, s), ems))(dst_ent_some(R.ends.fresh(e), R.db.ent(db, dk), KV.Item{KV.VColl{KV.CList{dl}}, de})(emd))(ne_sym(s, dk, Equal.sym(Bool, False{}, KV.str_eq(s, dk), es)))
    case Some{KV.Item{KV.VColl{KV.CList{l}}, se}} False{} Some{KV.Item{KV.VColl{KV.CHash{a}}, de}}:
      ems => es => emd => ok => ok
    case Some{KV.Item{KV.VColl{KV.CList{l}}, se}} False{} Some{KV.Item{KV.VColl{KV.CMems{a}}, de}}:
      ems => es => emd => ok => ok
    case Some{KV.Item{KV.VColl{KV.CList{l}}, se}} False{} Some{KV.Item{KV.VColl{KV.CZset{a}}, de}}:
      ems => es => emd => ok => ok
    case Some{KV.Item{KV.VColl{KV.CList{l}}, se}} False{} Some{KV.Item{KV.VColl{KV.CStream{a}}, de}}:
      ems => es => emd => ok => ok
    case Some{KV.Item{KV.VColl{KV.CList{l}}, se}} False{} Some{KV.Item{KV.VStr{a}, de}}:
      ems => es => emd => ok => ok
    case Some{KV.Item{KV.VColl{KV.CHash{a}}, se}} _ _:
      ems => es => emd => ok => ok
    case Some{KV.Item{KV.VColl{KV.CMems{a}}, se}} _ _:
      ems => es => emd => ok => ok
    case Some{KV.Item{KV.VColl{KV.CZset{a}}, se}} _ _:
      ems => es => emd => ok => ok
    case Some{KV.Item{KV.VColl{KV.CStream{a}}, se}} _ _:
