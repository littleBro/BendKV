def incr_missing_db(+db: R.Db, +k: String) -> {Laws.there(db, k) == None{} : Maybe<&2, KV.Item<KV.Val>>} -> {Laws.at_key(R.exec(R.IncrBy{k, R.ByPos{0n, 1n}}, db), k) == (R.RIntS{"1"}, Some{KV.Item{KV.VStr{"1"}, 0n}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}:
