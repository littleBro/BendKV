def dels_put(r: R.Dels, +c: Nat, +now: Nat, +n: Nat, +x: Nat, -rr: Maybe<&2, R.Db>) -> {Laws.counted(R.db_of(R.del.db(r, Nat.sub(n, dead(Laws.WAll{}, c)), Nat.sub(x, dead(Laws.WTimed{}, c)), now, rr))) == True{} : Bool} -> {Laws.counted(R.db_of(R.del.db(R.del_keys.put(c, now, r), n, x, now, rr))) == True{} : Bool}:
