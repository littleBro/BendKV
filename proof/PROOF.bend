# and the trie tnode_if makes of it
def tnode_if_read(-V: Data, +p: Nat, z: Bool, t: KV.Trie<V>, x: KV.Hex, +h: U32) -> {KV.tget_h(V, 1n+p, t, x, h) == KV.tget_h(V, 1n+p, KV.tnode_if(V, z, t), x, h) : KV.Trie<V>}:
  match z:
    case True{}:
      tnode_read(V, p, t, x, h)
    case False{}:
      {==}

