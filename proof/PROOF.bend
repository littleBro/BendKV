def counted_copy_if(ok: Bool, m: Maybe<&2, KV.Item<KV.Val>>, +dst: String, +j: Nat, +y: R.Db, +ds: R.Ds) -> {Laws.counted(y) == True{} : Bool} -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds_of(R.act.moved(R.ds.copy.if(ok, m, dst, j, y, ds)))) == True{} : Bool}:
