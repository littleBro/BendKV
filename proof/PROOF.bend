def counted_moved(+k: String, +j: Nat, +y: R.Db, +ds: R.Ds) -> {Laws.counted(y) == True{} : Bool} -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds.moved(k, j, y, ds)) == True{} : Bool}:
