# the rest of the batch answers alike on both sides
def rep_run(+c1: R.Cmd, +c2: R.Cmd, +db: KV.Trie<KV.Val>, +now: Nat, +e: {Laws.clash(c2, c1) == False{} : Bool}, cs: List<&2, R.Cmd>, +H: List<&2, R.Cmd>) -> {Laws.keywise_all(cs) == True{} : Bool} -> {t_rfst(t_run(cs, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), now)) == t_rfst(t_run(cs, tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), now)) : List<&2, R.Reply>}:
  match cs:
    case Nil{}:
      kw => {==}
    case Con{+c, +rest}:
      +kw =>
        %t_eta_l(t_run(rest, tw(Con{c, H}, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), now)) : {t_rfst(T.exec_all.cons(T.reply_of(T.exec(c, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), now)), _)) == t_rfst(t_run(Con{c, rest}, tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), now)) : List<&2, R.Reply>}
        %t_eta_l(t_run(rest, tw(Con{c, H}, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), now)) : {T.reply_of(T.exec(c, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), now)) <> t_rfst(t_run(rest, tw(Con{c, H}, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), now)) == t_rfst(T.exec_all.cons(T.reply_of(T.exec(c, tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), now)), _)) : List<&2, R.Reply>}
        %rep_tw(c1, c2, db, H, now, e, c)(and_l(Laws.keywise(c), Laws.keywise_all(rest))(kw)) : {T.reply_of(T.exec(c, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), now)) <> t_rfst(t_run(rest, tw(Con{c, H}, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), now)) == _ <> t_rfst(t_run(rest, tw(Con{c, H}, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), now)) : List<&2, R.Reply>}
        Equal.cong(List<&2, R.Reply>, List<&2, R.Reply>, z => T.reply_of(T.exec(c, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), now)) <> z, t_rfst(t_run(rest, tw(Con{c, H}, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), now)), t_rfst(t_run(rest, tw(Con{c, H}, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), now)), rep_run(c1, c2, db, now, e, rest, Con{c, H})(and_r(Laws.keywise(c), Laws.keywise_all(rest))(kw)))

# the trie after a run of cs after H on d
def tw_rev(cs: List<&2, R.Cmd>, +H: List<&2, R.Cmd>, +d: KV.Trie<KV.Val>, +now: Nat) -> {t_rsnd(t_run(cs, tw(H, d, now), now)) == tw(List.reverse.go(&2, R.Cmd, cs, H), d, now) : KV.Trie<KV.Val>}:
  match cs:
    case Nil{}:
      {==}
    case Con{+c, +rest}:
      %t_eta_l(t_run(rest, T.db_of(T.exec(c, tw(H, d, now), now)), now)) : {t_rsnd(T.exec_all.cons(T.reply_of(T.exec(c, tw(H, d, now), now)), _)) == tw(List.reverse.go(&2, R.Cmd, rest, Con{c, H}), d, now) : KV.Trie<KV.Val>}
      tw_rev(rest, Con{c, H}, d, now)

def t_swap_reads(+c1: R.Cmd, +c2: R.Cmd, +cs: List<&2, R.Cmd>, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, e: {Laws.clash(c2, c1) == False{} : Bool}) -> {KV.entry(KV.Val, T.final(T.exec_all(Con{c2, Con{c1, cs}}, db, now)), j) == KV.entry(KV.Val, T.final(T.exec_all(Con{c1, Con{c2, cs}}, db, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  %t_exec_all_run(Con{c2, Con{c1, cs}}, db, now) : {KV.entry(KV.Val, T.final(_), j) == KV.entry(KV.Val, T.final(T.exec_all(Con{c1, Con{c2, cs}}, db, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
  %t_exec_all_run(Con{c1, Con{c2, cs}}, db, now) : {KV.entry(KV.Val, T.final(t_run(Con{c2, Con{c1, cs}}, db, now)), j) == KV.entry(KV.Val, T.final(_), j) : Maybe<&2, KV.Item<KV.Val>>}
  %t_eta_l(t_run(cs, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now)) : {KV.entry(KV.Val, T.final(T.exec_all.cons(T.reply_of(T.exec(c2, db, now)), T.exec_all.cons(T.reply_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), _))), j) == KV.entry(KV.Val, T.final(t_run(Con{c1, Con{c2, cs}}, db, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
  %t_eta_l(t_run(cs, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now)) : {KV.entry(KV.Val, t_rsnd(t_run(cs, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now)), j) == KV.entry(KV.Val, T.final(T.exec_all.cons(T.reply_of(T.exec(c1, db, now)), T.exec_all.cons(T.reply_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), _))), j) : Maybe<&2, KV.Item<KV.Val>>}
  %Equal.sym(KV.Trie<KV.Val>, t_rsnd(t_run(cs, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now)), tw(List.reverse.go(&2, R.Cmd, cs, Nil{}), T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), tw_rev(cs, Nil{}, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now)) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, t_rsnd(t_run(cs, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now)), j) : Maybe<&2, KV.Item<KV.Val>>}
  %Equal.sym(KV.Trie<KV.Val>, t_rsnd(t_run(cs, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now)), tw(List.reverse.go(&2, R.Cmd, cs, Nil{}), T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), tw_rev(cs, Nil{}, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now)) : {KV.entry(KV.Val, tw(List.reverse.go(&2, R.Cmd, cs, Nil{}), T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), j) == KV.entry(KV.Val, _, j) : Maybe<&2, KV.Item<KV.Val>>}
  Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, tw(List.reverse.go(&2, R.Cmd, cs, Nil{}), T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), j), KV.entry(KV.Val, tw(List.reverse.go(&2, R.Cmd, cs, Nil{}), T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), j), eq_at(c1, c2, db, List.reverse.go(&2, R.Cmd, cs, Nil{}), j, now, e))

# The server's database
# =====================
# The server runs its commands on a database record (R.Db): the trie, the
# counts of its keys and of those with a time, the time now, and a field
# no command changes. Each command answers as the spec's exec on the trie
# alone at that now answers (SPEC.bend, whose laws the sections above
# prove), DBSIZE but, which answers the count, leaves the trie the spec's
# leaves, and leaves the time as it was (the bridge). The laws of the
# server's exec follow: those about replies or about what keys hold
# through the bridge, those about the whole database directly.

# a reply and a database, as a reply and its trie
def proj(p: R.Reply & R.Db) -> R.Reply & KV.Trie<KV.Val>:
  (y, d) = p
  (y, R.db.t(d))

def proj_db(p: R.Reply & R.Db) -> {T.db_of(proj(p)) == R.db.t(R.db_of(p)) : KV.Trie<KV.Val>}:
  (y, d) = p
  {==}

def proj_rep(p: R.Reply & R.Db) -> {T.reply_of(proj(p)) == R.reply_of(p) : R.Reply}:
  (y, d) = p
  {==}

# The bridge
# ----------
# A command that reads its key before it writes it goes on by what it
# read, as the spec's does: each step, whatever it read, answers and
# leaves the trie as the spec's step, and keeps the time.

def del_br(r: R.Dels, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.del.db(r, n, x, now, rr)) == T.del_reply(r) : R.Reply & KV.Trie<KV.Val>}:
  match r:
    case R.Dels{live, gone, gonex, t}:
      {==}

def incr_fit_br(+t: KV.Trie<KV.Val>, +k: String, +h: U32, s: R.LL, +keep: Bool, +m: Nat, +n: Nat, +y: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.incr.fit(t, k, h, s, keep, m, n, y, x, now, rr)) == T.incr.fit(t, k, h, s, keep) : R.Reply & KV.Trie<KV.Val>}:
  match s:
    case R.LL{+neg, +hi, +lo}:
      {==}
    case R.LLBad{}:
      {==}

def incr_num_br(+t: KV.Trie<KV.Val>, +k: String, +h: U32, +by: R.By, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, cur: R.LL) -> {proj(R.incr.num(t, k, h, by, n, x, now, rr, cur)) == T.incr.num(t, k, h, by, cur) : R.Reply & KV.Trie<KV.Val>}:
  match cur:
    case R.LL{+neg, +hi, +lo}:
      incr_fit_br(t, k, h, R.ll.add(neg, hi, lo, by), True{}, n, n, x, x, now, rr)
    case R.LLBad{}:
      {==}

def incr_br(+t: KV.Trie<KV.Val>, +k: String, +h: U32, +by: R.By, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, old: KV.Got) -> {proj(R.incr.got(t, k, h, by, n, x, now, rr, old)) == T.incr.got(t, k, h, by, old) : R.Reply & KV.Trie<KV.Val>}:
  match old:
    case KV.GStr{+s}:
      incr_num_br(t, k, h, by, n, x, now, rr, R.ll.read(s))
    case KV.GColl{}:
      {==}
    case KV.GNone{}:
      incr_fit_br(t, k, h, R.by.ll(by), False{}, R.cnt.n(KV.code.at(KV.Val, t, k, h), n), n, R.cnt.x(KV.code.at(KV.Val, t, k, h), 0n, x), x, now, rr)

def mset_br(ps: List<&2, R.KVPair>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.t(R.mset_pairs(ps, R.Db{t, n, x, now, rr})) == T.mset_pairs(ps, t) : KV.Trie<KV.Val>}:
  match ps:
    case Nil{}:
      {==}
    case Con{R.KP{+k, +v}, +rest}:
      mset_br(rest, KV.set(KV.Val, t, k, KV.VStr{v}), R.cnt.n(KV.code.at(KV.Val, t, k, KV.hash(k)), n), R.cnt.x(KV.code.at(KV.Val, t, k, KV.hash(k)), 0n, x), now, rr)

def upd_ch_br(+t: KV.Trie<KV.Val>, +k: String, +h: U32, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +c: Nat, r: R.Reply, ch: R.Change) -> {proj(R.upd.ch(t, k, h, n, x, now, rr, c, r, ch)) == T.upd.ch(t, k, h, r, ch) : R.Reply & KV.Trie<KV.Val>}:
  match ch:
    case R.CKeep{}:
      {==}
    case R.CDel{}:
      {==}
    case R.CExp{e}:
      {==}
    case R.CPut{v, e}:
      {==}
    case R.CKeepT{v}:
      {==}
    case R.CApp{a, v}:
      {==}
    case R.CRange{o, a, v}:
      {==}
    case R.CHash{op, hv}:
      {==}
    case R.CHashNew{ps, hv}:
      {==}
    case R.CList{op, hv}:
      {==}
    case R.CListNew{lf, ps, hv}:
      {==}
    case R.CMems{op, sv}:
      {==}
    case R.CMemsNew{ms, sv}:
      {==}
    case R.CZset{op, z}:
      {==}
    case R.CZsetNew{o, ps, z}:
      {==}
    case R.CRestore{p, v, e}:
      {==}

# an update's change
def ch_of(o: R.Out) -> R.Change:
  match o:
    case R.Out{r, ch}:
      ch

# The take of an update (R.db.upd.go, A.run.upd.go): an update that takes
# its key's value out of the keyspace keeps a hole in its place before
# its change (KV.keep.at), and a change that writes the value over,
# keeping or setting it (ch_over), writes the same trie over the hole
# as over the value: a write after a keep of the same key is as the
# write alone (keep_keep, setx_keep).
def keep_keep(-V: Data, +t: KV.Trie<V>, +k: String, +w0: V, +w: V, +h: U32) -> {KV.keep.at(V, KV.keep.at(V, t, k, w0, h), k, w, h) == KV.keep.at(V, t, k, w, h) : KV.Trie<V>}:
  tmod_twice(V, 5n, t, KV.hex(h), h, KV.OKeep{k, w0}, KV.OKeep{k, w}, b => bkeep2(V, k, w0, w, b))

def setx_keep(-V: Data, +t: KV.Trie<V>, +k: String, +w0: V, +w: V, +e: Nat, +h: U32) -> {KV.setx.at(V, KV.keep.at(V, t, k, w0, h), k, w, e, h) == KV.setx.at(V, t, k, w, e, h) : KV.Trie<V>}:
  tmod_twice(V, 5n, t, KV.hex(h), h, KV.OKeep{k, w0}, KV.OSet{k, w, e}, b => bset_bkeep(V, k, w0, w, e, b))

# whether a change writes its key's value over
def ch_over(ch: R.Change) -> Bool:
  match ch:
    case R.CKeep{}:
      False{}
    case R.CDel{}:
      False{}
    case R.CExp{e}:
      False{}
    case R.CPut{v, e}:
      True{}
    case R.CKeepT{v}:
      True{}
    case R.CApp{s, v}:
      True{}
    case R.CRange{o, s, v}:
      True{}
    case R.CHash{op, hv}:
      True{}
    case R.CHashNew{ps, hv}:
      True{}
    case R.CList{op, lv}:
      True{}
    case R.CListNew{left, xs, lv}:
      True{}
    case R.CMems{op, sv}:
      True{}
    case R.CMemsNew{ms, sv}:
      True{}
    case R.CZset{op, zv}:
      True{}
    case R.CZsetNew{o, ps, zv}:
      True{}
    case R.CRestore{p, v, e}:
      True{}

def upd_ch_take(+t: KV.Trie<KV.Val>, +k: String, +h: U32, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +c: Nat, r: R.Reply, ch: R.Change, +w: KV.Val) -> {ch_over(ch) == True{} : Bool} -> {R.upd.ch(KV.keep.at(KV.Val, t, k, w, h), k, h, n, x, now, rr, c, r, ch) == R.upd.ch(t, k, h, n, x, now, rr, c, r, ch) : R.Reply & R.Db}:
  match ch:
    case R.CKeep{}:
      g => Empty.absurd({R.upd.ch(KV.keep.at(KV.Val, t, k, w, h), k, h, n, x, now, rr, c, r, R.CKeep{}) == R.upd.ch(t, k, h, n, x, now, rr, c, r, R.CKeep{}) : R.Reply & R.Db}, false_true(g))
    case R.CDel{}:
      g => Empty.absurd({R.upd.ch(KV.keep.at(KV.Val, t, k, w, h), k, h, n, x, now, rr, c, r, R.CDel{}) == R.upd.ch(t, k, h, n, x, now, rr, c, r, R.CDel{}) : R.Reply & R.Db}, false_true(g))
    case R.CExp{e}:
      g => Empty.absurd({R.upd.ch(KV.keep.at(KV.Val, t, k, w, h), k, h, n, x, now, rr, c, r, R.CExp{e}) == R.upd.ch(t, k, h, n, x, now, rr, c, r, R.CExp{e}) : R.Reply & R.Db}, false_true(g))
    case R.CPut{v, e}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, R.cnt.n(c, n), R.cnt.x(c, e, x), now, rr}), KV.setx.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VStr{v}, e, h), KV.setx.at(KV.Val, t, k, KV.VStr{v}, e, h), setx_keep(KV.Val, t, k, w, KV.VStr{v}, e, h))
    case R.CKeepT{v}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, R.cnt.n(c, n), x, now, rr}), KV.keep.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VStr{v}, h), KV.keep.at(KV.Val, t, k, KV.VStr{v}, h), keep_keep(KV.Val, t, k, w, KV.VStr{v}, h))
    case R.CApp{s, v}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, R.cnt.n(c, n), x, now, rr}), KV.keep.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VStr{v}, h), KV.keep.at(KV.Val, t, k, KV.VStr{v}, h), keep_keep(KV.Val, t, k, w, KV.VStr{v}, h))
    case R.CRange{o, s, v}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, R.cnt.n(c, n), x, now, rr}), KV.keep.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VStr{v}, h), KV.keep.at(KV.Val, t, k, KV.VStr{v}, h), keep_keep(KV.Val, t, k, w, KV.VStr{v}, h))
    case R.CHash{op, hv}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, n, x, now, rr}), KV.keep.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VColl{KV.CHash{hv}}, h), KV.keep.at(KV.Val, t, k, KV.VColl{KV.CHash{hv}}, h), keep_keep(KV.Val, t, k, w, KV.VColl{KV.CHash{hv}}, h))
    case R.CHashNew{ps, hv}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, R.cnt.n(c, n), R.cnt.x(c, 0n, x), now, rr}), KV.setx.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VColl{KV.CHash{hv}}, 0n, h), KV.setx.at(KV.Val, t, k, KV.VColl{KV.CHash{hv}}, 0n, h), setx_keep(KV.Val, t, k, w, KV.VColl{KV.CHash{hv}}, 0n, h))
    case R.CList{op, lv}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, n, x, now, rr}), KV.keep.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VColl{KV.CList{lv}}, h), KV.keep.at(KV.Val, t, k, KV.VColl{KV.CList{lv}}, h), keep_keep(KV.Val, t, k, w, KV.VColl{KV.CList{lv}}, h))
    case R.CListNew{left, xs, lv}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, R.cnt.n(c, n), R.cnt.x(c, 0n, x), now, rr}), KV.setx.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VColl{KV.CList{lv}}, 0n, h), KV.setx.at(KV.Val, t, k, KV.VColl{KV.CList{lv}}, 0n, h), setx_keep(KV.Val, t, k, w, KV.VColl{KV.CList{lv}}, 0n, h))
    case R.CMems{op, sv}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, n, x, now, rr}), KV.keep.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VColl{KV.CMems{sv}}, h), KV.keep.at(KV.Val, t, k, KV.VColl{KV.CMems{sv}}, h), keep_keep(KV.Val, t, k, w, KV.VColl{KV.CMems{sv}}, h))
    case R.CMemsNew{ms, sv}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, R.cnt.n(c, n), R.cnt.x(c, 0n, x), now, rr}), KV.setx.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VColl{KV.CMems{sv}}, 0n, h), KV.setx.at(KV.Val, t, k, KV.VColl{KV.CMems{sv}}, 0n, h), setx_keep(KV.Val, t, k, w, KV.VColl{KV.CMems{sv}}, 0n, h))
    case R.CZset{op, zv}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, n, x, now, rr}), KV.keep.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VColl{KV.CZset{zv}}, h), KV.keep.at(KV.Val, t, k, KV.VColl{KV.CZset{zv}}, h), keep_keep(KV.Val, t, k, w, KV.VColl{KV.CZset{zv}}, h))
    case R.CZsetNew{o, ps, zv}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, R.cnt.n(c, n), R.cnt.x(c, 0n, x), now, rr}), KV.setx.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, KV.VColl{KV.CZset{zv}}, 0n, h), KV.setx.at(KV.Val, t, k, KV.VColl{KV.CZset{zv}}, 0n, h), setx_keep(KV.Val, t, k, w, KV.VColl{KV.CZset{zv}}, 0n, h))
    case R.CRestore{p, v, e}:
      g => Equal.cong(KV.Trie<KV.Val>, R.Reply & R.Db, z => (r, R.Db{z, R.cnt.n(c, n), R.cnt.x(c, e, x), now, rr}), KV.setx.at(KV.Val, KV.keep.at(KV.Val, t, k, w, h), k, v, e, h), KV.setx.at(KV.Val, t, k, v, e, h), setx_keep(KV.Val, t, k, w, v, e, h))

def upd_put_take(+t: KV.Trie<KV.Val>, +k: String, +h: U32, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +c: Nat, o: R.Out, +w: KV.Val) -> {ch_over(ch_of(o)) == True{} : Bool} -> {R.upd.put(KV.keep.at(KV.Val, t, k, w, h), k, h, n, x, now, rr, c, o) == R.upd.put(t, k, h, n, x, now, rr, c, o) : R.Reply & R.Db}:
  match o:
    case R.Out{r, ch}:
      g => upd_ch_take(t, k, h, n, x, now, rr, c, r, ch, w)(g)

# an HSET of pairs to a hash writes the hash over
def hset_over(r: R.HPut, -p: KV.HPair, -rest: List<&2, KV.HPair>, -mset: Bool) -> {ch_over(ch_of(R.hset.out(r, False{}, Con{p, rest}, mset))) == True{} : Bool}:
  match r:
    case R.HPut{h, made}:
      {==}

# an update that takes its key's value out writes the value over
def takes_coll(cl: KV.Coll, -e: Nat, +p: KV.HPair, +rest: List<&2, KV.HPair>, +mset: Bool, +now: Nat) -> {R.upd.takes(R.UHash{R.HWSet{Con{p, rest}, mset}}, Some{KV.Item{KV.VColl{cl}, e}}) == True{} : Bool} -> {ch_over(ch_of(R.upd.v(R.UHash{R.HWSet{Con{p, rest}, mset}}, now, Some{KV.Item{KV.VColl{cl}, e}}))) == True{} : Bool}:
  match cl:
    case KV.CHash{h}:
      g => hset_over(R.hset.go(Con{p, rest}, R.HPut{h, 0n}), p, rest, mset)
    case KV.CList{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWSet{Con{p, rest}, mset}}, now, Some{KV.Item{KV.VColl{KV.CList{a}}, e}}))) == True{} : Bool}, false_true(g))
    case KV.CMems{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWSet{Con{p, rest}, mset}}, now, Some{KV.Item{KV.VColl{KV.CMems{a}}, e}}))) == True{} : Bool}, false_true(g))
    case KV.CZset{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWSet{Con{p, rest}, mset}}, now, Some{KV.Item{KV.VColl{KV.CZset{a}}, e}}))) == True{} : Bool}, false_true(g))
    case KV.CStream{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWSet{Con{p, rest}, mset}}, now, Some{KV.Item{KV.VColl{KV.CStream{a}}, e}}))) == True{} : Bool}, false_true(g))

def takes_set(+p: KV.HPair, +rest: List<&2, KV.HPair>, +mset: Bool, lm: Maybe<&2, KV.Item<KV.Val>>, +now: Nat) -> {R.upd.takes(R.UHash{R.HWSet{Con{p, rest}, mset}}, lm) == True{} : Bool} -> {ch_over(ch_of(R.upd.v(R.UHash{R.HWSet{Con{p, rest}, mset}}, now, lm))) == True{} : Bool}:
  match lm:
    case Some{KV.Item{KV.VColl{cl}, e}}:
      takes_coll(cl, e, p, rest, mset, now)
    case Some{KV.Item{KV.VStr{s}, e}}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWSet{Con{p, rest}, mset}}, now, Some{KV.Item{KV.VStr{s}, e}}))) == True{} : Bool}, false_true(g))
    case None{}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWSet{Con{p, rest}, mset}}, now, None{}))) == True{} : Bool}, false_true(g))

def takes_hash(hop: R.HWrite, lm: Maybe<&2, KV.Item<KV.Val>>, +now: Nat) -> {R.upd.takes(R.UHash{hop}, lm) == True{} : Bool} -> {ch_over(ch_of(R.upd.v(R.UHash{hop}, now, lm))) == True{} : Bool}:
  match hop:
    case R.HWSet{Con{p, rest}, mset}:
      takes_set(p, rest, mset, lm, now)
    case R.HWSet{Nil{}, mset}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWSet{Nil{}, mset}}, now, lm))) == True{} : Bool}, false_true(g))
    case R.HWSetNx{a, b}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWSetNx{a, b}}, now, lm))) == True{} : Bool}, false_true(g))
    case R.HWDel{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWDel{a}}, now, lm))) == True{} : Bool}, false_true(g))
    case R.HWIncr{a, b}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWIncr{a, b}}, now, lm))) == True{} : Bool}, false_true(g))
    case R.HWNew{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWNew{a}}, now, lm))) == True{} : Bool}, false_true(g))
    case R.HWIncrF{a, b}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHash{R.HWIncrF{a, b}}, now, lm))) == True{} : Bool}, false_true(g))

# a <= b
def le(a: Nat, b: Nat) -> Bool:
  match a b:
    case 0n _:
      True{}
    case 1n+p 0n:
      False{}
    case 1n+p 1n+q:
      le(p, q)

def le_succ(a: Nat, b: Nat) -> {le(a, b) == True{} : Bool} -> {le(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n _:
      e => {==}
    case 1n+p 0n:
      e => Empty.absurd({le(1n+p, 1n) == True{} : Bool}, false_true(e))
    case 1n+p 1n+q:
      e => le_succ(p, q)(e)

def le_refl(n: Nat) -> {le(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      le_refl(p)

# An SADD to a set that lacks its first member writes the set over
# (takes_mems, for takes_over): the members added to a set leave it no
# smaller (le_add_mem, len_adds_ge), a member it lacks makes it one
# larger (le_big_new, le_ints_new), and a size one or more larger, less
# the old size, is not 0 (sub_pos), so SADD adds one or more.
def le_ints_putm(fits: Bool, +m: Nat, +n: Nat, -xs: KV.ITree, -y: String) -> {le(m, n) == True{} : Bool} -> {le(m, KV.mems.len(KV.mems.ints.put(fits, n, xs, y))) == True{} : Bool}:
  match fits:
    case True{}:
      e => le_succ(m, n)(e)
    case False{}:
      e => le_succ(m, n)(e)

def le_ints_more(int: Bool, +m: Nat, +n: Nat, -xs: KV.ITree, -y: String) -> {le(m, n) == True{} : Bool} -> {le(m, KV.mems.len(KV.mems.ints.add(False{}, int, n, xs, y))) == True{} : Bool}:
  match int:
    case True{}:
      e => le_ints_putm(Nat.is_lt(n, 512n), m, n, xs, y)(e)
    case False{}:
      e => le_succ(m, n)(e)

def le_ints_add(had: Bool, int: Bool, +m: Nat, +n: Nat, -xs: KV.ITree, -y: String) -> {le(m, n) == True{} : Bool} -> {le(m, KV.mems.len(KV.mems.ints.add(had, int, n, xs, y))) == True{} : Bool}:
  match had:
    case True{}:
      e => e
    case False{}:
      e => le_ints_more(int, m, n, xs, y)(e)

def le_big_add(had: Bool, +m: Nat, +n: Nat, -t: KV.Trie<Unit>, -y: String) -> {le(m, n) == True{} : Bool} -> {le(m, KV.mems.len(KV.mems.big.add(had, n, t, y))) == True{} : Bool}:
  match had:
    case True{}:
      e => e
    case False{}:
      e => le_succ(m, n)(e)

def le_add_mem(s: KV.Mems, +m: Nat, +y: String) -> {le(m, KV.mems.len(s)) == True{} : Bool} -> {le(m, KV.mems.len(KV.mems.add(s, y))) == True{} : Bool}:
  match s:
    case KV.MInts{+n, +xs}:
      le_ints_add(KV.mems.ints.has(KV.ints.ok(y), y, xs), KV.ints.ok(y), m, n, xs, y)
    case KV.MBig{+n, +t}:
      le_big_add(KV.has(Unit, t, y), m, n, t, y)

def len_adds_ge(xs: List<&2, String>, +s: KV.Mems, +m: Nat) -> {le(m, KV.mems.len(s)) == True{} : Bool} -> {le(m, KV.mems.len(KV.mems.adds(xs, s))) == True{} : Bool}:
  match xs:
    case Nil{}:
      e => e
    case Con{+x, rest}:
      e => len_adds_ge(rest, KV.mems.add(s, x), m)(le_add_mem(s, m, x)(e))

def le_big_new(had: Bool, +n: Nat, -t: KV.Trie<Unit>, -y: String) -> {Bool.not(had) == True{} : Bool} -> {le(1n+n, KV.mems.len(KV.mems.big.add(had, n, t, y))) == True{} : Bool}:
  match had:
    case True{}:
      e => Empty.absurd({le(1n+n, KV.mems.len(KV.mems.big.add(True{}, n, t, y))) == True{} : Bool}, false_true(e))
    case False{}:
      e => le_refl(n)

def le_ints_putn(fits: Bool, +n: Nat, -xs: KV.ITree, -y: String) -> {le(1n+n, KV.mems.len(KV.mems.ints.put(fits, n, xs, y))) == True{} : Bool}:
  match fits:
    case True{}:
      le_refl(n)
    case False{}:
      le_refl(n)

def le_ints_new(had: Bool, int: Bool, +n: Nat, -xs: KV.ITree, -y: String) -> {Bool.not(had) == True{} : Bool} -> {le(1n+n, KV.mems.len(KV.mems.ints.add(had, int, n, xs, y))) == True{} : Bool}:
  match had int:
    case True{} _:
      e => Empty.absurd({le(1n+n, KV.mems.len(KV.mems.ints.add(True{}, int, n, xs, y))) == True{} : Bool}, false_true(e))
    case False{} True{}:
      e => le_ints_putn(Nat.is_lt(n, 512n), n, xs, y)
    case False{} False{}:
      e => le_refl(n)

def sub_pos(a: Nat, b: Nat) -> {le(1n+b, a) == True{} : Bool} -> {Nat.is_eq(Nat.sub(a, b), 0n) == False{} : Bool}:
  match a b:
    case 0n _:
      e => Empty.absurd({Nat.is_eq(Nat.sub(0n, b), 0n) == False{} : Bool}, false_true(e))
    case 1n+p 0n:
      e => {==}
    case 1n+p 1n+q:
      e => sub_pos(p, q)(e)

def sadd_adds(+x: String, +rest: List<&2, String>, +n: Nat, +t: KV.Trie<Unit>) -> {Bool.not(KV.has(Unit, t, x)) == True{} : Bool} -> {Nat.is_eq(Nat.sub(KV.mems.len(KV.mems.adds(rest, KV.mems.add(KV.MBig{n, t}, x))), n), 0n) == False{} : Bool}:
  g => sub_pos(KV.mems.len(KV.mems.adds(rest, KV.mems.add(KV.MBig{n, t}, x))), n)(len_adds_ge(rest, KV.mems.add(KV.MBig{n, t}, x), 1n+n)(le_big_new(KV.has(Unit, t, x), n, t, x)(g)))

def sadd_adds_ints(+x: String, +rest: List<&2, String>, +n: Nat, +xs: KV.ITree) -> {Bool.not(KV.mems.ints.has(KV.ints.ok(x), x, xs)) == True{} : Bool} -> {Nat.is_eq(Nat.sub(KV.mems.len(KV.mems.adds(rest, KV.mems.add(KV.MInts{n, xs}, x))), n), 0n) == False{} : Bool}:
  g => sub_pos(KV.mems.len(KV.mems.adds(rest, KV.mems.add(KV.MInts{n, xs}, x))), n)(len_adds_ge(rest, KV.mems.add(KV.MInts{n, xs}, x), 1n+n)(le_ints_new(KV.mems.ints.has(KV.ints.ok(x), x, xs), KV.ints.ok(x), n, xs, x)(g)))

def sadd_of_over(b: Bool, +ms: List<&2, String>, -t: KV.Mems, -added: Nat) -> {b == False{} : Bool} -> {ch_over(ch_of(R.sadd.of(b, False{}, ms, t, added))) == True{} : Bool}:
  match b:
    case True{}:
      e => Empty.absurd({ch_over(ch_of(R.sadd.of(True{}, False{}, ms, t, added))) == True{} : Bool}, true_false(e))
    case False{}:
      e => {==}

def takes_madd(+x: String, +rest: List<&2, String>, +n: Nat, +t: KV.Trie<Unit>, -e: Nat, +now: Nat) -> {R.upd.takes(R.UMems{R.SWAdd{Con{x, rest}}}, Some{KV.Item{KV.VColl{KV.CMems{KV.MBig{n, t}}}, e}}) == True{} : Bool} -> {ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Con{x, rest}}}, now, Some{KV.Item{KV.VColl{KV.CMems{KV.MBig{n, t}}}, e}}))) == True{} : Bool}:
  g => sadd_of_over(Nat.is_eq(Nat.sub(KV.mems.len(KV.mems.adds(rest, KV.mems.add(KV.MBig{n, t}, x))), n), 0n), Con{x, rest}, KV.mems.adds(rest, KV.mems.add(KV.MBig{n, t}, x)), Nat.sub(KV.mems.len(KV.mems.adds(rest, KV.mems.add(KV.MBig{n, t}, x))), n))(sadd_adds(x, rest, n, t)(g))

def takes_madd_ints(+x: String, +rest: List<&2, String>, +n: Nat, +xs: KV.ITree, -e: Nat, +now: Nat) -> {R.upd.takes(R.UMems{R.SWAdd{Con{x, rest}}}, Some{KV.Item{KV.VColl{KV.CMems{KV.MInts{n, xs}}}, e}}) == True{} : Bool} -> {ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Con{x, rest}}}, now, Some{KV.Item{KV.VColl{KV.CMems{KV.MInts{n, xs}}}, e}}))) == True{} : Bool}:
  g => sadd_of_over(Nat.is_eq(Nat.sub(KV.mems.len(KV.mems.adds(rest, KV.mems.add(KV.MInts{n, xs}, x))), n), 0n), Con{x, rest}, KV.mems.adds(rest, KV.mems.add(KV.MInts{n, xs}, x)), Nat.sub(KV.mems.len(KV.mems.adds(rest, KV.mems.add(KV.MInts{n, xs}, x))), n))(sadd_adds_ints(x, rest, n, xs)(g))

def takes_madd_s(s: KV.Mems, -e: Nat, +x: String, +rest: List<&2, String>, +now: Nat) -> {R.upd.takes(R.UMems{R.SWAdd{Con{x, rest}}}, Some{KV.Item{KV.VColl{KV.CMems{s}}, e}}) == True{} : Bool} -> {ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Con{x, rest}}}, now, Some{KV.Item{KV.VColl{KV.CMems{s}}, e}}))) == True{} : Bool}:
  match s:
    case KV.MBig{n, t}:
      takes_madd(x, rest, n, t, e, now)
    case KV.MInts{n, xs}:
      takes_madd_ints(x, rest, n, xs, e, now)

def takes_madd_c(cl: KV.Coll, -e: Nat, +x: String, +rest: List<&2, String>, +now: Nat) -> {R.upd.takes(R.UMems{R.SWAdd{Con{x, rest}}}, Some{KV.Item{KV.VColl{cl}, e}}) == True{} : Bool} -> {ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Con{x, rest}}}, now, Some{KV.Item{KV.VColl{cl}, e}}))) == True{} : Bool}:
  match cl:
    case KV.CMems{s}:
      takes_madd_s(s, e, x, rest, now)
    case KV.CHash{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Con{x, rest}}}, now, Some{KV.Item{KV.VColl{KV.CHash{a}}, e}}))) == True{} : Bool}, false_true(g))
    case KV.CList{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Con{x, rest}}}, now, Some{KV.Item{KV.VColl{KV.CList{a}}, e}}))) == True{} : Bool}, false_true(g))
    case KV.CZset{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Con{x, rest}}}, now, Some{KV.Item{KV.VColl{KV.CZset{a}}, e}}))) == True{} : Bool}, false_true(g))
    case KV.CStream{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Con{x, rest}}}, now, Some{KV.Item{KV.VColl{KV.CStream{a}}, e}}))) == True{} : Bool}, false_true(g))

def takes_madd_m(+x: String, +rest: List<&2, String>, lm: Maybe<&2, KV.Item<KV.Val>>, +now: Nat) -> {R.upd.takes(R.UMems{R.SWAdd{Con{x, rest}}}, lm) == True{} : Bool} -> {ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Con{x, rest}}}, now, lm))) == True{} : Bool}:
  match lm:
    case Some{KV.Item{KV.VColl{cl}, e}}:
      takes_madd_c(cl, e, x, rest, now)
    case Some{KV.Item{KV.VStr{w}, e}}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Con{x, rest}}}, now, Some{KV.Item{KV.VStr{w}, e}}))) == True{} : Bool}, false_true(g))
    case None{}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Con{x, rest}}}, now, None{}))) == True{} : Bool}, false_true(g))

def takes_mems(sop: R.SWrite, lm: Maybe<&2, KV.Item<KV.Val>>, +now: Nat) -> {R.upd.takes(R.UMems{sop}, lm) == True{} : Bool} -> {ch_over(ch_of(R.upd.v(R.UMems{sop}, now, lm))) == True{} : Bool}:
  match sop:
    case R.SWAdd{Con{x, rest}}:
      takes_madd_m(x, rest, lm, now)
    case R.SWAdd{Nil{}}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UMems{R.SWAdd{Nil{}}}, now, lm))) == True{} : Bool}, false_true(g))
    case R.SWRem{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UMems{R.SWRem{a}}, now, lm))) == True{} : Bool}, false_true(g))
    case R.SWNew{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UMems{R.SWNew{a}}, now, lm))) == True{} : Bool}, false_true(g))
    case R.SWPop{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UMems{R.SWPop{a}}, now, lm))) == True{} : Bool}, false_true(g))
    case R.SWPopN{a, b}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UMems{R.SWPopN{a, b}}, now, lm))) == True{} : Bool}, false_true(g))

def takes_over(op: R.UpdOp, lm: Maybe<&2, KV.Item<KV.Val>>, +now: Nat) -> {R.upd.takes(op, lm) == True{} : Bool} -> {ch_over(ch_of(R.upd.v(op, now, lm))) == True{} : Bool}:
  match op:
    case R.UHash{hop}:
      takes_hash(hop, lm, now)
    case R.USetNx{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.USetNx{a}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UGet{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UGet{a}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UAppend{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UAppend{a}, now, lm))) == True{} : Bool}, false_true(g))
    case R.USet{a, b, d, f}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.USet{a, b, d, f}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UGetEx{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UGetEx{a}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UGetDel{}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UGetDel{}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UExpire{a, b, d}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UExpire{a, b, d}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UPersist{}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UPersist{}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UIncr{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UIncr{a}, now, lm))) == True{} : Bool}, false_true(g))
    case R.URange{a, b}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.URange{a, b}, now, lm))) == True{} : Bool}, false_true(g))
    case R.USetBit{a, b}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.USetBit{a, b}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UBitfield{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UBitfield{a}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UList{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UList{a}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UMems{sop}:
      takes_mems(sop, lm, now)
    case R.UIncrF{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UIncrF{a}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UZset{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UZset{a}, now, lm))) == True{} : Bool}, false_true(g))
    case R.UHll{a}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.UHll{a}, now, lm))) == True{} : Bool}, false_true(g))
    case R.URestore{a, b, c, d}:
      g => Empty.absurd({ch_over(ch_of(R.upd.v(R.URestore{a, b, c, d}, now, lm))) == True{} : Bool}, false_true(g))

# an update reads as its change made where its key's entry lies, the
# key's value taken out of the keyspace or not
def db_upd_go(b: Bool, +t: KV.Trie<KV.Val>, +k: String, +h: U32, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +op: R.UpdOp, +c: Nat, +lm: Maybe<&2, KV.Item<KV.Val>>) -> {b == R.upd.takes(op, lm) : Bool} -> {R.db.upd.go(b, t, k, h, n, x, now, rr, op, c, lm) == R.upd.put(t, k, h, n, x, now, rr, c, R.upd.v(op, now, lm)) : R.Reply & R.Db}:
  match b:
    case True{}:
      g => upd_put_take(t, k, h, n, x, now, rr, c, R.upd.v(op, now, lm), R.upd.hole())(takes_over(op, lm, now)(Equal.sym(Bool, True{}, R.upd.takes(op, lm), g)))
    case False{}:
      g => {==}

def db_upd_unfold(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +op: R.UpdOp) -> {R.db.upd(R.Db{t, n, x, now, rr}, k, op) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))) : R.Reply & R.Db}:
  db_upd_go(R.upd.takes(op, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))), t, k, KV.hash(k), n, x, now, rr, op, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))({==})

# and so does an update run with its effects
def run_upd_go(b: Bool, +t: KV.Trie<KV.Val>, +k: String, +h: U32, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +op: R.UpdOp, +c: Nat, +lm: Maybe<&2, KV.Item<KV.Val>>) -> {b == R.upd.takes(op, lm) : Bool} -> {A.run.upd.go(b, t, k, h, n, x, now, rr, op, c, lm) == A.run.out(R.upd.put(t, k, h, n, x, now, rr, c, R.upd.v(op, now, lm)), A.upd.effect(k, c, R.upd.v(op, now, lm))) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match b:
    case True{}:
      g => Equal.cong(R.Reply & R.Db, R.Reply & (List<&2, R.Cmd> & R.Db), z => A.run.out(z, A.upd.effect(k, c, R.upd.v(op, now, lm))), R.upd.put(KV.keep.at(KV.Val, t, k, R.upd.hole(), h), k, h, n, x, now, rr, c, R.upd.v(op, now, lm)), R.upd.put(t, k, h, n, x, now, rr, c, R.upd.v(op, now, lm)), upd_put_take(t, k, h, n, x, now, rr, c, R.upd.v(op, now, lm), R.upd.hole())(takes_over(op, lm, now)(Equal.sym(Bool, True{}, R.upd.takes(op, lm), g))))
    case False{}:
      g => {==}

def run_upd_unfold(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +op: R.UpdOp) -> {A.run.upd(R.Db{t, n, x, now, rr}, k, op) == A.run.out(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))), A.upd.effect(k, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))))) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  run_upd_go(R.upd.takes(op, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))), t, k, KV.hash(k), n, x, now, rr, op, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))({==})

# A.run.upd as the change made where the key's entry lies, the other way
def run_upd_eq(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +op: R.UpdOp) -> {A.run.out(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))), A.upd.effect(k, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))))) == A.run.upd(R.Db{t, n, x, now, rr}, k, op) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  Equal.sym(R.Reply & (List<&2, R.Cmd> & R.Db), A.run.upd(R.Db{t, n, x, now, rr}, k, op), A.run.out(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))), A.upd.effect(k, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))))), run_upd_unfold(t, k, n, x, now, rr, op))

def upd_br(+t: KV.Trie<KV.Val>, +k: String, +h: U32, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +c: Nat, o: R.Out) -> {proj(R.upd.put(t, k, h, n, x, now, rr, c, o)) == T.upd.put(t, k, h, o) : R.Reply & KV.Trie<KV.Val>}:
  match o:
    case R.Out{r, ch}:
      upd_ch_br(t, k, h, n, x, now, rr, c, r, ch)

# R.db.upd as the change made where the key's entry lies, the other way
def db_upd_eq(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +op: R.UpdOp) -> {R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))) == R.db.upd(R.Db{t, n, x, now, rr}, k, op) : R.Reply & R.Db}:
  Equal.sym(R.Reply & R.Db, R.db.upd(R.Db{t, n, x, now, rr}, k, op), R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))), db_upd_unfold(t, k, n, x, now, rr, op))

# an update's bridge to the spec (upd_br) through db_upd_unfold
def upd_db_br(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +op: R.UpdOp) -> {proj(R.db.upd(R.Db{t, n, x, now, rr}, k, op)) == T.upd.run(t, k, op, now) : R.Reply & KV.Trie<KV.Val>}:
  %db_upd_eq(t, k, n, x, now, rr, op) : {proj(_) == T.upd.run(t, k, op, now) : R.Reply & KV.Trie<KV.Val>}
  upd_br(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))))

# MSETNX and RENAME, for a given verdict, as the spec's
def msetnx_br(b: Bool, ps: List<&2, R.KVPair>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.msetnx.of(b, ps, R.Db{t, n, x, now, rr})) == T.msetnx(b, ps, t) : R.Reply & KV.Trie<KV.Val>}:
  match b:
    case True{}:
      {==}
    case False{}:
      Equal.cong(KV.Trie<KV.Val>, R.Reply & KV.Trie<KV.Val>, z => (R.r_int(1n), z), R.db.t(R.mset_pairs(ps, R.Db{t, n, x, now, rr})), T.mset_pairs(ps, t), mset_br(ps, t, n, x, now, rr))

def ren_br(r: R.Ren, +nx: Bool, +s: String, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.ren.do(r, nx, s, d, R.Db{t, n, x, now, rr})) == T.ren(r, nx, s, d, t) : R.Reply & KV.Trie<KV.Val>}:
  match r:
    case R.RnNone{}:
      {==}
    case R.RnSame{}:
      {==}
    case R.RnHeld{}:
      {==}
    case R.RnMove{v, e}:
      {==}

# BITOP's write on the record leaves the spec's trie
def bitop_br.t(e: Bool, +v: String, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.t(R.bitop.db(e, v, d, R.Db{t, n, x, now, rr})) == T.bitop.t(e, v, d, t) : KV.Trie<KV.Val>}:
  match e:
    case True{}:
      {==}
    case False{}:
      {==}

def bitop_br(+v: String, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj((R.r_int(String.length(v)), R.bitop.db(String.is_empty(v), v, d, R.Db{t, n, x, now, rr}))) == T.bitop(v, d, t) : R.Reply & KV.Trie<KV.Val>}:
  Equal.cong(KV.Trie<KV.Val>, R.Reply & KV.Trie<KV.Val>, z => (R.r_int(String.length(v)), z), R.db.t(R.bitop.db(String.is_empty(v), v, d, R.Db{t, n, x, now, rr})), T.bitop.t(String.is_empty(v), v, d, t), bitop_br.t(String.is_empty(v), v, d, t, n, x, now, rr))

def bitop_do_br(w: Bool, +op: R.BitK, +d: String, +srcs: List<&2, String>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.bitop.do(w, op, d, srcs, R.Db{t, n, x, now, rr})) == T.bitop.go(w, op, srcs, d, t, now) : R.Reply & KV.Trie<KV.Val>}:
  match w:
    case True{}:
      {==}
    case False{}:
      bitop_br(R.bitop.val(op, srcs, now, t), d, t, n, x, now, rr)

# LMOVE on the record, for a given verdict, as the spec's: the record's
# trie after each of its writes is the spec's
def keepl_t(d: R.Db, +k: String, +l: KV.Deq) -> {R.db.t(R.db.keepl(d, k, l)) == KV.keep(KV.Val, R.db.t(d), k, KV.VColl{KV.CList{l}}) : KV.Trie<KV.Val>}:
  match d:
    case R.Db{t, n, x, now, rr}:
      {==}

def newl_t(d: R.Db, +k: String, +l: KV.Deq) -> {R.db.t(R.db.newl(d, k, l)) == KV.setx(KV.Val, R.db.t(d), k, KV.VColl{KV.CList{l}}, 0n) : KV.Trie<KV.Val>}:
  match d:
    case R.Db{t, n, x, now, rr}:
      {==}

def deldb_t(r: R.Dels, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.t(R.db_of(R.del.db(r, n, x, now, rr))) == dels_t(r) : KV.Trie<KV.Val>}:
  match r:
    case R.Dels{l, g, y, t}:
      {==}

def del1_t(d: R.Db, +k: String) -> {R.db.t(R.db_of(R.db.del(d, [k]))) == KV.del(KV.Val, R.db.t(d), k) : KV.Trie<KV.Val>}:
  match d:
    case R.Db{+t, +n, +x, +now, +rr}:
      Equal.trans(KV.Trie<KV.Val>, R.db.t(R.db_of(R.del.db(R.del_keys([k], now, t), n, x, now, rr))), dels_t(R.del_keys([k], now, t)), KV.del(KV.Val, t, k),
        deldb_t(R.del_keys([k], now, t), n, x, now, rr),
        del_keys_t([k], now, t))

def mv_src_br(b: Bool, +k: String, +l: KV.Deq, +d: R.Db) -> {R.db.t(R.mv.src(b, k, l, d)) == T.mv.src(b, k, l, R.db.t(d)) : KV.Trie<KV.Val>}:
  match b:
    case True{}:
      del1_t(d, k)
    case False{}:
      keepl_t(d, k, l)

def mv_put_br(+s: String, +l: KV.Deq, +d: R.Db) -> {R.db.t(R.mv.put(s, l, d)) == T.mv.put(s, l, R.db.t(d)) : KV.Trie<KV.Val>}:
  mv_src_br(Nat.is_eq(KV.deq.len(l), 0n), s, l, d)

def mv_self_br(p: KV.Pop, +e: R.LEnds, +s: String, +d: R.Db) -> {proj(R.mv.self(p, e, s, d)) == T.mv.self(p, e, s, R.db.t(d)) : R.Reply & KV.Trie<KV.Val>}:
  match p:
    case KV.Pop{+x, +l}:
      Equal.cong(KV.Trie<KV.Val>, R.Reply & KV.Trie<KV.Val>, z => (R.RBulk{x}, z), R.db.t(R.db.keepl(d, s, KV.deq.push(R.ends.to(e), x, l))), KV.keep(KV.Val, R.db.t(d), s, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, l)}}), keepl_t(d, s, KV.deq.push(R.ends.to(e), x, l)))
    case KV.PopNone{}:
      {==}

def mv_go_br(p: KV.Pop, +e: R.LEnds, +s: String, +t: String, dl: Maybe<&2, KV.Deq>, +d: R.Db) -> {proj(R.mv.go(p, e, s, t, dl, d)) == T.mv.go(p, e, s, t, dl, R.db.t(d)) : R.Reply & KV.Trie<KV.Val>}:
  match p dl:
    case KV.Pop{+x, +l} Some{+q}:
      Equal.cong(KV.Trie<KV.Val>, R.Reply & KV.Trie<KV.Val>, z => (R.RBulk{x}, z), R.db.t(R.db.keepl(R.mv.put(s, l, d), t, KV.deq.push(R.ends.to(e), x, q))), KV.keep(KV.Val, T.mv.put(s, l, R.db.t(d)), t, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, q)}}),
        Equal.trans(KV.Trie<KV.Val>, R.db.t(R.db.keepl(R.mv.put(s, l, d), t, KV.deq.push(R.ends.to(e), x, q))), KV.keep(KV.Val, R.db.t(R.mv.put(s, l, d)), t, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, q)}}), KV.keep(KV.Val, T.mv.put(s, l, R.db.t(d)), t, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, q)}}),
          keepl_t(R.mv.put(s, l, d), t, KV.deq.push(R.ends.to(e), x, q)),
          Equal.cong(KV.Trie<KV.Val>, KV.Trie<KV.Val>, z => KV.keep(KV.Val, z, t, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, q)}}), R.db.t(R.mv.put(s, l, d)), T.mv.put(s, l, R.db.t(d)), mv_put_br(s, l, d))))
    case KV.Pop{+x, +l} None{}:
      Equal.cong(KV.Trie<KV.Val>, R.Reply & KV.Trie<KV.Val>, z => (R.RBulk{x}, z), R.db.t(R.db.newl(R.mv.put(s, l, d), t, KV.deq.push(R.ends.to(e), x, KV.deq.empty()))), KV.setx(KV.Val, T.mv.put(s, l, R.db.t(d)), t, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, KV.deq.empty())}}, 0n),
        Equal.trans(KV.Trie<KV.Val>, R.db.t(R.db.newl(R.mv.put(s, l, d), t, KV.deq.push(R.ends.to(e), x, KV.deq.empty()))), KV.setx(KV.Val, R.db.t(R.mv.put(s, l, d)), t, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, KV.deq.empty())}}, 0n), KV.setx(KV.Val, T.mv.put(s, l, R.db.t(d)), t, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, KV.deq.empty())}}, 0n),
          newl_t(R.mv.put(s, l, d), t, KV.deq.push(R.ends.to(e), x, KV.deq.empty())),
          Equal.cong(KV.Trie<KV.Val>, KV.Trie<KV.Val>, z => KV.setx(KV.Val, z, t, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, KV.deq.empty())}}, 0n), R.db.t(R.mv.put(s, l, d)), T.mv.put(s, l, R.db.t(d)), mv_put_br(s, l, d))))
    case KV.PopNone{} _:
      {==}

def mv_do_br(m: R.Mv, +e: R.LEnds, +s: String, +t: String, +d: R.Db) -> {proj(R.mv.do(m, e, s, t, d)) == T.mv.do(m, e, s, t, R.db.t(d)) : R.Reply & KV.Trie<KV.Val>}:
  match m:
    case R.MvNone{}:
      {==}
    case R.MvWrong{}:
      {==}
    case R.MvSelf{+l, se}:
      mv_self_br(KV.deq.pop(R.ends.from(e), l), e, s, d)
    case R.MvOnto{+l, se, +q}:
      mv_go_br(KV.deq.pop(R.ends.from(e), l), e, s, t, Some{q}, d)
    case R.MvNew{+l, se}:
      mv_go_br(KV.deq.pop(R.ends.from(e), l), e, s, t, None{}, d)

# LMPOP on the record as the spec's: it picks the same key, and pops its
# list as Upd does
def first_br_at(+k: String, +rest: List<&2, String>, h: Bool, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.lmpop.first(rest, R.lmpop.head(rest, R.Db{t, n, x, now, rr}), R.Db{t, n, x, now, rr}) == T.lmpop.first(rest, T.lmpop.head(rest, t, now), t, now) : Maybe<&2, String>} -> {R.lmpop.first(Con{k, rest}, h, R.Db{t, n, x, now, rr}) == T.lmpop.first(Con{k, rest}, h, t, now) : Maybe<&2, String>}:
  match h:
    case True{}:
      ih => {==}
    case False{}:
      ih => ih

def first_br(ks: List<&2, String>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.lmpop.first(ks, R.lmpop.head(ks, R.Db{t, n, x, now, rr}), R.Db{t, n, x, now, rr}) == T.lmpop.first(ks, T.lmpop.head(ks, t, now), t, now) : Maybe<&2, String>}:
  match ks:
    case Nil{}:
      {==}
    case Con{+k, +rest}:
      first_br_at(k, rest, T.lmpop.head(Con{k, rest}, t, now), t, n, x, now, rr)(first_br(rest, t, n, x, now, rr))

def out_br(+k: String, r: R.Reply & R.Db) -> {proj(R.lmpop.out(k, r)) == T.lmpop.out(k, proj(r)) : R.Reply & KV.Trie<KV.Val>}:
  (y, d) = r
  {==}

def lmpop_at_br(m: Maybe<&2, String>, +left: Bool, +c: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.lmpop.at(m, left, c, R.Db{t, n, x, now, rr})) == T.lmpop.at(m, left, c, t, now) : R.Reply & KV.Trie<KV.Val>}:
  match m:
    case Some{+k}:
      Equal.trans(R.Reply & KV.Trie<KV.Val>, proj(R.lmpop.out(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, c}}))), T.lmpop.out(k, proj(R.db.upd(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, c}}))), T.lmpop.out(k, T.upd.run(t, k, R.UList{R.LWPopN{left, c}}, now)),
        out_br(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, c}})),
        Equal.cong(R.Reply & KV.Trie<KV.Val>, R.Reply & KV.Trie<KV.Val>, z => T.lmpop.out(k, z), proj(R.db.upd(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, c}})), T.upd.run(t, k, R.UList{R.LWPopN{left, c}}, now),
          upd_db_br(t, k, n, x, now, rr, R.UList{R.LWPopN{left, c}})))
    case None{}:
      {==}

# SINTERSTORE and the rest, and SMOVE, on the record as the spec's: each
# write is DEL's or an update's, an update on a record leaves the spec's
# trie at the record's time, and keeps the time
def upd_ch_now(+t: KV.Trie<KV.Val>, +k: String, +h: U32, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +c: Nat, r: R.Reply, ch: R.Change) -> {R.db.now(R.db_of(R.upd.ch(t, k, h, n, x, now, rr, c, r, ch))) == now : Nat}:
  match ch:
    case R.CKeep{}:
      {==}
    case R.CDel{}:
      {==}
    case R.CExp{e}:
      {==}
    case R.CPut{v, e}:
      {==}
    case R.CKeepT{v}:
      {==}
    case R.CApp{a, v}:
      {==}
    case R.CRange{o, a, v}:
      {==}
    case R.CHash{op, hv}:
      {==}
    case R.CHashNew{ps, hv}:
      {==}
    case R.CList{op, hv}:
      {==}
    case R.CListNew{lf, ps, hv}:
      {==}
    case R.CMems{op, sv}:
      {==}
    case R.CMemsNew{ms, sv}:
      {==}
    case R.CZset{op, z}:
      {==}
    case R.CZsetNew{o, ps, z}:
      {==}
    case R.CRestore{p, v, e}:
      {==}

def upd_now(+t: KV.Trie<KV.Val>, +k: String, +h: U32, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +c: Nat, o: R.Out) -> {R.db.now(R.db_of(R.upd.put(t, k, h, n, x, now, rr, c, o))) == now : Nat}:
  match o:
    case R.Out{r, ch}:
      upd_ch_now(t, k, h, n, x, now, rr, c, r, ch)

def upd_t(d: R.Db, +k: String, +op: R.UpdOp) -> {R.db.t(R.db_of(R.db.upd(d, k, op))) == T.db_of(T.upd.run(R.db.t(d), k, op, R.db.now(d))) : KV.Trie<KV.Val>}:
  match d:
    case R.Db{+t, +n, +x, +now, +rr}:
      Equal.trans(KV.Trie<KV.Val>, R.db.t(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, k, op))), T.db_of(proj(R.db.upd(R.Db{t, n, x, now, rr}, k, op))), T.db_of(T.upd.run(t, k, op, now)),
        Equal.sym(KV.Trie<KV.Val>, T.db_of(proj(R.db.upd(R.Db{t, n, x, now, rr}, k, op))), R.db.t(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, k, op))), proj_db(R.db.upd(R.Db{t, n, x, now, rr}, k, op))),
        Equal.cong(R.Reply & KV.Trie<KV.Val>, KV.Trie<KV.Val>, z => T.db_of(z), proj(R.db.upd(R.Db{t, n, x, now, rr}, k, op)), T.upd.run(t, k, op, now),
          upd_db_br(t, k, n, x, now, rr, op)))

def upd_now_d(d: R.Db, +k: String, +op: R.UpdOp) -> {R.db.now(R.db_of(R.db.upd(d, k, op))) == R.db.now(d) : Nat}:
  match d:
    case R.Db{+t, +n, +x, +now, +rr}:
      %db_upd_eq(t, k, n, x, now, rr, op) : {R.db.now(R.db_of(_)) == now : Nat}
      upd_now(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))))

def sstore_del_br(r: R.Dels, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj((R.r_int(0n), R.db_of(R.del.db(r, n, x, now, rr)))) == (R.r_int(0n), T.db_of(T.del_reply(r))) : R.Reply & KV.Trie<KV.Val>}:
  match r:
    case R.Dels{live, gone, gonex, t}:
      {==}

def sstore_of_br(xs: List<&2, String>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.sstore.of(xs, d, R.Db{t, n, x, now, rr})) == T.sstore.of(xs, d, t, now) : R.Reply & KV.Trie<KV.Val>}:
  match xs:
    case Nil{}:
      sstore_del_br(R.del_keys([d], now, t), n, x, now, rr)
    case Con{+y, +rest}:
      Equal.cong(KV.Trie<KV.Val>, R.Reply & KV.Trie<KV.Val>, z => (R.r_int(List.length(&2, String, y <> rest)), z), R.db.t(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, d, R.UMems{R.SWNew{y <> rest}}))), T.db_of(T.upd.run(t, d, R.UMems{R.SWNew{y <> rest}}, now)), upd_t(R.Db{t, n, x, now, rr}, d, R.UMems{R.SWNew{y <> rest}}))

def sstore_do_br(g: R.SGot, +op: R.SetK, +ks: List<&2, String>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.sstore.do(g, op, ks, d, R.Db{t, n, x, now, rr})) == T.sstore.do(g, op, ks, d, t, now) : R.Reply & KV.Trie<KV.Val>}:
  match g:
    case R.SGot{+ss}:
      sstore_of_br(R.sop.members(op, ks, ss), d, t, n, x, now, rr)
    case R.SGotWrong{}:
      {==}

def smove_do_br(f: R.Smv, +s: String, +dk: String, +w: R.SMem, +d: R.Db) -> {proj(R.smove.do(f, s, dk, w, d)) == T.smove.do(f, s, dk, w, R.db.t(d), R.db.now(d)) : R.Reply & KV.Trie<KV.Val>}:
  match f:
    case R.SmvZero{}:
      {==}
    case R.SmvWrong{}:
      {==}
    case R.SmvSame{had}:
      {==}
    case R.SmvGo{}:
      +u = R.db_of(R.db.upd(d, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))
      %upd_now_d(d, s, R.UMems{R.SWRem{[R.smv.member(w)]}}) : {proj((R.r_int(1n), R.db_of(R.db.upd(u, dk, R.UMems{R.smv.add(w)})))) == (R.r_int(1n), T.db_of(T.upd.run(T.db_of(T.upd.run(R.db.t(d), s, R.UMems{R.SWRem{[R.smv.member(w)]}}, R.db.now(d))), dk, R.UMems{R.smv.add(w)}, _))) : R.Reply & KV.Trie<KV.Val>}
      %upd_t(d, s, R.UMems{R.SWRem{[R.smv.member(w)]}}) : {proj((R.r_int(1n), R.db_of(R.db.upd(u, dk, R.UMems{R.smv.add(w)})))) == (R.r_int(1n), T.db_of(T.upd.run(_, dk, R.UMems{R.smv.add(w)}, R.db.now(u)))) : R.Reply & KV.Trie<KV.Val>}
      Equal.cong(KV.Trie<KV.Val>, R.Reply & KV.Trie<KV.Val>, z => (R.r_int(1n), z), R.db.t(R.db_of(R.db.upd(u, dk, R.UMems{R.smv.add(w)}))), T.db_of(T.upd.run(R.db.t(u), dk, R.UMems{R.smv.add(w)}, R.db.now(u))), upd_t(u, dk, R.UMems{R.smv.add(w)}))

# ZUNIONSTORE and the rest, ZRANGESTORE and ZMPOP on the record as the
# spec's: each write is DEL's or an update's
def zstore_of_br(xs: List<&2, KV.ZEl>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.zstore.of(xs, d, R.Db{t, n, x, now, rr})) == T.zstore.of(xs, d, t, now) : R.Reply & KV.Trie<KV.Val>}:
  match xs:
    case Nil{}:
      sstore_del_br(R.del_keys([d], now, t), n, x, now, rr)
    case Con{+y, +rest}:
      Equal.cong(KV.Trie<KV.Val>, R.Reply & KV.Trie<KV.Val>, z => (R.r_int(List.length(&2, KV.ZEl, y <> rest)), z), R.db.t(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(y <> rest)}}))), T.db_of(T.upd.run(t, d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(y <> rest)}}, now)), upd_t(R.Db{t, n, x, now, rr}, d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(y <> rest)}}))

def zstore_ok_br(bad: Maybe<&2, R.Reply>, +op: R.ZSetK, ss: List<&2, R.ZSrc>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.zstore.ok(bad, op, ss, d, R.Db{t, n, x, now, rr})) == T.zstore.ok(bad, op, ss, d, t, now) : R.Reply & KV.Trie<KV.Val>}:
  match bad:
    case Some{r}:
      {==}
    case None{}:
      zstore_of_br(R.zop.els(op, ss), d, t, n, x, now, rr)

def zstore_do_br(g: R.ZGot, +op: R.ZSetK, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.zstore.do(g, op, d, R.Db{t, n, x, now, rr})) == T.zstore.do(g, op, d, t, now) : R.Reply & KV.Trie<KV.Val>}:
  match g:
    case R.ZGot{ss}:
      zstore_ok_br(R.zop.bad(op), op, ss, d, t, n, x, now, rr)
    case R.ZGotWrong{}:
      {==}

def zrs_of_br(m: Maybe<&2, KV.Val>, q: R.ZQ, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.zrs.of(m, q, d, R.Db{t, n, x, now, rr})) == T.zrs.of(m, q, d, t, now) : R.Reply & KV.Trie<KV.Val>}:
  match m:
    case None{}:
      zstore_of_br(Nil{}, d, t, n, x, now, rr)
    case Some{KV.VColl{KV.CZset{+z}}}:
      zstore_of_br(R.zq.run(q, z), d, t, n, x, now, rr)
    case Some{KV.VColl{KV.CHash{h}}}:
      {==}
    case Some{KV.VColl{KV.CList{l}}}:
      {==}
    case Some{KV.VColl{KV.CMems{s}}}:
      {==}
    case Some{KV.VColl{KV.CStream{s}}}:
      {==}
    case Some{KV.VStr{w}}:
      {==}

def zout_br(+k: String, r: R.Reply & R.Db) -> {proj(R.zmpop.out(k, r)) == T.zmpop.out(k, proj(r)) : R.Reply & KV.Trie<KV.Val>}:
  (y, d) = r
  {==}

def zmpop_at_br(m: Maybe<&2, String>, +max: Bool, +c: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {proj(R.zmpop.at(m, max, c, R.Db{t, n, x, now, rr})) == T.zmpop.at(m, max, c, t, now) : R.Reply & KV.Trie<KV.Val>}:
  match m:
    case Some{+k}:
      Equal.trans(R.Reply & KV.Trie<KV.Val>, proj(R.zmpop.out(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}}))), T.zmpop.out(k, proj(R.db.upd(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}}))), T.zmpop.out(k, T.upd.run(t, k, R.UZset{R.ZWPopN{max, c}}, now)),
        zout_br(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}})),
        Equal.cong(R.Reply & KV.Trie<KV.Val>, R.Reply & KV.Trie<KV.Val>, z => T.zmpop.out(k, z), proj(R.db.upd(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}})), T.upd.run(t, k, R.UZset{R.ZWPopN{max, c}}, now),
          upd_db_br(t, k, n, x, now, rr, R.UZset{R.ZWPopN{max, c}})))
    case None{}:
      {==}

# a command answers as the spec's at the database's now, DBSIZE but, and
# leaves the trie the spec's leaves
def bridge_go(c: R.Cmd, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.keywise(c) == True{} : Bool} -> {proj(R.exec(c, R.Db{t, n, x, now, rr})) == T.exec(c, t, now) : R.Reply & KV.Trie<KV.Val>}:
  match c:
    case R.Ping{}:
      kw => {==}
    case R.Echo{m}:
      kw => {==}
    case R.Get{k}:
      kw => {==}
    case R.Set{k, v}:
      kw => {==}
    case R.Del{+ks}:
      kw => del_br(R.del_keys(ks, now, t), n, x, now, rr)
    case R.Exists{ks}:
      kw => {==}
    case R.IncrBy{+k, +by}:
      kw => incr_br(t, k, KV.hash(k), by, n, x, now, rr, KV.get_copy.at(t, k, KV.hash(k), now))
    case R.MGet{ks}:
      kw => {==}
    case R.MSet{+ps}:
      kw => Equal.cong(KV.Trie<KV.Val>, R.Reply & KV.Trie<KV.Val>, z => (R.r_ok(), z), R.db.t(R.mset_pairs(ps, R.Db{t, n, x, now, rr})), T.mset_pairs(ps, t), mset_br(ps, t, n, x, now, rr))
    case R.DbSize{}:
      kw => Empty.absurd({proj(R.exec(R.DbSize{}, R.Db{t, n, x, now, rr})) == T.exec(R.DbSize{}, t, now) : R.Reply & KV.Trie<KV.Val>}, false_true(kw))
    case R.FlushDb{}:
      kw => {==}
    case R.Keys{p}:
      kw => {==}
    case R.Sort{k, o}:
      kw => {==}
    case R.Scan{a}:
      kw => {==}
    case R.Peek{k, o}:
      kw => {==}
    case R.Upd{+k, +op}:
      kw => upd_db_br(t, k, n, x, now, rr, op)
    case R.MSetNx{+ps}:
      kw => msetnx_br(R.pairs.live(ps, now, t), ps, t, n, x, now, rr)
    case R.Rename{+s, +d, +nx}:
      kw => ren_br(T.ren.find(t, s, d, nx, now), nx, s, d, t, n, x, now, rr)
    case R.BitOp{+op, +d, +srcs}:
      kw => bitop_do_br(R.bitop.wrong(srcs, now, t), op, d, srcs, t, n, x, now, rr)
    case R.LMove{+s, +d, +w}:
      kw => mv_do_br(T.mv.find(t, s, d, w, now), w, s, d, R.Db{t, n, x, now, rr})
    case R.LMPop{+ks, +left, +cnt}:
      kw => %first_br(ks, t, n, x, now, rr) : {proj(R.lmpop.at(R.lmpop.first(ks, R.lmpop.head(ks, R.Db{t, n, x, now, rr}), R.Db{t, n, x, now, rr}), left, cnt, R.Db{t, n, x, now, rr})) == T.lmpop.at(_, left, cnt, t, now) : R.Reply & KV.Trie<KV.Val>}
            lmpop_at_br(R.lmpop.first(ks, R.lmpop.head(ks, R.Db{t, n, x, now, rr}), R.Db{t, n, x, now, rr}), left, cnt, t, n, x, now, rr)
    case R.SOp{op, ks}:
      kw => {==}
    case R.SStore{+op, +d, +srcs}:
      kw => sstore_do_br(R.sets.at(srcs, now, t), op, srcs, d, t, n, x, now, rr)
    case R.SMv{+s, +d, +w}:
      kw => smove_do_br(T.smv.find(t, s, d, w, now), s, d, w, R.Db{t, n, x, now, rr})
    case R.ZOp{op, ks}:
      kw => {==}
    case R.ZStore{+op, +d, +srcs}:
      kw => zstore_do_br(R.zsrcs.at(srcs, now, t), op, d, t, n, x, now, rr)
    case R.ZRangeStore{+d, +s, +q}:
      kw => zrs_of_br(KV.read(KV.Val, t, s, now), q, d, t, n, x, now, rr)
    case R.ZMPop{+ks, +max, +c}:
      kw => %first_br(ks, t, n, x, now, rr) : {proj(R.zmpop.at(R.lmpop.first(ks, R.lmpop.head(ks, R.Db{t, n, x, now, rr}), R.Db{t, n, x, now, rr}), max, c, R.Db{t, n, x, now, rr})) == T.zmpop.at(_, max, c, t, now) : R.Reply & KV.Trie<KV.Val>}
            zmpop_at_br(R.lmpop.first(ks, R.lmpop.head(ks, R.Db{t, n, x, now, rr}), R.Db{t, n, x, now, rr}), max, c, t, n, x, now, rr)
    case R.Own{o}:
      kw => {==}
    case R.Bad{r}:
      kw => {==}

# and keeps the time
def del_now(r: R.Dels, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.del.db(r, n, x, now, rr))) == now : Nat}:
  match r:
    case R.Dels{live, gone, gonex, t}:
      {==}

def incr_fit_now(+t: KV.Trie<KV.Val>, +k: String, +h: U32, s: R.LL, +keep: Bool, +m: Nat, +n: Nat, +y: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.incr.fit(t, k, h, s, keep, m, n, y, x, now, rr))) == now : Nat}:
  match s:
    case R.LL{+neg, +hi, +lo}:
      {==}
    case R.LLBad{}:
      {==}

def incr_num_now(+t: KV.Trie<KV.Val>, +k: String, +h: U32, +by: R.By, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, cur: R.LL) -> {R.db.now(R.db_of(R.incr.num(t, k, h, by, n, x, now, rr, cur))) == now : Nat}:
  match cur:
    case R.LL{+neg, +hi, +lo}:
      incr_fit_now(t, k, h, R.ll.add(neg, hi, lo, by), True{}, n, n, x, x, now, rr)
    case R.LLBad{}:
      {==}

def incr_now(+t: KV.Trie<KV.Val>, +k: String, +h: U32, +by: R.By, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, old: KV.Got) -> {R.db.now(R.db_of(R.incr.got(t, k, h, by, n, x, now, rr, old))) == now : Nat}:
  match old:
    case KV.GStr{+s}:
      incr_num_now(t, k, h, by, n, x, now, rr, R.ll.read(s))
    case KV.GColl{}:
      {==}
    case KV.GNone{}:
      incr_fit_now(t, k, h, R.by.ll(by), False{}, R.cnt.n(KV.code.at(KV.Val, t, k, h), n), n, R.cnt.x(KV.code.at(KV.Val, t, k, h), 0n, x), x, now, rr)

def mset_now(ps: List<&2, R.KVPair>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.mset_pairs(ps, R.Db{t, n, x, now, rr})) == now : Nat}:
  match ps:
    case Nil{}:
      {==}
    case Con{R.KP{+k, +v}, +rest}:
      mset_now(rest, KV.set(KV.Val, t, k, KV.VStr{v}), R.cnt.n(KV.code.at(KV.Val, t, k, KV.hash(k)), n), R.cnt.x(KV.code.at(KV.Val, t, k, KV.hash(k)), 0n, x), now, rr)

def msetnx_now(b: Bool, ps: List<&2, R.KVPair>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.msetnx.of(b, ps, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match b:
    case True{}:
      {==}
    case False{}:
      mset_now(ps, t, n, x, now, rr)

def ren_now(r: R.Ren, +nx: Bool, +s: String, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.ren.do(r, nx, s, d, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match r:
    case R.RnNone{}:
      {==}
    case R.RnSame{}:
      {==}
    case R.RnHeld{}:
      {==}
    case R.RnMove{v, e}:
      {==}

def bitop_now(e: Bool, +v: String, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.bitop.db(e, v, d, R.Db{t, n, x, now, rr})) == now : Nat}:
  match e:
    case True{}:
      {==}
    case False{}:
      {==}

def bitop_do_now(w: Bool, +op: R.BitK, +d: String, +srcs: List<&2, String>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.bitop.do(w, op, d, srcs, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match w:
    case True{}:
      {==}
    case False{}:
      bitop_now(String.is_empty(R.bitop.val(op, srcs, now, t)), R.bitop.val(op, srcs, now, t), d, t, n, x, now, rr)

def keepl_now(d: R.Db, +k: String, +l: KV.Deq) -> {R.db.now(R.db.keepl(d, k, l)) == R.db.now(d) : Nat}:
  match d:
    case R.Db{t, n, x, now, rr}:
      {==}

def newl_now(d: R.Db, +k: String, +l: KV.Deq) -> {R.db.now(R.db.newl(d, k, l)) == R.db.now(d) : Nat}:
  match d:
    case R.Db{t, n, x, now, rr}:
      {==}

def del1_now(d: R.Db, +k: String) -> {R.db.now(R.db_of(R.db.del(d, [k]))) == R.db.now(d) : Nat}:
  match d:
    case R.Db{+t, +n, +x, +now, +rr}:
      del_now(R.del_keys([k], now, t), n, x, now, rr)

def mv_src_now(b: Bool, +k: String, +l: KV.Deq, +d: R.Db) -> {R.db.now(R.mv.src(b, k, l, d)) == R.db.now(d) : Nat}:
  match b:
    case True{}:
      del1_now(d, k)
    case False{}:
      keepl_now(d, k, l)

def mv_put_now(+s: String, +l: KV.Deq, +d: R.Db) -> {R.db.now(R.mv.put(s, l, d)) == R.db.now(d) : Nat}:
  mv_src_now(Nat.is_eq(KV.deq.len(l), 0n), s, l, d)

def mv_self_now(p: KV.Pop, +e: R.LEnds, +s: String, +d: R.Db) -> {R.db.now(R.db_of(R.mv.self(p, e, s, d))) == R.db.now(d) : Nat}:
  match p:
    case KV.Pop{+x, +l}:
      keepl_now(d, s, KV.deq.push(R.ends.to(e), x, l))
    case KV.PopNone{}:
      {==}

def mv_go_now(p: KV.Pop, +e: R.LEnds, +s: String, +t: String, dl: Maybe<&2, KV.Deq>, +d: R.Db) -> {R.db.now(R.db_of(R.mv.go(p, e, s, t, dl, d))) == R.db.now(d) : Nat}:
  match p dl:
    case KV.Pop{+x, +l} Some{+q}:
      Equal.trans(Nat, R.db.now(R.db.keepl(R.mv.put(s, l, d), t, KV.deq.push(R.ends.to(e), x, q))), R.db.now(R.mv.put(s, l, d)), R.db.now(d), keepl_now(R.mv.put(s, l, d), t, KV.deq.push(R.ends.to(e), x, q)), mv_put_now(s, l, d))
    case KV.Pop{+x, +l} None{}:
      Equal.trans(Nat, R.db.now(R.db.newl(R.mv.put(s, l, d), t, KV.deq.push(R.ends.to(e), x, KV.deq.empty()))), R.db.now(R.mv.put(s, l, d)), R.db.now(d), newl_now(R.mv.put(s, l, d), t, KV.deq.push(R.ends.to(e), x, KV.deq.empty())), mv_put_now(s, l, d))
    case KV.PopNone{} _:
      {==}

def mv_do_now(m: R.Mv, +e: R.LEnds, +s: String, +t: String, +d: R.Db) -> {R.db.now(R.db_of(R.mv.do(m, e, s, t, d))) == R.db.now(d) : Nat}:
  match m:
    case R.MvNone{}:
      {==}
    case R.MvWrong{}:
      {==}
    case R.MvSelf{+l, se}:
      mv_self_now(KV.deq.pop(R.ends.from(e), l), e, s, d)
    case R.MvOnto{+l, se, +q}:
      mv_go_now(KV.deq.pop(R.ends.from(e), l), e, s, t, Some{q}, d)
    case R.MvNew{+l, se}:
      mv_go_now(KV.deq.pop(R.ends.from(e), l), e, s, t, None{}, d)

def out_db_R(+k: String, r: R.Reply & R.Db) -> {R.db_of(R.lmpop.out(k, r)) == R.db_of(r) : R.Db}:
  (y, d) = r
  {==}

def lmpop_at_now(m: Maybe<&2, String>, +left: Bool, +c: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.lmpop.at(m, left, c, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match m:
    case Some{+k}:
      Equal.trans(Nat, R.db.now(R.db_of(R.lmpop.out(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, c}})))), R.db.now(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, c}}))), now,
        Equal.cong(R.Db, Nat, z => R.db.now(z), R.db_of(R.lmpop.out(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, c}}))), R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, c}})), out_db_R(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, c}}))),
        upd_now_d(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, c}}))
    case None{}:
      {==}

def sstore_of_now(xs: List<&2, String>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.sstore.of(xs, d, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match xs:
    case Nil{}:
      del_now(R.del_keys([d], now, t), n, x, now, rr)
    case Con{+y, +rest}:
      upd_now_d(R.Db{t, n, x, now, rr}, d, R.UMems{R.SWNew{y <> rest}})

def sstore_do_now(g: R.SGot, +op: R.SetK, +ks: List<&2, String>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.sstore.do(g, op, ks, d, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match g:
    case R.SGot{+ss}:
      sstore_of_now(R.sop.members(op, ks, ss), d, t, n, x, now, rr)
    case R.SGotWrong{}:
      {==}

def smove_do_now(f: R.Smv, +s: String, +dk: String, +w: R.SMem, +d: R.Db) -> {R.db.now(R.db_of(R.smove.do(f, s, dk, w, d))) == R.db.now(d) : Nat}:
  match f:
    case R.SmvZero{}:
      {==}
    case R.SmvWrong{}:
      {==}
    case R.SmvSame{had}:
      {==}
    case R.SmvGo{}:
      +u = R.db_of(R.db.upd(d, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))
      Equal.trans(Nat, R.db.now(R.db_of(R.db.upd(u, dk, R.UMems{R.smv.add(w)}))), R.db.now(u), R.db.now(d), upd_now_d(u, dk, R.UMems{R.smv.add(w)}), upd_now_d(d, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))

def zstore_of_now(xs: List<&2, KV.ZEl>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.zstore.of(xs, d, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match xs:
    case Nil{}:
      del_now(R.del_keys([d], now, t), n, x, now, rr)
    case Con{+y, +rest}:
      upd_now_d(R.Db{t, n, x, now, rr}, d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(y <> rest)}})

def zstore_ok_now(bad: Maybe<&2, R.Reply>, +op: R.ZSetK, ss: List<&2, R.ZSrc>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.zstore.ok(bad, op, ss, d, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match bad:
    case Some{r}:
      {==}
    case None{}:
      zstore_of_now(R.zop.els(op, ss), d, t, n, x, now, rr)

def zstore_do_now(g: R.ZGot, +op: R.ZSetK, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.zstore.do(g, op, d, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match g:
    case R.ZGot{ss}:
      zstore_ok_now(R.zop.bad(op), op, ss, d, t, n, x, now, rr)
    case R.ZGotWrong{}:
      {==}

def zrs_of_now(m: Maybe<&2, KV.Val>, q: R.ZQ, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.zrs.of(m, q, d, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match m:
    case None{}:
      zstore_of_now(Nil{}, d, t, n, x, now, rr)
    case Some{KV.VColl{KV.CZset{+z}}}:
      zstore_of_now(R.zq.run(q, z), d, t, n, x, now, rr)
    case Some{KV.VColl{KV.CHash{h}}}:
      {==}
    case Some{KV.VColl{KV.CList{l}}}:
      {==}
    case Some{KV.VColl{KV.CMems{s}}}:
      {==}
    case Some{KV.VColl{KV.CStream{s}}}:
      {==}
    case Some{KV.VStr{w}}:
      {==}

def zout_db_R(+k: String, r: R.Reply & R.Db) -> {R.db_of(R.zmpop.out(k, r)) == R.db_of(r) : R.Db}:
  (y, d) = r
  {==}

def zmpop_at_now(m: Maybe<&2, String>, +max: Bool, +c: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.zmpop.at(m, max, c, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match m:
    case Some{+k}:
      Equal.trans(Nat, R.db.now(R.db_of(R.zmpop.out(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}})))), R.db.now(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}}))), now,
        Equal.cong(R.Db, Nat, z => R.db.now(z), R.db_of(R.zmpop.out(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}}))), R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}})), zout_db_R(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}}))),
        upd_now_d(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}}))
    case None{}:
      {==}

def now_go(c: R.Cmd, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db.now(R.db_of(R.exec(c, R.Db{t, n, x, now, rr}))) == now : Nat}:
  match c:
    case R.Ping{}:
      {==}
    case R.Echo{m}:
      {==}
    case R.Get{k}:
      {==}
    case R.Set{k, v}:
      {==}
    case R.Del{+ks}:
      del_now(R.del_keys(ks, now, t), n, x, now, rr)
    case R.Exists{ks}:
      {==}
    case R.IncrBy{+k, +by}:
      incr_now(t, k, KV.hash(k), by, n, x, now, rr, KV.get_copy.at(t, k, KV.hash(k), now))
    case R.MGet{ks}:
      {==}
    case R.MSet{+ps}:
      mset_now(ps, t, n, x, now, rr)
    case R.DbSize{}:
      {==}
    case R.FlushDb{}:
      {==}
    case R.Keys{p}:
      {==}
    case R.Sort{k, o}:
      {==}
    case R.Scan{a}:
      {==}
    case R.Peek{k, o}:
      {==}
    case R.Upd{+k, +op}:
      upd_now_d(R.Db{t, n, x, now, rr}, k, op)
    case R.MSetNx{+ps}:
      msetnx_now(R.pairs.live(ps, now, t), ps, t, n, x, now, rr)
    case R.Rename{+s, +d, +nx}:
      ren_now(T.ren.find(t, s, d, nx, now), nx, s, d, t, n, x, now, rr)
    case R.BitOp{+op, +d, +srcs}:
      bitop_do_now(R.bitop.wrong(srcs, now, t), op, d, srcs, t, n, x, now, rr)
    case R.LMove{+s, +d, +w}:
      mv_do_now(T.mv.find(t, s, d, w, now), w, s, d, R.Db{t, n, x, now, rr})
    case R.LMPop{+ks, +left, +cnt}:
      lmpop_at_now(R.lmpop.first(ks, R.lmpop.head(ks, R.Db{t, n, x, now, rr}), R.Db{t, n, x, now, rr}), left, cnt, t, n, x, now, rr)
    case R.SOp{op, ks}:
      {==}
    case R.SStore{+op, +d, +srcs}:
      sstore_do_now(R.sets.at(srcs, now, t), op, srcs, d, t, n, x, now, rr)
    case R.SMv{+s, +d, +w}:
      smove_do_now(T.smv.find(t, s, d, w, now), s, d, w, R.Db{t, n, x, now, rr})
    case R.ZOp{op, ks}:
      {==}
    case R.ZStore{+op, +d, +srcs}:
      zstore_do_now(R.zsrcs.at(srcs, now, t), op, d, t, n, x, now, rr)
    case R.ZRangeStore{+d, +s, +q}:
      zrs_of_now(KV.read(KV.Val, t, s, now), q, d, t, n, x, now, rr)
    case R.ZMPop{+ks, +max, +c}:
      zmpop_at_now(R.lmpop.first(ks, R.lmpop.head(ks, R.Db{t, n, x, now, rr}), R.Db{t, n, x, now, rr}), max, c, t, n, x, now, rr)
    case R.Own{o}:
      {==}
    case R.Bad{r}:
      {==}

def br_go(+c: R.Cmd, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, kw: {Laws.keywise(c) == True{} : Bool}) -> {T.reply_of(T.exec(c, t, now)) == R.reply_of(R.exec(c, R.Db{t, n, x, now, rr})) : R.Reply}:
  %bridge_go(c, t, n, x, now, rr)(kw) : {T.reply_of(_) == R.reply_of(R.exec(c, R.Db{t, n, x, now, rr})) : R.Reply}
  proj_rep(R.exec(c, R.Db{t, n, x, now, rr}))

def bt_kw(+c: R.Cmd, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, kw: {Laws.keywise(c) == True{} : Bool}) -> {T.db_of(T.exec(c, t, now)) == R.db.t(R.db_of(R.exec(c, R.Db{t, n, x, now, rr}))) : KV.Trie<KV.Val>}:
  %bridge_go(c, t, n, x, now, rr)(kw) : {T.db_of(_) == R.db.t(R.db_of(R.exec(c, R.Db{t, n, x, now, rr}))) : KV.Trie<KV.Val>}
  proj_db(R.exec(c, R.Db{t, n, x, now, rr}))

# every command leaves the spec's trie: DBSIZE, KEYS and SCAN only read
def bt_go(c: R.Cmd, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {T.db_of(T.exec(c, t, now)) == R.db.t(R.db_of(R.exec(c, R.Db{t, n, x, now, rr}))) : KV.Trie<KV.Val>}:
  match c:
    case R.Ping{}:
      {==}
    case R.Echo{m}:
      {==}
    case R.Get{k}:
      {==}
    case R.Set{k, v}:
      {==}
    case R.Del{+ks}:
      bt_kw(R.Del{ks}, t, n, x, now, rr, {==})
    case R.Exists{ks}:
      {==}
    case R.IncrBy{+k, +by}:
      bt_kw(R.IncrBy{k, by}, t, n, x, now, rr, {==})
    case R.MGet{ks}:
      {==}
    case R.MSet{+ps}:
      bt_kw(R.MSet{ps}, t, n, x, now, rr, {==})
    case R.DbSize{}:
      {==}
    case R.FlushDb{}:
      {==}
    case R.Keys{p}:
      {==}
    case R.Sort{k, o}:
      {==}
    case R.Scan{a}:
      {==}
    case R.Peek{k, o}:
      {==}
    case R.Upd{+k, +op}:
      bt_kw(R.Upd{k, op}, t, n, x, now, rr, {==})
    case R.MSetNx{+ps}:
      bt_kw(R.MSetNx{ps}, t, n, x, now, rr, {==})
    case R.Rename{+s, +d, +nx}:
      bt_kw(R.Rename{s, d, nx}, t, n, x, now, rr, {==})
    case R.BitOp{+op, +d, +srcs}:
      bt_kw(R.BitOp{op, d, srcs}, t, n, x, now, rr, {==})
    case R.LMove{+op, +d, +srcs}:
      bt_kw(R.LMove{op, d, srcs}, t, n, x, now, rr, {==})
    case R.LMPop{+op, +d, +srcs}:
      bt_kw(R.LMPop{op, d, srcs}, t, n, x, now, rr, {==})
    case R.SOp{+op, +ks}:
      bt_kw(R.SOp{op, ks}, t, n, x, now, rr, {==})
    case R.SStore{+op, +d, +srcs}:
      bt_kw(R.SStore{op, d, srcs}, t, n, x, now, rr, {==})
    case R.SMv{+s, +d, +w}:
      bt_kw(R.SMv{s, d, w}, t, n, x, now, rr, {==})
    case R.ZOp{+op, +ks}:
      bt_kw(R.ZOp{op, ks}, t, n, x, now, rr, {==})
    case R.ZStore{+op, +d, +srcs}:
      bt_kw(R.ZStore{op, d, srcs}, t, n, x, now, rr, {==})
    case R.ZRangeStore{+d, +s, +q}:
      bt_kw(R.ZRangeStore{d, s, q}, t, n, x, now, rr, {==})
    case R.ZMPop{+ks, +max, +c}:
      bt_kw(R.ZMPop{ks, max, c}, t, n, x, now, rr, {==})
    case R.Own{o}:
      {==}
    case R.Bad{r}:
      {==}

# the bridge on any database: bt and tb for the trie, br for the reply,
# now_eq and eq_now for the time
def bt(+c: R.Cmd, +db: R.Db) -> {T.db_of(T.exec(c, R.db.t(db), R.db.now(db))) == R.db.t(R.db_of(R.exec(c, db))) : KV.Trie<KV.Val>}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      bt_go(c, t, n, x, now, rr)

def tb(+c: R.Cmd, +db: R.Db) -> {R.db.t(R.db_of(R.exec(c, db))) == T.db_of(T.exec(c, R.db.t(db), R.db.now(db))) : KV.Trie<KV.Val>}:
  Equal.sym(KV.Trie<KV.Val>, T.db_of(T.exec(c, R.db.t(db), R.db.now(db))), R.db.t(R.db_of(R.exec(c, db))), bt(c, db))

def br(+c: R.Cmd, +db: R.Db, kw: {Laws.keywise(c) == True{} : Bool}) -> {T.reply_of(T.exec(c, R.db.t(db), R.db.now(db))) == R.reply_of(R.exec(c, db)) : R.Reply}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      br_go(c, t, n, x, now, rr, kw)

def now_eq(+c: R.Cmd, +db: R.Db) -> {R.db.now(R.db_of(R.exec(c, db))) == R.db.now(db) : Nat}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      now_go(c, t, n, x, now, rr)

def eq_now(+c: R.Cmd, +db: R.Db) -> {R.db.now(db) == R.db.now(R.db_of(R.exec(c, db))) : Nat}:
  Equal.sym(Nat, R.db.now(R.db_of(R.exec(c, db))), R.db.now(db), now_eq(c, db))

# a batch of commands but DBSIZE, KEYS and SCAN answers as the spec's
# batch at the database's now, and any batch leaves the spec's trie
def run_r(cs: List<&2, R.Cmd>, +db: R.Db) -> {Laws.keywise_all(cs) == True{} : Bool} -> {t_rfst(t_run(cs, R.db.t(db), R.db.now(db))) == rfst(run(cs, db)) : List<&2, R.Reply>}:
  match cs:
    case Nil{}:
      kw => {==}
    case Con{+c, +rest}:
      +kw =>
        %t_eta_l(t_run(rest, T.db_of(T.exec(c, R.db.t(db), R.db.now(db))), R.db.now(db))) : {t_rfst(T.exec_all.cons(T.reply_of(T.exec(c, R.db.t(db), R.db.now(db))), _)) == rfst(R.exec_all.cons(R.reply_of(R.exec(c, db)), run(rest, R.db_of(R.exec(c, db))))) : List<&2, R.Reply>}
        %eta_l(run(rest, R.db_of(R.exec(c, db)))) : {T.reply_of(T.exec(c, R.db.t(db), R.db.now(db))) <> t_rfst(t_run(rest, T.db_of(T.exec(c, R.db.t(db), R.db.now(db))), R.db.now(db))) == rfst(R.exec_all.cons(R.reply_of(R.exec(c, db)), _)) : List<&2, R.Reply>}
        %br(c, db, and_l(Laws.keywise(c), Laws.keywise_all(rest))(kw)) : {T.reply_of(T.exec(c, R.db.t(db), R.db.now(db))) <> t_rfst(t_run(rest, T.db_of(T.exec(c, R.db.t(db), R.db.now(db))), R.db.now(db))) == _ <> rfst(run(rest, R.db_of(R.exec(c, db)))) : List<&2, R.Reply>}
        %tb(c, db) : {T.reply_of(T.exec(c, R.db.t(db), R.db.now(db))) <> t_rfst(t_run(rest, _, R.db.now(db))) == T.reply_of(T.exec(c, R.db.t(db), R.db.now(db))) <> rfst(run(rest, R.db_of(R.exec(c, db)))) : List<&2, R.Reply>}
        %now_eq(c, db) : {T.reply_of(T.exec(c, R.db.t(db), R.db.now(db))) <> t_rfst(t_run(rest, R.db.t(R.db_of(R.exec(c, db))), _)) == T.reply_of(T.exec(c, R.db.t(db), R.db.now(db))) <> rfst(run(rest, R.db_of(R.exec(c, db)))) : List<&2, R.Reply>}
        Equal.cong(List<&2, R.Reply>, List<&2, R.Reply>, z => T.reply_of(T.exec(c, R.db.t(db), R.db.now(db))) <> z, t_rfst(t_run(rest, R.db.t(R.db_of(R.exec(c, db))), R.db.now(R.db_of(R.exec(c, db))))), rfst(run(rest, R.db_of(R.exec(c, db)))), run_r(rest, R.db_of(R.exec(c, db)))(and_r(Laws.keywise(c), Laws.keywise_all(rest))(kw)))

def run_t(cs: List<&2, R.Cmd>, +db: R.Db) -> {t_rsnd(t_run(cs, R.db.t(db), R.db.now(db))) == R.db.t(rsnd(run(cs, db))) : KV.Trie<KV.Val>}:
  match cs:
    case Nil{}:
      {==}
    case Con{+c, +rest}:
      %t_eta_l(t_run(rest, T.db_of(T.exec(c, R.db.t(db), R.db.now(db))), R.db.now(db))) : {t_rsnd(T.exec_all.cons(T.reply_of(T.exec(c, R.db.t(db), R.db.now(db))), _)) == R.db.t(rsnd(R.exec_all.cons(R.reply_of(R.exec(c, db)), run(rest, R.db_of(R.exec(c, db)))))) : KV.Trie<KV.Val>}
      %eta_l(run(rest, R.db_of(R.exec(c, db)))) : {t_rsnd(t_run(rest, T.db_of(T.exec(c, R.db.t(db), R.db.now(db))), R.db.now(db))) == R.db.t(rsnd(R.exec_all.cons(R.reply_of(R.exec(c, db)), _))) : KV.Trie<KV.Val>}
      %tb(c, db) : {t_rsnd(t_run(rest, _, R.db.now(db))) == R.db.t(rsnd(run(rest, R.db_of(R.exec(c, db))))) : KV.Trie<KV.Val>}
      %now_eq(c, db) : {t_rsnd(t_run(rest, R.db.t(R.db_of(R.exec(c, db))), _)) == R.db.t(rsnd(run(rest, R.db_of(R.exec(c, db))))) : KV.Trie<KV.Val>}
      run_t(rest, R.db_of(R.exec(c, db)))

def fin_t(+cs: List<&2, R.Cmd>, +db: R.Db) -> {T.final(T.exec_all(cs, R.db.t(db), R.db.now(db))) == R.db.t(Laws.final(R.exec_all(cs, db))) : KV.Trie<KV.Val>}:
  %t_exec_all_run(cs, R.db.t(db), R.db.now(db)) : {T.final(_) == R.db.t(Laws.final(R.exec_all(cs, db))) : KV.Trie<KV.Val>}
  %exec_all_run(cs, db) : {T.final(t_run(cs, R.db.t(db), R.db.now(db))) == R.db.t(Laws.final(_)) : KV.Trie<KV.Val>}
  %t_eta_l(t_run(cs, R.db.t(db), R.db.now(db))) : {T.final(_) == R.db.t(Laws.final(run(cs, db))) : KV.Trie<KV.Val>}
  %eta_l(run(cs, db)) : {t_rsnd(t_run(cs, R.db.t(db), R.db.now(db))) == R.db.t(Laws.final(_)) : KV.Trie<KV.Val>}
  run_t(cs, db)

# The laws of the server's exec
# -----------------------------

def frame_db(+c: R.Cmd, +db: R.Db, +j: String, e: {Laws.writes(c, j) == False{} : Bool}) -> {KV.entry(KV.Val, R.db.t(R.db_of(R.exec(c, db))), j) == KV.entry(KV.Val, R.db.t(db), j) : Maybe<&2, KV.Item<KV.Val>>}:
  %bt(c, db) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, R.db.t(db), j) : Maybe<&2, KV.Item<KV.Val>>}
  t_frame(c, R.db.t(db), j, R.db.now(db), e)

def Laws.frame(c, db, j, e):
  frame_db(c, db, j, e)

def reads_go(c: R.Cmd, +db: R.Db) -> {Laws.is_read(c) == True{} : Bool} -> {R.db_of(R.exec(c, db)) == db : R.Db}:
  match c:
    case R.Ping{}:
      e => {==}
    case R.Echo{m}:
      e => {==}
    case R.Get{k}:
      e => {==}
    case R.Set{k, v}:
      e => Empty.absurd({R.db_of(R.exec(R.Set{k, v}, db)) == db : R.Db}, false_true(e))
    case R.Del{ks}:
      e => Empty.absurd({R.db_of(R.exec(R.Del{ks}, db)) == db : R.Db}, false_true(e))
    case R.Exists{ks}:
      e => {==}
    case R.IncrBy{k, by}:
      e => Empty.absurd({R.db_of(R.exec(R.IncrBy{k, by}, db)) == db : R.Db}, false_true(e))
    case R.MGet{ks}:
      e => {==}
    case R.MSet{ps}:
      e => Empty.absurd({R.db_of(R.exec(R.MSet{ps}, db)) == db : R.Db}, false_true(e))
    case R.DbSize{}:
      e => {==}
    case R.FlushDb{}:
      e => Empty.absurd({R.db_of(R.exec(R.FlushDb{}, db)) == db : R.Db}, false_true(e))
    case R.Keys{p}:
      e => {==}
    case R.Sort{k, o}:
      e => {==}
    case R.Scan{a}:
      e => {==}
    case R.Peek{k, o}:
      e => {==}
    case R.Upd{k, op}:
      e => Empty.absurd({R.db_of(R.exec(R.Upd{k, op}, db)) == db : R.Db}, false_true(e))
    case R.MSetNx{ps}:
      e => Empty.absurd({R.db_of(R.exec(R.MSetNx{ps}, db)) == db : R.Db}, false_true(e))
    case R.Rename{s, d, nx}:
      e => Empty.absurd({R.db_of(R.exec(R.Rename{s, d, nx}, db)) == db : R.Db}, false_true(e))
    case R.BitOp{op, d, srcs}:
      e => Empty.absurd({R.db_of(R.exec(R.BitOp{op, d, srcs}, db)) == db : R.Db}, false_true(e))
    case R.LMove{op, d, srcs}:
      e => Empty.absurd({R.db_of(R.exec(R.LMove{op, d, srcs}, db)) == db : R.Db}, false_true(e))
    case R.LMPop{op, d, srcs}:
      e => Empty.absurd({R.db_of(R.exec(R.LMPop{op, d, srcs}, db)) == db : R.Db}, false_true(e))
    case R.SOp{op, ks}:
      e => {==}
    case R.SStore{op, d, srcs}:
      e => Empty.absurd({R.db_of(R.exec(R.SStore{op, d, srcs}, db)) == db : R.Db}, false_true(e))
    case R.SMv{s, d, w}:
      e => Empty.absurd({R.db_of(R.exec(R.SMv{s, d, w}, db)) == db : R.Db}, false_true(e))
    case R.ZOp{op, ks}:
      e => {==}
    case R.ZStore{op, d, srcs}:
      e => Empty.absurd({R.db_of(R.exec(R.ZStore{op, d, srcs}, db)) == db : R.Db}, false_true(e))
    case R.ZRangeStore{d, s, q}:
      e => Empty.absurd({R.db_of(R.exec(R.ZRangeStore{d, s, q}, db)) == db : R.Db}, false_true(e))
    case R.ZMPop{ks, max, c}:
      e => Empty.absurd({R.db_of(R.exec(R.ZMPop{ks, max, c}, db)) == db : R.Db}, false_true(e))
    case R.Own{o}:
      e => {==}
    case R.Bad{r}:
      e => {==}

def Laws.reads_keep_db(c, db, e):
  reads_go(c, db)(e)

def Laws.get_after_set(db, k, v):
  %br(R.Get{k}, R.db_of(R.exec(R.Set{k, v}, db)), {==}) : {_ == R.RBulk{v} : R.Reply}
  %bt(R.Set{k, v}, db) : {T.reply_of(T.exec(R.Get{k}, _, R.db.now(R.db_of(R.exec(R.Set{k, v}, db))))) == R.RBulk{v} : R.Reply}
  %eq_now(R.Set{k, v}, db) : {T.reply_of(T.exec(R.Get{k}, T.db_of(T.exec(R.Set{k, v}, R.db.t(db), R.db.now(db))), _)) == R.RBulk{v} : R.Reply}
  t_get_after_set(R.db.t(db), k, v, R.db.now(db))

# a time that has passed: now is not at or before it
def lt_not_le(a: Nat, b: Nat) -> {Nat.is_lt(a, b) == True{} : Bool} -> {False{} == Nat.is_le(b, a) : Bool}:
  match a b:
    case 0n 0n:
      e => Empty.absurd({False{} == Nat.is_le(0n, 0n) : Bool}, false_true(e))
    case 0n 1n+bp:
      e => {==}
    case 1n+ap 0n:
      e => Empty.absurd({False{} == Nat.is_le(0n, 1n+ap) : Bool}, false_true(e))
    case 1n+ap 1n+bp:
      e => lt_not_le(ap, bp)(e)

def Laws.expired(db, k, v, e, h, p):
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, R.db.t(db), k), Some{KV.Item{v, 1n+e}}, h) : {R.ent.live(R.db.now(db), _) == None{} : Maybe<&2, KV.Item<KV.Val>>}
  %lt_not_le(1n+e, R.db.now(db))(p) : {Bool.pick(Maybe<&2, KV.Item<KV.Val>>, Bool.or(Nat.is_eq(1n+e, 0n), _), Some{KV.Item{v, 1n+e}}, None{}) == None{} : Maybe<&2, KV.Item<KV.Val>>}
  {==}

# the value of an entry
def item_val(m: Maybe<&2, KV.Item<KV.Val>>) -> Maybe<&2, KV.Val>:
  match m:
    case Some{KV.Item{+v, e}}:
      Some{v}
    case None{}:
      None{}

# a value read at now is the value of the entry there at now
def live_val_b(b: Bool, -v: KV.Val, -e: Nat) -> {item_val(Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{})) == KV.blive.ent(KV.Val, b, v) : Maybe<&2, KV.Val>}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def live_val_ent(m: Maybe<&2, KV.Item<KV.Val>>, +now: Nat) -> {item_val(R.ent.live(now, m)) == Laws.live_val(KV.Val, m, now) : Maybe<&2, KV.Val>}:
  match m:
    case Some{KV.Item{v, +e}}:
      live_val_b(KV.live(now, e), v, e)
    case None{}:
      {==}

# an entry there at now is the key's entry
def none_some(-y: KV.Item<KV.Val>, e: {None{} == Some{y} : Maybe<&2, KV.Item<KV.Val>>}) -> Empty:
  false_true(Equal.cong(Maybe<&2, KV.Item<KV.Val>>, Bool, z => Maybe.is_some(&2, KV.Item<KV.Val>, z), None{}, Some{y}, e))

def live_some_b(b: Bool, -v: KV.Val, -e: Nat, -y: KV.Item<KV.Val>) -> {Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{}) == Some{y} : Maybe<&2, KV.Item<KV.Val>>} -> {Some{KV.Item{v, e}} == Some{y} : Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case True{}:
      h => h
    case False{}:
      h => Empty.absurd({Some{KV.Item{v, e}} == Some{y} : Maybe<&2, KV.Item<KV.Val>>}, none_some(y, h))

def live_some(m: Maybe<&2, KV.Item<KV.Val>>, +now: Nat, -y: KV.Item<KV.Val>) -> {R.ent.live(now, m) == Some{y} : Maybe<&2, KV.Item<KV.Val>>} -> {m == Some{y} : Maybe<&2, KV.Item<KV.Val>>}:
  match m:
    case Some{KV.Item{v, +e}}:
      live_some_b(KV.live(now, e), v, e, y)
    case None{}:
      h => Empty.absurd({None{} == Some{y} : Maybe<&2, KV.Item<KV.Val>>}, none_some(y, h))

def get_missing_db(+db: R.Db, +k: String) -> {Laws.there(db, k) == None{} : Maybe<&2, KV.Item<KV.Val>>} -> {R.exec(R.Get{k}, db) == (R.RNull{}, db) : R.Reply & R.Db}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      e => %get_read(t, k, now) : {(R.r_getv(_), R.Db{t, n, x, now, rr}) == (R.RNull{}, R.Db{t, n, x, now, rr}) : R.Reply & R.Db}
           %live_val_ent(KV.entry(KV.Val, t, k), now) : {(R.r_getv(KV.got_of(_)), R.Db{t, n, x, now, rr}) == (R.RNull{}, R.Db{t, n, x, now, rr}) : R.Reply & R.Db}
           Equal.cong(Maybe<&2, KV.Item<KV.Val>>, R.Reply & R.Db, z => (R.r_getv(KV.got_of(item_val(z))), R.Db{t, n, x, now, rr}), R.ent.live(now, KV.entry(KV.Val, t, k)), None{}, e)

def Laws.get_missing(db, k, e):
  get_missing_db(db, k)(e)

def Laws.del_effect(ks, db, j, e):
  %bt(R.Del{ks}, db) : {KV.entry(KV.Val, _, j) == None{} : Maybe<&2, KV.Item<KV.Val>>}
  t_del_effect(ks, R.db.t(db), j, R.db.now(db), e)

def Laws.del_one_count(db, k):
  %br(R.Del{[k]}, db, {==}) : {_ == R.r_int(Bool.pick(Nat, Maybe.is_some(&2, KV.Item<KV.Val>, Laws.there(db, k)), 1n, 0n)) : R.Reply}
  t_del_one_count(R.db.t(db), k, R.db.now(db))

# APPEND, by the entry of its key: of a key not there, a SET; of one
# there, the value with s after it and the time kept (a key there holds a
# string: one that holds a collection is WRONGTYPE)
def app_put(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +c: Nat, +s: String) -> {Laws.at_key(R.upd.put(t, k, KV.hash(k), n, x, now, rr, c, R.upd.v(R.UAppend{s}, now, None{})), k) == (R.r_int(String.length(Laws.old_val(None{}) ++ s)), Some{KV.Item{KV.VStr{Laws.old_val(None{}) ++ s}, Laws.old_exp(None{})}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}:
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.setx(KV.Val, t, k, KV.VStr{s}, 0n), k), Some{KV.Item{KV.VStr{s}, 0n}}, Laws.entry_setx_same(KV.Val, t, k, KV.VStr{s}, 0n)) : {(R.r_int(String.length(s)), _) == (R.r_int(String.length(s)), Some{KV.Item{KV.VStr{s}, 0n}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
  {==}

def app_w(w: KV.Val, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +s: String, +e: Nat) -> {KV.entry(KV.Val, t, k) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>} -> {Laws.holds_coll(Some{KV.Item{w, e}}) == False{} : Bool} -> {Laws.at_key(R.upd.put(t, k, KV.hash(k), n, x, now, rr, 1n+e, R.upd.v(R.UAppend{s}, now, Some{KV.Item{w, e}})), k) == (R.r_int(String.length(Laws.old_val(Some{KV.Item{w, e}}) ++ s)), Some{KV.Item{KV.VStr{Laws.old_val(Some{KV.Item{w, e}}) ++ s}, Laws.old_exp(Some{KV.Item{w, e}})}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}:
  match w:
    case KV.VStr{+v}:
      eq => nc =>
        %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.keep(KV.Val, t, k, KV.VStr{v ++ s}), k), Some{KV.Item{KV.VStr{v ++ s}, Laws.keep_exp(KV.Val, KV.entry(KV.Val, t, k))}}, Laws.entry_keep_same(KV.Val, t, k, KV.VStr{v ++ s})) : {(R.r_int(String.length(v ++ s)), _) == (R.r_int(String.length(v ++ s)), Some{KV.Item{KV.VStr{v ++ s}, e}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
        %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, t, k), Some{KV.Item{KV.VStr{v}, e}}, eq) : {(R.r_int(String.length(v ++ s)), Some{KV.Item{KV.VStr{v ++ s}, Laws.keep_exp(KV.Val, _)}}) == (R.r_int(String.length(v ++ s)), Some{KV.Item{KV.VStr{v ++ s}, e}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
        {==}
    case KV.VColl{c}:
      eq => nc => Empty.absurd({Laws.at_key(R.upd.put(t, k, KV.hash(k), n, x, now, rr, 1n+e, R.upd.v(R.UAppend{s}, now, Some{KV.Item{KV.VColl{c}, e}})), k) == (R.r_int(String.length(Laws.old_val(Some{KV.Item{KV.VColl{c}, e}}) ++ s)), Some{KV.Item{KV.VStr{Laws.old_val(Some{KV.Item{KV.VColl{c}, e}}) ++ s}, Laws.old_exp(Some{KV.Item{KV.VColl{c}, e}})}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}, true_false(nc))

def app_b(b: Bool, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +s: String, +w: KV.Val, +e: Nat, +eq: {KV.entry(KV.Val, t, k) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>}) -> {Laws.holds_coll(Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{w, e}}, None{})) == False{} : Bool} -> {Laws.at_key(R.upd.put(t, k, KV.hash(k), n, x, now, rr, 1n+e, R.upd.v(R.UAppend{s}, now, Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{w, e}}, None{}))), k) == (R.r_int(String.length(Laws.old_val(Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{w, e}}, None{})) ++ s)), Some{KV.Item{KV.VStr{Laws.old_val(Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{w, e}}, None{})) ++ s}, Laws.old_exp(Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{w, e}}, None{}))}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case True{}:
      nc => app_w(w, t, k, n, x, now, rr, s, e)(eq)(nc)
    case False{}:
      nc => app_put(t, k, n, x, now, rr, 1n+e, s)

def app_m(m: Maybe<&2, KV.Item<KV.Val>>, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +s: String) -> {KV.entry(KV.Val, t, k) == m : Maybe<&2, KV.Item<KV.Val>>} -> {Laws.holds_coll(R.ent.live(now, m)) == False{} : Bool} -> {Laws.at_key(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), R.upd.v(R.UAppend{s}, now, R.ent.live(now, m))), k) == (R.r_int(String.length(Laws.old_val(R.ent.live(now, m)) ++ s)), Some{KV.Item{KV.VStr{Laws.old_val(R.ent.live(now, m)) ++ s}, Laws.old_exp(R.ent.live(now, m))}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}:
  match m:
    case None{}:
      eq => nc => app_put(t, k, n, x, now, rr, 0n, s)
    case Some{KV.Item{+w, +e}}:
      eq => nc => app_b(KV.live(now, e), t, k, n, x, now, rr, s, w, e, eq)(nc)

def append_db(+db: R.Db, +k: String, +s: String) -> {Laws.holds_coll(Laws.there(db, k)) == False{} : Bool} -> {Laws.at_key(R.exec(R.Upd{k, R.UAppend{s}}, db), k) == (R.r_int(String.length(Laws.old_val(Laws.there(db, k)) ++ s)), Some{KV.Item{KV.VStr{Laws.old_val(Laws.there(db, k)) ++ s}, Laws.old_exp(Laws.there(db, k))}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      nc =>
        %entry_at_eq(KV.Val, t, k) : {Laws.at_key(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(_), R.upd.v(R.UAppend{s}, now, R.ent.live(now, _))), k) == (R.r_int(String.length(Laws.old_val(R.ent.live(now, KV.entry(KV.Val, t, k))) ++ s)), Some{KV.Item{KV.VStr{Laws.old_val(R.ent.live(now, KV.entry(KV.Val, t, k))) ++ s}, Laws.old_exp(R.ent.live(now, KV.entry(KV.Val, t, k)))}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
        app_m(KV.entry(KV.Val, t, k), t, k, n, x, now, rr, s)({==})(nc)

def Laws.append_effect(db, k, s, nc):
  append_db(db, k, s)(nc)

def setnx_missing_db(+db: R.Db, +k: String, +v: String) -> {Laws.there(db, k) == None{} : Maybe<&2, KV.Item<KV.Val>>} -> {Laws.at_key(R.exec(R.Upd{k, R.USetNx{v}}, db), k) == (R.r_int(1n), Some{KV.Item{KV.VStr{v}, 0n}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      h =>
        %entry_at_eq(KV.Val, t, k) : {Laws.at_key(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(_), R.upd.v(R.USetNx{v}, now, R.ent.live(now, _))), k) == (R.r_int(1n), Some{KV.Item{KV.VStr{v}, 0n}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
        %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(now, KV.entry(KV.Val, t, k)), None{}, h) : {Laws.at_key(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry(KV.Val, t, k)), R.upd.v(R.USetNx{v}, now, _)), k) == (R.r_int(1n), Some{KV.Item{KV.VStr{v}, 0n}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
        %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.setx(KV.Val, t, k, KV.VStr{v}, 0n), k), Some{KV.Item{KV.VStr{v}, 0n}}, Laws.entry_setx_same(KV.Val, t, k, KV.VStr{v}, 0n)) : {(R.r_int(1n), _) == (R.r_int(1n), Some{KV.Item{KV.VStr{v}, 0n}}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
        {==}

def Laws.setnx_missing(db, k, v, h):
  setnx_missing_db(db, k, v)(h)

# SETNX of a key there, of any kind, finds it there
def setnx_w(+w: KV.Val, +e: Nat, +v: String, +now: Nat) -> {R.upd.v(R.USetNx{v}, now, Some{KV.Item{w, e}}) == R.Out{R.r_int(0n), R.CKeep{}} : R.Out}:
  match w:
    case KV.VStr{u}:
      {==}
    case KV.VColl{c}:
      {==}

def setnx_some(+y: KV.Item<KV.Val>, +v: String, +now: Nat) -> {R.upd.v(R.USetNx{v}, now, Some{y}) == R.Out{R.r_int(0n), R.CKeep{}} : R.Out}:
  match y:
    case KV.Item{+w, +e}:
      setnx_w(w, e, v, now)

def setnx_present_db(+db: R.Db, +k: String, +v: String, +y: KV.Item<KV.Val>) -> {Laws.there(db, k) == Some{y} : Maybe<&2, KV.Item<KV.Val>>} -> {R.exec(R.Upd{k, R.USetNx{v}}, db) == (R.r_int(0n), db) : R.Reply & R.Db}:
