def counted_ren_of(m: Maybe<&2, KV.Item<KV.Val>>, same: Bool, held: Bool, +nx: Bool, +src: String, +dst: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {m == R.ent.live(now, KV.entry.at(KV.Val, t, src, KV.hash(src))) : Maybe<&2, KV.Item<KV.Val>>} -> {same == KV.str_eq(src, dst) : Bool} -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {Laws.counted(R.db_of(R.ren.do(R.ren.of(m, same, held), nx, src, dst, R.Db{t, n, x, now, rr}))) == True{} : Bool}:
  match m same held:
