    case 0n Nil{}:
      ey => ex => {==}
    case 1n+i Nil{}:
      ey => ex => {==}

def counted_nth(j: Nat, xs: List<&2, R.Db>) -> {Laws.counted_list(xs) == True{} : Bool} -> {counted_mdb(R.ds.nth(j, xs)) == True{} : Bool}:
  match j xs:
    case 0n Con{+x, +rest}:
      ex => and_l(Laws.counted(x), Laws.counted_list(rest))(ex)
    case 1n+i Con{+x, +rest}:
      ex => counted_nth(i, rest)(and_r(Laws.counted(x), Laws.counted_list(rest))(ex))
    case 0n Nil{}:
      ex => {==}
    case 1n+i Nil{}:
      ex => {==}

def counted_focus_if(same: Bool, +j: Nat, +ds: R.Ds) -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds.focus.if(same, j, ds)) == True{} : Bool}:
