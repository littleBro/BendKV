# END gen_trie: tsize

# DBSIZE of a database counted answers the trie's size
def counted_dbsize(db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {R.reply_of(R.exec(R.DbSize{}, db)) == R.r_int(KV.size(KV.Val, R.db.t(db))) : R.Reply}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      ok => Equal.cong(Nat, R.Reply, z => R.r_int(z), n, KV.tsize(KV.Val, t), Equal.trans(Nat, n, Laws.tsum(KV.Val, Laws.WAll{}, t), KV.tsize(KV.Val, t), counted_n(t, n, x, now, rr)(ok), tsum_size(KV.Val, t)))

# the database in focus is counted when every database is
def counted_focused(+ds: R.Ds) -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted(R.ds.focused(ds)) == True{} : Bool}:
  match ds:
    case R.Ds{+d, +pre, +post}:
      e => and_l(Laws.counted(d), Bool.and(Laws.counted_list(pre), Laws.counted_list(post)))(e)

def Laws.counts_hold(hist, n):
  counted_single(hist, n)

def Laws.dbsize_size(hist, n):
  counted_dbsize(R.ds.focused(Laws.single(hist, n)))(counted_focused(Laws.single(hist, n))(counted_single(hist, n)))
