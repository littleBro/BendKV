def act_run_ds(r: R.Reply & R.Db, -pre: List<&2, R.Db>, -post: List<&2, R.Db>) -> {R.ds_of(R.act.run(r, pre, post)) == R.Ds{R.db_of(r), pre, post} : R.Ds}:
