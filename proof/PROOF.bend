      +e => counted_or_ds(R.ds.pick(j, R.ds.now(ds), Nil{}, R.ds.list(ds)), ds)(counted_pick(j, R.ds.now(ds), Nil{}, R.ds.list(ds))({==})(counted_ds_list(ds)(e)))(e)

def counted_swap_of(+a: Nat, +b: Nat, ma: Maybe<&2, R.Db>, mb: Maybe<&2, R.Db>, +xs: List<&2, R.Db>, +ds: R.Ds) -> {counted_mdb(ma) == True{} : Bool} -> {counted_mdb(mb) == True{} : Bool} -> {Laws.counted_list(xs) == True{} : Bool} -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds_of(R.act.ok(R.ds.swap.of(a, b, ma, mb, xs, ds)))) == True{} : Bool}:
