# The commands' writes, counted
# -----------------------------
def counted_set(db: R.Db, +k: String, +v: String) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db.set(db, k, v)) == True{} : Bool}:
  match db:
