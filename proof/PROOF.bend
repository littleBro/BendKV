# a bucket that holds a key once is a well-formed trie of depth 0
def twf0(-V: Data, b: KV.Trie<V>) -> {Laws.bwf(V, b) == True{} : Bool} -> {Laws.twf(V, b, 0n) == True{} : Bool}:
  match b:
    case KV.Tip{}:
      g => {==}
    case KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15}:
      g => {==}
    case KV.Ent{k, v, e, rest}:
      g => g
# END gen_trie: tmod

# BEGIN gen_trie: tdel
