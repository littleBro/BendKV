      ok => %Equal.sym(Nat, Nat.sub(n, Nat.add(g, Bool.pick(Nat, Nat.is_eq(c, 0n), 0n, 1n))), Nat.sub(Nat.sub(n, Bool.pick(Nat, Nat.is_eq(c, 0n), 0n, 1n)), g), sub_add2(n, g, Bool.pick(Nat, Nat.is_eq(c, 0n), 0n, 1n))) : {Laws.counted(R.Db{u, _, Nat.sub(x, Nat.add(gx, Bool.pick(Nat, Nat.is_lt(1n, c), 1n, 0n))), now, rr}) == True{} : Bool}
            %Equal.sym(Nat, Nat.sub(x, Nat.add(gx, Bool.pick(Nat, Nat.is_lt(1n, c), 1n, 0n))), Nat.sub(Nat.sub(x, Bool.pick(Nat, Nat.is_lt(1n, c), 1n, 0n)), gx), sub_add2(x, gx, Bool.pick(Nat, Nat.is_lt(1n, c), 1n, 0n))) : {Laws.counted(R.Db{u, Nat.sub(Nat.sub(n, Bool.pick(Nat, Nat.is_eq(c, 0n), 0n, 1n)), g), _, now, rr}) == True{} : Bool}
