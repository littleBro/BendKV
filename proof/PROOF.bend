def counted_renamed(+t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +src: String, +dst: String, +v: KV.Val, +e: Nat) -> {KV.code.at(KV.Val, KV.setx.at(KV.Val, t, dst, v, e, KV.hash(dst)), src, KV.hash(src)) == 1n+e : Nat} -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {Laws.counted(R.db.renamed(R.Db{t, n, x, now, rr}, src, dst, v, e)) == True{} : Bool}:
