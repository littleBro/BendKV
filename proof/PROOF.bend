def tsum_tnode_if(-V: Data, +w: Laws.Wt, z: Bool, t: KV.Trie<V>) -> {Laws.tsum(V, w, KV.tnode_if(V, z, t)) == Laws.tsum(V, w, t) : Nat}:
  match z:
    case True{}:
      tsum_tnode(V, w, t)
    case False{}:
      {==}

