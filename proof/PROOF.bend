def counted_move_of(+k: String, +j: Nat, my: Maybe<&2, R.Db>, +ds: R.Ds) -> {counted_mdb(my) == True{} : Bool} -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds_of(R.act.moved(R.ds.move.of(k, j, my, ds)))) == True{} : Bool}:
