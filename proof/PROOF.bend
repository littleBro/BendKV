    case Some{KV.Item{+v, +e}} False{} False{}:
      em => es => counted_renamed(t, n, x, now, rr, src, dst, v, e)(ren_there(t, src, dst, v, e, now)(em)(es))

def counted_rename(db: R.Db, +src: String, +dst: String, +nx: Bool) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.db.rename(db, src, dst, nx))) == True{} : Bool}:
