def counted_keepl(db: R.Db, +k: String, +l: KV.Deq, -w: KV.Val, +q: Nat) -> {R.db.ent(db, k) == Some{KV.Item{w, q}} : Maybe<&2, KV.Item<KV.Val>>} -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db.keepl(db, k, l)) == True{} : Bool}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      e => cnt_keep_there(t, k, KV.VColl{KV.CList{l}}, KV.hash(k), n, x, now, rr, q, there_code(t, k, now, w, q)(e))

# DEL of keys, one after another: a key there leaves one entry less, and
# one that can expire less when it had a time
def dead_all(c: Nat) -> {dead(Laws.WAll{}, c) == Bool.pick(Nat, Nat.is_eq(c, 0n), 0n, 1n) : Nat}:
  match c:
    case 0n:
      {==}
    case 1n+q:
      {==}

def sub_add2(n: Nat, +a: Nat, b: Nat) -> {Nat.sub(n, Nat.add(a, b)) == Nat.sub(Nat.sub(n, b), a) : Nat}:
  match n b:
    case 0n _:
      {==}
    case 1n+m 0n:
      %add_zero(a) : {Nat.sub(1n+m, _) == Nat.sub(1n+m, a) : Nat}
      {==}
    case 1n+m 1n+c:
      %Equal.sym(Nat, Nat.add(a, 1n+c), 1n+Nat.add(a, c), add_succ_r(a, c)) : {Nat.sub(1n+m, _) == Nat.sub(Nat.sub(m, c), a) : Nat}
      sub_add2(m, a, c)

