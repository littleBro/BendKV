  +ok => counted_mk(KV.del.at(KV.Val, t, k, h), Nat.sub(n, 1n), R.cnt.x(1n+q, 0n, x), now, rr)(wf_del(KV.Val, t, k, h)(counted_wf(t, n, x, now, rr)(ok)))(Equal.trans(Nat, Nat.sub(n, 1n), Nat.sub(Laws.tsum(KV.Val, Laws.WAll{}, t), 1n), Laws.tsum(KV.Val, Laws.WAll{}, KV.del.at(KV.Val, t, k, h)), Equal.cong(Nat, Nat, z => Nat.sub(z, 1n), n, Laws.tsum(KV.Val, Laws.WAll{}, t), counted_n(t, n, x, now, rr)(ok)), Equal.sym(Nat, Laws.tsum(KV.Val, Laws.WAll{}, KV.del.at(KV.Val, t, k, h)), Nat.sub(Laws.tsum(KV.Val, Laws.WAll{}, t), 1n), n_del(q, Laws.tsum(KV.Val, Laws.WAll{}, t), Laws.tsum(KV.Val, Laws.WAll{}, KV.del.at(KV.Val, t, k, h)))(sum_del_there(KV.Val, Laws.WAll{}, t, k, h, q)(eC)(counted_wf(t, n, x, now, rr)(ok))))))(Equal.trans(Nat, R.cnt.x(1n+q, 0n, x), R.cnt.x(1n+q, 0n, Laws.tsum(KV.Val, Laws.WTimed{}, t)), Laws.tsum(KV.Val, Laws.WTimed{}, KV.del.at(KV.Val, t, k, h)), Equal.cong(Nat, Nat, z => R.cnt.x(1n+q, 0n, z), x, Laws.tsum(KV.Val, Laws.WTimed{}, t), counted_x(t, n, x, now, rr)(ok)), Equal.sym(Nat, Laws.tsum(KV.Val, Laws.WTimed{}, KV.del.at(KV.Val, t, k, h)), R.cnt.x(1n+q, 0n, Laws.tsum(KV.Val, Laws.WTimed{}, t)), x_del(1n+q, Laws.tsum(KV.Val, Laws.WTimed{}, t), Laws.tsum(KV.Val, Laws.WTimed{}, KV.del.at(KV.Val, t, k, h)))(sum_del_there(KV.Val, Laws.WTimed{}, t, k, h, q)(eC)(counted_wf(t, n, x, now, rr)(ok))))))

# a change an update makes keeps the database counted: a change that
# finds its key there (by Good) has the key's code 1 + q
def counted_ch(ch: R.Change, m: Maybe<&2, KV.Item<KV.Val>>, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply) -> Good(m, ch) -> {R.ent.code(m) == KV.code.at(KV.Val, t, k, KV.hash(k)) : Nat} -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {Laws.counted(R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, ch))) == True{} : Bool}:
  match ch m:
    case R.CKeep{} m:
      g => ec => ok => ok
    case R.CDel{} Some{KV.Item{w, +q}}:
      g => ec => ok => cnt_del(t, k, KV.hash(k), n, x, now, rr, q, Equal.sym(Nat, 1n+q, KV.code.at(KV.Val, t, k, KV.hash(k)), ec))(ok)
    case R.CDel{} None{}:
      g => ec => ok => Empty.absurd({Laws.counted(R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CDel{}))) == True{} : Bool}, false_true(g))
    case R.CExp{f} Some{KV.Item{w, +q}}:
      g => ec => ok => cnt_expire(t, k, f, KV.hash(k), n, x, now, rr, q, Equal.sym(Nat, 1n+q, KV.code.at(KV.Val, t, k, KV.hash(k)), ec))(ok)
    case R.CExp{f} None{}:
      g => ec => ok => Empty.absurd({Laws.counted(R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CExp{f}))) == True{} : Bool}, g)
    case R.CPut{v, f} m:
      g => ec => ok => %Equal.sym(Nat, R.ent.code(m), KV.code.at(KV.Val, t, k, KV.hash(k)), ec) : {Laws.counted(R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, _, r, R.CPut{v, f}))) == True{} : Bool}
                       cnt_setx(t, k, KV.VStr{v}, f, KV.hash(k), n, x, now, rr)(ok)
    case R.CKeepT{v} m:
      g => ec => ok => %Equal.sym(Nat, R.ent.code(m), KV.code.at(KV.Val, t, k, KV.hash(k)), ec) : {Laws.counted(R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, _, r, R.CKeepT{v}))) == True{} : Bool}
                       cnt_keep(t, k, KV.VStr{v}, KV.hash(k), n, x, now, rr)(ok)
    case R.CApp{s, v} m:
      g => ec => ok => %Equal.sym(Nat, R.ent.code(m), KV.code.at(KV.Val, t, k, KV.hash(k)), ec) : {Laws.counted(R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, _, r, R.CApp{s, v}))) == True{} : Bool}
                       cnt_keep(t, k, KV.VStr{v}, KV.hash(k), n, x, now, rr)(ok)
    case R.CRange{o, s, v} m:
      g => ec => ok => %Equal.sym(Nat, R.ent.code(m), KV.code.at(KV.Val, t, k, KV.hash(k)), ec) : {Laws.counted(R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, _, r, R.CRange{o, s, v}))) == True{} : Bool}
                       cnt_keep(t, k, KV.VStr{v}, KV.hash(k), n, x, now, rr)(ok)
    case R.CHash{op, hv} Some{KV.Item{w, +q}}:
      g => ec => ok => cnt_keep_there(t, k, KV.VColl{KV.CHash{hv}}, KV.hash(k), n, x, now, rr, q, Equal.sym(Nat, 1n+q, KV.code.at(KV.Val, t, k, KV.hash(k)), ec))(ok)
    case R.CHash{op, hv} None{}:
      g => ec => ok => Empty.absurd({Laws.counted(R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CHash{op, hv}))) == True{} : Bool}, g)
    case R.CHashNew{ps, hv} m:
      g => ec => ok => %Equal.sym(Nat, R.ent.code(m), KV.code.at(KV.Val, t, k, KV.hash(k)), ec) : {Laws.counted(R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, _, r, R.CHashNew{ps, hv}))) == True{} : Bool}
                       cnt_setx(t, k, KV.VColl{KV.CHash{hv}}, 0n, KV.hash(k), n, x, now, rr)(ok)
    case R.CList{op, lv} Some{KV.Item{w, +q}}:
      g => ec => ok => cnt_keep_there(t, k, KV.VColl{KV.CList{lv}}, KV.hash(k), n, x, now, rr, q, Equal.sym(Nat, 1n+q, KV.code.at(KV.Val, t, k, KV.hash(k)), ec))(ok)
    case R.CList{op, lv} None{}:
      g => ec => ok => Empty.absurd({Laws.counted(R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CList{op, lv}))) == True{} : Bool}, g)
    case R.CListNew{left, xs, lv} m:
