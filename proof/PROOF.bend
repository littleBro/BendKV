# The writes of a key
# -------------------
# a write of key k weighs the trie as it weighs k's bucket, in terms of
# k's code before it (KV.code.at), and leaves the trie well formed
def code_b(-V: Data, +t: KV.Trie<V>, +k: String, +h: U32) -> {KV.bcode(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h)) == KV.code.at(V, t, k, h) : Nat}:
  tget_kx_eq(V, 5n, t, KV.hex(h), h, k)

def sum_setx(-V: Data, +w: Laws.Wt, +t: KV.Trie<V>, +k: String, +v: V, +e: Nat, +h: U32) -> {Laws.twf(V, t, 5n) == True{} : Bool} -> {Nat.add(Laws.tsum(V, w, KV.setx.at(V, t, k, v, e, h)), dead(w, KV.code.at(V, t, k, h))) == Nat.add(Laws.tsum(V, w, t), Laws.wt(w, e)) : Nat}:
  wf => %code_b(V, t, k, h) : {Nat.add(Laws.tsum(V, w, KV.setx.at(V, t, k, v, e, h)), dead(w, _)) == Nat.add(Laws.tsum(V, w, t), Laws.wt(w, e)) : Nat}
        tsum_mod(V, w, 5n, t, KV.hex(h), h, KV.OSet{k, v, e}, dead(w, KV.bcode(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h))), Laws.wt(w, e))(wf)(bset_sum(V, w, k, v, e, KV.tget_h(V, 5n, t, KV.hex(h), h), KV.bhead(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h))))

def sum_keep(-V: Data, +w: Laws.Wt, +t: KV.Trie<V>, +k: String, +v: V, +h: U32) -> {Laws.twf(V, t, 5n) == True{} : Bool} -> {Nat.add(Laws.tsum(V, w, KV.keep.at(V, t, k, v, h)), dead(w, KV.code.at(V, t, k, h))) == Nat.add(Laws.tsum(V, w, t), kept(w, KV.code.at(V, t, k, h))) : Nat}:
  wf => %code_b(V, t, k, h) : {Nat.add(Laws.tsum(V, w, KV.keep.at(V, t, k, v, h)), dead(w, _)) == Nat.add(Laws.tsum(V, w, t), kept(w, _)) : Nat}
        tsum_mod(V, w, 5n, t, KV.hex(h), h, KV.OKeep{k, v}, dead(w, KV.bcode(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h))), kept(w, KV.bcode(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h))))(wf)(bkeep_sum(V, w, k, v, KV.tget_h(V, 5n, t, KV.hex(h), h), KV.bhead(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h))))

def sum_expire(-V: Data, +w: Laws.Wt, +t: KV.Trie<V>, +k: String, +e: Nat, +h: U32) -> {Laws.twf(V, t, 5n) == True{} : Bool} -> {Nat.add(Laws.tsum(V, w, KV.expire.at(V, t, k, e, h)), dead(w, KV.code.at(V, t, k, h))) == Nat.add(Laws.tsum(V, w, t), timew(w, KV.code.at(V, t, k, h), e)) : Nat}:
  wf => %code_b(V, t, k, h) : {Nat.add(Laws.tsum(V, w, KV.expire.at(V, t, k, e, h)), dead(w, _)) == Nat.add(Laws.tsum(V, w, t), timew(w, _, e)) : Nat}
        tsum_mod(V, w, 5n, t, KV.hex(h), h, KV.OExp{k, e}, dead(w, KV.bcode(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h))), timew(w, KV.bcode(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h)), e))(wf)(bexp_sum(V, w, k, e, KV.tget_h(V, 5n, t, KV.hex(h), h), KV.bhead(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h))))

def sum_del(-V: Data, +w: Laws.Wt, +t: KV.Trie<V>, +k: String, +h: U32) -> {Laws.twf(V, t, 5n) == True{} : Bool} -> {Nat.add(Laws.tsum(V, w, KV.del.at(V, t, k, h)), dead(w, KV.code.at(V, t, k, h))) == Nat.add(Laws.tsum(V, w, t), 0n) : Nat}:
  +wf => %code_b(V, t, k, h) : {Nat.add(Laws.tsum(V, w, KV.del.at(V, t, k, h)), dead(w, _)) == Nat.add(Laws.tsum(V, w, t), 0n) : Nat}
         tsum_del(V, w, 5n, t, KV.hex(h), h, k, dead(w, KV.bcode(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h))), 0n)(wf)(Equal.trans(Nat, Nat.add(Laws.tsum(V, w, KV.bdel(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h))), dead(w, KV.bcode(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h)))), Laws.tsum(V, w, KV.tget_h(V, 5n, t, KV.hex(h), h)), Nat.add(Laws.tsum(V, w, KV.tget_h(V, 5n, t, KV.hex(h), h)), 0n), bdel_sum(V, w, k, KV.tget_h(V, 5n, t, KV.hex(h), h), KV.bhead(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h)))({==})(twf_b(V, 5n, t, KV.hex(h), h)(wf)), add_zero(Laws.tsum(V, w, KV.tget_h(V, 5n, t, KV.hex(h), h)))))

def wf_setx(-V: Data, +t: KV.Trie<V>, +k: String, +v: V, +e: Nat, +h: U32) -> {Laws.twf(V, t, 5n) == True{} : Bool} -> {Laws.twf(V, KV.setx.at(V, t, k, v, e, h), 5n) == True{} : Bool}:
  +wf => twf_mod(V, 5n, t, KV.hex(h), h, KV.OSet{k, v, e})(wf)(twf0(V, KV.bset(V, k, v, e, KV.tget_h(V, 5n, t, KV.hex(h), h)))(bset_wf(V, k, v, e, KV.tget_h(V, 5n, t, KV.hex(h), h), KV.bhead(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h)))({==})(twf_b(V, 5n, t, KV.hex(h), h)(wf))))

def wf_keep(-V: Data, +t: KV.Trie<V>, +k: String, +v: V, +h: U32) -> {Laws.twf(V, t, 5n) == True{} : Bool} -> {Laws.twf(V, KV.keep.at(V, t, k, v, h), 5n) == True{} : Bool}:
  +wf => twf_mod(V, 5n, t, KV.hex(h), h, KV.OKeep{k, v})(wf)(twf0(V, KV.bkeep(V, k, v, KV.tget_h(V, 5n, t, KV.hex(h), h)))(bkeep_wf(V, k, v, KV.tget_h(V, 5n, t, KV.hex(h), h), KV.bhead(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h)))({==})(twf_b(V, 5n, t, KV.hex(h), h)(wf))))

def wf_expire(-V: Data, +t: KV.Trie<V>, +k: String, +e: Nat, +h: U32) -> {Laws.twf(V, t, 5n) == True{} : Bool} -> {Laws.twf(V, KV.expire.at(V, t, k, e, h), 5n) == True{} : Bool}:
  +wf => twf_mod(V, 5n, t, KV.hex(h), h, KV.OExp{k, e})(wf)(twf0(V, KV.bexp(V, k, e, KV.tget_h(V, 5n, t, KV.hex(h), h)))(bexp_wf(V, k, e, KV.tget_h(V, 5n, t, KV.hex(h), h), KV.bhead(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h)))({==})(twf_b(V, 5n, t, KV.hex(h), h)(wf))))

def wf_del(-V: Data, +t: KV.Trie<V>, +k: String, +h: U32) -> {Laws.twf(V, t, 5n) == True{} : Bool} -> {Laws.twf(V, KV.del.at(V, t, k, h), 5n) == True{} : Bool}:
  +wf => twf_del(V, 5n, t, KV.hex(h), h, k)(wf)(twf0(V, KV.bdel(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h)))(bdel_wf(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h), KV.bhead(V, k, KV.tget_h(V, 5n, t, KV.hex(h), h)))({==})(twf_b(V, 5n, t, KV.hex(h), h)(wf))))

# The counts of a write
# ---------------------
def dead_timed1(e: Nat) -> {Laws.wt(Laws.WTimed{}, e) == Bool.pick(Nat, Nat.is_lt(1n, 1n+e), 1n, 0n) : Nat}:
  match e:
    case 0n:
      {==}
    case 1n+q:
      {==}

# the code of a key with a time: past 1
def dead_timed(c: Nat) -> {dead(Laws.WTimed{}, c) == Bool.pick(Nat, Nat.is_lt(1n, c), 1n, 0n) : Nat}:
  match c:
    case 0n:
      {==}
    case 1n+e:
      dead_timed1(e)

# n after a write that sets k (cnt.n), keeps its time, sets its time, or
# deletes it; x likewise (cnt.x)
def n_set(c: Nat, +s: Nat, +u: Nat) -> {Nat.add(u, dead(Laws.WAll{}, c)) == Nat.add(s, 1n) : Nat} -> {u == R.cnt.n(c, s) : Nat}:
  match c:
    case 0n:
      e => Equal.trans(Nat, u, Nat.add(u, 0n), 1n+s, add_zero(u), Equal.trans(Nat, Nat.add(u, 0n), Nat.add(s, 1n), 1n+s, e, Equal.trans(Nat, Nat.add(s, 1n), 1n+Nat.add(s, 0n), 1n+s, add_succ_r(s, 0n), Equal.cong(Nat, Nat, z => 1n+z, Nat.add(s, 0n), s, Equal.sym(Nat, s, Nat.add(s, 0n), add_zero(s))))))
    case 1n+q:
      e => add_cancel(1n, u, s)(e)

def n_keep(c: Nat, +s: Nat, +u: Nat) -> {Nat.add(u, dead(Laws.WAll{}, c)) == Nat.add(s, kept(Laws.WAll{}, c)) : Nat} -> {u == R.cnt.n(c, s) : Nat}:
  match c:
    case 0n:
      e => n_set(0n, s, u)(e)
    case 1n+q:
      e => add_cancel(1n, u, s)(e)

def n_same(c: Nat, +s: Nat, +u: Nat, -e: Nat) -> {Nat.add(u, dead(Laws.WAll{}, c)) == Nat.add(s, timew(Laws.WAll{}, c, e)) : Nat} -> {u == s : Nat}:
  match c:
    case 0n:
      g => add_cancel(0n, u, s)(g)
    case 1n+q:
      g => add_cancel(1n, u, s)(g)

def n_del(-q: Nat, +s: Nat, +u: Nat) -> {Nat.add(u, dead(Laws.WAll{}, 1n+q)) == Nat.add(s, 0n) : Nat} -> {u == Nat.sub(s, 1n) : Nat}:
  e => %Equal.sym(Nat, s, Nat.add(s, 0n), add_zero(s)) : {u == Nat.sub(_, 1n) : Nat}
       sub_of_add(u, 1n, Nat.add(s, 0n))(e)

def x_set(+c: Nat, +e: Nat, +s: Nat, +u: Nat) -> {Nat.add(u, dead(Laws.WTimed{}, c)) == Nat.add(s, Laws.wt(Laws.WTimed{}, e)) : Nat} -> {u == R.cnt.x(c, e, s) : Nat}:
  g => %dead_timed(c) : {u == Nat.sub(Nat.add(s, Laws.wt(Laws.WTimed{}, e)), _) : Nat}
       sub_of_add(u, dead(Laws.WTimed{}, c), Nat.add(s, Laws.wt(Laws.WTimed{}, e)))(g)

def x_keep(c: Nat, +s: Nat, +u: Nat) -> {Nat.add(u, dead(Laws.WTimed{}, c)) == Nat.add(s, kept(Laws.WTimed{}, c)) : Nat} -> {u == s : Nat}:
  match c:
    case 0n:
      g => add_cancel(0n, u, s)(g)
    case 1n+q:
      g => add_cancel(Laws.wt(Laws.WTimed{}, q), u, s)(g)

def x_same(c: Nat, +s: Nat, +u: Nat) -> {Nat.add(u, dead(Laws.WTimed{}, c)) == Nat.add(s, timew(Laws.WTimed{}, c, 0n)) : Nat} -> {u == R.cnt.x(c, 0n, s) : Nat}:
  match c:
    case 0n:
      g => Equal.trans(Nat, u, s, R.cnt.x(0n, 0n, s), add_cancel(0n, u, s)(g), Equal.trans(Nat, s, Nat.add(s, 0n), Nat.sub(Nat.add(s, 0n), 0n), add_zero(s), Equal.sym(Nat, Nat.sub(Nat.add(s, 0n), 0n), Nat.add(s, 0n), sub_zero(Nat.add(s, 0n)))))
    case 1n+q:
      g => x_set(1n+q, 0n, s, u)(g)

def x_del(+c: Nat, +s: Nat, +u: Nat) -> {Nat.add(u, dead(Laws.WTimed{}, c)) == Nat.add(s, 0n) : Nat} -> {u == R.cnt.x(c, 0n, s) : Nat}:
  g => x_set(c, 0n, s, u)(g)

# the weights after a write of a key that is there, of code 1 + q
def sum_expire_there(-V: Data, +w: Laws.Wt, +t: KV.Trie<V>, +k: String, +e: Nat, +h: U32, -q: Nat) -> {KV.code.at(V, t, k, h) == 1n+q : Nat} -> {Laws.twf(V, t, 5n) == True{} : Bool} -> {Nat.add(Laws.tsum(V, w, KV.expire.at(V, t, k, e, h)), dead(w, 1n+q)) == Nat.add(Laws.tsum(V, w, t), Laws.wt(w, e)) : Nat}:
  eC => wf => %eC : {Nat.add(Laws.tsum(V, w, KV.expire.at(V, t, k, e, h)), dead(w, _)) == Nat.add(Laws.tsum(V, w, t), timew(w, _, e)) : Nat}
              sum_expire(V, w, t, k, e, h)(wf)

def sum_del_there(-V: Data, +w: Laws.Wt, +t: KV.Trie<V>, +k: String, +h: U32, -q: Nat) -> {KV.code.at(V, t, k, h) == 1n+q : Nat} -> {Laws.twf(V, t, 5n) == True{} : Bool} -> {Nat.add(Laws.tsum(V, w, KV.del.at(V, t, k, h)), dead(w, 1n+q)) == Nat.add(Laws.tsum(V, w, t), 0n) : Nat}:
  eC => wf => %eC : {Nat.add(Laws.tsum(V, w, KV.del.at(V, t, k, h)), dead(w, _)) == Nat.add(Laws.tsum(V, w, t), 0n) : Nat}
              sum_del(V, w, t, k, h)(wf)

# The counts of a database
# ------------------------
# what a database counted says of its trie and its counts, and back

def counted_wf(+t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, -now: Nat, -rr: Maybe<&2, R.Db>) -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {Laws.twf(KV.Val, t, 5n) == True{} : Bool}:
  ok => and_l(Laws.twf(KV.Val, t, 5n), Bool.and(Nat.is_eq(n, Laws.tsum(KV.Val, Laws.WAll{}, t)), Nat.is_eq(x, Laws.tsum(KV.Val, Laws.WTimed{}, t))))(ok)

def counted_n(+t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, -now: Nat, -rr: Maybe<&2, R.Db>) -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {n == Laws.tsum(KV.Val, Laws.WAll{}, t) : Nat}:
  ok => nat_eq(n, Laws.tsum(KV.Val, Laws.WAll{}, t))(and_l(Nat.is_eq(n, Laws.tsum(KV.Val, Laws.WAll{}, t)), Nat.is_eq(x, Laws.tsum(KV.Val, Laws.WTimed{}, t)))(and_r(Laws.twf(KV.Val, t, 5n), Bool.and(Nat.is_eq(n, Laws.tsum(KV.Val, Laws.WAll{}, t)), Nat.is_eq(x, Laws.tsum(KV.Val, Laws.WTimed{}, t))))(ok)))

def counted_x(+t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, -now: Nat, -rr: Maybe<&2, R.Db>) -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {x == Laws.tsum(KV.Val, Laws.WTimed{}, t) : Nat}:
  ok => nat_eq(x, Laws.tsum(KV.Val, Laws.WTimed{}, t))(and_r(Nat.is_eq(n, Laws.tsum(KV.Val, Laws.WAll{}, t)), Nat.is_eq(x, Laws.tsum(KV.Val, Laws.WTimed{}, t)))(and_r(Laws.twf(KV.Val, t, 5n), Bool.and(Nat.is_eq(n, Laws.tsum(KV.Val, Laws.WAll{}, t)), Nat.is_eq(x, Laws.tsum(KV.Val, Laws.WTimed{}, t))))(ok)))

def is_eq_of(+a: Nat, -b: Nat) -> {a == b : Nat} -> {Nat.is_eq(a, b) == True{} : Bool}:
  e => %e : {Nat.is_eq(a, _) == True{} : Bool}
       nat_refl(a)

def counted_mk(+t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, -now: Nat, -rr: Maybe<&2, R.Db>) -> {Laws.twf(KV.Val, t, 5n) == True{} : Bool} -> {n == Laws.tsum(KV.Val, Laws.WAll{}, t) : Nat} -> {x == Laws.tsum(KV.Val, Laws.WTimed{}, t) : Nat} -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool}:
  wf => en => ex => and_true(Laws.twf(KV.Val, t, 5n), Bool.and(Nat.is_eq(n, Laws.tsum(KV.Val, Laws.WAll{}, t)), Nat.is_eq(x, Laws.tsum(KV.Val, Laws.WTimed{}, t))))(wf)(and_true(Nat.is_eq(n, Laws.tsum(KV.Val, Laws.WAll{}, t)), Nat.is_eq(x, Laws.tsum(KV.Val, Laws.WTimed{}, t)))(is_eq_of(n, Laws.tsum(KV.Val, Laws.WAll{}, t))(en))(is_eq_of(x, Laws.tsum(KV.Val, Laws.WTimed{}, t))(ex)))

# a write of a key keeps a database counted, its counts changed as the
