# END gen_trie: twice

# The laws
# ========
# The map: a write of key k through the trie is a bucket write (an Op) on
# the bucket where k's walk ends (tget_tmod_same), and leaves every other
# bucket as it was (tget_tmod_other); so k's entry after it is what the
# bucket lemmas say, and another key's entry is the one it had (op_other).

# the step of op_other: c says whether the walks of k and j end in the
# same bucket; ob says that the bucket write leaves j's entry in any bucket
def op_other_step(-V: Data, +t: KV.Trie<V>, +k: String, +j: String, +op: KV.Op<V>, ob: @b: KV.Trie<V> -> {KV.bent(V, j, b) == KV.bent(V, j, KV.bapply(V, op, b)) : Maybe<&2, KV.Item<V>>}, c: Bool)
  -> {dsame(5n, KV.hex(KV.hash(k)), KV.hash(k), KV.hex(KV.hash(j)), KV.hash(j)) == c : Bool}
  -> {KV.bent(V, j, KV.tget_h(V, 5n, KV.tmod_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), op), KV.hex(KV.hash(j)), KV.hash(j))) == KV.bent(V, j, KV.tget_h(V, 5n, t, KV.hex(KV.hash(j)), KV.hash(j))) : Maybe<&2, KV.Item<V>>}:
  match c:
    case True{}:
      +e => %walk_same(V, 5n, KV.tmod_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), op), KV.hex(KV.hash(k)), KV.hash(k), KV.hex(KV.hash(j)), KV.hash(j))(e) : {KV.bent(V, j, _) == KV.bent(V, j, KV.tget_h(V, 5n, t, KV.hex(KV.hash(j)), KV.hash(j))) : Maybe<&2, KV.Item<V>>}
            %walk_same(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), KV.hex(KV.hash(j)), KV.hash(j))(e) : {KV.bent(V, j, KV.tget_h(V, 5n, KV.tmod_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), op), KV.hex(KV.hash(k)), KV.hash(k))) == KV.bent(V, j, _) : Maybe<&2, KV.Item<V>>}
            %tget_tmod_same(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), op) : {KV.bent(V, j, _) == KV.bent(V, j, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))) : Maybe<&2, KV.Item<V>>}
            Equal.sym(Maybe<&2, KV.Item<V>>, KV.bent(V, j, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))), KV.bent(V, j, KV.bapply(V, op, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)))), ob(KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))))
    case False{}:
      e => Equal.cong(KV.Trie<V>, Maybe<&2, KV.Item<V>>, b => KV.bent(V, j, b), KV.tget_h(V, 5n, KV.tmod_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), op), KV.hex(KV.hash(j)), KV.hash(j)), KV.tget_h(V, 5n, t, KV.hex(KV.hash(j)), KV.hash(j)), tget_tmod_other(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), KV.hex(KV.hash(j)), KV.hash(j), op)(e))

def op_other(-V: Data, +t: KV.Trie<V>, +k: String, +j: String, +op: KV.Op<V>, ob: @b: KV.Trie<V> -> {KV.bent(V, j, b) == KV.bent(V, j, KV.bapply(V, op, b)) : Maybe<&2, KV.Item<V>>})
  -> {KV.bent(V, j, KV.tget_h(V, 5n, KV.tmod_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), op), KV.hex(KV.hash(j)), KV.hash(j))) == KV.entry(V, t, j) : Maybe<&2, KV.Item<V>>}:
  op_other_step(V, t, k, j, op, ob, dsame(5n, KV.hex(KV.hash(k)), KV.hash(k), KV.hex(KV.hash(j)), KV.hash(j)))({==})

def Laws.entry_empty(V, k):
  {==}

def Laws.entry_setx_same(V, t, k, v, e):
  %tget_tmod_same(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), KV.OSet{k, v, e}) : {KV.bent(V, k, _) == Some{KV.Item{v, e}} : Maybe<&2, KV.Item<V>>}
  Equal.sym(Maybe<&2, KV.Item<V>>, Some{KV.Item{v, e}}, KV.bent(V, k, KV.bset(V, k, v, e, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)))), bent_bset_same(V, k, v, e, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))))

def Laws.entry_setx_other(V, t, k, j, v, e, ne):
  op_other(V, t, k, j, KV.OSet{k, v, e}, b => bent_bset_other(V, j, k, v, e, b, str_eq_ne(j, k, ne)))

def Laws.entry_keep_same(V, t, k, v):
  %tget_tmod_same(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), KV.OKeep{k, v}) : {KV.bent(V, k, _) == Some{KV.Item{v, Laws.keep_exp(V, KV.entry(V, t, k))}} : Maybe<&2, KV.Item<V>>}
  Equal.sym(Maybe<&2, KV.Item<V>>, Some{KV.Item{v, Laws.keep_exp(V, KV.bent(V, k, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))))}}, KV.bent(V, k, KV.bkeep(V, k, v, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)))), bent_bkeep_same(V, k, v, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))))

def Laws.entry_keep_other(V, t, k, j, v, ne):
  op_other(V, t, k, j, KV.OKeep{k, v}, b => bent_bkeep_other(V, j, k, v, b, str_eq_ne(j, k, ne)))

def Laws.entry_expire_same(V, t, k, e):
  %tget_tmod_same(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), KV.OExp{k, e}) : {KV.bent(V, k, _) == Laws.with_exp(V, KV.entry(V, t, k), e) : Maybe<&2, KV.Item<V>>}
  Equal.sym(Maybe<&2, KV.Item<V>>, Laws.with_exp(V, KV.bent(V, k, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))), e), KV.bent(V, k, KV.bexp(V, k, e, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)))), bent_bexp_same(V, k, e, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))))

def Laws.entry_expire_other(V, t, k, j, e, ne):
  op_other(V, t, k, j, KV.OExp{k, e}, b => bent_bexp_other(V, j, k, e, b, str_eq_ne(j, k, ne)))

def Laws.entry_del_same(V, t, k):
  %tdel_eq(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), k, KV.hex(KV.hash(k)), KV.hash(k)) : {KV.bent(V, k, _) == None{} : Maybe<&2, KV.Item<V>>}
  %tget_tmod_same(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), KV.ODel{k}) : {KV.bent(V, k, _) == None{} : Maybe<&2, KV.Item<V>>}
  Equal.sym(Maybe<&2, KV.Item<V>>, None{}, KV.bent(V, k, KV.bdel(V, k, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)))), bent_bdel_same(V, k, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))))

def Laws.entry_del_other(V, t, k, j, ne):
  %tdel_eq(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), k, KV.hex(KV.hash(j)), KV.hash(j)) : {KV.bent(V, j, _) == KV.entry(V, t, j) : Maybe<&2, KV.Item<V>>}
  op_other(V, t, k, j, KV.ODel{k}, b => bent_bdel_other(V, j, k, b, str_eq_ne(j, k, ne)))

def Laws.get_entry(V, t, k):
  %tget_k_eq(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), k) : {_ == Laws.item_val(V, KV.entry(V, t, k)) : Maybe<&2, V>}
  Equal.sym(Maybe<&2, V>, Laws.item_val(V, KV.bent(V, k, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)))), KV.bget(V, k, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))), bget_eq(V, k, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))))

def Laws.read_entry(V, t, k, now):
  %tget_kl_eq(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), k, now) : {_ == Laws.live_val(V, KV.entry(V, t, k), now) : Maybe<&2, V>}
  Equal.sym(Maybe<&2, V>, Laws.live_val(V, KV.bent(V, k, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k))), now), KV.blive(V, k, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)), now), blive_eq(V, k, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)), now))

# the walks the commands take answer what the laws speak of: KV.code.at
# the code of the key's entry, KV.entry.at the entry, KV.get_copy the
# value read reads
def code_eq(-V: Data, +t: KV.Trie<V>, +k: String) -> {Laws.item_code(V, KV.entry(V, t, k)) == KV.code.at(V, t, k, KV.hash(k)) : Nat}:
  %tget_kx_eq(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), k) : {Laws.item_code(V, KV.entry(V, t, k)) == _ : Nat}
  bcode_eq(V, k, KV.tget_h(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)))

def entry_at_eq(-V: Data, +t: KV.Trie<V>, +k: String) -> {KV.entry(V, t, k) == KV.entry.at(V, t, k, KV.hash(k)) : Maybe<&2, KV.Item<V>>}:
  tget_ke_eq(V, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), k)

def get_copy_eq(+t: KV.Trie<KV.Val>, +k: String, +now: Nat) -> {KV.got_of(KV.read(KV.Val, t, k, now)) == KV.get_copy(t, k, now) : KV.Got}:
  Equal.trans(KV.Got, KV.got_of(KV.read(KV.Val, t, k, now)), KV.got_of(KV.blive(KV.Val, k, KV.tget_h(KV.Val, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)), now)), KV.get_copy(t, k, now),
    Equal.cong(Maybe<&2, KV.Val>, KV.Got, x => KV.got_of(x), KV.read(KV.Val, t, k, now), KV.blive(KV.Val, k, KV.tget_h(KV.Val, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)), now),
      Equal.sym(Maybe<&2, KV.Val>, KV.blive(KV.Val, k, KV.tget_h(KV.Val, 5n, t, KV.hex(KV.hash(k)), KV.hash(k)), now), KV.tget_kl(KV.Val, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), k, now), tget_kl_eq(KV.Val, 5n, t, KV.hex(KV.hash(k)), KV.hash(k), k, now))),
    tget_kc_eq(5n, t, KV.hex(KV.hash(k)), KV.hash(k), k, now))

# Keys
# ====

def Laws.key_eq_true(a, b, e):
  %e : Reflect(String, a, b, _)
  str_refl(a, b)

def Laws.key_eq_false(a, b, e):
  %e : Reflect(String, a, b, _)
  str_refl(a, b)

# Commands
# ========
# The spec's commands on a trie at a time now (SPEC.bend). What a key
# holds is its entry (KV.entry): the walks the commands take read it
# (code_eq, entry_at_eq, get_copy_eq), and the writes change it as the
# map's laws say.

# a key's entry after SET: the value, with no time
def e_set(+t: KV.Trie<KV.Val>, +k: String, +v: String) -> {KV.entry(KV.Val, KV.set(KV.Val, t, k, KV.VStr{v}), k) == Some{KV.Item{KV.VStr{v}, 0n}} : Maybe<&2, KV.Item<KV.Val>>}:
  Laws.entry_setx_same(KV.Val, t, k, KV.VStr{v}, 0n)

# GET and the other reads at now see the entry's value when the key is
# there at now
def read_eq(+t: KV.Trie<KV.Val>, +k: String, +now: Nat) -> {Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now) == KV.read(KV.Val, t, k, now) : Maybe<&2, KV.Val>}:
  Equal.sym(Maybe<&2, KV.Val>, KV.read(KV.Val, t, k, now), Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now), Laws.read_entry(KV.Val, t, k, now))

def get_read(+t: KV.Trie<KV.Val>, +k: String, +now: Nat) -> {KV.got_of(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)) == KV.get_copy(t, k, now) : KV.Got}:
  Equal.trans(KV.Got, KV.got_of(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), KV.got_of(KV.read(KV.Val, t, k, now)), KV.get_copy(t, k, now),
    Equal.cong(Maybe<&2, KV.Val>, KV.Got, x => KV.got_of(x), Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now), KV.read(KV.Val, t, k, now), read_eq(t, k, now)),
    get_copy_eq(t, k, now))

def t_get_after_set(+db: KV.Trie<KV.Val>, +k: String, +v: String, +now: Nat) -> {T.reply_of(T.exec(R.Get{k}, T.db_of(T.exec(R.Set{k, v}, db, now)), now)) == R.RBulk{v} : R.Reply}:
  %get_read(KV.set(KV.Val, db, k, KV.VStr{v}), k, now) : {R.r_getv(_) == R.RBulk{v} : R.Reply}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.set(KV.Val, db, k, KV.VStr{v}), k), Some{KV.Item{KV.VStr{v}, 0n}}, e_set(db, k, v)) : {R.r_getv(KV.got_of(Laws.live_val(KV.Val, _, now))) == R.RBulk{v} : R.Reply}
  {==}

# a key is there at now as its code says
def sub_zero(n: Nat) -> {Nat.sub(n, 0n) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def pick_some(b: Bool, -v: KV.Val, -e: Nat) -> {b == Maybe.is_some(&2, KV.Item<KV.Val>, Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{})) : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def live_code(m: Maybe<&2, KV.Item<KV.Val>>, +now: Nat) -> {R.code.live(Laws.item_code(KV.Val, m), now) == Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, m)) : Bool}:
  match m:
    case Some{KV.Item{v, +e}}:
      %Equal.sym(Nat, Nat.sub(e, 0n), e, sub_zero(e)) : {KV.live(now, _) == Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, Some{KV.Item{v, e}})) : Bool}
      pick_some(KV.live(now, e), v, e)
    case None{}:
      {==}

# DEL of one key answers whether the key was there at now
def t_del_one_count(+db: KV.Trie<KV.Val>, +k: String, +now: Nat) -> {T.reply_of(T.exec(R.Del{[k]}, db, now)) == R.r_int(Bool.pick(Nat, Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry(KV.Val, db, k))), 1n, 0n)) : R.Reply}:
  %code_eq(KV.Val, db, k) : {R.r_int(Bool.pick(Nat, R.code.live(_, now), 1n, 0n)) == R.r_int(Bool.pick(Nat, Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry(KV.Val, db, k))), 1n, 0n)) : R.Reply}
  Equal.cong(Bool, R.Reply, b => R.r_int(Bool.pick(Nat, b, 1n, 0n)), R.code.live(Laws.item_code(KV.Val, KV.entry(KV.Val, db, k)), now), Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry(KV.Val, db, k))), live_code(KV.entry(KV.Val, db, k), now))

# Reads
# -----

def t_reads_go(c: R.Cmd, +db: KV.Trie<KV.Val>, +now: Nat) -> {Laws.is_read(c) == True{} : Bool} -> {T.db_of(T.exec(c, db, now)) == db : KV.Trie<KV.Val>}:
  match c:
    case R.Ping{}:
      e => {==}
    case R.Echo{m}:
      e => {==}
    case R.Get{k}:
      e => {==}
    case R.Set{k, v}:
      e => Empty.absurd({T.db_of(T.exec(R.Set{k, v}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.Del{ks}:
      e => Empty.absurd({T.db_of(T.exec(R.Del{ks}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.Exists{ks}:
      e => {==}
    case R.IncrBy{k, by}:
      e => Empty.absurd({T.db_of(T.exec(R.IncrBy{k, by}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.MGet{ks}:
      e => {==}
    case R.MSet{ps}:
      e => Empty.absurd({T.db_of(T.exec(R.MSet{ps}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.DbSize{}:
      e => {==}
    case R.FlushDb{}:
      e => Empty.absurd({T.db_of(T.exec(R.FlushDb{}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.Keys{p}:
      e => {==}
    case R.Sort{k, o}:
      e => {==}
    case R.Scan{a}:
      e => {==}
    case R.Peek{k, o}:
      e => {==}
    case R.Upd{k, op}:
      e => Empty.absurd({T.db_of(T.exec(R.Upd{k, op}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.MSetNx{ps}:
      e => Empty.absurd({T.db_of(T.exec(R.MSetNx{ps}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.Rename{s, d, nx}:
      e => Empty.absurd({T.db_of(T.exec(R.Rename{s, d, nx}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.BitOp{op, d, srcs}:
      e => Empty.absurd({T.db_of(T.exec(R.BitOp{op, d, srcs}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.LMove{op, d, srcs}:
      e => Empty.absurd({T.db_of(T.exec(R.LMove{op, d, srcs}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.LMPop{op, d, srcs}:
      e => Empty.absurd({T.db_of(T.exec(R.LMPop{op, d, srcs}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.SOp{op, ks}:
      e => {==}
    case R.SStore{op, d, srcs}:
      e => Empty.absurd({T.db_of(T.exec(R.SStore{op, d, srcs}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.SMv{s, d, w}:
      e => Empty.absurd({T.db_of(T.exec(R.SMv{s, d, w}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.ZOp{op, ks}:
      e => {==}
    case R.ZStore{op, d, srcs}:
      e => Empty.absurd({T.db_of(T.exec(R.ZStore{op, d, srcs}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.ZRangeStore{d, s, q}:
      e => Empty.absurd({T.db_of(T.exec(R.ZRangeStore{d, s, q}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.ZMPop{ks, max, c}:
      e => Empty.absurd({T.db_of(T.exec(R.ZMPop{ks, max, c}, db, now)) == db : KV.Trie<KV.Val>}, false_true(e))
    case R.Own{o}:
      e => {==}
    case R.Bad{r}:
      e => {==}

def t_reads_keep_db(c: R.Cmd, +db: KV.Trie<KV.Val>, +now: Nat, e: {Laws.is_read(c) == True{} : Bool}) -> {T.db_of(T.exec(c, db, now)) == db : KV.Trie<KV.Val>}:
  t_reads_go(c, db, now)(e)

# Multi-key writes
# ----------------
# DEL and MSET fold the map's delete and set over their keys; their laws
# follow from the map's laws, one key at a time. DEL reads each key's code
# (KV.code.at) before it deletes it: the count of the keys there at now.

# what DEL leaves, spelled as a fold
def del_all(ks: List<&2, String>, db: KV.Trie<KV.Val>) -> KV.Trie<KV.Val>:
  match ks:
    case Nil{}:
      db
    case Con{+k, rest}:
      del_all(rest, KV.del(KV.Val, db, k))

# and how many of its keys were there at now, a deleted key counting no
# more
def del_count(ks: List<&2, String>, +now: Nat, +db: KV.Trie<KV.Val>) -> Nat:
  match ks:
    case Nil{}:
      0n
    case Con{+k, rest}:
      Nat.add(del_count(rest, now, KV.del(KV.Val, db, k)), Bool.pick(Nat, R.code.live(Laws.item_code(KV.Val, KV.entry(KV.Val, db, k)), now), 1n, 0n))

def dels_t(r: R.Dels) -> KV.Trie<KV.Val>:
  match r:
    case R.Dels{l, g, x, t}:
      t

def dels_live(r: R.Dels) -> Nat:
  match r:
    case R.Dels{l, g, x, t}:
      l

def put_t(+c: Nat, +now: Nat, r: R.Dels) -> {dels_t(R.del_keys.put(c, now, r)) == dels_t(r) : KV.Trie<KV.Val>}:
  match r:
    case R.Dels{l, g, x, t}:
      {==}

def put_live(+c: Nat, +now: Nat, r: R.Dels) -> {dels_live(R.del_keys.put(c, now, r)) == Nat.add(dels_live(r), Bool.pick(Nat, R.code.live(c, now), 1n, 0n)) : Nat}:
  match r:
    case R.Dels{l, g, x, t}:
      {==}

def del_keys_t(ks: List<&2, String>, +now: Nat, +db: KV.Trie<KV.Val>) -> {dels_t(R.del_keys(ks, now, db)) == del_all(ks, db) : KV.Trie<KV.Val>}:
  match ks:
    case Nil{}:
      {==}
    case Con{+k, +rest}:
      Equal.trans(KV.Trie<KV.Val>, dels_t(R.del_keys.put(KV.code.at(KV.Val, db, k, KV.hash(k)), now, R.del_keys(rest, now, KV.del(KV.Val, db, k)))), dels_t(R.del_keys(rest, now, KV.del(KV.Val, db, k))), del_all(rest, KV.del(KV.Val, db, k)),
        put_t(KV.code.at(KV.Val, db, k, KV.hash(k)), now, R.del_keys(rest, now, KV.del(KV.Val, db, k))),
        del_keys_t(rest, now, KV.del(KV.Val, db, k)))

def del_keys_live(ks: List<&2, String>, +now: Nat, +db: KV.Trie<KV.Val>) -> {dels_live(R.del_keys(ks, now, db)) == del_count(ks, now, db) : Nat}:
  match ks:
    case Nil{}:
      {==}
    case Con{+k, +rest}:
      %code_eq(KV.Val, db, k) : {dels_live(R.del_keys.put(_, now, R.del_keys(rest, now, KV.del(KV.Val, db, k)))) == del_count(Con{k, rest}, now, db) : Nat}
      Equal.trans(Nat, dels_live(R.del_keys.put(Laws.item_code(KV.Val, KV.entry(KV.Val, db, k)), now, R.del_keys(rest, now, KV.del(KV.Val, db, k)))), Nat.add(dels_live(R.del_keys(rest, now, KV.del(KV.Val, db, k))), Bool.pick(Nat, R.code.live(Laws.item_code(KV.Val, KV.entry(KV.Val, db, k)), now), 1n, 0n)), del_count(Con{k, rest}, now, db),
        put_live(Laws.item_code(KV.Val, KV.entry(KV.Val, db, k)), now, R.del_keys(rest, now, KV.del(KV.Val, db, k))),
        Equal.cong(Nat, Nat, z => Nat.add(z, Bool.pick(Nat, R.code.live(Laws.item_code(KV.Val, KV.entry(KV.Val, db, k)), now), 1n, 0n)), dels_live(R.del_keys(rest, now, KV.del(KV.Val, db, k))), del_count(rest, now, KV.del(KV.Val, db, k)), del_keys_live(rest, now, KV.del(KV.Val, db, k))))

def del_reply_t(r: R.Dels) -> {T.db_of(T.del_reply(r)) == dels_t(r) : KV.Trie<KV.Val>}:
  match r:
    case R.Dels{l, g, x, t}:
      {==}

def del_reply_r(r: R.Dels) -> {T.reply_of(T.del_reply(r)) == R.r_int(dels_live(r)) : R.Reply}:
  match r:
    case R.Dels{l, g, x, t}:
      {==}

# DEL changes the trie as del_all does, and answers del_count
def exec_del(+ks: List<&2, String>, +db: KV.Trie<KV.Val>, +now: Nat) -> {del_all(ks, db) == T.db_of(T.exec(R.Del{ks}, db, now)) : KV.Trie<KV.Val>}:
  Equal.sym(KV.Trie<KV.Val>, T.db_of(T.del_reply(R.del_keys(ks, now, db))), del_all(ks, db),
    Equal.trans(KV.Trie<KV.Val>, T.db_of(T.del_reply(R.del_keys(ks, now, db))), dels_t(R.del_keys(ks, now, db)), del_all(ks, db), del_reply_t(R.del_keys(ks, now, db)), del_keys_t(ks, now, db)))

def exec_del_r(+ks: List<&2, String>, +db: KV.Trie<KV.Val>, +now: Nat) -> {R.r_int(del_count(ks, now, db)) == T.reply_of(T.exec(R.Del{ks}, db, now)) : R.Reply}:
  Equal.sym(R.Reply, T.reply_of(T.del_reply(R.del_keys(ks, now, db))), R.r_int(del_count(ks, now, db)),
    Equal.trans(R.Reply, T.reply_of(T.del_reply(R.del_keys(ks, now, db))), R.r_int(dels_live(R.del_keys(ks, now, db))), R.r_int(del_count(ks, now, db)), del_reply_r(R.del_keys(ks, now, db)),
      Equal.cong(Nat, R.Reply, z => R.r_int(z), dels_live(R.del_keys(ks, now, db)), del_count(ks, now, db), del_keys_live(ks, now, db))))

# a Bool.or that is False has two False halves
def or_false_l(a: Bool, -b: Bool) -> {Bool.or(a, b) == False{} : Bool} -> {a == False{} : Bool}:
  match a:
    case True{}:
      e => Empty.absurd({True{} == False{} : Bool}, true_false(e))
    case False{}:
      e => {==}

def or_false_r(a: Bool, -b: Bool) -> {Bool.or(a, b) == False{} : Bool} -> {b == False{} : Bool}:
  match a:
    case True{}:
      e => Empty.absurd({b == False{} : Bool}, true_false(e))
    case False{}:
      e => e

# deleting keys other than j leaves j's entry as it was
def del_all_frame(ks: List<&2, String>, +db: KV.Trie<KV.Val>, +j: String) -> {Laws.any_key(j, ks) == False{} : Bool} -> {KV.entry(KV.Val, del_all(ks, db), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match ks:
    case Nil{}:
      e => {==}
    case Con{+k, +rest}:
      +e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, del_all(rest, KV.del(KV.Val, db, k)), j), KV.entry(KV.Val, KV.del(KV.Val, db, k), j), KV.entry(KV.Val, db, j),
              del_all_frame(rest, KV.del(KV.Val, db, k), j)(or_false_r(KV.str_eq(j, k), Laws.any_key(j, rest))(e)),
              Laws.entry_del_other(KV.Val, db, k, j, Laws.key_eq_false(j, k, or_false_l(KV.str_eq(j, k), Laws.any_key(j, rest))(e))))

def del_none(+db: KV.Trie<KV.Val>, +k: String, +j: String, c: Bool) -> Reflect(String, j, k, c) -> {KV.entry(KV.Val, db, j) == None{} : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, KV.del(KV.Val, db, k), j) == None{} : Maybe<&2, KV.Item<KV.Val>>}:
  match c:
    case True{}:
      ejk => e => %ejk : {KV.entry(KV.Val, KV.del(KV.Val, db, _), j) == None{} : Maybe<&2, KV.Item<KV.Val>>}
                  Laws.entry_del_same(KV.Val, db, j)
    case False{}:
      ne => e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.del(KV.Val, db, k), j), KV.entry(KV.Val, db, j), None{}, Laws.entry_del_other(KV.Val, db, k, j, ne), e)

# a key with no entry stays so through any deletes
def del_all_none(ks: List<&2, String>, +db: KV.Trie<KV.Val>, +j: String) -> {KV.entry(KV.Val, db, j) == None{} : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, del_all(ks, db), j) == None{} : Maybe<&2, KV.Item<KV.Val>>}:
  match ks:
    case Nil{}:
      e => e
    case Con{+k, +rest}:
      e => del_all_none(rest, KV.del(KV.Val, db, k), j)(del_none(db, k, j, KV.str_eq(j, k), str_refl(j, k), e))

# a deleted key has no entry, under any name equal to it
def entry_del_eq(+db: KV.Trie<KV.Val>, -k: String, +j: String, ejk: {j == k : String}) -> {KV.entry(KV.Val, KV.del(KV.Val, db, k), j) == None{} : Maybe<&2, KV.Item<KV.Val>>}:
  %ejk : {KV.entry(KV.Val, KV.del(KV.Val, db, _), j) == None{} : Maybe<&2, KV.Item<KV.Val>>}
  Laws.entry_del_same(KV.Val, db, j)

def del_eff_step(+db: KV.Trie<KV.Val>, +k: String, +rest: List<&2, String>, +j: String, c1: Bool, c2: Bool)
  -> Reflect(String, j, k, c1)
  -> ({c2 == True{} : Bool} -> {KV.entry(KV.Val, del_all(rest, KV.del(KV.Val, db, k)), j) == None{} : Maybe<&2, KV.Item<KV.Val>>})
  -> {Bool.or(c1, c2) == True{} : Bool}
  -> {KV.entry(KV.Val, del_all(rest, KV.del(KV.Val, db, k)), j) == None{} : Maybe<&2, KV.Item<KV.Val>>}:
  match c1 c2:
    case True{} _:
      ejk => ih => e => del_all_none(rest, KV.del(KV.Val, db, k), j)(entry_del_eq(db, k, j, ejk))
    case False{} True{}:
      ne => ih => e => ih({==})
    case False{} False{}:
      ne => ih => e => Empty.absurd({KV.entry(KV.Val, del_all(rest, KV.del(KV.Val, db, k)), j) == None{} : Maybe<&2, KV.Item<KV.Val>>}, false_true(e))

# every key DEL names has no entry afterwards
def del_all_effect(ks: List<&2, String>, +db: KV.Trie<KV.Val>, +j: String) -> {Laws.any_key(j, ks) == True{} : Bool} -> {KV.entry(KV.Val, del_all(ks, db), j) == None{} : Maybe<&2, KV.Item<KV.Val>>}:
  match ks:
    case Nil{}:
      e => Empty.absurd({KV.entry(KV.Val, db, j) == None{} : Maybe<&2, KV.Item<KV.Val>>}, false_true(e))
    case Con{+k, +rest}:
      del_eff_step(db, k, rest, j, KV.str_eq(j, k), Laws.any_key(j, rest))(str_refl(j, k), del_all_effect(rest, KV.del(KV.Val, db, k), j))

def t_del_effect(+ks: List<&2, String>, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, e: {Laws.any_key(j, ks) == True{} : Bool}) -> {KV.entry(KV.Val, T.db_of(T.exec(R.Del{ks}, db, now)), j) == None{} : Maybe<&2, KV.Item<KV.Val>>}:
  %exec_del(ks, db, now) : {KV.entry(KV.Val, _, j) == None{} : Maybe<&2, KV.Item<KV.Val>>}
  del_all_effect(ks, db, j)(e)

# The frame law
# -------------
# a write of another key leaves j's entry as it was: INCRBY's, MSET's and
# an update's, whatever they read

def incr_fit_frame(+db: KV.Trie<KV.Val>, +k: String, s: R.LL, +j: String, keep: Bool, ne: {j != k : String}) -> {KV.entry(KV.Val, T.db_of(T.incr.fit(db, k, KV.hash(k), s, keep)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match s keep:
    case R.LL{+neg, +hi, +lo} True{}:
      Laws.entry_keep_other(KV.Val, db, k, j, KV.VStr{R.ll.show(neg, hi, lo)}, ne)
    case R.LL{+neg, +hi, +lo} False{}:
      Laws.entry_setx_other(KV.Val, db, k, j, KV.VStr{R.ll.show(neg, hi, lo)}, 0n, ne)
    case R.LLBad{} True{}:
      {==}
    case R.LLBad{} False{}:
      {==}

def incr_num_frame(+db: KV.Trie<KV.Val>, +k: String, +by: R.By, +j: String, cur: R.LL, ne: {j != k : String}) -> {KV.entry(KV.Val, T.db_of(T.incr.num(db, k, KV.hash(k), by, cur)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match cur:
    case R.LL{+neg, +hi, +lo}:
      incr_fit_frame(db, k, R.ll.add(neg, hi, lo, by), j, True{}, ne)
    case R.LLBad{}:
      {==}

def incr_frame(+db: KV.Trie<KV.Val>, +k: String, +by: R.By, +j: String, old: KV.Got, ne: {j != k : String}) -> {KV.entry(KV.Val, T.db_of(T.incr.got(db, k, KV.hash(k), by, old)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match old:
    case KV.GStr{s}:
      incr_num_frame(db, k, by, j, R.ll.read(s), ne)
    case KV.GColl{}:
      {==}
    case KV.GNone{}:
      incr_fit_frame(db, k, R.by.ll(by), j, False{}, ne)

def upd_ch_frame(+t: KV.Trie<KV.Val>, +k: String, +j: String, r: R.Reply, ch: R.Change, ne: {j != k : String}) -> {KV.entry(KV.Val, T.db_of(T.upd.ch(t, k, KV.hash(k), r, ch)), j) == KV.entry(KV.Val, t, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match ch:
    case R.CKeep{}:
      {==}
    case R.CDel{}:
      Laws.entry_del_other(KV.Val, t, k, j, ne)
    case R.CExp{+e}:
      Laws.entry_expire_other(KV.Val, t, k, j, e, ne)
    case R.CPut{+v, +e}:
      Laws.entry_setx_other(KV.Val, t, k, j, KV.VStr{v}, e, ne)
    case R.CKeepT{+v}:
      Laws.entry_keep_other(KV.Val, t, k, j, KV.VStr{v}, ne)
    case R.CApp{a, +v}:
      Laws.entry_keep_other(KV.Val, t, k, j, KV.VStr{v}, ne)
    case R.CRange{o, a, +v}:
      Laws.entry_keep_other(KV.Val, t, k, j, KV.VStr{v}, ne)
    case R.CHash{op, +hv}:
      Laws.entry_keep_other(KV.Val, t, k, j, KV.VColl{KV.CHash{hv}}, ne)
    case R.CHashNew{ps, +hv}:
      Laws.entry_setx_other(KV.Val, t, k, j, KV.VColl{KV.CHash{hv}}, 0n, ne)
    case R.CList{op, +hv}:
      Laws.entry_keep_other(KV.Val, t, k, j, KV.VColl{KV.CList{hv}}, ne)
    case R.CListNew{lf, ps, +hv}:
      Laws.entry_setx_other(KV.Val, t, k, j, KV.VColl{KV.CList{hv}}, 0n, ne)
    case R.CMems{op, +sv}:
      Laws.entry_keep_other(KV.Val, t, k, j, KV.VColl{KV.CMems{sv}}, ne)
    case R.CMemsNew{ms, +sv}:
      Laws.entry_setx_other(KV.Val, t, k, j, KV.VColl{KV.CMems{sv}}, 0n, ne)
    case R.CZset{op, +z}:
      Laws.entry_keep_other(KV.Val, t, k, j, KV.VColl{KV.CZset{z}}, ne)
    case R.CZsetNew{o, ps, +z}:
      Laws.entry_setx_other(KV.Val, t, k, j, KV.VColl{KV.CZset{z}}, 0n, ne)
    case R.CRestore{p, +v, +e}:
      Laws.entry_setx_other(KV.Val, t, k, j, v, e, ne)

def upd_frame(+t: KV.Trie<KV.Val>, +k: String, +j: String, o: R.Out, ne: {j != k : String}) -> {KV.entry(KV.Val, T.db_of(T.upd.put(t, k, KV.hash(k), o)), j) == KV.entry(KV.Val, t, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match o:
    case R.Out{+r, +ch}:
      upd_ch_frame(t, k, j, r, ch, ne)

def mset_frame(ps: List<&2, R.KVPair>, +db: KV.Trie<KV.Val>, +j: String) -> {Laws.any_pair(j, ps) == False{} : Bool} -> {KV.entry(KV.Val, T.mset_pairs(ps, db), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match ps:
    case Nil{}:
      e => {==}
    case Con{R.KP{+k, +v}, +rest}:
      +e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.mset_pairs(rest, KV.set(KV.Val, db, k, KV.VStr{v})), j), KV.entry(KV.Val, KV.set(KV.Val, db, k, KV.VStr{v}), j), KV.entry(KV.Val, db, j),
              mset_frame(rest, KV.set(KV.Val, db, k, KV.VStr{v}), j)(or_false_r(KV.str_eq(j, k), Laws.any_pair(j, rest))(e)),
              Laws.entry_setx_other(KV.Val, db, k, j, KV.VStr{v}, 0n, Laws.key_eq_false(j, k, or_false_l(KV.str_eq(j, k), Laws.any_pair(j, rest))(e))))

# MSETNX's and RENAME's writes, whatever they found, leave a key they do
# not write as it was
def msetnx_frame(b: Bool, ps: List<&2, R.KVPair>, +db: KV.Trie<KV.Val>, +j: String) -> {Laws.any_pair(j, ps) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.msetnx(b, ps, db)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case True{}:
      e => {==}
    case False{}:
      mset_frame(ps, db, j)

def ren_frame(r: R.Ren, +nx: Bool, +s: String, +d: String, +db: KV.Trie<KV.Val>, +j: String) -> {Laws.any_key(j, [s, d]) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.ren(r, nx, s, d, db)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match r:
    case R.RnNone{}:
      e => {==}
    case R.RnSame{}:
      e => {==}
    case R.RnHeld{}:
      e => {==}
    case R.RnMove{+v, +x}:
      +e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.del(KV.Val, KV.setx(KV.Val, db, d, v, x), s), j), KV.entry(KV.Val, KV.setx(KV.Val, db, d, v, x), j), KV.entry(KV.Val, db, j),
              Laws.entry_del_other(KV.Val, KV.setx(KV.Val, db, d, v, x), s, j, Laws.key_eq_false(j, s, or_false_l(KV.str_eq(j, s), Laws.any_key(j, [d]))(e))),
              Laws.entry_setx_other(KV.Val, db, d, j, v, x, Laws.key_eq_false(j, d, or_false_l(KV.str_eq(j, d), Laws.any_key(j, Nil{}))(or_false_r(KV.str_eq(j, s), Laws.any_key(j, [d]))(e)))))

# LMOVE writes its source and its destination alone: the source's list
# set or deleted, then the destination's set
def mv_src_frame(b: Bool, +s: String, +l: KV.Deq, +db: KV.Trie<KV.Val>, +j: String, ns: {j != s : String}) -> {KV.entry(KV.Val, T.mv.src(b, s, l, db), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case True{}:
      Laws.entry_del_other(KV.Val, db, s, j, ns)
    case False{}:
      Laws.entry_keep_other(KV.Val, db, s, j, KV.VColl{KV.CList{l}}, ns)

def mv_put_frame(+s: String, +l: KV.Deq, +db: KV.Trie<KV.Val>, +j: String, ns: {j != s : String}) -> {KV.entry(KV.Val, T.mv.put(s, l, db), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  mv_src_frame(Nat.is_eq(KV.deq.len(l), 0n), s, l, db, j, ns)

def mv_self_frame(p: KV.Pop, +e: R.LEnds, +s: String, +db: KV.Trie<KV.Val>, +j: String, ns: {j != s : String}) -> {KV.entry(KV.Val, T.db_of(T.mv.self(p, e, s, db)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match p:
    case KV.Pop{+x, +l}:
      Laws.entry_keep_other(KV.Val, db, s, j, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, l)}}, ns)
    case KV.PopNone{}:
      {==}

def mv_go_frame(p: KV.Pop, +e: R.LEnds, +s: String, +t: String, dl: Maybe<&2, KV.Deq>, +db: KV.Trie<KV.Val>, +j: String, ns: {j != s : String}, nt: {j != t : String}) -> {KV.entry(KV.Val, T.db_of(T.mv.go(p, e, s, t, dl, db)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match p dl:
    case KV.Pop{+x, +l} Some{+d}:
      Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.keep(KV.Val, T.mv.put(s, l, db), t, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, d)}}), j), KV.entry(KV.Val, T.mv.put(s, l, db), j), KV.entry(KV.Val, db, j),
        Laws.entry_keep_other(KV.Val, T.mv.put(s, l, db), t, j, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, d)}}, nt),
        mv_put_frame(s, l, db, j, ns))
    case KV.Pop{+x, +l} None{}:
      Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.setx(KV.Val, T.mv.put(s, l, db), t, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, KV.deq.empty())}}, 0n), j), KV.entry(KV.Val, T.mv.put(s, l, db), j), KV.entry(KV.Val, db, j),
        Laws.entry_setx_other(KV.Val, T.mv.put(s, l, db), t, j, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, KV.deq.empty())}}, 0n, nt),
        mv_put_frame(s, l, db, j, ns))
    case KV.PopNone{} _:
      {==}

def mv_do_frame(m: R.Mv, +e: R.LEnds, +s: String, +t: String, +db: KV.Trie<KV.Val>, +j: String, ns: {j != s : String}, nt: {j != t : String}) -> {KV.entry(KV.Val, T.db_of(T.mv.do(m, e, s, t, db)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match m:
    case R.MvNone{}:
      {==}
    case R.MvWrong{}:
      {==}
    case R.MvSelf{+l, se}:
      mv_self_frame(KV.deq.pop(R.ends.from(e), l), e, s, db, j, ns)
    case R.MvOnto{+l, se, +dl}:
      mv_go_frame(KV.deq.pop(R.ends.from(e), l), e, s, t, Some{dl}, db, j, ns, nt)
    case R.MvNew{+l, se}:
      mv_go_frame(KV.deq.pop(R.ends.from(e), l), e, s, t, None{}, db, j, ns, nt)

def lmove_frame(+s: String, +t: String, +e: R.LEnds, +db: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {Laws.any_key(j, [s, t]) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.lmove(db, s, t, e, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  +ee => mv_do_frame(T.mv.find(db, s, t, e, now), e, s, t, db, j,
    Laws.key_eq_false(j, s, or_false_l(KV.str_eq(j, s), Laws.any_key(j, [t]))(ee)),
    Laws.key_eq_false(j, t, or_false_l(KV.str_eq(j, t), Laws.any_key(j, Nil{}))(or_false_r(KV.str_eq(j, s), Laws.any_key(j, [t]))(ee))))

# LMPOP pops from one of its keys: the key it picks is one of them
def NotAt(j: String, m: Maybe<&2, String>) -> Data:
  match m:
    case Some{k}:
      {KV.str_eq(j, k) == False{} : Bool}
    case None{}:
      Unit

def first_not(ks: List<&2, String>, h: Bool, +db: KV.Trie<KV.Val>, +now: Nat, +j: String) -> {Laws.any_key(j, ks) == False{} : Bool} -> NotAt(j, T.lmpop.first(ks, h, db, now)):
  match ks h:
    case Con{+k, +rest} True{}:
      e => or_false_l(KV.str_eq(j, k), Laws.any_key(j, rest))(e)
    case Con{+k, +rest} False{}:
      e => first_not(rest, T.lmpop.head(rest, db, now), db, now, j)(or_false_r(KV.str_eq(j, k), Laws.any_key(j, rest))(e))
    case Nil{} _:
      e => Unit{}

def lmpop_out_db(+k: String, r: R.Reply & KV.Trie<KV.Val>) -> {T.db_of(T.lmpop.out(k, r)) == T.db_of(r) : KV.Trie<KV.Val>}:
  (x, d) = r
  {==}

def lmpop_out_rep(+k: String, r: R.Reply & KV.Trie<KV.Val>) -> {T.reply_of(T.lmpop.out(k, r)) == R.lmpop.reply(k, T.reply_of(r)) : R.Reply}:
  (x, d) = r
  {==}

def lmpop_at_frame(m: Maybe<&2, String>, +left: Bool, +c: String, +db: KV.Trie<KV.Val>, +j: String, +now: Nat) -> NotAt(j, m) -> {KV.entry(KV.Val, T.db_of(T.lmpop.at(m, left, c, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match m:
    case Some{+k}:
      ne => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.lmpop.out(k, T.upd.run(db, k, R.UList{R.LWPopN{left, c}}, now))), j), KV.entry(KV.Val, T.db_of(T.upd.run(db, k, R.UList{R.LWPopN{left, c}}, now)), j), KV.entry(KV.Val, db, j),
              Equal.cong(KV.Trie<KV.Val>, Maybe<&2, KV.Item<KV.Val>>, z => KV.entry(KV.Val, z, j), T.db_of(T.lmpop.out(k, T.upd.run(db, k, R.UList{R.LWPopN{left, c}}, now))), T.db_of(T.upd.run(db, k, R.UList{R.LWPopN{left, c}}, now)), lmpop_out_db(k, T.upd.run(db, k, R.UList{R.LWPopN{left, c}}, now))),
              upd_frame(db, k, j, R.upd.v(R.UList{R.LWPopN{left, c}}, now, R.ent.live(now, KV.entry.at(KV.Val, db, k, KV.hash(k)))), Laws.key_eq_false(j, k, ne)))
    case None{}:
      u => {==}

def lmpop_frame(+ks: List<&2, String>, +left: Bool, +c: String, +db: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {Laws.any_key(j, ks) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.lmpop(db, ks, left, c, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  e => lmpop_at_frame(T.lmpop.first(ks, T.lmpop.head(ks, db, now), db, now), left, c, db, j, now)(first_not(ks, T.lmpop.head(ks, db, now), db, now, j)(e))

# BITOP's write, for a given value: the destination set or deleted, every
# other key as it was
def bitop_frame(e: Bool, +v: String, +d: String, +db: KV.Trie<KV.Val>, +j: String) -> {KV.str_eq(j, d) == False{} : Bool} -> {KV.entry(KV.Val, T.bitop.t(e, v, d, db), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match e:
    case True{}:
      ne => Laws.entry_del_other(KV.Val, db, d, j, Laws.key_eq_false(j, d, ne))
    case False{}:
      ne => Laws.entry_setx_other(KV.Val, db, d, j, KV.VStr{v}, 0n, Laws.key_eq_false(j, d, ne))

def bitop_go_frame(w: Bool, +op: R.BitK, +srcs: List<&2, String>, +d: String, +db: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.str_eq(j, d) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.bitop.go(w, op, srcs, d, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match w:
    case True{}:
      e => {==}
    case False{}:
      e => bitop_frame(String.is_empty(R.bitop.val(op, srcs, now, db)), R.bitop.val(op, srcs, now, db), d, db, j)(e)

# a STORE of a set operation writes its destination alone: the DEL of it,
# or the update SWNew
def any_one(+j: String, +d: String, e: {KV.str_eq(j, d) == False{} : Bool}) -> {Laws.any_key(j, [d]) == False{} : Bool}:
  %Equal.sym(Bool, KV.str_eq(j, d), False{}, e) : {Bool.or(_, False{}) == False{} : Bool}
  {==}

def sstore_of_frame(xs: List<&2, String>, +d: String, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, e: {KV.str_eq(j, d) == False{} : Bool}) -> {KV.entry(KV.Val, T.db_of(T.sstore.of(xs, d, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match xs:
    case Nil{}:
      %exec_del([d], db, now) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}
      del_all_frame([d], db, j)(any_one(j, d, e))
    case Con{+x, +rest}:
      upd_frame(db, d, j, R.upd.v(R.UMems{R.SWNew{x <> rest}}, now, R.ent.live(now, KV.entry.at(KV.Val, db, d, KV.hash(d)))), Laws.key_eq_false(j, d, e))

def sstore_do_frame(g: R.SGot, +op: R.SetK, +ks: List<&2, String>, +d: String, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, e: {KV.str_eq(j, d) == False{} : Bool}) -> {KV.entry(KV.Val, T.db_of(T.sstore.do(g, op, ks, d, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match g:
    case R.SGot{ss}:
      sstore_of_frame(R.sop.members(op, ks, ss), d, db, j, now, e)
    case R.SGotWrong{}:
      {==}

def sstore_frame(+op: R.SetK, +d: String, +ks: List<&2, String>, +db: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.str_eq(j, d) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.sstore(db, op, d, ks, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  e => sstore_do_frame(R.sets.at(ks, now, db), op, ks, d, db, j, now, e)

# SMOVE writes its source and its destination alone, each by an update
def smove_do_frame(f: R.Smv, +s: String, +d: String, +w: R.SMem, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, ns: {j != s : String}, nd: {j != d : String}) -> {KV.entry(KV.Val, T.db_of(T.smove.do(f, s, d, w, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match f:
    case R.SmvZero{}:
      {==}
    case R.SmvWrong{}:
      {==}
    case R.SmvSame{had}:
      {==}
    case R.SmvGo{}:
      +u = T.db_of(T.upd.run(db, s, R.UMems{R.SWRem{[R.smv.member(w)]}}, now))
      Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.upd.run(u, d, R.UMems{R.smv.add(w)}, now)), j), KV.entry(KV.Val, u, j), KV.entry(KV.Val, db, j),
        upd_frame(u, d, j, R.upd.v(R.UMems{R.smv.add(w)}, now, R.ent.live(now, KV.entry.at(KV.Val, u, d, KV.hash(d)))), nd),
        upd_frame(db, s, j, R.upd.v(R.UMems{R.SWRem{[R.smv.member(w)]}}, now, R.ent.live(now, KV.entry.at(KV.Val, db, s, KV.hash(s)))), ns))

def smove_frame(+s: String, +d: String, +w: R.SMem, +db: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {Laws.any_key(j, [s, d]) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.smove(db, s, d, w, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  +ee => smove_do_frame(T.smv.find(db, s, d, w, now), s, d, w, db, j, now,
    Laws.key_eq_false(j, s, or_false_l(KV.str_eq(j, s), Laws.any_key(j, [d]))(ee)),
    Laws.key_eq_false(j, d, or_false_l(KV.str_eq(j, d), Laws.any_key(j, Nil{}))(or_false_r(KV.str_eq(j, s), Laws.any_key(j, [d]))(ee))))

# a STORE of a sorted-set operation, or of a range (ZRANGESTORE), writes
# its destination alone: the DEL of it, or the update ZWNew; ZMPOP writes
# the key it pops from alone, by an update
def zstore_of_frame(xs: List<&2, KV.ZEl>, +d: String, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, e: {KV.str_eq(j, d) == False{} : Bool}) -> {KV.entry(KV.Val, T.db_of(T.zstore.of(xs, d, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match xs:
    case Nil{}:
      %exec_del([d], db, now) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}
      del_all_frame([d], db, j)(any_one(j, d, e))
    case Con{+x, +rest}:
      upd_frame(db, d, j, R.upd.v(R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(x <> rest)}}, now, R.ent.live(now, KV.entry.at(KV.Val, db, d, KV.hash(d)))), Laws.key_eq_false(j, d, e))

def zstore_ok_frame(bad: Maybe<&2, R.Reply>, +op: R.ZSetK, ss: List<&2, R.ZSrc>, +d: String, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, e: {KV.str_eq(j, d) == False{} : Bool}) -> {KV.entry(KV.Val, T.db_of(T.zstore.ok(bad, op, ss, d, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match bad:
    case Some{r}:
      {==}
    case None{}:
      zstore_of_frame(R.zop.els(op, ss), d, db, j, now, e)

def zstore_do_frame(g: R.ZGot, +op: R.ZSetK, +d: String, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, e: {KV.str_eq(j, d) == False{} : Bool}) -> {KV.entry(KV.Val, T.db_of(T.zstore.do(g, op, d, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match g:
    case R.ZGot{ss}:
      zstore_ok_frame(R.zop.bad(op), op, ss, d, db, j, now, e)
    case R.ZGotWrong{}:
      {==}

def zstore_frame(+op: R.ZSetK, +d: String, ks: List<&2, String>, +db: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.str_eq(j, d) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.zstore(db, op, d, ks, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  e => zstore_do_frame(R.zsrcs.at(ks, now, db), op, d, db, j, now, e)

def zrs_of_frame(m: Maybe<&2, KV.Val>, q: R.ZQ, +d: String, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, e: {KV.str_eq(j, d) == False{} : Bool}) -> {KV.entry(KV.Val, T.db_of(T.zrs.of(m, q, d, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match m:
    case None{}:
      zstore_of_frame(Nil{}, d, db, j, now, e)
    case Some{KV.VColl{KV.CZset{+z}}}:
      zstore_of_frame(R.zq.run(q, z), d, db, j, now, e)
    case Some{KV.VColl{KV.CHash{h}}}:
      {==}
    case Some{KV.VColl{KV.CList{l}}}:
      {==}
    case Some{KV.VColl{KV.CMems{s}}}:
      {==}
    case Some{KV.VColl{KV.CStream{s}}}:
      {==}
    case Some{KV.VStr{w}}:
      {==}

def zrangestore_frame(+d: String, +s: String, q: R.ZQ, +db: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.str_eq(j, d) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.zrangestore(db, d, s, q, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  e => zrs_of_frame(KV.read(KV.Val, db, s, now), q, d, db, j, now, e)

def zmpop_out_db(+k: String, r: R.Reply & KV.Trie<KV.Val>) -> {T.db_of(T.zmpop.out(k, r)) == T.db_of(r) : KV.Trie<KV.Val>}:
  (y, d) = r
  {==}

def zmpop_at_frame(m: Maybe<&2, String>, +max: Bool, +c: String, +db: KV.Trie<KV.Val>, +j: String, +now: Nat) -> NotAt(j, m) -> {KV.entry(KV.Val, T.db_of(T.zmpop.at(m, max, c, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match m:
    case Some{+k}:
      ne => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.zmpop.out(k, T.upd.run(db, k, R.UZset{R.ZWPopN{max, c}}, now))), j), KV.entry(KV.Val, T.db_of(T.upd.run(db, k, R.UZset{R.ZWPopN{max, c}}, now)), j), KV.entry(KV.Val, db, j),
              Equal.cong(KV.Trie<KV.Val>, Maybe<&2, KV.Item<KV.Val>>, z => KV.entry(KV.Val, z, j), T.db_of(T.zmpop.out(k, T.upd.run(db, k, R.UZset{R.ZWPopN{max, c}}, now))), T.db_of(T.upd.run(db, k, R.UZset{R.ZWPopN{max, c}}, now)), zmpop_out_db(k, T.upd.run(db, k, R.UZset{R.ZWPopN{max, c}}, now))),
              upd_frame(db, k, j, R.upd.v(R.UZset{R.ZWPopN{max, c}}, now, R.ent.live(now, KV.entry.at(KV.Val, db, k, KV.hash(k)))), Laws.key_eq_false(j, k, ne)))
    case None{}:
      u => {==}

def zmpop_frame(+ks: List<&2, String>, +max: Bool, +c: String, +db: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {Laws.any_key(j, ks) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.zmpop(db, ks, max, c, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  e => zmpop_at_frame(T.lmpop.first(ks, T.lmpop.head(ks, db, now), db, now), max, c, db, j, now)(first_not(ks, T.lmpop.head(ks, db, now), db, now, j)(e))

def frame_go(c: R.Cmd, +db: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {Laws.writes(c, j) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.exec(c, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  match c:
    case R.Ping{}:
      e => {==}
    case R.Echo{m}:
      e => {==}
    case R.Get{k}:
      e => {==}
    case R.Set{+k, +v}:
      e => Laws.entry_setx_other(KV.Val, db, k, j, KV.VStr{v}, 0n, Laws.key_eq_false(j, k, e))
    case R.Del{+ks}:
      e => %exec_del(ks, db, now) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}
           del_all_frame(ks, db, j)(e)
    case R.Exists{ks}:
      e => {==}
    case R.IncrBy{+k, +by}:
      e => incr_frame(db, k, by, j, KV.get_copy.at(db, k, KV.hash(k), now), Laws.key_eq_false(j, k, e))
    case R.MGet{ks}:
      e => {==}
    case R.MSet{+ps}:
      e => mset_frame(ps, db, j)(e)
    case R.DbSize{}:
      e => {==}
    case R.FlushDb{}:
      e => Empty.absurd({KV.entry(KV.Val, KV.empty(KV.Val), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}, true_false(e))
    case R.Keys{p}:
      e => {==}
    case R.Sort{k, o}:
      e => {==}
    case R.Scan{a}:
      e => {==}
    case R.Peek{k, o}:
      e => {==}
    case R.Upd{+k, +op}:
      e => upd_frame(db, k, j, R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, db, k, KV.hash(k)))), Laws.key_eq_false(j, k, e))
    case R.MSetNx{+ps}:
      e => msetnx_frame(R.pairs.live(ps, now, db), ps, db, j)(e)
    case R.Rename{+s, +d, +nx}:
      e => ren_frame(T.ren.find(db, s, d, nx, now), nx, s, d, db, j)(e)
    case R.BitOp{+op, +d, +srcs}:
      e => bitop_go_frame(R.bitop.wrong(srcs, now, db), op, srcs, d, db, j, now)(e)
    case R.LMove{+s, +t, +e}:
      ee => lmove_frame(s, t, e, db, j, now)(ee)
    case R.LMPop{+ks, +left, +c}:
      ee => lmpop_frame(ks, left, c, db, j, now)(ee)
    case R.SOp{op, ks}:
      e => {==}
    case R.SStore{+op, +d, +ks}:
      e => sstore_frame(op, d, ks, db, j, now)(e)
    case R.SMv{+s, +d, +w}:
      e => smove_frame(s, d, w, db, j, now)(e)
    case R.ZOp{op, ks}:
      e => {==}
    case R.ZStore{+op, +d, ks}:
      e => zstore_frame(op, d, ks, db, j, now)(e)
    case R.ZRangeStore{+d, +s, q}:
      e => zrangestore_frame(d, s, q, db, j, now)(e)
    case R.ZMPop{+ks, +max, +c}:
      ee => zmpop_frame(ks, max, c, db, j, now)(ee)
    case R.Own{o}:
      e => {==}
    case R.Bad{r}:
      e => {==}

def t_frame(c: R.Cmd, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, e: {Laws.writes(c, j) == False{} : Bool}) -> {KV.entry(KV.Val, T.db_of(T.exec(c, db, now)), j) == KV.entry(KV.Val, db, j) : Maybe<&2, KV.Item<KV.Val>>}:
  frame_go(c, db, j, now)(e)

# Batches
# -------
# exec_all accumulates replies in reverse and flips them at the end; run
# is the plain recursive spec. G generalizes over the accumulator, and
# eta lets a computed pair be taken apart.

def rfst(r: List<&2, R.Reply> & R.Db) -> List<&2, R.Reply>:
  (rs, db) = r
  rs

def rsnd(r: List<&2, R.Reply> & R.Db) -> R.Db:
  (rs, db) = r
  db

def eta_r(p: R.Reply & R.Db) -> {(R.reply_of(p), R.db_of(p)) == p : R.Reply & R.Db}:
  (x, db) = p
  {==}

def eta_l(p: List<&2, R.Reply> & R.Db) -> {(rfst(p), rsnd(p)) == p : List<&2, R.Reply> & R.Db}:
  (rs, db) = p
  {==}

def run(cs: List<&2, R.Cmd>, +db: R.Db) -> List<&2, R.Reply> & R.Db:
  match cs:
    case Nil{}:
      (Nil{}, db)
    case Con{+c, rest}:
      R.exec_all.cons(R.reply_of(R.exec(c, db)), run(rest, R.db_of(R.exec(c, db))))

def batch_go(cs: List<&2, R.Cmd>, +acc: List<&2, R.Reply>, +d: R.Db)
  -> {(List.reverse.go(&2, R.Reply, acc, rfst(run(cs, d))), rsnd(run(cs, d))) == R.exec_all.fin(R.exec_all.go(cs, (acc, d))) : List<&2, R.Reply> & R.Db}:
  match cs:
    case Nil{}:
      {==}
    case Con{+c, +rest}:
      %eta_r(R.exec(c, d)) : {(List.reverse.go(&2, R.Reply, acc, rfst(run(Con{c, rest}, d))), rsnd(run(Con{c, rest}, d))) == R.exec_all.fin(R.exec_all.go(rest, R.exec_all.put(acc, _))) : List<&2, R.Reply> & R.Db}
      %batch_go(rest, Con{R.reply_of(R.exec(c, d)), acc}, R.db_of(R.exec(c, d))) : {(List.reverse.go(&2, R.Reply, acc, rfst(run(Con{c, rest}, d))), rsnd(run(Con{c, rest}, d))) == _ : List<&2, R.Reply> & R.Db}
      %eta_l(run(rest, R.db_of(R.exec(c, d)))) : {(List.reverse.go(&2, R.Reply, acc, rfst(R.exec_all.cons(R.reply_of(R.exec(c, d)), _))), rsnd(R.exec_all.cons(R.reply_of(R.exec(c, d)), _))) == (List.reverse.go(&2, R.Reply, Con{R.reply_of(R.exec(c, d)), acc}, rfst(run(rest, R.db_of(R.exec(c, d))))), rsnd(run(rest, R.db_of(R.exec(c, d))))) : List<&2, R.Reply> & R.Db}
      {==}

# exec_all is run
def exec_all_run(+cs: List<&2, R.Cmd>, +d: R.Db) -> {run(cs, d) == R.exec_all(cs, d) : List<&2, R.Reply> & R.Db}:
  Equal.trans(List<&2, R.Reply> & R.Db, run(cs, d), (rfst(run(cs, d)), rsnd(run(cs, d))), R.exec_all(cs, d),
    Equal.sym(List<&2, R.Reply> & R.Db, (rfst(run(cs, d)), rsnd(run(cs, d))), run(cs, d), eta_l(run(cs, d))),
    batch_go(cs, Nil{}, d))

def Laws.batch_step(c, cs, db):
  %exec_all_run(cs, R.db_of(R.exec(c, db))) : {R.exec_all(Con{c, cs}, db) == R.exec_all.cons(R.reply_of(R.exec(c, db)), _) : List<&2, R.Reply> & R.Db}
  %exec_all_run(Con{c, cs}, db) : {_ == R.exec_all.cons(R.reply_of(R.exec(c, db)), run(cs, R.db_of(R.exec(c, db)))) : List<&2, R.Reply> & R.Db}
  {==}

# a batch's database after its first command runs is the one after it
def fin_cons(+c: R.Cmd, +cs: List<&2, R.Cmd>, +t: R.Db) -> {Laws.final(R.exec_all(cs, R.db_of(R.exec(c, t)))) == Laws.final(R.exec_all(Con{c, cs}, t)) : R.Db}:
  %Equal.sym(List<&2, R.Reply> & R.Db, R.exec_all(Con{c, cs}, t), R.exec_all.cons(R.reply_of(R.exec(c, t)), R.exec_all(cs, R.db_of(R.exec(c, t)))), Laws.batch_step(c, cs, t)) : {Laws.final(R.exec_all(cs, R.db_of(R.exec(c, t)))) == Laws.final(_) : R.Db}
  %eta_l(R.exec_all(cs, R.db_of(R.exec(c, t)))) : {Laws.final(_) == Laws.final(R.exec_all.cons(R.reply_of(R.exec(c, t)), _)) : R.Db}
  {==}

# Hints
# -----

# a batch run after its hints is exec_all, whatever the hints' verdict
def hinted_any(u: Bool, +cs: List<&2, R.Cmd>, +db: R.Db) -> {B.exec_hinted(u, cs, db) == R.exec_all(cs, db) : List<&2, R.Reply> & R.Db}:
  match u:
    case True{}:
      {==}
    case False{}:
      {==}

def Laws.batch_hints(cs, hs, db):
  hinted_any(U32.is_eq(B.touch_db(B.many(hs), hs, db), 0), cs, db)

# The spec's batches
# -------------------
# the helpers above, for the spec's exec on the trie alone, at a time now

def t_rfst(r: List<&2, R.Reply> & KV.Trie<KV.Val>) -> List<&2, R.Reply>:
  (rs, db) = r
  rs

def t_rsnd(r: List<&2, R.Reply> & KV.Trie<KV.Val>) -> KV.Trie<KV.Val>:
  (rs, db) = r
  db

def t_eta_r(p: R.Reply & KV.Trie<KV.Val>) -> {(T.reply_of(p), T.db_of(p)) == p : R.Reply & KV.Trie<KV.Val>}:
  (x, db) = p
  {==}

def t_eta_l(p: List<&2, R.Reply> & KV.Trie<KV.Val>) -> {(t_rfst(p), t_rsnd(p)) == p : List<&2, R.Reply> & KV.Trie<KV.Val>}:
  (rs, db) = p
  {==}

def t_run(cs: List<&2, R.Cmd>, +db: KV.Trie<KV.Val>, +now: Nat) -> List<&2, R.Reply> & KV.Trie<KV.Val>:
  match cs:
    case Nil{}:
      (Nil{}, db)
    case Con{+c, rest}:
      T.exec_all.cons(T.reply_of(T.exec(c, db, now)), t_run(rest, T.db_of(T.exec(c, db, now)), now))

def t_batch_go(cs: List<&2, R.Cmd>, +acc: List<&2, R.Reply>, +d: KV.Trie<KV.Val>, +now: Nat)
  -> {(List.reverse.go(&2, R.Reply, acc, t_rfst(t_run(cs, d, now))), t_rsnd(t_run(cs, d, now))) == T.exec_all.fin(T.exec_all.go(cs, now, (acc, d))) : List<&2, R.Reply> & KV.Trie<KV.Val>}:
  match cs:
    case Nil{}:
      {==}
    case Con{+c, +rest}:
      %t_eta_r(T.exec(c, d, now)) : {(List.reverse.go(&2, R.Reply, acc, t_rfst(t_run(Con{c, rest}, d, now))), t_rsnd(t_run(Con{c, rest}, d, now))) == T.exec_all.fin(T.exec_all.go(rest, now, T.exec_all.put(acc, _))) : List<&2, R.Reply> & KV.Trie<KV.Val>}
      %t_batch_go(rest, Con{T.reply_of(T.exec(c, d, now)), acc}, T.db_of(T.exec(c, d, now)), now) : {(List.reverse.go(&2, R.Reply, acc, t_rfst(t_run(Con{c, rest}, d, now))), t_rsnd(t_run(Con{c, rest}, d, now))) == _ : List<&2, R.Reply> & KV.Trie<KV.Val>}
      %t_eta_l(t_run(rest, T.db_of(T.exec(c, d, now)), now)) : {(List.reverse.go(&2, R.Reply, acc, t_rfst(T.exec_all.cons(T.reply_of(T.exec(c, d, now)), _))), t_rsnd(T.exec_all.cons(T.reply_of(T.exec(c, d, now)), _))) == (List.reverse.go(&2, R.Reply, Con{T.reply_of(T.exec(c, d, now)), acc}, t_rfst(t_run(rest, T.db_of(T.exec(c, d, now)), now))), t_rsnd(t_run(rest, T.db_of(T.exec(c, d, now)), now))) : List<&2, R.Reply> & KV.Trie<KV.Val>}
      {==}

def t_exec_all_run(+cs: List<&2, R.Cmd>, +d: KV.Trie<KV.Val>, +now: Nat) -> {t_run(cs, d, now) == T.exec_all(cs, d, now) : List<&2, R.Reply> & KV.Trie<KV.Val>}:
  Equal.trans(List<&2, R.Reply> & KV.Trie<KV.Val>, t_run(cs, d, now), (t_rfst(t_run(cs, d, now)), t_rsnd(t_run(cs, d, now))), T.exec_all(cs, d, now),
    Equal.sym(List<&2, R.Reply> & KV.Trie<KV.Val>, (t_rfst(t_run(cs, d, now)), t_rsnd(t_run(cs, d, now))), t_run(cs, d, now), t_eta_l(t_run(cs, d, now))),
    t_batch_go(cs, Nil{}, d, now))

# Locality
# ========
# A command on one key: its reply depends only on its key's entry (and
# the time), and so does its key's entry after it.

def first_key(ks: List<&2, String>) -> String:
  match ks:
    case Nil{}:
      ""
    case Con{k, rest}:
      k

def one_key(ks: List<&2, String>) -> Bool:
  match ks:
    case Con{k, Nil{}}:
      True{}
    case _:
      False{}

# the key of a command on keys ("" for a command of no key)
def key_of(c: R.Cmd) -> String:
  match c:
    case R.Get{k}:
      k
    case R.Set{k, v}:
      k
    case R.IncrBy{k, by}:
      k
    case R.Peek{k, o}:
      k
    case R.Upd{k, op}:
      k
    case R.Del{ks}:
      first_key(ks)
    case R.Exists{ks}:
      first_key(ks)
    case _:
      ""

# a command on one key, named once
def keyed(c: R.Cmd) -> Bool:
  match c:
    case R.Get{k}:
      True{}
    case R.Set{k, v}:
      True{}
    case R.IncrBy{k, by}:
      True{}
    case R.Peek{k, o}:
      True{}
    case R.Upd{k, op}:
      True{}
    case R.Del{ks}:
      one_key(ks)
    case R.Exists{ks}:
      one_key(ks)
    case _:
      False{}

# INCRBY's and an update's replies depend on what they read, not on the
# trie they write
def incr_fit_rep(s: R.LL, -keep: Bool, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -k: String, -h: U32) -> {T.reply_of(T.incr.fit(t, k, h, s, keep)) == T.reply_of(T.incr.fit(u, k, h, s, keep)) : R.Reply}:
  match s:
    case R.LL{+neg, +hi, +lo}:
      {==}
    case R.LLBad{}:
      {==}

def incr_num_rep(cur: R.LL, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -k: String, -h: U32, +by: R.By) -> {T.reply_of(T.incr.num(t, k, h, by, cur)) == T.reply_of(T.incr.num(u, k, h, by, cur)) : R.Reply}:
  match cur:
    case R.LL{+neg, +hi, +lo}:
      incr_fit_rep(R.ll.add(neg, hi, lo, by), True{}, t, u, k, h)
    case R.LLBad{}:
      {==}

def incr_rep(old: KV.Got, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -k: String, -h: U32, +by: R.By) -> {T.reply_of(T.incr.got(t, k, h, by, old)) == T.reply_of(T.incr.got(u, k, h, by, old)) : R.Reply}:
  match old:
    case KV.GStr{s}:
      incr_num_rep(R.ll.read(s), t, u, k, h, by)
    case KV.GColl{}:
      {==}
    case KV.GNone{}:
      incr_fit_rep(R.by.ll(by), False{}, t, u, k, h)

def upd_ch_rep(ch: R.Change, -r: R.Reply, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -k: String, -h: U32) -> {T.reply_of(T.upd.ch(t, k, h, r, ch)) == T.reply_of(T.upd.ch(u, k, h, r, ch)) : R.Reply}:
  match ch:
    case R.CKeep{}:
      {==}
    case R.CDel{}:
      {==}
    case R.CExp{e}:
      {==}
    case R.CPut{v, e}:
      {==}
    case R.CKeepT{v}:
      {==}
    case R.CApp{a, v}:
      {==}
    case R.CRange{o, a, v}:
      {==}
    case R.CHash{op, hv}:
      {==}
    case R.CHashNew{ps, hv}:
      {==}
    case R.CList{op, hv}:
      {==}
    case R.CListNew{lf, ps, hv}:
      {==}
    case R.CMems{op, sv}:
      {==}
    case R.CMemsNew{ms, sv}:
      {==}
    case R.CZset{op, z}:
      {==}
    case R.CZsetNew{o, ps, z}:
      {==}
    case R.CRestore{p, v, e}:
      {==}

def upd_rep(o: R.Out, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -k: String, -h: U32) -> {T.reply_of(T.upd.put(t, k, h, o)) == T.reply_of(T.upd.put(u, k, h, o)) : R.Reply}:
  match o:
    case R.Out{r, ch}:
      upd_ch_rep(ch, r, t, u, k, h)

def loc_reply_del(ks: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> {keyed(R.Del{ks}) == True{} : Bool} -> {KV.entry(KV.Val, t, key_of(R.Del{ks})) == KV.entry(KV.Val, u, key_of(R.Del{ks})) : Maybe<&2, KV.Item<KV.Val>>} -> {T.reply_of(T.exec(R.Del{ks}, t, now)) == T.reply_of(T.exec(R.Del{ks}, u, now)) : R.Reply}:
  match ks:
    case Nil{}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Del{Nil{}}, t, now)) == T.reply_of(T.exec(R.Del{Nil{}}, u, now)) : R.Reply}, false_true(kd))
    case Con{+k, Nil{}}:
      kd => e => Equal.trans(R.Reply, T.reply_of(T.exec(R.Del{[k]}, t, now)), R.r_int(Bool.pick(Nat, Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry(KV.Val, t, k))), 1n, 0n)), T.reply_of(T.exec(R.Del{[k]}, u, now)),
                   t_del_one_count(t, k, now),
                   Equal.trans(R.Reply, R.r_int(Bool.pick(Nat, Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry(KV.Val, t, k))), 1n, 0n)), R.r_int(Bool.pick(Nat, Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry(KV.Val, u, k))), 1n, 0n)), T.reply_of(T.exec(R.Del{[k]}, u, now)),
                     Equal.cong(Maybe<&2, KV.Item<KV.Val>>, R.Reply, m => R.r_int(Bool.pick(Nat, Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, m)), 1n, 0n)), KV.entry(KV.Val, t, k), KV.entry(KV.Val, u, k), e),
                     Equal.sym(R.Reply, T.reply_of(T.exec(R.Del{[k]}, u, now)), R.r_int(Bool.pick(Nat, Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry(KV.Val, u, k))), 1n, 0n)), t_del_one_count(u, k, now))))
    case Con{k, Con{j, rest}}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Del{Con{k, Con{j, rest}}}, t, now)) == T.reply_of(T.exec(R.Del{Con{k, Con{j, rest}}}, u, now)) : R.Reply}, false_true(kd))

def loc_reply_ex(ks: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> {keyed(R.Exists{ks}) == True{} : Bool} -> {KV.entry(KV.Val, t, key_of(R.Exists{ks})) == KV.entry(KV.Val, u, key_of(R.Exists{ks})) : Maybe<&2, KV.Item<KV.Val>>} -> {T.reply_of(T.exec(R.Exists{ks}, t, now)) == T.reply_of(T.exec(R.Exists{ks}, u, now)) : R.Reply}:
  match ks:
    case Nil{}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Exists{Nil{}}, t, now)) == T.reply_of(T.exec(R.Exists{Nil{}}, u, now)) : R.Reply}, false_true(kd))
    case Con{+k, Nil{}}:
      kd => e => %read_eq(t, k, now) : {R.r_int(Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, _), 1n, 0n), 0n)) == R.r_int(Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, KV.read(KV.Val, u, k, now)), 1n, 0n), 0n)) : R.Reply}
                 %read_eq(u, k, now) : {R.r_int(Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), 1n, 0n), 0n)) == R.r_int(Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, _), 1n, 0n), 0n)) : R.Reply}
                 Equal.cong(Maybe<&2, KV.Item<KV.Val>>, R.Reply, m => R.r_int(Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, m, now)), 1n, 0n), 0n)), KV.entry(KV.Val, t, k), KV.entry(KV.Val, u, k), e)
    case Con{k, Con{j, rest}}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Exists{Con{k, Con{j, rest}}}, t, now)) == T.reply_of(T.exec(R.Exists{Con{k, Con{j, rest}}}, u, now)) : R.Reply}, false_true(kd))

def loc_reply(c: R.Cmd, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> {keyed(c) == True{} : Bool} -> {KV.entry(KV.Val, t, key_of(c)) == KV.entry(KV.Val, u, key_of(c)) : Maybe<&2, KV.Item<KV.Val>>} -> {T.reply_of(T.exec(c, t, now)) == T.reply_of(T.exec(c, u, now)) : R.Reply}:
  match c:
    case R.Ping{}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Ping{}, t, now)) == T.reply_of(T.exec(R.Ping{}, u, now)) : R.Reply}, false_true(kd))
    case R.Echo{m}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Echo{m}, t, now)) == T.reply_of(T.exec(R.Echo{m}, u, now)) : R.Reply}, false_true(kd))
    case R.Get{+k}:
      kd => e => %get_read(t, k, now) : {R.r_getv(_) == R.r_getv(KV.get_copy(u, k, now)) : R.Reply}
                 %get_read(u, k, now) : {R.r_getv(KV.got_of(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now))) == R.r_getv(_) : R.Reply}
                 Equal.cong(Maybe<&2, KV.Item<KV.Val>>, R.Reply, m => R.r_getv(KV.got_of(Laws.live_val(KV.Val, m, now))), KV.entry(KV.Val, t, k), KV.entry(KV.Val, u, k), e)
    case R.Set{+k, +v}:
      kd => e => {==}
    case R.Del{ks}:
      loc_reply_del(ks, t, u, now)
    case R.Exists{ks}:
      loc_reply_ex(ks, t, u, now)
    case R.IncrBy{+k, +by}:
      kd => e => %get_read(t, k, now) : {T.reply_of(T.incr.got(t, k, KV.hash(k), by, _)) == T.reply_of(T.incr.got(u, k, KV.hash(k), by, KV.get_copy(u, k, now))) : R.Reply}
                 %get_read(u, k, now) : {T.reply_of(T.incr.got(t, k, KV.hash(k), by, KV.got_of(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)))) == T.reply_of(T.incr.got(u, k, KV.hash(k), by, _)) : R.Reply}
                 %e : {T.reply_of(T.incr.got(t, k, KV.hash(k), by, KV.got_of(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)))) == T.reply_of(T.incr.got(u, k, KV.hash(k), by, KV.got_of(Laws.live_val(KV.Val, _, now)))) : R.Reply}
                 incr_rep(KV.got_of(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), t, u, k, KV.hash(k), by)
    case R.MGet{ks}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.MGet{ks}, t, now)) == T.reply_of(T.exec(R.MGet{ks}, u, now)) : R.Reply}, false_true(kd))
    case R.MSet{ps}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.MSet{ps}, t, now)) == T.reply_of(T.exec(R.MSet{ps}, u, now)) : R.Reply}, false_true(kd))
    case R.DbSize{}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.DbSize{}, t, now)) == T.reply_of(T.exec(R.DbSize{}, u, now)) : R.Reply}, false_true(kd))
    case R.FlushDb{}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.FlushDb{}, t, now)) == T.reply_of(T.exec(R.FlushDb{}, u, now)) : R.Reply}, false_true(kd))
    case R.Keys{p}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Keys{p}, t, now)) == T.reply_of(T.exec(R.Keys{p}, u, now)) : R.Reply}, false_true(kd))
    case R.Sort{k, o}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Sort{k, o}, t, now)) == T.reply_of(T.exec(R.Sort{k, o}, u, now)) : R.Reply}, false_true(kd))
    case R.Scan{a}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Scan{a}, t, now)) == T.reply_of(T.exec(R.Scan{a}, u, now)) : R.Reply}, false_true(kd))
    case R.Peek{+k, +o}:
      kd => e => %entry_at_eq(KV.Val, t, k) : {R.peek.v(o, now, R.ent.live(now, _)) == R.peek.v(o, now, R.ent.live(now, KV.entry.at(KV.Val, u, k, KV.hash(k)))) : R.Reply}
                 %entry_at_eq(KV.Val, u, k) : {R.peek.v(o, now, R.ent.live(now, KV.entry(KV.Val, t, k))) == R.peek.v(o, now, R.ent.live(now, _)) : R.Reply}
                 Equal.cong(Maybe<&2, KV.Item<KV.Val>>, R.Reply, m => R.peek.v(o, now, R.ent.live(now, m)), KV.entry(KV.Val, t, k), KV.entry(KV.Val, u, k), e)
    case R.Upd{+k, +op}:
      kd => e => %entry_at_eq(KV.Val, t, k) : {T.reply_of(T.upd.put(t, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, _)))) == T.reply_of(T.upd.put(u, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, u, k, KV.hash(k)))))) : R.Reply}
                 %entry_at_eq(KV.Val, u, k) : {T.reply_of(T.upd.put(t, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, KV.entry(KV.Val, t, k))))) == T.reply_of(T.upd.put(u, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, _)))) : R.Reply}
                 %e : {T.reply_of(T.upd.put(t, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, KV.entry(KV.Val, t, k))))) == T.reply_of(T.upd.put(u, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, _)))) : R.Reply}
                 upd_rep(R.upd.v(op, now, R.ent.live(now, KV.entry(KV.Val, t, k))), t, u, k, KV.hash(k))
    case R.MSetNx{ps}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.MSetNx{ps}, t, now)) == T.reply_of(T.exec(R.MSetNx{ps}, u, now)) : R.Reply}, false_true(kd))
    case R.Rename{s, d, nx}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Rename{s, d, nx}, t, now)) == T.reply_of(T.exec(R.Rename{s, d, nx}, u, now)) : R.Reply}, false_true(kd))
    case R.BitOp{op, d, srcs}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.BitOp{op, d, srcs}, t, now)) == T.reply_of(T.exec(R.BitOp{op, d, srcs}, u, now)) : R.Reply}, false_true(kd))
    case R.LMove{op, d, srcs}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.LMove{op, d, srcs}, t, now)) == T.reply_of(T.exec(R.LMove{op, d, srcs}, u, now)) : R.Reply}, false_true(kd))
    case R.LMPop{op, d, srcs}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.LMPop{op, d, srcs}, t, now)) == T.reply_of(T.exec(R.LMPop{op, d, srcs}, u, now)) : R.Reply}, false_true(kd))
    case R.SOp{op, d}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.SOp{op, d}, t, now)) == T.reply_of(T.exec(R.SOp{op, d}, u, now)) : R.Reply}, false_true(kd))

    case R.SStore{op, d, srcs}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.SStore{op, d, srcs}, t, now)) == T.reply_of(T.exec(R.SStore{op, d, srcs}, u, now)) : R.Reply}, false_true(kd))

    case R.SMv{op, d, srcs}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.SMv{op, d, srcs}, t, now)) == T.reply_of(T.exec(R.SMv{op, d, srcs}, u, now)) : R.Reply}, false_true(kd))
    case R.ZOp{op, ks}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.ZOp{op, ks}, t, now)) == T.reply_of(T.exec(R.ZOp{op, ks}, u, now)) : R.Reply}, false_true(kd))
    case R.ZStore{op, d, srcs}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.ZStore{op, d, srcs}, t, now)) == T.reply_of(T.exec(R.ZStore{op, d, srcs}, u, now)) : R.Reply}, false_true(kd))
    case R.ZRangeStore{d, s, q}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.ZRangeStore{d, s, q}, t, now)) == T.reply_of(T.exec(R.ZRangeStore{d, s, q}, u, now)) : R.Reply}, false_true(kd))
    case R.ZMPop{ks, max, c}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.ZMPop{ks, max, c}, t, now)) == T.reply_of(T.exec(R.ZMPop{ks, max, c}, u, now)) : R.Reply}, false_true(kd))
    case R.Own{o}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Own{o}, t, now)) == T.reply_of(T.exec(R.Own{o}, u, now)) : R.Reply}, false_true(kd))
    case R.Bad{r}:
      kd => e => Empty.absurd({T.reply_of(T.exec(R.Bad{r}, t, now)) == T.reply_of(T.exec(R.Bad{r}, u, now)) : R.Reply}, false_true(kd))

# A command's effect on its key
# -----------------------------

def set_key(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +v: String) -> {KV.entry(KV.Val, KV.set(KV.Val, t, k, KV.VStr{v}), k) == KV.entry(KV.Val, KV.set(KV.Val, u, k, KV.VStr{v}), k) : Maybe<&2, KV.Item<KV.Val>>}:
  Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.set(KV.Val, t, k, KV.VStr{v}), k), Some{KV.Item{KV.VStr{v}, 0n}}, KV.entry(KV.Val, KV.set(KV.Val, u, k, KV.VStr{v}), k), e_set(t, k, v), Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.set(KV.Val, u, k, KV.VStr{v}), k), Some{KV.Item{KV.VStr{v}, 0n}}, e_set(u, k, v)))

def keep_key(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +v: KV.Val) -> {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, KV.keep(KV.Val, t, k, v), k) == KV.entry(KV.Val, KV.keep(KV.Val, u, k, v), k) : Maybe<&2, KV.Item<KV.Val>>}:
  e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.keep(KV.Val, t, k, v), k), Some{KV.Item{v, Laws.keep_exp(KV.Val, KV.entry(KV.Val, t, k))}}, KV.entry(KV.Val, KV.keep(KV.Val, u, k, v), k), Laws.entry_keep_same(KV.Val, t, k, v),
         Equal.trans(Maybe<&2, KV.Item<KV.Val>>, Some{KV.Item{v, Laws.keep_exp(KV.Val, KV.entry(KV.Val, t, k))}}, Some{KV.Item{v, Laws.keep_exp(KV.Val, KV.entry(KV.Val, u, k))}}, KV.entry(KV.Val, KV.keep(KV.Val, u, k, v), k),
           Equal.cong(Maybe<&2, KV.Item<KV.Val>>, Maybe<&2, KV.Item<KV.Val>>, m => Some{KV.Item{v, Laws.keep_exp(KV.Val, m)}}, KV.entry(KV.Val, t, k), KV.entry(KV.Val, u, k), e),
           Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.keep(KV.Val, u, k, v), k), Some{KV.Item{v, Laws.keep_exp(KV.Val, KV.entry(KV.Val, u, k))}}, Laws.entry_keep_same(KV.Val, u, k, v))))

def incr_fit_key(s: R.LL, keep: Bool, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String) -> {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.incr.fit(t, k, KV.hash(k), s, keep)), k) == KV.entry(KV.Val, T.db_of(T.incr.fit(u, k, KV.hash(k), s, keep)), k) : Maybe<&2, KV.Item<KV.Val>>}:
  match s keep:
    case R.LL{+neg, +hi, +lo} True{}:
      e => keep_key(t, u, k, KV.VStr{R.ll.show(neg, hi, lo)})(e)
    case R.LL{+neg, +hi, +lo} False{}:
      e => set_key(t, u, k, R.ll.show(neg, hi, lo))
    case R.LLBad{} True{}:
      e => e
    case R.LLBad{} False{}:
      e => e

def incr_num_key(cur: R.LL, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +by: R.By) -> {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.incr.num(t, k, KV.hash(k), by, cur)), k) == KV.entry(KV.Val, T.db_of(T.incr.num(u, k, KV.hash(k), by, cur)), k) : Maybe<&2, KV.Item<KV.Val>>}:
  match cur:
    case R.LL{+neg, +hi, +lo}:
      incr_fit_key(R.ll.add(neg, hi, lo, by), True{}, t, u, k)
    case R.LLBad{}:
      e => e

def incr_key(old: KV.Got, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +by: R.By) -> {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.incr.got(t, k, KV.hash(k), by, old)), k) == KV.entry(KV.Val, T.db_of(T.incr.got(u, k, KV.hash(k), by, old)), k) : Maybe<&2, KV.Item<KV.Val>>}:
  match old:
    case KV.GStr{s}:
      incr_num_key(R.ll.read(s), t, u, k, by)
    case KV.GColl{}:
      e => e
    case KV.GNone{}:
      incr_fit_key(R.by.ll(by), False{}, t, u, k)

def upd_ch_key(ch: R.Change, -r: R.Reply, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String) -> {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.upd.ch(t, k, KV.hash(k), r, ch)), k) == KV.entry(KV.Val, T.db_of(T.upd.ch(u, k, KV.hash(k), r, ch)), k) : Maybe<&2, KV.Item<KV.Val>>}:
  match ch:
    case R.CKeep{}:
      e => e
    case R.CDel{}:
      e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.del(KV.Val, t, k), k), None{}, KV.entry(KV.Val, KV.del(KV.Val, u, k), k), Laws.entry_del_same(KV.Val, t, k), Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.del(KV.Val, u, k), k), None{}, Laws.entry_del_same(KV.Val, u, k)))
    case R.CExp{+x}:
      e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.expire(KV.Val, t, k, x), k), Laws.with_exp(KV.Val, KV.entry(KV.Val, t, k), x), KV.entry(KV.Val, KV.expire(KV.Val, u, k, x), k), Laws.entry_expire_same(KV.Val, t, k, x),
             Equal.trans(Maybe<&2, KV.Item<KV.Val>>, Laws.with_exp(KV.Val, KV.entry(KV.Val, t, k), x), Laws.with_exp(KV.Val, KV.entry(KV.Val, u, k), x), KV.entry(KV.Val, KV.expire(KV.Val, u, k, x), k),
               Equal.cong(Maybe<&2, KV.Item<KV.Val>>, Maybe<&2, KV.Item<KV.Val>>, m => Laws.with_exp(KV.Val, m, x), KV.entry(KV.Val, t, k), KV.entry(KV.Val, u, k), e),
               Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.expire(KV.Val, u, k, x), k), Laws.with_exp(KV.Val, KV.entry(KV.Val, u, k), x), Laws.entry_expire_same(KV.Val, u, k, x))))
    case R.CPut{+v, +x}:
