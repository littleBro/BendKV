def counted_copy_of(+src: String, +dst: String, +j: Nat, +rep: Bool, my: Maybe<&2, R.Db>, +ds: R.Ds) -> {counted_mdb(my) == True{} : Bool} -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds_of(R.act.moved(R.ds.copy.of(src, dst, j, rep, my, ds)))) == True{} : Bool}:
