            ok

def counted_dels(ks: List<&2, String>, +now: Nat, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, -rr: Maybe<&2, R.Db>) -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {Laws.counted(R.db_of(R.del.db(R.del_keys(ks, now, t), n, x, now, rr))) == True{} : Bool}:
  match ks:
    case Nil{}:
      ok => %Equal.sym(Nat, Nat.sub(n, 0n), n, sub_zero(n)) : {Laws.counted(R.Db{t, _, Nat.sub(x, 0n), now, rr}) == True{} : Bool}
            %Equal.sym(Nat, Nat.sub(x, 0n), x, sub_zero(x)) : {Laws.counted(R.Db{t, n, _, now, rr}) == True{} : Bool}
            ok
    case Con{+k, +rest}:
      ok => dels_put(R.del_keys(rest, now, KV.del.at(KV.Val, t, k, KV.hash(k))), KV.code.at(KV.Val, t, k, KV.hash(k)), now, n, x, rr)(counted_dels(rest, now, KV.del.at(KV.Val, t, k, KV.hash(k)), Nat.sub(n, dead(Laws.WAll{}, KV.code.at(KV.Val, t, k, KV.hash(k)))), Nat.sub(x, dead(Laws.WTimed{}, KV.code.at(KV.Val, t, k, KV.hash(k)))), rr)(cnt_del_any(t, k, KV.hash(k), n, x, now, rr)(ok)))

def counted_del(db: R.Db, ks: List<&2, String>) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.db.del(db, ks))) == True{} : Bool}:
  match db:
    case R.Db{+t, +n, +x, +now, rr}:
      counted_dels(ks, now, t, n, x, rr)

def got_is_none(g: KV.Got) -> Type:
  match g:
    case KV.GNone{}:
      Unit
    case KV.GStr{s}:
      Empty
    case KV.GColl{}:
      Empty

# any database a command takes apart: as an update, a delete, ...
def counted_upd_db(db: R.Db, +k: String, +op: R.UpdOp) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.db.upd(db, k, op))) == True{} : Bool}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      counted_upd(t, n, x, now, rr, k, op)

def counted_msetnx_of(any: Bool, ps: List<&2, R.KVPair>, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.msetnx.of(any, ps, db))) == True{} : Bool}:
  match any:
    case True{}:
      ok => ok
    case False{}:
      counted_mset(ps, db)

def counted_bitop_db(e: Bool, +v: String, +d: String, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.bitop.db(e, v, d, db)) == True{} : Bool}:
  match e:
    case True{}:
      counted_del(db, [d])
    case False{}:
      counted_set(db, d, v)

def counted_bitop_do(w: Bool, +op: R.BitK, +d: String, +srcs: List<&2, String>, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.bitop.do(w, op, d, srcs, db))) == True{} : Bool}:
  match w:
    case True{}:
      ok => ok
    case False{}:
      counted_bitop_db(String.is_empty(R.bitop.val(op, srcs, R.db.now(db), R.db.trie(db))), R.bitop.val(op, srcs, R.db.now(db), R.db.trie(db)), d, db)

def r_lmpop_out_db(+k: String, r: R.Reply & R.Db) -> {R.db_of(R.lmpop.out(k, r)) == R.db_of(r) : R.Db}:
  match r:
    case (a, b):
      {==}

def r_zmpop_out_db(+k: String, r: R.Reply & R.Db) -> {R.db_of(R.zmpop.out(k, r)) == R.db_of(r) : R.Db}:
  match r:
    case (a, b):
      {==}

def counted_lmpop_at(m: Maybe<&2, String>, +left: Bool, +c: String, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.lmpop.at(m, left, c, db))) == True{} : Bool}:
  match m:
    case Some{+k}:
      ok => %Equal.sym(R.Db, R.db_of(R.lmpop.out(k, R.db.upd(db, k, R.UList{R.LWPopN{left, c}}))), R.db_of(R.db.upd(db, k, R.UList{R.LWPopN{left, c}})), r_lmpop_out_db(k, R.db.upd(db, k, R.UList{R.LWPopN{left, c}}))) : {Laws.counted(_) == True{} : Bool}
            counted_upd_db(db, k, R.UList{R.LWPopN{left, c}})(ok)
    case None{}:
      ok => ok

def counted_zmpop_at(m: Maybe<&2, String>, +max: Bool, +c: String, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.zmpop.at(m, max, c, db))) == True{} : Bool}:
  match m:
    case Some{+k}:
      ok => %Equal.sym(R.Db, R.db_of(R.zmpop.out(k, R.db.upd(db, k, R.UZset{R.ZWPopN{max, c}}))), R.db_of(R.db.upd(db, k, R.UZset{R.ZWPopN{max, c}})), r_zmpop_out_db(k, R.db.upd(db, k, R.UZset{R.ZWPopN{max, c}}))) : {Laws.counted(_) == True{} : Bool}
            counted_upd_db(db, k, R.UZset{R.ZWPopN{max, c}})(ok)
    case None{}:
      ok => ok

def counted_sstore_of(xs: List<&2, String>, +d: String, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.sstore.of(xs, d, db))) == True{} : Bool}:
  match xs:
    case Nil{}:
      counted_del(db, [d])
    case Con{x, rest}:
      counted_upd_db(db, d, R.UMems{R.SWNew{x <> rest}})

def counted_sstore_do(g: R.SGot, op: R.SetK, ks: List<&2, String>, +d: String, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.sstore.do(g, op, ks, d, db))) == True{} : Bool}:
  match g:
    case R.SGot{ss}:
      counted_sstore_of(R.sop.members(op, ks, ss), d, db)
    case R.SGotWrong{}:
      ok => ok

def counted_smove_do(f: R.Smv, +s: String, +d: String, +w: R.SMem, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.smove.do(f, s, d, w, db))) == True{} : Bool}:
  match f:
    case R.SmvZero{}:
      ok => ok
    case R.SmvWrong{}:
      ok => ok
    case R.SmvSame{had}:
      ok => ok
    case R.SmvGo{}:
      ok => counted_upd_db(R.db_of(R.db.upd(db, s, R.UMems{R.SWRem{[R.smv.member(w)]}})), d, R.UMems{R.smv.add(w)})(counted_upd_db(db, s, R.UMems{R.SWRem{[R.smv.member(w)]}})(ok))

def counted_zstore_of(xs: List<&2, KV.ZEl>, +d: String, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.zstore.of(xs, d, db))) == True{} : Bool}:
  match xs:
    case Nil{}:
      counted_del(db, [d])
    case Con{x, rest}:
      counted_upd_db(db, d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(x <> rest)}})

def counted_zstore_ok(bad: Maybe<&2, R.Reply>, +op: R.ZSetK, ss: List<&2, R.ZSrc>, +d: String, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.zstore.ok(bad, op, ss, d, db))) == True{} : Bool}:
  match bad:
    case Some{r}:
      ok => ok
    case None{}:
      counted_zstore_of(R.zop.els(op, ss), d, db)

def counted_zstore_do(g: R.ZGot, +op: R.ZSetK, +d: String, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.zstore.do(g, op, d, db))) == True{} : Bool}:
  match g:
    case R.ZGot{ss}:
      counted_zstore_ok(R.zop.bad(op), op, ss, d, db)
    case R.ZGotWrong{}:
      ok => ok

def counted_zrs_of(m: Maybe<&2, KV.Val>, q: R.ZQ, +d: String, +db: R.Db) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.zrs.of(m, q, d, db))) == True{} : Bool}:
  match m:
    case None{}:
      counted_zstore_of(Nil{}, d, db)
    case Some{KV.VColl{KV.CZset{z}}}:
      counted_zstore_of(R.zq.run(q, z), d, db)
    case Some{KV.VColl{KV.CHash{a}}}:
      ok => ok
    case Some{KV.VColl{KV.CList{a}}}:
      ok => ok
    case Some{KV.VColl{KV.CMems{a}}}:
      ok => ok
    case Some{KV.VColl{KV.CStream{a}}}:
      ok => ok
    case Some{KV.VStr{a}}:
      ok => ok

# INCRBY: a value it finds is there, and stays with its time
def got_none_str(-s: String, g: {KV.GNone{} == KV.GStr{s} : KV.Got}) -> Empty:
  %g : got_is_none(_)
  Unit{}

def nz_of_got(m: Maybe<&2, KV.Item<KV.Val>>, +now: Nat, -s: String) -> {KV.got_of(Laws.live_val(KV.Val, m, now)) == KV.GStr{s} : KV.Got} -> {Nat.is_eq(R.ent.code(m), 0n) == False{} : Bool}:
  match m:
    case Some{KV.Item{v, e}}:
      g => {==}
    case None{}:
      g => Empty.absurd({Nat.is_eq(R.ent.code(None{}), 0n) == False{} : Bool}, got_none_str(s, g))

def nz_code(+t: KV.Trie<KV.Val>, +k: String, +now: Nat, -s: String) -> {KV.GStr{s} == KV.get_copy.at(t, k, KV.hash(k), now) : KV.Got} -> {Nat.is_eq(KV.code.at(KV.Val, t, k, KV.hash(k)), 0n) == False{} : Bool}:
  e => %code_m(t, k, KV.entry(KV.Val, t, k), {==}) : {Nat.is_eq(_, 0n) == False{} : Bool}
       nz_of_got(KV.entry(KV.Val, t, k), now, s)(Equal.trans(KV.Got, KV.got_of(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), KV.got_of(KV.read(KV.Val, t, k, now)), KV.GStr{s}, Equal.cong(Maybe<&2, KV.Val>, KV.Got, z => KV.got_of(z), Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now), KV.read(KV.Val, t, k, now), Equal.sym(Maybe<&2, KV.Val>, KV.read(KV.Val, t, k, now), Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now), Laws.read_entry(KV.Val, t, k, now))), Equal.trans(KV.Got, KV.got_of(KV.read(KV.Val, t, k, now)), KV.get_copy.at(t, k, KV.hash(k), now), KV.GStr{s}, get_copy_eq(t, k, now), Equal.sym(KV.Got, KV.GStr{s}, KV.get_copy.at(t, k, KV.hash(k), now), e))))

def cnt_keep_nz(+t: KV.Trie<KV.Val>, +k: String, +v: KV.Val, +h: U32, +n: Nat, +x: Nat, -now: Nat, -rr: Maybe<&2, R.Db>) -> {Nat.is_eq(KV.code.at(KV.Val, t, k, h), 0n) == False{} : Bool} -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {Laws.counted(R.Db{KV.keep.at(KV.Val, t, k, v, h), n, x, now, rr}) == True{} : Bool}:
  nz => ok => %nz : {Laws.counted(R.Db{KV.keep.at(KV.Val, t, k, v, h), Bool.pick(Nat, _, 1n+n, n), x, now, rr}) == True{} : Bool}
              cnt_keep(t, k, v, h, n, x, now, rr)(ok)

def counted_incr_fit_keep(s: R.LL, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Nat.is_eq(KV.code.at(KV.Val, t, k, KV.hash(k)), 0n) == False{} : Bool} -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {Laws.counted(R.db_of(R.incr.fit(t, k, KV.hash(k), s, True{}, n, n, x, x, now, rr))) == True{} : Bool}:
  match s:
    case R.LL{+neg, +hi, +lo}:
      cnt_keep_nz(t, k, KV.VStr{R.ll.show(neg, hi, lo)}, KV.hash(k), n, x, now, rr)
    case R.LLBad{}:
      nz => ok => ok

def counted_incr_num(+t: KV.Trie<KV.Val>, +k: String, +by: R.By, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, cur: R.LL) -> {Nat.is_eq(KV.code.at(KV.Val, t, k, KV.hash(k)), 0n) == False{} : Bool} -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {Laws.counted(R.db_of(R.incr.num(t, k, KV.hash(k), by, n, x, now, rr, cur))) == True{} : Bool}:
  match cur:
    case R.LL{+neg, +hi, +lo}:
      counted_incr_fit_keep(R.ll.add(neg, hi, lo, by), t, k, n, x, now, rr)
    case R.LLBad{}:
      nz => ok => ok

def counted_incr_fit_new(s: R.LL, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {Laws.counted(R.db_of(R.incr.fit(t, k, KV.hash(k), s, False{}, R.cnt.n(KV.code.at(KV.Val, t, k, KV.hash(k)), n), n, R.cnt.x(KV.code.at(KV.Val, t, k, KV.hash(k)), 0n, x), x, now, rr))) == True{} : Bool}:
  match s:
    case R.LL{+neg, +hi, +lo}:
      cnt_setx(t, k, KV.VStr{R.ll.show(neg, hi, lo)}, 0n, KV.hash(k), n, x, now, rr)
    case R.LLBad{}:
      ok => ok

def counted_incr_got(+t: KV.Trie<KV.Val>, +k: String, +by: R.By, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, g: KV.Got) -> {g == KV.get_copy.at(t, k, KV.hash(k), now) : KV.Got} -> {Laws.counted(R.Db{t, n, x, now, rr}) == True{} : Bool} -> {Laws.counted(R.db_of(R.incr.got(t, k, KV.hash(k), by, n, x, now, rr, g))) == True{} : Bool}:
  match g:
    case KV.GStr{s}:
      eg => counted_incr_num(t, k, by, n, x, now, rr, R.ll.read(s))(nz_code(t, k, now, s)(eg))
    case KV.GColl{}:
      eg => ok => ok
    case KV.GNone{}:
      eg => counted_incr_fit_new(R.by.ll(by), t, k, n, x, now, rr)

def counted_incr(db: R.Db, +k: String, +by: R.By) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.db.incr(db, k, by))) == True{} : Bool}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      counted_incr_got(t, k, by, n, x, now, rr, KV.get_copy.at(t, k, KV.hash(k), now))({==})

def msome0(m: Maybe<&2, KV.Item<KV.Val>>) -> Type:
  match m:
    case Some{y}:
      Unit
    case None{}:
      Empty

def some_none(-y: KV.Item<KV.Val>, g: {Some{y} == None{} : Maybe<&2, KV.Item<KV.Val>>}) -> Empty:
  %g : msome0(_)
  Unit{}

# RENAME: src, there, is the same after dst is set
