# an act keeps every database counted
# a command of one database run on the focus keeps every database counted
def counted_cmd(+c: R.Cmd, +ds: R.Ds) -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds_of(R.act(R.ARun{c}, ds))) == True{} : Bool}:
  match ds:
    case R.Ds{+d, +pre, +post}:
      +e => %Equal.sym(R.Ds, R.ds_of(R.act.run(R.exec(c, d), pre, post)), R.Ds{R.db_of(R.exec(c, d)), pre, post}, act_run_ds(R.exec(c, d), pre, post)) : {Laws.counted_ds(_) == True{} : Bool}
            and_true(Laws.counted(R.db_of(R.exec(c, d))), Bool.and(Laws.counted_list(pre), Laws.counted_list(post)))(counted_exec(c, d)(and_l(Laws.counted(d), Bool.and(Laws.counted_list(pre), Laws.counted_list(post)))(e)))(and_r(Laws.counted(d), Bool.and(Laws.counted_list(pre), Laws.counted_list(post)))(e))

def counted_act(a: R.Act, +ds: R.Ds) -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds_of(R.act(a, ds))) == True{} : Bool}:
  match a ds:
    case R.ARun{+c} x:
      counted_cmd(c, x)
    case R.AFocus{+j} x:
      counted_focus_if(Nat.is_eq(R.ds.index(x), j), j, x)
    case R.ASwap{+a, +b} x:
      +e => counted_swap_of(a, b, R.ds.nth(a, R.ds.list(x)), R.ds.nth(b, R.ds.list(x)), R.ds.list(x), x)(counted_nth(a, R.ds.list(x))(counted_ds_list(x)(e)))(counted_nth(b, R.ds.list(x))(counted_ds_list(x)(e)))(counted_ds_list(x)(e))(e)
    case R.APurge{+k, +j} x:
      +e => counted_purge_of(k, j, R.ds.nth(j, R.ds.list(x)), R.ds.list(x), x)(counted_nth(j, R.ds.list(x))(counted_ds_list(x)(e)))(counted_ds_list(x)(e))(e)
    case R.AMove{+k, +j} x:
      +e => counted_move_of(k, j, R.ds.nth(j, R.ds.list(x)), x)(counted_nth(j, R.ds.list(x))(counted_ds_list(x)(e)))(e)
    case R.ACopy{+s, +d, +j, +rep} x:
      +e => counted_copy_of(s, d, j, rep, R.ds.nth(j, R.ds.list(x)), x)(counted_nth(j, R.ds.list(x))(counted_ds_list(x)(e)))(e)
    case R.ACopyHere{+s, +d, +rep} x:
      +e => counted_copy_of(s, d, R.ds.index(x), rep, R.ds.nth(R.ds.index(x), R.ds.list(x)), x)(counted_nth(R.ds.index(x), R.ds.list(x))(counted_ds_list(x)(e)))(e)
    case R.AWipe{} x:
      e => counted_wipe(x)
    case R.ASort{+k, +ob} x:
      counted_cmd(R.sort.write.ds(x, k, ob), x)
    case R.APfMerge{+d, +srcs} x:
      counted_cmd(R.pf.merge.ds(x, d, srcs), x)
    case R.AGeo{+k, +args} x:
      counted_cmd(R.geo.store.ds(x, k, args), x)

def counted_acts(as: List<&2, R.Act>, +ds: R.Ds) -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.acts(as, ds)) == True{} : Bool}:
  match as:
    case Nil{}:
      e => e
    case Con{+a, rest}:
      e => counted_acts(rest, R.ds_of(R.act(a, ds)))(counted_act(a, ds)(e))

def counted_ds_at(+now: Nat, ds: R.Ds) -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds.at(now, ds)) == True{} : Bool}:
  match ds:
    case R.Ds{+d, pre, post}:
      e => %Equal.sym(Bool, Laws.counted(R.db.at(now, d)), Laws.counted(d), counted_at(now, d)) : {Bool.and(_, Bool.and(Laws.counted_list(pre), Laws.counted_list(post))) == True{} : Bool}
           e

def counted_empty_go(n: Nat) -> {Laws.counted_list(R.ds.empty.go(n)) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      counted_empty_go(m)

def counted_batch(b: Laws.Run, +ds: R.Ds) -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(Laws.batch_at(b, ds)) == True{} : Bool}:
  match b:
    case Laws.Run{+now, as}:
      e => counted_acts(as, R.ds.at(now, ds))(counted_ds_at(now, ds)(e))
    case Laws.RunTx{+now, as}:
      e => counted_acts(as, R.ds.at(now, ds))(counted_ds_at(now, ds)(e))

# after any history, every database is counted
def counted_single(hist: List<&2, Laws.Run>, +n: Nat) -> {Laws.counted_ds(Laws.single(hist, n)) == True{} : Bool}:
  match hist:
    case Nil{}:
      counted_empty_go(n)
    case Con{b, +older}:
      counted_batch(b, Laws.single(older, n))(counted_single(older, n))

