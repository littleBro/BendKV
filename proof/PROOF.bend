def mv_src_ent(empty: Bool, db: R.Db, +s: String, +l: KV.Deq, +k: String, ne: {k != s : String}) -> {R.db.ent(R.mv.src(empty, s, l, db), k) == R.db.ent(db, k) : Maybe<&2, KV.Item<KV.Val>>}:
  match empty db:
    case True{} R.Db{+t, n, x, +now, rr}:
      ent_other_del(t, s, k, now, ne)
    case False{} R.Db{+t, n, x, +now, rr}:
      ent_other_keep(t, s, k, KV.VColl{KV.CList{l}}, now, ne)

def counted_mv_src(empty: Bool, +s: String, +l: KV.Deq, +db: R.Db, -w: KV.Val, +q: Nat) -> {R.db.ent(db, s) == Some{KV.Item{w, q}} : Maybe<&2, KV.Item<KV.Val>>} -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.mv.src(empty, s, l, db)) == True{} : Bool}:
  match empty:
    case True{}:
      th => counted_del(db, [s])
    case False{}:
      counted_keepl(db, s, l, w, q)

def counted_mv_self(p: KV.Pop, +e: R.LEnds, +s: String, +db: R.Db, -w: KV.Val, +q: Nat) -> {R.db.ent(db, s) == Some{KV.Item{w, q}} : Maybe<&2, KV.Item<KV.Val>>} -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db_of(R.mv.self(p, e, s, db))) == True{} : Bool}:
