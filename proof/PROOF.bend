    case None{} Some{y}:
      ea => eb => lx => eds => eds
    case None{} None{}:
      ea => eb => lx => eds => eds

def counted_purge_if(ok: Bool, +k: String, +j: Nat, +y: R.Db, +xs: List<&2, R.Db>, +ds: R.Ds) -> {Laws.counted(y) == True{} : Bool} -> {Laws.counted_list(xs) == True{} : Bool} -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds_of(R.act.ok(R.ds.purge.if(ok, k, j, y, xs, ds)))) == True{} : Bool}:
