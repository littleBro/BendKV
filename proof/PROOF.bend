def getdel_db(+db: R.Db, +k: String, +v: String, +e: Nat) -> {Laws.there(db, k) == Some{KV.Item{KV.VStr{v}, e}} : Maybe<&2, KV.Item<KV.Val>>} -> {Laws.at_key(R.exec(R.Upd{k, R.UGetDel{}}, db), k) == (R.RBulk{v}, None{}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      h =>
        %entry_at_eq(KV.Val, t, k) : {Laws.at_key(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(_), R.upd.v(R.UGetDel{}, now, R.ent.live(now, _))), k) == (R.RBulk{v}, None{}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
        %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(now, KV.entry(KV.Val, t, k)), Some{KV.Item{KV.VStr{v}, e}}, h) : {Laws.at_key(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry(KV.Val, t, k)), R.upd.v(R.UGetDel{}, now, _)), k) == (R.RBulk{v}, None{}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
        %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.del(KV.Val, t, k), k), None{}, Laws.entry_del_same(KV.Val, t, k)) : {(R.RBulk{v}, _) == (R.RBulk{v}, None{}) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
        {==}

def Laws.getdel_effect(db, k, v, e, h):
  getdel_db(db, k, v, e)(h)

# keys that compare unequal, the other way round
def ne_sym(+s: String, +d: String, +ne: {KV.str_eq(s, d) == False{} : Bool}) -> {d != s : String}:
  z => neq_eq(s, d, Equal.sym(Bool, KV.str_eq(s, d), False{}, ne), Equal.sym(String, d, s, z))

# RENAME of a key there to another one: the verdict is the move (the
# entry read at now is the key's entry), then the source is deleted and
# the destination holds the entry
def rename_go(+t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +s: String, +d: String, +v: KV.Val, +e: Nat, h: {R.ent.live(now, KV.entry(KV.Val, t, s)) == Some{KV.Item{v, e}} : Maybe<&2, KV.Item<KV.Val>>}, +ne: {KV.str_eq(s, d) == False{} : Bool}) -> {Laws.at_keys(R.exec(R.Rename{s, d, False{}}, R.Db{t, n, x, now, rr}), s, d) == (R.r_ok(), (None{}, Some{KV.Item{v, e}})) : R.Reply & (Maybe<&2, KV.Item<KV.Val>> & Maybe<&2, KV.Item<KV.Val>>)}:
  nds = ne_sym(s, d, ne)
  %entry_at_eq(KV.Val, t, s) : {Laws.at_keys(R.ren.do(R.ren.of(R.ent.live(now, _), KV.str_eq(s, d), False{}), False{}, s, d, R.Db{t, n, x, now, rr}), s, d) == (R.r_ok(), (None{}, Some{KV.Item{v, e}})) : R.Reply & (Maybe<&2, KV.Item<KV.Val>> & Maybe<&2, KV.Item<KV.Val>>)}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(now, KV.entry(KV.Val, t, s)), Some{KV.Item{v, e}}, h) : {Laws.at_keys(R.ren.do(R.ren.of(_, KV.str_eq(s, d), False{}), False{}, s, d, R.Db{t, n, x, now, rr}), s, d) == (R.r_ok(), (None{}, Some{KV.Item{v, e}})) : R.Reply & (Maybe<&2, KV.Item<KV.Val>> & Maybe<&2, KV.Item<KV.Val>>)}
  %Equal.sym(Bool, KV.str_eq(s, d), False{}, ne) : {Laws.at_keys(R.ren.do(R.ren.of(Some{KV.Item{v, e}}, _, False{}), False{}, s, d, R.Db{t, n, x, now, rr}), s, d) == (R.r_ok(), (None{}, Some{KV.Item{v, e}})) : R.Reply & (Maybe<&2, KV.Item<KV.Val>> & Maybe<&2, KV.Item<KV.Val>>)}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.del(KV.Val, KV.setx(KV.Val, t, d, v, e), s), s), None{}, Laws.entry_del_same(KV.Val, KV.setx(KV.Val, t, d, v, e), s)) : {(R.r_ok(), (_, KV.entry(KV.Val, KV.del(KV.Val, KV.setx(KV.Val, t, d, v, e), s), d))) == (R.r_ok(), (None{}, Some{KV.Item{v, e}})) : R.Reply & (Maybe<&2, KV.Item<KV.Val>> & Maybe<&2, KV.Item<KV.Val>>)}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.del(KV.Val, KV.setx(KV.Val, t, d, v, e), s), d), KV.entry(KV.Val, KV.setx(KV.Val, t, d, v, e), d), Laws.entry_del_other(KV.Val, KV.setx(KV.Val, t, d, v, e), s, d, nds)) : {(R.r_ok(), (None{}, _)) == (R.r_ok(), (None{}, Some{KV.Item{v, e}})) : R.Reply & (Maybe<&2, KV.Item<KV.Val>> & Maybe<&2, KV.Item<KV.Val>>)}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.setx(KV.Val, t, d, v, e), d), Some{KV.Item{v, e}}, Laws.entry_setx_same(KV.Val, t, d, v, e)) : {(R.r_ok(), (None{}, _)) == (R.r_ok(), (None{}, Some{KV.Item{v, e}})) : R.Reply & (Maybe<&2, KV.Item<KV.Val>> & Maybe<&2, KV.Item<KV.Val>>)}
  {==}

def rename_db(+db: R.Db, +s: String, +d: String, +v: KV.Val, +e: Nat) -> {Laws.there(db, s) == Some{KV.Item{v, e}} : Maybe<&2, KV.Item<KV.Val>>} -> {KV.str_eq(s, d) == False{} : Bool} -> {Laws.at_keys(R.exec(R.Rename{s, d, False{}}, db), s, d) == (R.r_ok(), (None{}, Some{KV.Item{v, e}})) : R.Reply & (Maybe<&2, KV.Item<KV.Val>> & Maybe<&2, KV.Item<KV.Val>>)}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      h => ne => rename_go(t, n, x, now, rr, s, d, v, e, h, ne)

def Laws.rename_effect(db, s, d, v, e, h, ne):
  rename_db(db, s, d, v, e)(h)(ne)

# MSETNX's verdict is whether a key of its pairs is there
def some_live_b(b: Bool, -v: KV.Val, -e: Nat) -> {Maybe.is_some(&2, KV.Val, KV.blive.ent(KV.Val, b, v)) == Maybe.is_some(&2, KV.Item<KV.Val>, Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{})) : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def some_live(m: Maybe<&2, KV.Item<KV.Val>>, +now: Nat) -> {Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, m, now)) == Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, m)) : Bool}:
  match m:
    case Some{KV.Item{v, +e}}:
      some_live_b(KV.live(now, e), v, e)
    case None{}:
      {==}

def live_there(ps: List<&2, R.KVPair>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.pairs.live(ps, now, t) == Laws.any_there(R.Db{t, n, x, now, rr}, Laws.pair_keys(ps)) : Bool}:
  match ps:
    case Nil{}:
      {==}
    case Con{R.KP{+k, +v}, +rest}:
      %read_eq(t, k, now) : {Bool.or(Maybe.is_some(&2, KV.Val, _), R.pairs.live(rest, now, t)) == Laws.any_there(R.Db{t, n, x, now, rr}, k <> Laws.pair_keys(rest)) : Bool}
      %Equal.sym(Bool, Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry(KV.Val, t, k))), some_live(KV.entry(KV.Val, t, k), now)) : {Bool.or(_, R.pairs.live(rest, now, t)) == Laws.any_there(R.Db{t, n, x, now, rr}, k <> Laws.pair_keys(rest)) : Bool}
      %Equal.sym(Bool, R.pairs.live(rest, now, t), Laws.any_there(R.Db{t, n, x, now, rr}, Laws.pair_keys(rest)), live_there(rest, t, n, x, now, rr)) : {Bool.or(Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry(KV.Val, t, k))), _) == Laws.any_there(R.Db{t, n, x, now, rr}, k <> Laws.pair_keys(rest)) : Bool}
      {==}

def msetnx_db(+t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +ps: List<&2, R.KVPair>, -b: Bool, e: {Laws.any_there(R.Db{t, n, x, now, rr}, Laws.pair_keys(ps)) == b : Bool}) -> {R.exec(R.MSetNx{ps}, R.Db{t, n, x, now, rr}) == R.msetnx.of(b, ps, R.Db{t, n, x, now, rr}) : R.Reply & R.Db}:
  %Equal.sym(Bool, R.pairs.live(ps, now, t), b, Equal.trans(Bool, R.pairs.live(ps, now, t), Laws.any_there(R.Db{t, n, x, now, rr}, Laws.pair_keys(ps)), b, live_there(ps, t, n, x, now, rr), e)) : {R.msetnx.of(_, ps, R.Db{t, n, x, now, rr}) == R.msetnx.of(b, ps, R.Db{t, n, x, now, rr}) : R.Reply & R.Db}
  {==}

def msetnx_present_db(+db: R.Db, +ps: List<&2, R.KVPair>) -> {Laws.any_there(db, Laws.pair_keys(ps)) == True{} : Bool} -> {R.exec(R.MSetNx{ps}, db) == (R.r_int(0n), db) : R.Reply & R.Db}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      e => msetnx_db(t, n, x, now, rr, ps, True{}, e)

def msetnx_missing_db(+db: R.Db, +ps: List<&2, R.KVPair>) -> {Laws.any_there(db, Laws.pair_keys(ps)) == False{} : Bool} -> {R.exec(R.MSetNx{ps}, db) == (R.r_int(1n), R.db_of(R.exec(R.MSet{ps}, db))) : R.Reply & R.Db}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      e => msetnx_db(t, n, x, now, rr, ps, False{}, e)

def Laws.msetnx_present(db, ps, e):
  msetnx_present_db(db, ps)(e)

def Laws.msetnx_missing(db, ps, e):
  msetnx_missing_db(db, ps)(e)


# BITOP's destination after it: deleted for an empty value, else the value
# with no time
def bitop_store_go(e: Bool, +v: String, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.at_key((R.r_int(String.length(v)), R.bitop.db(e, v, d, R.Db{t, n, x, now, rr})), d) == (R.r_int(String.length(v)), Laws.stored(e, v)) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}:
  match e:
    case True{}:
      %Laws.entry_del_same(KV.Val, t, d) : {Laws.at_key((R.r_int(String.length(v)), R.bitop.db(True{}, v, d, R.Db{t, n, x, now, rr})), d) == (R.r_int(String.length(v)), _) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
      {==}
    case False{}:
      %Laws.entry_setx_same(KV.Val, t, d, KV.VStr{v}, 0n) : {Laws.at_key((R.r_int(String.length(v)), R.bitop.db(False{}, v, d, R.Db{t, n, x, now, rr})), d) == (R.r_int(String.length(v)), _) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
      {==}

def bitop_store_db(+op: R.BitK, +d: String, +srcs: List<&2, String>, +db: R.Db) -> {R.bitop.wrong(srcs, R.db.now(db), R.db.trie(db)) == False{} : Bool} -> {Laws.at_key(R.exec(R.BitOp{op, d, srcs}, db), d) == (R.r_int(String.length(Laws.bitop_val(op, srcs, db))), Laws.stored(String.is_empty(Laws.bitop_val(op, srcs, db)), Laws.bitop_val(op, srcs, db))) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      nw => %Equal.sym(Bool, R.bitop.wrong(srcs, now, t), False{}, nw) : {Laws.at_key(R.bitop.do(_, op, d, srcs, R.Db{t, n, x, now, rr}), d) == (R.r_int(String.length(R.bitop.val(op, srcs, now, t))), Laws.stored(String.is_empty(R.bitop.val(op, srcs, now, t)), R.bitop.val(op, srcs, now, t))) : R.Reply & Maybe<&2, KV.Item<KV.Val>>}
            bitop_store_go(String.is_empty(R.bitop.val(op, srcs, now, t)), R.bitop.val(op, srcs, now, t), d, t, n, x, now, rr)

def Laws.bitop_store(op, d, srcs, db, nw):
  bitop_store_db(op, d, srcs, db)(nw)

def Laws.batch_nil(db):
  {==}

# a command that does not need the count (all but DBSIZE, KEYS, SCAN)
# answers alike after another that does not disturb it, as the spec's
def reply_via(+c1: R.Cmd, +c2: R.Cmd, +db: R.Db, +kw: {Laws.keywise(c1) == True{} : Bool}, e: {Laws.disturbs(c2, c1) == False{} : Bool}) -> {R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db)))) == R.reply_of(R.exec(c1, db)) : R.Reply}:
  %br(c1, R.db_of(R.exec(c2, db)), kw) : {_ == R.reply_of(R.exec(c1, db)) : R.Reply}
  %bt(c2, db) : {T.reply_of(T.exec(c1, _, R.db.now(R.db_of(R.exec(c2, db))))) == R.reply_of(R.exec(c1, db)) : R.Reply}
  %eq_now(c2, db) : {T.reply_of(T.exec(c1, T.db_of(T.exec(c2, R.db.t(db), R.db.now(db))), _)) == R.reply_of(R.exec(c1, db)) : R.Reply}
  %br(c1, db, kw) : {T.reply_of(T.exec(c1, T.db_of(T.exec(c2, R.db.t(db), R.db.now(db))), R.db.now(db))) == _ : R.Reply}
  reply_after(c1, c2, R.db.t(db), R.db.now(db))(e)

# DBSIZE, KEYS and SCAN see the whole database, and so only reads leave
# them alone, and a read leaves the database as it was
def reply_after_db(c1: R.Cmd, +c2: R.Cmd, +db: R.Db) -> {Laws.disturbs(c2, c1) == False{} : Bool} -> {R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db)))) == R.reply_of(R.exec(c1, db)) : R.Reply}:
  match c1:
    case R.Ping{}:
      e => reply_via(R.Ping{}, c2, db, {==}, e)
    case R.Echo{m}:
      e => reply_via(R.Echo{m}, c2, db, {==}, e)
    case R.Get{k}:
      e => reply_via(R.Get{k}, c2, db, {==}, e)
    case R.Set{k, v}:
      e => reply_via(R.Set{k, v}, c2, db, {==}, e)
    case R.Del{ks}:
      e => reply_via(R.Del{ks}, c2, db, {==}, e)
    case R.Exists{ks}:
      e => reply_via(R.Exists{ks}, c2, db, {==}, e)
    case R.IncrBy{k, by}:
      e => reply_via(R.IncrBy{k, by}, c2, db, {==}, e)
    case R.MGet{ks}:
      e => reply_via(R.MGet{ks}, c2, db, {==}, e)
    case R.MSet{ps}:
      e => reply_via(R.MSet{ps}, c2, db, {==}, e)
    case R.DbSize{}:
      e => %Equal.sym(R.Db, R.db_of(R.exec(c2, db)), db, Laws.reads_keep_db(c2, db, not_false(Laws.is_read(c2))(e))) : {R.reply_of(R.exec(R.DbSize{}, _)) == R.reply_of(R.exec(R.DbSize{}, db)) : R.Reply}
           {==}
    case R.FlushDb{}:
      e => reply_via(R.FlushDb{}, c2, db, {==}, e)
    case R.Keys{p}:
      e => %Equal.sym(R.Db, R.db_of(R.exec(c2, db)), db, Laws.reads_keep_db(c2, db, not_false(Laws.is_read(c2))(e))) : {R.reply_of(R.exec(R.Keys{p}, _)) == R.reply_of(R.exec(R.Keys{p}, db)) : R.Reply}
           {==}
    case R.Sort{k, o}:
      e => %Equal.sym(R.Db, R.db_of(R.exec(c2, db)), db, Laws.reads_keep_db(c2, db, not_false(Laws.is_read(c2))(e))) : {R.reply_of(R.exec(R.Sort{k, o}, _)) == R.reply_of(R.exec(R.Sort{k, o}, db)) : R.Reply}
           {==}
    case R.Scan{a}:
      e => %Equal.sym(R.Db, R.db_of(R.exec(c2, db)), db, Laws.reads_keep_db(c2, db, not_false(Laws.is_read(c2))(e))) : {R.reply_of(R.exec(R.Scan{a}, _)) == R.reply_of(R.exec(R.Scan{a}, db)) : R.Reply}
           {==}
    case R.Peek{k, o}:
      e => reply_via(R.Peek{k, o}, c2, db, {==}, e)
    case R.Upd{k, op}:
      e => reply_via(R.Upd{k, op}, c2, db, {==}, e)
    case R.MSetNx{ps}:
      e => reply_via(R.MSetNx{ps}, c2, db, {==}, e)
    case R.Rename{s, d, nx}:
      e => reply_via(R.Rename{s, d, nx}, c2, db, {==}, e)
    case R.BitOp{op, d, srcs}:
      e => reply_via(R.BitOp{op, d, srcs}, c2, db, {==}, e)
    case R.LMove{op, d, srcs}:
      e => reply_via(R.LMove{op, d, srcs}, c2, db, {==}, e)
    case R.LMPop{op, d, srcs}:
      e => reply_via(R.LMPop{op, d, srcs}, c2, db, {==}, e)
    case R.SOp{op, ks}:
      e => reply_via(R.SOp{op, ks}, c2, db, {==}, e)
    case R.SStore{op, d, srcs}:
      e => reply_via(R.SStore{op, d, srcs}, c2, db, {==}, e)
    case R.SMv{s, d, w}:
      e => reply_via(R.SMv{s, d, w}, c2, db, {==}, e)
    case R.ZOp{op, ks}:
      e => reply_via(R.ZOp{op, ks}, c2, db, {==}, e)
    case R.ZStore{op, d, srcs}:
      e => reply_via(R.ZStore{op, d, srcs}, c2, db, {==}, e)
    case R.ZRangeStore{d, s, q}:
      e => reply_via(R.ZRangeStore{d, s, q}, c2, db, {==}, e)
    case R.ZMPop{ks, max, c}:
      e => reply_via(R.ZMPop{ks, max, c}, c2, db, {==}, e)
    case R.Own{o}:
      e => reply_via(R.Own{o}, c2, db, {==}, e)
    case R.Bad{r}:
      e => reply_via(R.Bad{r}, c2, db, {==}, e)

def Laws.commute_reply(c1, c2, db, e):
  reply_after_db(c1, c2, db)(e)

def Laws.commute_reads(c1, c2, db, j, e, d):
  %bt(c2, R.db_of(R.exec(c1, db))) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, R.db.t(R.db_of(R.exec(c1, R.db_of(R.exec(c2, db))))), j) : Maybe<&2, KV.Item<KV.Val>>}
  %bt(c1, R.db_of(R.exec(c2, db))) : {KV.entry(KV.Val, T.db_of(T.exec(c2, R.db.t(R.db_of(R.exec(c1, db))), R.db.now(R.db_of(R.exec(c1, db))))), j) == KV.entry(KV.Val, _, j) : Maybe<&2, KV.Item<KV.Val>>}
  %bt(c1, db) : {KV.entry(KV.Val, T.db_of(T.exec(c2, _, R.db.now(R.db_of(R.exec(c1, db))))), j) == KV.entry(KV.Val, T.db_of(T.exec(c1, R.db.t(R.db_of(R.exec(c2, db))), R.db.now(R.db_of(R.exec(c2, db))))), j) : Maybe<&2, KV.Item<KV.Val>>}
  %bt(c2, db) : {KV.entry(KV.Val, T.db_of(T.exec(c2, T.db_of(T.exec(c1, R.db.t(db), R.db.now(db))), R.db.now(R.db_of(R.exec(c1, db))))), j) == KV.entry(KV.Val, T.db_of(T.exec(c1, _, R.db.now(R.db_of(R.exec(c2, db))))), j) : Maybe<&2, KV.Item<KV.Val>>}
  %eq_now(c1, db) : {KV.entry(KV.Val, T.db_of(T.exec(c2, T.db_of(T.exec(c1, R.db.t(db), R.db.now(db))), _)), j) == KV.entry(KV.Val, T.db_of(T.exec(c1, T.db_of(T.exec(c2, R.db.t(db), R.db.now(db))), R.db.now(R.db_of(R.exec(c2, db))))), j) : Maybe<&2, KV.Item<KV.Val>>}
  %eq_now(c2, db) : {KV.entry(KV.Val, T.db_of(T.exec(c2, T.db_of(T.exec(c1, R.db.t(db), R.db.now(db))), R.db.now(db))), j) == KV.entry(KV.Val, T.db_of(T.exec(c1, T.db_of(T.exec(c2, R.db.t(db), R.db.now(db))), _)), j) : Maybe<&2, KV.Item<KV.Val>>}
  t_commute_reads(c1, c2, R.db.t(db), j, R.db.now(db), e, d)

# so two commands that do not disturb each other answer the same in
# either order
def commute_go(+c1: R.Cmd, +c2: R.Cmd, +db: R.Db, +e: {Bool.or(Laws.disturbs(c1, c2), Laws.disturbs(c2, c1)) == False{} : Bool}) -> {Laws.replies(R.exec_all([c2, c1], db)) == List.reverse(&2, R.Reply, Laws.replies(R.exec_all([c1, c2], db))) : List<&2, R.Reply>}:
  %exec_all_run([c2, c1], db) : {Laws.replies(_) == List.reverse(&2, R.Reply, Laws.replies(R.exec_all([c1, c2], db))) : List<&2, R.Reply>}
  %exec_all_run([c1, c2], db) : {Laws.replies(run([c2, c1], db)) == List.reverse(&2, R.Reply, Laws.replies(_)) : List<&2, R.Reply>}
  %reply_after_db(c1, c2, db)(or_false_r(Laws.disturbs(c1, c2), Laws.disturbs(c2, c1))(e)) : {[R.reply_of(R.exec(c2, db)), R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db))))] == [R.reply_of(R.exec(c2, R.db_of(R.exec(c1, db)))), _] : List<&2, R.Reply>}
  %reply_after_db(c2, c1, db)(or_false_l(Laws.disturbs(c1, c2), Laws.disturbs(c2, c1))(e)) : {[_, R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db))))] == [R.reply_of(R.exec(c2, R.db_of(R.exec(c1, db)))), R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db))))] : List<&2, R.Reply>}
  {==}

def Laws.commute(c1, c2, db, e):
  commute_go(c1, c2, db, e)

# the rest of a batch answers alike after c1 then c2 and after c2 then
# c1, as the spec's does (rep_run)
def rest_same(+c1: R.Cmd, +c2: R.Cmd, +cs: List<&2, R.Cmd>, +db: R.Db, +nc: {Laws.clash(c2, c1) == False{} : Bool}, +kw: {Laws.keywise_all(cs) == True{} : Bool}) -> {rfst(run(cs, R.db_of(R.exec(c2, R.db_of(R.exec(c1, db)))))) == rfst(run(cs, R.db_of(R.exec(c1, R.db_of(R.exec(c2, db)))))) : List<&2, R.Reply>}:
  %run_r(cs, R.db_of(R.exec(c2, R.db_of(R.exec(c1, db)))))(kw) : {_ == rfst(run(cs, R.db_of(R.exec(c1, R.db_of(R.exec(c2, db)))))) : List<&2, R.Reply>}
  %run_r(cs, R.db_of(R.exec(c1, R.db_of(R.exec(c2, db)))))(kw) : {t_rfst(t_run(cs, R.db.t(R.db_of(R.exec(c2, R.db_of(R.exec(c1, db))))), R.db.now(R.db_of(R.exec(c2, R.db_of(R.exec(c1, db))))))) == _ : List<&2, R.Reply>}
  %bt(c2, R.db_of(R.exec(c1, db))) : {t_rfst(t_run(cs, _, R.db.now(R.db_of(R.exec(c2, R.db_of(R.exec(c1, db))))))) == t_rfst(t_run(cs, R.db.t(R.db_of(R.exec(c1, R.db_of(R.exec(c2, db))))), R.db.now(R.db_of(R.exec(c1, R.db_of(R.exec(c2, db))))))) : List<&2, R.Reply>}
  %bt(c1, db) : {t_rfst(t_run(cs, T.db_of(T.exec(c2, _, R.db.now(R.db_of(R.exec(c1, db))))), R.db.now(R.db_of(R.exec(c2, R.db_of(R.exec(c1, db))))))) == t_rfst(t_run(cs, R.db.t(R.db_of(R.exec(c1, R.db_of(R.exec(c2, db))))), R.db.now(R.db_of(R.exec(c1, R.db_of(R.exec(c2, db))))))) : List<&2, R.Reply>}
  %bt(c1, R.db_of(R.exec(c2, db))) : {t_rfst(t_run(cs, T.db_of(T.exec(c2, T.db_of(T.exec(c1, R.db.t(db), R.db.now(db))), R.db.now(R.db_of(R.exec(c1, db))))), R.db.now(R.db_of(R.exec(c2, R.db_of(R.exec(c1, db))))))) == t_rfst(t_run(cs, _, R.db.now(R.db_of(R.exec(c1, R.db_of(R.exec(c2, db))))))) : List<&2, R.Reply>}
  %bt(c2, db) : {t_rfst(t_run(cs, T.db_of(T.exec(c2, T.db_of(T.exec(c1, R.db.t(db), R.db.now(db))), R.db.now(R.db_of(R.exec(c1, db))))), R.db.now(R.db_of(R.exec(c2, R.db_of(R.exec(c1, db))))))) == t_rfst(t_run(cs, T.db_of(T.exec(c1, _, R.db.now(R.db_of(R.exec(c2, db))))), R.db.now(R.db_of(R.exec(c1, R.db_of(R.exec(c2, db))))))) : List<&2, R.Reply>}
  %eq_now(c2, R.db_of(R.exec(c1, db))) : {t_rfst(t_run(cs, T.db_of(T.exec(c2, T.db_of(T.exec(c1, R.db.t(db), R.db.now(db))), R.db.now(R.db_of(R.exec(c1, db))))), _)) == t_rfst(t_run(cs, T.db_of(T.exec(c1, T.db_of(T.exec(c2, R.db.t(db), R.db.now(db))), R.db.now(R.db_of(R.exec(c2, db))))), R.db.now(R.db_of(R.exec(c1, R.db_of(R.exec(c2, db))))))) : List<&2, R.Reply>}
  %eq_now(c1, db) : {t_rfst(t_run(cs, T.db_of(T.exec(c2, T.db_of(T.exec(c1, R.db.t(db), R.db.now(db))), _)), _)) == t_rfst(t_run(cs, T.db_of(T.exec(c1, T.db_of(T.exec(c2, R.db.t(db), R.db.now(db))), R.db.now(R.db_of(R.exec(c2, db))))), R.db.now(R.db_of(R.exec(c1, R.db_of(R.exec(c2, db))))))) : List<&2, R.Reply>}
  %eq_now(c1, R.db_of(R.exec(c2, db))) : {t_rfst(t_run(cs, T.db_of(T.exec(c2, T.db_of(T.exec(c1, R.db.t(db), R.db.now(db))), R.db.now(db))), R.db.now(db))) == t_rfst(t_run(cs, T.db_of(T.exec(c1, T.db_of(T.exec(c2, R.db.t(db), R.db.now(db))), R.db.now(R.db_of(R.exec(c2, db))))), _)) : List<&2, R.Reply>}
  %eq_now(c2, db) : {t_rfst(t_run(cs, T.db_of(T.exec(c2, T.db_of(T.exec(c1, R.db.t(db), R.db.now(db))), R.db.now(db))), R.db.now(db))) == t_rfst(t_run(cs, T.db_of(T.exec(c1, T.db_of(T.exec(c2, R.db.t(db), R.db.now(db))), _)), _)) : List<&2, R.Reply>}
  rep_run(c1, c2, R.db.t(db), R.db.now(db), nc, cs, Nil{})(kw)

def swap_go(+c1: R.Cmd, +c2: R.Cmd, +cs: List<&2, R.Cmd>, +db: R.Db, +e1: {Laws.interferes(c1, c2) == False{} : Bool}, +e2: {Laws.keywise_all(cs) == True{} : Bool}) -> {Laws.replies(R.exec_all(Con{c2, Con{c1, cs}}, db)) == Laws.swap2(Laws.replies(R.exec_all(Con{c1, Con{c2, cs}}, db))) : List<&2, R.Reply>}:
  +nd = or_false_l(Bool.or(Laws.disturbs(c1, c2), Laws.disturbs(c2, c1)), Laws.clash(c2, c1))(e1)
  +nc = or_false_r(Bool.or(Laws.disturbs(c1, c2), Laws.disturbs(c2, c1)), Laws.clash(c2, c1))(e1)
  %exec_all_run(Con{c2, Con{c1, cs}}, db) : {Laws.replies(_) == Laws.swap2(Laws.replies(R.exec_all(Con{c1, Con{c2, cs}}, db))) : List<&2, R.Reply>}
  %exec_all_run(Con{c1, Con{c2, cs}}, db) : {Laws.replies(run(Con{c2, Con{c1, cs}}, db)) == Laws.swap2(Laws.replies(_)) : List<&2, R.Reply>}
  %eta_l(run(cs, R.db_of(R.exec(c1, R.db_of(R.exec(c2, db)))))) : {Laws.replies(R.exec_all.cons(R.reply_of(R.exec(c2, db)), R.exec_all.cons(R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db)))), _))) == Laws.swap2(Laws.replies(run(Con{c1, Con{c2, cs}}, db))) : List<&2, R.Reply>}
  %eta_l(run(cs, R.db_of(R.exec(c2, R.db_of(R.exec(c1, db)))))) : {R.reply_of(R.exec(c2, db)) <> R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db)))) <> rfst(run(cs, R.db_of(R.exec(c1, R.db_of(R.exec(c2, db)))))) == Laws.swap2(Laws.replies(R.exec_all.cons(R.reply_of(R.exec(c1, db)), R.exec_all.cons(R.reply_of(R.exec(c2, R.db_of(R.exec(c1, db)))), _)))) : List<&2, R.Reply>}
  %reply_after_db(c1, c2, db)(or_false_r(Laws.disturbs(c1, c2), Laws.disturbs(c2, c1))(nd)) : {R.reply_of(R.exec(c2, db)) <> R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db)))) <> rfst(run(cs, R.db_of(R.exec(c1, R.db_of(R.exec(c2, db)))))) == R.reply_of(R.exec(c2, R.db_of(R.exec(c1, db)))) <> _ <> rfst(run(cs, R.db_of(R.exec(c2, R.db_of(R.exec(c1, db)))))) : List<&2, R.Reply>}
  %reply_after_db(c2, c1, db)(or_false_l(Laws.disturbs(c1, c2), Laws.disturbs(c2, c1))(nd)) : {_ <> R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db)))) <> rfst(run(cs, R.db_of(R.exec(c1, R.db_of(R.exec(c2, db)))))) == R.reply_of(R.exec(c2, R.db_of(R.exec(c1, db)))) <> R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db)))) <> rfst(run(cs, R.db_of(R.exec(c2, R.db_of(R.exec(c1, db)))))) : List<&2, R.Reply>}
  %rest_same(c1, c2, cs, db, nc, e2) : {R.reply_of(R.exec(c2, R.db_of(R.exec(c1, db)))) <> R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db)))) <> _ == R.reply_of(R.exec(c2, R.db_of(R.exec(c1, db)))) <> R.reply_of(R.exec(c1, R.db_of(R.exec(c2, db)))) <> rfst(run(cs, R.db_of(R.exec(c2, R.db_of(R.exec(c1, db)))))) : List<&2, R.Reply>}
  {==}

def Laws.swap_replies(c1, c2, cs, db, e1, e2):
  swap_go(c1, c2, cs, db, e1, e2)

def Laws.swap_reads(c1, c2, cs, db, j, e):
  %fin_t(Con{c2, Con{c1, cs}}, db) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, R.db.t(Laws.final(R.exec_all(Con{c1, Con{c2, cs}}, db))), j) : Maybe<&2, KV.Item<KV.Val>>}
  %fin_t(Con{c1, Con{c2, cs}}, db) : {KV.entry(KV.Val, T.final(T.exec_all(Con{c2, Con{c1, cs}}, R.db.t(db), R.db.now(db))), j) == KV.entry(KV.Val, _, j) : Maybe<&2, KV.Item<KV.Val>>}
  t_swap_reads(c1, c2, cs, R.db.t(db), j, R.db.now(db), e)

# Persistence
# ===========
# The file loads as written (Laws.aof_load): a number line reads back as
# the number Nat.show wrote (num_show), a bulk as its bytes (bulk_rt), an
# entry as its strings (entry_rt), and the loader has fuel for every
# entry (load_fuel). exec_log runs as run does, its effects being each
# command's in turn (log_parts). A command's effects, run at time 0 on
# the database the command ran on, leave the database it left, at time 0
# (effect_db), and parse back to themselves (eff_args): a time they name
# is one a key keeps, which reads back as written (num14_show). The file
# after a history holds the entries of all its effects (aof_all); they
# parse back to them, and run from an empty database they leave the
# history's database, at time 0 (replay_all).

# Gluing
# ------

def app_assoc(a: String, -b: String, -c: String) -> {(a ++ b) ++ c == a ++ (b ++ c) : String}:
  match a:
    case SNil{}:
      {==}
    case SCon{h, t}:
      Equal.cong(String, String, x => SCon{h, x}, (t ++ b) ++ c, t ++ (b ++ c), app_assoc(t, b, c))

# a ++ x glued in front of out is a in front of x glued in front of out
def glue_in(a: String, -x: String, -y: String, -out: String, e: {x ++ out == y : String}) -> {(a ++ x) ++ out == a ++ y : String}:
  %e : {(a ++ x) ++ out == a ++ _ : String}
  app_assoc(a, x, out)

def bulk_glue(+s: String, -y: String, -out: String) -> {P.bulk_into(s, y) ++ out == P.bulk_into(s, y ++ out) : String}:
  glue_in("$", Nat.show(String.length(s)) ++ (P.crlf() ++ (s ++ (P.crlf() ++ y))), Nat.show(String.length(s)) ++ (P.crlf() ++ (s ++ (P.crlf() ++ (y ++ out)))), out,
    glue_in(Nat.show(String.length(s)), P.crlf() ++ (s ++ (P.crlf() ++ y)), P.crlf() ++ (s ++ (P.crlf() ++ (y ++ out))), out,
      glue_in(P.crlf(), s ++ (P.crlf() ++ y), s ++ (P.crlf() ++ (y ++ out)), out,
        glue_in(s, P.crlf() ++ y, P.crlf() ++ (y ++ out), out, app_assoc(P.crlf(), y, out)))))

# Numbers
# -------
# Nat.show writes n's last digit, then the digits of n's tens before it,
# with n itself as its fuel. quot10 and rem10 are n's tens and last digit,
# found by steps of ten; they are what divmod by 10 gives (divmod_10).

type Dig is Data:
  D0{}
  D1{}
  D2{}
  D3{}
  D4{}
  D5{}
  D6{}
  D7{}
  D8{}
  D9{}

def dval(d: Dig) -> Nat:
  match d:
    case D0{}:
      0n
    case D1{}:
      1n
    case D2{}:
      2n
    case D3{}:
      3n
    case D4{}:
      4n
    case D5{}:
      5n
    case D6{}:
      6n
    case D7{}:
      7n
    case D8{}:
      8n
    case D9{}:
      9n

def quot10(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n:
      0n
    case 2n:
      0n
    case 3n:
      0n
    case 4n:
      0n
    case 5n:
      0n
    case 6n:
      0n
    case 7n:
      0n
    case 8n:
      0n
    case 9n:
      0n
    case 10n+m:
      1n+quot10(m)

def rem10(n: Nat) -> Dig:
  match n:
    case 0n:
      D0{}
    case 1n:
      D1{}
    case 2n:
      D2{}
    case 3n:
      D3{}
    case 4n:
      D4{}
    case 5n:
      D5{}
    case 6n:
      D6{}
    case 7n:
      D7{}
    case 8n:
      D8{}
    case 9n:
      D9{}
    case 10n+m:
      rem10(m)

def add_succ_r(a: Nat, -b: Nat) -> {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, x => 1n+x, Nat.add(p, 1n+b), 1n+Nat.add(p, b), add_succ_r(p, b))

def divmod_go(n: Nat, -d: Nat) -> {(Nat.add(quot10(n), d), dval(rem10(n))) == Nat.divmod.go(n, 9n, d, 0n) : Nat & Nat}:
  match n:
    case 0n:
      {==}
    case 1n:
      {==}
    case 2n:
      {==}
    case 3n:
      {==}
    case 4n:
      {==}
    case 5n:
      {==}
    case 6n:
      {==}
    case 7n:
      {==}
    case 8n:
      {==}
    case 9n:
      {==}
    case 10n++m:
      %add_succ_r(quot10(m), d) : {(_, dval(rem10(m))) == Nat.divmod.go(m, 9n, 1n+d, 0n) : Nat & Nat}
      divmod_go(m, 1n+d)

def divmod_10(+n: Nat) -> {(quot10(n), dval(rem10(n))) == Nat.divmod(n, 10n) : Nat & Nat}:
  %Equal.sym(Nat, quot10(n), Nat.add(quot10(n), 0n), add_zero(quot10(n))) : {(_, dval(rem10(n))) == Nat.divmod(n, 10n) : Nat & Nat}
  divmod_go(n, 0n)

def quot_spec(n: Nat) -> {n == Nat.add(Nat.mul(quot10(n), 10n), dval(rem10(n))) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n:
      {==}
    case 2n:
      {==}
    case 3n:
      {==}
    case 4n:
      {==}
    case 5n:
      {==}
    case 6n:
      {==}
    case 7n:
      {==}
    case 8n:
      {==}
    case 9n:
      {==}
    case 10n+m:
      Equal.cong(Nat, Nat, x => 10n+x, m, Nat.add(Nat.mul(quot10(m), 10n), dval(rem10(m))), quot_spec(m))

def le_self(n: Nat) -> {le(n, 1n+n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      le_self(p)

def le_drop(k: Nat, +a: Nat, b: Nat) -> {le(Nat.add(k, a), b) == True{} : Bool} -> {le(a, b) == True{} : Bool}:
  match k b:
    case 0n _:
      e => e
    case 1n+j 0n:
      e => Empty.absurd({le(a, 0n) == True{} : Bool}, false_true(e))
    case 1n+j 1n++c:
      e => le_succ(a, c)(le_drop(j, a, c)(e))

# the fuel of Nat.show lasts: a number below 1 + g has its tens below g
def le_quot(n: Nat, g: Nat) -> {le(n, 1n+g) == True{} : Bool} -> {le(quot10(n), g) == True{} : Bool}:
  match n g:
    case 0n _:
      e => {==}
    case 1n _:
      e => {==}
    case 2n _:
      e => {==}
    case 3n _:
      e => {==}
    case 4n _:
      e => {==}
    case 5n _:
      e => {==}
    case 6n _:
      e => {==}
    case 7n _:
      e => {==}
    case 8n _:
      e => {==}
    case 9n _:
      e => {==}
    case 10n+m 0n:
      e => Empty.absurd({le(quot10(10n+m), 0n) == True{} : Bool}, false_true(e))
    case 10n++m 1n++h:
      e => le_quot(m, h)(le_succ(m, h)(le_drop(8n, m, h)(e)))

# the char Nat.show writes for a digit reads back as that digit
def ch_dig(r: Dig, -t: String) -> {A.CDigit{dval(r)} == A.ch(SCon{Chr{U32.from_nat(Nat.add(48n, dval(r)))}, t}) : A.Ch}:
  match r:
    case D0{}:
      {==}
    case D1{}:
      {==}
    case D2{}:
      {==}
    case D3{}:
      {==}
    case D4{}:
      {==}
    case D5{}:
      {==}
    case D6{}:
      {==}
    case D7{}:
      {==}
    case D8{}:
      {==}
    case D9{}:
      {==}

# the digits Nat.show.go writes in front of acc, read as a number from 0,
# are acc read on from n
def num_fin(-g: Nat, q: Nat, -n: Nat, +r: Dig, +acc: String, ih: @m: Nat -> @t: String -> {le(m, g) == True{} : Bool} -> {A.num(t, m, A.ch(t)) == A.num(Nat.show.go(g, m, t), 0n, A.ch(Nat.show.go(g, m, t))) : Maybe<&1, Nat & String>})
  -> {n == Nat.add(Nat.mul(q, 10n), dval(r)) : Nat}
  -> {le(q, g) == True{} : Bool}
  -> {A.num(acc, n, A.ch(acc)) == A.num(Nat.show.fin(g, acc, (Chr{U32.from_nat(Nat.add(48n, dval(r)))}, q)), 0n, A.ch(Nat.show.fin(g, acc, (Chr{U32.from_nat(Nat.add(48n, dval(r)))}, q)))) : Maybe<&1, Nat & String>}:
  match q:
    case 0n:
      sp => lq =>
        %ch_dig(r, acc) : {A.num(acc, n, A.ch(acc)) == A.num(SCon{Chr{U32.from_nat(Nat.add(48n, dval(r)))}, acc}, 0n, _) : Maybe<&1, Nat & String>}
        %sp : {A.num(acc, n, A.ch(acc)) == A.num(acc, _, A.ch(acc)) : Maybe<&1, Nat & String>}
        {==}
    case 1n+p:
      sp => lq =>
        %ih(1n+p, SCon{Chr{U32.from_nat(Nat.add(48n, dval(r)))}, acc})(lq) : {A.num(acc, n, A.ch(acc)) == _ : Maybe<&1, Nat & String>}
        %ch_dig(r, acc) : {A.num(acc, n, A.ch(acc)) == A.num(SCon{Chr{U32.from_nat(Nat.add(48n, dval(r)))}, acc}, 1n+p, _) : Maybe<&1, Nat & String>}
        %sp : {A.num(acc, n, A.ch(acc)) == A.num(acc, _, A.ch(acc)) : Maybe<&1, Nat & String>}
        {==}

def num_go(f: Nat, +n: Nat, acc: String) -> {le(n, f) == True{} : Bool} -> {A.num(acc, n, A.ch(acc)) == A.num(Nat.show.go(f, n, acc), 0n, A.ch(Nat.show.go(f, n, acc))) : Maybe<&1, Nat & String>}:
  match f:
    case 0n:
      match n:
        case 0n:
          e => {==}
        case 1n+p:
          e => Empty.absurd({A.num(acc, 1n+p, A.ch(acc)) == A.num(acc, 0n, A.ch(acc)) : Maybe<&1, Nat & String>}, false_true(e))
    case 1n++g:
      e =>
        %divmod_10(n) : {A.num(acc, n, A.ch(acc)) == A.num(Nat.show.fin(g, acc, Nat.show.put(_)), 0n, A.ch(Nat.show.fin(g, acc, Nat.show.put(_)))) : Maybe<&1, Nat & String>}
        num_fin(g, quot10(n), n, rem10(n), acc, m => t => num_go(g, m, t))(quot_spec(n))(le_quot(n, g)(e))

# Nat.show.go writes in front of what follows its acc
def show_fin_app(-g: Nat, acc: String, -t: String, p: Char & Nat, ih: @m: Nat -> @a: String -> {Nat.show.go(g, m, a ++ t) == Nat.show.go(g, m, a) ++ t : String}) -> {Nat.show.fin(g, acc ++ t, p) == Nat.show.fin(g, acc, p) ++ t : String}:
  (c, q) = p
  match q:
    case 0n:
      {==}
    case 1n+r:
      ih(1n+r, SCon{c, acc})

def show_app(f: Nat, n: Nat, acc: String, -t: String) -> {Nat.show.go(f, n, acc ++ t) == Nat.show.go(f, n, acc) ++ t : String}:
  match f:
    case 0n:
      {==}
    case 1n++g:
      show_fin_app(g, acc, t, Nat.show.put(Nat.divmod(n, 10n)), m => a => show_app(g, m, a, t))

# a number line reads back as the number Nat.show wrote
def num_show(+n: Nat, rest: String) -> {Some{(n, rest)} == A.num(Nat.show(n) ++ (P.crlf() ++ rest), 0n, A.ch(Nat.show(n) ++ (P.crlf() ++ rest))) : Maybe<&1, Nat & String>}:
  %show_app(1n+n, n, SNil{}, P.crlf() ++ rest) : {Some{(n, rest)} == A.num(_, 0n, A.ch(_)) : Maybe<&1, Nat & String>}
  num_go(1n+n, n, P.crlf() ++ rest)(le_self(n))

# Entries
# -------

def take_app(s: String, t: String) -> {s == String.take(s ++ t, String.length(s)) : String}:
  match s:
    case SNil{}:
      match t:
        case SNil{}:
          {==}
        case SCon{h, r}:
          {==}
    case SCon{h, r}:
      Equal.cong(String, String, x => SCon{h, x}, r, String.take(r ++ t, String.length(r)), take_app(r, t))

def drop_app(s: String, t: String) -> {t == String.drop(s ++ t, String.length(s)) : String}:
  match s:
    case SNil{}:
      match t:
        case SNil{}:
          {==}
        case SCon{h, r}:
          {==}
    case SCon{h, r}:
      drop_app(r, t)

# a bulk reads back as its bytes
def bulk_rt(+s: String, +rest: String) -> {Some{(s, rest)} == A.bulk(P.bulk_into(s, rest)) : Maybe<&1, String & String>}:
  %num_show(String.length(s), s ++ (P.crlf() ++ rest)) : {Some{(s, rest)} == A.bulk.body(_) : Maybe<&1, String & String>}
  %take_app(s, P.crlf() ++ rest) : {Some{(s, rest)} == A.bulk.end(_, String.drop(s ++ (P.crlf() ++ rest), String.length(s))) : Maybe<&1, String & String>}
  %drop_app(s, P.crlf() ++ rest) : {Some{(s, rest)} == A.bulk.end(s, _) : Maybe<&1, String & String>}
  {==}

# the bulks after the one just read (x) read back as the strings written
def bulks_rt(ys: List<&2, String>, -x: String, +rest: String, -acc: List<&2, String>) -> {Some{(List.reverse.go(&2, String, acc, x <> ys), rest)} == A.bulks(List.length(&2, String, ys), Some{(x, A.bulks.onto(ys, rest))}, acc) : Maybe<&1, List<&2, String> & String>}:
  match ys:
    case Nil{}:
      {==}
    case Con{+y, +zs}:
      %bulk_rt(y, A.bulks.onto(zs, rest)) : {Some{(List.reverse.go(&2, String, acc, x <> y <> zs), rest)} == A.bulks(List.length(&2, String, zs), _, x <> acc) : Maybe<&1, List<&2, String> & String>}
      bulks_rt(zs, y, rest, x <> acc)

# an entry reads back as its strings
def entry_rt(xs: List<&2, String>, +rest: String) -> {Some{(xs, rest)} == A.entry(A.entry.onto(xs, rest)) : Maybe<&1, List<&2, String> & String>}:
  match xs:
    case Nil{}:
      %num_show(0n, rest) : {Some{(Nil{}, rest)} == A.entry.head(_) : Maybe<&1, List<&2, String> & String>}
      {==}
    case Con{+x, +ys}:
      %num_show(1n+List.length(&2, String, ys), A.bulks.onto(Con{x, ys}, rest)) : {Some{(Con{x, ys}, rest)} == A.entry.head(_) : Maybe<&1, List<&2, String> & String>}
      %bulk_rt(x, A.bulks.onto(ys, rest)) : {Some{(Con{x, ys}, rest)} == A.bulks(List.length(&2, String, ys), _, Nil{}) : Maybe<&1, List<&2, String> & String>}
      bulks_rt(ys, x, rest, Nil{})

# Loading
# -------

# the entries of a file, with fuel for each, read back as written, up to
# what follows them (rest, where no entry starts)
def load_go(reqs: List<&2, List<&2, String>>, f: Nat, +rest: String, -acc: List<&2, List<&2, String>>, en: {None{} == A.entry(rest) : Maybe<&1, List<&2, String> & String>})
  -> {le(List.length(&2, List<&2, String>, reqs), f) == True{} : Bool}
  -> {(List.reverse.go(&2, List<&2, String>, acc, reqs), rest) == A.load.go(f, A.encode.onto(reqs, rest), A.entry(A.encode.onto(reqs, rest)), acc) : List<&2, List<&2, String>> & String}:
  match reqs f:
    case Nil{} 0n:
      e =>
        %en : {(List.reverse.go(&2, List<&2, String>, acc, Nil{}), rest) == A.load.go(0n, rest, _, acc) : List<&2, List<&2, String>> & String}
        {==}
    case Nil{} 1n+g:
      e =>
        %en : {(List.reverse.go(&2, List<&2, String>, acc, Nil{}), rest) == A.load.go(1n+g, rest, _, acc) : List<&2, List<&2, String>> & String}
        {==}
    case Con{+r, +more} 0n:
      e => Empty.absurd({(List.reverse.go(&2, List<&2, String>, acc, Con{r, more}), rest) == A.load.go(0n, A.encode.onto(Con{r, more}, rest), A.entry(A.encode.onto(Con{r, more}, rest)), acc) : List<&2, List<&2, String>> & String}, false_true(e))
    case Con{+r, more} 1n+g:
      e =>
        %entry_rt(r, A.encode.onto(more, rest)) : {(List.reverse.go(&2, List<&2, String>, acc, Con{r, more}), rest) == A.load.go(1n+g, A.entry.onto(r, A.encode.onto(more, rest)), _, acc) : List<&2, List<&2, String>> & String}
        load_go(more, g, rest, r <> acc, en)(e)

# a file has a byte for each entry, at least: enough fuel for load
def le_app(+a: Nat, p: String, +t: String) -> {le(a, String.length(t)) == True{} : Bool} -> {le(a, String.length(p ++ t)) == True{} : Bool}:
  match p:
    case SNil{}:
      e => e
    case SCon{h, +q}:
      e => le_succ(a, String.length(q ++ t))(le_app(a, q, t)(e))

def le_bulks(+a: Nat, xs: List<&2, String>, +t: String) -> {le(a, String.length(t)) == True{} : Bool} -> {le(a, String.length(A.bulks.onto(xs, t))) == True{} : Bool}:
  match xs:
    case Nil{}:
      e => e
    case Con{+x, +ys}:
      e => le_succ(a, String.length(Nat.show(String.length(x)) ++ (P.crlf() ++ (x ++ (P.crlf() ++ A.bulks.onto(ys, t))))))(
        le_app(a, Nat.show(String.length(x)), P.crlf() ++ (x ++ (P.crlf() ++ A.bulks.onto(ys, t))))(
          le_app(a, P.crlf(), x ++ (P.crlf() ++ A.bulks.onto(ys, t)))(
            le_app(a, x, P.crlf() ++ A.bulks.onto(ys, t))(
              le_app(a, P.crlf(), A.bulks.onto(ys, t))(
                le_bulks(a, ys, t)(e))))))

def load_fuel(reqs: List<&2, List<&2, String>>, +rest: String) -> {le(List.length(&2, List<&2, String>, reqs), String.length(A.encode.onto(reqs, rest))) == True{} : Bool}:
  match reqs:
    case Nil{}:
      {==}
    case Con{+r, +more}:
      le_app(List.length(&2, List<&2, String>, more), Nat.show(List.length(&2, String, r)), P.crlf() ++ A.bulks.onto(r, A.encode.onto(more, rest)))(
        le_app(List.length(&2, List<&2, String>, more), P.crlf(), A.bulks.onto(r, A.encode.onto(more, rest)))(
          le_bulks(List.length(&2, List<&2, String>, more), r, A.encode.onto(more, rest))(load_fuel(more, rest))))

def Laws.aof_load(reqs):
  Equal.sym(List<&2, List<&2, String>> & String, (reqs, ""), A.load(A.encode(reqs)), load_go(reqs, String.length(A.encode(reqs)), "", Nil{}, {==})(load_fuel(reqs, "")))

# Logging
# -------
# A command run with its effects (A.run) answers and leaves the database
# as R.exec does, with its effects (eff): an update's are its change's,
# INCRBY's those of the update UIncr, which R.db.incr runs the same way
# (incr_upd_eq); any other command's come from the command alone.

# an update's effects, run on db
def upd_eff(+db: R.Db, +k: String, op: R.UpdOp) -> List<&2, R.Cmd>:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      A.upd.effect(k, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))))

# LMPOP's effects: the update of the key it picks
def lmpop_eff(m: Maybe<&2, String>, +left: Bool, cnt: String, +db: R.Db) -> List<&2, R.Cmd>:
  match m:
    case Some{+k}:
      upd_eff(db, k, R.UList{R.LWPopN{left, cnt}})
    case None{}:
      Nil{}

# a STORE's effects: the DEL of its destination, or its update SWNew
def sstore_eff_of(xs: List<&2, String>, +d: String, +db: R.Db) -> List<&2, R.Cmd>:
  match xs:
    case Nil{}:
      A.effect(R.Del{[d]})
    case Con{+x, +rest}:
      upd_eff(db, d, R.UMems{R.SWNew{x <> rest}})

def sstore_eff(g: R.SGot, op: R.SetK, ks: List<&2, String>, +d: String, +db: R.Db) -> List<&2, R.Cmd>:
  match g:
    case R.SGot{ss}:
      sstore_eff_of(R.sop.members(op, ks, ss), d, db)
    case R.SGotWrong{}:
      Nil{}

# a STORE's effects, of a sorted-set operation or of a range: the DEL of
# its destination, or its update ZWNew; ZMPOP's: the update of the key it
# picks
def zstore_eff_of(xs: List<&2, KV.ZEl>, +d: String, +db: R.Db) -> List<&2, R.Cmd>:
  match xs:
    case Nil{}:
      A.effect(R.Del{[d]})
    case Con{+x, +rest}:
      upd_eff(db, d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(x <> rest)}})

def zstore_eff_ok(bad: Maybe<&2, R.Reply>, op: R.ZSetK, ss: List<&2, R.ZSrc>, +d: String, +db: R.Db) -> List<&2, R.Cmd>:
  match bad:
    case Some{r}:
      Nil{}
    case None{}:
      zstore_eff_of(R.zop.els(op, ss), d, db)

def zstore_eff(g: R.ZGot, +op: R.ZSetK, +d: String, +db: R.Db) -> List<&2, R.Cmd>:
  match g:
    case R.ZGot{ss}:
      zstore_eff_ok(R.zop.bad(op), op, ss, d, db)
    case R.ZGotWrong{}:
      Nil{}

def zrs_eff(m: Maybe<&2, KV.Val>, q: R.ZQ, +d: String, +db: R.Db) -> List<&2, R.Cmd>:
  match m:
    case None{}:
      zstore_eff_of(Nil{}, d, db)
    case Some{KV.VColl{KV.CZset{+z}}}:
      zstore_eff_of(R.zq.run(q, z), d, db)
    case Some{v}:
      Nil{}

def zmpop_eff(m: Maybe<&2, String>, +max: Bool, c: String, +db: R.Db) -> List<&2, R.Cmd>:
  match m:
    case Some{+k}:
      upd_eff(db, k, R.UZset{R.ZWPopN{max, c}})
    case None{}:
      Nil{}

# a command's effects, run on db
def eff(c: R.Cmd, +db: R.Db) -> List<&2, R.Cmd>:
  match c:
    case R.Ping{}:
      A.effect(R.Ping{})
    case R.Echo{m}:
      A.effect(R.Echo{m})
    case R.Get{k}:
      A.effect(R.Get{k})
    case R.Set{k, v}:
      A.effect(R.Set{k, v})
    case R.Del{ks}:
      A.effect(R.Del{ks})
    case R.Exists{ks}:
      A.effect(R.Exists{ks})
    case R.IncrBy{+k, by}:
      upd_eff(db, k, R.UIncr{by})
    case R.MGet{ks}:
      A.effect(R.MGet{ks})
    case R.MSet{ps}:
      A.effect(R.MSet{ps})
    case R.DbSize{}:
      A.effect(R.DbSize{})
    case R.FlushDb{}:
      A.effect(R.FlushDb{})
    case R.Keys{p}:
      A.effect(R.Keys{p})
    case R.Sort{k, o}:
      A.effect(R.Sort{k, o})
    case R.Scan{a}:
      A.effect(R.Scan{a})
    case R.Peek{k, o}:
      A.effect(R.Peek{k, o})
    case R.Upd{+k, op}:
      upd_eff(db, k, op)
    case R.MSetNx{+ps}:
      A.msetnx.effect(R.pairs.live(ps, R.db.now(db), R.db.trie(db)), ps)
    case R.Rename{+s, +d, +nx}:
      A.ren.effect(R.ren.find(db, s, d, nx), s, d)
    case R.BitOp{+op, +d, +srcs}:
      A.bitop.eff(R.bitop.wrong(srcs, R.db.now(db), R.db.trie(db)), op, d, srcs, db)
    case R.LMove{+s, +d, +w}:
      A.lmove.effect(A.lmove.moved(R.mv.find(db, s, d, w)), R.ent.dead(R.db.now(db), R.db.entry(db, d)), s, d, w)
    case R.LMPop{+ks, +left, +cnt}:
      lmpop_eff(R.lmpop.first(ks, R.lmpop.head(ks, db), db), left, cnt, db)
    case R.SOp{op, ks}:
      A.effect(R.SOp{op, ks})
    case R.SStore{+op, +d, +srcs}:
      sstore_eff(R.sets.at(srcs, R.db.now(db), R.db.trie(db)), op, srcs, d, db)
    case R.SMv{+s, +d, +w}:
      A.smove.effect(A.smove.moved(R.smv.of(db, s, d, w)), R.ent.dead(R.db.now(db), R.db.entry(db, d)), s, d, w)
    case R.ZOp{op, ks}:
      A.effect(R.ZOp{op, ks})
    case R.ZStore{+op, +d, +srcs}:
      zstore_eff(R.zsrcs.at(srcs, R.db.now(db), R.db.trie(db)), op, d, db)
    case R.ZRangeStore{+d, +s, q}:
      zrs_eff(R.db.read(db, s), q, d, db)
    case R.ZMPop{+ks, +max, c}:
      zmpop_eff(R.lmpop.first(ks, R.lmpop.head(ks, db), db), max, c, db)
    case R.Own{o}:
      A.effect(R.Own{o})
    case R.Bad{r}:
      A.effect(R.Bad{r})

# INCRBY runs as the update UIncr: its value read and its reply, the
# entry it leaves and the counts (code_m: a key's code is its entry's)
def ent_code_item(m: Maybe<&2, KV.Item<KV.Val>>) -> {R.ent.code(m) == Laws.item_code(KV.Val, m) : Nat}:
  match m:
    case Some{KV.Item{v, e}}:
      {==}
    case None{}:
      {==}

def code_m(+t: KV.Trie<KV.Val>, +k: String, -m: Maybe<&2, KV.Item<KV.Val>>, eq: {KV.entry(KV.Val, t, k) == m : Maybe<&2, KV.Item<KV.Val>>}) -> {R.ent.code(m) == KV.code.at(KV.Val, t, k, KV.hash(k)) : Nat}:
  %eq : {R.ent.code(_) == KV.code.at(KV.Val, t, k, KV.hash(k)) : Nat}
  Equal.trans(Nat, R.ent.code(KV.entry(KV.Val, t, k)), Laws.item_code(KV.Val, KV.entry(KV.Val, t, k)), KV.code.at(KV.Val, t, k, KV.hash(k)), ent_code_item(KV.entry(KV.Val, t, k)), code_eq(KV.Val, t, k))

def incr_none(s: R.LL, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +c: Nat) -> {R.incr.fit(t, k, KV.hash(k), s, False{}, R.cnt.n(c, n), n, R.cnt.x(c, 0n, x), x, now, rr) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, c, R.uincr.fit(s, False{})) : R.Reply & R.Db}:
  match s:
    case R.LL{+neg, +hi, +lo}:
      {==}
    case R.LLBad{}:
      {==}

def incr_some(s: R.LL, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +e: Nat) -> {R.incr.fit(t, k, KV.hash(k), s, True{}, n, n, x, x, now, rr) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, 1n+e, R.uincr.fit(s, True{})) : R.Reply & R.Db}:
  match s:
    case R.LL{+neg, +hi, +lo}:
      {==}
    case R.LLBad{}:
      {==}

def incr_cur(cur: R.LL, +t: KV.Trie<KV.Val>, +k: String, +by: R.By, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +e: Nat) -> {R.incr.num(t, k, KV.hash(k), by, n, x, now, rr, cur) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, 1n+e, R.uincr.num(by, cur)) : R.Reply & R.Db}:
  match cur:
    case R.LL{+neg, +hi, +lo}:
      incr_some(R.ll.add(neg, hi, lo, by), t, k, n, x, now, rr, e)
    case R.LLBad{}:
      {==}

# INCRBY of a key there: a string's value read, a collection WRONGTYPE
def incr_w(w: KV.Val, +t: KV.Trie<KV.Val>, +k: String, +by: R.By, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +e: Nat) -> {R.incr.got(t, k, KV.hash(k), by, n, x, now, rr, KV.got_of(Some{w})) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, 1n+e, R.upd.v(R.UIncr{by}, now, Some{KV.Item{w, e}})) : R.Reply & R.Db}:
  match w:
    case KV.VStr{+v}:
      incr_cur(R.ll.read(v), t, k, by, n, x, now, rr, e)
    case KV.VColl{c}:
      {==}

def incr_b(b: Bool, +t: KV.Trie<KV.Val>, +k: String, +by: R.By, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +w: KV.Val, +e: Nat, +eq: {KV.entry(KV.Val, t, k) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>}) -> {R.incr.got(t, k, KV.hash(k), by, n, x, now, rr, KV.got_of(item_val(Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{w, e}}, None{})))) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, 1n+e, R.upd.v(R.UIncr{by}, now, Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{w, e}}, None{}))) : R.Reply & R.Db}:
  match b:
    case True{}:
      incr_w(w, t, k, by, n, x, now, rr, e)
    case False{}:
      %code_m(t, k, Some{KV.Item{w, e}}, eq) : {R.incr.fit(t, k, KV.hash(k), R.by.ll(by), False{}, R.cnt.n(_, n), n, R.cnt.x(_, 0n, x), x, now, rr) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, 1n+e, R.uincr.fit(R.by.ll(by), False{})) : R.Reply & R.Db}
      incr_none(R.by.ll(by), t, k, n, x, now, rr, 1n+e)

def incr_m(m: Maybe<&2, KV.Item<KV.Val>>, +t: KV.Trie<KV.Val>, +k: String, +by: R.By, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {KV.entry(KV.Val, t, k) == m : Maybe<&2, KV.Item<KV.Val>>} -> {R.incr.got(t, k, KV.hash(k), by, n, x, now, rr, KV.got_of(item_val(R.ent.live(now, m)))) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), R.upd.v(R.UIncr{by}, now, R.ent.live(now, m))) : R.Reply & R.Db}:
  match m:
    case None{}:
      eq => %code_m(t, k, None{}, eq) : {R.incr.fit(t, k, KV.hash(k), R.by.ll(by), False{}, R.cnt.n(_, n), n, R.cnt.x(_, 0n, x), x, now, rr) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, 0n, R.uincr.fit(R.by.ll(by), False{})) : R.Reply & R.Db}
            incr_none(R.by.ll(by), t, k, n, x, now, rr, 0n)
    case Some{KV.Item{+w, +e}}:
      eq => incr_b(KV.live(now, e), t, k, by, n, x, now, rr, w, e, eq)

# INCRBY on a database record is the update UIncr
def incr_upd_eq(+t: KV.Trie<KV.Val>, +k: String, +by: R.By, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.exec(R.IncrBy{k, by}, R.Db{t, n, x, now, rr}) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(R.UIncr{by}, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))) : R.Reply & R.Db}:
  %get_read(t, k, now) : {R.incr.got(t, k, KV.hash(k), by, n, x, now, rr, _) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(R.UIncr{by}, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))) : R.Reply & R.Db}
  %live_val_ent(KV.entry(KV.Val, t, k), now) : {R.incr.got(t, k, KV.hash(k), by, n, x, now, rr, KV.got_of(_)) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(R.UIncr{by}, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))) : R.Reply & R.Db}
  %entry_at_eq(KV.Val, t, k) : {R.incr.got(t, k, KV.hash(k), by, n, x, now, rr, KV.got_of(item_val(R.ent.live(now, KV.entry(KV.Val, t, k))))) == R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(_), R.upd.v(R.UIncr{by}, now, R.ent.live(now, _))) : R.Reply & R.Db}
  incr_m(KV.entry(KV.Val, t, k), t, k, by, n, x, now, rr)({==})

# A.run splits into the reply, the effects and the database
def put_split(+c: R.Cmd, p: R.Reply & R.Db) -> {(R.reply_of(p), (A.effect(c), R.db_of(p))) == A.run.put(c, p) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  (y, d) = p
  {==}

def out_split(p: R.Reply & R.Db, -es: List<&2, R.Cmd>) -> {(R.reply_of(p), (es, R.db_of(p))) == A.run.out(p, es) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  (y, d) = p
  {==}

def upd_split(+db: R.Db, +k: String, +op: R.UpdOp) -> {(R.reply_of(R.exec(R.Upd{k, op}, db)), (upd_eff(db, k, op), R.db_of(R.exec(R.Upd{k, op}, db)))) == A.run(R.Upd{k, op}, db) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      %db_upd_eq(t, k, n, x, now, rr, op) : {(R.reply_of(_), (upd_eff(R.Db{t, n, x, now, rr}, k, op), R.db_of(_))) == A.run(R.Upd{k, op}, R.Db{t, n, x, now, rr}) : R.Reply & (List<&2, R.Cmd> & R.Db)}
      %run_upd_eq(t, k, n, x, now, rr, op) : {(R.reply_of(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))))), (upd_eff(R.Db{t, n, x, now, rr}, k, op), R.db_of(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))))))) == _ : R.Reply & (List<&2, R.Cmd> & R.Db)}
      out_split(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))), A.upd.effect(k, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))))

def incr_split(+db: R.Db, +k: String, +by: R.By) -> {(R.reply_of(R.exec(R.IncrBy{k, by}, db)), (upd_eff(db, k, R.UIncr{by}), R.db_of(R.exec(R.IncrBy{k, by}, db)))) == A.run(R.IncrBy{k, by}, db) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      %Equal.sym(R.Reply & R.Db, R.exec(R.IncrBy{k, by}, R.Db{t, n, x, now, rr}), R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(R.UIncr{by}, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))), incr_upd_eq(t, k, by, n, x, now, rr)) : {(R.reply_of(_), (upd_eff(R.Db{t, n, x, now, rr}, k, R.UIncr{by}), R.db_of(_))) == A.run(R.IncrBy{k, by}, R.Db{t, n, x, now, rr}) : R.Reply & (List<&2, R.Cmd> & R.Db)}
      out_split(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(R.UIncr{by}, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))), A.upd.effect(k, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(R.UIncr{by}, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))))

def lmpop_out_split(+k: String, r: R.Reply & R.Db, -es: List<&2, R.Cmd>) -> {(R.reply_of(R.lmpop.out(k, r)), (es, R.db_of(R.lmpop.out(k, r)))) == A.lmpop.out(k, (R.reply_of(r), (es, R.db_of(r)))) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  (y, d) = r
  {==}

def lmpop_split(m: Maybe<&2, String>, +left: Bool, +cnt: String, +db: R.Db) -> {(R.reply_of(R.lmpop.at(m, left, cnt, db)), (lmpop_eff(m, left, cnt, db), R.db_of(R.lmpop.at(m, left, cnt, db)))) == A.lmpop.at(m, left, cnt, db) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match m:
    case Some{+k}:
      Equal.trans(R.Reply & (List<&2, R.Cmd> & R.Db),
        (R.reply_of(R.lmpop.out(k, R.db.upd(db, k, R.UList{R.LWPopN{left, cnt}}))), (upd_eff(db, k, R.UList{R.LWPopN{left, cnt}}), R.db_of(R.lmpop.out(k, R.db.upd(db, k, R.UList{R.LWPopN{left, cnt}}))))),
        A.lmpop.out(k, (R.reply_of(R.db.upd(db, k, R.UList{R.LWPopN{left, cnt}})), (upd_eff(db, k, R.UList{R.LWPopN{left, cnt}}), R.db_of(R.db.upd(db, k, R.UList{R.LWPopN{left, cnt}}))))),
        A.lmpop.out(k, A.run.upd(db, k, R.UList{R.LWPopN{left, cnt}})),
        lmpop_out_split(k, R.db.upd(db, k, R.UList{R.LWPopN{left, cnt}}), upd_eff(db, k, R.UList{R.LWPopN{left, cnt}})),
        Equal.cong(R.Reply & (List<&2, R.Cmd> & R.Db), R.Reply & (List<&2, R.Cmd> & R.Db), z => A.lmpop.out(k, z), (R.reply_of(R.db.upd(db, k, R.UList{R.LWPopN{left, cnt}})), (upd_eff(db, k, R.UList{R.LWPopN{left, cnt}}), R.db_of(R.db.upd(db, k, R.UList{R.LWPopN{left, cnt}})))), A.run.upd(db, k, R.UList{R.LWPopN{left, cnt}}), upd_split(db, k, R.UList{R.LWPopN{left, cnt}})))
    case None{}:
      {==}

def sstore_of_split(xs: List<&2, String>, +d: String, +db: R.Db) -> {(R.reply_of(R.sstore.of(xs, d, db)), (sstore_eff_of(xs, d, db), R.db_of(R.sstore.of(xs, d, db)))) == A.sstore.eff(xs, d, db) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match xs:
    case Nil{}:
      Equal.cong(R.Reply & (List<&2, R.Cmd> & R.Db), R.Reply & (List<&2, R.Cmd> & R.Db), z => A.sstore.ans(0n, z), (R.reply_of(R.exec(R.Del{[d]}, db)), (A.effect(R.Del{[d]}), R.db_of(R.exec(R.Del{[d]}, db)))), A.run.put(R.Del{[d]}, R.exec(R.Del{[d]}, db)), put_split(R.Del{[d]}, R.exec(R.Del{[d]}, db)))
    case Con{+x, +rest}:
      Equal.cong(R.Reply & (List<&2, R.Cmd> & R.Db), R.Reply & (List<&2, R.Cmd> & R.Db), z => A.sstore.ans(List.length(&2, String, x <> rest), z), (R.reply_of(R.exec(R.Upd{d, R.UMems{R.SWNew{x <> rest}}}, db)), (upd_eff(db, d, R.UMems{R.SWNew{x <> rest}}), R.db_of(R.exec(R.Upd{d, R.UMems{R.SWNew{x <> rest}}}, db)))), A.run(R.Upd{d, R.UMems{R.SWNew{x <> rest}}}, db), upd_split(db, d, R.UMems{R.SWNew{x <> rest}}))

def sstore_split(g: R.SGot, +op: R.SetK, +ks: List<&2, String>, +d: String, +db: R.Db) -> {(R.reply_of(R.sstore.do(g, op, ks, d, db)), (sstore_eff(g, op, ks, d, db), R.db_of(R.sstore.do(g, op, ks, d, db)))) == A.sstore.run(g, op, ks, d, db) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match g:
    case R.SGot{+ss}:
      sstore_of_split(R.sop.members(op, ks, ss), d, db)
    case R.SGotWrong{}:
      {==}

def zstore_of_split(xs: List<&2, KV.ZEl>, +d: String, +db: R.Db) -> {(R.reply_of(R.zstore.of(xs, d, db)), (zstore_eff_of(xs, d, db), R.db_of(R.zstore.of(xs, d, db)))) == A.zstore.eff(xs, d, db) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match xs:
    case Nil{}:
      Equal.cong(R.Reply & (List<&2, R.Cmd> & R.Db), R.Reply & (List<&2, R.Cmd> & R.Db), z => A.sstore.ans(0n, z), (R.reply_of(R.exec(R.Del{[d]}, db)), (A.effect(R.Del{[d]}), R.db_of(R.exec(R.Del{[d]}, db)))), A.run.put(R.Del{[d]}, R.exec(R.Del{[d]}, db)), put_split(R.Del{[d]}, R.exec(R.Del{[d]}, db)))
    case Con{+x, +rest}:
      Equal.cong(R.Reply & (List<&2, R.Cmd> & R.Db), R.Reply & (List<&2, R.Cmd> & R.Db), z => A.sstore.ans(List.length(&2, KV.ZEl, x <> rest), z), (R.reply_of(R.exec(R.Upd{d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(x <> rest)}}}, db)), (upd_eff(db, d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(x <> rest)}}), R.db_of(R.exec(R.Upd{d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(x <> rest)}}}, db)))), A.run(R.Upd{d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(x <> rest)}}}, db), upd_split(db, d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(x <> rest)}}))

def zstore_ok_split(bad: Maybe<&2, R.Reply>, +op: R.ZSetK, ss: List<&2, R.ZSrc>, +d: String, +db: R.Db) -> {(R.reply_of(R.zstore.ok(bad, op, ss, d, db)), (zstore_eff_ok(bad, op, ss, d, db), R.db_of(R.zstore.ok(bad, op, ss, d, db)))) == A.zstore.ok(bad, op, ss, d, db) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match bad:
    case Some{r}:
      {==}
    case None{}:
      zstore_of_split(R.zop.els(op, ss), d, db)

def zstore_split(g: R.ZGot, +op: R.ZSetK, +d: String, +db: R.Db) -> {(R.reply_of(R.zstore.do(g, op, d, db)), (zstore_eff(g, op, d, db), R.db_of(R.zstore.do(g, op, d, db)))) == A.zstore.run(g, op, d, db) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match g:
    case R.ZGot{ss}:
      zstore_ok_split(R.zop.bad(op), op, ss, d, db)
    case R.ZGotWrong{}:
      {==}

def zrs_split(m: Maybe<&2, KV.Val>, q: R.ZQ, +d: String, +db: R.Db) -> {(R.reply_of(R.zrs.of(m, q, d, db)), (zrs_eff(m, q, d, db), R.db_of(R.zrs.of(m, q, d, db)))) == A.zrs.run(m, q, d, db) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match m:
    case None{}:
      zstore_of_split(Nil{}, d, db)
    case Some{KV.VColl{KV.CZset{+z}}}:
      zstore_of_split(R.zq.run(q, z), d, db)
    case Some{KV.VColl{KV.CHash{h}}}:
      {==}
    case Some{KV.VColl{KV.CList{l}}}:
      {==}
    case Some{KV.VColl{KV.CMems{s}}}:
      {==}
    case Some{KV.VColl{KV.CStream{s}}}:
      {==}
    case Some{KV.VStr{w}}:
      {==}

def zout_split(+k: String, r: R.Reply & R.Db, -es: List<&2, R.Cmd>) -> {(R.reply_of(R.zmpop.out(k, r)), (es, R.db_of(R.zmpop.out(k, r)))) == A.zmpop.out(k, (R.reply_of(r), (es, R.db_of(r)))) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  (y, d) = r
  {==}

def zmpop_split(m: Maybe<&2, String>, +max: Bool, +c: String, +db: R.Db) -> {(R.reply_of(R.zmpop.at(m, max, c, db)), (zmpop_eff(m, max, c, db), R.db_of(R.zmpop.at(m, max, c, db)))) == A.zmpop.at(m, max, c, db) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match m:
    case Some{+k}:
      Equal.trans(R.Reply & (List<&2, R.Cmd> & R.Db),
        (R.reply_of(R.zmpop.out(k, R.db.upd(db, k, R.UZset{R.ZWPopN{max, c}}))), (upd_eff(db, k, R.UZset{R.ZWPopN{max, c}}), R.db_of(R.zmpop.out(k, R.db.upd(db, k, R.UZset{R.ZWPopN{max, c}}))))),
        A.zmpop.out(k, (R.reply_of(R.db.upd(db, k, R.UZset{R.ZWPopN{max, c}})), (upd_eff(db, k, R.UZset{R.ZWPopN{max, c}}), R.db_of(R.db.upd(db, k, R.UZset{R.ZWPopN{max, c}}))))),
        A.zmpop.out(k, A.run.upd(db, k, R.UZset{R.ZWPopN{max, c}})),
        zout_split(k, R.db.upd(db, k, R.UZset{R.ZWPopN{max, c}}), upd_eff(db, k, R.UZset{R.ZWPopN{max, c}})),
        Equal.cong(R.Reply & (List<&2, R.Cmd> & R.Db), R.Reply & (List<&2, R.Cmd> & R.Db), z => A.zmpop.out(k, z), (R.reply_of(R.db.upd(db, k, R.UZset{R.ZWPopN{max, c}})), (upd_eff(db, k, R.UZset{R.ZWPopN{max, c}}), R.db_of(R.db.upd(db, k, R.UZset{R.ZWPopN{max, c}})))), A.run.upd(db, k, R.UZset{R.ZWPopN{max, c}}), upd_split(db, k, R.UZset{R.ZWPopN{max, c}})))
    case None{}:
      {==}

def run_split(c: R.Cmd, +db: R.Db) -> {(R.reply_of(R.exec(c, db)), (eff(c, db), R.db_of(R.exec(c, db)))) == A.run(c, db) : R.Reply & (List<&2, R.Cmd> & R.Db)}:
  match c:
    case R.Ping{}:
      put_split(R.Ping{}, R.exec(R.Ping{}, db))
    case R.Echo{+m}:
      put_split(R.Echo{m}, R.exec(R.Echo{m}, db))
    case R.Get{+k}:
      put_split(R.Get{k}, R.exec(R.Get{k}, db))
    case R.Set{+k, +v}:
      put_split(R.Set{k, v}, R.exec(R.Set{k, v}, db))
    case R.Del{+ks}:
      put_split(R.Del{ks}, R.exec(R.Del{ks}, db))
    case R.Exists{+ks}:
      put_split(R.Exists{ks}, R.exec(R.Exists{ks}, db))
    case R.IncrBy{+k, +by}:
      incr_split(db, k, by)
    case R.MGet{+ks}:
      put_split(R.MGet{ks}, R.exec(R.MGet{ks}, db))
    case R.MSet{+ps}:
      put_split(R.MSet{ps}, R.exec(R.MSet{ps}, db))
    case R.DbSize{}:
      put_split(R.DbSize{}, R.exec(R.DbSize{}, db))
    case R.FlushDb{}:
      put_split(R.FlushDb{}, R.exec(R.FlushDb{}, db))
    case R.Keys{+p}:
      put_split(R.Keys{p}, R.exec(R.Keys{p}, db))
    case R.Sort{+k, +o}:
      put_split(R.Sort{k, o}, R.exec(R.Sort{k, o}, db))
    case R.Scan{+a}:
      put_split(R.Scan{a}, R.exec(R.Scan{a}, db))
    case R.Peek{+k, +o}:
      put_split(R.Peek{k, o}, R.exec(R.Peek{k, o}, db))
    case R.Upd{+k, +op}:
      upd_split(db, k, op)
    case R.MSetNx{+ps}:
      out_split(R.exec(R.MSetNx{ps}, db), A.msetnx.effect(R.pairs.live(ps, R.db.now(db), R.db.trie(db)), ps))
    case R.Rename{+s, +d, +nx}:
      out_split(R.exec(R.Rename{s, d, nx}, db), A.ren.effect(R.ren.find(db, s, d, nx), s, d))
    case R.BitOp{+op, +d, +srcs}:
      out_split(R.exec(R.BitOp{op, d, srcs}, db), A.bitop.eff(R.bitop.wrong(srcs, R.db.now(db), R.db.trie(db)), op, d, srcs, db))
    case R.LMove{+s, +d, +w}:
      out_split(R.exec(R.LMove{s, d, w}, db), A.lmove.effect(A.lmove.moved(R.mv.find(db, s, d, w)), R.ent.dead(R.db.now(db), R.db.entry(db, d)), s, d, w))
    case R.LMPop{+ks, +left, +cnt}:
      lmpop_split(R.lmpop.first(ks, R.lmpop.head(ks, db), db), left, cnt, db)
    case R.SOp{+op, +ks}:
      put_split(R.SOp{op, ks}, R.exec(R.SOp{op, ks}, db))
    case R.SStore{+op, +d, +srcs}:
      sstore_split(R.sets.at(srcs, R.db.now(db), R.db.trie(db)), op, srcs, d, db)
    case R.SMv{+s, +d, +w}:
      out_split(R.exec(R.SMv{s, d, w}, db), A.smove.effect(A.smove.moved(R.smv.of(db, s, d, w)), R.ent.dead(R.db.now(db), R.db.entry(db, d)), s, d, w))
    case R.ZOp{+op, +ks}:
      put_split(R.ZOp{op, ks}, R.exec(R.ZOp{op, ks}, db))
    case R.ZStore{+op, +d, +srcs}:
      zstore_split(R.zsrcs.at(srcs, R.db.now(db), R.db.trie(db)), op, d, db)
    case R.ZRangeStore{+d, +s, +q}:
      zrs_split(R.db.read(db, s), q, d, db)
    case R.ZMPop{+ks, +max, +c}:
      zmpop_split(R.lmpop.first(ks, R.lmpop.head(ks, db), db), max, c, db)
    case R.Own{+o}:
      put_split(R.Own{o}, R.exec(R.Own{o}, db))
    case R.Bad{+r}:
      put_split(R.Bad{r}, R.exec(R.Bad{r}, db))

# the effects of a batch run on db, in order
def effs(cs: List<&2, R.Cmd>, +db: R.Db) -> List<&2, R.Cmd>:
  match cs:
    case Nil{}:
      Nil{}
    case Con{+c, rest}:
      List.append(&2, R.Cmd, eff(c, db), effs(rest, R.db_of(R.exec(c, db))))

def rev_go_app(e: List<&2, R.Cmd>, -es: List<&2, R.Cmd>, -ys: List<&2, R.Cmd>) -> {List.reverse.go(&2, R.Cmd, List.reverse.go(&2, R.Cmd, e, es), ys) == List.reverse.go(&2, R.Cmd, es, List.append(&2, R.Cmd, e, ys)) : List<&2, R.Cmd>}:
  match e:
    case Nil{}:
      {==}
    case Con{h, t}:
      rev_go_app(t, h <> es, ys)

# exec_log is run, with each command's effects in turn
def log_go(cs: List<&2, R.Cmd>, +rs: List<&2, R.Reply>, +es: List<&2, R.Cmd>, +d: R.Db)
  -> {(List.reverse.go(&2, R.Reply, rs, rfst(run(cs, d))), (List.reverse.go(&2, R.Cmd, es, effs(cs, d)), rsnd(run(cs, d)))) == A.log.fin(A.log.go(cs, (rs, (es, d)))) : List<&2, R.Reply> & (List<&2, R.Cmd> & R.Db)}:
  match cs:
    case Nil{}:
      {==}
    case Con{+c, +rest}:
      %run_split(c, d) : {(List.reverse.go(&2, R.Reply, rs, rfst(run(Con{c, rest}, d))), (List.reverse.go(&2, R.Cmd, es, effs(Con{c, rest}, d)), rsnd(run(Con{c, rest}, d)))) == A.log.fin(A.log.go(rest, A.log.put(rs, es, _))) : List<&2, R.Reply> & (List<&2, R.Cmd> & R.Db)}
      %eta_l(run(rest, R.db_of(R.exec(c, d)))) : {(List.reverse.go(&2, R.Reply, rs, rfst(R.exec_all.cons(R.reply_of(R.exec(c, d)), _))), (List.reverse.go(&2, R.Cmd, es, effs(Con{c, rest}, d)), rsnd(R.exec_all.cons(R.reply_of(R.exec(c, d)), _)))) == A.log.fin(A.log.go(rest, (R.reply_of(R.exec(c, d)) <> rs, (List.reverse.go(&2, R.Cmd, eff(c, d), es), R.db_of(R.exec(c, d)))))) : List<&2, R.Reply> & (List<&2, R.Cmd> & R.Db)}
      %rev_go_app(eff(c, d), es, effs(rest, R.db_of(R.exec(c, d)))) : {(List.reverse.go(&2, R.Reply, rs, R.reply_of(R.exec(c, d)) <> rfst(run(rest, R.db_of(R.exec(c, d))))), (_, rsnd(run(rest, R.db_of(R.exec(c, d)))))) == A.log.fin(A.log.go(rest, (R.reply_of(R.exec(c, d)) <> rs, (List.reverse.go(&2, R.Cmd, eff(c, d), es), R.db_of(R.exec(c, d)))))) : List<&2, R.Reply> & (List<&2, R.Cmd> & R.Db)}
      log_go(rest, R.reply_of(R.exec(c, d)) <> rs, List.reverse.go(&2, R.Cmd, eff(c, d), es), R.db_of(R.exec(c, d)))

def log_parts(+cs: List<&2, R.Cmd>, +db: R.Db) -> {(rfst(run(cs, db)), (effs(cs, db), rsnd(run(cs, db)))) == A.exec_log(cs, db) : List<&2, R.Reply> & (List<&2, R.Cmd> & R.Db)}:
  log_go(cs, Nil{}, Nil{}, db)

def effects_eq(+cs: List<&2, R.Cmd>, +db: R.Db) -> {effs(cs, db) == Laws.effects(A.exec_log(cs, db)) : List<&2, R.Cmd>}:
  %log_parts(cs, db) : {effs(cs, db) == Laws.effects(_) : List<&2, R.Cmd>}
  {==}

# the log run after its hints is exec_log, whatever the hints' verdict
def log_hinted_any(u: Bool, +cs: List<&2, R.Cmd>, +db: R.Db) -> {A.log_hinted(u, cs, db) == A.exec_log(cs, db) : List<&2, R.Reply> & (List<&2, R.Cmd> & R.Db)}:
  match u:
    case True{}:
      {==}
    case False{}:
      {==}

def Laws.log_hints(cs, hs, db):
  log_hinted_any(U32.is_eq(B.touch_db(B.many(hs), hs, db), 0), cs, db)

def Laws.log_exec(cs, db):
  %log_parts(cs, db) : {Laws.log_out(_) == R.exec_all(cs, db) : List<&2, R.Reply> & R.Db}
  Equal.trans(List<&2, R.Reply> & R.Db, (rfst(run(cs, db)), rsnd(run(cs, db))), run(cs, db), R.exec_all(cs, db), eta_l(run(cs, db)), exec_all_run(cs, db))

# Replaying
# ---------
# A batch's effects, run at time 0 on the database the batch ran on, leave
# the database it left, at time 0 (Laws.log_replay). An update's change
# is one its effects make again (ch_replay), for the change it made is a
# good one (upd_good): it deletes, or sets the time alone, of a key that
# is there, it sets the time alone to none only when the key had one, it
# keeps the time of a key there only, and a time it gives is one a key may
# keep (KV.clamp), which the file writes and reads back. At time 0 every
# key is there (live0), so an update the file holds reads the entry the
# update it logs read.

def live0(e: Nat) -> {KV.live(0n, e) == True{} : Bool}:
  match e:
    case 0n:
      {==}
    case 1n+p:
      {==}

def live0_ent(m: Maybe<&2, KV.Item<KV.Val>>) -> {R.ent.live(0n, m) == m : Maybe<&2, KV.Item<KV.Val>>}:
  match m:
    case Some{KV.Item{v, +e}}:
      %Equal.sym(Bool, KV.live(0n, e), True{}, live0(e)) : {Bool.pick(Maybe<&2, KV.Item<KV.Val>>, _, Some{KV.Item{v, e}}, None{}) == Some{KV.Item{v, e}} : Maybe<&2, KV.Item<KV.Val>>}
      {==}
    case None{}:
      {==}

def max_zero(p: Nat) -> {Nat.max(p, 0n) == p : Nat}:
  match p:
    case 0n:
      {==}
    case 1n+q:
      {==}

def zero_succ(-p: Nat, e: {0n == 1n+p : Nat}) -> Empty:
  true_false(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, 1n+p, e))

# a time a key may keep, not 0, is small
def fs_go(b: Bool, -p: Nat) -> {KV.clamp.go(b, 1n+p) == 1n+p : Nat} -> {b == True{} : Bool}:
  match b:
    case True{}:
      e => {==}
    case False{}:
      e => Empty.absurd({False{} == True{} : Bool}, zero_succ(p, e))

def fixed_small(+p: Nat, fx: {KV.clamp(1n+p) == 1n+p : Nat}) -> {KV.small(1n+p) == True{} : Bool}:
  fs_go(KV.small(1n+p), p)(fx)

def ci_go(b: Bool, +p: Nat) -> {b == KV.small(1n+p) : Bool} -> {KV.clamp(KV.clamp.go(b, 1n+p)) == KV.clamp.go(b, 1n+p) : Nat}:
  match b:
    case True{}:
      eb => %eb : {KV.clamp.go(_, 1n+p) == 1n+p : Nat}
            {==}
    case False{}:
      eb => {==}

# a time clamped is one a key may keep
def clamp_idem(e: Nat) -> {KV.clamp(KV.clamp(e)) == KV.clamp(e) : Nat}:
  match e:
    case 0n:
      {==}
    case 1n++p:
      ci_go(KV.small(1n+p), p)({==})

def ms_fixed(+p: Nat, fx: {KV.clamp(1n+p) == 1n+p : Nat}) -> {R.at.ms(1n+p) == R.AtMs{1n+p} : R.At}:
  %Equal.sym(Bool, KV.small(1n+p), True{}, fixed_small(p, fx)) : {Bool.pick(R.At, _, R.AtMs{1n+p}, R.AtFar{}) == R.AtMs{1n+p} : R.At}
  {==}

def exp_ms(+p: Nat) -> {R.at.exp(R.AtMs{1n+p}) == 1n+p : Nat}:
  %Equal.sym(Nat, Nat.max(p, 0n), p, max_zero(p)) : {1n+_ == 1n+p : Nat}
  {==}

# a key's code is its entry's
def code_at(+t: KV.Trie<KV.Val>, +k: String, -m: Maybe<&2, KV.Item<KV.Val>>, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>}) -> {R.ent.code(m) == KV.code.at(KV.Val, t, k, KV.hash(k)) : Nat}:
  code_m(t, k, m, Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, t, k), KV.entry.at(KV.Val, t, k, KV.hash(k)), m, entry_at_eq(KV.Val, t, k), eq))

# the string an update that acts on a key of any kind sees: a string's
# own, and for a collection "" (none of those updates reads it)
def sview(w: KV.Val) -> String:
  match w:
    case KV.VStr{u}:
      u
    case KV.VColl{c}:
      ""

def sv_ent(m: Maybe<&2, KV.Item<KV.Val>>) -> Maybe<&2, KV.Item<String>>:
  match m:
    case Some{KV.Item{w, e}}:
      Some{KV.Item{sview(w), e}}
    case None{}:
      None{}

# such an update (SETNX, SET, EXPIRE and its kin, PERSIST) acts on the
# string view of the entry
def any_v(+op: R.UpdOp, +now: Nat, w: KV.Val, +e: Nat) -> {R.upd.any(op) == True{} : Bool} -> {R.upd.v(op, now, Some{KV.Item{w, e}}) == R.upd(op, now, Some{KV.Item{sview(w), e}}) : R.Out}:
  match w:
    case KV.VStr{u}:
      a => {==}
    case KV.VColl{c}:
      a => %Equal.sym(Bool, R.upd.any(op), True{}, a) : {R.upd.coll(_, op, now, c, e) == R.upd(op, now, Some{KV.Item{"", e}}) : R.Out}
           {==}

def any_ent(+op: R.UpdOp, +now: Nat, m: Maybe<&2, KV.Item<KV.Val>>) -> {R.upd.any(op) == True{} : Bool} -> {R.upd.v(op, now, m) == R.upd(op, now, sv_ent(m)) : R.Out}:
  match m:
    case Some{KV.Item{w, +e}}:
      a => any_v(op, now, w, e)(a)
    case None{}:
      a => {==}

# a good change of a key whose entry is m
def GoodExp(m: Maybe<&2, KV.Item<KV.Val>>, f: Nat) -> Type:
  match m:
    case Some{KV.Item{w, e}}:
      {KV.clamp(f) == f : Nat} & {Bool.and(Nat.is_eq(f, 0n), Nat.is_eq(e, 0n)) == False{} : Bool}
    case None{}:
      Empty

def GoodAppV(w: KV.Val, s: String, v: String) -> Type:
  match w:
    case KV.VStr{u}:
      {v == u ++ s : String}
    case KV.VColl{c}:
      Empty

def GoodApp(m: Maybe<&2, KV.Item<KV.Val>>, s: String, v: String) -> Type:
  match m:
    case Some{KV.Item{w, e}}:
      GoodAppV(w, s, v)
    case None{}:
      Empty

# a SETRANGE of s at o (or a SETBIT, as one) of a key there: one that
# changes it (R.range.go), whose value v is the old one w with s at o
def GoodRangeV(w: KV.Val, o: Nat, s: String, v: String) -> Type:
  match w:
    case KV.VStr{u}:
      {R.range.go(o, s) == True{} : Bool} & {v == R.range.put(u, o, s) : String}
    case KV.VColl{c}:
      Empty

def GoodRange(m: Maybe<&2, KV.Item<KV.Val>>, o: Nat, s: String, v: String) -> Type:
  match m:
    case Some{KV.Item{w, e}}:
      GoodRangeV(w, o, s, v)
    case None{}:
      Empty

# A write of a hash: its change replayed. A hash changed is one the key
# held (h0), and the write it keeps, replayed on h0, makes the same change:
# an HSET of pairs, or an HDEL of fields, neither of them empty. A new hash
# is the pairs it keeps set in an empty hash, none at all being no change.
def hput.h(r: R.HPut) -> KV.Hash:
  match r:
    case R.HPut{h, made}:
      h

def NeP(ps: List<&2, KV.HPair>) -> Type:
  match ps:
    case Nil{}:
      Empty
    case Con{p, rest}:
      {True{} == True{} : Bool}

def NeS(fs: List<&2, String>) -> Type:
  match fs:
    case Nil{}:
      Empty
    case Con{f, rest}:
      {True{} == True{} : Bool}

def GoodOp(op: R.HWrite) -> Type:
  match op:
    case R.HWSet{ps, False{}}:
      NeP(ps)
    case R.HWDel{fs}:
      NeS(fs)
    case _:
      Empty

def GoodHashV(w: KV.Val, op: R.HWrite, hv: KV.Hash) -> Type:
  match w:
    case KV.VColl{KV.CHash{h0}}:
      {ch_of(R.hwrite(op, False{}, h0)) == R.CHash{op, hv} : R.Change} & GoodOp(op)
    case KV.VColl{KV.CList{l0}}:
      Empty
    case KV.VColl{KV.CMems{s0}}:
      Empty
    case KV.VColl{KV.CZset{z0}}:
      Empty
    case KV.VColl{KV.CStream{z0}}:
      Empty
    case KV.VStr{u}:
      Empty

def GoodHash(m: Maybe<&2, KV.Item<KV.Val>>, op: R.HWrite, hv: KV.Hash) -> Type:
  match m:
    case Some{KV.Item{w, e}}:
      GoodHashV(w, op, hv)
    case None{}:
      Empty

def GoodNew(ps: List<&2, KV.HPair>, hv: KV.Hash) -> Type:
  {R.hset.ch(True{}, ps, hput.h(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}))) == R.CHashNew{ps, hv} : R.Change} & NeP(ps)

# A write of a list: its change replayed. A list changed is one the key
# held (l0), and the write the change keeps, replayed on l0, makes the
# same change; the file logs it as a command that parses back to it
# (GoodLOp): a push of elements, a pop (of a count that reads as one),
# LSET, LINSERT, LREM of a count and LTRIM of a range that read as
# numbers. A new list is the pushes it keeps, of elements, made on an
# empty list.
def GoodLOp(op: R.LWrite) -> Type:
  match op:
    case R.LWPush{left, xs}:
      NeS(xs)
    case R.LWPushX{left, xs}:
      NeS(xs)
    case R.LWPop{left}:
      {True{} == True{} : Bool}
    case R.LWPopN{left, c}:
      {Maybe.is_some(&2, Nat, R.lcount(c)) == True{} : Bool}
    case R.LWSet{i, v}:
      {True{} == True{} : Bool}
    case R.LWBefore{p, v}:
      {True{} == True{} : Bool}
    case R.LWAfter{p, v}:
      {True{} == True{} : Bool}
    case R.LWRem{c, v}:
      {R.lnum.ok(c) == True{} : Bool}
    case R.LWTrim{a, b}:
      {Bool.and(R.lnum.ok(a), R.lnum.ok(b)) == True{} : Bool}
    case R.LWNew{left, xs}:
      Empty

def GoodListV(w: KV.Val, op: R.LWrite, l: KV.Deq) -> Type:
  match w:
    case KV.VColl{KV.CList{l0}}:
      {ch_of(R.lwrite(op, False{}, l0)) == R.CList{op, l} : R.Change} & GoodLOp(op)
    case KV.VColl{KV.CHash{h0}}:
      Empty
    case KV.VColl{KV.CMems{s0}}:
      Empty
    case KV.VColl{KV.CZset{z0}}:
      Empty
    case KV.VColl{KV.CStream{z0}}:
      Empty
    case KV.VStr{u}:
      Empty

def GoodList(m: Maybe<&2, KV.Item<KV.Val>>, op: R.LWrite, l: KV.Deq) -> Type:
  match m:
    case Some{KV.Item{w, e}}:
      GoodListV(w, op, l)
    case None{}:
      Empty

def GoodNewL(left: Bool, xs: List<&2, String>, l: KV.Deq) -> Type:
  {KV.deq.pushes(left, xs, KV.deq.empty()) == l : KV.Deq} & NeS(xs)

# A write of a set: its change replayed. A set changed is one the key
# held (s0), and the write the change keeps, replayed on s0, makes the
# same change: an SADD or an SREM of members, none of them empty (SPOP's
# change is the SREM of what it took). A new set is its members added to
# an empty set, none at all being no change.
def GoodSOp(op: R.SWrite) -> Type:
  match op:
    case R.SWAdd{ms}:
      NeS(ms)
    case R.SWRem{ms}:
      NeS(ms)
    case _:
      Empty

def GoodMemsV(w: KV.Val, op: R.SWrite, sv: KV.Mems) -> Type:
  match w:
    case KV.VColl{KV.CMems{s0}}:
      {ch_of(R.swrite(op, False{}, s0)) == R.CMems{op, sv} : R.Change} & GoodSOp(op)
    case KV.VColl{KV.CZset{z0}}:
      Empty
    case KV.VColl{KV.CStream{z0}}:
      Empty
    case KV.VColl{KV.CHash{h0}}:
      Empty
    case KV.VColl{KV.CList{l0}}:
      Empty
    case KV.VStr{u}:
      Empty

def GoodMems(m: Maybe<&2, KV.Item<KV.Val>>, op: R.SWrite, sv: KV.Mems) -> Type:
  match m:
    case Some{KV.Item{w, e}}:
      GoodMemsV(w, op, sv)
    case None{}:
      Empty

def GoodNewM(ms: List<&2, String>, sv: KV.Mems) -> Type:
  {KV.mems.of(ms) == sv : KV.Mems} & NeS(ms)

# A write of a sorted set: its change replayed. A sorted set changed is
# one the key held (z0), and the write the change keeps, replayed on z0,
# makes the same change; the file logs it as a command that parses back
# to it (GoodZOp): a ZADD whose options and pairs pass ZADD's checks, a
# ZREM of members, a removal of a range that reads, a pop (of a count
# that reads). A new sorted set is the ZADD of options without XX that
# pass the checks, made on an empty sorted set.
def GoodZOp(op: R.ZWrite) -> Type:
  match op:
    case R.ZWAdd{o, ps}:
      {R.zadd.check(o, ps) == None{} : Maybe<&2, R.Reply>}
    case R.ZWRem{ms}:
      NeS(ms)
    case R.ZWNew{o, ps}:
      Empty
    case R.ZWRemRank{a, b}:
      {Maybe.is_some(&2, R.ZRng, R.zrng.of(1n, a, b)) == True{} : Bool}
    case R.ZWRemScore{a, b}:
      {Maybe.is_some(&2, R.ZRng, R.zrng.of(2n, a, b)) == True{} : Bool}
    case R.ZWRemLex{a, b}:
      {Maybe.is_some(&2, R.ZRng, R.zrng.of(3n, a, b)) == True{} : Bool}
    case R.ZWPop{max}:
      {True{} == True{} : Bool}
    case R.ZWPopN{max, c}:
      {Maybe.is_some(&2, Nat, R.lcount(c)) == True{} : Bool}

def GoodZsetV(w: KV.Val, op: R.ZWrite, z: KV.Zset) -> Type:
  match w:
    case KV.VColl{KV.CZset{z0}}:
      {ch_of(R.zwrite(op, False{}, z0)) == R.CZset{op, z} : R.Change} & GoodZOp(op)
    case KV.VColl{KV.CHash{h0}}:
      Empty
    case KV.VColl{KV.CList{l0}}:
      Empty
    case KV.VColl{KV.CMems{s0}}:
      Empty
    case KV.VColl{KV.CStream{s0}}:
      Empty
    case KV.VStr{u}:
      Empty

def GoodZset(m: Maybe<&2, KV.Item<KV.Val>>, op: R.ZWrite, z: KV.Zset) -> Type:
  match m:
    case Some{KV.Item{w, e}}:
      GoodZsetV(w, op, z)
    case None{}:
      Empty

def GoodNewZ(o: R.ZOpts, ps: List<&2, R.ZPair>, z: KV.Zset) -> Type:
  {ch_of(R.zadd.out(True{}, o, ps, KV.zset.empty())) == R.CZsetNew{o, ps, z} : R.Change} & ({R.zopts.xx(o) == False{} : Bool} & {R.zadd.check(o, ps) == None{} : Maybe<&2, R.Reply>})

def Good(m: Maybe<&2, KV.Item<KV.Val>>, ch: R.Change) -> Type:
  match ch:
    case R.CKeep{}:
      {True{} == True{} : Bool}
    case R.CDel{}:
      {Maybe.is_some(&2, KV.Item<KV.Val>, m) == True{} : Bool}
    case R.CExp{f}:
      GoodExp(m, f)
    case R.CPut{v, f}:
      {KV.clamp(f) == f : Nat}
    case R.CKeepT{v}:
      {Maybe.is_some(&2, KV.Item<KV.Val>, m) == True{} : Bool}
    case R.CApp{s, v}:
      GoodApp(m, s, v)
    case R.CRange{o, s, v}:
      GoodRange(m, o, s, v)
    case R.CHash{op, hv}:
      GoodHash(m, op, hv)
    case R.CHashNew{ps, hv}:
      GoodNew(ps, hv)
    case R.CList{op, l}:
      GoodList(m, op, l)
    case R.CListNew{left, xs, l}:
      GoodNewL(left, xs, l)
    case R.CMems{op, sv}:
      GoodMems(m, op, sv)
    case R.CMemsNew{ms, sv}:
      GoodNewM(ms, sv)
    case R.CZset{op, z}:
      GoodZset(m, op, z)
    case R.CZsetNew{o, ps, z}:
      GoodNewZ(o, ps, z)
    case R.CRestore{p, v, f}:
      {D.verify(p) == True{} : Bool} & ({D.load(p) == Some{v} : Maybe<&2, KV.Val>} & {KV.clamp(f) == f : Nat})

# a change, made again by its effects at time 0
def del_replay(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +w: KV.Val, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>}) -> {Laws.final(R.exec_all([R.Del{[k]}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CDel{}))) : R.Db}:
  %code_at(t, k, Some{KV.Item{w, e}}, eq) : {R.db_of(R.del.db(R.del_keys.put(_, 0n, R.Dels{0n, 0n, 0n, KV.del.at(KV.Val, t, k, KV.hash(k))}), n, x, 0n, rr)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CDel{}))) : R.Db}
  %add_zero(x) : {R.db_of(R.del.db(R.del_keys.put(1n+e, 0n, R.Dels{0n, 0n, 0n, KV.del.at(KV.Val, t, k, KV.hash(k))}), n, x, 0n, rr)) == R.Db{KV.del.at(KV.Val, t, k, KV.hash(k)), Nat.sub(n, 1n), Nat.sub(_, Bool.pick(Nat, Nat.is_lt(1n, 1n+e), 1n, 0n)), 0n, rr} : R.Db}
  {==}

