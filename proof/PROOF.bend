def plain_run_log(b: Bool, conn: S.Conn, +srv: S.Srv, cs: List<&2, R.Cmd>, +hs: List<&2, U32>, ds: R.Ds) -> {b == S.ready(conn, srv) : Bool} -> {plain(cs) == True{} : Bool} -> {S.run_log.plain(b, conn, srv, cs, hs, ds) == S.logged.gen(S.gen(conn, srv, cs, ds)) : S.Logged}:
  match b conn cs ds:
    case _ _ Nil{} _:
      eb => ep => {==}
    case False{} _ Con{c, rest} _:
      eb => ep => {==}
    case True{} S.Conn{+id, +a, +n, S.MOn{}, False{}, +sel, +r3} Con{+c, +rest} R.Ds{+d, +pre, +post}:
      eb => +ep => fast_eq_log(c, rest, id, a, n, sel, r3, srv, hs, d, pre, post)(Equal.sym(Bool, True{}, S.authed(S.Conn{id, a, n, S.MOn{}, False{}, sel, r3}, srv), eb))(ep)
    case True{} S.Conn{id, a, n, S.MOn{}, True{}, sel, r3} Con{c, rest} x:
      eb => ep => Empty.absurd({S.run_log.plain(True{}, S.Conn{id, a, n, S.MOn{}, True{}, sel, r3}, srv, Con{c, rest}, hs, x) == S.logged.gen(S.gen(S.Conn{id, a, n, S.MOn{}, True{}, sel, r3}, srv, Con{c, rest}, x)) : S.Logged}, true_false(eb))
    case True{} S.Conn{id, a, n, S.MOff{}, True{}, sel, r3} Con{c, rest} x:
      eb => ep => Empty.absurd({S.run_log.plain(True{}, S.Conn{id, a, n, S.MOff{}, True{}, sel, r3}, srv, Con{c, rest}, hs, x) == S.logged.gen(S.gen(S.Conn{id, a, n, S.MOff{}, True{}, sel, r3}, srv, Con{c, rest}, x)) : S.Logged}, true_false(eb))
    case True{} S.Conn{id, a, n, S.MOff{}, False{}, sel, r3} Con{c, rest} x:
      eb => ep => Empty.absurd({S.run_log.plain(True{}, S.Conn{id, a, n, S.MOff{}, False{}, sel, r3}, srv, Con{c, rest}, hs, x) == S.logged.gen(S.gen(S.Conn{id, a, n, S.MOff{}, False{}, sel, r3}, srv, Con{c, rest}, x)) : S.Logged}, true_false(eb))
    case True{} S.Conn{id, a, n, S.MSkip{}, True{}, sel, r3} Con{c, rest} x:
      eb => ep => Empty.absurd({S.run_log.plain(True{}, S.Conn{id, a, n, S.MSkip{}, True{}, sel, r3}, srv, Con{c, rest}, hs, x) == S.logged.gen(S.gen(S.Conn{id, a, n, S.MSkip{}, True{}, sel, r3}, srv, Con{c, rest}, x)) : S.Logged}, true_false(eb))
    case True{} S.Conn{id, a, n, S.MSkip{}, False{}, sel, r3} Con{c, rest} x:
      eb => ep => Empty.absurd({S.run_log.plain(True{}, S.Conn{id, a, n, S.MSkip{}, False{}, sel, r3}, srv, Con{c, rest}, hs, x) == S.logged.gen(S.gen(S.Conn{id, a, n, S.MSkip{}, False{}, sel, r3}, srv, Con{c, rest}, x)) : S.Logged}, true_false(eb))

def unzip_gen_log(+conn: S.Conn, +srv: S.Srv, rs: List<&2, B.Req>, +cs: List<&2, R.Cmd>, +hs: List<&2, U32>, +ds: R.Ds) -> {plain(cs) == True{} : Bool} -> {S.run_log(conn, srv, B.job(B.unzip(rs, cs, hs)), ds) == S.logged.gen(S.gen(conn, srv, B.cmds_of(rs, cs), ds)) : S.Logged}:
  match rs:
    case Nil{}:
      e => plain_run_log(S.ready(conn, srv), conn, srv, cs, hs, ds)({==})(e)
    case Con{B.Req{R.Ping{}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Ping{} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Echo{x0}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Echo{x0} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Get{x0}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Get{x0} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Set{x0, x1}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Set{x0, x1} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Del{x0}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Del{x0} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Exists{x0}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Exists{x0} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.IncrBy{x0, x1}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.IncrBy{x0, x1} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.MGet{x0}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.MGet{x0} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.MSet{x0}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.MSet{x0} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.DbSize{}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.DbSize{} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.FlushDb{}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.FlushDb{} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Keys{x0}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Keys{x0} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Scan{x0}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Scan{x0} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Peek{x0, x1}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Peek{x0, x1} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Upd{x0, x1}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Upd{x0, x1} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.MSetNx{x0}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.MSetNx{x0} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Rename{x0, x1, x2}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Rename{x0, x1, x2} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.BitOp{x0, x1, x2}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.BitOp{x0, x1, x2} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.LMove{x0, x1, x2}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.LMove{x0, x1, x2} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.LMPop{x0, x1, x2}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.LMPop{x0, x1, x2} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.SOp{x0, x1}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.SOp{x0, x1} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.SStore{x0, x1, x2}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.SStore{x0, x1, x2} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.SMv{x0, x1, x2}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.SMv{x0, x1, x2} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.ZOp{x0, x1}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.ZOp{x0, x1} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.ZStore{x0, x1, x2}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.ZStore{x0, x1, x2} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.ZRangeStore{x0, x1, x2}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.ZRangeStore{x0, x1, x2} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.ZMPop{x0, x1, x2}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.ZMPop{x0, x1, x2} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Sort{x0, x1}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Sort{x0, x1} <> cs, h <> hs, ds)(e)
    case Con{B.Req{R.Own{x0}, h}, rest}:
      e => mixed_gen_log(conn, srv, rest, R.Own{x0} <> cs, h <> hs, ds)
    case Con{B.Req{R.Bad{x0}, h}, rest}:
      e => unzip_gen_log(conn, srv, rest, R.Bad{x0} <> cs, h <> hs, ds)(e)

def Laws.run_log_gen(conn, srv, rs, ds):
  unzip_gen_log(conn, srv, rs, Nil{}, Nil{}, ds)({==})

# A client that has not authenticated
# ------------------------------------

def or_ff(a: Bool, -b: Bool) -> {a == False{} : Bool} -> {b == False{} : Bool} -> {Bool.or(a, b) == False{} : Bool}:
  match a:
    case True{}:
      ea => eb => Empty.absurd({Bool.or(True{}, b) == False{} : Bool}, true_false(ea))
    case False{}:
      ea => eb => eb

def not_true(b: Bool) -> {Bool.not(b) == True{} : Bool} -> {b == False{} : Bool}:
  match b:
    case True{}:
      e => Empty.absurd({True{} == False{} : Bool}, false_true(e))
    case False{}:
      e => {==}

# a client that may not run commands changes the server with none of its
# commands: it may run only those that need no login, and those leave the
# server as it was (CONFIG SET, which changes it, needs one)
def srv_same.o(o: R.SessOp, +conn: S.Conn, +srv: S.Srv, +ef: {S.authed(conn, srv) == False{} : Bool})
  -> {True{} == S.may(S.KSess{o}, conn, srv) : Bool}
  -> {S.own_srv(o, conn, srv) == srv : S.Srv}:
  match o:
    case R.SHello{y0}:
      e => {==}
    case R.SAuth{y0}:
      e => {==}
    case R.SSelect{y0}:
      e => Empty.absurd({S.own_srv(R.SSelect{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SQuit{}:
      e => {==}
    case R.SReset{}:
      e => {==}
    case R.SClientId{}:
      e => Empty.absurd({S.own_srv(R.SClientId{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SClientGetName{}:
      e => Empty.absurd({S.own_srv(R.SClientGetName{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SClientSetName{y0}:
      e => Empty.absurd({S.own_srv(R.SClientSetName{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SClientReply{y0}:
      e => Empty.absurd({S.own_srv(R.SClientReply{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SConfigGet{y0}:
      e => Empty.absurd({S.own_srv(R.SConfigGet{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SConfigSet{y0}:
      e => Empty.absurd({S.own_srv(R.SConfigSet{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SConfigResetStat{}:
      e => Empty.absurd({S.own_srv(R.SConfigResetStat{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SInfo{y0}:
      e => Empty.absurd({S.own_srv(R.SInfo{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SCommand{y0}:
      e => Empty.absurd({S.own_srv(R.SCommand{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SRandomKey{}:
      e => Empty.absurd({S.own_srv(R.SRandomKey{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SSwapDb{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SSwapDb{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SMove{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SMove{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SFlushAll{}:
      e => Empty.absurd({S.own_srv(R.SFlushAll{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.STime{}:
      e => Empty.absurd({S.own_srv(R.STime{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SObject{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SObject{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SCopy{y0}:
      e => Empty.absurd({S.own_srv(R.SCopy{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SLcs{y0}:
      e => Empty.absurd({S.own_srv(R.SLcs{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SHRandField{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SHRandField{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SSPop{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SSPop{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SSRandMember{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SSRandMember{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SZRandMember{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SZRandMember{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SBlock{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SBlock{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SUnblock{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SUnblock{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SMulti{}:
      e => Empty.absurd({S.own_srv(R.SMulti{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SExec{}:
      e => Empty.absurd({S.own_srv(R.SExec{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SDiscard{}:
      e => Empty.absurd({S.own_srv(R.SDiscard{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SWatch{y0}:
      e => Empty.absurd({S.own_srv(R.SWatch{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SUnwatch{}:
      e => Empty.absurd({S.own_srv(R.SUnwatch{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SPub{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SPub{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SClient{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SClient{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SMonitor{}:
      e => Empty.absurd({S.own_srv(R.SMonitor{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SRewrite{}:
      e => Empty.absurd({S.own_srv(R.SRewrite{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SSortStore{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SSortStore{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SPfCount{y0}:
      e => Empty.absurd({S.own_srv(R.SPfCount{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SPfMerge{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SPfMerge{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SPfSelfTest{}:
      e => Empty.absurd({S.own_srv(R.SPfSelfTest{}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SAdmin{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SAdmin{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SAcl{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SAcl{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SGeoStore{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SGeoStore{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SRestore{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SRestore{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SFail{y0}:
      e => Empty.absurd({S.own_srv(R.SFail{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SMemUsage{y0, y1}:
      e => Empty.absurd({S.own_srv(R.SMemUsage{y0, y1}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SReply{y0}:
      e => Empty.absurd({S.own_srv(R.SReply{y0}, conn, srv) == srv : S.Srv}, true_false(Equal.trans(Bool, True{}, S.authed(conn, srv), False{}, e, ef)))
    case R.SBad{y0}:
      e => {==}

def srv_same.k(k: S.Role, ok: Bool, +conn: S.Conn, +srv: S.Srv, +ef: {S.authed(conn, srv) == False{} : Bool})
  -> {ok == S.may(k, conn, srv) : Bool}
  -> {S.next_srv.k(k, ok, conn, srv) == srv : S.Srv}:
  match k ok:
    case S.KSess{o} True{}:
      e => srv_same.o(o, conn, srv, ef)(e)
    case S.KSess{o} False{}:
      e => {==}
    case S.KData{} _:
      e => {==}
    case S.KBad{} _:
      e => {==}

def srv_same(q: Bool, +c: R.Cmd, +conn: S.Conn, +srv: S.Srv, +ef: {S.authed(conn, srv) == False{} : Bool}) -> {S.next_srv(q, c, conn, srv) == srv : S.Srv}:
  match q:
    case True{}:
      {==}
    case False{}:
      srv_same.k(S.kind(c), S.may(S.kind(c), conn, srv), conn, srv, ef)({==})

