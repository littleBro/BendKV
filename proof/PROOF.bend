      ok => ok
    case Con{R.KP{+k, +v}, rest}:
      ok => counted_mset(rest, R.db.set(db, k, v))(counted_set(db, k, v)(ok))

def counted_flush(db: R.Db) -> {Laws.counted(R.db.flush(db)) == True{} : Bool}:
  match db:
    case R.Db{t, n, x, now, rr}:
      {==}

def counted_newl(db: R.Db, +k: String, +l: KV.Deq) -> {Laws.counted(db) == True{} : Bool} -> {Laws.counted(R.db.newl(db, k, l)) == True{} : Bool}:
