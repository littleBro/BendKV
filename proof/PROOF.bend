def persist_v(+v: KV.Val, +e: Nat, +now: Nat) -> {R.upd.v(R.UPersist{}, now, Some{KV.Item{v, 1n+e}}) == R.Out{R.r_int(1n), R.CExp{0n}} : R.Out}:
