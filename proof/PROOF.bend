def app_replay(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +s: String, +v: String, +w: String, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{KV.VStr{w}, e}} : Maybe<&2, KV.Item<KV.Val>>}, gv: {v == w ++ s : String}) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), R.CApp{s, v}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CApp{s, v}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UAppend{s}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CApp{s, v}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), Some{KV.Item{KV.VStr{w}, e}}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UAppend{s}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CApp{s, v}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, Some{KV.Item{KV.VStr{w}, e}}), Some{KV.Item{KV.VStr{w}, e}}, live0_ent(Some{KV.Item{KV.VStr{w}, e}})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), R.upd.v(R.UAppend{s}, 0n, _))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CApp{s, v}))) : R.Db}
  %Equal.sym(String, v, w ++ s, gv) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), R.append.of(s, Some{KV.Item{w, e}}))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CApp{s, _}))) : R.Db}
  {==}

def range_replay(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +o: Nat, +s: String, +v: String, +w: String, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{KV.VStr{w}, e}} : Maybe<&2, KV.Item<KV.Val>>}, ok: {R.range.go(o, s) == True{} : Bool}, gv: {v == R.range.put(w, o, s) : String}) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), R.CRange{o, s, v}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CRange{o, s, v}))) : R.Db}:
  %fin_cons(R.Upd{k, R.URange{o, s}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CRange{o, s, v}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), Some{KV.Item{KV.VStr{w}, e}}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.URange{o, s}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CRange{o, s, v}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, Some{KV.Item{KV.VStr{w}, e}}), Some{KV.Item{KV.VStr{w}, e}}, live0_ent(Some{KV.Item{KV.VStr{w}, e}})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), R.upd.v(R.URange{o, s}, 0n, _))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CRange{o, s, v}))) : R.Db}
  %Equal.sym(Bool, R.range.go(o, s), True{}, ok) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), R.range.some(_, o, s, w, String.is_empty(s)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CRange{o, s, v}))) : R.Db}
  %Equal.sym(String, v, R.range.put(w, o, s), gv) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), R.range.some(True{}, o, s, w, String.is_empty(s)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CRange{o, s, _}))) : R.Db}
  {==}

def range_go(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +o: Nat, +s: String, +v: String, +w: String, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{KV.VStr{w}, e}} : Maybe<&2, KV.Item<KV.Val>>}, g: GoodRange(Some{KV.Item{KV.VStr{w}, e}}, o, s, v)) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), R.CRange{o, s, v}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VStr{w}, e}}), r, R.CRange{o, s, v}))) : R.Db}:
  (ok, gv) = g
  range_replay(t, k, n, x, now, rr, r, o, s, v, w, e, eq, ok, gv)

# an update's database: its change made, whatever its reply
def ch_db(ch: R.Change, +t: KV.Trie<KV.Val>, +k: String, +h: U32, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +c: Nat, -r: R.Reply) -> {R.db_of(R.upd.ch(t, k, h, n, x, now, rr, c, R.RNull{}, ch)) == R.db_of(R.upd.ch(t, k, h, n, x, now, rr, c, r, ch)) : R.Db}:
  match ch:
    case R.CKeep{}:
      {==}
    case R.CDel{}:
      {==}
    case R.CExp{f}:
      {==}
    case R.CPut{v, f}:
      {==}
    case R.CKeepT{v}:
      {==}
    case R.CApp{a, v}:
      {==}
    case R.CRange{o, a, v}:
      {==}
    case R.CHash{op, hv}:
      {==}
    case R.CHashNew{ps, hv}:
      {==}
    case R.CList{op, l}:
      {==}
    case R.CListNew{left, xs, l}:
      {==}
    case R.CMems{op, sv}:
      {==}
    case R.CMemsNew{ms, sv}:
      {==}
    case R.CZset{op, z}:
      {==}
    case R.CZsetNew{o, ps, z}:
      {==}
    case R.CRestore{p, v, f}:
      {==}

def put_db(+t: KV.Trie<KV.Val>, +k: String, +h: U32, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +c: Nat, o: R.Out) -> {R.db_of(R.upd.ch(t, k, h, n, x, now, rr, c, R.RNull{}, ch_of(o))) == R.db_of(R.upd.put(t, k, h, n, x, now, rr, c, o)) : R.Db}:
  match o:
    case R.Out{r, +ch}:
      ch_db(ch, t, k, h, n, x, now, rr, c, r)

# HSET's change and HWNew's: the pairs set
def hset_out_ch(r: R.HPut, +fresh: Bool, +ps: List<&2, KV.HPair>, +mset: Bool) -> {R.hset.ch(fresh, ps, hput.h(r)) == ch_of(R.hset.out(r, fresh, ps, mset)) : R.Change}:
  match r:
    case R.HPut{h, made}:
      {==}

def hnew_out_ch(r: R.HPut, +ps: List<&2, KV.HPair>) -> {R.hset.ch(True{}, ps, hput.h(r)) == ch_of(R.hnew.out(r, ps)) : R.Change}:
  match r:
    case R.HPut{h, made}:
      {==}

# a hash changed, made again by its write (HSET or HDEL) at time 0
def hash_replay(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.HWrite, +hv: KV.Hash, +h0: KV.Hash, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}} : Maybe<&2, KV.Item<KV.Val>>}, gh: {ch_of(R.hwrite(op, False{}, h0)) == R.CHash{op, hv} : R.Change}) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CHash{op, hv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UHash{op}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}
  %db_upd_eq(t, k, n, x, 0n, rr, R.UHash{op}) : {R.db_of(_) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UHash{op}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}), Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, live0_ent(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.upd.v(R.UHash{op}, 0n, _))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}
  %put_db(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.hwrite(op, False{}, h0)) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}
  %Equal.sym(R.Change, ch_of(R.hwrite(op, False{}, h0)), R.CHash{op, hv}, gh) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}
  {==}

def hash_replay_g(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.HWrite, +hv: KV.Hash, +h0: KV.Hash, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}} : Maybe<&2, KV.Item<KV.Val>>}, g: {ch_of(R.hwrite(op, False{}, h0)) == R.CHash{op, hv} : R.Change} & GoodOp(op)) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CHash{op, hv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}:
  (gh, go) = g
  hash_replay(t, k, n, x, now, rr, r, op, hv, h0, e, eq, gh)

def hash_replay_v(w: KV.Val, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.HWrite, +hv: KV.Hash, +e: Nat) -> {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>} -> GoodHashV(w, op, hv) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CHash{op, hv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}:
  match w:
    case KV.VColl{KV.CHash{+h0}}:
      eq => g => hash_replay_g(t, k, n, x, now, rr, r, op, hv, h0, e, eq, g)
    case KV.VColl{KV.CList{l0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CHash{op, hv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}, g)
    case KV.VColl{KV.CMems{s0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CHash{op, hv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}, g)
    case KV.VColl{KV.CZset{z0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CHash{op, hv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}, g)
    case KV.VColl{KV.CStream{z0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CHash{op, hv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}, g)
    case KV.VStr{u}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CHash{op, hv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHash{op, hv}))) : R.Db}, g)

# a new hash, made again at time 0: by an HSET where the trie held no
# entry for the key, by the script of a new hash where it held one
def hnew_hset(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +ps: List<&2, KV.HPair>, +hv: KV.Hash, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == None{} : Maybe<&2, KV.Item<KV.Val>>}, gn: {R.hset.ch(True{}, ps, hput.h(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}))) == R.CHashNew{ps, hv} : R.Change}) -> {Laws.final(R.exec_all([R.Upd{k, R.UHash{R.HWSet{ps, False{}}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CHashNew{ps, hv}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UHash{R.HWSet{ps, False{}}}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CHashNew{ps, hv}))) : R.Db}
  %db_upd_eq(t, k, n, x, 0n, rr, R.UHash{R.HWSet{ps, False{}}}) : {R.db_of(_) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CHashNew{ps, hv}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), None{}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UHash{R.HWSet{ps, False{}}}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CHashNew{ps, hv}))) : R.Db}
  %put_db(t, k, KV.hash(k), n, x, 0n, rr, 0n, R.hset.out(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}), True{}, ps, False{})) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CHashNew{ps, hv}))) : R.Db}
  %hset_out_ch(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}), True{}, ps, False{}) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, 0n, R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CHashNew{ps, hv}))) : R.Db}
  %Equal.sym(R.Change, R.hset.ch(True{}, ps, hput.h(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}))), R.CHashNew{ps, hv}, gn) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, 0n, R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CHashNew{ps, hv}))) : R.Db}
  {==}

# the script's write, of a key that holds w: a new hash of the pairs
def hnew_v(w: KV.Val, +ps: List<&2, KV.HPair>, +e: Nat) -> {R.hnew.out(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}), ps) == R.upd.v(R.UHash{R.HWNew{ps}}, 0n, Some{KV.Item{w, e}}) : R.Out}:
  match w:
    case KV.VStr{u}:
      {==}
    case KV.VColl{KV.CHash{h0}}:
      {==}
    case KV.VColl{KV.CList{l0}}:
      {==}
    case KV.VColl{KV.CMems{s0}}:
      {==}
    case KV.VColl{KV.CZset{z0}}:
      {==}
    case KV.VColl{KV.CStream{z0}}:
      {==}

def hnew_eval(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +ps: List<&2, KV.HPair>, +hv: KV.Hash, +w: KV.Val, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>}, gn: {R.hset.ch(True{}, ps, hput.h(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}))) == R.CHashNew{ps, hv} : R.Change}) -> {Laws.final(R.exec_all([R.Upd{k, R.UHash{R.HWNew{ps}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHashNew{ps, hv}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UHash{R.HWNew{ps}}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHashNew{ps, hv}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), Some{KV.Item{w, e}}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UHash{R.HWNew{ps}}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHashNew{ps, hv}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, Some{KV.Item{w, e}}), Some{KV.Item{w, e}}, live0_ent(Some{KV.Item{w, e}})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.upd.v(R.UHash{R.HWNew{ps}}, 0n, _))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHashNew{ps, hv}))) : R.Db}
  %hnew_v(w, ps, e) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHashNew{ps, hv}))) : R.Db}
  %put_db(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.hnew.out(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}), ps)) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHashNew{ps, hv}))) : R.Db}
  %hnew_out_ch(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}), ps) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHashNew{ps, hv}))) : R.Db}
  %Equal.sym(R.Change, R.hset.ch(True{}, ps, hput.h(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}))), R.CHashNew{ps, hv}, gn) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CHashNew{ps, hv}))) : R.Db}
  {==}

def gnew_eq(-ps: List<&2, KV.HPair>, -hv: KV.Hash, g: GoodNew(ps, hv)) -> {R.hset.ch(True{}, ps, hput.h(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}))) == R.CHashNew{ps, hv} : R.Change}:
  (gn, ne) = g
  gn

def gnew_ne(-ps: List<&2, KV.HPair>, -hv: KV.Hash, g: GoodNew(ps, hv)) -> NeP(ps):
  (gn, ne) = g
  ne

def hnew_replay(m: Maybe<&2, KV.Item<KV.Val>>, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +ps: List<&2, KV.HPair>, +hv: KV.Hash) -> {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>} -> GoodNew(ps, hv) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(m), R.CHashNew{ps, hv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CHashNew{ps, hv}))) : R.Db}:
  match m:
    case Some{KV.Item{+w, +e}}:
      eq => g => hnew_eval(t, k, n, x, now, rr, r, ps, hv, w, e, eq, gnew_eq(ps, hv, g))
    case None{}:
      eq => g => hnew_hset(t, k, n, x, now, rr, r, ps, hv, eq, gnew_eq(ps, hv, g))

# a list changed, made again by its write at time 0
def list_replay(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.LWrite, +l: KV.Deq, +l0: KV.Deq, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{KV.VColl{KV.CList{l0}}, e}} : Maybe<&2, KV.Item<KV.Val>>}, gl: {ch_of(R.lwrite(op, False{}, l0)) == R.CList{op, l} : R.Change}) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CList{op, l}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UList{op}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UList{op}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}), Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, live0_ent(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.upd.v(R.UList{op}, 0n, _))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}
  %put_db(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.lwrite(op, False{}, l0)) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}
  %Equal.sym(R.Change, ch_of(R.lwrite(op, False{}, l0)), R.CList{op, l}, gl) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}
  {==}

def list_replay_g(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.LWrite, +l: KV.Deq, +l0: KV.Deq, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{KV.VColl{KV.CList{l0}}, e}} : Maybe<&2, KV.Item<KV.Val>>}, g: {ch_of(R.lwrite(op, False{}, l0)) == R.CList{op, l} : R.Change} & GoodLOp(op)) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CList{op, l}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}:
  (gl, go) = g
  list_replay(t, k, n, x, now, rr, r, op, l, l0, e, eq, gl)

def list_replay_v(w: KV.Val, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.LWrite, +l: KV.Deq, +e: Nat) -> {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>} -> GoodListV(w, op, l) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CList{op, l}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}:
  match w:
    case KV.VColl{KV.CList{+l0}}:
      eq => g => list_replay_g(t, k, n, x, now, rr, r, op, l, l0, e, eq, g)
    case KV.VColl{KV.CHash{h0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CList{op, l}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}, g)
    case KV.VColl{KV.CMems{s0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CList{op, l}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}, g)
    case KV.VColl{KV.CZset{z0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CList{op, l}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}, g)
    case KV.VColl{KV.CStream{z0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CList{op, l}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}, g)
    case KV.VStr{u}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CList{op, l}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CList{op, l}))) : R.Db}, g)

# a new list, made again at time 0: by a push where the trie held no
# entry for the key, by the script of a new list where it held one
def ne_empty(xs: List<&2, String>) -> NeS(xs) -> {List.is_empty(&2, String, xs) == False{} : Bool}:
  match xs:
    case Nil{}:
      ne => Empty.absurd({List.is_empty(&2, String, Nil{}) == False{} : Bool}, ne)
    case Con{y, rest}:
      ne => {==}

def lnew_push(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +left: Bool, +xs: List<&2, String>, +l: KV.Deq, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == None{} : Maybe<&2, KV.Item<KV.Val>>}, gn: {KV.deq.pushes(left, xs, KV.deq.empty()) == l : KV.Deq}, ne: {List.is_empty(&2, String, xs) == False{} : Bool}) -> {Laws.final(R.exec_all([R.Upd{k, R.UList{R.LWPush{left, xs}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CListNew{left, xs, l}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UList{R.LWPush{left, xs}}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CListNew{left, xs, l}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), None{}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UList{R.LWPush{left, xs}}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CListNew{left, xs, l}))) : R.Db}
  %Equal.sym(Bool, List.is_empty(&2, String, xs), False{}, ne) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 0n, R.lpush.of(_, True{}, left, xs, False{}, KV.deq.empty()))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CListNew{left, xs, l}))) : R.Db}
  %gn : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 0n, R.lpush.of(False{}, True{}, left, xs, False{}, KV.deq.empty()))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CListNew{left, xs, _}))) : R.Db}
  {==}

# the script's write, of a key that holds w: a new list of the pushes
def lnew_v(w: KV.Val, +left: Bool, +xs: List<&2, String>, +e: Nat) -> {R.lnew.of(List.is_empty(&2, String, xs), left, xs) == R.upd.v(R.UList{R.LWNew{left, xs}}, 0n, Some{KV.Item{w, e}}) : R.Out}:
  match w:
    case KV.VStr{u}:
      {==}
    case KV.VColl{KV.CHash{h0}}:
      {==}
    case KV.VColl{KV.CList{l0}}:
      {==}
    case KV.VColl{KV.CMems{s0}}:
      {==}
    case KV.VColl{KV.CZset{z0}}:
      {==}
    case KV.VColl{KV.CStream{z0}}:
      {==}

def lnew_eval(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +left: Bool, +xs: List<&2, String>, +l: KV.Deq, +w: KV.Val, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>}, gn: {KV.deq.pushes(left, xs, KV.deq.empty()) == l : KV.Deq}, ne: {List.is_empty(&2, String, xs) == False{} : Bool}) -> {Laws.final(R.exec_all([R.Upd{k, R.UList{R.LWNew{left, xs}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CListNew{left, xs, l}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UList{R.LWNew{left, xs}}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CListNew{left, xs, l}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), Some{KV.Item{w, e}}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UList{R.LWNew{left, xs}}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CListNew{left, xs, l}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, Some{KV.Item{w, e}}), Some{KV.Item{w, e}}, live0_ent(Some{KV.Item{w, e}})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.upd.v(R.UList{R.LWNew{left, xs}}, 0n, _))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CListNew{left, xs, l}))) : R.Db}
  %lnew_v(w, left, xs, e) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CListNew{left, xs, l}))) : R.Db}
  %Equal.sym(Bool, List.is_empty(&2, String, xs), False{}, ne) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.lnew.of(_, left, xs))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CListNew{left, xs, l}))) : R.Db}
  %gn : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.lnew.of(False{}, left, xs))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CListNew{left, xs, _}))) : R.Db}
  {==}

def lnew_push_g(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +left: Bool, +xs: List<&2, String>, +l: KV.Deq, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == None{} : Maybe<&2, KV.Item<KV.Val>>}, g: GoodNewL(left, xs, l)) -> {Laws.final(R.exec_all([R.Upd{k, R.UList{R.LWPush{left, xs}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CListNew{left, xs, l}))) : R.Db}:
  (gn, ne) = g
  lnew_push(t, k, n, x, now, rr, r, left, xs, l, eq, gn, ne_empty(xs)(ne))

def lnew_eval_g(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +left: Bool, +xs: List<&2, String>, +l: KV.Deq, +w: KV.Val, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>}, g: GoodNewL(left, xs, l)) -> {Laws.final(R.exec_all([R.Upd{k, R.UList{R.LWNew{left, xs}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CListNew{left, xs, l}))) : R.Db}:
  (gn, ne) = g
  lnew_eval(t, k, n, x, now, rr, r, left, xs, l, w, e, eq, gn, ne_empty(xs)(ne))

def lnew_replay(m: Maybe<&2, KV.Item<KV.Val>>, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +left: Bool, +xs: List<&2, String>, +l: KV.Deq) -> {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>} -> GoodNewL(left, xs, l) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(m), R.CListNew{left, xs, l}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CListNew{left, xs, l}))) : R.Db}:
  match m:
    case Some{KV.Item{+w, +e}}:
      eq => g => lnew_eval_g(t, k, n, x, now, rr, r, left, xs, l, w, e, eq, g)
    case None{}:
      eq => g => lnew_push_g(t, k, n, x, now, rr, r, left, xs, l, eq, g)

# a set changed, made again by its write (SADD or SREM) at time 0
def mems_replay(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.SWrite, +sv: KV.Mems, +s0: KV.Mems, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}} : Maybe<&2, KV.Item<KV.Val>>}, gs: {ch_of(R.swrite(op, False{}, s0)) == R.CMems{op, sv} : R.Change}) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CMems{op, sv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UMems{op}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}
  %db_upd_eq(t, k, n, x, 0n, rr, R.UMems{op}) : {R.db_of(_) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UMems{op}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}), Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}, live0_ent(Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.upd.v(R.UMems{op}, 0n, _))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}
  %put_db(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.swrite(op, False{}, s0)) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}
  %Equal.sym(R.Change, ch_of(R.swrite(op, False{}, s0)), R.CMems{op, sv}, gs) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}
  {==}

def mems_replay_g(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.SWrite, +sv: KV.Mems, +s0: KV.Mems, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}} : Maybe<&2, KV.Item<KV.Val>>}, g: {ch_of(R.swrite(op, False{}, s0)) == R.CMems{op, sv} : R.Change} & GoodSOp(op)) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CMems{op, sv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}:
  (gs, go) = g
  mems_replay(t, k, n, x, now, rr, r, op, sv, s0, e, eq, gs)

def mems_replay_v(w: KV.Val, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.SWrite, +sv: KV.Mems, +e: Nat) -> {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>} -> GoodMemsV(w, op, sv) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CMems{op, sv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}:
  match w:
    case KV.VColl{KV.CMems{+s0}}:
      eq => g => mems_replay_g(t, k, n, x, now, rr, r, op, sv, s0, e, eq, g)
    case KV.VColl{KV.CZset{z0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CMems{op, sv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}, g)
    case KV.VColl{KV.CStream{z0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CMems{op, sv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}, g)
    case KV.VColl{KV.CHash{h0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CMems{op, sv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}, g)
    case KV.VColl{KV.CList{l0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CMems{op, sv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}, g)
    case KV.VStr{u}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CMems{op, sv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMems{op, sv}))) : R.Db}, g)

# a new set, made again at time 0: by an SADD where the trie held no
# entry for the key, by the script of a new set where it held one
def snew_sadd(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +ms: List<&2, String>, +sv: KV.Mems, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == None{} : Maybe<&2, KV.Item<KV.Val>>}, gn: {KV.mems.of(ms) == sv : KV.Mems}, ne: {List.is_empty(&2, String, ms) == False{} : Bool}) -> {Laws.final(R.exec_all([R.Upd{k, R.UMems{R.SWAdd{ms}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CMemsNew{ms, sv}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UMems{R.SWAdd{ms}}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CMemsNew{ms, sv}))) : R.Db}
  %db_upd_eq(t, k, n, x, 0n, rr, R.UMems{R.SWAdd{ms}}) : {R.db_of(_) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CMemsNew{ms, sv}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), None{}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UMems{R.SWAdd{ms}}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CMemsNew{ms, sv}))) : R.Db}
  %Equal.sym(Bool, List.is_empty(&2, String, ms), False{}, ne) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 0n, R.sadd.of(_, True{}, ms, KV.mems.adds(ms, KV.mems.empty()), Nat.sub(KV.mems.len(KV.mems.adds(ms, KV.mems.empty())), 0n)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CMemsNew{ms, sv}))) : R.Db}
  %gn : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 0n, R.sadd.of(False{}, True{}, ms, KV.mems.adds(ms, KV.mems.empty()), Nat.sub(KV.mems.len(KV.mems.adds(ms, KV.mems.empty())), 0n)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CMemsNew{ms, _}))) : R.Db}
  {==}

# the script's write, of a key that holds w: a new set of the members
def snew_v(w: KV.Val, +ms: List<&2, String>, +e: Nat) -> {R.snew.of(List.is_empty(&2, String, ms), ms) == R.upd.v(R.UMems{R.SWNew{ms}}, 0n, Some{KV.Item{w, e}}) : R.Out}:
  match w:
    case KV.VStr{u}:
      {==}
    case KV.VColl{KV.CHash{h0}}:
      {==}
    case KV.VColl{KV.CList{l0}}:
      {==}
    case KV.VColl{KV.CMems{s0}}:
      {==}
    case KV.VColl{KV.CZset{z0}}:
      {==}
    case KV.VColl{KV.CStream{z0}}:
      {==}

def snew_eval(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +ms: List<&2, String>, +sv: KV.Mems, +w: KV.Val, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>}, gn: {KV.mems.of(ms) == sv : KV.Mems}, ne: {List.is_empty(&2, String, ms) == False{} : Bool}) -> {Laws.final(R.exec_all([R.Upd{k, R.UMems{R.SWNew{ms}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMemsNew{ms, sv}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UMems{R.SWNew{ms}}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMemsNew{ms, sv}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), Some{KV.Item{w, e}}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UMems{R.SWNew{ms}}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMemsNew{ms, sv}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, Some{KV.Item{w, e}}), Some{KV.Item{w, e}}, live0_ent(Some{KV.Item{w, e}})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.upd.v(R.UMems{R.SWNew{ms}}, 0n, _))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMemsNew{ms, sv}))) : R.Db}
  %snew_v(w, ms, e) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMemsNew{ms, sv}))) : R.Db}
  %Equal.sym(Bool, List.is_empty(&2, String, ms), False{}, ne) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.snew.of(_, ms))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMemsNew{ms, sv}))) : R.Db}
  %gn : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.snew.of(False{}, ms))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMemsNew{ms, _}))) : R.Db}
  {==}

def snew_sadd_g(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +ms: List<&2, String>, +sv: KV.Mems, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == None{} : Maybe<&2, KV.Item<KV.Val>>}, g: GoodNewM(ms, sv)) -> {Laws.final(R.exec_all([R.Upd{k, R.UMems{R.SWAdd{ms}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CMemsNew{ms, sv}))) : R.Db}:
  (gn, ne) = g
  snew_sadd(t, k, n, x, now, rr, r, ms, sv, eq, gn, ne_empty(ms)(ne))

def snew_eval_g(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +ms: List<&2, String>, +sv: KV.Mems, +w: KV.Val, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>}, g: GoodNewM(ms, sv)) -> {Laws.final(R.exec_all([R.Upd{k, R.UMems{R.SWNew{ms}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CMemsNew{ms, sv}))) : R.Db}:
  (gn, ne) = g
  snew_eval(t, k, n, x, now, rr, r, ms, sv, w, e, eq, gn, ne_empty(ms)(ne))

def snew_replay(m: Maybe<&2, KV.Item<KV.Val>>, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +ms: List<&2, String>, +sv: KV.Mems) -> {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>} -> GoodNewM(ms, sv) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(m), R.CMemsNew{ms, sv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CMemsNew{ms, sv}))) : R.Db}:
  match m:
    case Some{KV.Item{+w, +e}}:
      eq => g => snew_eval_g(t, k, n, x, now, rr, r, ms, sv, w, e, eq, g)
    case None{}:
      eq => g => snew_sadd_g(t, k, n, x, now, rr, r, ms, sv, eq, g)

# a sorted set changed, made again by its write at time 0
def zset_replay(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.ZWrite, +z: KV.Zset, +z0: KV.Zset, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}} : Maybe<&2, KV.Item<KV.Val>>}, gz: {ch_of(R.zwrite(op, False{}, z0)) == R.CZset{op, z} : R.Change}) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CZset{op, z}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UZset{op}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UZset{op}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}), Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, live0_ent(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.upd.v(R.UZset{op}, 0n, _))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}
  %put_db(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.zwrite(op, False{}, z0)) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}
  %Equal.sym(R.Change, ch_of(R.zwrite(op, False{}, z0)), R.CZset{op, z}, gz) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}
  {==}

def zset_replay_g(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.ZWrite, +z: KV.Zset, +z0: KV.Zset, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}} : Maybe<&2, KV.Item<KV.Val>>}, g: {ch_of(R.zwrite(op, False{}, z0)) == R.CZset{op, z} : R.Change} & GoodZOp(op)) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CZset{op, z}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}:
  (gz, go) = g
  zset_replay(t, k, n, x, now, rr, r, op, z, z0, e, eq, gz)

def zset_replay_v(w: KV.Val, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +op: R.ZWrite, +z: KV.Zset, +e: Nat) -> {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>} -> GoodZsetV(w, op, z) -> {Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CZset{op, z}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}:
  match w:
    case KV.VColl{KV.CZset{+z0}}:
      eq => g => zset_replay_g(t, k, n, x, now, rr, r, op, z, z0, e, eq, g)
    case KV.VColl{KV.CHash{h0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CZset{op, z}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}, g)
    case KV.VColl{KV.CList{l0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CZset{op, z}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}, g)
    case KV.VColl{KV.CMems{s0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CZset{op, z}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}, g)
    case KV.VColl{KV.CStream{s0}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CZset{op, z}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}, g)
    case KV.VStr{u}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, 1n+e, R.CZset{op, z}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZset{op, z}))) : R.Db}, g)

# a new sorted set, made again at time 0: by its ZADD where the trie held
# no entry for the key, by the script of a new sorted set where it held
# one, whatever the entry held
def znew_ch(o: R.Out) -> {ch_of(o) == ch_of(R.znew.out(o)) : R.Change}:
  match o:
    case R.Out{r, ch}:
      {==}

def znew_v(w: KV.Val, +o: R.ZOpts, +ps: List<&2, R.ZPair>, +e: Nat) -> {R.znew.out(R.zadd.out(True{}, o, ps, KV.zset.empty())) == R.upd.v(R.UZset{R.ZWNew{o, ps}}, 0n, Some{KV.Item{w, e}}) : R.Out}:
  match w:
    case KV.VStr{u}:
      {==}
    case KV.VColl{KV.CHash{h0}}:
      {==}
    case KV.VColl{KV.CList{l0}}:
      {==}
    case KV.VColl{KV.CMems{s0}}:
      {==}
    case KV.VColl{KV.CStream{s0}}:
      {==}
    case KV.VColl{KV.CZset{z0}}:
      {==}

def znew_zadd(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +o: R.ZOpts, +ps: List<&2, R.ZPair>, +z: KV.Zset, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == None{} : Maybe<&2, KV.Item<KV.Val>>}, gn: {ch_of(R.zadd.out(True{}, o, ps, KV.zset.empty())) == R.CZsetNew{o, ps, z} : R.Change}) -> {Laws.final(R.exec_all([R.Upd{k, R.UZset{R.ZWAdd{o, ps}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CZsetNew{o, ps, z}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UZset{R.ZWAdd{o, ps}}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CZsetNew{o, ps, z}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), None{}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UZset{R.ZWAdd{o, ps}}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CZsetNew{o, ps, z}))) : R.Db}
  %put_db(t, k, KV.hash(k), n, x, 0n, rr, 0n, R.zadd.out(True{}, o, ps, KV.zset.empty())) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CZsetNew{o, ps, z}))) : R.Db}
  %Equal.sym(R.Change, ch_of(R.zadd.out(True{}, o, ps, KV.zset.empty())), R.CZsetNew{o, ps, z}, gn) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, 0n, R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CZsetNew{o, ps, z}))) : R.Db}
  {==}

def znew_eval(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +o: R.ZOpts, +ps: List<&2, R.ZPair>, +z: KV.Zset, +w: KV.Val, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>}, gn: {ch_of(R.zadd.out(True{}, o, ps, KV.zset.empty())) == R.CZsetNew{o, ps, z} : R.Change}) -> {Laws.final(R.exec_all([R.Upd{k, R.UZset{R.ZWNew{o, ps}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZsetNew{o, ps, z}))) : R.Db}:
  %fin_cons(R.Upd{k, R.UZset{R.ZWNew{o, ps}}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZsetNew{o, ps, z}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), Some{KV.Item{w, e}}, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.upd.v(R.UZset{R.ZWNew{o, ps}}, 0n, R.ent.live(0n, _)))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZsetNew{o, ps, z}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, Some{KV.Item{w, e}}), Some{KV.Item{w, e}}, live0_ent(Some{KV.Item{w, e}})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.upd.v(R.UZset{R.ZWNew{o, ps}}, 0n, _))) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZsetNew{o, ps, z}))) : R.Db}
  %znew_v(w, o, ps, e) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZsetNew{o, ps, z}))) : R.Db}
  %put_db(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.znew.out(R.zadd.out(True{}, o, ps, KV.zset.empty()))) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZsetNew{o, ps, z}))) : R.Db}
  %znew_ch(R.zadd.out(True{}, o, ps, KV.zset.empty())) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZsetNew{o, ps, z}))) : R.Db}
  %Equal.sym(R.Change, ch_of(R.zadd.out(True{}, o, ps, KV.zset.empty())), R.CZsetNew{o, ps, z}, gn) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, 1n+e, R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZsetNew{o, ps, z}))) : R.Db}
  {==}

def znew_zadd_g(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +o: R.ZOpts, +ps: List<&2, R.ZPair>, +z: KV.Zset, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == None{} : Maybe<&2, KV.Item<KV.Val>>}, g: GoodNewZ(o, ps, z)) -> {Laws.final(R.exec_all([R.Upd{k, R.UZset{R.ZWAdd{o, ps}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 0n, r, R.CZsetNew{o, ps, z}))) : R.Db}:
  (gn, gr) = g
  znew_zadd(t, k, n, x, now, rr, r, o, ps, z, eq, gn)

def znew_eval_g(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +o: R.ZOpts, +ps: List<&2, R.ZPair>, +z: KV.Zset, +w: KV.Val, +e: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == Some{KV.Item{w, e}} : Maybe<&2, KV.Item<KV.Val>>}, g: GoodNewZ(o, ps, z)) -> {Laws.final(R.exec_all([R.Upd{k, R.UZset{R.ZWNew{o, ps}}}], R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, 1n+e, r, R.CZsetNew{o, ps, z}))) : R.Db}:
  (gn, gr) = g
  znew_eval(t, k, n, x, now, rr, r, o, ps, z, w, e, eq, gn)

def znew_replay(m: Maybe<&2, KV.Item<KV.Val>>, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +o: R.ZOpts, +ps: List<&2, R.ZPair>, +z: KV.Zset) -> {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>} -> GoodNewZ(o, ps, z) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(m), R.CZsetNew{o, ps, z}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CZsetNew{o, ps, z}))) : R.Db}:
  match m:
    case Some{KV.Item{+w, +e}}:
      eq => g => znew_eval_g(t, k, n, x, now, rr, r, o, ps, z, w, e, eq, g)
    case None{}:
      eq => g => znew_zadd_g(t, k, n, x, now, rr, r, o, ps, z, eq, g)

# RESTORE's change, made again by its effect at time 0: the RESTORE of
# its payload with REPLACE (rs_out0, rs_out1: whose version, checksum
# and value read, so that it restores the payload's value, with the time
# logged, from 1970)
def rs_out0(live: Bool, +p: String, +v: KV.Val, gv: {D.verify(p) == True{} : Bool}, gd: {D.load(p) == Some{v} : Maybe<&2, KV.Val>}) -> {R.restore.live(live, p, R.TOk{R.TmN{False{}, 0n}}, True{}, 0n) == R.Out{R.r_ok(), R.CRestore{p, v, 0n}} : R.Out}:
  %Equal.sym(Bool, D.verify(p), True{}, gv) : {R.restore.check(_, p, R.TmN{False{}, 0n}, live, 0n) == R.Out{R.r_ok(), R.CRestore{p, v, 0n}} : R.Out}
  %Equal.sym(Maybe<&2, KV.Val>, D.load(p), Some{v}, gd) : {R.restore.load(_, p, R.TmN{False{}, 0n}, live, 0n) == R.Out{R.r_ok(), R.CRestore{p, v, 0n}} : R.Out}
  {==}

def rs_out1(live: Bool, +p: String, +v: KV.Val, +q: Nat, gv: {D.verify(p) == True{} : Bool}, gd: {D.load(p) == Some{v} : Maybe<&2, KV.Val>}, +fx: {KV.clamp(1n+q) == 1n+q : Nat}) -> {R.restore.live(live, p, R.TOk{R.TmN{True{}, 1n+q}}, True{}, 0n) == R.Out{R.r_ok(), R.CRestore{p, v, 1n+q}} : R.Out}:
  %Equal.sym(Bool, D.verify(p), True{}, gv) : {R.restore.check(_, p, R.TmN{True{}, 1n+q}, live, 0n) == R.Out{R.r_ok(), R.CRestore{p, v, 1n+q}} : R.Out}
  %Equal.sym(Maybe<&2, KV.Val>, D.load(p), Some{v}, gd) : {R.restore.load(_, p, R.TmN{True{}, 1n+q}, live, 0n) == R.Out{R.r_ok(), R.CRestore{p, v, 1n+q}} : R.Out}
  %Equal.sym(R.At, R.at.ms(1n+q), R.AtMs{1n+q}, ms_fixed(q, fx)) : {R.restore.at(Some{_}, p, v, live, 0n) == R.Out{R.r_ok(), R.CRestore{p, v, 1n+q}} : R.Out}
  %Equal.sym(Nat, R.at.exp(R.AtMs{1n+q}), 1n+q, exp_ms(q)) : {R.Out{R.r_ok(), R.CRestore{p, v, KV.clamp(_)}} == R.Out{R.r_ok(), R.CRestore{p, v, 1n+q}} : R.Out}
  %Equal.sym(Nat, KV.clamp(1n+q), 1n+q, fx) : {R.Out{R.r_ok(), R.CRestore{p, v, _}} == R.Out{R.r_ok(), R.CRestore{p, v, 1n+q}} : R.Out}
  {==}

def rs0_replay(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +p: String, +v: KV.Val, +m: Maybe<&2, KV.Item<KV.Val>>, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>}, gv: {D.verify(p) == True{} : Bool}, gd: {D.load(p) == Some{v} : Maybe<&2, KV.Val>}) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(m), R.CRestore{p, v, 0n}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 0n}))) : R.Db}:
  %fin_cons(R.Upd{k, R.URestore{p, R.TOk{R.TmN{False{}, 0n}}, True{}, 0n}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 0n}))) : R.Db}
  %Equal.sym(R.Out, R.upd.v(R.URestore{p, R.TOk{R.TmN{False{}, 0n}}, True{}, 0n}, 0n, R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k)))), R.upd(R.URestore{p, R.TOk{R.TmN{False{}, 0n}}, True{}, 0n}, 0n, sv_ent(R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k))))), any_ent(R.URestore{p, R.TOk{R.TmN{False{}, 0n}}, True{}, 0n}, 0n, R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k))))({==})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 0n}))) : R.Db}
  %Equal.sym(R.Out, R.restore.live(Maybe.is_some(&2, KV.Item<String>, sv_ent(R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k))))), p, R.TOk{R.TmN{False{}, 0n}}, True{}, 0n), R.Out{R.r_ok(), R.CRestore{p, v, 0n}}, rs_out0(Maybe.is_some(&2, KV.Item<String>, sv_ent(R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k))))), p, v, gv, gd)) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 0n}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), m, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.Out{R.r_ok(), R.CRestore{p, v, 0n}})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 0n}))) : R.Db}
  {==}

def rsp_replay(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +p: String, +v: KV.Val, +m: Maybe<&2, KV.Item<KV.Val>>, +q: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>}, gv: {D.verify(p) == True{} : Bool}, gd: {D.load(p) == Some{v} : Maybe<&2, KV.Val>}, fx: {KV.clamp(1n+q) == 1n+q : Nat}) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(m), R.CRestore{p, v, 1n+q}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 1n+q}))) : R.Db}:
  %fin_cons(R.Upd{k, R.URestore{p, R.TOk{R.TmN{True{}, 1n+q}}, True{}, 0n}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 1n+q}))) : R.Db}
  %Equal.sym(R.Out, R.upd.v(R.URestore{p, R.TOk{R.TmN{True{}, 1n+q}}, True{}, 0n}, 0n, R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k)))), R.upd(R.URestore{p, R.TOk{R.TmN{True{}, 1n+q}}, True{}, 0n}, 0n, sv_ent(R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k))))), any_ent(R.URestore{p, R.TOk{R.TmN{True{}, 1n+q}}, True{}, 0n}, 0n, R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k))))({==})) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 1n+q}))) : R.Db}
  %Equal.sym(R.Out, R.restore.live(Maybe.is_some(&2, KV.Item<String>, sv_ent(R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k))))), p, R.TOk{R.TmN{True{}, 1n+q}}, True{}, 0n), R.Out{R.r_ok(), R.CRestore{p, v, 1n+q}}, rs_out1(Maybe.is_some(&2, KV.Item<String>, sv_ent(R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k))))), p, v, q, gv, gd, fx)) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 1n+q}))) : R.Db}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), m, eq) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(_), R.Out{R.r_ok(), R.CRestore{p, v, 1n+q}})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 1n+q}))) : R.Db}
  {==}

def rs0_go(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +p: String, +v: KV.Val, +m: Maybe<&2, KV.Item<KV.Val>>, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>}, g: Good(m, R.CRestore{p, v, 0n})) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(m), R.CRestore{p, v, 0n}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 0n}))) : R.Db}:
  (gv, gr) = g
  (gd, fx) = gr
  rs0_replay(t, k, n, x, now, rr, r, p, v, m, eq, gv, gd)

def rsp_go(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +p: String, +v: KV.Val, +m: Maybe<&2, KV.Item<KV.Val>>, +q: Nat, eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>}, g: Good(m, R.CRestore{p, v, 1n+q})) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(m), R.CRestore{p, v, 1n+q}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, 1n+q}))) : R.Db}:
  (gv, gr) = g
  (gd, fx) = gr
  rsp_replay(t, k, n, x, now, rr, r, p, v, m, q, eq, gv, gd, fx)

def restore_replay(f: Nat, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply, +p: String, +v: KV.Val, +m: Maybe<&2, KV.Item<KV.Val>>, +eq: {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>}) -> Good(m, R.CRestore{p, v, f}) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(m), R.CRestore{p, v, f}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, R.CRestore{p, v, f}))) : R.Db}:
  match f:
    case 0n:
      g => rs0_go(t, k, n, x, now, rr, r, p, v, m, eq, g)
    case 1n++q:
      g => rsp_go(t, k, n, x, now, rr, r, p, v, m, q, eq, g)

def ch_replay(ch: R.Change, m: Maybe<&2, KV.Item<KV.Val>>, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +r: R.Reply) -> {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>} -> Good(m, ch) -> {Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(m), ch), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), r, ch))) : R.Db}:
  match ch m:
    case R.CKeep{} _:
      eq => g => {==}
    case R.CDel{} Some{KV.Item{w, +e}}:
      eq => g => del_replay(t, k, n, x, now, rr, r, w, e, eq)
    case R.CDel{} None{}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(None{}), R.CDel{}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CDel{}))) : R.Db}, false_true(g))
    case R.CExp{f} Some{KV.Item{w, +e}}:
      eq => g => exp_replay(f, t, k, n, x, now, rr, r, w, e, eq)(g)
    case R.CExp{f} None{}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(None{}), R.CExp{f}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CExp{f}))) : R.Db}, g)
    case R.CPut{v, f} _:
      +eq => fx => put_replay(f, t, k, n, x, now, rr, r, v, m, eq)(fx)
    case R.CKeepT{v} Some{KV.Item{w, e}}:
      eq => g => keept_replay(t, k, n, x, now, rr, r, v, w, e, eq)
    case R.CKeepT{v} None{}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(None{}), R.CKeepT{v}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CKeepT{v}))) : R.Db}, false_true(g))
    case R.CApp{s, v} Some{KV.Item{KV.VStr{w}, e}}:
      eq => g => app_replay(t, k, n, x, now, rr, r, s, v, w, e, eq, g)
    case R.CApp{s, v} Some{KV.Item{KV.VColl{c}, e}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(Some{KV.Item{KV.VColl{c}, e}}), R.CApp{s, v}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VColl{c}, e}}), r, R.CApp{s, v}))) : R.Db}, g)
    case R.CApp{s, v} None{}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(None{}), R.CApp{s, v}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CApp{s, v}))) : R.Db}, g)
    case R.CRange{o, s, v} Some{KV.Item{KV.VStr{w}, e}}:
      eq => g => range_go(t, k, n, x, now, rr, r, o, s, v, w, e, eq, g)
    case R.CRange{o, s, v} Some{KV.Item{KV.VColl{c}, e}}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(Some{KV.Item{KV.VColl{c}, e}}), R.CRange{o, s, v}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(Some{KV.Item{KV.VColl{c}, e}}), r, R.CRange{o, s, v}))) : R.Db}, g)
    case R.CRange{o, s, v} None{}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(None{}), R.CRange{o, s, v}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CRange{o, s, v}))) : R.Db}, g)
    case R.CHash{+op, +hv} Some{KV.Item{w, +e}}:
      eq => g => hash_replay_v(w, t, k, n, x, now, rr, r, op, hv, e)(eq)(g)
    case R.CHash{op, hv} None{}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(None{}), R.CHash{op, hv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CHash{op, hv}))) : R.Db}, g)
    case R.CHashNew{+ps, +hv} _:
      eq => g => hnew_replay(m, t, k, n, x, now, rr, r, ps, hv)(eq)(g)
    case R.CList{+op, +l} Some{KV.Item{w, +e}}:
      eq => g => list_replay_v(w, t, k, n, x, now, rr, r, op, l, e)(eq)(g)
    case R.CList{op, l} None{}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(None{}), R.CList{op, l}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CList{op, l}))) : R.Db}, g)
    case R.CListNew{+left, +xs, +l} _:
      eq => g => lnew_replay(m, t, k, n, x, now, rr, r, left, xs, l)(eq)(g)
    case R.CMems{+op, +sv} Some{KV.Item{w, +e}}:
      eq => g => mems_replay_v(w, t, k, n, x, now, rr, r, op, sv, e)(eq)(g)
    case R.CMems{op, sv} None{}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(None{}), R.CMems{op, sv}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CMems{op, sv}))) : R.Db}, g)
    case R.CMemsNew{+ms, +sv} _:
      eq => g => snew_replay(m, t, k, n, x, now, rr, r, ms, sv)(eq)(g)
    case R.CZset{+op, +z} Some{KV.Item{w, +e}}:
      eq => g => zset_replay_v(w, t, k, n, x, now, rr, r, op, z, e)(eq)(g)
    case R.CZset{op, z} None{}:
      eq => g => Empty.absurd({Laws.final(R.exec_all(A.ch.effect(k, R.ent.code(None{}), R.CZset{op, z}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(None{}), r, R.CZset{op, z}))) : R.Db}, g)
    case R.CZsetNew{+o, +ps, +z} _:
      eq => g => znew_replay(m, t, k, n, x, now, rr, r, o, ps, z)(eq)(g)
    case R.CRestore{+p, +v, f} _:
      +eq => g => restore_replay(f, t, k, n, x, now, rr, r, p, v, m, eq)(g)

# an update's effects make its change again
def out_replay(o: R.Out, +m: Maybe<&2, KV.Item<KV.Val>>, +t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {KV.entry.at(KV.Val, t, k, KV.hash(k)) == m : Maybe<&2, KV.Item<KV.Val>>} -> Good(m, ch_of(o)) -> {Laws.final(R.exec_all(A.upd.effect(k, R.ent.code(m), o), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(m), o))) : R.Db}:
  match o:
    case R.Out{+r, ch}:
      ch_replay(ch, m, t, k, n, x, now, rr, r)

# The change an update makes is a good one
# ----------------------------------------

def get_ch(+old: R.Reply, o: R.Out) -> {ch_of(R.get.out(old, o)) == ch_of(o) : R.Change}:
  match o:
    case R.Out{+r, ch}:
      {==}

# SET's change, under its conditions
def setdo_good(b: Bool, -m: Maybe<&2, KV.Item<KV.Val>>, -ch: R.Change, g: Good(m, ch)) -> Good(m, ch_of(Bool.pick(R.Out, b, R.Out{R.RNull{}, R.CKeep{}}, R.Out{R.r_ok(), ch}))):
  match b:
    case True{}:
      {==}
    case False{}:
      g

def setat_good(a: Maybe<&2, R.At>, +cond: Nat, +v: String, +name: String, +l: Maybe<&2, KV.Item<String>>, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.set.at(cond, v, name, a, l))):
  match a:
    case Some{+tt}:
      setdo_good(Bool.or(Bool.and(Nat.is_eq(cond, 1n), Maybe.is_some(&2, KV.Item<String>, l)), Bool.and(Nat.is_eq(cond, 2n), Bool.not(Maybe.is_some(&2, KV.Item<String>, l)))), m, R.CPut{v, KV.clamp(R.at.exp(tt))}, clamp_idem(R.at.exp(tt)))
    case None{}:
      {==}

def uset_none(ttl: R.SetTtl, +v: String, +cond: Nat, +name: String, +now: Nat, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.set.of(v, cond, ttl, name, now, None{}))):
  match ttl:
    case R.TNone{}:
      setdo_good(Bool.or(Bool.and(Nat.is_eq(cond, 1n), Maybe.is_some(&2, KV.Item<String>, None{})), Bool.and(Nat.is_eq(cond, 2n), Bool.not(Maybe.is_some(&2, KV.Item<String>, None{})))), m, R.CPut{v, 0n}, {==})
    case R.TKeep{}:
      setdo_good(Bool.or(Bool.and(Nat.is_eq(cond, 1n), Maybe.is_some(&2, KV.Item<String>, None{})), Bool.and(Nat.is_eq(cond, 2n), Bool.not(Maybe.is_some(&2, KV.Item<String>, None{})))), m, R.CPut{v, 0n}, {==})
    case R.TAt{+tt}:
      setat_good(R.at.of(tt, now), cond, v, name, None{}, m)

def uset_some(ttl: R.SetTtl, +v: String, +cond: Nat, +name: String, +now: Nat, +w: String, -y: KV.Val, +e: Nat) -> Good(Some{KV.Item{y, e}}, ch_of(R.set.of(v, cond, ttl, name, now, Some{KV.Item{w, e}}))):
  match ttl:
    case R.TNone{}:
      setdo_good(Bool.or(Bool.and(Nat.is_eq(cond, 1n), Maybe.is_some(&2, KV.Item<String>, Some{KV.Item{w, e}})), Bool.and(Nat.is_eq(cond, 2n), Bool.not(Maybe.is_some(&2, KV.Item<String>, Some{KV.Item{w, e}})))), Some{KV.Item{y, e}}, R.CPut{v, 0n}, {==})
    case R.TKeep{}:
      setdo_good(Bool.or(Bool.and(Nat.is_eq(cond, 1n), Maybe.is_some(&2, KV.Item<String>, Some{KV.Item{w, e}})), Bool.and(Nat.is_eq(cond, 2n), Bool.not(Maybe.is_some(&2, KV.Item<String>, Some{KV.Item{w, e}})))), Some{KV.Item{y, e}}, R.CKeepT{v}, {==})
    case R.TAt{+tt}:
      setat_good(R.at.of(tt, now), cond, v, name, Some{KV.Item{w, e}}, Some{KV.Item{y, e}})

def expire_none(a: Maybe<&2, R.At>, c: R.ExpIf, +name: String, +now: Nat, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.expire.at(c, name, now, a, None{}))):
  match a:
    case Some{tt}:
      {==}
    case None{}:
      {==}

def incr_fit_none(s: R.LL, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.uincr.fit(s, False{}))):
  match s:
    case R.LL{+neg, +hi, +lo}:
      {==}
    case R.LLBad{}:
      {==}

# INCRBYFLOAT of a key not there: a put of the sum, with no time, or
# nothing (an error)
def incrf_fin_none(bad: Bool, +s: F.Fl, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.uincrf.fin(bad, s, False{}))):
  match bad:
    case True{}:
      {==}
    case False{}:
      {==}

def incrf_add_none(a: Maybe<&2, F.Fl>, b: Maybe<&2, F.Fl>, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.uincrf.add(a, b, False{}))):
  match a b:
    case Some{+x} Some{+y}:
      incrf_fin_none(Bool.or(F.fl.is_nan(F.fl.add(F.fmt.ld(), x, y)), F.fl.is_inf(F.fl.add(F.fmt.ld(), x, y))), F.fl.add(F.fmt.ld(), x, y), m)
    case Some{x} None{}:
      {==}
    case None{} Some{y}:
      {==}
    case None{} None{}:
      {==}

# SETRANGE, and SETBIT as the SETRANGE of its byte: of a key not there a
# put of a value with no time, of a key there a SETRANGE that changes it
def range_none_good(b: Bool, +o: Nat, +a: String, +em: Bool, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.range.none(b, o, a, em))):
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def range_some_good(b: Bool, +o: Nat, +a: String, +w: String, -e: Nat, +em: Bool) -> {b == R.range.go(o, a) : Bool} -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.range.some(b, o, a, w, em))):
  match b:
    case True{}:
      eb => (Equal.sym(Bool, True{}, R.range.go(o, a), eb), {==})
    case False{}:
      eb => {==}

def setbit_ch(+r: R.Reply, o: R.Out) -> {ch_of(R.setbit.out(r, o)) == ch_of(o) : R.Change}:
  match o:
    case R.Out{x, ch}:
      {==}

def setbit_none(+o: Nat, +on: Bool, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.setbit.of(o, on, None{}))):
  %Equal.sym(R.Change, ch_of(R.setbit.out(R.r_int(0n), R.range.of(Nat.div(o, 8n), R.setbit.byte(o, on, 0), None{}))), ch_of(R.range.of(Nat.div(o, 8n), R.setbit.byte(o, on, 0), None{})), setbit_ch(R.r_int(0n), R.range.of(Nat.div(o, 8n), R.setbit.byte(o, on, 0), None{}))) : Good(m, _)
  range_none_good(R.range.go(Nat.div(o, 8n), R.setbit.byte(o, on, 0)), Nat.div(o, 8n), R.setbit.byte(o, on, 0), String.is_empty(R.setbit.byte(o, on, 0)), m)

def setbit_some_good(b: Bool, +o: Nat, +on: Bool, +w: String, +e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.setbit.some(b, o, on, w, e))):
  match b:
    case True{}:
      {==}
    case False{}:
      %Equal.sym(R.Change, ch_of(R.setbit.out(R.setbit.r(o, w), R.range.of(Nat.div(o, 8n), R.setbit.byte(o, on, R.setbit.x(o, w)), Some{KV.Item{w, e}}))), ch_of(R.range.of(Nat.div(o, 8n), R.setbit.byte(o, on, R.setbit.x(o, w)), Some{KV.Item{w, e}})), setbit_ch(R.setbit.r(o, w), R.range.of(Nat.div(o, 8n), R.setbit.byte(o, on, R.setbit.x(o, w)), Some{KV.Item{w, e}}))) : Good(Some{KV.Item{KV.VStr{w}, e}}, _)
      range_some_good(R.range.go(Nat.div(o, 8n), R.setbit.byte(o, on, R.setbit.x(o, w))), Nat.div(o, 8n), R.setbit.byte(o, on, R.setbit.x(o, w)), w, e, String.is_empty(R.setbit.byte(o, on, R.setbit.x(o, w))))({==})

# BITFIELD: nothing, an error that changes nothing, or the SETRANGE of
# its span (of a key not there a put)
def bf_put_none(ok: Bool, +r: R.Reply, +lo: Nat, +sp: String, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.bf.put(ok, r, lo, sp, None{}))):
  match ok:
    case True{}:
      %Equal.sym(R.Change, ch_of(R.setbit.out(r, R.range.of(lo, sp, None{}))), ch_of(R.range.of(lo, sp, None{})), setbit_ch(r, R.range.of(lo, sp, None{}))) : Good(m, _)
      range_none_good(R.range.go(lo, sp), lo, sp, String.is_empty(sp), m)
    case False{}:
      {==}

def bf_res_none(ch: Bool, +r: R.Reply, +lo: Nat, +sp: String, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.bf.res(ch, r, lo, sp, None{}))):
  match ch:
    case True{}:
      bf_put_none(R.range.go(lo, sp), r, lo, sp, m)
    case False{}:
      {==}

def bf_none(st: R.BfRun, +lo: Nat, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.bf.fin(st, lo, None{}))):
  match st:
    case R.BfRun{+sp, ch, rs}:
      bf_res_none(ch, R.RArray{List.reverse(&2, R.Reply, rs)}, lo, sp, m)

def bf_put_some(ok: Bool, +r: R.Reply, +lo: Nat, +sp: String, +w: String, +e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.bf.put(ok, r, lo, sp, Some{KV.Item{w, e}}))):
  match ok:
    case True{}:
      %Equal.sym(R.Change, ch_of(R.setbit.out(r, R.range.of(lo, sp, Some{KV.Item{w, e}}))), ch_of(R.range.of(lo, sp, Some{KV.Item{w, e}})), setbit_ch(r, R.range.of(lo, sp, Some{KV.Item{w, e}}))) : Good(Some{KV.Item{KV.VStr{w}, e}}, _)
      range_some_good(R.range.go(lo, sp), lo, sp, w, e, String.is_empty(sp))({==})
    case False{}:
      {==}

def bf_res_some(ch: Bool, +r: R.Reply, +lo: Nat, +sp: String, +w: String, +e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.bf.res(ch, r, lo, sp, Some{KV.Item{w, e}}))):
  match ch:
    case True{}:
      bf_put_some(R.range.go(lo, sp), r, lo, sp, w, e)
    case False{}:
      {==}

def bf_some(st: R.BfRun, +lo: Nat, +w: String, +e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.bf.fin(st, lo, Some{KV.Item{w, e}}))):
  match st:
    case R.BfRun{+sp, ch, rs}:
      bf_res_some(ch, R.RArray{List.reverse(&2, R.Reply, rs)}, lo, sp, w, e)

# A write of a hash: a new one's change is good whatever the key's entry
# was (a new hash replaces it); a change of the hash h0 the key held is
# good of that entry
def hw_set_new(ps: List<&2, KV.HPair>, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, R.hset.ch(True{}, ps, hput.h(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n})))):
  match ps:
    case Nil{}:
      {==}
    case Con{p, rest}:
      ({==}, {==})

def hdel_empty(fs: List<&2, String>) -> {R.HDel{KV.hash.empty(), 0n} == R.hdel.go(fs, R.HDel{KV.hash.empty(), 0n}) : R.HDel}:
  match fs:
    case Nil{}:
      {==}
    case Con{f, rest}:
      hdel_empty(rest)

def hincr_new(s: R.LL, +f: String, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.hincr.fit(s, True{}, f, KV.hash.empty()))):
  match s:
    case R.LL{+neg, +hi, +lo}:
      ({==}, {==})
    case R.LLBad{}:
      {==}

# HINCRBYFLOAT of a new hash: the new hash of the field with the sum, or
# nothing
def hincrf_new_fin(bad: Bool, +s: F.Fl, +f: String, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.hincrf.fin(bad, s, True{}, f, KV.hash.empty()))):
  match bad:
    case True{}:
      {==}
    case False{}:
      ({==}, {==})

def hw_new_good(op: R.HWrite, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.hwrite(op, True{}, KV.hash.empty()))):
  match op:
    case R.HWSet{+ps, +mset}:
      %hset_out_ch(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}), True{}, ps, mset) : Good(m, _)
      hw_set_new(ps, m)
    case R.HWSetNx{+f, +v}:
      ({==}, {==})
    case R.HWDel{+fs}:
      %hdel_empty(fs) : Good(m, ch_of(R.hdel.out(_, fs)))
      {==}
    case R.HWIncr{+f, +by}:
      hincr_new(R.by.ll(by), f, m)
    case R.HWNew{+ps}:
      %hnew_out_ch(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}), ps) : Good(m, _)
      hw_set_new(ps, m)
    case R.HWIncrF{+f, +by}:
      hincrf_new_fin(Bool.or(F.fl.is_nan(F.fl.add(F.fmt.ld(), F.fl.zero(False{}), by)), F.fl.is_inf(F.fl.add(F.fmt.ld(), F.fl.zero(False{}), by))), F.fl.add(F.fmt.ld(), F.fl.zero(False{}), by), f, m)

def hw_wrong_good(op: R.HWrite, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.hwrite.wrong(op))):
  match op:
    case R.HWNew{+ps}:
      hw_new_good(R.HWNew{ps}, m)
    case R.HWSet{ps, mset}:
      {==}
    case R.HWSetNx{f, v}:
      {==}
    case R.HWDel{fs}:
      {==}
    case R.HWIncr{f, by}:
      {==}
    case R.HWIncrF{f, by}:
      {==}

def hw_set_old(ps: List<&2, KV.HPair>, +h0: KV.Hash, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, R.hset.ch(False{}, ps, hput.h(R.hset.go(ps, R.HPut{h0, 0n})))):
  match ps:
    case Nil{}:
      {==}
    case Con{+p, +rest}:
      (Equal.sym(R.Change, R.hset.ch(False{}, Con{p, rest}, hput.h(R.hset.go(Con{p, rest}, R.HPut{h0, 0n}))), ch_of(R.hset.out(R.hset.go(Con{p, rest}, R.HPut{h0, 0n}), False{}, Con{p, rest}, False{})), hset_out_ch(R.hset.go(Con{p, rest}, R.HPut{h0, 0n}), False{}, Con{p, rest}, False{})), {==})

def hsetnx_old(had: Bool, +f: String, +v: String, +h0: KV.Hash, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, ch_of(R.hsetnx.of(had, False{}, f, v, h0))):
  match had:
    case True{}:
      {==}
    case False{}:
      ({==}, {==})

def hincr_old_fit(s: R.LL, +f: String, +h0: KV.Hash, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, ch_of(R.hincr.fit(s, False{}, f, h0))):
  match s:
    case R.LL{+neg, +hi, +lo}:
      ({==}, {==})
    case R.LLBad{}:
      {==}

def hincr_old_num(mi: R.LL, +f: String, +by: R.By, +h0: KV.Hash, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, ch_of(R.hincr.num(mi, False{}, f, by, h0))):
  match mi:
    case R.LL{+neg, +hi, +lo}:
      hincr_old_fit(R.ll.add(neg, hi, lo, by), f, h0, e)
    case R.LLBad{}:
      {==}

def hincr_old(cur: Maybe<&2, String>, +f: String, +by: R.By, +h0: KV.Hash, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, ch_of(R.hincr.of(cur, False{}, f, by, h0))):
  match cur:
    case Some{+v}:
      hincr_old_num(R.ll.read(v), f, by, h0, e)
    case None{}:
      hincr_old_fit(R.by.ll(by), f, h0, e)

# HINCRBYFLOAT of a hash the key held: the HSET of the field with the
# sum, or nothing (an error)
def hincrf_old_fin(bad: Bool, +s: F.Fl, +f: String, +h0: KV.Hash, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, ch_of(R.hincrf.fin(bad, s, False{}, f, h0))):
  match bad:
    case True{}:
      {==}
    case False{}:
      ({==}, {==})

def hincrf_old_num(m: Maybe<&2, F.Fl>, +f: String, +by: F.Fl, +h0: KV.Hash, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, ch_of(R.hincrf.num(m, False{}, f, by, h0))):
  match m:
    case Some{+x}:
      hincrf_old_fin(Bool.or(F.fl.is_nan(F.fl.add(F.fmt.ld(), x, by)), F.fl.is_inf(F.fl.add(F.fmt.ld(), x, by))), F.fl.add(F.fmt.ld(), x, by), f, h0, e)
    case None{}:
      {==}

def hincrf_old(cur: Maybe<&2, String>, +f: String, +by: F.Fl, +h0: KV.Hash, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, ch_of(R.hincrf.of(cur, False{}, f, by, h0))):
  match cur:
    case Some{+v}:
      hincrf_old_num(F.ld.parse(v), f, by, h0, e)
    case None{}:
      hincrf_old_num(Some{F.fl.zero(False{})}, f, by, h0, e)

# HDEL of a hash the key held: nothing, the key deleted (its last field
# taken), or the hash without the fields, which HDEL of them makes again
def hdel_of_old(none: Bool, empty: Bool, +f: String, +rest: List<&2, String>, +h: KV.Hash, +gone: Nat, +h0: KV.Hash, -e: Nat, eq: {R.hdel.go(Con{f, rest}, R.HDel{h0, 0n}) == R.HDel{h, gone} : R.HDel}) -> {none == Nat.is_eq(gone, 0n) : Bool} -> {empty == Nat.is_eq(KV.hash.len(h), 0n) : Bool} -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, ch_of(R.hdel.of(none, empty, Con{f, rest}, h, gone))):
  match none empty:
    case True{} _:
      en => ee => {==}
    case False{} True{}:
      en => ee => {==}
    case False{} False{}:
      en => ee =>
        %Equal.sym(R.HDel, R.hdel.go(Con{f, rest}, R.HDel{h0, 0n}), R.HDel{h, gone}, eq) : {ch_of(R.hdel.out(_, Con{f, rest})) == R.CHash{R.HWDel{Con{f, rest}}, h} : R.Change} & {True{} == True{} : Bool}
        %en : {ch_of(R.hdel.of(_, Nat.is_eq(KV.hash.len(h), 0n), Con{f, rest}, h, gone)) == R.CHash{R.HWDel{Con{f, rest}}, h} : R.Change} & {True{} == True{} : Bool}
        %ee : {ch_of(R.hdel.of(False{}, _, Con{f, rest}, h, gone)) == R.CHash{R.HWDel{Con{f, rest}}, h} : R.Change} & {True{} == True{} : Bool}
        ({==}, {==})

def hdel_old_d(d: R.HDel, +f: String, +rest: List<&2, String>, +h0: KV.Hash, -e: Nat) -> {R.hdel.go(Con{f, rest}, R.HDel{h0, 0n}) == d : R.HDel} -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, ch_of(R.hdel.out(d, Con{f, rest}))):
  match d:
    case R.HDel{+h, +gone}:
      eq => hdel_of_old(Nat.is_eq(gone, 0n), Nat.is_eq(KV.hash.len(h), 0n), f, rest, h, gone, h0, e, eq)({==})({==})

def hdel_old(fs: List<&2, String>, +h0: KV.Hash, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, ch_of(R.hdel.out(R.hdel.go(fs, R.HDel{h0, 0n}), fs))):
  match fs:
    case Nil{}:
      {==}
    case Con{+f, +rest}:
      hdel_old_d(R.hdel.go(Con{f, rest}, R.HDel{h0, 0n}), f, rest, h0, e)({==})

def hw_old_good(op: R.HWrite, +h0: KV.Hash, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, ch_of(R.hwrite(op, False{}, h0))):
  match op:
    case R.HWSet{+ps, +mset}:
      %hset_out_ch(R.hset.go(ps, R.HPut{h0, 0n}), False{}, ps, mset) : Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, _)
      hw_set_old(ps, h0, e)
    case R.HWSetNx{+f, +v}:
      hsetnx_old(KV.hash.has(f, h0), f, v, h0, e)
    case R.HWDel{+fs}:
      hdel_old(fs, h0, e)
    case R.HWIncr{+f, +by}:
      hincr_old(KV.hash.get(f, h0), f, by, h0, e)
    case R.HWNew{+ps}:
      %hnew_out_ch(R.hset.go(ps, R.HPut{KV.hash.empty(), 0n}), ps) : Good(Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}}, _)
      hw_set_new(ps, Some{KV.Item{KV.VColl{KV.CHash{h0}}, e}})
    case R.HWIncrF{+f, +by}:
      hincrf_old(KV.hash.get(f, h0), f, by, h0, e)

def good_coll_hash(op: R.HWrite, c: KV.Coll, -e: Nat) -> Good(Some{KV.Item{KV.VColl{c}, e}}, ch_of(R.hwrite.coll(op, c))):
  match c:
    case KV.CHash{+h0}:
      hw_old_good(op, h0, e)
    case KV.CList{+l}:
      hw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CList{l}}, e}})
    case KV.CMems{+sv}:
      hw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CMems{sv}}, e}})
    case KV.CZset{+z}:
      hw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CZset{z}}, e}})
    case KV.CStream{+z}:
      hw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CStream{z}}, e}})

# A write of a list: of a key not there (an empty list made fresh) none
# or a new list; of a key that holds another kind, none, or the new list
# of LWNew
def push_fresh(xs: List<&2, String>, +left: Bool, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.lpush.of(List.is_empty(&2, String, xs), True{}, left, xs, False{}, KV.deq.empty()))):
  match xs:
    case Nil{}:
      {==}
    case Con{+y, +rest}:
      ({==}, {==})

def new_fresh(xs: List<&2, String>, +left: Bool, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.lnew.of(List.is_empty(&2, String, xs), left, xs))):
  match xs:
    case Nil{}:
      {==}
    case Con{+y, +rest}:
      ({==}, {==})

def popn_fresh(mc: Maybe<&2, Nat>, +left: Bool, +c: String, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.lpop.count(mc, True{}, left, c, KV.deq.empty()))):
  match mc:
    case Some{k}:
      {==}
    case None{}:
      {==}

def lw_fresh_good(op: R.LWrite, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.lwrite(op, True{}, KV.deq.empty()))):
  match op:
    case R.LWPush{+left, +xs}:
      push_fresh(xs, left, m)
    case R.LWPushX{left, xs}:
      {==}
    case R.LWPop{left}:
      {==}
    case R.LWPopN{+left, +c}:
      popn_fresh(R.lcount(c), left, c, m)
    case R.LWSet{i, v}:
      {==}
    case R.LWBefore{p, v}:
      {==}
    case R.LWAfter{p, v}:
      {==}
    case R.LWRem{c, v}:
      {==}
    case R.LWTrim{a, b}:
      {==}
    case R.LWNew{+left, +xs}:
      new_fresh(xs, left, m)

def lw_wrong_good(op: R.LWrite, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.lwrite.wrong(op))):
  match op:
    case R.LWNew{+left, +xs}:
      lw_fresh_good(R.LWNew{left, xs}, m)
    case R.LWPush{left, xs}:
      {==}
    case R.LWPushX{left, xs}:
      {==}
    case R.LWPop{left}:
      {==}
    case R.LWPopN{left, c}:
      {==}
    case R.LWSet{i, v}:
      {==}
    case R.LWBefore{p, v}:
      {==}
    case R.LWAfter{p, v}:
      {==}
    case R.LWRem{c, v}:
      {==}
    case R.LWTrim{a, b}:
      {==}

# of a list the key held (l0): none, the key deleted, the list changed by
# the write itself (the write the change keeps is the one made, and one
# the file logs: LShape), or a new list (LWNew)
def LShape(op: R.LWrite, ch: R.Change) -> Type:
  match ch:
    case R.CKeep{}:
      {True{} == True{} : Bool}
    case R.CDel{}:
      {True{} == True{} : Bool}
    case R.CList{op2, l}:
      {op2 == op : R.LWrite} & GoodLOp(op2)
    case R.CListNew{left, xs, l}:
      GoodNewL(left, xs, l)
    case R.CExp{f}:
      Empty
    case R.CPut{v, f}:
      Empty
    case R.CKeepT{v}:
      Empty
    case R.CApp{s, v}:
      Empty
    case R.CRange{o, s, v}:
      Empty
    case R.CHash{hop, hv}:
      Empty
    case R.CHashNew{ps, hv}:
      Empty
    case R.CMems{sop, sv}:
      Empty
    case R.CMemsNew{ms, sv}:
      Empty
    case R.CZset{zop, z}:
      Empty
    case R.CZsetNew{o, ps, z}:
      Empty
    case R.CRestore{p, v, f}:
      Empty

def op_eq(-op: R.LWrite, -op2: R.LWrite, -l: KV.Deq, -l0: KV.Deq, gl: {op2 == op : R.LWrite}, eq: {ch_of(R.lwrite(op, False{}, l0)) == R.CList{op2, l} : R.Change}) -> {ch_of(R.lwrite(op2, False{}, l0)) == R.CList{op2, l} : R.Change}:
  %Equal.sym(R.LWrite, op2, op, gl) : {ch_of(R.lwrite(_, False{}, l0)) == R.CList{op2, l} : R.Change}
  eq

def sh_list(-op: R.LWrite, -op2: R.LWrite, -l: KV.Deq, -l0: KV.Deq, eq: {ch_of(R.lwrite(op, False{}, l0)) == R.CList{op2, l} : R.Change}, sh: {op2 == op : R.LWrite} & GoodLOp(op2)) -> {ch_of(R.lwrite(op2, False{}, l0)) == R.CList{op2, l} : R.Change} & GoodLOp(op2):
  (gl, go) = sh
  (op_eq(op, op2, l, l0, gl, eq), go)

def shape_good(ch: R.Change, -op: R.LWrite, -l0: KV.Deq, -e: Nat) -> {ch_of(R.lwrite(op, False{}, l0)) == ch : R.Change} -> LShape(op, ch) -> Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, ch):
  match ch:
    case R.CKeep{}:
      eq => sh => {==}
    case R.CDel{}:
      eq => sh => {==}
    case R.CList{op2, l}:
      eq => sh => sh_list(op, op2, l, l0, eq, sh)
    case R.CListNew{left, xs, l}:
      eq => sh => sh
    case R.CExp{f}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CExp{f}), sh)
    case R.CPut{v, f}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CPut{v, f}), sh)
    case R.CKeepT{v}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CKeepT{v}), sh)
    case R.CApp{s, v}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CApp{s, v}), sh)
    case R.CRange{o, s, v}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CRange{o, s, v}), sh)
    case R.CHash{hop, hv}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CHash{hop, hv}), sh)
    case R.CHashNew{ps, hv}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CHashNew{ps, hv}), sh)
    case R.CMems{sop, sv}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CMems{sop, sv}), sh)
    case R.CMemsNew{ms, sv}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CMemsNew{ms, sv}), sh)
    case R.CZset{zop, z}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CZset{zop, z}), sh)
    case R.CZsetNew{o, ps, z}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CZsetNew{o, ps, z}), sh)
    case R.CRestore{p, v, f}:
      eq => sh => Empty.absurd(Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, R.CRestore{p, v, f}), sh)

def some_ok_n(-m: Maybe<&2, Nat>, -a: Nat, e: {m == Some{a} : Maybe<&2, Nat>}) -> {Maybe.is_some(&2, Nat, m) == True{} : Bool}:
  %Equal.sym(Maybe<&2, Nat>, m, Some{a}, e) : {Maybe.is_some(&2, Nat, _) == True{} : Bool}
  {==}

def some_ok_i(-m: Maybe<&2, R.Int>, -a: R.Int, e: {m == Some{a} : Maybe<&2, R.Int>}) -> {Maybe.is_some(&2, R.Int, m) == True{} : Bool}:
  %Equal.sym(Maybe<&2, R.Int>, m, Some{a}, e) : {Maybe.is_some(&2, R.Int, _) == True{} : Bool}
  {==}

def and_ok(-ma: Maybe<&2, R.Int>, -mb: Maybe<&2, R.Int>, -x: R.Int, -y: R.Int, ea: {ma == Some{x} : Maybe<&2, R.Int>}, eb: {mb == Some{y} : Maybe<&2, R.Int>}) -> {Bool.and(Maybe.is_some(&2, R.Int, ma), Maybe.is_some(&2, R.Int, mb)) == True{} : Bool}:
  %Equal.sym(Maybe<&2, R.Int>, ma, Some{x}, ea) : {Bool.and(Maybe.is_some(&2, R.Int, _), Maybe.is_some(&2, R.Int, mb)) == True{} : Bool}
  %Equal.sym(Maybe<&2, R.Int>, mb, Some{y}, eb) : {Bool.and(Maybe.is_some(&2, R.Int, Some{x}), Maybe.is_some(&2, R.Int, _)) == True{} : Bool}
  {==}

def push_shape(xs: List<&2, String>, +left: Bool, +l0: KV.Deq) -> LShape(R.LWPush{left, xs}, ch_of(R.lpush.of(List.is_empty(&2, String, xs), False{}, left, xs, False{}, l0))):
  match xs:
    case Nil{}:
      {==}
    case Con{+y, +rest}:
      ({==}, {==})

def pushx_shape(xs: List<&2, String>, +left: Bool, +l0: KV.Deq) -> LShape(R.LWPushX{left, xs}, ch_of(R.lpush.of(Bool.or(False{}, List.is_empty(&2, String, xs)), False{}, left, xs, True{}, l0))):
  match xs:
    case Nil{}:
      {==}
    case Con{+y, +rest}:
      ({==}, {==})

def popch_shape(b: Bool, -r: R.Reply, -left: Bool, -c: Maybe<&2, String>, -nl: KV.Deq, -op: R.LWrite) -> {R.lpop.op(left, c) == op : R.LWrite} -> GoodLOp(R.lpop.op(left, c)) -> LShape(op, ch_of(R.lpop.ch.of(b, r, left, c, nl))):
  match b:
    case True{}:
      eo => g => {==}
    case False{}:
      eo => g => (eo, g)

def pop_shape(p: KV.Pop, +left: Bool) -> LShape(R.LWPop{left}, ch_of(R.lpop.one(p, left))):
  match p:
    case KV.Pop{+x, +nl}:
      popch_shape(Nat.is_eq(KV.deq.len(nl), 0n), R.RBulk{x}, left, None{}, nl, R.LWPop{left})({==})({==})
    case KV.PopNone{}:
      {==}

def pops_shape(st: KV.Pops, +left: Bool, +c: String, ok: {Maybe.is_some(&2, Nat, R.lcount(c)) == True{} : Bool}) -> LShape(R.LWPopN{left, c}, ch_of(R.lpop.many(st, left, c))):
  match st:
    case KV.Pops{+xs, +nl}:
      popch_shape(Nat.is_eq(KV.deq.len(nl), 0n), R.RArray{R.lbulks(List.reverse(&2, String, xs))}, left, Some{c}, nl, R.LWPopN{left, c})({==})(ok)

def popnk_shape(k: Nat, +left: Bool, +c: String, +l0: KV.Deq, ok: {Maybe.is_some(&2, Nat, R.lcount(c)) == True{} : Bool}) -> LShape(R.LWPopN{left, c}, ch_of(R.lpop.n(False{}, k, left, c, l0))):
  match k:
    case 0n:
      {==}
    case 1n++j:
      pops_shape(KV.deq.pops(R.lpop.cap(Nat.is_lt(1n+j, KV.deq.len(l0)), 1n+j, KV.deq.len(l0)), left, KV.Pops{Nil{}, l0}), left, c, ok)

def popn_shape(mc: Maybe<&2, Nat>, +left: Bool, +c: String, +l0: KV.Deq) -> {R.lcount(c) == mc : Maybe<&2, Nat>} -> LShape(R.LWPopN{left, c}, ch_of(R.lpop.count(mc, False{}, left, c, l0))):
  match mc:
    case Some{+k}:
      e => popnk_shape(k, left, c, l0, some_ok_n(R.lcount(c), k, e))
    case None{}:
      e => {==}

def lset_at_shape(m: Maybe<&2, Nat>, +i: String, +v: String, +l0: KV.Deq) -> LShape(R.LWSet{i, v}, ch_of(R.lset.at(m, i, v, l0))):
  match m:
    case Some{p}:
      ({==}, {==})
    case None{}:
      {==}

def lset_shape(mi: Maybe<&2, R.Int>, +i: String, +v: String, +l0: KV.Deq) -> LShape(R.LWSet{i, v}, ch_of(R.lset.of(mi, i, v, l0))):
  match mi:
    case Some{+ix}:
      lset_at_shape(R.lidx.at(ix, KV.deq.len(l0)), i, v, l0)
    case None{}:
      {==}

def lins_m_shape(m: Maybe<&2, KV.Deq>, -n: Nat, -after: Bool, -p: String, -v: String, -op: R.LWrite) -> {R.lins.op(after, p, v) == op : R.LWrite} -> GoodLOp(R.lins.op(after, p, v)) -> LShape(op, ch_of(R.lins.of(m, n, after, p, v))):
  match m:
    case Some{d}:
      eo => g => (eo, g)
    case None{}:
      eo => g => {==}

def lrem_ch_shape(none: Bool, all: Bool, -gone: Nat, -n: Nat, -c: String, -v: String, -d: KV.Deq, ok: {R.lnum.ok(c) == True{} : Bool}) -> LShape(R.LWRem{c, v}, ch_of(R.lrem.ch(none, all, gone, n, c, v, d))):
  match none all:
    case True{} _:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      ({==}, ok)

def lrem_r_shape(r: KV.Rem, +n: Nat, +c: String, +v: String, ok: {R.lnum.ok(c) == True{} : Bool}) -> LShape(R.LWRem{c, v}, ch_of(R.lrem.out(r, n, c, v))):
  match r:
    case KV.Rem{+d, +gone}:
      lrem_ch_shape(Nat.is_eq(gone, 0n), Nat.is_eq(gone, n), gone, n, c, v, d, ok)

def lrem_shape(mi: Maybe<&2, R.Int>, +c: String, +v: String, +l0: KV.Deq) -> {R.lnum(c) == mi : Maybe<&2, R.Int>} -> LShape(R.LWRem{c, v}, ch_of(R.lrem.of(mi, c, v, l0))):
  match mi:
    case Some{R.IPos{+k}}:
      e => lrem_r_shape(KV.deq.rem(v, k, False{}, l0), KV.deq.len(l0), c, v, some_ok_i(R.lnum(c), R.IPos{k}, e))
    case Some{R.INeg{+k}}:
      e => lrem_r_shape(KV.deq.rem(v, 1n+k, True{}, l0), KV.deq.len(l0), c, v, some_ok_i(R.lnum(c), R.INeg{k}, e))
    case None{}:
      e => {==}

def ltrim_cut_shape(none: Bool, -s: Nat, -r: Nat, -a: String, -b: String, -l0: KV.Deq, ok: {Bool.and(R.lnum.ok(a), R.lnum.ok(b)) == True{} : Bool}) -> LShape(R.LWTrim{a, b}, ch_of(R.ltrim.cut(none, s, r, a, b, l0))):
  match none:
    case True{}:
      {==}
    case False{}:
      ({==}, ok)

def ltrim_sp_shape(sp: R.LSpan, +n: Nat, +a: String, +b: String, +l0: KV.Deq, ok: {Bool.and(R.lnum.ok(a), R.lnum.ok(b)) == True{} : Bool}) -> LShape(R.LWTrim{a, b}, ch_of(R.ltrim.span(sp, n, a, b, l0))):
  match sp:
    case R.LSpan{+s, +e}:
      ltrim_cut_shape(Nat.is_eq(Nat.add(s, Nat.sub(Nat.sub(n, 1n), e)), 0n), s, Nat.sub(Nat.sub(n, 1n), e), a, b, l0, ok)
    case R.LNone{}:
      {==}

def ltrim_shape(ma: Maybe<&2, R.Int>, mb: Maybe<&2, R.Int>, +a: String, +b: String, +l0: KV.Deq) -> {R.lnum(a) == ma : Maybe<&2, R.Int>} -> {R.lnum(b) == mb : Maybe<&2, R.Int>} -> LShape(R.LWTrim{a, b}, ch_of(R.ltrim.of(ma, mb, a, b, l0))):
  match ma mb:
    case Some{+x} Some{+y}:
      ea => eb => ltrim_sp_shape(R.lspan(x, y, KV.deq.len(l0)), KV.deq.len(l0), a, b, l0, and_ok(R.lnum(a), R.lnum(b), x, y, ea, eb))
    case Some{x} None{}:
      ea => eb => {==}
    case None{} _:
      ea => eb => {==}

def new_shape(xs: List<&2, String>, +left: Bool) -> LShape(R.LWNew{left, xs}, ch_of(R.lnew.of(List.is_empty(&2, String, xs), left, xs))):
  match xs:
    case Nil{}:
      {==}
    case Con{+y, +rest}:
      ({==}, {==})

def lw_shape(op: R.LWrite, +l0: KV.Deq) -> LShape(op, ch_of(R.lwrite(op, False{}, l0))):
  match op:
    case R.LWPush{+left, +xs}:
      push_shape(xs, left, l0)
    case R.LWPushX{+left, +xs}:
      pushx_shape(xs, left, l0)
    case R.LWPop{+left}:
      pop_shape(KV.deq.pop(left, l0), left)
    case R.LWPopN{+left, +c}:
      popn_shape(R.lcount(c), left, c, l0)({==})
    case R.LWSet{+i, +v}:
      lset_shape(R.lnum(i), i, v, l0)
    case R.LWBefore{+p, +v}:
      lins_m_shape(KV.deq.ins(p, False{}, v, l0), KV.deq.len(l0), False{}, p, v, R.LWBefore{p, v})({==})({==})
    case R.LWAfter{+p, +v}:
      lins_m_shape(KV.deq.ins(p, True{}, v, l0), KV.deq.len(l0), True{}, p, v, R.LWAfter{p, v})({==})({==})
    case R.LWRem{+c, +v}:
      lrem_shape(R.lnum(c), c, v, l0)({==})
    case R.LWTrim{+a, +b}:
      ltrim_shape(R.lnum(a), R.lnum(b), a, b, l0)({==})({==})
    case R.LWNew{+left, +xs}:
      new_shape(xs, left)

def lw_old_good(op: R.LWrite, +l0: KV.Deq, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CList{l0}}, e}}, ch_of(R.lwrite(op, False{}, l0))):
  +o = op
  shape_good(ch_of(R.lwrite(o, False{}, l0)), o, l0, e)({==})(lw_shape(o, l0))

def good_coll_list(op: R.LWrite, c: KV.Coll, -e: Nat) -> Good(Some{KV.Item{KV.VColl{c}, e}}, ch_of(R.lwrite.coll(op, c))):
  match c:
    case KV.CList{+l0}:
      lw_old_good(op, l0, e)
    case KV.CHash{h}:
      lw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CHash{h}}, e}})
    case KV.CMems{+sv}:
      lw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CMems{sv}}, e}})
    case KV.CZset{+z}:
      lw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CZset{z}}, e}})
    case KV.CStream{+z}:
      lw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CStream{z}}, e}})

# A write of a set: of a key not there (an empty set made fresh) none or
# a new set; of a key that holds another kind, none, or the new set of
# SWNew; of a set the key held (s0): none, the key deleted (its last
# member taken), or the set changed by SADD or SREM of the members, which
# make it again (SPOP's change is SREM's)
def sub_self(n: Nat) -> {0n == Nat.sub(n, n) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n++p:
      sub_self(p)

def has_none(b: Bool, +m: String) -> {False{} == KV.mems.ints.has(b, m, KV.ITip{}) : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def srem_empty(ms: List<&2, String>) -> {R.SDel{KV.mems.empty(), 0n} == R.srem.go(ms, R.SDel{KV.mems.empty(), 0n}) : R.SDel}:
  match ms:
    case Nil{}:
      {==}
    case Con{+m, +rest}:
      %has_none(KV.ints.ok(m), m) : {R.SDel{KV.mems.empty(), 0n} == R.srem.go(rest, R.srem.one(_, KV.mems.empty(), m, 0n)) : R.SDel}
      srem_empty(rest)

def spop_ch(o: R.Out) -> {ch_of(o) == R.spop.ch(o) : R.Change}:
  match o:
    case R.Out{r, ch}:
      {==}

def sadd_fresh(ms: List<&2, String>, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.swrite(R.SWAdd{ms}, True{}, KV.mems.empty()))):
  match ms:
    case Nil{}:
      {==}
    case Con{+y, +rest}:
      ({==}, {==})

def snew_good(ms: List<&2, String>, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.snew.of(List.is_empty(&2, String, ms), ms))):
  match ms:
    case Nil{}:
      {==}
    case Con{+y, +rest}:
      ({==}, {==})

def spop_fresh(+xs: List<&2, String>, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, R.spop.ch(R.srem.out(R.srem.go(xs, R.SDel{KV.mems.empty(), 0n}), xs))):
  %srem_empty(xs) : Good(m, R.spop.ch(R.srem.out(_, xs)))
  {==}

def sw_fresh_good(op: R.SWrite, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.swrite(op, True{}, KV.mems.empty()))):
  match op:
    case R.SWAdd{+ms}:
      sadd_fresh(ms, m)
    case R.SWRem{+ms}:
      %srem_empty(ms) : Good(m, ch_of(R.srem.out(_, ms)))
      {==}
    case R.SWNew{+ms}:
      snew_good(ms, m)
    case R.SWPop{+r}:
      spop_fresh(R.spop.one(R.srand.pick(KV.mems.empty(), R.srand.next(r))), m)
    case R.SWPopN{+c, +r}:
      spop_fresh(R.srand.many(c, KV.mems.empty(), r), m)

def sw_wrong_good(op: R.SWrite, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.swrite.wrong(op))):
  match op:
    case R.SWNew{+ms}:
      sw_fresh_good(R.SWNew{ms}, m)
    case R.SWAdd{ms}:
      {==}
    case R.SWRem{ms}:
      {==}
    case R.SWPop{r}:
      {==}
    case R.SWPopN{c, r}:
      {==}

def sadd_of_old(none: Bool, +ms: List<&2, String>, +s0: KV.Mems, -e: Nat) -> {none == Nat.is_eq(Nat.sub(KV.mems.len(KV.mems.adds(ms, s0)), KV.mems.len(s0)), 0n) : Bool} -> NeS(ms) -> Good(Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}, ch_of(R.sadd.of(none, False{}, ms, KV.mems.adds(ms, s0), Nat.sub(KV.mems.len(KV.mems.adds(ms, s0)), KV.mems.len(s0))))):
  match none:
    case True{}:
      en => ne => {==}
    case False{}:
      en => ne =>
        %en : {ch_of(R.sadd.of(_, False{}, ms, KV.mems.adds(ms, s0), Nat.sub(KV.mems.len(KV.mems.adds(ms, s0)), KV.mems.len(s0)))) == R.CMems{R.SWAdd{ms}, KV.mems.adds(ms, s0)} : R.Change} & NeS(ms)
        ({==}, ne)

def sadd_old(ms: List<&2, String>, +s0: KV.Mems, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}, ch_of(R.swrite(R.SWAdd{ms}, False{}, s0))):
  match ms:
    case Nil{}:
      %sub_self(KV.mems.len(s0)) : Good(Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}, ch_of(R.sadd.of(Nat.is_eq(_, 0n), False{}, Nil{}, s0, _)))
      {==}
    case Con{+y, +rest}:
      sadd_of_old(Nat.is_eq(Nat.sub(KV.mems.len(KV.mems.adds(Con{y, rest}, s0)), KV.mems.len(s0)), 0n), Con{y, rest}, s0, e)({==})({==})

# SREM of a set the key held: nothing, the key deleted (its last member
# taken), or the set without the members, which SREM of them makes again
def srem_of_old(none: Bool, empty: Bool, +m: String, +rest: List<&2, String>, +sv: KV.Mems, +gone: Nat, +s0: KV.Mems, -e: Nat, eq: {R.srem.go(Con{m, rest}, R.SDel{s0, 0n}) == R.SDel{sv, gone} : R.SDel}) -> {none == Nat.is_eq(gone, 0n) : Bool} -> {empty == Nat.is_eq(KV.mems.len(sv), 0n) : Bool} -> Good(Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}, ch_of(R.srem.of(none, empty, Con{m, rest}, sv, gone))):
  match none empty:
    case True{} _:
      en => ee => {==}
    case False{} True{}:
      en => ee => {==}
    case False{} False{}:
      en => ee =>
        %Equal.sym(R.SDel, R.srem.go(Con{m, rest}, R.SDel{s0, 0n}), R.SDel{sv, gone}, eq) : {ch_of(R.srem.out(_, Con{m, rest})) == R.CMems{R.SWRem{Con{m, rest}}, sv} : R.Change} & {True{} == True{} : Bool}
        %en : {ch_of(R.srem.of(_, Nat.is_eq(KV.mems.len(sv), 0n), Con{m, rest}, sv, gone)) == R.CMems{R.SWRem{Con{m, rest}}, sv} : R.Change} & {True{} == True{} : Bool}
        %ee : {ch_of(R.srem.of(False{}, _, Con{m, rest}, sv, gone)) == R.CMems{R.SWRem{Con{m, rest}}, sv} : R.Change} & {True{} == True{} : Bool}
        ({==}, {==})

def srem_old_d(d: R.SDel, +m: String, +rest: List<&2, String>, +s0: KV.Mems, -e: Nat) -> {R.srem.go(Con{m, rest}, R.SDel{s0, 0n}) == d : R.SDel} -> Good(Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}, ch_of(R.srem.out(d, Con{m, rest}))):
  match d:
    case R.SDel{+sv, +gone}:
      eq => srem_of_old(Nat.is_eq(gone, 0n), Nat.is_eq(KV.mems.len(sv), 0n), m, rest, sv, gone, s0, e, eq)({==})({==})

def srem_old(ms: List<&2, String>, +s0: KV.Mems, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}, ch_of(R.srem.out(R.srem.go(ms, R.SDel{s0, 0n}), ms))):
  match ms:
    case Nil{}:
      {==}
    case Con{+m, +rest}:
      srem_old_d(R.srem.go(Con{m, rest}, R.SDel{s0, 0n}), m, rest, s0, e)({==})

def spop_old(+xs: List<&2, String>, +s0: KV.Mems, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}, R.spop.ch(R.srem.out(R.srem.go(xs, R.SDel{s0, 0n}), xs))):
  %spop_ch(R.srem.out(R.srem.go(xs, R.SDel{s0, 0n}), xs)) : Good(Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}, _)
  srem_old(xs, s0, e)

def sw_old_good(op: R.SWrite, +s0: KV.Mems, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}}, ch_of(R.swrite(op, False{}, s0))):
  match op:
    case R.SWAdd{+ms}:
      sadd_old(ms, s0, e)
    case R.SWRem{+ms}:
      srem_old(ms, s0, e)
    case R.SWNew{+ms}:
      snew_good(ms, Some{KV.Item{KV.VColl{KV.CMems{s0}}, e}})
    case R.SWPop{+r}:
      spop_old(R.spop.one(R.srand.pick(s0, R.srand.next(r))), s0, e)
    case R.SWPopN{+c, +r}:
      spop_old(R.srand.many(c, s0, r), s0, e)

def good_coll_set(op: R.SWrite, c: KV.Coll, -e: Nat) -> Good(Some{KV.Item{KV.VColl{c}, e}}, ch_of(R.swrite.coll(op, c))):
  match c:
    case KV.CMems{+s0}:
      sw_old_good(op, s0, e)
    case KV.CHash{+h}:
      sw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CHash{h}}, e}})
    case KV.CList{+l}:
      sw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CList{l}}, e}})
    case KV.CZset{+z}:
      sw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CZset{z}}, e}})
    case KV.CStream{+z}:
      sw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CStream{z}}, e}})

# A write of a sorted set: of a key not there (an empty sorted set made
# fresh) none or a new sorted set (ZADD, or the script of one: never with
# XX, which adds nothing to an empty sorted set); of a key that holds
# another kind, none, or the new sorted set of ZWNew; of a sorted set the
# key held (z0): none, the key deleted (its last elements taken), or z0
# changed by the write, which makes the change again
def zrem_empty(ms: List<&2, String>) -> {R.ZDel{KV.zset.empty(), 0n} == R.zrem.go(ms, R.ZDel{KV.zset.empty(), 0n}) : R.ZDel}:
  match ms:
    case Nil{}:
      {==}
    case Con{+m, +rest}:
      zrem_empty(rest)

def zadd_xx_go(ps: List<&2, R.ZPair>, +nx: Bool, +gt: Bool, +lt: Bool, +ch: Bool, +incr: Bool, +last: F.F64) -> {R.ZAdd{KV.zset.empty(), 0n, 0n, 0n, last} == R.zadd.go(ps, R.ZOpts{nx, True{}, gt, lt, ch, incr}, R.ZAdd{KV.zset.empty(), 0n, 0n, 0n, last}) : R.ZAdd}:
  match ps:
    case Nil{}:
      {==}
    case Con{R.ZPair{s, m}, rest}:
      zadd_xx_go(rest, nx, gt, lt, ch, incr, last)

def zadd_zero(st: R.ZAdd) -> Nat:
  match st:
    case R.ZAdd{z, added, upd, done, last}:
      Nat.add(added, upd)
    case R.ZAddNaN{}:
      1n

def zadd_new_xx_b(xx: Bool, +nx: Bool, +gt: Bool, +lt: Bool, +ch: Bool, +incr: Bool, +ps: List<&2, R.ZPair>, +z: KV.Zset, +added: Nat, +upd: Nat, +done: Nat, +last: F.F64) -> {R.zadd.go(ps, R.ZOpts{nx, xx, gt, lt, ch, incr}, R.ZAdd{KV.zset.empty(), 0n, 0n, 0n, F.F64{0n, 0n}}) == R.ZAdd{z, added, upd, done, last} : R.ZAdd} -> {False{} == Nat.is_eq(Nat.add(added, upd), 0n) : Bool} -> {xx == False{} : Bool}:
  match xx:
    case False{}:
      eg => en => {==}
    case True{}:
      eg => en => Empty.absurd({True{} == False{} : Bool}, false_true(Equal.trans(Bool, False{}, Nat.is_eq(Nat.add(added, upd), 0n), True{}, en, Equal.cong(Nat, Bool, q => Nat.is_eq(q, 0n), Nat.add(added, upd), 0n, Equal.sym(Nat, 0n, Nat.add(added, upd), Equal.cong(R.ZAdd, Nat, q => zadd_zero(q), R.ZAdd{KV.zset.empty(), 0n, 0n, 0n, F.F64{0n, 0n}}, R.ZAdd{z, added, upd, done, last}, Equal.trans(R.ZAdd, R.ZAdd{KV.zset.empty(), 0n, 0n, 0n, F.F64{0n, 0n}}, R.zadd.go(ps, R.ZOpts{nx, True{}, gt, lt, ch, incr}, R.ZAdd{KV.zset.empty(), 0n, 0n, 0n, F.F64{0n, 0n}}), R.ZAdd{z, added, upd, done, last}, zadd_xx_go(ps, nx, gt, lt, ch, incr, F.F64{0n, 0n}), eg)))))))

def zadd_new_xx(o: R.ZOpts, +ps: List<&2, R.ZPair>, +z: KV.Zset, +added: Nat, +upd: Nat, +done: Nat, +last: F.F64) -> {R.zadd.go(ps, o, R.ZAdd{KV.zset.empty(), 0n, 0n, 0n, F.F64{0n, 0n}}) == R.ZAdd{z, added, upd, done, last} : R.ZAdd} -> {False{} == Nat.is_eq(Nat.add(added, upd), 0n) : Bool} -> {R.zopts.xx(o) == False{} : Bool}:
  match o:
    case R.ZOpts{+nx, xx, +gt, +lt, +ch, +incr}:
      zadd_new_xx_b(xx, nx, gt, lt, ch, incr, ps, z, added, upd, done, last)

# ZADD's change, when it passes its checks and adds or changes elements
def zadd_eq(+fresh: Bool, +o: R.ZOpts, +ps: List<&2, R.ZPair>, +z0: KV.Zset, +z: KV.Zset, +added: Nat, +upd: Nat, +done: Nat, +last: F.F64, ec: {R.zadd.check(o, ps) == None{} : Maybe<&2, R.Reply>}, eg: {R.zadd.go(ps, o, R.ZAdd{z0, 0n, 0n, 0n, F.F64{0n, 0n}}) == R.ZAdd{z, added, upd, done, last} : R.ZAdd}, en: {False{} == Nat.is_eq(Nat.add(added, upd), 0n) : Bool}) -> {ch_of(R.zadd.out(fresh, o, ps, z0)) == R.zadd.ch(False{}, fresh, o, ps, z) : R.Change}:
  %Equal.sym(Maybe<&2, R.Reply>, R.zadd.check(o, ps), None{}, ec) : {ch_of(R.zadd.fin(_, fresh, o, ps, z0)) == R.zadd.ch(False{}, fresh, o, ps, z) : R.Change}
  %Equal.sym(R.ZAdd, R.zadd.go(ps, o, R.ZAdd{z0, 0n, 0n, 0n, F.F64{0n, 0n}}), R.ZAdd{z, added, upd, done, last}, eg) : {ch_of(R.zadd.res(_, fresh, o, ps)) == R.zadd.ch(False{}, fresh, o, ps, z) : R.Change}
  %en : {R.zadd.ch(_, fresh, o, ps, z) == R.zadd.ch(False{}, fresh, o, ps, z) : R.Change}
  {==}

def zadd_fresh_ch(none: Bool, +o: R.ZOpts, +ps: List<&2, R.ZPair>, +z: KV.Zset, +added: Nat, +upd: Nat, +done: Nat, +last: F.F64, -m: Maybe<&2, KV.Item<KV.Val>>) -> {R.zadd.check(o, ps) == None{} : Maybe<&2, R.Reply>} -> {R.zadd.go(ps, o, R.ZAdd{KV.zset.empty(), 0n, 0n, 0n, F.F64{0n, 0n}}) == R.ZAdd{z, added, upd, done, last} : R.ZAdd} -> {none == Nat.is_eq(Nat.add(added, upd), 0n) : Bool} -> Good(m, R.zadd.ch(none, True{}, o, ps, z)):
  match none:
    case True{}:
      ec => eg => en => {==}
    case False{}:
      +ec => +eg => +en => (zadd_eq(True{}, o, ps, KV.zset.empty(), z, added, upd, done, last, ec, eg, en), (zadd_new_xx(o, ps, z, added, upd, done, last)(eg)(en), ec))

def zadd_fresh_res(st: R.ZAdd, +o: R.ZOpts, +ps: List<&2, R.ZPair>, -m: Maybe<&2, KV.Item<KV.Val>>) -> {R.zadd.check(o, ps) == None{} : Maybe<&2, R.Reply>} -> {R.zadd.go(ps, o, R.ZAdd{KV.zset.empty(), 0n, 0n, 0n, F.F64{0n, 0n}}) == st : R.ZAdd} -> Good(m, ch_of(R.zadd.res(st, True{}, o, ps))):
  match st:
    case R.ZAdd{+z, +added, +upd, +done, +last}:
      ec => eg => zadd_fresh_ch(Nat.is_eq(Nat.add(added, upd), 0n), o, ps, z, added, upd, done, last, m)(ec)(eg)({==})
    case R.ZAddNaN{}:
      ec => eg => {==}

def zadd_fresh_fin(c: Maybe<&2, R.Reply>, +o: R.ZOpts, +ps: List<&2, R.ZPair>, -m: Maybe<&2, KV.Item<KV.Val>>) -> {R.zadd.check(o, ps) == c : Maybe<&2, R.Reply>} -> Good(m, ch_of(R.zadd.fin(c, True{}, o, ps, KV.zset.empty()))):
  match c:
    case Some{r}:
      ec => {==}
    case None{}:
      ec => zadd_fresh_res(R.zadd.go(ps, o, R.ZAdd{KV.zset.empty(), 0n, 0n, 0n, F.F64{0n, 0n}}), o, ps, m)(ec)({==})

def zadd_fresh(+o: R.ZOpts, +ps: List<&2, R.ZPair>, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.zadd.out(True{}, o, ps, KV.zset.empty()))):
  zadd_fresh_fin(R.zadd.check(o, ps), o, ps, m)({==})

def znew_good(+o: R.ZOpts, +ps: List<&2, R.ZPair>, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.znew.out(R.zadd.out(True{}, o, ps, KV.zset.empty())))):
  %znew_ch(R.zadd.out(True{}, o, ps, KV.zset.empty())) : Good(m, _)
  zadd_fresh(o, ps, m)

def zremr_none_good(mr: Maybe<&2, R.ZRng>, +k: Nat, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.zremr.none(mr, k))):
  match mr:
    case Some{r}:
      {==}
    case None{}:
      {==}

def zpop_none_good(mc: Maybe<&2, Nat>, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.zpop.none(mc))):
  match mc:
    case Some{c}:
      {==}
    case None{}:
      {==}

def zw_fresh_good(op: R.ZWrite, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.zwrite(op, True{}, KV.zset.empty()))):
  match op:
    case R.ZWAdd{+o, +ps}:
      zadd_fresh(o, ps, m)
    case R.ZWRem{+ms}:
      %zrem_empty(ms) : Good(m, ch_of(R.zrem.out(_, ms)))
      {==}
    case R.ZWNew{+o, +ps}:
      znew_good(o, ps, m)
    case R.ZWRemRank{+a, +b}:
      zremr_none_good(R.zrng.of(1n, a, b), 1n, m)
    case R.ZWRemScore{+a, +b}:
      zremr_none_good(R.zrng.of(2n, a, b), 2n, m)
    case R.ZWRemLex{+a, +b}:
      zremr_none_good(R.zrng.of(3n, a, b), 3n, m)
    case R.ZWPop{max}:
      {==}
    case R.ZWPopN{max, +c}:
      zpop_none_good(R.lcount(c), m)

def zw_wrong_good(op: R.ZWrite, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.zwrite.wrong(op))):
  match op:
    case R.ZWAdd{o, ps}:
      {==}
    case R.ZWRem{ms}:
      {==}
    case R.ZWNew{+o, +ps}:
      znew_good(o, ps, m)
    case R.ZWRemRank{a, b}:
      {==}
    case R.ZWRemScore{a, b}:
      {==}
    case R.ZWRemLex{a, b}:
      {==}
    case R.ZWPop{max}:
      {==}
    case R.ZWPopN{max, c}:
      {==}

def zadd_old_ch(none: Bool, +o: R.ZOpts, +ps: List<&2, R.ZPair>, +z: KV.Zset, +added: Nat, +upd: Nat, +done: Nat, +last: F.F64, +z0: KV.Zset, -e: Nat) -> {R.zadd.check(o, ps) == None{} : Maybe<&2, R.Reply>} -> {R.zadd.go(ps, o, R.ZAdd{z0, 0n, 0n, 0n, F.F64{0n, 0n}}) == R.ZAdd{z, added, upd, done, last} : R.ZAdd} -> {none == Nat.is_eq(Nat.add(added, upd), 0n) : Bool} -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, R.zadd.ch(none, False{}, o, ps, z)):
  match none:
    case True{}:
      ec => eg => en => {==}
    case False{}:
      +ec => eg => en => (zadd_eq(False{}, o, ps, z0, z, added, upd, done, last, ec, eg, en), ec)

def zadd_old_res(st: R.ZAdd, +o: R.ZOpts, +ps: List<&2, R.ZPair>, +z0: KV.Zset, -e: Nat) -> {R.zadd.check(o, ps) == None{} : Maybe<&2, R.Reply>} -> {R.zadd.go(ps, o, R.ZAdd{z0, 0n, 0n, 0n, F.F64{0n, 0n}}) == st : R.ZAdd} -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, ch_of(R.zadd.res(st, False{}, o, ps))):
  match st:
    case R.ZAdd{+z, +added, +upd, +done, +last}:
      ec => eg => zadd_old_ch(Nat.is_eq(Nat.add(added, upd), 0n), o, ps, z, added, upd, done, last, z0, e)(ec)(eg)({==})
    case R.ZAddNaN{}:
      ec => eg => {==}

def zadd_old_fin(c: Maybe<&2, R.Reply>, +o: R.ZOpts, +ps: List<&2, R.ZPair>, +z0: KV.Zset, -e: Nat) -> {R.zadd.check(o, ps) == c : Maybe<&2, R.Reply>} -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, ch_of(R.zadd.fin(c, False{}, o, ps, z0))):
  match c:
    case Some{r}:
      ec => {==}
    case None{}:
      ec => zadd_old_res(R.zadd.go(ps, o, R.ZAdd{z0, 0n, 0n, 0n, F.F64{0n, 0n}}), o, ps, z0, e)(ec)({==})

def zadd_old(+o: R.ZOpts, +ps: List<&2, R.ZPair>, +z0: KV.Zset, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, ch_of(R.zadd.out(False{}, o, ps, z0))):
  zadd_old_fin(R.zadd.check(o, ps), o, ps, z0, e)({==})

# ZREM of a sorted set the key held: nothing, the key deleted (its last
# member taken), or the sorted set without the members, which ZREM of
# them makes again
def zrem_of_old(none: Bool, empty: Bool, +m: String, +rest: List<&2, String>, +z: KV.Zset, +gone: Nat, +z0: KV.Zset, -e: Nat, eq: {R.zrem.go(Con{m, rest}, R.ZDel{z0, 0n}) == R.ZDel{z, gone} : R.ZDel}) -> {none == Nat.is_eq(gone, 0n) : Bool} -> {empty == Nat.is_eq(KV.zset.len(z), 0n) : Bool} -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, ch_of(R.zrem.of(none, empty, Con{m, rest}, z, gone))):
  match none empty:
    case True{} _:
      en => ee => {==}
    case False{} True{}:
      en => ee => {==}
    case False{} False{}:
      en => ee =>
        %Equal.sym(R.ZDel, R.zrem.go(Con{m, rest}, R.ZDel{z0, 0n}), R.ZDel{z, gone}, eq) : {ch_of(R.zrem.out(_, Con{m, rest})) == R.CZset{R.ZWRem{Con{m, rest}}, z} : R.Change} & {True{} == True{} : Bool}
        %en : {ch_of(R.zrem.of(_, Nat.is_eq(KV.zset.len(z), 0n), Con{m, rest}, z, gone)) == R.CZset{R.ZWRem{Con{m, rest}}, z} : R.Change} & {True{} == True{} : Bool}
        %ee : {ch_of(R.zrem.of(False{}, _, Con{m, rest}, z, gone)) == R.CZset{R.ZWRem{Con{m, rest}}, z} : R.Change} & {True{} == True{} : Bool}
        ({==}, {==})

def zrem_old_d(d: R.ZDel, +m: String, +rest: List<&2, String>, +z0: KV.Zset, -e: Nat) -> {R.zrem.go(Con{m, rest}, R.ZDel{z0, 0n}) == d : R.ZDel} -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, ch_of(R.zrem.out(d, Con{m, rest}))):
  match d:
    case R.ZDel{+z, +gone}:
      eq => zrem_of_old(Nat.is_eq(gone, 0n), Nat.is_eq(KV.zset.len(z), 0n), m, rest, z, gone, z0, e, eq)({==})({==})

def zrem_old(ms: List<&2, String>, +z0: KV.Zset, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, ch_of(R.zrem.out(R.zrem.go(ms, R.ZDel{z0, 0n}), ms))):
  match ms:
    case Nil{}:
      {==}
    case Con{+m, +rest}:
      zrem_old_d(R.zrem.go(Con{m, rest}, R.ZDel{z0, 0n}), m, rest, z0, e)({==})

# a removal of elements z0 holds (a range, a pop): none, the key deleted,
# or z0 without them, which the write makes again
def zdels_good(none: Bool, empty: Bool, +op: R.ZWrite, +left: KV.Zset, +r: R.Reply, +z0: KV.Zset, -e: Nat) -> {ch_of(R.zwrite(op, False{}, z0)) == ch_of(R.zdels.of(none, empty, op, left, r)) : R.Change} -> GoodZOp(op) -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, ch_of(R.zdels.of(none, empty, op, left, r))):
  match none empty:
    case True{} _:
      ew => go => {==}
    case False{} True{}:
      ew => go => {==}
    case False{} False{}:
      ew => go => (ew, go)

def zdels_good_xs(+xs: List<&2, KV.ZEl>, +op: R.ZWrite, +r: R.Reply, +z0: KV.Zset, -e: Nat) -> {ch_of(R.zwrite(op, False{}, z0)) == ch_of(R.zdels.out(xs, op, z0, r)) : R.Change} -> GoodZOp(op) -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, ch_of(R.zdels.out(xs, op, z0, r))):
  zdels_good(List.is_empty(&2, KV.ZEl, xs), Nat.is_eq(KV.zset.len(KV.zset.dels(xs, z0)), 0n), op, KV.zset.dels(xs, z0), r, z0, e)

def zremr_old(mr: Maybe<&2, R.ZRng>, +k: Nat, +op: R.ZWrite, +z0: KV.Zset, -e: Nat) -> {R.zwrite(op, False{}, z0) == R.zremr.of(mr, k, op, z0) : R.Out} -> ({Maybe.is_some(&2, R.ZRng, mr) == True{} : Bool} -> GoodZOp(op)) -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, ch_of(R.zremr.of(mr, k, op, z0))):
  match mr:
    case Some{+r}:
      ew => go => zdels_good_xs(R.zrange.of(r, False{}, R.IPos{0n}, R.INeg{0n}, z0), op, R.r_int(List.length(&2, KV.ZEl, R.zrange.of(r, False{}, R.IPos{0n}, R.INeg{0n}, z0))), z0, e)(Equal.cong(R.Out, R.Change, q => ch_of(q), R.zwrite(op, False{}, z0), R.zremr.of(Some{r}, k, op, z0), ew))(go({==}))
    case None{}:
      ew => go => {==}

def zpop_old(mc: Maybe<&2, Nat>, +max: Bool, +op: R.ZWrite, +z0: KV.Zset, -e: Nat) -> {R.zwrite(op, False{}, z0) == R.zpop.of(mc, max, op, z0) : R.Out} -> ({Maybe.is_some(&2, Nat, mc) == True{} : Bool} -> GoodZOp(op)) -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, ch_of(R.zpop.of(mc, max, op, z0))):
  match mc:
    case Some{+c}:
      ew => go => zdels_good_xs(R.zpop.els(max, c, z0), op, R.zpop.reply(op, R.zpop.els(max, c, z0)), z0, e)(Equal.cong(R.Out, R.Change, q => ch_of(q), R.zwrite(op, False{}, z0), R.zpop.of(Some{c}, max, op, z0), ew))(go({==}))
    case None{}:
      ew => go => {==}

def zw_old_good(op: R.ZWrite, +z0: KV.Zset, -e: Nat) -> Good(Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}}, ch_of(R.zwrite(op, False{}, z0))):
  match op:
    case R.ZWAdd{+o, +ps}:
      zadd_old(o, ps, z0, e)
    case R.ZWRem{+ms}:
      zrem_old(ms, z0, e)
    case R.ZWNew{+o, +ps}:
      znew_good(o, ps, Some{KV.Item{KV.VColl{KV.CZset{z0}}, e}})
    case R.ZWRemRank{+a, +b}:
      zremr_old(R.zrng.of(1n, a, b), 1n, R.ZWRemRank{a, b}, z0, e)({==})(h => h)
    case R.ZWRemScore{+a, +b}:
      zremr_old(R.zrng.of(2n, a, b), 2n, R.ZWRemScore{a, b}, z0, e)({==})(h => h)
    case R.ZWRemLex{+a, +b}:
      zremr_old(R.zrng.of(3n, a, b), 3n, R.ZWRemLex{a, b}, z0, e)({==})(h => h)
    case R.ZWPop{+max}:
      zpop_old(Some{1n}, max, R.ZWPop{max}, z0, e)({==})(h => {==})
    case R.ZWPopN{+max, +c}:
      zpop_old(R.lcount(c), max, R.ZWPopN{max, c}, z0, e)({==})(h => h)

def good_coll_zset(op: R.ZWrite, c: KV.Coll, -e: Nat) -> Good(Some{KV.Item{KV.VColl{c}, e}}, ch_of(R.zwrite.coll(op, c))):
  match c:
    case KV.CZset{+z0}:
      zw_old_good(op, z0, e)
    case KV.CHash{+h}:
      zw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CHash{h}}, e}})
    case KV.CList{+l}:
      zw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CList{l}}, e}})
    case KV.CMems{+s}:
      zw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CMems{s}}, e}})
    case KV.CStream{+s}:
      zw_wrong_good(op, Some{KV.Item{KV.VColl{KV.CStream{s}}, e}})

# PFADD of a key not there: a new HyperLogLog put (also when its walk
# fails, as Redis adds the key first), or nothing; PFCOUNT and PFDEBUG
# change nothing
def pfadd_none(o: H.AddOut, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.pfadd.out(o, True{}))):
  match o:
    case H.AddDone{ch, v}:
      match ch:
        case True{}:
          {==}
        case False{}:
          {==}
    case H.AddErr{ch, v}:
      match ch:
        case True{}:
          {==}
        case False{}:
          {==}

def hll_none(op: R.HllOp, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.hll.upd(op, None{}))):
  match op:
    case R.HAdd{+els}:
      pfadd_none(H.add(True{}, H.fresh(), R.hll.max(), els), m)
    case R.HCount{}:
      {==}
    case R.HDebug{sub}:
      {==}

# of a key that is not there: none or a put
# RESTORE's changes are good: a key deleted (a time already past) was
# there (live: REPLACE found it), and a value restored is its payload's,
# whose version, checksum and value read, with a time a key keeps
def Live(live: Bool, m: Maybe<&2, KV.Item<KV.Val>>) -> Type:
  {live == True{} : Bool} -> {Maybe.is_some(&2, KV.Item<KV.Val>, m) == True{} : Bool}

def rs_gone_good(live: Bool, -m: Maybe<&2, KV.Item<KV.Val>>) -> Live(live, m) -> Good(m, ch_of(R.restore.gone(live))):
  match live:
    case True{}:
      gl => gl({==})
    case False{}:
      gl => {==}

def rs_past_good(past: Bool, +a: R.At, +p: String, +v: KV.Val, live: Bool, -m: Maybe<&2, KV.Item<KV.Val>>, gv: {D.verify(p) == True{} : Bool}, gd: {D.load(p) == Some{v} : Maybe<&2, KV.Val>}) -> Live(live, m) -> Good(m, ch_of(R.restore.past(past, a, p, v, live))):
  match past:
    case True{}:
      gl => rs_gone_good(live, m)(gl)
    case False{}:
      gl => (gv, (gd, clamp_idem(R.at.exp(a))))

def rs_at_good(ma: Maybe<&2, R.At>, +p: String, +v: KV.Val, live: Bool, +now: Nat, -m: Maybe<&2, KV.Item<KV.Val>>, gv: {D.verify(p) == True{} : Bool}, gd: {D.load(p) == Some{v} : Maybe<&2, KV.Val>}) -> Live(live, m) -> Good(m, ch_of(R.restore.at(ma, p, v, live, now))):
  match ma:
    case Some{+a}:
      gl => rs_past_good(R.at.past(a, now), a, p, v, live, m, gv, gd)(gl)
    case None{}:
      gl => rs_gone_good(live, m)(gl)

def rs_ms_good(ms: Nat, +at: Bool, +p: String, +v: KV.Val, live: Bool, +now: Nat, -m: Maybe<&2, KV.Item<KV.Val>>, gv: {D.verify(p) == True{} : Bool}, gd: {D.load(p) == Some{v} : Maybe<&2, KV.Val>}) -> Live(live, m) -> Good(m, ch_of(R.restore.ms(ms, at, p, v, live, now))):
  match ms:
    case 0n:
      gl => (gv, (gd, {==}))
    case 1n++q:
      gl => rs_at_good(R.at.of(R.TmN{at, 1n+q}, now), p, v, live, now, m, gv, gd)(gl)

def rs_when_good(t: R.Tm, +p: String, +v: KV.Val, live: Bool, +now: Nat, -m: Maybe<&2, KV.Item<KV.Val>>, gv: {D.verify(p) == True{} : Bool}, gd: {D.load(p) == Some{v} : Maybe<&2, KV.Val>}) -> Live(live, m) -> Good(m, ch_of(R.restore.when(t, p, v, live, now))):
  match t:
    case R.TmN{+at, ms}:
      gl => rs_ms_good(ms, at, p, v, live, now, m, gv, gd)(gl)
    case R.TmB{+at, +neg, +hi, +lo}:
      gl => rs_at_good(R.at.of(R.TmB{at, neg, hi, lo}, now), p, v, live, now, m, gv, gd)(gl)

def rs_load_good(mv: Maybe<&2, KV.Val>, +p: String, +t: R.Tm, live: Bool, +now: Nat, -m: Maybe<&2, KV.Item<KV.Val>>, gv: {D.verify(p) == True{} : Bool}) -> {mv == D.load(p) : Maybe<&2, KV.Val>} -> Live(live, m) -> Good(m, ch_of(R.restore.load(mv, p, t, live, now))):
  match mv:
    case Some{+v}:
      e => gl => rs_when_good(t, p, v, live, now, m, gv, Equal.sym(Maybe<&2, KV.Val>, Some{v}, D.load(p), e))(gl)
    case None{}:
      e => gl => {==}

def rs_check_good(ok: Bool, +p: String, +t: R.Tm, live: Bool, +now: Nat, -m: Maybe<&2, KV.Item<KV.Val>>) -> {ok == D.verify(p) : Bool} -> Live(live, m) -> Good(m, ch_of(R.restore.check(ok, p, t, live, now))):
  match ok:
    case True{}:
      e => gl => rs_load_good(D.load(p), p, t, live, now, m, Equal.sym(Bool, True{}, D.verify(p), e))({==})(gl)
    case False{}:
      e => gl => {==}

def rs_ttl_good(t: R.TmR, +p: String, live: Bool, +now: Nat, -m: Maybe<&2, KV.Item<KV.Val>>) -> Live(live, m) -> Good(m, ch_of(R.restore.ttl(t, p, live, now))):
  match t:
    case R.TOk{x}:
      match x:
        case R.TmN{+at, +ms}:
          gl => rs_check_good(D.verify(p), p, R.TmN{at, ms}, live, now, m)({==})(gl)
        case R.TmB{+at, neg, +hi, +lo}:
          match neg:
            case True{}:
              gl => {==}
            case False{}:
              gl => rs_check_good(D.verify(p), p, R.TmB{at, False{}, hi, lo}, live, now, m)({==})(gl)
    case R.TBad{r}:
      gl => {==}

def rs_busy_good(busy: Bool, +p: String, +t: R.TmR, live: Bool, +now: Nat, -m: Maybe<&2, KV.Item<KV.Val>>) -> Live(live, m) -> Good(m, ch_of(R.restore.busy(busy, p, t, live, now))):
  match busy:
    case True{}:
      gl => {==}
    case False{}:
      gl => rs_ttl_good(t, p, live, now, m)(gl)

def good_none(op: R.UpdOp, +now: Nat, -m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.upd(op, now, None{}))):
  match op:
    case R.USetNx{v}:
      {==}
    case R.UGet{+o}:
      %Equal.sym(R.Change, ch_of(R.get.out(R.RNull{}, R.upd(o, now, None{}))), ch_of(R.upd(o, now, None{})), get_ch(R.RNull{}, R.upd(o, now, None{}))) : Good(m, _)
      good_none(o, now, m)
    case R.UAppend{v}:
      {==}
    case R.USet{+v, +cond, ttl, +name}:
      uset_none(ttl, v, cond, name, now, m)
    case R.UGetEx{o}:
      {==}
    case R.UGetDel{}:
      {==}
    case R.UExpire{+tt, c, +name}:
      expire_none(R.at.of(tt, now), c, name, now, m)
    case R.UPersist{}:
      {==}
    case R.UIncr{+by}:
      incr_fit_none(R.by.ll(by), m)
    case R.URange{+o, +a}:
      range_none_good(R.range.go(o, a), o, a, String.is_empty(a), m)
    case R.USetBit{+o, +on}:
      setbit_none(o, on, m)
    case R.UBitfield{+ops}:
      bf_none(R.bf.run0(ops, ""), R.bf.lo0(ops), m)
    case R.UHash{+hop}:
      hw_new_good(hop, m)
    case R.UList{+lop}:
      lw_fresh_good(lop, m)
    case R.UMems{+sop}:
      sw_fresh_good(sop, m)
    case R.UIncrF{+by}:
      incrf_add_none(Some{F.fl.zero(False{})}, F.ld.parse(by), m)
    case R.UZset{+zop}:
      zw_fresh_good(zop, m)
    case R.UHll{+hop}:
      hll_none(hop, m)
    case R.URestore{+p, +t, +rep, ac}:
      rs_busy_good(Bool.and(Bool.not(rep), False{}), p, t, False{}, now, m)(l => Empty.absurd({Maybe.is_some(&2, KV.Item<KV.Val>, m) == True{} : Bool}, false_true(l)))

# a time set alone, to f, of a key there with e: none given none is
# nothing
def etg(b: Bool, +f: Nat, +e: Nat, -w: KV.Val, fx: {KV.clamp(f) == f : Nat}) -> {b == Bool.and(Nat.is_eq(f, 0n), Nat.is_eq(e, 0n)) : Bool} -> Good(Some{KV.Item{w, e}}, Bool.pick(R.Change, b, R.CKeep{}, R.CExp{f})):
  match b:
    case True{}:
      eb => {==}
    case False{}:
      eb => (fx, Equal.sym(Bool, False{}, Bool.and(Nat.is_eq(f, 0n), Nat.is_eq(e, 0n)), eb))

def exp_to_good(+f: Nat, +e: Nat, -w: KV.Val, fx: {KV.clamp(f) == f : Nat}) -> Good(Some{KV.Item{w, e}}, R.exp.to(f, e)):
  etg(Bool.and(Nat.is_eq(f, 0n), Nat.is_eq(e, 0n)), f, e, w, fx)({==})

# deleted, or its time set alone
def dexp_good(b: Bool, +f: Nat, +e: Nat, -w: KV.Val, fx: {KV.clamp(f) == f : Nat}) -> Good(Some{KV.Item{w, e}}, Bool.pick(R.Change, b, R.CDel{}, R.exp.to(f, e))):
  match b:
    case True{}:
      {==}
    case False{}:
      exp_to_good(f, e, w, fx)

# PERSIST: a key with a time loses it
def fixed0() -> {KV.clamp(0n) == 0n : Nat}:
  {==}

def pers_go(b: Bool, -w: KV.Val, +e: Nat) -> {b == Nat.is_eq(e, 0n) : Bool} -> Good(Some{KV.Item{w, e}}, Bool.pick(R.Change, b, R.CKeep{}, R.CExp{0n})):
  match b:
    case True{}:
      eb => {==}
    case False{}:
      eb => (fixed0(), Equal.sym(Bool, False{}, Nat.is_eq(e, 0n), eb))

def persist_go(b: Bool, -w: KV.Val, +e: Nat) -> {b == Nat.is_eq(e, 0n) : Bool} -> Good(Some{KV.Item{w, e}}, ch_of(Bool.pick(R.Out, b, R.Out{R.r_int(0n), R.CKeep{}}, R.Out{R.r_int(1n), R.CExp{0n}}))):
  match b:
    case True{}:
      eb => {==}
    case False{}:
      eb => (fixed0(), Equal.sym(Bool, False{}, Nat.is_eq(e, 0n), eb))

def getex_at_good(a: Maybe<&2, R.At>, +ww: String, +at: Bool, +now: Nat, +w: String, +e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.getex.at(ww, at, now, e, a))):
  match a:
    case Some{+tt}:
      dexp_good(Bool.and(at, R.at.past(tt, now)), KV.clamp(R.at.exp(tt)), e, KV.VStr{w}, clamp_idem(R.at.exp(tt)))
    case None{}:
      {==}

def getex_tm_good(r: R.TmR, +at: Bool, +now: Nat, +w: String, +e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.getex.tm(w, at, now, e, r))):
  match r:
    case R.TOk{+tt}:
      getex_at_good(R.at.of(tt, now), w, at, now, w, e)
    case R.TBad{z}:
      {==}

def getex_good(o: R.ExOpt, +now: Nat, +w: String, +e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.getex.ent(o, now, w, e))):
  match o:
    case R.XNone{}:
      {==}
    case R.XPersist{}:
      pers_go(Nat.is_eq(e, 0n), KV.VStr{w}, e)({==})
    case R.XAt{+at, +ms, +s}:
      getex_tm_good(R.tm.of(s, at, Bool.not(ms), True{}, "getex"), at, now, w, e)

def expire_do_good(ok: Bool, +now: Nat, +tt: R.At, -y: KV.Val, +e: Nat) -> Good(Some{KV.Item{y, e}}, ch_of(R.expire.do(now, e, tt, ok))):
  match ok:
    case True{}:
      dexp_good(R.at.past(tt, now), KV.clamp(R.at.exp(tt)), e, y, clamp_idem(R.at.exp(tt)))
    case False{}:
      {==}

def expire_some(a: Maybe<&2, R.At>, +c: R.ExpIf, +name: String, +now: Nat, +w: String, -y: KV.Val, +e: Nat) -> Good(Some{KV.Item{y, e}}, ch_of(R.expire.at(c, name, now, a, Some{KV.Item{w, e}}))):
  match a:
    case Some{+tt}:
      expire_do_good(R.expire.ok(c, tt, e), now, tt, y, e)
    case None{}:
      {==}

def incr_fit_some(s: R.LL, -w: KV.Val, -e: Nat) -> Good(Some{KV.Item{w, e}}, ch_of(R.uincr.fit(s, True{}))):
  match s:
    case R.LL{+neg, +hi, +lo}:
      {==}
    case R.LLBad{}:
      {==}

def incr_num_some(cur: R.LL, +by: R.By, -w: KV.Val, -e: Nat) -> Good(Some{KV.Item{w, e}}, ch_of(R.uincr.num(by, cur))):
  match cur:
    case R.LL{+neg, +hi, +lo}:
      incr_fit_some(R.ll.add(neg, hi, lo, by), w, e)
    case R.LLBad{}:
      {==}

# INCRBYFLOAT of a key there: the sum set with the key's time kept, or
# nothing (an error)
def incrf_fin_some(bad: Bool, +s: F.Fl, -w: KV.Val, -e: Nat) -> Good(Some{KV.Item{w, e}}, ch_of(R.uincrf.fin(bad, s, True{}))):
  match bad:
    case True{}:
      {==}
    case False{}:
      {==}

def incrf_add_some(a: Maybe<&2, F.Fl>, b: Maybe<&2, F.Fl>, -w: KV.Val, -e: Nat) -> Good(Some{KV.Item{w, e}}, ch_of(R.uincrf.add(a, b, True{}))):
  match a b:
    case Some{+x} Some{+y}:
      incrf_fin_some(Bool.or(F.fl.is_nan(F.fl.add(F.fmt.ld(), x, y)), F.fl.is_inf(F.fl.add(F.fmt.ld(), x, y))), F.fl.add(F.fmt.ld(), x, y), w, e)
    case Some{x} None{}:
      {==}
    case None{} Some{y}:
      {==}
    case None{} None{}:
      {==}

# PFADD, PFCOUNT and PFDEBUG of a key there that holds a string: its
# value with its time kept, the SETRANGE of the count kept in it (of 8
# bytes at 8), or nothing
def pfadd_some_out(o: H.AddOut, -w: String, -e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.pfadd.out(o, False{}))):
  match o:
    case H.AddDone{ch, v}:
      match ch:
        case True{}:
          {==}
        case False{}:
          {==}
    case H.AddErr{ch, v}:
      match ch:
        case True{}:
          {==}
        case False{}:
          {==}

def pfadd_some(ok: Bool, +w: String, els: List<&2, String>, -e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.pfadd.some(ok, w, els))):
  match ok:
    case True{}:
      pfadd_some_out(H.add(False{}, w, R.hll.max(), els), w, e)
    case False{}:
      {==}

def pfcount_cnt(c: H.Count, +w: String, -e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.pfcount.cnt(c, w))):
  match c:
    case H.CntBad{}:
      {==}
    case H.CntKept{x}:
      {==}
    case H.CntNew{H.W{hi, lo}}:
      ({==}, {==})

def pfcount_some(ok: Bool, +w: String, -e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.pfcount.some(ok, w))):
  match ok:
    case True{}:
      pfcount_cnt(H.count(w), w, e)
    case False{}:
      {==}

def pfdebug_dense(m: Maybe<&2, String>, regs: Bool, -w: String, -e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.pfdebug.dense(m, regs))):
  match m:
    case Some{v}:
      {==}
    case None{}:
      {==}

def pfdebug_sub(id: Nat, sparse: Bool, +sub: String, +w: String, -e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.pfdebug.sub(id, sparse, sub, w))):
  match id:
    case 0n:
      {==}
    case 1n+p:
      match p:
        case 0n:
          match sparse:
            case True{}:
              pfdebug_dense(H.sp.dense(w, 0), True{}, w, e)
            case False{}:
              {==}
        case 1n+q:
          match q:
            case 0n:
              {==}
            case 1n+r:
              match r:
                case 0n:
                  {==}
                case 1n+t:
                  match t:
                    case 0n:
                      match sparse:
                        case True{}:
                          pfdebug_dense(H.sp.dense(w, 0), False{}, w, e)
                        case False{}:
                          {==}
                    case 1n+u:
                      {==}

def pfdebug_some(ok: Bool, +sub: String, +w: String, -e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.pfdebug.some(ok, sub, w))):
  match ok:
    case True{}:
      pfdebug_sub(R.pfdebug.id(sub), H.is_sparse(w), sub, w, e)
    case False{}:
      {==}

def hll_some(op: R.HllOp, +w: String, -e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.hll.upd(op, Some{KV.Item{w, e}}))):
  match op:
    case R.HAdd{+els}:
      pfadd_some(H.valid(w), w, els, e)
    case R.HCount{}:
      pfcount_some(H.valid(w), w, e)
    case R.HDebug{+sub}:
      pfdebug_some(H.valid(w), sub, w, e)

# of a key there, with value w and time e
def good_some(op: R.UpdOp, +now: Nat, +w: String, +e: Nat) -> Good(Some{KV.Item{KV.VStr{w}, e}}, ch_of(R.upd(op, now, Some{KV.Item{w, e}}))):
  match op:
    case R.USetNx{v}:
      {==}
    case R.UGet{+o}:
      %Equal.sym(R.Change, ch_of(R.get.out(R.RBulk{w}, R.upd(o, now, Some{KV.Item{w, e}}))), ch_of(R.upd(o, now, Some{KV.Item{w, e}})), get_ch(R.RBulk{w}, R.upd(o, now, Some{KV.Item{w, e}}))) : Good(Some{KV.Item{KV.VStr{w}, e}}, _)
      good_some(o, now, w, e)
    case R.UAppend{s}:
      {==}
    case R.USet{+v, +cond, ttl, +name}:
      uset_some(ttl, v, cond, name, now, w, KV.VStr{w}, e)
    case R.UGetEx{o}:
      getex_good(o, now, w, e)
    case R.UGetDel{}:
      {==}
    case R.UExpire{+tt, +c, +name}:
      expire_some(R.at.of(tt, now), c, name, now, w, KV.VStr{w}, e)
    case R.UPersist{}:
      persist_go(Nat.is_eq(e, 0n), KV.VStr{w}, e)({==})
    case R.UIncr{+by}:
      incr_num_some(R.ll.read(w), by, KV.VStr{w}, e)
    case R.URange{+o, +a}:
      range_some_good(R.range.go(o, a), o, a, w, e, String.is_empty(a))({==})
    case R.USetBit{+o, +on}:
      setbit_some_good(R.setbit.same(o, on, w), o, on, w, e)
    case R.UBitfield{+ops}:
      bf_some(R.bf.run0(ops, w), R.bf.lo0(ops), w, e)
    case R.UHash{+hop}:
      hw_wrong_good(hop, Some{KV.Item{KV.VStr{w}, e}})
    case R.UList{+lop}:
      lw_wrong_good(lop, Some{KV.Item{KV.VStr{w}, e}})
    case R.UMems{+sop}:
      sw_wrong_good(sop, Some{KV.Item{KV.VStr{w}, e}})
    case R.UIncrF{+by}:
      incrf_add_some(F.ld.parse(w), F.ld.parse(by), KV.VStr{w}, e)
    case R.UZset{+zop}:
      zw_wrong_good(zop, Some{KV.Item{KV.VStr{w}, e}})
    case R.UHll{+hop}:
      hll_some(hop, w, e)
    case R.URestore{+p, +t, +rep, ac}:
      rs_busy_good(Bool.and(Bool.not(rep), True{}), p, t, True{}, now, Some{KV.Item{KV.VStr{w}, e}})(l => {==})

# SET with GET of a key that holds a collection changes nothing
def get_wrong_at(a: Maybe<&2, R.At>, -name: String) -> {ch_of(R.get.wrong.at(a, name)) == R.CKeep{} : R.Change}:
  match a:
    case Some{t}:
      {==}
    case None{}:
      {==}

def get_wrong_ttl(ttl: R.SetTtl, -v: String, -cond: Nat, +name: String, +now: Nat) -> {ch_of(R.get.wrong(R.USet{v, cond, ttl, name}, now)) == R.CKeep{} : R.Change}:
  match ttl:
    case R.TNone{}:
      {==}
    case R.TKeep{}:
      {==}
    case R.TAt{+t}:
      get_wrong_at(R.at.of(t, now), name)

def get_wrong_keep(o: R.UpdOp, +now: Nat) -> {ch_of(R.get.wrong(o, now)) == R.CKeep{} : R.Change}:
  match o:
    case R.USet{v, cond, +ttl, +name}:
      get_wrong_ttl(ttl, v, cond, name, now)
    case R.USetNx{x}:
      {==}
    case R.UGet{x}:
      {==}
    case R.UAppend{x}:
      {==}
    case R.UGetEx{x}:
      {==}
    case R.UGetDel{}:
      {==}
    case R.UExpire{x, y, z}:
      {==}
    case R.UPersist{}:
      {==}
    case R.UIncr{x}:
      {==}
    case R.URange{x, y}:
      {==}
    case R.USetBit{x, y}:
      {==}
    case R.UBitfield{x}:
      {==}
    case R.UHash{x}:
      {==}
    case R.UList{x}:
      {==}
    case R.UMems{x}:
      {==}
    case R.UIncrF{x}:
      {==}
    case R.UZset{x}:
      {==}
    case R.UHll{x}:
      {==}
    case R.URestore{a, b, c, d}:
      {==}

# of a key there that holds a collection: SET, SETNX, EXPIRE and its kin
# and PERSIST act on it as on a string, any other changes nothing
def good_coll(op: R.UpdOp, +now: Nat, +c: KV.Coll, +e: Nat) -> Good(Some{KV.Item{KV.VColl{c}, e}}, ch_of(R.upd.coll(R.upd.any(op), op, now, c, e))):
  match op:
    case R.USetNx{v}:
      {==}
    case R.UGet{+o}:
      %Equal.sym(R.Change, ch_of(R.get.wrong(o, now)), R.CKeep{}, get_wrong_keep(o, now)) : Good(Some{KV.Item{KV.VColl{c}, e}}, _)
      {==}
    case R.UAppend{a}:
      {==}
    case R.USet{+v, +cond, ttl, +name}:
      uset_some(ttl, v, cond, name, now, "", KV.VColl{c}, e)
    case R.UGetEx{o}:
      {==}
    case R.UGetDel{}:
      {==}
    case R.UExpire{+tt, +x, +name}:
      expire_some(R.at.of(tt, now), x, name, now, "", KV.VColl{c}, e)
    case R.UPersist{}:
      persist_go(Nat.is_eq(e, 0n), KV.VColl{c}, e)({==})
    case R.UIncr{by}:
      {==}
    case R.URange{o, a}:
      {==}
    case R.USetBit{o, on}:
      {==}
    case R.UBitfield{ops}:
      {==}
    case R.UHash{+hop}:
      good_coll_hash(hop, c, e)
    case R.UList{+lop}:
      good_coll_list(lop, c, e)
    case R.UMems{+sop}:
      good_coll_set(sop, c, e)
    case R.UIncrF{by}:
      {==}
    case R.UZset{+zop}:
      good_coll_zset(zop, c, e)
    case R.UHll{h}:
      {==}
    case R.URestore{+p, +t, +rep, ac}:
      rs_busy_good(Bool.and(Bool.not(rep), True{}), p, t, True{}, now, Some{KV.Item{KV.VColl{c}, e}})(l => {==})

def ug_v(w: KV.Val, op: R.UpdOp, +now: Nat, +e: Nat) -> Good(Some{KV.Item{w, e}}, ch_of(R.upd.v(op, now, Some{KV.Item{w, e}}))):
  match w:
    case KV.VStr{+u}:
      good_some(op, now, u, e)
    case KV.VColl{c}:
      good_coll(op, now, c, e)

def ug_b(b: Bool, op: R.UpdOp, +now: Nat, +w: KV.Val, +e: Nat) -> Good(Some{KV.Item{w, e}}, ch_of(R.upd.v(op, now, Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{w, e}}, None{})))):
  match b:
    case True{}:
      ug_v(w, op, now, e)
    case False{}:
      good_none(op, now, Some{KV.Item{w, e}})

def upd_good(op: R.UpdOp, +now: Nat, m: Maybe<&2, KV.Item<KV.Val>>) -> Good(m, ch_of(R.upd.v(op, now, R.ent.live(now, m)))):
  match m:
    case Some{KV.Item{+w, +e}}:
      ug_b(KV.live(now, e), op, now, w, e)
    case None{}:
      good_none(op, now, None{})

# Replaying a batch
# ------------------
# A batch's effects, run at time 0 on the database the batch ran on,
# leave the database the batch left, at time 0: each command's effects
# do (effect_db), and runs one after another compose (comp).

# a batch's run, then another's, is the run of both
def comp(xs: List<&2, R.Cmd>, +ys: List<&2, R.Cmd>, +d: R.Db) -> {Laws.final(R.exec_all(ys, Laws.final(R.exec_all(xs, d)))) == Laws.final(R.exec_all(List.append(&2, R.Cmd, xs, ys), d)) : R.Db}:
  match xs:
    case Nil{}:
      {==}
    case Con{+c, +rest}:
      %fin_cons(c, List.append(&2, R.Cmd, rest, ys), d) : {Laws.final(R.exec_all(ys, Laws.final(R.exec_all(Con{c, rest}, d)))) == _ : R.Db}
      %fin_cons(c, rest, d) : {Laws.final(R.exec_all(ys, _)) == Laws.final(R.exec_all(List.append(&2, R.Cmd, rest, ys), R.db_of(R.exec(c, d)))) : R.Db}
      comp(rest, ys, R.db_of(R.exec(c, d)))

# DEL's database: the entries it took away, how many of them had a time,
# and the trie it left; none of them depends on the time (only the reply
# does, which counts the keys there at now)
def dc(r: R.Dels) -> Nat & (Nat & KV.Trie<KV.Val>):
  match r:
    case R.Dels{live, gone, gonex, t}:
      (gone, (gonex, t))

def dput(+c: Nat, q: Nat & (Nat & KV.Trie<KV.Val>)) -> Nat & (Nat & KV.Trie<KV.Val>):
  (g, p) = q
  (gx, t) = p
  (Nat.add(g, Bool.pick(Nat, Nat.is_eq(c, 0n), 0n, 1n)), (Nat.add(gx, Bool.pick(Nat, Nat.is_lt(1n, c), 1n, 0n)), t))

def dc_put(+c: Nat, +now: Nat, r: R.Dels) -> {dput(c, dc(r)) == dc(R.del_keys.put(c, now, r)) : Nat & (Nat & KV.Trie<KV.Val>)}:
  match r:
    case R.Dels{live, gone, gonex, t}:
      {==}

def dc_now(ks: List<&2, String>, +now: Nat, +t: KV.Trie<KV.Val>) -> {dc(R.del_keys(ks, 0n, t)) == dc(R.del_keys(ks, now, t)) : Nat & (Nat & KV.Trie<KV.Val>)}:
  match ks:
    case Nil{}:
      {==}
    case Con{+k, +rest}:
      %dc_put(KV.code.at(KV.Val, t, k, KV.hash(k)), 0n, R.del_keys(rest, 0n, KV.del.at(KV.Val, t, k, KV.hash(k)))) : {_ == dc(R.del_keys.put(KV.code.at(KV.Val, t, k, KV.hash(k)), now, R.del_keys(rest, now, KV.del.at(KV.Val, t, k, KV.hash(k))))) : Nat & (Nat & KV.Trie<KV.Val>)}
      %dc_put(KV.code.at(KV.Val, t, k, KV.hash(k)), now, R.del_keys(rest, now, KV.del.at(KV.Val, t, k, KV.hash(k)))) : {dput(KV.code.at(KV.Val, t, k, KV.hash(k)), dc(R.del_keys(rest, 0n, KV.del.at(KV.Val, t, k, KV.hash(k))))) == _ : Nat & (Nat & KV.Trie<KV.Val>)}
      %dc_now(rest, now, KV.del.at(KV.Val, t, k, KV.hash(k))) : {dput(KV.code.at(KV.Val, t, k, KV.hash(k)), dc(R.del_keys(rest, 0n, KV.del.at(KV.Val, t, k, KV.hash(k))))) == dput(KV.code.at(KV.Val, t, k, KV.hash(k)), _) : Nat & (Nat & KV.Trie<KV.Val>)}
      {==}

# DEL's database at time 0, from what it took away
def ddb(q: Nat & (Nat & KV.Trie<KV.Val>), +n: Nat, +x: Nat, rr: Maybe<&2, R.Db>) -> R.Db:
  (g, p) = q
  (gx, t) = p
  R.Db{t, Nat.sub(n, g), Nat.sub(x, gx), 0n, rr}

def ddb_eq(r: R.Dels, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {ddb(dc(r), n, x, rr) == R.db.at(0n, R.db_of(R.del.db(r, n, x, now, rr))) : R.Db}:
  match r:
    case R.Dels{live, gone, gonex, t}:
      {==}

def ddb_eq0(r: R.Dels, +n: Nat, +x: Nat, +rr: Maybe<&2, R.Db>) -> {ddb(dc(r), n, x, rr) == R.db_of(R.del.db(r, n, x, 0n, rr)) : R.Db}:
  match r:
    case R.Dels{live, gone, gonex, t}:
      {==}

# DEL at time 0 leaves the database DEL leaves at any time, at time 0
def del_at0(+ks: List<&2, String>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.db_of(R.del.db(R.del_keys(ks, 0n, t), n, x, 0n, rr)) == R.db.at(0n, R.db_of(R.del.db(R.del_keys(ks, now, t), n, x, now, rr))) : R.Db}:
  %ddb_eq0(R.del_keys(ks, 0n, t), n, x, rr) : {_ == R.db.at(0n, R.db_of(R.del.db(R.del_keys(ks, now, t), n, x, now, rr))) : R.Db}
  %ddb_eq(R.del_keys(ks, now, t), n, x, now, rr) : {ddb(dc(R.del_keys(ks, 0n, t)), n, x, rr) == _ : R.Db}
  %dc_now(ks, now, t) : {ddb(dc(R.del_keys(ks, 0n, t)), n, x, rr) == ddb(_, n, x, rr) : R.Db}
  {==}

# and so does MSET
def mset_at0(ps: List<&2, R.KVPair>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.mset_pairs(ps, R.Db{t, n, x, 0n, rr}) == R.db.at(0n, R.mset_pairs(ps, R.Db{t, n, x, now, rr})) : R.Db}:
  match ps:
    case Nil{}:
      {==}
    case Con{R.KP{+k, +v}, +rest}:
      mset_at0(rest, KV.set.at(KV.Val, t, k, KV.VStr{v}, KV.hash(k)), R.cnt.n(KV.code.at(KV.Val, t, k, KV.hash(k)), n), R.cnt.x(KV.code.at(KV.Val, t, k, KV.hash(k)), 0n, x), now, rr)

# MSETNX's effects, run at time 0, leave the database MSETNX left, at
# time 0: none when it set nothing, else its MSET (mset_at0)
def msetnx_at0(b: Bool, ps: List<&2, R.KVPair>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(A.msetnx.effect(b, ps), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.msetnx.of(b, ps, R.Db{t, n, x, now, rr}))) : R.Db}:
  match b:
    case True{}:
      {==}
    case False{}:
      match ps:
        case Nil{}:
          {==}
        case Con{+p, +rest}:
          mset_at0(Con{p, rest}, t, n, x, now, rr)

# RENAME's effect, run at time 0, leaves the database RENAME left, at time
# 0: none when it moved nothing, else a RENAME, which finds at time 0 the
# entry RENAME moved (an entry there at now is there at 0)
def ren_find0(+t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +rr: Maybe<&2, R.Db>, +s: String, +d: String, +v: KV.Val, +e: Nat, em: {KV.entry.at(KV.Val, t, s, KV.hash(s)) == Some{KV.Item{v, e}} : Maybe<&2, KV.Item<KV.Val>>}, es: {KV.str_eq(s, d) == False{} : Bool}) -> {R.ren.find(R.Db{t, n, x, 0n, rr}, s, d, False{}) == R.RnMove{v, e} : R.Ren}:
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, s, KV.hash(s)), Some{KV.Item{v, e}}, em) : {R.ren.of(R.ent.live(0n, _), KV.str_eq(s, d), False{}) == R.RnMove{v, e} : R.Ren}
  %Equal.sym(Bool, KV.str_eq(s, d), False{}, es) : {R.ren.of(R.ent.live(0n, Some{KV.Item{v, e}}), _, False{}) == R.RnMove{v, e} : R.Ren}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, Some{KV.Item{v, e}}), Some{KV.Item{v, e}}, live0_ent(Some{KV.Item{v, e}})) : {R.ren.of(_, False{}, False{}) == R.RnMove{v, e} : R.Ren}
  {==}

def ren_at0_b(b: Bool, same: Bool, held: Bool, +nx: Bool, +s: String, +d: String, +v: KV.Val, +e: Nat, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, em: {KV.entry.at(KV.Val, t, s, KV.hash(s)) == Some{KV.Item{v, e}} : Maybe<&2, KV.Item<KV.Val>>}) -> {KV.str_eq(s, d) == same : Bool} -> {Laws.final(R.exec_all(A.ren.effect(R.ren.of(Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{}), same, held), s, d), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.ren.do(R.ren.of(Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{}), same, held), nx, s, d, R.Db{t, n, x, now, rr}))) : R.Db}:
  match b same held:
    case False{} _ _:
      es => {==}
    case True{} True{} _:
      es => {==}
    case True{} False{} True{}:
      es => {==}
    case True{} False{} False{}:
      es =>
        %fin_cons(R.Rename{s, d, False{}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db.renamed(R.Db{t, n, x, now, rr}, s, d, v, e)) : R.Db}
        %Equal.sym(R.Ren, R.ren.find(R.Db{t, n, x, 0n, rr}, s, d, False{}), R.RnMove{v, e}, ren_find0(t, n, x, rr, s, d, v, e, em, es)) : {R.db_of(R.ren.do(_, False{}, s, d, R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db.renamed(R.Db{t, n, x, now, rr}, s, d, v, e)) : R.Db}
        {==}

def ren_at0(m: Maybe<&2, KV.Item<KV.Val>>, same: Bool, held: Bool, +nx: Bool, +s: String, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {KV.entry.at(KV.Val, t, s, KV.hash(s)) == m : Maybe<&2, KV.Item<KV.Val>>} -> {KV.str_eq(s, d) == same : Bool} -> {Laws.final(R.exec_all(A.ren.effect(R.ren.of(R.ent.live(now, m), same, held), s, d), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.ren.do(R.ren.of(R.ent.live(now, m), same, held), nx, s, d, R.Db{t, n, x, now, rr}))) : R.Db}:
  match m:
    case None{}:
      em => es => {==}
    case Some{KV.Item{+v, +e}}:
      em => ren_at0_b(KV.live(now, e), same, held, nx, s, d, v, e, t, n, x, now, rr, em)

# BITOP's effect, the SET of its value or the DEL of its destination,
# replays at time 0 as BITOP ran
def bitop_at0(e: Bool, +v: String, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(A.bitop.effect(e, v, d), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.bitop.db(e, v, d, R.Db{t, n, x, now, rr})) : R.Db}:
  match e:
    case True{}:
      %fin_cons(R.Del{[d]}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.bitop.db(True{}, v, d, R.Db{t, n, x, now, rr})) : R.Db}
      del_at0([d], t, n, x, now, rr)
    case False{}:
      {==}

# none when a source holds a collection
def bitop_do_at0(w: Bool, +op: R.BitK, +d: String, +srcs: List<&2, String>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(A.bitop.eff(w, op, d, srcs, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.bitop.do(w, op, d, srcs, R.Db{t, n, x, now, rr}))) : R.Db}:
  match w:
    case True{}:
      {==}
    case False{}:
      bitop_at0(String.is_empty(R.bitop.val(op, srcs, now, t)), R.bitop.val(op, srcs, now, t), d, t, n, x, now, rr)

# LMOVE's effect, run at time 0, leaves the database LMOVE left, at time
# 0: none when it moved nothing, else an LMOVE that finds at time 0 what
# LMOVE found (an entry there at now is there at 0; a destination whose
# time had passed is one the New form takes as not there), and writes as
# LMOVE wrote (a New form pops and pushes at the ends of its plain form)
def fresh_new(w: R.LEnds) -> {True{} == R.ends.fresh(R.ends.new(w)) : Bool}:
  match w:
    case R.LtoL{}:
      {==}
    case R.LtoR{}:
      {==}
    case R.RtoL{}:
      {==}
    case R.RtoR{}:
      {==}
    case R.LtoLNew{}:
      {==}
    case R.LtoRNew{}:
      {==}
    case R.RtoLNew{}:
      {==}
    case R.RtoRNew{}:
      {==}

def new_from(w: R.LEnds) -> {R.ends.from(R.ends.new(w)) == R.ends.from(w) : Bool}:
  match w:
    case R.LtoL{}:
      {==}
    case R.LtoR{}:
      {==}
    case R.RtoL{}:
      {==}
    case R.RtoR{}:
      {==}
    case R.LtoLNew{}:
      {==}
    case R.LtoRNew{}:
      {==}
    case R.RtoLNew{}:
      {==}
    case R.RtoRNew{}:
      {==}

def new_to(w: R.LEnds) -> {R.ends.to(R.ends.new(w)) == R.ends.to(w) : Bool}:
  match w:
    case R.LtoL{}:
      {==}
    case R.LtoR{}:
      {==}
    case R.RtoL{}:
      {==}
    case R.RtoR{}:
      {==}
    case R.LtoLNew{}:
      {==}
    case R.LtoRNew{}:
      {==}
    case R.RtoLNew{}:
      {==}
    case R.RtoRNew{}:
      {==}

def dst_none(f: Bool) -> {R.mv.dst.ent(f, None{}) == None{} : Maybe<&2, KV.Item<KV.Val>>}:
  match f:
    case True{}:
      {==}
    case False{}:
      {==}

# the destination as LMOVE saw it at now, and as its effect sees it at 0
def dst_eq_b(b: Bool, +v: KV.Val, +e: Nat, +w: R.LEnds) -> {R.mv.dst.ent(R.ends.fresh(w), Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{})) == R.mv.dst.ent(R.ends.fresh(Bool.pick(R.LEnds, Bool.not(b), R.ends.new(w), w)), Some{KV.Item{v, e}}) : Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case True{}:
      {==}
    case False{}:
      %fresh_new(w) : {R.mv.dst.ent(R.ends.fresh(w), None{}) == R.mv.dst.ent(_, Some{KV.Item{v, e}}) : Maybe<&2, KV.Item<KV.Val>>}
      dst_none(R.ends.fresh(w))

def dst_eq(md: Maybe<&2, KV.Item<KV.Val>>, +w: R.LEnds, +now: Nat) -> {R.mv.dst.ent(R.ends.fresh(w), R.ent.live(now, md)) == R.mv.dst.ent(R.ends.fresh(Bool.pick(R.LEnds, R.ent.dead(now, md), R.ends.new(w), w)), md) : Maybe<&2, KV.Item<KV.Val>>}:
  match md:
    case None{}:
      {==}
    case Some{KV.Item{+v, +e}}:
      dst_eq_b(KV.live(now, e), v, e, w)

# the source, when LMOVE moved an element: there at now
def src0_b(b: Bool, +v: KV.Val, +e: Nat, +same: Bool, +md: Maybe<&2, KV.Item<KV.Val>>) -> {A.lmove.moved(R.mv.of(Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{}), same, md)) == True{} : Bool} -> {R.mv.of(Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{}), same, md) == R.mv.of(Some{KV.Item{v, e}}, same, md) : R.Mv}:
  match b:
    case True{}:
      mv => {==}
    case False{}:
      mv => Empty.absurd({R.mv.of(None{}, same, md) == R.mv.of(Some{KV.Item{v, e}}, same, md) : R.Mv}, false_true(mv))

def src0(ms: Maybe<&2, KV.Item<KV.Val>>, +same: Bool, +md: Maybe<&2, KV.Item<KV.Val>>, +now: Nat) -> {A.lmove.moved(R.mv.of(R.ent.live(now, ms), same, md)) == True{} : Bool} -> {R.mv.of(R.ent.live(now, ms), same, md) == R.mv.of(ms, same, md) : R.Mv}:
  match ms:
    case None{}:
      mv => {==}
    case Some{KV.Item{+v, +e}}:
      src0_b(KV.live(now, e), v, e, same, md)

# what the effect's LMOVE finds at time 0 (its ends New when the
# destination's time had passed at now): what LMOVE found at now
def find0(+s: String, +d: String, +w: R.LEnds, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, -dd: Bool) -> {R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))) == dd : Bool} -> {A.lmove.moved(R.mv.find(R.Db{t, n, x, now, rr}, s, d, w)) == True{} : Bool} -> {R.mv.find(R.Db{t, n, x, now, rr}, s, d, w) == R.mv.find(R.Db{t, n, x, 0n, rr}, s, d, Bool.pick(R.LEnds, dd, R.ends.new(w), w)) : R.Mv}:
  ed => mv =>
    %ed : {R.mv.find(R.Db{t, n, x, now, rr}, s, d, w) == R.mv.find(R.Db{t, n, x, 0n, rr}, s, d, Bool.pick(R.LEnds, _, R.ends.new(w), w)) : R.Mv}
    %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, KV.entry.at(KV.Val, t, d, KV.hash(d))), KV.entry.at(KV.Val, t, d, KV.hash(d)), live0_ent(KV.entry.at(KV.Val, t, d, KV.hash(d)))) : {R.mv.of(R.ent.live(now, KV.entry.at(KV.Val, t, s, KV.hash(s))), KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(w), R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d))))) == R.mv.of(R.ent.live(0n, KV.entry.at(KV.Val, t, s, KV.hash(s))), KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(Bool.pick(R.LEnds, R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), R.ends.new(w), w)), _)) : R.Mv}
    %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, KV.entry.at(KV.Val, t, s, KV.hash(s))), KV.entry.at(KV.Val, t, s, KV.hash(s)), live0_ent(KV.entry.at(KV.Val, t, s, KV.hash(s)))) : {R.mv.of(R.ent.live(now, KV.entry.at(KV.Val, t, s, KV.hash(s))), KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(w), R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d))))) == R.mv.of(_, KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(Bool.pick(R.LEnds, R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), R.ends.new(w), w)), KV.entry.at(KV.Val, t, d, KV.hash(d)))) : R.Mv}
    %dst_eq(KV.entry.at(KV.Val, t, d, KV.hash(d)), w, now) : {R.mv.of(R.ent.live(now, KV.entry.at(KV.Val, t, s, KV.hash(s))), KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(w), R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d))))) == R.mv.of(KV.entry.at(KV.Val, t, s, KV.hash(s)), KV.str_eq(s, d), _) : R.Mv}
    src0(KV.entry.at(KV.Val, t, s, KV.hash(s)), KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(w), R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d)))), now)(mv)

# LMOVE's writes, for a given verdict, at time 0 and at now
def keepl_at0(d: R.Db, +k: String, +l: KV.Deq) -> {R.db.keepl(R.db.at(0n, d), k, l) == R.db.at(0n, R.db.keepl(d, k, l)) : R.Db}:
  match d:
    case R.Db{t, n, x, now, rr}:
      {==}

def newl_at0(d: R.Db, +k: String, +l: KV.Deq) -> {R.db.newl(R.db.at(0n, d), k, l) == R.db.at(0n, R.db.newl(d, k, l)) : R.Db}:
  match d:
    case R.Db{t, n, x, now, rr}:
      {==}

def mv_src_at0(b: Bool, +k: String, +l: KV.Deq, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.mv.src(b, k, l, R.Db{t, n, x, 0n, rr}) == R.db.at(0n, R.mv.src(b, k, l, R.Db{t, n, x, now, rr})) : R.Db}:
  match b:
    case True{}:
      del_at0([k], t, n, x, now, rr)
    case False{}:
      {==}

def mv_put_at0(+s: String, +l: KV.Deq, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.mv.put(s, l, R.Db{t, n, x, 0n, rr}) == R.db.at(0n, R.mv.put(s, l, R.Db{t, n, x, now, rr})) : R.Db}:
  mv_src_at0(Nat.is_eq(KV.deq.len(l), 0n), s, l, t, n, x, now, rr)

def mv_self_at0(p: KV.Pop, +e: R.LEnds, +e2: R.LEnds, +s: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.ends.to(e2) == R.ends.to(e) : Bool} -> {R.db_of(R.mv.self(p, e2, s, R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.mv.self(p, e, s, R.Db{t, n, x, now, rr}))) : R.Db}:
  match p:
    case KV.Pop{+y, +l}:
      et => %et : {R.db.keepl(R.Db{t, n, x, 0n, rr}, s, KV.deq.push(R.ends.to(e2), y, l)) == R.db.at(0n, R.db.keepl(R.Db{t, n, x, now, rr}, s, KV.deq.push(_, y, l))) : R.Db}
            {==}
    case KV.PopNone{}:
      et => {==}

def mv_go_at0(p: KV.Pop, +e: R.LEnds, +e2: R.LEnds, +s: String, +d: String, dl: Maybe<&2, KV.Deq>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.ends.to(e2) == R.ends.to(e) : Bool} -> {R.db_of(R.mv.go(p, e2, s, d, dl, R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.mv.go(p, e, s, d, dl, R.Db{t, n, x, now, rr}))) : R.Db}:
  match p dl:
    case KV.Pop{+y, +l} Some{+q}:
      et => %et : {R.db.keepl(R.mv.put(s, l, R.Db{t, n, x, 0n, rr}), d, KV.deq.push(R.ends.to(e2), y, q)) == R.db.at(0n, R.db.keepl(R.mv.put(s, l, R.Db{t, n, x, now, rr}), d, KV.deq.push(_, y, q))) : R.Db}
            Equal.trans(R.Db, R.db.keepl(R.mv.put(s, l, R.Db{t, n, x, 0n, rr}), d, KV.deq.push(R.ends.to(e2), y, q)), R.db.keepl(R.db.at(0n, R.mv.put(s, l, R.Db{t, n, x, now, rr})), d, KV.deq.push(R.ends.to(e2), y, q)), R.db.at(0n, R.db.keepl(R.mv.put(s, l, R.Db{t, n, x, now, rr}), d, KV.deq.push(R.ends.to(e2), y, q))),
              Equal.cong(R.Db, R.Db, z => R.db.keepl(z, d, KV.deq.push(R.ends.to(e2), y, q)), R.mv.put(s, l, R.Db{t, n, x, 0n, rr}), R.db.at(0n, R.mv.put(s, l, R.Db{t, n, x, now, rr})), mv_put_at0(s, l, t, n, x, now, rr)),
              keepl_at0(R.mv.put(s, l, R.Db{t, n, x, now, rr}), d, KV.deq.push(R.ends.to(e2), y, q)))
    case KV.Pop{+y, +l} None{}:
      et => %et : {R.db.newl(R.mv.put(s, l, R.Db{t, n, x, 0n, rr}), d, KV.deq.push(R.ends.to(e2), y, KV.deq.empty())) == R.db.at(0n, R.db.newl(R.mv.put(s, l, R.Db{t, n, x, now, rr}), d, KV.deq.push(_, y, KV.deq.empty()))) : R.Db}
            Equal.trans(R.Db, R.db.newl(R.mv.put(s, l, R.Db{t, n, x, 0n, rr}), d, KV.deq.push(R.ends.to(e2), y, KV.deq.empty())), R.db.newl(R.db.at(0n, R.mv.put(s, l, R.Db{t, n, x, now, rr})), d, KV.deq.push(R.ends.to(e2), y, KV.deq.empty())), R.db.at(0n, R.db.newl(R.mv.put(s, l, R.Db{t, n, x, now, rr}), d, KV.deq.push(R.ends.to(e2), y, KV.deq.empty()))),
              Equal.cong(R.Db, R.Db, z => R.db.newl(z, d, KV.deq.push(R.ends.to(e2), y, KV.deq.empty())), R.mv.put(s, l, R.Db{t, n, x, 0n, rr}), R.db.at(0n, R.mv.put(s, l, R.Db{t, n, x, now, rr})), mv_put_at0(s, l, t, n, x, now, rr)),
              newl_at0(R.mv.put(s, l, R.Db{t, n, x, now, rr}), d, KV.deq.push(R.ends.to(e2), y, KV.deq.empty())))
    case KV.PopNone{} _:
      et => {==}

def mv_do_at0(m: R.Mv, +e: R.LEnds, +e2: R.LEnds, +s: String, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {R.ends.from(e2) == R.ends.from(e) : Bool} -> {R.ends.to(e2) == R.ends.to(e) : Bool} -> {R.db_of(R.mv.do(m, e2, s, d, R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.mv.do(m, e, s, d, R.Db{t, n, x, now, rr}))) : R.Db}:
  match m:
    case R.MvNone{}:
      ef => et => {==}
    case R.MvWrong{}:
      ef => et => {==}
    case R.MvSelf{+l, se}:
      ef => et => %ef : {R.db_of(R.mv.self(KV.deq.pop(R.ends.from(e2), l), e2, s, R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.mv.self(KV.deq.pop(_, l), e, s, R.Db{t, n, x, now, rr}))) : R.Db}
                  mv_self_at0(KV.deq.pop(R.ends.from(e2), l), e, e2, s, t, n, x, now, rr)(et)
    case R.MvOnto{+l, se, +q}:
      ef => et => %ef : {R.db_of(R.mv.go(KV.deq.pop(R.ends.from(e2), l), e2, s, d, Some{q}, R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.mv.go(KV.deq.pop(_, l), e, s, d, Some{q}, R.Db{t, n, x, now, rr}))) : R.Db}
                  mv_go_at0(KV.deq.pop(R.ends.from(e2), l), e, e2, s, d, Some{q}, t, n, x, now, rr)(et)
    case R.MvNew{+l, se}:
      ef => et => %ef : {R.db_of(R.mv.go(KV.deq.pop(R.ends.from(e2), l), e2, s, d, None{}, R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.mv.go(KV.deq.pop(_, l), e, s, d, None{}, R.Db{t, n, x, now, rr}))) : R.Db}
                  mv_go_at0(KV.deq.pop(R.ends.from(e2), l), e, e2, s, d, None{}, t, n, x, now, rr)(et)

# LMOVE that moved nothing leaves the database as it was
def unmoved(m: R.Mv, +e: R.LEnds, +s: String, +d: String, +db: R.Db) -> {A.lmove.moved(m) == False{} : Bool} -> {db == R.db_of(R.mv.do(m, e, s, d, db)) : R.Db}:
  match m:
    case R.MvNone{}:
      em => {==}
    case R.MvWrong{}:
      em => {==}
    case R.MvSelf{l, se}:
      em => Empty.absurd({db == R.db_of(R.mv.do(R.MvSelf{l, se}, e, s, d, db)) : R.Db}, true_false(em))
    case R.MvOnto{l, se, q}:
      em => Empty.absurd({db == R.db_of(R.mv.do(R.MvOnto{l, se, q}, e, s, d, db)) : R.Db}, true_false(em))
    case R.MvNew{l, se}:
      em => Empty.absurd({db == R.db_of(R.mv.do(R.MvNew{l, se}, e, s, d, db)) : R.Db}, true_false(em))

def lmove_at0(mvd: Bool, dd: Bool, +s: String, +d: String, +w: R.LEnds, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {A.lmove.moved(R.mv.find(R.Db{t, n, x, now, rr}, s, d, w)) == mvd : Bool} -> {R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))) == dd : Bool} -> {Laws.final(R.exec_all(A.lmove.effect(mvd, dd, s, d, w), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.mv.do(R.mv.find(R.Db{t, n, x, now, rr}, s, d, w), w, s, d, R.Db{t, n, x, now, rr}))) : R.Db}:
  match mvd dd:
    case False{} _:
      em => ed => %unmoved(R.mv.find(R.Db{t, n, x, now, rr}, s, d, w), w, s, d, R.Db{t, n, x, now, rr})(em) : {R.Db{t, n, x, 0n, rr} == R.db.at(0n, _) : R.Db}
                  {==}
    case True{} True{}:
      em => ed =>
        %fin_cons(R.LMove{s, d, R.ends.new(w)}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.mv.do(R.mv.find(R.Db{t, n, x, now, rr}, s, d, w), w, s, d, R.Db{t, n, x, now, rr}))) : R.Db}
        %find0(s, d, w, t, n, x, now, rr, True{})(ed)(em) : {R.db_of(R.mv.do(_, R.ends.new(w), s, d, R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.mv.do(R.mv.find(R.Db{t, n, x, now, rr}, s, d, w), w, s, d, R.Db{t, n, x, now, rr}))) : R.Db}
        mv_do_at0(R.mv.find(R.Db{t, n, x, now, rr}, s, d, w), w, R.ends.new(w), s, d, t, n, x, now, rr)(new_from(w))(new_to(w))
    case True{} False{}:
      em => ed =>
        %fin_cons(R.LMove{s, d, w}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.mv.do(R.mv.find(R.Db{t, n, x, now, rr}, s, d, w), w, s, d, R.Db{t, n, x, now, rr}))) : R.Db}
        %find0(s, d, w, t, n, x, now, rr, False{})(ed)(em) : {R.db_of(R.mv.do(_, w, s, d, R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.mv.do(R.mv.find(R.Db{t, n, x, now, rr}, s, d, w), w, s, d, R.Db{t, n, x, now, rr}))) : R.Db}
        mv_do_at0(R.mv.find(R.Db{t, n, x, now, rr}, s, d, w), w, w, s, d, t, n, x, now, rr)({==})({==})

# LMPOP's effects, the update of the key it picked, replay at time 0 as
# that update ran
def out_db_Rr(+k: String, r: R.Reply & R.Db) -> {R.db_of(r) == R.db_of(R.lmpop.out(k, r)) : R.Db}:
  (y, d) = r
  {==}

def lmpop_at0(m: Maybe<&2, String>, +left: Bool, +cnt: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(lmpop_eff(m, left, cnt, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.lmpop.at(m, left, cnt, R.Db{t, n, x, now, rr}))) : R.Db}:
  match m:
    case Some{+k}:
      %out_db_Rr(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, cnt}})) : {Laws.final(R.exec_all(upd_eff(R.Db{t, n, x, now, rr}, k, R.UList{R.LWPopN{left, cnt}}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, _) : R.Db}
      out_replay(R.upd.v(R.UList{R.LWPopN{left, cnt}}, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))), KV.entry.at(KV.Val, t, k, KV.hash(k)), t, k, n, x, now, rr)({==})(upd_good(R.UList{R.LWPopN{left, cnt}}, now, KV.entry.at(KV.Val, t, k, KV.hash(k))))
    case None{}:
      {==}

# a STORE's effects replay at time 0 as its write ran: the DEL of its
# destination, or the update SWNew of it
def sstore_of_at0(xs: List<&2, String>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(sstore_eff_of(xs, d, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.sstore.of(xs, d, R.Db{t, n, x, now, rr}))) : R.Db}:
  match xs:
    case Nil{}:
      %fin_cons(R.Del{[d]}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.sstore.of(Nil{}, d, R.Db{t, n, x, now, rr}))) : R.Db}
      del_at0([d], t, n, x, now, rr)
    case Con{+y, +rest}:
      out_replay(R.upd.v(R.UMems{R.SWNew{y <> rest}}, now, R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d)))), KV.entry.at(KV.Val, t, d, KV.hash(d)), t, d, n, x, now, rr)({==})(upd_good(R.UMems{R.SWNew{y <> rest}}, now, KV.entry.at(KV.Val, t, d, KV.hash(d))))

def sstore_at0(g: R.SGot, +op: R.SetK, +ks: List<&2, String>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(sstore_eff(g, op, ks, d, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.sstore.do(g, op, ks, d, R.Db{t, n, x, now, rr}))) : R.Db}:
  match g:
    case R.SGot{+ss}:
      sstore_of_at0(R.sop.members(op, ks, ss), d, t, n, x, now, rr)
    case R.SGotWrong{}:
      {==}

# a STORE's effects, of a sorted-set operation or of a range, replay at
# time 0 as its write ran: the DEL of its destination, or the update
# ZWNew of it; ZMPOP's, the update of the key it picked
def zstore_of_at0(xs: List<&2, KV.ZEl>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(zstore_eff_of(xs, d, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.zstore.of(xs, d, R.Db{t, n, x, now, rr}))) : R.Db}:
  match xs:
    case Nil{}:
      %fin_cons(R.Del{[d]}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.zstore.of(Nil{}, d, R.Db{t, n, x, now, rr}))) : R.Db}
      del_at0([d], t, n, x, now, rr)
    case Con{+y, +rest}:
      out_replay(R.upd.v(R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(y <> rest)}}, now, R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d)))), KV.entry.at(KV.Val, t, d, KV.hash(d)), t, d, n, x, now, rr)({==})(upd_good(R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(y <> rest)}}, now, KV.entry.at(KV.Val, t, d, KV.hash(d))))

def zstore_ok_at0(bad: Maybe<&2, R.Reply>, +op: R.ZSetK, ss: List<&2, R.ZSrc>, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(zstore_eff_ok(bad, op, ss, d, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.zstore.ok(bad, op, ss, d, R.Db{t, n, x, now, rr}))) : R.Db}:
  match bad:
    case Some{r}:
      {==}
    case None{}:
      zstore_of_at0(R.zop.els(op, ss), d, t, n, x, now, rr)

def zstore_at0(g: R.ZGot, +op: R.ZSetK, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(zstore_eff(g, op, d, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.zstore.do(g, op, d, R.Db{t, n, x, now, rr}))) : R.Db}:
  match g:
    case R.ZGot{ss}:
      zstore_ok_at0(R.zop.bad(op), op, ss, d, t, n, x, now, rr)
    case R.ZGotWrong{}:
      {==}

def zrs_at0(m: Maybe<&2, KV.Val>, q: R.ZQ, +d: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(zrs_eff(m, q, d, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.zrs.of(m, q, d, R.Db{t, n, x, now, rr}))) : R.Db}:
  match m:
    case None{}:
      zstore_of_at0(Nil{}, d, t, n, x, now, rr)
    case Some{KV.VColl{KV.CZset{+z}}}:
      zstore_of_at0(R.zq.run(q, z), d, t, n, x, now, rr)
    case Some{KV.VColl{KV.CHash{h}}}:
      {==}
    case Some{KV.VColl{KV.CList{l}}}:
      {==}
    case Some{KV.VColl{KV.CMems{s}}}:
      {==}
    case Some{KV.VColl{KV.CStream{s}}}:
      {==}
    case Some{KV.VStr{w}}:
      {==}

def zout_db_Rr(+k: String, r: R.Reply & R.Db) -> {R.db_of(r) == R.db_of(R.zmpop.out(k, r)) : R.Db}:
  (y, d) = r
  {==}

def zmpop_at0(m: Maybe<&2, String>, +max: Bool, +c: String, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(zmpop_eff(m, max, c, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.zmpop.at(m, max, c, R.Db{t, n, x, now, rr}))) : R.Db}:
  match m:
    case Some{+k}:
      %zout_db_Rr(k, R.db.upd(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}})) : {Laws.final(R.exec_all(upd_eff(R.Db{t, n, x, now, rr}, k, R.UZset{R.ZWPopN{max, c}}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, _) : R.Db}
      out_replay(R.upd.v(R.UZset{R.ZWPopN{max, c}}, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))), KV.entry.at(KV.Val, t, k, KV.hash(k)), t, k, n, x, now, rr)({==})(upd_good(R.UZset{R.ZWPopN{max, c}}, now, KV.entry.at(KV.Val, t, k, KV.hash(k))))
    case None{}:
      {==}

# An update at time 0 leaves the database the update at now leaves, at
# time 0, when it makes the same change there
def ch_at0(ch: R.Change, +t: KV.Trie<KV.Val>, +k: String, +h: U32, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +c: Nat, +r: R.Reply) -> {R.db_of(R.upd.ch(t, k, h, n, x, 0n, rr, c, r, ch)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, h, n, x, now, rr, c, r, ch))) : R.Db}:
  match ch:
    case R.CKeep{}:
      {==}
    case R.CDel{}:
      {==}
    case R.CExp{e}:
      {==}
    case R.CPut{v, e}:
      {==}
    case R.CKeepT{v}:
      {==}
    case R.CApp{a, v}:
      {==}
    case R.CRange{o, a, v}:
      {==}
    case R.CHash{op, hv}:
      {==}
    case R.CHashNew{ps, hv}:
      {==}
    case R.CList{op, lv}:
      {==}
    case R.CListNew{lf, xs, lv}:
      {==}
    case R.CMems{op, sv}:
      {==}
    case R.CMemsNew{ms, sv}:
      {==}
    case R.CZset{op, z}:
      {==}
    case R.CZsetNew{o, ps, z}:
      {==}
    case R.CRestore{p, v, e}:
      {==}

def upd0_ch(+t: KV.Trie<KV.Val>, +k: String, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +op: R.UpdOp, +op2: R.UpdOp) -> {ch_of(R.upd.v(op2, 0n, KV.entry.at(KV.Val, t, k, KV.hash(k)))) == ch_of(R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))) : R.Change} -> {R.db_of(R.db.upd(R.Db{t, n, x, 0n, rr}, k, op2)) == R.db.at(0n, R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, k, op))) : R.Db}:
  ec =>
    %db_upd_eq(t, k, n, x, 0n, rr, op2) : {R.db_of(_) == R.db.at(0n, R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, k, op))) : R.Db}
    %db_upd_eq(t, k, n, x, now, rr, op) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op2, 0n, R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k)))))) == R.db.at(0n, R.db_of(_)) : R.Db}
    %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, KV.entry.at(KV.Val, t, k, KV.hash(k))), KV.entry.at(KV.Val, t, k, KV.hash(k)), live0_ent(KV.entry.at(KV.Val, t, k, KV.hash(k)))) : {R.db_of(R.upd.put(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op2, 0n, _))) == R.db.at(0n, R.db_of(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))))) : R.Db}
    %put_db(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op2, 0n, KV.entry.at(KV.Val, t, k, KV.hash(k)))) : {_ == R.db.at(0n, R.db_of(R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))))) : R.Db}
    %put_db(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.RNull{}, ch_of(R.upd.v(op2, 0n, KV.entry.at(KV.Val, t, k, KV.hash(k)))))) == R.db.at(0n, _) : R.Db}
    %Equal.sym(R.Change, ch_of(R.upd.v(op2, 0n, KV.entry.at(KV.Val, t, k, KV.hash(k)))), ch_of(R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))), ec) : {R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, 0n, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.RNull{}, _)) == R.db.at(0n, R.db_of(R.upd.ch(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.RNull{}, ch_of(R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))))))) : R.Db}
    ch_at0(ch_of(R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))), t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.RNull{})

def upd0_d(d: R.Db, +k: String, +op: R.UpdOp, +op2: R.UpdOp) -> {ch_of(R.upd.v(op2, 0n, KV.entry.at(KV.Val, R.db.t(d), k, KV.hash(k)))) == ch_of(R.upd.v(op, R.db.now(d), R.ent.live(R.db.now(d), KV.entry.at(KV.Val, R.db.t(d), k, KV.hash(k))))) : R.Change} -> {R.db_of(R.db.upd(R.db.at(0n, d), k, op2)) == R.db.at(0n, R.db_of(R.db.upd(d, k, op))) : R.Db}:
  match d:
    case R.Db{+t, +n, +x, +now, +rr}:
      upd0_ch(t, k, n, x, now, rr, op, op2)

# SMOVE's effect replays at time 0 as SMOVE ran: what it finds at time 0
# (its New form when the destination's time had passed at now) is what
# it found at now, and its two updates make the changes they made
def sunmoved(f: R.Smv, +s: String, +d: String, +w: R.SMem, +db: R.Db) -> {A.smove.moved(f) == False{} : Bool} -> {db == R.db_of(R.smove.do(f, s, d, w, db)) : R.Db}:
  match f:
    case R.SmvZero{}:
      em => {==}
    case R.SmvWrong{}:
      em => {==}
    case R.SmvSame{had}:
      em => {==}
    case R.SmvGo{}:
      em => Empty.absurd({db == R.db_of(R.smove.do(R.SmvGo{}, s, d, w, db)) : R.Db}, true_false(em))

def smv_go(f: R.Smv) -> {A.smove.moved(f) == True{} : Bool} -> {f == R.SmvGo{} : R.Smv}:
  match f:
    case R.SmvZero{}:
      em => Empty.absurd({R.SmvZero{} == R.SmvGo{} : R.Smv}, false_true(em))
    case R.SmvWrong{}:
      em => Empty.absurd({R.SmvWrong{} == R.SmvGo{} : R.Smv}, false_true(em))
    case R.SmvSame{had}:
      em => Empty.absurd({R.SmvSame{had} == R.SmvGo{} : R.Smv}, false_true(em))
    case R.SmvGo{}:
      em => {==}

# a move: the source is there at now, and is not the destination
def go_src_b(b: Bool, +v: KV.Val, +e: Nat, +md: Maybe<&2, KV.Item<KV.Val>>, +same: Bool, +m: String) -> {A.smove.moved(R.smv.find(Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{}), md, same, m)) == True{} : Bool} -> {Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{}) == Some{KV.Item{v, e}} : Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case True{}:
      em => {==}
    case False{}:
      em => Empty.absurd({None{} == Some{KV.Item{v, e}} : Maybe<&2, KV.Item<KV.Val>>}, false_true(em))

def go_src(ms: Maybe<&2, KV.Item<KV.Val>>, +now: Nat, +md: Maybe<&2, KV.Item<KV.Val>>, +same: Bool, +m: String) -> {A.smove.moved(R.smv.find(R.ent.live(now, ms), md, same, m)) == True{} : Bool} -> {R.ent.live(now, ms) == ms : Maybe<&2, KV.Item<KV.Val>>}:
  match ms:
    case None{}:
      em => {==}
    case Some{KV.Item{+v, +e}}:
      go_src_b(KV.live(now, e), v, e, md, same, m)

def go_dst(same: Bool, +had: Bool, -md: Maybe<&2, KV.Item<KV.Val>>) -> {A.smove.moved(R.smv.dst(same, had, md)) == True{} : Bool} -> {same == False{} : Bool}:
  match same:
    case True{}:
      em => Empty.absurd({True{} == False{} : Bool}, false_true(em))
    case False{}:
      em => {==}

def go_same_v(v: KV.Val, -e: Nat, +md: Maybe<&2, KV.Item<KV.Val>>, +same: Bool, +m: String) -> {A.smove.moved(R.smv.find(Some{KV.Item{v, e}}, md, same, m)) == True{} : Bool} -> {same == False{} : Bool}:
  match v:
    case KV.VColl{KV.CMems{+sv}}:
      go_dst(same, KV.mems.has(m, sv), md)
    case KV.VColl{KV.CZset{z}}:
      em => Empty.absurd({same == False{} : Bool}, false_true(em))
    case KV.VColl{KV.CStream{z}}:
      em => Empty.absurd({same == False{} : Bool}, false_true(em))
    case KV.VColl{KV.CHash{h}}:
      em => Empty.absurd({same == False{} : Bool}, false_true(em))
    case KV.VColl{KV.CList{l}}:
      em => Empty.absurd({same == False{} : Bool}, false_true(em))
    case KV.VStr{u}:
      em => Empty.absurd({same == False{} : Bool}, false_true(em))

def go_same(ms: Maybe<&2, KV.Item<KV.Val>>, +md: Maybe<&2, KV.Item<KV.Val>>, +same: Bool, +m: String) -> {A.smove.moved(R.smv.find(ms, md, same, m)) == True{} : Bool} -> {same == False{} : Bool}:
  match ms:
    case None{}:
      em => Empty.absurd({same == False{} : Bool}, false_true(em))
    case Some{KV.Item{+v, +e}}:
      go_same_v(v, e, md, same, m)

# a set's write sees no time: at 0 as at now
def umems_v(v: KV.Val, +op: R.SWrite, +now: Nat, +e: Nat) -> {R.upd.v(R.UMems{op}, 0n, Some{KV.Item{v, e}}) == R.upd.v(R.UMems{op}, now, Some{KV.Item{v, e}}) : R.Out}:
  match v:
    case KV.VStr{u}:
      {==}
    case KV.VColl{c}:
      {==}

def umems_now(m: Maybe<&2, KV.Item<KV.Val>>, +op: R.SWrite, +now: Nat) -> {R.upd.v(R.UMems{op}, 0n, m) == R.upd.v(R.UMems{op}, now, m) : R.Out}:
  match m:
    case Some{KV.Item{+v, +e}}:
      umems_v(v, op, now, e)
    case None{}:
      {==}

# the destination's write: the same change at time 0, by the New form
# when its time had passed at now
def add_fresh_ch(w: R.SMem) -> {ch_of(R.swrite(R.smv.add(w), True{}, KV.mems.empty())) == R.CMemsNew{[R.smv.member(w)], KV.mems.of([R.smv.member(w)])} : R.Change}:
  match w:
    case R.SMem{+m}:
      {==}
    case R.SMemNew{+m}:
      {==}

def dst_ch_b(b: Bool, +v: KV.Val, +e: Nat, +w: R.SMem, +now: Nat) -> {ch_of(R.upd.v(R.UMems{R.smv.add(Bool.pick(R.SMem, Bool.not(b), R.SMemNew{R.smv.member(w)}, w))}, 0n, Some{KV.Item{v, e}})) == ch_of(R.upd.v(R.UMems{R.smv.add(w)}, now, Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{}))) : R.Change}:
  match b:
    case True{}:
      Equal.cong(R.Out, R.Change, z => ch_of(z), R.upd.v(R.UMems{R.smv.add(w)}, 0n, Some{KV.Item{v, e}}), R.upd.v(R.UMems{R.smv.add(w)}, now, Some{KV.Item{v, e}}), umems_v(v, R.smv.add(w), now, e))
    case False{}:
      %snew_v(v, [R.smv.member(w)], e) : {ch_of(_) == ch_of(R.upd.v(R.UMems{R.smv.add(w)}, now, None{})) : R.Change}
      Equal.sym(R.Change, ch_of(R.swrite(R.smv.add(w), True{}, KV.mems.empty())), R.CMemsNew{[R.smv.member(w)], KV.mems.of([R.smv.member(w)])}, add_fresh_ch(w))

def dst_ch(md: Maybe<&2, KV.Item<KV.Val>>, +w: R.SMem, +now: Nat) -> {ch_of(R.upd.v(R.UMems{R.smv.add(Bool.pick(R.SMem, R.ent.dead(now, md), R.SMemNew{R.smv.member(w)}, w))}, 0n, md)) == ch_of(R.upd.v(R.UMems{R.smv.add(w)}, now, R.ent.live(now, md))) : R.Change}:
  match md:
    case None{}:
      {==}
    case Some{KV.Item{+v, +e}}:
      dst_ch_b(KV.live(now, e), v, e, w, now)

def member_pick(b: Bool, +w: R.SMem) -> {R.smv.member(Bool.pick(R.SMem, b, R.SMemNew{R.smv.member(w)}, w)) == R.smv.member(w) : String}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def smv_dst_eq_b(b: Bool, +v: KV.Val, +e: Nat, +w: R.SMem) -> {R.mv.dst.ent(R.smv.fresh(w), Bool.pick(Maybe<&2, KV.Item<KV.Val>>, b, Some{KV.Item{v, e}}, None{})) == R.mv.dst.ent(R.smv.fresh(Bool.pick(R.SMem, Bool.not(b), R.SMemNew{R.smv.member(w)}, w)), Some{KV.Item{v, e}}) : Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case True{}:
      {==}
    case False{}:
      dst_none(R.smv.fresh(w))

def smv_dst_eq(md: Maybe<&2, KV.Item<KV.Val>>, +w: R.SMem, +now: Nat) -> {R.mv.dst.ent(R.smv.fresh(w), R.ent.live(now, md)) == R.mv.dst.ent(R.smv.fresh(Bool.pick(R.SMem, R.ent.dead(now, md), R.SMemNew{R.smv.member(w)}, w)), md) : Maybe<&2, KV.Item<KV.Val>>}:
  match md:
    case None{}:
      {==}
    case Some{KV.Item{+v, +e}}:
      smv_dst_eq_b(KV.live(now, e), v, e, w)

def smv_find0(+s: String, +d: String, +w: R.SMem, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, -dd: Bool) -> {R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))) == dd : Bool} -> {A.smove.moved(R.smv.of(R.Db{t, n, x, now, rr}, s, d, w)) == True{} : Bool} -> {R.smv.of(R.Db{t, n, x, now, rr}, s, d, w) == R.smv.of(R.Db{t, n, x, 0n, rr}, s, d, Bool.pick(R.SMem, dd, R.SMemNew{R.smv.member(w)}, w)) : R.Smv}:
  ed => mv =>
    %ed : {R.smv.of(R.Db{t, n, x, now, rr}, s, d, w) == R.smv.of(R.Db{t, n, x, 0n, rr}, s, d, Bool.pick(R.SMem, _, R.SMemNew{R.smv.member(w)}, w)) : R.Smv}
    %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, KV.entry.at(KV.Val, t, d, KV.hash(d))), KV.entry.at(KV.Val, t, d, KV.hash(d)), live0_ent(KV.entry.at(KV.Val, t, d, KV.hash(d)))) : {R.smv.of(R.Db{t, n, x, now, rr}, s, d, w) == R.smv.find(R.ent.live(0n, KV.entry.at(KV.Val, t, s, KV.hash(s))), R.mv.dst.ent(R.smv.fresh(Bool.pick(R.SMem, R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), R.SMemNew{R.smv.member(w)}, w)), _), KV.str_eq(s, d), R.smv.member(Bool.pick(R.SMem, R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), R.SMemNew{R.smv.member(w)}, w))) : R.Smv}
    %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(0n, KV.entry.at(KV.Val, t, s, KV.hash(s))), KV.entry.at(KV.Val, t, s, KV.hash(s)), live0_ent(KV.entry.at(KV.Val, t, s, KV.hash(s)))) : {R.smv.of(R.Db{t, n, x, now, rr}, s, d, w) == R.smv.find(_, R.mv.dst.ent(R.smv.fresh(Bool.pick(R.SMem, R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), R.SMemNew{R.smv.member(w)}, w)), KV.entry.at(KV.Val, t, d, KV.hash(d))), KV.str_eq(s, d), R.smv.member(Bool.pick(R.SMem, R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), R.SMemNew{R.smv.member(w)}, w))) : R.Smv}
    %Equal.sym(String, R.smv.member(Bool.pick(R.SMem, R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), R.SMemNew{R.smv.member(w)}, w)), R.smv.member(w), member_pick(R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), w)) : {R.smv.of(R.Db{t, n, x, now, rr}, s, d, w) == R.smv.find(KV.entry.at(KV.Val, t, s, KV.hash(s)), R.mv.dst.ent(R.smv.fresh(Bool.pick(R.SMem, R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), R.SMemNew{R.smv.member(w)}, w)), KV.entry.at(KV.Val, t, d, KV.hash(d))), KV.str_eq(s, d), _) : R.Smv}
    %smv_dst_eq(KV.entry.at(KV.Val, t, d, KV.hash(d)), w, now) : {R.smv.of(R.Db{t, n, x, now, rr}, s, d, w) == R.smv.find(KV.entry.at(KV.Val, t, s, KV.hash(s)), _, KV.str_eq(s, d), R.smv.member(w)) : R.Smv}
    Equal.cong(Maybe<&2, KV.Item<KV.Val>>, R.Smv, z => R.smv.find(z, R.mv.dst.ent(R.smv.fresh(w), R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d)))), KV.str_eq(s, d), R.smv.member(w)), R.ent.live(now, KV.entry.at(KV.Val, t, s, KV.hash(s))), KV.entry.at(KV.Val, t, s, KV.hash(s)), go_src(KV.entry.at(KV.Val, t, s, KV.hash(s)), now, R.mv.dst.ent(R.smv.fresh(w), R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d)))), KV.str_eq(s, d), R.smv.member(w))(mv))

# the frame of the source's update at the destination
def upd_entry_at(+t: KV.Trie<KV.Val>, +s: String, +d: String, +op: R.UpdOp, +now: Nat, ne: {d != s : String}) -> {KV.entry.at(KV.Val, T.db_of(T.upd.run(t, s, op, now)), d, KV.hash(d)) == KV.entry.at(KV.Val, t, d, KV.hash(d)) : Maybe<&2, KV.Item<KV.Val>>}:
  Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, T.db_of(T.upd.run(t, s, op, now)), d, KV.hash(d)), KV.entry(KV.Val, T.db_of(T.upd.run(t, s, op, now)), d), KV.entry.at(KV.Val, t, d, KV.hash(d)),
    Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.upd.run(t, s, op, now)), d), KV.entry.at(KV.Val, T.db_of(T.upd.run(t, s, op, now)), d, KV.hash(d)), entry_at_eq(KV.Val, T.db_of(T.upd.run(t, s, op, now)), d)),
    Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.upd.run(t, s, op, now)), d), KV.entry(KV.Val, t, d), KV.entry.at(KV.Val, t, d, KV.hash(d)),
      upd_frame(t, s, d, R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, s, KV.hash(s)))), ne),
      entry_at_eq(KV.Val, t, d)))

def src_ch(+t: KV.Trie<KV.Val>, +s: String, +op: R.SWrite, +now: Nat, es: {R.ent.live(now, KV.entry.at(KV.Val, t, s, KV.hash(s))) == KV.entry.at(KV.Val, t, s, KV.hash(s)) : Maybe<&2, KV.Item<KV.Val>>}) -> {ch_of(R.upd.v(R.UMems{op}, 0n, KV.entry.at(KV.Val, t, s, KV.hash(s)))) == ch_of(R.upd.v(R.UMems{op}, now, R.ent.live(now, KV.entry.at(KV.Val, t, s, KV.hash(s))))) : R.Change}:
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(now, KV.entry.at(KV.Val, t, s, KV.hash(s))), KV.entry.at(KV.Val, t, s, KV.hash(s)), es) : {ch_of(R.upd.v(R.UMems{op}, 0n, KV.entry.at(KV.Val, t, s, KV.hash(s)))) == ch_of(R.upd.v(R.UMems{op}, now, _)) : R.Change}
  Equal.cong(R.Out, R.Change, z => ch_of(z), R.upd.v(R.UMems{op}, 0n, KV.entry.at(KV.Val, t, s, KV.hash(s))), R.upd.v(R.UMems{op}, now, KV.entry.at(KV.Val, t, s, KV.hash(s))), umems_now(KV.entry.at(KV.Val, t, s, KV.hash(s)), op, now))

def dst_cond(+t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +s: String, +d: String, +w: R.SMem, +w2: R.SMem, ne: {d != s : String}, ed: {ch_of(R.upd.v(R.UMems{R.smv.add(w2)}, 0n, KV.entry.at(KV.Val, t, d, KV.hash(d)))) == ch_of(R.upd.v(R.UMems{R.smv.add(w)}, now, R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d))))) : R.Change}) -> {ch_of(R.upd.v(R.UMems{R.smv.add(w2)}, 0n, KV.entry.at(KV.Val, R.db.t(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))), d, KV.hash(d)))) == ch_of(R.upd.v(R.UMems{R.smv.add(w)}, R.db.now(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))), R.ent.live(R.db.now(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))), KV.entry.at(KV.Val, R.db.t(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))), d, KV.hash(d))))) : R.Change}:
  %Equal.sym(Nat, R.db.now(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))), now, upd_now_d(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}})) : {ch_of(R.upd.v(R.UMems{R.smv.add(w2)}, 0n, KV.entry.at(KV.Val, R.db.t(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))), d, KV.hash(d)))) == ch_of(R.upd.v(R.UMems{R.smv.add(w)}, _, R.ent.live(_, KV.entry.at(KV.Val, R.db.t(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))), d, KV.hash(d))))) : R.Change}
  %Equal.sym(KV.Trie<KV.Val>, R.db.t(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))), T.db_of(T.upd.run(t, s, R.UMems{R.SWRem{[R.smv.member(w)]}}, now)), upd_t(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}})) : {ch_of(R.upd.v(R.UMems{R.smv.add(w2)}, 0n, KV.entry.at(KV.Val, _, d, KV.hash(d)))) == ch_of(R.upd.v(R.UMems{R.smv.add(w)}, now, R.ent.live(now, KV.entry.at(KV.Val, _, d, KV.hash(d))))) : R.Change}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, T.db_of(T.upd.run(t, s, R.UMems{R.SWRem{[R.smv.member(w)]}}, now)), d, KV.hash(d)), KV.entry.at(KV.Val, t, d, KV.hash(d)), upd_entry_at(t, s, d, R.UMems{R.SWRem{[R.smv.member(w)]}}, now, ne)) : {ch_of(R.upd.v(R.UMems{R.smv.add(w2)}, 0n, _)) == ch_of(R.upd.v(R.UMems{R.smv.add(w)}, now, R.ent.live(now, _))) : R.Change}
  ed

def smove_go_at0(+s: String, +d: String, +w: R.SMem, +w2: R.SMem, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, em: {R.smv.member(w2) == R.smv.member(w) : String}, es: {R.ent.live(now, KV.entry.at(KV.Val, t, s, KV.hash(s))) == KV.entry.at(KV.Val, t, s, KV.hash(s)) : Maybe<&2, KV.Item<KV.Val>>}, ne: {d != s : String}, ed: {ch_of(R.upd.v(R.UMems{R.smv.add(w2)}, 0n, KV.entry.at(KV.Val, t, d, KV.hash(d)))) == ch_of(R.upd.v(R.UMems{R.smv.add(w)}, now, R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d))))) : R.Change}) -> {R.db_of(R.smove.do(R.SmvGo{}, s, d, w2, R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.smove.do(R.SmvGo{}, s, d, w, R.Db{t, n, x, now, rr}))) : R.Db}:
  %Equal.sym(String, R.smv.member(w2), R.smv.member(w), em) : {R.db_of(R.db.upd(R.db_of(R.db.upd(R.Db{t, n, x, 0n, rr}, s, R.UMems{R.SWRem{[_]}})), d, R.UMems{R.smv.add(w2)})) == R.db.at(0n, R.db_of(R.db.upd(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}})), d, R.UMems{R.smv.add(w)}))) : R.Db}
  %Equal.sym(R.Db, R.db_of(R.db.upd(R.Db{t, n, x, 0n, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}})), R.db.at(0n, R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}}))), upd0_ch(t, s, n, x, now, rr, R.UMems{R.SWRem{[R.smv.member(w)]}}, R.UMems{R.SWRem{[R.smv.member(w)]}})(src_ch(t, s, R.SWRem{[R.smv.member(w)]}, now, es))) : {R.db_of(R.db.upd(_, d, R.UMems{R.smv.add(w2)})) == R.db.at(0n, R.db_of(R.db.upd(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}})), d, R.UMems{R.smv.add(w)}))) : R.Db}
  upd0_d(R.db_of(R.db.upd(R.Db{t, n, x, now, rr}, s, R.UMems{R.SWRem{[R.smv.member(w)]}})), d, R.UMems{R.smv.add(w)}, R.UMems{R.smv.add(w2)})(dst_cond(t, n, x, now, rr, s, d, w, w2, ne, ed))

def smove_mv_at0(+s: String, +d: String, +w: R.SMem, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, -dd: Bool, +ed: {R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))) == dd : Bool}, +mv: {A.smove.moved(R.smv.of(R.Db{t, n, x, now, rr}, s, d, w)) == True{} : Bool}) -> {R.db_of(R.smove.do(R.smv.of(R.Db{t, n, x, 0n, rr}, s, d, Bool.pick(R.SMem, dd, R.SMemNew{R.smv.member(w)}, w)), s, d, Bool.pick(R.SMem, dd, R.SMemNew{R.smv.member(w)}, w), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.smove.do(R.smv.of(R.Db{t, n, x, now, rr}, s, d, w), s, d, w, R.Db{t, n, x, now, rr}))) : R.Db}:
  %smv_find0(s, d, w, t, n, x, now, rr, dd)(ed)(mv) : {R.db_of(R.smove.do(_, s, d, Bool.pick(R.SMem, dd, R.SMemNew{R.smv.member(w)}, w), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.smove.do(R.smv.of(R.Db{t, n, x, now, rr}, s, d, w), s, d, w, R.Db{t, n, x, now, rr}))) : R.Db}
  %Equal.sym(R.Smv, R.smv.of(R.Db{t, n, x, now, rr}, s, d, w), R.SmvGo{}, smv_go(R.smv.of(R.Db{t, n, x, now, rr}, s, d, w))(mv)) : {R.db_of(R.smove.do(_, s, d, Bool.pick(R.SMem, dd, R.SMemNew{R.smv.member(w)}, w), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.smove.do(_, s, d, w, R.Db{t, n, x, now, rr}))) : R.Db}
  %ed : {R.db_of(R.smove.do(R.SmvGo{}, s, d, Bool.pick(R.SMem, _, R.SMemNew{R.smv.member(w)}, w), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.smove.do(R.SmvGo{}, s, d, w, R.Db{t, n, x, now, rr}))) : R.Db}
  smove_go_at0(s, d, w, Bool.pick(R.SMem, R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), R.SMemNew{R.smv.member(w)}, w), t, n, x, now, rr,
    member_pick(R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), w),
    go_src(KV.entry.at(KV.Val, t, s, KV.hash(s)), now, R.mv.dst.ent(R.smv.fresh(w), R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d)))), KV.str_eq(s, d), R.smv.member(w))(mv),
    ne_sym(s, d, go_same(R.ent.live(now, KV.entry.at(KV.Val, t, s, KV.hash(s))), R.mv.dst.ent(R.smv.fresh(w), R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d)))), KV.str_eq(s, d), R.smv.member(w))(mv)),
    dst_ch(KV.entry.at(KV.Val, t, d, KV.hash(d)), w, now))

def smove_at0(mvd: Bool, dd: Bool, +s: String, +d: String, +w: R.SMem, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {A.smove.moved(R.smv.of(R.Db{t, n, x, now, rr}, s, d, w)) == mvd : Bool} -> {R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))) == dd : Bool} -> {Laws.final(R.exec_all(A.smove.effect(mvd, dd, s, d, w), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.smove.do(R.smv.of(R.Db{t, n, x, now, rr}, s, d, w), s, d, w, R.Db{t, n, x, now, rr}))) : R.Db}:
  match mvd dd:
    case False{} _:
      em => ed => %sunmoved(R.smv.of(R.Db{t, n, x, now, rr}, s, d, w), s, d, w, R.Db{t, n, x, now, rr})(em) : {R.Db{t, n, x, 0n, rr} == R.db.at(0n, _) : R.Db}
                  {==}
    case True{} True{}:
      em => ed =>
        %fin_cons(R.SMv{s, d, R.SMemNew{R.smv.member(w)}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.smove.do(R.smv.of(R.Db{t, n, x, now, rr}, s, d, w), s, d, w, R.Db{t, n, x, now, rr}))) : R.Db}
        smove_mv_at0(s, d, w, t, n, x, now, rr, True{}, ed, em)
    case True{} False{}:
      em => ed =>
        %fin_cons(R.SMv{s, d, w}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.smove.do(R.smv.of(R.Db{t, n, x, now, rr}, s, d, w), s, d, w, R.Db{t, n, x, now, rr}))) : R.Db}
        smove_mv_at0(s, d, w, t, n, x, now, rr, False{}, ed, em)

# a command's effects, run at time 0 on the database it ran on, leave the
# database it left, at time 0: an update's (and INCRBY's) by its change
# (out_replay), as the change is a good one (upd_good)
def effect_go(c: R.Cmd, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>) -> {Laws.final(R.exec_all(eff(c, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(R.exec(c, R.Db{t, n, x, now, rr}))) : R.Db}:
  match c:
    case R.Ping{}:
      {==}
    case R.Echo{m}:
      {==}
    case R.Get{k}:
      {==}
    case R.Set{k, v}:
      {==}
    case R.Del{ks}:
      match ks:
        case Nil{}:
          %Equal.sym(Nat, Nat.sub(n, 0n), n, sub_zero(n)) : {R.Db{t, n, x, 0n, rr} == R.Db{t, _, Nat.sub(x, 0n), 0n, rr} : R.Db}
          %Equal.sym(Nat, Nat.sub(x, 0n), x, sub_zero(x)) : {R.Db{t, n, x, 0n, rr} == R.Db{t, n, _, 0n, rr} : R.Db}
          {==}
        case Con{+k, +rest}:
          %fin_cons(R.Del{Con{k, rest}}, Nil{}, R.Db{t, n, x, 0n, rr}) : {_ == R.db.at(0n, R.db_of(R.exec(R.Del{Con{k, rest}}, R.Db{t, n, x, now, rr}))) : R.Db}
          del_at0(Con{k, rest}, t, n, x, now, rr)
    case R.Exists{ks}:
      {==}
    case R.IncrBy{+k, +by}:
      %Equal.sym(R.Reply & R.Db, R.exec(R.IncrBy{k, by}, R.Db{t, n, x, now, rr}), R.upd.put(t, k, KV.hash(k), n, x, now, rr, R.ent.code(KV.entry.at(KV.Val, t, k, KV.hash(k))), R.upd.v(R.UIncr{by}, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k))))), incr_upd_eq(t, k, by, n, x, now, rr)) : {Laws.final(R.exec_all(eff(R.IncrBy{k, by}, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(_)) : R.Db}
      out_replay(R.upd.v(R.UIncr{by}, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))), KV.entry.at(KV.Val, t, k, KV.hash(k)), t, k, n, x, now, rr)({==})(upd_good(R.UIncr{by}, now, KV.entry.at(KV.Val, t, k, KV.hash(k))))
    case R.MGet{ks}:
      {==}
    case R.MSet{ps}:
      match ps:
        case Nil{}:
          {==}
        case Con{+p, +rest}:
          mset_at0(Con{p, rest}, t, n, x, now, rr)
    case R.DbSize{}:
      {==}
    case R.FlushDb{}:
      {==}
    case R.Keys{p}:
      {==}
    case R.Sort{k, o}:
      {==}
    case R.Scan{a}:
      {==}
    case R.Peek{k, o}:
      {==}
    case R.Upd{+k, +op}:
      %db_upd_eq(t, k, n, x, now, rr, op) : {Laws.final(R.exec_all(eff(R.Upd{k, op}, R.Db{t, n, x, now, rr}), R.Db{t, n, x, 0n, rr})) == R.db.at(0n, R.db_of(_)) : R.Db}
      out_replay(R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))), KV.entry.at(KV.Val, t, k, KV.hash(k)), t, k, n, x, now, rr)({==})(upd_good(op, now, KV.entry.at(KV.Val, t, k, KV.hash(k))))
    case R.MSetNx{+ps}:
      msetnx_at0(R.pairs.live(ps, now, t), ps, t, n, x, now, rr)
    case R.Rename{+s, +d, +nx}:
      ren_at0(KV.entry.at(KV.Val, t, s, KV.hash(s)), KV.str_eq(s, d), Bool.and(nx, Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry.at(KV.Val, t, d, KV.hash(d))))), nx, s, d, t, n, x, now, rr)({==})({==})
    case R.BitOp{+op, +d, +srcs}:
      bitop_do_at0(R.bitop.wrong(srcs, now, t), op, d, srcs, t, n, x, now, rr)
    case R.LMove{+s, +d, +w}:
      lmove_at0(A.lmove.moved(R.mv.find(R.Db{t, n, x, now, rr}, s, d, w)), R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), s, d, w, t, n, x, now, rr)({==})({==})
    case R.LMPop{+ks, +left, +cnt}:
      lmpop_at0(R.lmpop.first(ks, R.lmpop.head(ks, R.Db{t, n, x, now, rr}), R.Db{t, n, x, now, rr}), left, cnt, t, n, x, now, rr)
    case R.SOp{op, ks}:
      {==}
    case R.SStore{+op, +d, +srcs}:
      sstore_at0(R.sets.at(srcs, now, t), op, srcs, d, t, n, x, now, rr)
    case R.SMv{+s, +d, +w}:
      smove_at0(A.smove.moved(R.smv.of(R.Db{t, n, x, now, rr}, s, d, w)), R.ent.dead(now, KV.entry.at(KV.Val, t, d, KV.hash(d))), s, d, w, t, n, x, now, rr)({==})({==})
    case R.ZOp{op, ks}:
      {==}
    case R.ZStore{+op, +d, +srcs}:
      zstore_at0(R.zsrcs.at(srcs, now, t), op, d, t, n, x, now, rr)
    case R.ZRangeStore{+d, +s, +q}:
      zrs_at0(KV.read(KV.Val, t, s, now), q, d, t, n, x, now, rr)
    case R.ZMPop{+ks, +max, +c}:
      zmpop_at0(R.lmpop.first(ks, R.lmpop.head(ks, R.Db{t, n, x, now, rr}), R.Db{t, n, x, now, rr}), max, c, t, n, x, now, rr)
    case R.Own{o}:
      {==}
    case R.Bad{r}:
      {==}

def effect_db(c: R.Cmd, +db: R.Db) -> {Laws.final(R.exec_all(eff(c, db), R.db.at(0n, db))) == R.db.at(0n, R.db_of(R.exec(c, db))) : R.Db}:
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      effect_go(c, t, n, x, now, rr)

def replay_effs(cs: List<&2, R.Cmd>, +db: R.Db) -> {Laws.final(R.exec_all(effs(cs, db), R.db.at(0n, db))) == R.db.at(0n, Laws.final(R.exec_all(cs, db))) : R.Db}:
  match cs:
    case Nil{}:
      {==}
    case Con{+c, +rest}:
      %comp(eff(c, db), effs(rest, R.db_of(R.exec(c, db))), R.db.at(0n, db)) : {_ == R.db.at(0n, Laws.final(R.exec_all(Con{c, rest}, db))) : R.Db}
      %Equal.sym(R.Db, Laws.final(R.exec_all(eff(c, db), R.db.at(0n, db))), R.db.at(0n, R.db_of(R.exec(c, db))), effect_db(c, db)) : {Laws.final(R.exec_all(effs(rest, R.db_of(R.exec(c, db))), _)) == R.db.at(0n, Laws.final(R.exec_all(Con{c, rest}, db))) : R.Db}
      %fin_cons(c, rest, db) : {Laws.final(R.exec_all(effs(rest, R.db_of(R.exec(c, db))), R.db.at(0n, R.db_of(R.exec(c, db))))) == R.db.at(0n, _) : R.Db}
      replay_effs(rest, R.db_of(R.exec(c, db)))

def Laws.log_replay(cs, db):
  %effects_eq(cs, db) : {Laws.final(R.exec_all(_, R.db.at(0n, db))) == R.db.at(0n, Laws.final(R.exec_all(cs, db))) : R.Db}
  replay_effs(cs, db)

# Parsing back
# ------------
# A batch's effects, written as entries, parse back to themselves. A time
# an effect names is one a key keeps (a change is a good one: upd_good),
# so it is small, and what Nat.show writes of it reads back as a short
# number (num14_show): its digits, at most 14, with no leading 0.

# how many digits num14 has read once it has read n's, as Nat.show writes
# them with fuel f (15, too many, when the fuel runs out)
def nd(f: Nat, +n: Nat) -> Nat:
  match f:
    case 0n:
      15n
    case 1n+g:
      Bool.pick(Nat, Nat.is_eq(quot10(n), 0n), 1n, 1n+nd(g, quot10(n)))

def lt_weak(a: Nat, b: Nat) -> {Nat.is_lt(a, b) == True{} : Bool} -> {Nat.is_lt(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n _:
      e => {==}
    case 1n+p 0n:
      e => Empty.absurd({Nat.is_lt(1n+p, 1n) == True{} : Bool}, false_true(e))
    case 1n+p 1n+q:
      e => lt_weak(p, q)(e)

# the char Nat.show writes for a digit reads as that digit
def nch_dig(r: Dig, -t: String) -> {R.NDig{dval(r)} == R.nch(SCon{Chr{U32.from_nat(Nat.add(48n, dval(r)))}, t}) : R.NCh}:
  match r:
    case D0{}:
      {==}
    case D1{}:
      {==}
    case D2{}:
      {==}
    case D3{}:
      {==}
    case D4{}:
      {==}
    case D5{}:
      {==}
    case D6{}:
      {==}
    case D7{}:
      {==}
    case D8{}:
      {==}
    case D9{}:
      {==}

# the digits Nat.show.go writes in front of acc, read by num14, are acc
# read on after n's digits
def num14_fin(+g: Nat, q: Nat, -n: Nat, +r: Dig, +acc: String, ih: @m: Nat -> @t: String -> {le(m, g) == True{} : Bool} -> {Nat.is_lt(nd(g, m), 15n) == True{} : Bool} -> {R.num14(t, m, nd(g, m), True{}, R.n14.next(nd(g, m), m, R.nch(t))) == R.num14(Nat.show.go(g, m, t), 0n, 0n, False{}, R.nch(Nat.show.go(g, m, t))) : Maybe<&2, Nat>})
  -> {n == Nat.add(Nat.mul(q, 10n), dval(r)) : Nat}
  -> {le(q, g) == True{} : Bool}
  -> {Nat.is_lt(Bool.pick(Nat, Nat.is_eq(q, 0n), 1n, 1n+nd(g, q)), 15n) == True{} : Bool}
  -> {R.num14(acc, n, Bool.pick(Nat, Nat.is_eq(q, 0n), 1n, 1n+nd(g, q)), True{}, R.n14.next(Bool.pick(Nat, Nat.is_eq(q, 0n), 1n, 1n+nd(g, q)), n, R.nch(acc))) == R.num14(Nat.show.fin(g, acc, (Chr{U32.from_nat(Nat.add(48n, dval(r)))}, q)), 0n, 0n, False{}, R.nch(Nat.show.fin(g, acc, (Chr{U32.from_nat(Nat.add(48n, dval(r)))}, q)))) : Maybe<&2, Nat>}:
  match q:
    case 0n:
      sp => lq => lt =>
        %nch_dig(r, acc) : {R.num14(acc, n, 1n, True{}, R.n14.next(1n, n, R.nch(acc))) == R.num14(SCon{Chr{U32.from_nat(Nat.add(48n, dval(r)))}, acc}, 0n, 0n, False{}, _) : Maybe<&2, Nat>}
        %sp : {R.num14(acc, n, 1n, True{}, R.n14.next(1n, n, R.nch(acc))) == R.num14(acc, _, 1n, True{}, R.n14.next(1n, _, R.nch(acc))) : Maybe<&2, Nat>}
        {==}
    case 1n++p:
      sp => lq => +lt =>
        %ih(1n+p, SCon{Chr{U32.from_nat(Nat.add(48n, dval(r)))}, acc})(lq)(lt_weak(nd(g, 1n+p), 14n)(lt)) : {R.num14(acc, n, 1n+nd(g, 1n+p), True{}, R.n14.next(1n+nd(g, 1n+p), n, R.nch(acc))) == _ : Maybe<&2, Nat>}
        %nch_dig(r, acc) : {R.num14(acc, n, 1n+nd(g, 1n+p), True{}, R.n14.next(1n+nd(g, 1n+p), n, R.nch(acc))) == R.num14(SCon{Chr{U32.from_nat(Nat.add(48n, dval(r)))}, acc}, 1n+p, nd(g, 1n+p), True{}, R.n14.next(nd(g, 1n+p), 1n+p, _)) : Maybe<&2, Nat>}
        %Equal.sym(Bool, Nat.is_lt(nd(g, 1n+p), 14n), True{}, lt) : {R.num14(acc, n, 1n+nd(g, 1n+p), True{}, R.n14.next(1n+nd(g, 1n+p), n, R.nch(acc))) == R.num14(SCon{Chr{U32.from_nat(Nat.add(48n, dval(r)))}, acc}, 1n+p, nd(g, 1n+p), True{}, Bool.pick(R.NCh, Bool.and(_, Nat.is_lt(0n, 1n+p)), R.NDig{dval(r)}, R.NOther{})) : Maybe<&2, Nat>}
        %sp : {R.num14(acc, n, 1n+nd(g, 1n+p), True{}, R.n14.next(1n+nd(g, 1n+p), n, R.nch(acc))) == R.num14(acc, _, 1n+nd(g, 1n+p), True{}, R.n14.next(1n+nd(g, 1n+p), _, R.nch(acc))) : Maybe<&2, Nat>}
        {==}

def num14_go(f: Nat, +n: Nat, acc: String) -> {le(n, f) == True{} : Bool} -> {Nat.is_lt(nd(f, n), 15n) == True{} : Bool} -> {R.num14(acc, n, nd(f, n), True{}, R.n14.next(nd(f, n), n, R.nch(acc))) == R.num14(Nat.show.go(f, n, acc), 0n, 0n, False{}, R.nch(Nat.show.go(f, n, acc))) : Maybe<&2, Nat>}:
  match f:
    case 0n:
      e => lt => Empty.absurd({R.num14(acc, n, 15n, True{}, R.n14.next(15n, n, R.nch(acc))) == R.num14(acc, 0n, 0n, False{}, R.nch(acc)) : Maybe<&2, Nat>}, false_true(lt))
    case 1n++g:
      e => lt =>
        %divmod_10(n) : {R.num14(acc, n, nd(1n+g, n), True{}, R.n14.next(nd(1n+g, n), n, R.nch(acc))) == R.num14(Nat.show.fin(g, acc, Nat.show.put(_)), 0n, 0n, False{}, R.nch(Nat.show.fin(g, acc, Nat.show.put(_)))) : Maybe<&2, Nat>}
        num14_fin(g, quot10(n), n, rem10(n), acc, m => t => num14_go(g, m, t))(quot_spec(n))(le_quot(n, g)(e))(lt)

# a time small enough has 14 digits at most
def digits_quot(k: Nat, +n: Nat) -> {KV.digits.le(k, quot10(n)) == KV.digits.le(1n+k, n) : Bool}:
  %divmod_10(n) : {KV.digits.le(k, quot10(n)) == KV.digits.le(k, Pair.fst(Nat, Nat, _)) : Bool}
  {==}

def nd_q(-g: Nat, q: Nat, k: Nat, ih: @j: Nat -> @p2: Nat -> {KV.digits.le(1n+j, 1n+p2) == True{} : Bool} -> {le(1n+p2, g) == True{} : Bool} -> {Nat.is_lt(nd(g, 1n+p2), 2n+j) == True{} : Bool}) -> {KV.digits.le(k, q) == True{} : Bool} -> {le(q, g) == True{} : Bool} -> {Nat.is_lt(Bool.pick(Nat, Nat.is_eq(q, 0n), 1n, 1n+nd(g, q)), 2n+k) == True{} : Bool}:
  match q:
    case 0n:
      e => l => {==}
    case 1n+p2:
      match k:
        case 0n:
          e => l => Empty.absurd({Nat.is_lt(1n+nd(g, 1n+p2), 2n) == True{} : Bool}, false_true(e))
        case 1n+j:
          e => l => ih(j, p2)(e)(l)

def nd_le(f: Nat, +k: Nat, +p: Nat) -> {KV.digits.le(1n+k, 1n+p) == True{} : Bool} -> {le(1n+p, f) == True{} : Bool} -> {Nat.is_lt(nd(f, 1n+p), 2n+k) == True{} : Bool}:
  match f:
    case 0n:
      e => l => Empty.absurd({Nat.is_lt(15n, 2n+k) == True{} : Bool}, false_true(l))
    case 1n++g:
      e => l => nd_q(g, quot10(1n+p), k, j => p2 => nd_le(g, j, p2))(Equal.trans(Bool, KV.digits.le(k, quot10(1n+p)), KV.digits.le(1n+k, 1n+p), True{}, digits_quot(k, 1n+p), e))(le_quot(1n+p, g)(l))

# a small time, written by Nat.show, reads back as itself
def num14_show(+p: Nat, sm: {KV.small(1n+p) == True{} : Bool}) -> {Some{1n+p} == R.num14(Nat.show(1n+p), 0n, 0n, False{}, R.nch(Nat.show(1n+p))) : Maybe<&2, Nat>}:
  num14_go(2n+p, 1n+p, SNil{})(le_self(1n+p))(nd_le(2n+p, 13n, p)(sm)(le_self(1n+p)))

# an MSET's pairs, written as strings, read back as themselves
def pairs_rt(ps: List<&2, R.KVPair>) -> {Some{ps} == R.pairs(A.pair_args(ps)) : Maybe<&2, List<&2, R.KVPair>>}:
  match ps:
    case Nil{}:
      {==}
    case Con{R.KP{k, v}, rest}:
      %pairs_rt(rest) : {Some{Con{R.KP{k, v}, rest}} == R.pairs.put(k, v, _) : Maybe<&2, List<&2, R.KVPair>>}
      {==}

# a change's effects, written as entries, parse back to themselves: a
# time named is one a key keeps (clamped), so small
def exp_args(f: Nat, +k: String, -c: Nat) -> {KV.clamp(f) == f : Nat} -> {A.ch.effect(k, c, R.CExp{f}) == A.parse_all(A.args_all(A.ch.effect(k, c, R.CExp{f}))) : List<&2, R.Cmd>}:
  match f:
    case 0n:
      fx => {==}
    case 1n++p:
      fx =>
        %num14_show(p, fixed_small(p, fx)) : {[R.Upd{k, R.UExpire{R.TmN{True{}, 1n+p}, R.ExpIf{False{}, False{}, False{}, False{}}, "pexpireat"}}] == [R.exp.ttl.cmd(k, R.ExpIf{False{}, False{}, False{}, False{}}, R.tm.of.go(_, Nat.show(1n+p), True{}, False{}, False{}, "pexpireat"), "pexpireat")] : List<&2, R.Cmd>}
        {==}

def expg_args(f: Nat, +k: String, -w: KV.Val, -e: Nat, g: GoodExp(Some{KV.Item{w, e}}, f)) -> {A.ch.effect(k, 1n+e, R.CExp{f}) == A.parse_all(A.args_all(A.ch.effect(k, 1n+e, R.CExp{f}))) : List<&2, R.Cmd>}:
  (fx, nz) = g
  exp_args(f, k, 1n+e)(fx)

def put_args(f: Nat, +k: String, +v: String, -c: Nat) -> {KV.clamp(f) == f : Nat} -> {A.ch.effect(k, c, R.CPut{v, f}) == A.parse_all(A.args_all(A.ch.effect(k, c, R.CPut{v, f}))) : List<&2, R.Cmd>}:
  match f:
    case 0n:
      fx => {==}
    case 1n++p:
      fx =>
        %num14_show(p, fixed_small(p, fx)) : {[R.Upd{k, R.USet{v, 0n, R.TAt{R.TmN{True{}, 1n+p}}, "set"}}] == [R.set.ttl.cmd(k, v, 0n, False{}, R.tm.of.go(_, Nat.show(1n+p), True{}, False{}, True{}, "set"), "set")] : List<&2, R.Cmd>}
        {==}

# a SETRANGE that changes its key has a small offset
def range_small(+o: Nat, +s: String, ok: {R.range.go(o, s) == True{} : Bool}) -> {KV.small(o) == True{} : Bool}:
  and_l(KV.small(o), Nat.is_le(Nat.add(o, String.length(s)), 536870912n))(and_r(Bool.not(String.is_empty(s)), Bool.and(KV.small(o), Nat.is_le(Nat.add(o, String.length(s)), 536870912n)))(ok))

def range_args(o: Nat, +k: String, +a: String, -v: String, -c: Nat) -> {KV.small(o) == True{} : Bool} -> {A.ch.effect(k, c, R.CRange{o, a, v}) == A.parse_all(A.args_all(A.ch.effect(k, c, R.CRange{o, a, v}))) : List<&2, R.Cmd>}:
  match o:
    case 0n:
      sm => {==}
    case 1n++p:
      sm =>
        %num14_show(p, sm) : {[R.Upd{k, R.URange{1n+p, a}}] == [R.setrange.of(k, _, Nat.show(1n+p), a)] : List<&2, R.Cmd>}
        {==}

def range_args_go(+o: Nat, +k: String, +a: String, -v: String, -w: String, -e: Nat, g: GoodRange(Some{KV.Item{KV.VStr{w}, e}}, o, a, v)) -> {A.ch.effect(k, 1n+e, R.CRange{o, a, v}) == A.parse_all(A.args_all(A.ch.effect(k, 1n+e, R.CRange{o, a, v}))) : List<&2, R.Cmd>}:
  (ok, gv) = g
  range_args(o, k, a, v, 1n+e)(range_small(o, a, ok))

# a hash's pairs, written as HSET's arguments, read back
def hpairs_rt(ps: List<&2, KV.HPair>) -> {Some{ps} == R.hpairs(A.hpairs.args(ps)) : Maybe<&2, List<&2, KV.HPair>>}:
  match ps:
    case Nil{}:
      {==}
    case Con{KV.HP{+f, +v}, +rest}:
      %hpairs_rt(rest) : {Some{Con{KV.HP{f, v}, rest}} == R.hpairs.cons(KV.HP{f, v}, _) : Maybe<&2, List<&2, KV.HPair>>}
      {==}

# a hash's write, as the file logs it, parses back to itself: HSET of
# pairs, HDEL of fields, the script of a new hash
def hset_args(+k: String, ps: List<&2, KV.HPair>) -> NeP(ps) -> {[R.Upd{k, R.UHash{R.HWSet{ps, False{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{R.HWSet{ps, False{}}}}])) : List<&2, R.Cmd>}:
  match ps:
    case Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UHash{R.HWSet{Nil{}, False{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{R.HWSet{Nil{}, False{}}}}])) : List<&2, R.Cmd>}, ne)
    case Con{KV.HP{+f, +v}, +rest}:
      ne =>
        %hpairs_rt(rest) : {[R.Upd{k, R.UHash{R.HWSet{Con{KV.HP{f, v}, rest}, False{}}}}] == [R.parse_hset.of(k, R.hpairs.cons(KV.HP{f, v}, _), False{}, "hset")] : List<&2, R.Cmd>}
        {==}

def hdel_args(+k: String, fs: List<&2, String>) -> NeS(fs) -> {[R.Upd{k, R.UHash{R.HWDel{fs}}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{R.HWDel{fs}}}])) : List<&2, R.Cmd>}:
  match fs:
    case Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UHash{R.HWDel{Nil{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{R.HWDel{Nil{}}}}])) : List<&2, R.Cmd>}, ne)
    case Con{f, rest}:
      ne => {==}

def hnew_eval_args(+k: String, ps: List<&2, KV.HPair>) -> NeP(ps) -> {[R.Upd{k, R.UHash{R.HWNew{ps}}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{R.HWNew{ps}}}])) : List<&2, R.Cmd>}:
  match ps:
    case Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UHash{R.HWNew{Nil{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{R.HWNew{Nil{}}}}])) : List<&2, R.Cmd>}, ne)
    case Con{KV.HP{+f, +v}, +rest}:
      ne =>
        %hpairs_rt(rest) : {[R.Upd{k, R.UHash{R.HWNew{Con{KV.HP{f, v}, rest}}}}] == [R.parse_eval.of(True{}, k, R.hpairs.cons(KV.HP{f, v}, _))] : List<&2, R.Cmd>}
        {==}

def hash_args(op: R.HWrite, +k: String) -> GoodOp(op) -> {[R.Upd{k, R.UHash{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{op}}])) : List<&2, R.Cmd>}:
  match op:
    case R.HWSet{ps, False{}}:
      ne => hset_args(k, ps)(ne)
    case R.HWSet{ps, True{}}:
      g => Empty.absurd({[R.Upd{k, R.UHash{R.HWSet{ps, True{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{R.HWSet{ps, True{}}}}])) : List<&2, R.Cmd>}, g)
    case R.HWDel{fs}:
      ne => hdel_args(k, fs)(ne)
    case R.HWSetNx{f, v}:
      g => Empty.absurd({[R.Upd{k, R.UHash{R.HWSetNx{f, v}}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{R.HWSetNx{f, v}}}])) : List<&2, R.Cmd>}, g)
    case R.HWIncr{f, by}:
      g => Empty.absurd({[R.Upd{k, R.UHash{R.HWIncr{f, by}}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{R.HWIncr{f, by}}}])) : List<&2, R.Cmd>}, g)
    case R.HWNew{ps}:
      g => Empty.absurd({[R.Upd{k, R.UHash{R.HWNew{ps}}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{R.HWNew{ps}}}])) : List<&2, R.Cmd>}, g)
    case R.HWIncrF{f, by}:
      g => Empty.absurd({[R.Upd{k, R.UHash{R.HWIncrF{f, by}}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{R.HWIncrF{f, by}}}])) : List<&2, R.Cmd>}, g)

def ghash_op(-op: R.HWrite, -hv: KV.Hash, -h0: KV.Hash, g: {ch_of(R.hwrite(op, False{}, h0)) == R.CHash{op, hv} : R.Change} & GoodOp(op)) -> GoodOp(op):
  (gh, go) = g
  go

def hash_args_v(w: KV.Val, +op: R.HWrite, -hv: KV.Hash, +k: String) -> GoodHashV(w, op, hv) -> {[R.Upd{k, R.UHash{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{op}}])) : List<&2, R.Cmd>}:
  match w:
    case KV.VColl{KV.CHash{h0}}:
      g => hash_args(op, k)(ghash_op(op, hv, h0, g))
    case KV.VColl{KV.CList{l0}}:
      g => Empty.absurd({[R.Upd{k, R.UHash{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VStr{u}:
      g => Empty.absurd({[R.Upd{k, R.UHash{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VColl{KV.CMems{s0}}:
      g => Empty.absurd({[R.Upd{k, R.UHash{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VColl{KV.CZset{z0}}:
      g => Empty.absurd({[R.Upd{k, R.UHash{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VColl{KV.CStream{z0}}:
      g => Empty.absurd({[R.Upd{k, R.UHash{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UHash{op}}])) : List<&2, R.Cmd>}, g)

def hnew_args(b: Bool, +k: String, +ps: List<&2, KV.HPair>, ne: NeP(ps)) -> {A.hnew.effect(b, k, ps) == A.parse_all(A.args_all(A.hnew.effect(b, k, ps))) : List<&2, R.Cmd>}:
  match b:
    case True{}:
      hset_args(k, ps)(ne)
    case False{}:
      hnew_eval_args(k, ps)(ne)

# a list's write, as the file logs it, parses back to itself: a push of
# elements, a pop (of a count that reads as one), LSET, LINSERT, LREM and
# LTRIM (of numbers that read as ones), the script of a new list
def lpush_args(left: Bool, +k: String, xs: List<&2, String>) -> NeS(xs) -> {[R.Upd{k, R.UList{R.LWPush{left, xs}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWPush{left, xs}}}])) : List<&2, R.Cmd>}:
  match left xs:
    case True{} Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UList{R.LWPush{True{}, Nil{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWPush{True{}, Nil{}}}}])) : List<&2, R.Cmd>}, ne)
    case True{} Con{y, rest}:
      ne => {==}
    case False{} Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UList{R.LWPush{False{}, Nil{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWPush{False{}, Nil{}}}}])) : List<&2, R.Cmd>}, ne)
    case False{} Con{y, rest}:
      ne => {==}

def lpushx_args(left: Bool, +k: String, xs: List<&2, String>) -> NeS(xs) -> {[R.Upd{k, R.UList{R.LWPushX{left, xs}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWPushX{left, xs}}}])) : List<&2, R.Cmd>}:
  match left xs:
    case True{} Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UList{R.LWPushX{True{}, Nil{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWPushX{True{}, Nil{}}}}])) : List<&2, R.Cmd>}, ne)
    case True{} Con{y, rest}:
      ne => {==}
    case False{} Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UList{R.LWPushX{False{}, Nil{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWPushX{False{}, Nil{}}}}])) : List<&2, R.Cmd>}, ne)
    case False{} Con{y, rest}:
      ne => {==}

def lpop_args(left: Bool, +k: String) -> {[R.Upd{k, R.UList{R.LWPop{left}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWPop{left}}}])) : List<&2, R.Cmd>}:
  match left:
    case True{}:
      {==}
    case False{}:
      {==}

def lpopn_args(left: Bool, +k: String, +c: String) -> {Maybe.is_some(&2, Nat, R.lcount(c)) == True{} : Bool} -> {[R.Upd{k, R.UList{R.LWPopN{left, c}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWPopN{left, c}}}])) : List<&2, R.Cmd>}:
  match left:
    case True{}:
      ok => %Equal.sym(Bool, Maybe.is_some(&2, Nat, R.lcount(c)), True{}, ok) : {[R.Upd{k, R.UList{R.LWPopN{True{}, c}}}] == [R.parse_lpop.n(_, k, True{}, c)] : List<&2, R.Cmd>}
            {==}
    case False{}:
      ok => %Equal.sym(Bool, Maybe.is_some(&2, Nat, R.lcount(c)), True{}, ok) : {[R.Upd{k, R.UList{R.LWPopN{False{}, c}}}] == [R.parse_lpop.n(_, k, False{}, c)] : List<&2, R.Cmd>}
            {==}

def lrem_args(+k: String, +c: String, +v: String, ok: {R.lnum.ok(c) == True{} : Bool}) -> {[R.Upd{k, R.UList{R.LWRem{c, v}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWRem{c, v}}}])) : List<&2, R.Cmd>}:
  %Equal.sym(Bool, R.lnum.ok(c), True{}, ok) : {[R.Upd{k, R.UList{R.LWRem{c, v}}}] == [R.parse_lrem(_, k, c, v)] : List<&2, R.Cmd>}
  {==}

def ltrim_args(+k: String, +a: String, +b: String, ok: {Bool.and(R.lnum.ok(a), R.lnum.ok(b)) == True{} : Bool}) -> {[R.Upd{k, R.UList{R.LWTrim{a, b}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWTrim{a, b}}}])) : List<&2, R.Cmd>}:
  %Equal.sym(Bool, Bool.and(R.lnum.ok(a), R.lnum.ok(b)), True{}, ok) : {[R.Upd{k, R.UList{R.LWTrim{a, b}}}] == [R.parse_ltrim(_, k, a, b)] : List<&2, R.Cmd>}
  {==}

def list_args(op: R.LWrite, +k: String) -> GoodLOp(op) -> {[R.Upd{k, R.UList{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{op}}])) : List<&2, R.Cmd>}:
  match op:
    case R.LWPush{+left, +xs}:
      g => lpush_args(left, k, xs)(g)
    case R.LWPushX{+left, +xs}:
      g => lpushx_args(left, k, xs)(g)
    case R.LWPop{+left}:
      g => lpop_args(left, k)
    case R.LWPopN{+left, +c}:
      g => lpopn_args(left, k, c)(g)
    case R.LWSet{i, v}:
      g => {==}
    case R.LWBefore{p, v}:
      g => {==}
    case R.LWAfter{p, v}:
      g => {==}
    case R.LWRem{+c, +v}:
      g => lrem_args(k, c, v, g)
    case R.LWTrim{+a, +b}:
      g => ltrim_args(k, a, b, g)
    case R.LWNew{left, xs}:
      g => Empty.absurd({[R.Upd{k, R.UList{R.LWNew{left, xs}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWNew{left, xs}}}])) : List<&2, R.Cmd>}, g)

def glist_op(-op: R.LWrite, -l: KV.Deq, -l0: KV.Deq, g: {ch_of(R.lwrite(op, False{}, l0)) == R.CList{op, l} : R.Change} & GoodLOp(op)) -> GoodLOp(op):
  (gl, go) = g
  go

def list_args_v(w: KV.Val, +op: R.LWrite, -l: KV.Deq, +k: String) -> GoodListV(w, op, l) -> {[R.Upd{k, R.UList{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{op}}])) : List<&2, R.Cmd>}:
  match w:
    case KV.VColl{KV.CList{l0}}:
      g => list_args(op, k)(glist_op(op, l, l0, g))
    case KV.VColl{KV.CHash{h0}}:
      g => Empty.absurd({[R.Upd{k, R.UList{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VStr{u}:
      g => Empty.absurd({[R.Upd{k, R.UList{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VColl{KV.CMems{s0}}:
      g => Empty.absurd({[R.Upd{k, R.UList{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VColl{KV.CZset{z0}}:
      g => Empty.absurd({[R.Upd{k, R.UList{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VColl{KV.CStream{z0}}:
      g => Empty.absurd({[R.Upd{k, R.UList{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{op}}])) : List<&2, R.Cmd>}, g)

def lnew_eval_args(left: Bool, +k: String, xs: List<&2, String>) -> NeS(xs) -> {[R.Upd{k, R.UList{R.LWNew{left, xs}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWNew{left, xs}}}])) : List<&2, R.Cmd>}:
  match left xs:
    case True{} Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UList{R.LWNew{True{}, Nil{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWNew{True{}, Nil{}}}}])) : List<&2, R.Cmd>}, ne)
    case True{} Con{y, rest}:
      ne => {==}
    case False{} Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UList{R.LWNew{False{}, Nil{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UList{R.LWNew{False{}, Nil{}}}}])) : List<&2, R.Cmd>}, ne)
    case False{} Con{y, rest}:
      ne => {==}

def lnew_args(b: Bool, +k: String, +left: Bool, +xs: List<&2, String>, ne: NeS(xs)) -> {A.lnew.effect(b, k, left, xs) == A.parse_all(A.args_all(A.lnew.effect(b, k, left, xs))) : List<&2, R.Cmd>}:
  match b:
    case True{}:
      lpush_args(left, k, xs)(ne)
    case False{}:
      lnew_eval_args(left, k, xs)(ne)

def gl_ne(-left: Bool, -xs: List<&2, String>, -l: KV.Deq, g: GoodNewL(left, xs, l)) -> NeS(xs):
  (gn, ne) = g
  ne

# a set's write, as the file logs it, parses back to itself: SADD or
# SREM of members, the script of a new set
def sadd_args(+k: String, ms: List<&2, String>) -> NeS(ms) -> {[R.Upd{k, R.UMems{R.SWAdd{ms}}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{R.SWAdd{ms}}}])) : List<&2, R.Cmd>}:
  match ms:
    case Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UMems{R.SWAdd{Nil{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{R.SWAdd{Nil{}}}}])) : List<&2, R.Cmd>}, ne)
    case Con{y, rest}:
      ne => {==}

def srem_args(+k: String, ms: List<&2, String>) -> NeS(ms) -> {[R.Upd{k, R.UMems{R.SWRem{ms}}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{R.SWRem{ms}}}])) : List<&2, R.Cmd>}:
  match ms:
    case Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UMems{R.SWRem{Nil{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{R.SWRem{Nil{}}}}])) : List<&2, R.Cmd>}, ne)
    case Con{y, rest}:
      ne => {==}

def snew_eval_args(+k: String, ms: List<&2, String>) -> NeS(ms) -> {[R.Upd{k, R.UMems{R.SWNew{ms}}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{R.SWNew{ms}}}])) : List<&2, R.Cmd>}:
  match ms:
    case Nil{}:
      ne => Empty.absurd({[R.Upd{k, R.UMems{R.SWNew{Nil{}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{R.SWNew{Nil{}}}}])) : List<&2, R.Cmd>}, ne)
    case Con{y, rest}:
      ne => {==}

def mems_args(op: R.SWrite, +k: String) -> GoodSOp(op) -> {[R.Upd{k, R.UMems{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{op}}])) : List<&2, R.Cmd>}:
  match op:
    case R.SWAdd{ms}:
      g => sadd_args(k, ms)(g)
    case R.SWRem{ms}:
      g => srem_args(k, ms)(g)
    case R.SWNew{ms}:
      g => Empty.absurd({[R.Upd{k, R.UMems{R.SWNew{ms}}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{R.SWNew{ms}}}])) : List<&2, R.Cmd>}, g)
    case R.SWPop{r}:
      g => Empty.absurd({[R.Upd{k, R.UMems{R.SWPop{r}}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{R.SWPop{r}}}])) : List<&2, R.Cmd>}, g)
    case R.SWPopN{c, r}:
      g => Empty.absurd({[R.Upd{k, R.UMems{R.SWPopN{c, r}}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{R.SWPopN{c, r}}}])) : List<&2, R.Cmd>}, g)

def gmems_op(-op: R.SWrite, -sv: KV.Mems, -s0: KV.Mems, g: {ch_of(R.swrite(op, False{}, s0)) == R.CMems{op, sv} : R.Change} & GoodSOp(op)) -> GoodSOp(op):
  (gs, go) = g
  go

def mems_args_v(w: KV.Val, +op: R.SWrite, -sv: KV.Mems, +k: String) -> GoodMemsV(w, op, sv) -> {[R.Upd{k, R.UMems{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{op}}])) : List<&2, R.Cmd>}:
  match w:
    case KV.VColl{KV.CMems{s0}}:
      g => mems_args(op, k)(gmems_op(op, sv, s0, g))
    case KV.VColl{KV.CZset{z0}}:
      g => Empty.absurd({[R.Upd{k, R.UMems{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VColl{KV.CStream{z0}}:
      g => Empty.absurd({[R.Upd{k, R.UMems{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VColl{KV.CHash{h0}}:
      g => Empty.absurd({[R.Upd{k, R.UMems{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VColl{KV.CList{l0}}:
      g => Empty.absurd({[R.Upd{k, R.UMems{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{op}}])) : List<&2, R.Cmd>}, g)
    case KV.VStr{u}:
      g => Empty.absurd({[R.Upd{k, R.UMems{op}}] == A.parse_all(A.args_all([R.Upd{k, R.UMems{op}}])) : List<&2, R.Cmd>}, g)

def snew_args(b: Bool, +k: String, +ms: List<&2, String>, ne: NeS(ms)) -> {A.snew.effect(b, k, ms) == A.parse_all(A.args_all(A.snew.effect(b, k, ms))) : List<&2, R.Cmd>}:
  match b:
    case True{}:
      sadd_args(k, ms)(ne)
    case False{}:
      snew_eval_args(k, ms)(ne)

def gm_ne(-ms: List<&2, String>, -sv: KV.Mems, g: GoodNewM(ms, sv)) -> NeS(ms):
  (gn, ne) = g
  ne

# a sorted set's write, as the file logs it, parses back to itself: ZADD
# of options and pairs that pass ZADD's checks (its first score no
# option's word, so that ZADD's loop of options ends where the options,
# written in one order, end), ZREM of members, a removal of a range that
# reads, a pop of a count that reads, the script of a new sorted set
def zpairs_rt(ps: List<&2, R.ZPair>) -> {Some{ps} == R.zpairs(A.zpairs.args(ps)) : Maybe<&2, List<&2, R.ZPair>>}:
  match ps:
    case Nil{}:
      {==}
    case Con{R.ZPair{+s, +m}, +rest}:
      %zpairs_rt(rest) : {Some{Con{R.ZPair{s, m}, rest}} == R.zpairs.cons(R.ZPair{s, m}, _) : Maybe<&2, List<&2, R.ZPair>>}
      {==}

def some_none_r(-y: R.Reply, e: {Some{y} == None{} : Maybe<&2, R.Reply>}) -> Empty:
  true_false(Equal.cong(Maybe<&2, R.Reply>, Bool, z => Maybe.is_some(&2, R.Reply, z), Some{y}, None{}, e))

def word_zero(n: Nat) -> {Nat.is_eq(n, 0n) == True{} : Bool} -> {n == 0n : Nat}:
  match n:
    case 0n:
      e => {==}
    case 1n+p:
      e => Empty.absurd({1n+p == 0n : Nat}, false_true(e))

def check_first(first: Bool, -nxx: Bool, -gtl: Bool, -many: Bool, -ok: Bool) -> {R.zadd.check.of(first, nxx, gtl, many, ok) == None{} : Maybe<&2, R.Reply>} -> {first == True{} : Bool}:
  match first:
    case True{}:
      e => {==}
    case False{}:
      e => Empty.absurd({False{} == True{} : Bool}, some_none_r(R.RError{"ERR syntax error"}, e))

# ZADD's loop of options stops at a word that is no option's
def opts_tail(+s: String, +more: List<&2, String>, +o: R.ZOpts, w0: {R.zopt.word(s) == 0n : Nat}) -> {(o, Con{s, more}) == R.zadd.opts.go(Con{s, more}, R.zopt.word(s), o) : R.ZOpts & List<&2, String>}:
  %Equal.sym(Nat, R.zopt.word(s), 0n, w0) : {(o, Con{s, more}) == R.zadd.opts.go(Con{s, more}, _, o) : R.ZOpts & List<&2, String>}
  {==}

# ZADD and the script, past their options: the pairs read back, and pass
# the checks
def zadd_tail(+k: String, +o: R.ZOpts, +s: String, +m: String, +rest: List<&2, R.ZPair>, w0: {R.zopt.word(s) == 0n : Nat}, ck: {R.zadd.check(o, Con{R.ZPair{s, m}, rest}) == None{} : Maybe<&2, R.Reply>}) -> {[R.Upd{k, R.UZset{R.ZWAdd{o, Con{R.ZPair{s, m}, rest}}}}] == [R.parse_zadd.at(k, R.zadd.opts.go(Con{s, Con{m, A.zpairs.args(rest)}}, R.zopt.word(s), o))] : List<&2, R.Cmd>}:
  %opts_tail(s, Con{m, A.zpairs.args(rest)}, o, w0) : {[R.Upd{k, R.UZset{R.ZWAdd{o, Con{R.ZPair{s, m}, rest}}}}] == [R.parse_zadd.at(k, _)] : List<&2, R.Cmd>}
  %zpairs_rt(rest) : {[R.Upd{k, R.UZset{R.ZWAdd{o, Con{R.ZPair{s, m}, rest}}}}] == [R.parse_zadd.of(k, R.zpairs.cons(R.ZPair{s, m}, _), o)] : List<&2, R.Cmd>}
  %Equal.sym(Maybe<&2, R.Reply>, R.zadd.check(o, Con{R.ZPair{s, m}, rest}), None{}, ck) : {[R.Upd{k, R.UZset{R.ZWAdd{o, Con{R.ZPair{s, m}, rest}}}}] == [R.parse_zadd.ok(_, k, o, Con{R.ZPair{s, m}, rest})] : List<&2, R.Cmd>}
  {==}

def znew_tail(+k: String, +o: R.ZOpts, +s: String, +m: String, +rest: List<&2, R.ZPair>, w0: {R.zopt.word(s) == 0n : Nat}, xe: {R.zopts.xx(o) == False{} : Bool}, ck: {R.zadd.check(o, Con{R.ZPair{s, m}, rest}) == None{} : Maybe<&2, R.Reply>}) -> {[R.Upd{k, R.UZset{R.ZWNew{o, Con{R.ZPair{s, m}, rest}}}}] == [R.parse_eval.znew.of(True{}, k, Nat.show(R.zopts.count(o)), R.zadd.opts.go(Con{s, Con{m, A.zpairs.args(rest)}}, R.zopt.word(s), o))] : List<&2, R.Cmd>}:
  %opts_tail(s, Con{m, A.zpairs.args(rest)}, o, w0) : {[R.Upd{k, R.UZset{R.ZWNew{o, Con{R.ZPair{s, m}, rest}}}}] == [R.parse_eval.znew.of(True{}, k, Nat.show(R.zopts.count(o)), _)] : List<&2, R.Cmd>}
  %str_eq_self(Nat.show(R.zopts.count(o))) : {[R.Upd{k, R.UZset{R.ZWNew{o, Con{R.ZPair{s, m}, rest}}}}] == [R.parse_eval.znew.ps(Bool.and(True{}, Bool.and(_, Bool.not(R.zopts.xx(o)))), k, o, R.zpairs(Con{s, Con{m, A.zpairs.args(rest)}}))] : List<&2, R.Cmd>}
  %Equal.sym(Bool, R.zopts.xx(o), False{}, xe) : {[R.Upd{k, R.UZset{R.ZWNew{o, Con{R.ZPair{s, m}, rest}}}}] == [R.parse_eval.znew.ps(Bool.and(True{}, Bool.and(True{}, Bool.not(_))), k, o, R.zpairs(Con{s, Con{m, A.zpairs.args(rest)}}))] : List<&2, R.Cmd>}
  %zpairs_rt(rest) : {[R.Upd{k, R.UZset{R.ZWNew{o, Con{R.ZPair{s, m}, rest}}}}] == [R.parse_eval.znew.ps(True{}, k, o, R.zpairs.cons(R.ZPair{s, m}, _))] : List<&2, R.Cmd>}
  %Equal.sym(Maybe<&2, R.Reply>, R.zadd.check(o, Con{R.ZPair{s, m}, rest}), None{}, ck) : {[R.Upd{k, R.UZset{R.ZWNew{o, Con{R.ZPair{s, m}, rest}}}}] == [R.parse_eval.znew.fin(_, k, o, Con{R.ZPair{s, m}, rest})] : List<&2, R.Cmd>}
  {==}

# the options, as the file writes them, read back: one case for each of
# their 64 sets (generated)
def zadd_args6(nx: Bool, xx: Bool, gt: Bool, lt: Bool, ch: Bool, incr: Bool, +k: String, +s: String, +m: String, +rest: List<&2, R.ZPair>) -> {R.zopt.word(s) == 0n : Nat} -> {R.zadd.check(R.ZOpts{nx, xx, gt, lt, ch, incr}, Con{R.ZPair{s, m}, rest}) == None{} : Maybe<&2, R.Reply>} -> {[R.Upd{k, R.UZset{R.ZWAdd{R.ZOpts{nx, xx, gt, lt, ch, incr}, Con{R.ZPair{s, m}, rest}}}}] == A.parse_all(A.args_all([R.Upd{k, R.UZset{R.ZWAdd{R.ZOpts{nx, xx, gt, lt, ch, incr}, Con{R.ZPair{s, m}, rest}}}}])) : List<&2, R.Cmd>}:
  match nx xx gt lt ch incr:
    case False{} False{} False{} False{} False{} False{}:
      w0 => ck => zadd_tail(k, R.ZOpts{False{}, False{}, False{}, False{}, False{}, False{}}, s, m, rest, w0, ck)
    case False{} False{} False{} False{} False{} True{}:
      w0 => ck => zadd_tail(k, R.ZOpts{False{}, False{}, False{}, False{}, False{}, True{}}, s, m, rest, w0, ck)
    case False{} False{} False{} False{} True{} False{}:
