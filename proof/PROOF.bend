  -> {C.item.find(items2, String.to_lower(n)) == Some{Laws.with(C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}, nv)} : Maybe<&2, C.CItem>}:
  e =>
    sg.app(n, v, items, name, alias, imm, hidden, prot, multi, ty, app, old, nv, items2, e1)(Equal.trans(Result<&2, &2, R.Reply, List<&2, C.CItem>>, C.set.vals([C.val.mk(Done{nv}, C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}, String.to_lower(n))], items), C.set.vals([C.val.mk(C.item.set(C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}, v), C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}, String.to_lower(n))], items), Done{items2},
      Equal.cong(Result<&2, &2, String, String>, Result<&2, &2, R.Reply, List<&2, C.CItem>>, z => C.set.vals([C.val.mk(z, C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}, String.to_lower(n))], items), Done{nv}, C.item.set(C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}, v), Equal.sym(Result<&2, &2, String, String>, C.item.set(C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}, v), Done{nv}, e2)), e))

# a protected parameter: p is whether enable-protected-configs lets it change
def sg.p(p: Bool, +n: String, +v: String, +items: List<&2, C.CItem>, +name: String, +alias: String, +hidden: Bool, +multi: Bool, +ty: C.CTy, +app: C.CApp, +old: String, +nv: String, +items2: List<&2, C.CItem>, e1: {C.item.find(items, String.to_lower(n)) == Some{C.CItem{C.CParam{name, alias, False{}, hidden, True{}, multi, ty, app}, old}} : Maybe<&2, C.CItem>}, e2: {C.item.set(C.CItem{C.CParam{name, alias, False{}, hidden, True{}, multi, ty, app}, old}, v) == Done{nv} : Result<&2, &2, String, String>})
  -> {p == C.prot_ok(items) : Bool}
  -> {C.set.go([C.look.deny(False{}, Bool.not(C.prot_ok(items)), False{}, n, C.LOk{C.CItem{C.CParam{name, alias, False{}, hidden, True{}, multi, ty, app}, old}, String.to_lower(n), v})], items) == Done{items2} : Result<&2, &2, R.Reply, List<&2, C.CItem>>}
  -> {C.item.find(items2, String.to_lower(n)) == Some{Laws.with(C.CItem{C.CParam{name, alias, False{}, hidden, True{}, multi, ty, app}, old}, nv)} : Maybe<&2, C.CItem>}:
  match p:
    case True{}:
      ep => e => sg.ok(n, v, items, name, alias, False{}, hidden, True{}, multi, ty, app, old, nv, items2, e1, e2)(Equal.trans(Result<&2, &2, R.Reply, List<&2, C.CItem>>, C.set.go([C.look.deny(False{}, Bool.not(True{}), False{}, n, C.LOk{C.CItem{C.CParam{name, alias, False{}, hidden, True{}, multi, ty, app}, old}, String.to_lower(n), v})], items), C.set.go([C.look.deny(False{}, Bool.not(C.prot_ok(items)), False{}, n, C.LOk{C.CItem{C.CParam{name, alias, False{}, hidden, True{}, multi, ty, app}, old}, String.to_lower(n), v})], items), Done{items2}, Equal.cong(Bool, Result<&2, &2, R.Reply, List<&2, C.CItem>>, z => C.set.go([C.look.deny(False{}, Bool.not(z), False{}, n, C.LOk{C.CItem{C.CParam{name, alias, False{}, hidden, True{}, multi, ty, app}, old}, String.to_lower(n), v})], items), True{}, C.prot_ok(items), ep), e))
    case False{}:
      ep => e => Empty.absurd({C.item.find(items2, String.to_lower(n)) == Some{Laws.with(C.CItem{C.CParam{name, alias, False{}, hidden, True{}, multi, ty, app}, old}, nv)} : Maybe<&2, C.CItem>}, cfg_fail_done(R.RError{C.e.set(n, "can't set protected config")}, items2, Equal.trans(Result<&2, &2, R.Reply, List<&2, C.CItem>>, C.set.go([C.look.deny(False{}, Bool.not(False{}), False{}, n, C.LOk{C.CItem{C.CParam{name, alias, False{}, hidden, True{}, multi, ty, app}, old}, String.to_lower(n), v})], items), C.set.go([C.look.deny(False{}, Bool.not(C.prot_ok(items)), False{}, n, C.LOk{C.CItem{C.CParam{name, alias, False{}, hidden, True{}, multi, ty, app}, old}, String.to_lower(n), v})], items), Done{items2}, Equal.cong(Bool, Result<&2, &2, R.Reply, List<&2, C.CItem>>, z => C.set.go([C.look.deny(False{}, Bool.not(z), False{}, n, C.LOk{C.CItem{C.CParam{name, alias, False{}, hidden, True{}, multi, ty, app}, old}, String.to_lower(n), v})], items), False{}, C.prot_ok(items), ep), e)))

def sg.prot(+n: String, +v: String, +items: List<&2, C.CItem>, +name: String, +alias: String, +hidden: Bool, +prot: Bool, +multi: Bool, +ty: C.CTy, +app: C.CApp, +old: String, +nv: String, +items2: List<&2, C.CItem>, e1: {C.item.find(items, String.to_lower(n)) == Some{C.CItem{C.CParam{name, alias, False{}, hidden, prot, multi, ty, app}, old}} : Maybe<&2, C.CItem>}, e2: {C.item.set(C.CItem{C.CParam{name, alias, False{}, hidden, prot, multi, ty, app}, old}, v) == Done{nv} : Result<&2, &2, String, String>})
  -> {C.set.go([C.look.deny(False{}, Bool.and(prot, Bool.not(C.prot_ok(items))), False{}, n, C.LOk{C.CItem{C.CParam{name, alias, False{}, hidden, prot, multi, ty, app}, old}, String.to_lower(n), v})], items) == Done{items2} : Result<&2, &2, R.Reply, List<&2, C.CItem>>}
  -> {C.item.find(items2, String.to_lower(n)) == Some{Laws.with(C.CItem{C.CParam{name, alias, False{}, hidden, prot, multi, ty, app}, old}, nv)} : Maybe<&2, C.CItem>}:
  match prot:
    case True{}:
      e => sg.p(C.prot_ok(items), n, v, items, name, alias, hidden, multi, ty, app, old, nv, items2, e1, e2)({==})(e)
    case False{}:
      e => sg.ok(n, v, items, name, alias, False{}, hidden, False{}, multi, ty, app, old, nv, items2, e1, e2)(e)

def sg.imm(+n: String, +v: String, +items: List<&2, C.CItem>, +name: String, +alias: String, +imm: Bool, +hidden: Bool, +prot: Bool, +multi: Bool, +ty: C.CTy, +app: C.CApp, +old: String, +nv: String, +items2: List<&2, C.CItem>, e1: {C.item.find(items, String.to_lower(n)) == Some{C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}} : Maybe<&2, C.CItem>}, e2: {C.item.set(C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}, v) == Done{nv} : Result<&2, &2, String, String>})
  -> {C.set.go([C.look.deny(imm, Bool.and(prot, Bool.not(C.prot_ok(items))), False{}, n, C.LOk{C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}, String.to_lower(n), v})], items) == Done{items2} : Result<&2, &2, R.Reply, List<&2, C.CItem>>}
  -> {C.item.find(items2, String.to_lower(n)) == Some{Laws.with(C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}, nv)} : Maybe<&2, C.CItem>}:
  match imm:
    case True{}:
      e => Empty.absurd({C.item.find(items2, String.to_lower(n)) == Some{Laws.with(C.CItem{C.CParam{name, alias, True{}, hidden, prot, multi, ty, app}, old}, nv)} : Maybe<&2, C.CItem>}, cfg_fail_done(R.RError{C.e.set(n, "can't set immutable config")}, items2, e))
    case False{}:
      e => sg.prot(n, v, items, name, alias, hidden, prot, multi, ty, app, old, nv, items2, e1, e2)(e)

def sg.top(+n: String, +v: String, +items: List<&2, C.CItem>, it: C.CItem, +nv: String, +items2: List<&2, C.CItem>)
  -> {C.item.find(items, String.to_lower(n)) == Some{it} : Maybe<&2, C.CItem>}
  -> {C.item.set(it, v) == Done{nv} : Result<&2, &2, String, String>}
  -> {C.config.set([n, v], items) == Done{items2} : Result<&2, &2, R.Reply, List<&2, C.CItem>>}
  -> {C.item.find(items2, String.to_lower(n)) == Some{Laws.with(it, nv)} : Maybe<&2, C.CItem>}:
  match it:
    case C.CItem{C.CParam{+name, +alias, +imm, +hidden, +prot, +multi, +ty, +app}, +old}:
      +e1 => e2 => e3 =>
        sg.imm(n, v, items, name, alias, imm, hidden, prot, multi, ty, app, old, nv, items2, e1, e2)(Equal.trans(Result<&2, &2, R.Reply, List<&2, C.CItem>>, C.set.go([C.look.mk(Some{C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}}, n, v, Nil{}, C.prot_ok(items))], items), C.set.go([C.look.mk(C.item.find(items, String.to_lower(n)), n, v, Nil{}, C.prot_ok(items))], items), Done{items2}, Equal.cong(Maybe<&2, C.CItem>, Result<&2, &2, R.Reply, List<&2, C.CItem>>, z => C.set.go([C.look.mk(z, n, v, Nil{}, C.prot_ok(items))], items), Some{C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}}, C.item.find(items, String.to_lower(n)), Equal.sym(Maybe<&2, C.CItem>, C.item.find(items, String.to_lower(n)), Some{C.CItem{C.CParam{name, alias, imm, hidden, prot, multi, ty, app}, old}}, e1)), e3))

def Laws.config_set_get(n, v, items, it, nv, items2, e1, e2, e3):
  sg.top(n, v, items, it, nv, items2)(e1)(e2)(e3)

# The sweep of expired keys
# =========================
# A sweep deletes with DEL the keys R.reap.keys keeps, which are not there
# at now: so a key that is there is none of them, and DEL leaves it as it
# was (frame).

# a key that is there, and a key equal to it, is there
def reap_there(+t: KV.Trie<KV.Val>, +k: String, +j: String, +now: Nat, -y: KV.Item<KV.Val>, jk: {j == k : String}, e: {R.ent.live(now, KV.entry(KV.Val, t, j)) == Some{y} : Maybe<&2, KV.Item<KV.Val>>}) -> {Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))) == True{} : Bool}:
  %entry_at_eq(KV.Val, t, k) : {Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, _)) == True{} : Bool}
  %jk : {Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry(KV.Val, t, _))) == True{} : Bool}
  %Equal.sym(Maybe<&2, KV.Item<KV.Val>>, R.ent.live(now, KV.entry(KV.Val, t, j)), Some{y}, e) : {Maybe.is_some(&2, KV.Item<KV.Val>, _) == True{} : Bool}
  {==}

# a key the sweep keeps is not j, which is there
def reap_ne(c: Bool, +t: KV.Trie<KV.Val>, +k: String, +j: String, +now: Nat, -y: KV.Item<KV.Val>, -r: Bool)
  -> {c == KV.str_eq(j, k) : Bool}
  -> {False{} == Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))) : Bool}
  -> {R.ent.live(now, KV.entry(KV.Val, t, j)) == Some{y} : Maybe<&2, KV.Item<KV.Val>>}
  -> {r == False{} : Bool}
  -> {Bool.or(c, r) == False{} : Bool}:
  match c:
    case False{}:
      ec => eb => e => ih => ih
    case True{}:
      ec => eb => e => ih => Empty.absurd({Bool.or(True{}, r) == False{} : Bool}, false_true(Equal.trans(Bool, False{}, Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))), True{}, eb, reap_there(t, k, j, now, y, Laws.key_eq_true(j, k, Equal.sym(Bool, True{}, KV.str_eq(j, k), ec)), e))))

def reap_k(b: Bool, +k: String, +j: String, +t: KV.Trie<KV.Val>, +now: Nat, -y: KV.Item<KV.Val>, -ks: List<&2, String>)
  -> {b == Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))) : Bool}
  -> {Laws.any_key(j, ks) == False{} : Bool}
  -> {R.ent.live(now, KV.entry(KV.Val, t, j)) == Some{y} : Maybe<&2, KV.Item<KV.Val>>}
  -> {Laws.any_key(j, R.reap.put(b, k, ks)) == False{} : Bool}:
  match b:
    case True{}:
      eb => ih => e => ih
    case False{}:
      eb => ih => e => reap_ne(KV.str_eq(j, k), t, k, j, now, y, Laws.any_key(j, ks))({==})(eb)(e)(ih)

# none of the keys the sweep keeps is j, which is there
def reap_none(ks: List<&2, String>, +t: KV.Trie<KV.Val>, +n: Nat, +x: Nat, +now: Nat, +rr: Maybe<&2, R.Db>, +j: String, -y: KV.Item<KV.Val>) -> {R.ent.live(now, KV.entry(KV.Val, t, j)) == Some{y} : Maybe<&2, KV.Item<KV.Val>>} -> {Laws.any_key(j, R.reap.keys(ks, R.Db{t, n, x, now, rr})) == False{} : Bool}:
  match ks:
    case Nil{}:
      e => {==}
    case Con{+k, +rest}:
      +e => reap_k(Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))), k, j, t, now, y, R.reap.keys(rest, R.Db{t, n, x, now, rr}))({==})(reap_none(rest, t, n, x, now, rr, j, y)(e))(e)

def Laws.reap_keeps(ks, db, j, y, e):
  match db:
    case R.Db{+t, +n, +x, +now, +rr}:
      Laws.frame(R.Del{R.reap.keys(ks, R.Db{t, n, x, now, rr})}, R.Db{t, n, x, now, rr}, j, reap_none(ks, t, n, x, now, rr, j, y)(e))

# The key count
# =============
# The counts of every database are its trie's own after any history
# (Laws.counts_hold): every act keeps them so, and every command, whose
# writes change the counts as they change the trie. A write of a key
# weighs the trie as it weighs the key's bucket, in terms of the key's
# code before it (tsum_mod, tsum_del: through the 16 subtries of each
# node, slot0 to slot15), and in the bucket it weighs the new entry more
# and the entry it replaces less (bset_sum, bkeep_sum, bexp_sum,
# bdel_sum); the writes keep the trie well formed (twf_mod, twf_del),
# which a delete needs: it takes every entry of its key.

# what the entry of code c weighs (nothing for no entry); what it weighs
# with its time kept (a new entry has none); and with the time e
def dead(+w: Laws.Wt, c: Nat) -> Nat:
  match c:
    case 0n:
      0n
    case 1n+e:
      Laws.wt(w, e)

def kept(+w: Laws.Wt, c: Nat) -> Nat:
  match c:
    case 0n:
      Laws.wt(w, 0n)
    case 1n+e:
      Laws.wt(w, e)

def timew(+w: Laws.Wt, c: Nat, +e: Nat) -> Nat:
  match c:
    case 0n:
      0n
    case 1n+x:
      Laws.wt(w, e)

# sums of naturals: neither how their terms group nor the order of two
# matters
def add_assoc(a: Nat, -b: Nat, -c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(a, Nat.add(b, c)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, x => 1n+x, Nat.add(Nat.add(p, b), c), Nat.add(p, Nat.add(b, c)), add_assoc(p, b, c))

def add_comm(a: Nat, +b: Nat) -> {Nat.add(a, b) == Nat.add(b, a) : Nat}:
  match a:
    case 0n:
      add_zero(b)
    case 1n+p:
      %Equal.sym(Nat, Nat.add(b, 1n+p), 1n+Nat.add(b, p), add_succ_r(b, p)) : {1n+Nat.add(p, b) == _ : Nat}
      Equal.cong(Nat, Nat, x => 1n+x, Nat.add(p, b), Nat.add(b, p), add_comm(p, b))

# the last two of three summed trade places
def add_swap(+a: Nat, +b: Nat, +c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(Nat.add(a, c), b) : Nat}:
  %Equal.sym(Nat, Nat.add(Nat.add(a, b), c), Nat.add(a, Nat.add(b, c)), add_assoc(a, b, c)) : {_ == Nat.add(Nat.add(a, c), b) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(a, c), b), Nat.add(a, Nat.add(c, b)), add_assoc(a, c, b)) : {Nat.add(a, Nat.add(b, c)) == _ : Nat}
  Equal.cong(Nat, Nat, x => Nat.add(a, x), Nat.add(b, c), Nat.add(c, b), add_comm(b, c))

# the first and the last of three summed trade places
def add_rot(+a: Nat, +b: Nat, +c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(Nat.add(c, b), a) : Nat}:
  %Equal.sym(Nat, Nat.add(Nat.add(c, b), a), Nat.add(c, Nat.add(b, a)), add_assoc(c, b, a)) : {Nat.add(Nat.add(a, b), c) == _ : Nat}
  %add_comm(c, Nat.add(a, b)) : {_ == Nat.add(c, Nat.add(b, a)) : Nat}
  Equal.cong(Nat, Nat, x => Nat.add(c, x), Nat.add(a, b), Nat.add(b, a), add_comm(a, b))

# numbers whose successors are equal are equal
def nat_pred(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

def succ_inj(-a: Nat, -b: Nat, e: {1n+a == 1n+b : Nat}) -> {a == b : Nat}:
  Equal.cong(Nat, Nat, x => nat_pred(x), 1n+a, 1n+b, e)

# a successor is not 0
def nz(n: Nat) -> Type:
  match n:
    case 0n:
      Empty
    case 1n+p:
      Unit

def succ_zero(-n: Nat, e: {1n+n == 0n : Nat}) -> Empty:
  %e : nz(_)
  Unit{}

# a number Nat.is_eq finds 0 is 0
def zero_of(a: Nat) -> {Nat.is_eq(a, 0n) == True{} : Bool} -> {a == 0n : Nat}:
  match a:
    case 0n:
      e => {==}
    case 1n+p:
      e => Empty.absurd({1n+p == 0n : Nat}, false_true(e))

# a sum is the same with the same thing taken off both sides
def add_cancel(a: Nat, +b: Nat, +c: Nat) -> {Nat.add(b, a) == Nat.add(c, a) : Nat} -> {b == c : Nat}:
  match a:
    case 0n:
      e => %Equal.sym(Nat, b, Nat.add(b, 0n), add_zero(b)) : {_ == c : Nat}
           %Equal.sym(Nat, c, Nat.add(c, 0n), add_zero(c)) : {Nat.add(b, 0n) == _ : Nat}
           e
    case 1n+p:
      e => add_cancel(p, b, c)(succ_inj(Nat.add(b, p), Nat.add(c, p), Equal.trans(Nat, 1n+Nat.add(b, p), Nat.add(b, 1n+p), 1n+Nat.add(c, p), Equal.sym(Nat, Nat.add(b, 1n+p), 1n+Nat.add(b, p), add_succ_r(b, p)), Equal.trans(Nat, Nat.add(b, 1n+p), Nat.add(c, 1n+p), 1n+Nat.add(c, p), e, add_succ_r(c, p)))))

# a sum less what was added
def sub_of_add(+a: Nat, b: Nat, +c: Nat) -> {Nat.add(a, b) == c : Nat} -> {a == Nat.sub(c, b) : Nat}:
  match b:
    case 0n:
      e => %e : {a == Nat.sub(_, 0n) : Nat}
           %Equal.sym(Nat, Nat.sub(Nat.add(a, 0n), 0n), Nat.add(a, 0n), sub_zero(Nat.add(a, 0n))) : {a == _ : Nat}
           add_zero(a)
    case 1n++p:
      e => %e : {a == Nat.sub(_, 1n+p) : Nat}
           %Equal.sym(Nat, Nat.add(a, 1n+p), 1n+Nat.add(a, p), add_succ_r(a, p)) : {a == Nat.sub(_, 1n+p) : Nat}
           sub_of_add(a, p, Nat.add(a, p))({==})

# a step past an entry that is not k's: the entry's weight on both sides
def step_sum(+f: Nat, +t1: Nat, +d1: Nat, +r: Nat, +x: Nat) -> {Nat.add(t1, d1) == Nat.add(r, x) : Nat} -> {Nat.add(Nat.add(f, t1), d1) == Nat.add(Nat.add(f, r), x) : Nat}:
  e => %Equal.sym(Nat, Nat.add(Nat.add(f, t1), d1), Nat.add(f, Nat.add(t1, d1)), add_assoc(f, t1, d1)) : {_ == Nat.add(Nat.add(f, r), x) : Nat}
       %Equal.sym(Nat, Nat.add(Nat.add(f, r), x), Nat.add(f, Nat.add(r, x)), add_assoc(f, r, x)) : {Nat.add(f, Nat.add(t1, d1)) == _ : Nat}
       Equal.cong(Nat, Nat, z => Nat.add(f, z), Nat.add(t1, d1), Nat.add(r, x), e)

def step_del(+f: Nat, +t1: Nat, +d1: Nat, +r: Nat) -> {Nat.add(t1, d1) == r : Nat} -> {Nat.add(Nat.add(f, t1), d1) == Nat.add(f, r) : Nat}:
  e => %Equal.sym(Nat, Nat.add(Nat.add(f, t1), d1), Nat.add(f, Nat.add(t1, d1)), add_assoc(f, t1, d1)) : {_ == Nat.add(f, r) : Nat}
       Equal.cong(Nat, Nat, z => Nat.add(f, z), Nat.add(t1, d1), r, e)

# k, which heads a bucket that holds a key once, is not in its rest
def gone_once(-V: Data, +k: String, +key: String, -val: V, -ex: Nat, +rest: KV.Trie<V>, hs: {True{} == KV.str_eq(k, key) : Bool}, g: {Laws.bwf(V, KV.Ent{key, val, ex, rest}) == True{} : Bool}) -> {KV.bcode.go(V, k, rest, KV.bhead(V, k, rest)) == 0n : Nat}:
  %Equal.sym(String, k, key, refl_of(k, key, True{}, hs)) : {KV.bcode(V, _, rest) == 0n : Nat}
  zero_of(KV.bcode(V, key, rest))(and_l(Nat.is_eq(KV.bcode(V, key, rest), 0n), Laws.bwf(V, rest))(g))

# A write of k in a bucket weighs the new entry more and the entry it
# replaces less: SET (bset_sum), SET keeping the time (bkeep_sum), the
# time alone (bexp_sum), and, in a bucket that holds k once, a delete
# (bdel_sum). s is whether the bucket's head is k's (KV.bhead).
def bset_sum(-V: Data, +w: Laws.Wt, +k: String, +v: V, +e: Nat, b: KV.Trie<V>, s: Bool) -> {Nat.add(Laws.tsum(V, w, KV.bset.go(V, k, v, e, b, s)), dead(w, KV.bcode.go(V, k, b, s))) == Nat.add(Laws.tsum(V, w, b), Laws.wt(w, e)) : Nat}:
  match b s:
    case KV.Ent{key, val, +ex, +rest} True{}:
      add_rot(Laws.wt(w, e), Laws.tsum(V, w, rest), Laws.wt(w, ex))
    case KV.Ent{key, val, +ex, +rest} False{}:
      step_sum(Laws.wt(w, ex), Laws.tsum(V, w, KV.bset.go(V, k, v, e, rest, KV.bhead(V, k, rest))), dead(w, KV.bcode.go(V, k, rest, KV.bhead(V, k, rest))), Laws.tsum(V, w, rest), Laws.wt(w, e))(bset_sum(V, w, k, v, e, rest, KV.bhead(V, k, rest)))
    case KV.Tip{} _:
      %add_zero(Laws.wt(w, e)) : {Nat.add(_, 0n) == Laws.wt(w, e) : Nat}
      Equal.sym(Nat, Laws.wt(w, e), Nat.add(Laws.wt(w, e), 0n), add_zero(Laws.wt(w, e)))
    case KV.Node{+c0, +c1, +c2, +c3, +c4, +c5, +c6, +c7, +c8, +c9, +c10, +c11, +c12, +c13, +c14, +c15} _:
      %add_zero(Nat.add(Laws.wt(w, e), Laws.tsum(V, w, KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15}))) : {_ == Nat.add(Laws.tsum(V, w, KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15}), Laws.wt(w, e)) : Nat}
      add_comm(Laws.wt(w, e), Laws.tsum(V, w, KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15}))

def bkeep_sum(-V: Data, +w: Laws.Wt, +k: String, +v: V, b: KV.Trie<V>, s: Bool) -> {Nat.add(Laws.tsum(V, w, KV.bkeep.go(V, k, v, b, s)), dead(w, KV.bcode.go(V, k, b, s))) == Nat.add(Laws.tsum(V, w, b), kept(w, KV.bcode.go(V, k, b, s))) : Nat}:
  match b s:
    case KV.Ent{key, val, +ex, +rest} True{}:
      {==}
    case KV.Ent{key, val, +ex, +rest} False{}:
      step_sum(Laws.wt(w, ex), Laws.tsum(V, w, KV.bkeep.go(V, k, v, rest, KV.bhead(V, k, rest))), dead(w, KV.bcode.go(V, k, rest, KV.bhead(V, k, rest))), Laws.tsum(V, w, rest), kept(w, KV.bcode.go(V, k, rest, KV.bhead(V, k, rest))))(bkeep_sum(V, w, k, v, rest, KV.bhead(V, k, rest)))
    case KV.Tip{} _:
      %add_zero(Laws.wt(w, 0n)) : {Nat.add(_, 0n) == Laws.wt(w, 0n) : Nat}
      Equal.sym(Nat, Laws.wt(w, 0n), Nat.add(Laws.wt(w, 0n), 0n), add_zero(Laws.wt(w, 0n)))
    case KV.Node{+c0, +c1, +c2, +c3, +c4, +c5, +c6, +c7, +c8, +c9, +c10, +c11, +c12, +c13, +c14, +c15} _:
      %add_zero(Nat.add(Laws.wt(w, 0n), Laws.tsum(V, w, KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15}))) : {_ == Nat.add(Laws.tsum(V, w, KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15}), Laws.wt(w, 0n)) : Nat}
      add_comm(Laws.wt(w, 0n), Laws.tsum(V, w, KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15}))

def bexp_sum(-V: Data, +w: Laws.Wt, +k: String, +e: Nat, b: KV.Trie<V>, s: Bool) -> {Nat.add(Laws.tsum(V, w, KV.bexp.go(V, k, e, b, s)), dead(w, KV.bcode.go(V, k, b, s))) == Nat.add(Laws.tsum(V, w, b), timew(w, KV.bcode.go(V, k, b, s), e)) : Nat}:
  match b s:
    case KV.Ent{key, val, +ex, +rest} True{}:
      add_rot(Laws.wt(w, e), Laws.tsum(V, w, rest), Laws.wt(w, ex))
    case KV.Ent{key, val, +ex, +rest} False{}:
      step_sum(Laws.wt(w, ex), Laws.tsum(V, w, KV.bexp.go(V, k, e, rest, KV.bhead(V, k, rest))), dead(w, KV.bcode.go(V, k, rest, KV.bhead(V, k, rest))), Laws.tsum(V, w, rest), timew(w, KV.bcode.go(V, k, rest, KV.bhead(V, k, rest)), e))(bexp_sum(V, w, k, e, rest, KV.bhead(V, k, rest)))
    case KV.Tip{} _:
      {==}
    case KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15} _:
      {==}

# a delete of a key that the rest of the bucket lacks leaves it as it was
def bdel_none(-V: Data, +k: String, b: KV.Trie<V>, s: Bool) -> {s == KV.bhead(V, k, b) : Bool} -> {KV.bcode.go(V, k, b, s) == 0n : Nat} -> {KV.bdel.go(V, k, b, s) == b : KV.Trie<V>}:
  match b s:
    case KV.Ent{key, val, ex, rest} True{}:
      hs => e => Empty.absurd({KV.bdel.go(V, k, KV.Ent{key, val, ex, rest}, True{}) == KV.Ent{key, val, ex, rest} : KV.Trie<V>}, succ_zero(ex, e))
    case KV.Ent{key, val, ex, +rest} False{}:
      hs => e => Equal.cong(KV.Trie<V>, KV.Trie<V>, z => KV.Ent{key, val, ex, z}, KV.bdel.go(V, k, rest, KV.bhead(V, k, rest)), rest, bdel_none(V, k, rest, KV.bhead(V, k, rest))({==})(e))
    case KV.Tip{} _:
      hs => e => {==}
    case KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15} _:
      hs => e => {==}

def bdel_sum(-V: Data, +w: Laws.Wt, +k: String, b: KV.Trie<V>, s: Bool) -> {s == KV.bhead(V, k, b) : Bool} -> {Laws.bwf(V, b) == True{} : Bool} -> {Nat.add(Laws.tsum(V, w, KV.bdel.go(V, k, b, s)), dead(w, KV.bcode.go(V, k, b, s))) == Laws.tsum(V, w, b) : Nat}:
  match b s:
    case KV.Ent{+key, val, +ex, +rest} True{}:
      hs => g => %Equal.sym(KV.Trie<V>, KV.bdel.go(V, k, rest, KV.bhead(V, k, rest)), rest, bdel_none(V, k, rest, KV.bhead(V, k, rest))({==})(gone_once(V, k, key, val, ex, rest, hs, g))) : {Nat.add(Laws.tsum(V, w, _), Laws.wt(w, ex)) == Nat.add(Laws.wt(w, ex), Laws.tsum(V, w, rest)) : Nat}
                 add_comm(Laws.tsum(V, w, rest), Laws.wt(w, ex))
    case KV.Ent{+key, val, +ex, +rest} False{}:
      hs => g => step_del(Laws.wt(w, ex), Laws.tsum(V, w, KV.bdel.go(V, k, rest, KV.bhead(V, k, rest))), dead(w, KV.bcode.go(V, k, rest, KV.bhead(V, k, rest))), Laws.tsum(V, w, rest))(bdel_sum(V, w, k, rest, KV.bhead(V, k, rest))({==})(and_r(Nat.is_eq(KV.bcode(V, key, rest), 0n), Laws.bwf(V, rest))(g)))
    case KV.Tip{} _:
      hs => g => {==}
    case KV.Node{+c0, +c1, +c2, +c3, +c4, +c5, +c6, +c7, +c8, +c9, +c10, +c11, +c12, +c13, +c14, +c15} _:
      hs => g => Equal.sym(Nat, Laws.tsum(V, w, KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15}), Nat.add(Laws.tsum(V, w, KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15}), 0n), add_zero(Laws.tsum(V, w, KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15})))

# keys that compare unequal compare unequal either way
def str_ne_sym(+a: String, +b: String, nb: {False{} == KV.str_eq(a, b) : Bool}) -> {False{} == KV.str_eq(b, a) : Bool}:
  str_eq_ne(b, a, h => neq_eq(a, b, nb, Equal.sym(String, b, a, h)))

# a write of k leaves the code of another key j
def bcode_set_other(-V: Data, +j: String, +k: String, +v: V, +e: Nat, +b: KV.Trie<V>, +nb: {False{} == KV.str_eq(j, k) : Bool}) -> {KV.bcode(V, j, KV.bset(V, k, v, e, b)) == KV.bcode(V, j, b) : Nat}:
  %bcode_eq(V, j, KV.bset(V, k, v, e, b)) : {_ == KV.bcode(V, j, b) : Nat}
  %bcode_eq(V, j, b) : {Laws.item_code(V, KV.bent(V, j, KV.bset(V, k, v, e, b))) == _ : Nat}
  Equal.cong(Maybe<&2, KV.Item<V>>, Nat, m => Laws.item_code(V, m), KV.bent(V, j, KV.bset(V, k, v, e, b)), KV.bent(V, j, b), Equal.sym(Maybe<&2, KV.Item<V>>, KV.bent(V, j, b), KV.bent(V, j, KV.bset(V, k, v, e, b)), bent_bset_other(V, j, k, v, e, b, nb)))

def bcode_keep_other(-V: Data, +j: String, +k: String, +v: V, +b: KV.Trie<V>, +nb: {False{} == KV.str_eq(j, k) : Bool}) -> {KV.bcode(V, j, KV.bkeep(V, k, v, b)) == KV.bcode(V, j, b) : Nat}:
  %bcode_eq(V, j, KV.bkeep(V, k, v, b)) : {_ == KV.bcode(V, j, b) : Nat}
  %bcode_eq(V, j, b) : {Laws.item_code(V, KV.bent(V, j, KV.bkeep(V, k, v, b))) == _ : Nat}
  Equal.cong(Maybe<&2, KV.Item<V>>, Nat, m => Laws.item_code(V, m), KV.bent(V, j, KV.bkeep(V, k, v, b)), KV.bent(V, j, b), Equal.sym(Maybe<&2, KV.Item<V>>, KV.bent(V, j, b), KV.bent(V, j, KV.bkeep(V, k, v, b)), bent_bkeep_other(V, j, k, v, b, nb)))

def bcode_exp_other(-V: Data, +j: String, +k: String, +e: Nat, +b: KV.Trie<V>, +nb: {False{} == KV.str_eq(j, k) : Bool}) -> {KV.bcode(V, j, KV.bexp(V, k, e, b)) == KV.bcode(V, j, b) : Nat}:
  %bcode_eq(V, j, KV.bexp(V, k, e, b)) : {_ == KV.bcode(V, j, b) : Nat}
  %bcode_eq(V, j, b) : {Laws.item_code(V, KV.bent(V, j, KV.bexp(V, k, e, b))) == _ : Nat}
  Equal.cong(Maybe<&2, KV.Item<V>>, Nat, m => Laws.item_code(V, m), KV.bent(V, j, KV.bexp(V, k, e, b)), KV.bent(V, j, b), Equal.sym(Maybe<&2, KV.Item<V>>, KV.bent(V, j, b), KV.bent(V, j, KV.bexp(V, k, e, b)), bent_bexp_other(V, j, k, e, b, nb)))

def bcode_del_other(-V: Data, +j: String, +k: String, +b: KV.Trie<V>, +nb: {False{} == KV.str_eq(j, k) : Bool}) -> {KV.bcode(V, j, KV.bdel(V, k, b)) == KV.bcode(V, j, b) : Nat}:
  %bcode_eq(V, j, KV.bdel(V, k, b)) : {_ == KV.bcode(V, j, b) : Nat}
  %bcode_eq(V, j, b) : {Laws.item_code(V, KV.bent(V, j, KV.bdel(V, k, b))) == _ : Nat}
  Equal.cong(Maybe<&2, KV.Item<V>>, Nat, m => Laws.item_code(V, m), KV.bent(V, j, KV.bdel(V, k, b)), KV.bent(V, j, b), Equal.sym(Maybe<&2, KV.Item<V>>, KV.bent(V, j, b), KV.bent(V, j, KV.bdel(V, k, b)), bent_bdel_other(V, j, k, b, nb)))

# and the writes keep a bucket holding each key once

def bset_wf(-V: Data, +k: String, +v: V, +e: Nat, b: KV.Trie<V>, s: Bool) -> {s == KV.bhead(V, k, b) : Bool} -> {Laws.bwf(V, b) == True{} : Bool} -> {Laws.bwf(V, KV.bset.go(V, k, v, e, b, s)) == True{} : Bool}:
  match b s:
    case KV.Ent{+key, val, ex, +rest} True{}:
      hs => g => g
    case KV.Ent{+key, val, ex, +rest} False{}:
      hs => +g => and_true(Nat.is_eq(KV.bcode(V, key, KV.bset(V, k, v, e, rest)), 0n), Laws.bwf(V, KV.bset(V, k, v, e, rest)))(Equal.trans(Bool, Nat.is_eq(KV.bcode(V, key, KV.bset(V, k, v, e, rest)), 0n), Nat.is_eq(KV.bcode(V, key, rest), 0n), True{}, Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), KV.bcode(V, key, KV.bset(V, k, v, e, rest)), KV.bcode(V, key, rest), bcode_set_other(V, key, k, v, e, rest, str_ne_sym(k, key, hs))), and_l(Nat.is_eq(KV.bcode(V, key, rest), 0n), Laws.bwf(V, rest))(g)))(bset_wf(V, k, v, e, rest, KV.bhead(V, k, rest))({==})(and_r(Nat.is_eq(KV.bcode(V, key, rest), 0n), Laws.bwf(V, rest))(g)))
    case KV.Tip{} _:
      hs => g => {==}
    case KV.Node{c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15} _:
      hs => g => {==}

def bkeep_wf(-V: Data, +k: String, +v: V, b: KV.Trie<V>, s: Bool) -> {s == KV.bhead(V, k, b) : Bool} -> {Laws.bwf(V, b) == True{} : Bool} -> {Laws.bwf(V, KV.bkeep.go(V, k, v, b, s)) == True{} : Bool}:
  match b s:
    case KV.Ent{+key, val, ex, +rest} True{}:
