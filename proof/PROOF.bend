    case False{}:
      ey => lx => eds => eds

def counted_purge_of(+k: String, +j: Nat, my: Maybe<&2, R.Db>, +xs: List<&2, R.Db>, +ds: R.Ds) -> {counted_mdb(my) == True{} : Bool} -> {Laws.counted_list(xs) == True{} : Bool} -> {Laws.counted_ds(ds) == True{} : Bool} -> {Laws.counted_ds(R.ds_of(R.act.ok(R.ds.purge.of(k, j, my, xs, ds)))) == True{} : Bool}:
