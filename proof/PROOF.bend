  +ok => counted_mk(KV.expire.at(KV.Val, t, k, f, h), n, R.cnt.x(1n+q, f, x), now, rr)(wf_expire(KV.Val, t, k, f, h)(counted_wf(t, n, x, now, rr)(ok)))(Equal.trans(Nat, n, Laws.tsum(KV.Val, Laws.WAll{}, t), Laws.tsum(KV.Val, Laws.WAll{}, KV.expire.at(KV.Val, t, k, f, h)), counted_n(t, n, x, now, rr)(ok), Equal.sym(Nat, Laws.tsum(KV.Val, Laws.WAll{}, KV.expire.at(KV.Val, t, k, f, h)), Laws.tsum(KV.Val, Laws.WAll{}, t), n_same(KV.code.at(KV.Val, t, k, h), Laws.tsum(KV.Val, Laws.WAll{}, t), Laws.tsum(KV.Val, Laws.WAll{}, KV.expire.at(KV.Val, t, k, f, h)), f)(sum_expire(KV.Val, Laws.WAll{}, t, k, f, h)(counted_wf(t, n, x, now, rr)(ok))))))(Equal.trans(Nat, R.cnt.x(1n+q, f, x), R.cnt.x(1n+q, f, Laws.tsum(KV.Val, Laws.WTimed{}, t)), Laws.tsum(KV.Val, Laws.WTimed{}, KV.expire.at(KV.Val, t, k, f, h)), Equal.cong(Nat, Nat, z => R.cnt.x(1n+q, f, z), x, Laws.tsum(KV.Val, Laws.WTimed{}, t), counted_x(t, n, x, now, rr)(ok)), Equal.sym(Nat, Laws.tsum(KV.Val, Laws.WTimed{}, KV.expire.at(KV.Val, t, k, f, h)), R.cnt.x(1n+q, f, Laws.tsum(KV.Val, Laws.WTimed{}, t)), x_set(1n+q, f, Laws.tsum(KV.Val, Laws.WTimed{}, t), Laws.tsum(KV.Val, Laws.WTimed{}, KV.expire.at(KV.Val, t, k, f, h)))(sum_expire_there(KV.Val, Laws.WTimed{}, t, k, f, h, q)(eC)(counted_wf(t, n, x, now, rr)(ok))))))

