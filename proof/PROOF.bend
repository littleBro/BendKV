def upd_key(o: R.Out, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String) -> {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.upd.put(t, k, KV.hash(k), o)), k) == KV.entry(KV.Val, T.db_of(T.upd.put(u, k, KV.hash(k), o)), k) : Maybe<&2, KV.Item<KV.Val>>}:
  match o:
    case R.Out{+r, +ch}:
      upd_ch_key(ch, r, t, u, k)

# a list of one key names it
def any_self(+k: String) -> {Laws.any_key(k, [k]) == True{} : Bool}:
  %str_eq_self(k) : {Bool.or(_, False{}) == True{} : Bool}
  {==}

def loc_key_del(ks: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> {keyed(R.Del{ks}) == True{} : Bool} -> {KV.entry(KV.Val, t, key_of(R.Del{ks})) == KV.entry(KV.Val, u, key_of(R.Del{ks})) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.exec(R.Del{ks}, t, now)), key_of(R.Del{ks})) == KV.entry(KV.Val, T.db_of(T.exec(R.Del{ks}, u, now)), key_of(R.Del{ks})) : Maybe<&2, KV.Item<KV.Val>>}:
  match ks:
    case Nil{}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.Del{Nil{}}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.Del{Nil{}}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case Con{+k, Nil{}}:
      kd => e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.exec(R.Del{[k]}, t, now)), k), None{}, KV.entry(KV.Val, T.db_of(T.exec(R.Del{[k]}, u, now)), k), t_del_effect([k], t, k, now, any_self(k)), Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.exec(R.Del{[k]}, u, now)), k), None{}, t_del_effect([k], u, k, now, any_self(k))))
    case Con{+k, Con{j, rest}}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.Del{Con{k, Con{j, rest}}}, t, now)), k) == KV.entry(KV.Val, T.db_of(T.exec(R.Del{Con{k, Con{j, rest}}}, u, now)), k) : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))

def loc_key(c: R.Cmd, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> {keyed(c) == True{} : Bool} -> {KV.entry(KV.Val, t, key_of(c)) == KV.entry(KV.Val, u, key_of(c)) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.exec(c, t, now)), key_of(c)) == KV.entry(KV.Val, T.db_of(T.exec(c, u, now)), key_of(c)) : Maybe<&2, KV.Item<KV.Val>>}:
  match c:
    case R.Ping{}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.Ping{}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.Ping{}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.Echo{m}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.Echo{m}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.Echo{m}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.Get{+k}:
      kd => e => e
    case R.Set{+k, +v}:
      kd => e => set_key(t, u, k, v)
    case R.Del{ks}:
      loc_key_del(ks, t, u, now)
    case R.Exists{ks}:
      kd => e => e
    case R.IncrBy{+k, +by}:
      kd => +e => %get_read(t, k, now) : {KV.entry(KV.Val, T.db_of(T.incr.got(t, k, KV.hash(k), by, _)), k) == KV.entry(KV.Val, T.db_of(T.incr.got(u, k, KV.hash(k), by, KV.get_copy(u, k, now))), k) : Maybe<&2, KV.Item<KV.Val>>}
                  %get_read(u, k, now) : {KV.entry(KV.Val, T.db_of(T.incr.got(t, k, KV.hash(k), by, KV.got_of(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)))), k) == KV.entry(KV.Val, T.db_of(T.incr.got(u, k, KV.hash(k), by, _)), k) : Maybe<&2, KV.Item<KV.Val>>}
                  %e : {KV.entry(KV.Val, T.db_of(T.incr.got(t, k, KV.hash(k), by, KV.got_of(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)))), k) == KV.entry(KV.Val, T.db_of(T.incr.got(u, k, KV.hash(k), by, KV.got_of(Laws.live_val(KV.Val, _, now)))), k) : Maybe<&2, KV.Item<KV.Val>>}
                  incr_key(KV.got_of(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), t, u, k, by)(e)
    case R.MGet{ks}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.MGet{ks}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.MGet{ks}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.MSet{ps}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.MSet{ps}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.MSet{ps}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.DbSize{}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.DbSize{}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.DbSize{}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.FlushDb{}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.FlushDb{}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.FlushDb{}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.Keys{p}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.Keys{p}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.Keys{p}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.Sort{k, o}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.Sort{k, o}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.Sort{k, o}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.Scan{a}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.Scan{a}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.Scan{a}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.Peek{+k, o}:
      kd => e => e
    case R.Upd{+k, +op}:
      kd => +e => %entry_at_eq(KV.Val, t, k) : {KV.entry(KV.Val, T.db_of(T.upd.put(t, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, _)))), k) == KV.entry(KV.Val, T.db_of(T.upd.put(u, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, KV.entry.at(KV.Val, u, k, KV.hash(k)))))), k) : Maybe<&2, KV.Item<KV.Val>>}
                  %entry_at_eq(KV.Val, u, k) : {KV.entry(KV.Val, T.db_of(T.upd.put(t, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, KV.entry(KV.Val, t, k))))), k) == KV.entry(KV.Val, T.db_of(T.upd.put(u, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, _)))), k) : Maybe<&2, KV.Item<KV.Val>>}
                  %e : {KV.entry(KV.Val, T.db_of(T.upd.put(t, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, KV.entry(KV.Val, t, k))))), k) == KV.entry(KV.Val, T.db_of(T.upd.put(u, k, KV.hash(k), R.upd.v(op, now, R.ent.live(now, _)))), k) : Maybe<&2, KV.Item<KV.Val>>}
                  upd_key(R.upd.v(op, now, R.ent.live(now, KV.entry(KV.Val, t, k))), t, u, k)(e)
    case R.MSetNx{ps}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.MSetNx{ps}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.MSetNx{ps}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.Rename{s, d, nx}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.Rename{s, d, nx}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.Rename{s, d, nx}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.BitOp{op, d, srcs}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.BitOp{op, d, srcs}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.BitOp{op, d, srcs}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.LMove{op, d, srcs}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.LMove{op, d, srcs}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.LMove{op, d, srcs}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.LMPop{op, d, srcs}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.LMPop{op, d, srcs}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.LMPop{op, d, srcs}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.SOp{op, d}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.SOp{op, d}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.SOp{op, d}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))

    case R.SStore{op, d, srcs}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.SStore{op, d, srcs}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.SStore{op, d, srcs}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))

    case R.SMv{op, d, srcs}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.SMv{op, d, srcs}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.SMv{op, d, srcs}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.ZOp{op, ks}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.ZOp{op, ks}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.ZOp{op, ks}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.ZStore{op, d, srcs}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.ZStore{op, d, srcs}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.ZStore{op, d, srcs}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.ZRangeStore{d, s, q}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.ZRangeStore{d, s, q}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.ZRangeStore{d, s, q}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.ZMPop{ks, max, c}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.ZMPop{ks, max, c}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.ZMPop{ks, max, c}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.Own{o}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.Own{o}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.Own{o}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))
    case R.Bad{r}:
      kd => e => Empty.absurd({KV.entry(KV.Val, T.db_of(T.exec(R.Bad{r}, t, now)), "") == KV.entry(KV.Val, T.db_of(T.exec(R.Bad{r}, u, now)), "") : Maybe<&2, KV.Item<KV.Val>>}, false_true(kd))

def writes_del(ks: List<&2, String>, +j: String) -> {keyed(R.Del{ks}) == True{} : Bool} -> {False{} == KV.str_eq(j, key_of(R.Del{ks})) : Bool} -> {Laws.writes(R.Del{ks}, j) == False{} : Bool}:
  match ks:
    case Nil{}:
      kd => nb => Empty.absurd({Laws.writes(R.Del{Nil{}}, j) == False{} : Bool}, false_true(kd))
    case Con{k, Nil{}}:
      kd => nb => %nb : {Bool.or(_, False{}) == False{} : Bool}
                  {==}
    case Con{k, Con{i, rest}}:
      kd => nb => Empty.absurd({Laws.writes(R.Del{Con{k, Con{i, rest}}}, j) == False{} : Bool}, false_true(kd))

def writes_one(c: R.Cmd, +j: String) -> {keyed(c) == True{} : Bool} -> {False{} == KV.str_eq(j, key_of(c)) : Bool} -> {Laws.writes(c, j) == False{} : Bool}:
  match c:
    case R.Ping{}:
      kd => nb => Empty.absurd({Laws.writes(R.Ping{}, j) == False{} : Bool}, false_true(kd))
    case R.Echo{m}:
      kd => nb => Empty.absurd({Laws.writes(R.Echo{m}, j) == False{} : Bool}, false_true(kd))
    case R.Get{k}:
      kd => nb => {==}
    case R.Set{k, v}:
      kd => nb => Equal.sym(Bool, False{}, KV.str_eq(j, k), nb)
    case R.Del{ks}:
      writes_del(ks, j)
    case R.Exists{ks}:
      kd => nb => {==}
    case R.IncrBy{k, by}:
      kd => nb => Equal.sym(Bool, False{}, KV.str_eq(j, k), nb)
    case R.MGet{ks}:
      kd => nb => Empty.absurd({Laws.writes(R.MGet{ks}, j) == False{} : Bool}, false_true(kd))
    case R.MSet{ps}:
      kd => nb => Empty.absurd({Laws.writes(R.MSet{ps}, j) == False{} : Bool}, false_true(kd))
    case R.DbSize{}:
      kd => nb => Empty.absurd({Laws.writes(R.DbSize{}, j) == False{} : Bool}, false_true(kd))
    case R.FlushDb{}:
      kd => nb => Empty.absurd({Laws.writes(R.FlushDb{}, j) == False{} : Bool}, false_true(kd))
    case R.Keys{p}:
      kd => nb => Empty.absurd({Laws.writes(R.Keys{p}, j) == False{} : Bool}, false_true(kd))
    case R.Sort{k, o}:
      kd => nb => Empty.absurd({Laws.writes(R.Sort{k, o}, j) == False{} : Bool}, false_true(kd))
    case R.Scan{a}:
      kd => nb => Empty.absurd({Laws.writes(R.Scan{a}, j) == False{} : Bool}, false_true(kd))
    case R.Peek{k, o}:
      kd => nb => {==}
    case R.Upd{k, op}:
      kd => nb => Equal.sym(Bool, False{}, KV.str_eq(j, k), nb)
    case R.MSetNx{ps}:
      kd => nb => Empty.absurd({Laws.writes(R.MSetNx{ps}, j) == False{} : Bool}, false_true(kd))
    case R.Rename{s, d, nx}:
      kd => nb => Empty.absurd({Laws.writes(R.Rename{s, d, nx}, j) == False{} : Bool}, false_true(kd))
    case R.BitOp{op, d, srcs}:
      kd => nb => Empty.absurd({Laws.writes(R.BitOp{op, d, srcs}, j) == False{} : Bool}, false_true(kd))
    case R.LMove{op, d, srcs}:
      kd => nb => Empty.absurd({Laws.writes(R.LMove{op, d, srcs}, j) == False{} : Bool}, false_true(kd))
    case R.LMPop{op, d, srcs}:
      kd => nb => Empty.absurd({Laws.writes(R.LMPop{op, d, srcs}, j) == False{} : Bool}, false_true(kd))
    case R.SOp{op, d}:
      kd => nb => Empty.absurd({Laws.writes(R.SOp{op, d}, j) == False{} : Bool}, false_true(kd))

    case R.SStore{op, d, srcs}:
      kd => nb => Empty.absurd({Laws.writes(R.SStore{op, d, srcs}, j) == False{} : Bool}, false_true(kd))

    case R.SMv{op, d, srcs}:
      kd => nb => Empty.absurd({Laws.writes(R.SMv{op, d, srcs}, j) == False{} : Bool}, false_true(kd))
    case R.ZOp{op, ks}:
      kd => nb => Empty.absurd({Laws.writes(R.ZOp{op, ks}, j) == False{} : Bool}, false_true(kd))
    case R.ZStore{op, d, srcs}:
      kd => nb => Empty.absurd({Laws.writes(R.ZStore{op, d, srcs}, j) == False{} : Bool}, false_true(kd))
    case R.ZRangeStore{d, s, q}:
      kd => nb => Empty.absurd({Laws.writes(R.ZRangeStore{d, s, q}, j) == False{} : Bool}, false_true(kd))
    case R.ZMPop{ks, max, c}:
      kd => nb => Empty.absurd({Laws.writes(R.ZMPop{ks, max, c}, j) == False{} : Bool}, false_true(kd))
    case R.Own{o}:
      kd => nb => Empty.absurd({Laws.writes(R.Own{o}, j) == False{} : Bool}, false_true(kd))
    case R.Bad{r}:
      kd => nb => Empty.absurd({Laws.writes(R.Bad{r}, j) == False{} : Bool}, false_true(kd))

# a hypothesis about a key, for a key equal to it
def entry_at(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, -j: String, -k: String, ejk: {j == k : String}, e: {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>}) -> {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>}:
  %ejk : {KV.entry(KV.Val, t, _) == KV.entry(KV.Val, u, _) : Maybe<&2, KV.Item<KV.Val>>}
  e

def point_same(+c: R.Cmd, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat, +kd: {keyed(c) == True{} : Bool}, +ejk: {j == key_of(c) : String}, e: {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>}) -> {KV.entry(KV.Val, T.db_of(T.exec(c, t, now)), j) == KV.entry(KV.Val, T.db_of(T.exec(c, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  %Equal.sym(String, j, key_of(c), ejk) : {KV.entry(KV.Val, T.db_of(T.exec(c, t, now)), _) == KV.entry(KV.Val, T.db_of(T.exec(c, u, now)), _) : Maybe<&2, KV.Item<KV.Val>>}
  loc_key(c, t, u, now)(kd)(entry_at(t, u, j, key_of(c), ejk, e))

# a command on one key: a key j's entry after it depends only on j's
# entry before it
def point_key(+c: R.Cmd, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat, +kd: {keyed(c) == True{} : Bool}, b: Bool)
  -> {b == KV.str_eq(j, key_of(c)) : Bool}
  -> Reflect(String, j, key_of(c), b)
  -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>}
  -> {KV.entry(KV.Val, T.db_of(T.exec(c, t, now)), j) == KV.entry(KV.Val, T.db_of(T.exec(c, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case True{}:
      eb => ejk => e => point_same(c, t, u, j, now, kd, ejk, e)
    case False{}:
      +eb => ne => e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.exec(c, t, now)), j), KV.entry(KV.Val, t, j), KV.entry(KV.Val, T.db_of(T.exec(c, u, now)), j),
                          t_frame(c, t, j, now, writes_one(c, j)(kd)(eb)),
                          Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, t, j), KV.entry(KV.Val, u, j), KV.entry(KV.Val, T.db_of(T.exec(c, u, now)), j), e,
                            Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.exec(c, u, now)), j), KV.entry(KV.Val, u, j), t_frame(c, u, j, now, writes_one(c, j)(kd)(eb)))))

# a delete, or a set, of one key: a key with one entry in two tries has
# one entry after it
def del_same(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, -k: String, +j: String, +ejk: {j == k : String}) -> {KV.entry(KV.Val, KV.del(KV.Val, t, k), j) == KV.entry(KV.Val, KV.del(KV.Val, u, k), j) : Maybe<&2, KV.Item<KV.Val>>}:
  Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.del(KV.Val, t, k), j), None{}, KV.entry(KV.Val, KV.del(KV.Val, u, k), j), entry_del_eq(t, k, j, ejk), Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.del(KV.Val, u, k), j), None{}, entry_del_eq(u, k, j, ejk)))

def del_one_point(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +j: String, c: Bool) -> {c == KV.str_eq(j, k) : Bool} -> Reflect(String, j, k, c) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, KV.del(KV.Val, t, k), j) == KV.entry(KV.Val, KV.del(KV.Val, u, k), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match c:
    case True{}:
      eb => ejk => e => del_same(t, u, k, j, ejk)
    case False{}:
      +eb => ne => e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.del(KV.Val, t, k), j), KV.entry(KV.Val, t, j), KV.entry(KV.Val, KV.del(KV.Val, u, k), j), Laws.entry_del_other(KV.Val, t, k, j, Laws.key_eq_false(j, k, Equal.sym(Bool, False{}, KV.str_eq(j, k), eb))),
                          Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, t, j), KV.entry(KV.Val, u, j), KV.entry(KV.Val, KV.del(KV.Val, u, k), j), e, Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.del(KV.Val, u, k), j), KV.entry(KV.Val, u, j), Laws.entry_del_other(KV.Val, u, k, j, Laws.key_eq_false(j, k, Equal.sym(Bool, False{}, KV.str_eq(j, k), eb))))))

def set_same(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +v: String, +j: String, +ejk: {j == k : String}) -> {KV.entry(KV.Val, KV.set(KV.Val, t, k, KV.VStr{v}), j) == KV.entry(KV.Val, KV.set(KV.Val, u, k, KV.VStr{v}), j) : Maybe<&2, KV.Item<KV.Val>>}:
  %Equal.sym(String, j, k, ejk) : {KV.entry(KV.Val, KV.set(KV.Val, t, k, KV.VStr{v}), _) == KV.entry(KV.Val, KV.set(KV.Val, u, k, KV.VStr{v}), _) : Maybe<&2, KV.Item<KV.Val>>}
  set_key(t, u, k, v)

def set_one_point(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +v: String, +j: String, c: Bool) -> {c == KV.str_eq(j, k) : Bool} -> Reflect(String, j, k, c) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, KV.set(KV.Val, t, k, KV.VStr{v}), j) == KV.entry(KV.Val, KV.set(KV.Val, u, k, KV.VStr{v}), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match c:
    case True{}:
      eb => ejk => e => set_same(t, u, k, v, j, ejk)
    case False{}:
      +eb => ne => e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.set(KV.Val, t, k, KV.VStr{v}), j), KV.entry(KV.Val, t, j), KV.entry(KV.Val, KV.set(KV.Val, u, k, KV.VStr{v}), j), Laws.entry_setx_other(KV.Val, t, k, j, KV.VStr{v}, 0n, Laws.key_eq_false(j, k, Equal.sym(Bool, False{}, KV.str_eq(j, k), eb))),
                          Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, t, j), KV.entry(KV.Val, u, j), KV.entry(KV.Val, KV.set(KV.Val, u, k, KV.VStr{v}), j), e, Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.set(KV.Val, u, k, KV.VStr{v}), j), KV.entry(KV.Val, u, j), Laws.entry_setx_other(KV.Val, u, k, j, KV.VStr{v}, 0n, Laws.key_eq_false(j, k, Equal.sym(Bool, False{}, KV.str_eq(j, k), eb))))))

def del_point(ks: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, del_all(ks, t), j) == KV.entry(KV.Val, del_all(ks, u), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match ks:
    case Nil{}:
      e => e
    case Con{+k, +rest}:
      e => del_point(rest, KV.del(KV.Val, t, k), KV.del(KV.Val, u, k), j)(del_one_point(t, u, k, j, KV.str_eq(j, k))({==})(str_refl(j, k))(e))

def mset_point(ps: List<&2, R.KVPair>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.mset_pairs(ps, t), j) == KV.entry(KV.Val, T.mset_pairs(ps, u), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match ps:
    case Nil{}:
      e => e
    case Con{R.KP{+k, +v}, +rest}:
      e => mset_point(rest, KV.set(KV.Val, t, k, KV.VStr{v}), KV.set(KV.Val, u, k, KV.VStr{v}), j)(set_one_point(t, u, k, v, j, KV.str_eq(j, k))({==})(str_refl(j, k))(e))

# Keys that agree
# ---------------
# A command's writes depend on what its key holds, and on what the keys
# of deps hold (MSETNX's keys, RENAME's two keys). Agree(t, u, ks): the
# keys of ks have one entry in t and in u.
def Agree(t: KV.Trie<KV.Val>, u: KV.Trie<KV.Val>, ks: List<&2, String>) -> Data:
  match ks:
    case Nil{}:
      Unit
    case Con{k, rest}:
      Sigma<&2, &2, {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>}, _ => Agree(t, u, rest)>

def ag_head(-t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -k: String, -rest: List<&2, String>, ag: Agree(t, u, Con{k, rest})) -> {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>}:
  (h, r) = ag
  h

def ag_tail(-t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -k: String, -rest: List<&2, String>, ag: Agree(t, u, Con{k, rest})) -> Agree(t, u, rest):
  (h, r) = ag
  r

# a key's entry through the walk with its hash given
def at_agree(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, e: {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>}) -> {KV.entry.at(KV.Val, t, k, KV.hash(k)) == KV.entry.at(KV.Val, u, k, KV.hash(k)) : Maybe<&2, KV.Item<KV.Val>>}:
  Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry.at(KV.Val, t, k, KV.hash(k)), KV.entry(KV.Val, t, k), KV.entry.at(KV.Val, u, k, KV.hash(k)),
    Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, t, k), KV.entry.at(KV.Val, t, k, KV.hash(k)), entry_at_eq(KV.Val, t, k)),
    Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, t, k), KV.entry(KV.Val, u, k), KV.entry.at(KV.Val, u, k, KV.hash(k)), e, entry_at_eq(KV.Val, u, k)))

# MSETNX's verdict, in two tries that agree on its keys
def live_step(+k: String, -rest: List<&2, R.KVPair>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat, h: {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>}, ih: {R.pairs.live(rest, now, t) == R.pairs.live(rest, now, u) : Bool}) -> {Bool.or(Maybe.is_some(&2, KV.Val, KV.read(KV.Val, t, k, now)), R.pairs.live(rest, now, t)) == Bool.or(Maybe.is_some(&2, KV.Val, KV.read(KV.Val, u, k, now)), R.pairs.live(rest, now, u)) : Bool}:
  %read_eq(t, k, now) : {Bool.or(Maybe.is_some(&2, KV.Val, _), R.pairs.live(rest, now, t)) == Bool.or(Maybe.is_some(&2, KV.Val, KV.read(KV.Val, u, k, now)), R.pairs.live(rest, now, u)) : Bool}
  %read_eq(u, k, now) : {Bool.or(Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), R.pairs.live(rest, now, t)) == Bool.or(Maybe.is_some(&2, KV.Val, _), R.pairs.live(rest, now, u)) : Bool}
  %h : {Bool.or(Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), R.pairs.live(rest, now, t)) == Bool.or(Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, _, now)), R.pairs.live(rest, now, u)) : Bool}
  %ih : {Bool.or(Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), R.pairs.live(rest, now, t)) == Bool.or(Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), _) : Bool}
  {==}

def live_agree(ps: List<&2, R.KVPair>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> Agree(t, u, Laws.pair_keys(ps)) -> {R.pairs.live(ps, now, t) == R.pairs.live(ps, now, u) : Bool}:
  match ps:
    case Nil{}:
      ag => {==}
    case Con{R.KP{+k, +v}, +rest}:
      +ag => live_step(k, rest, t, u, now, ag_head(t, u, k, Laws.pair_keys(rest), ag), live_agree(rest, t, u, now)(ag_tail(t, u, k, Laws.pair_keys(rest), ag)))

# RENAME's verdict, in two tries that agree on its keys
def pick_eq(-ms1: Maybe<&2, KV.Item<KV.Val>>, -ms2: Maybe<&2, KV.Item<KV.Val>>, -md1: Maybe<&2, KV.Item<KV.Val>>, -md2: Maybe<&2, KV.Item<KV.Val>>, +s: String, +d: String, +nx: Bool, +now: Nat, es: {ms1 == ms2 : Maybe<&2, KV.Item<KV.Val>>}, ed: {md1 == md2 : Maybe<&2, KV.Item<KV.Val>>}) -> {T.ren.pick(ms1, md1, s, d, nx, now) == T.ren.pick(ms2, md2, s, d, nx, now) : R.Ren}:
  %es : {T.ren.pick(ms1, md1, s, d, nx, now) == T.ren.pick(_, md2, s, d, nx, now) : R.Ren}
  %ed : {T.ren.pick(ms1, md1, s, d, nx, now) == T.ren.pick(ms1, _, s, d, nx, now) : R.Ren}
  {==}

def ren_find_eq(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +s: String, +d: String, +nx: Bool, +now: Nat) -> Agree(t, u, [s, d]) -> {T.ren.find(t, s, d, nx, now) == T.ren.find(u, s, d, nx, now) : R.Ren}:
  +ag => pick_eq(KV.entry.at(KV.Val, t, s, KV.hash(s)), KV.entry.at(KV.Val, u, s, KV.hash(s)), KV.entry.at(KV.Val, t, d, KV.hash(d)), KV.entry.at(KV.Val, u, d, KV.hash(d)), s, d, nx, now,
           at_agree(t, u, s, ag_head(t, u, s, [d], ag)),
           at_agree(t, u, d, ag_head(t, u, d, Nil{}, ag_tail(t, u, s, [d], ag))))

# MSETNX's and RENAME's replies, for a given verdict, are the same in any
# trie
def msetnx_rep(b: Bool, -ps: List<&2, R.KVPair>, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>) -> {T.reply_of(T.msetnx(b, ps, t)) == T.reply_of(T.msetnx(b, ps, u)) : R.Reply}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def ren_rep(r: R.Ren, +nx: Bool, -s: String, -d: String, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>) -> {T.reply_of(T.ren(r, nx, s, d, t)) == T.reply_of(T.ren(r, nx, s, d, u)) : R.Reply}:
  match r:
    case R.RnNone{}:
      {==}
    case R.RnSame{}:
      {==}
    case R.RnHeld{}:
      {==}
    case R.RnMove{v, x}:
      {==}

# a set of one key with a time: a key with one entry in two tries has one
# entry after it
def setx_same(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +v: KV.Val, +x: Nat, +j: String, +ejk: {j == k : String}) -> {KV.entry(KV.Val, KV.setx(KV.Val, t, k, v, x), j) == KV.entry(KV.Val, KV.setx(KV.Val, u, k, v, x), j) : Maybe<&2, KV.Item<KV.Val>>}:
  %Equal.sym(String, j, k, ejk) : {KV.entry(KV.Val, KV.setx(KV.Val, t, k, v, x), _) == KV.entry(KV.Val, KV.setx(KV.Val, u, k, v, x), _) : Maybe<&2, KV.Item<KV.Val>>}
  Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.setx(KV.Val, t, k, v, x), k), Some{KV.Item{v, x}}, KV.entry(KV.Val, KV.setx(KV.Val, u, k, v, x), k), Laws.entry_setx_same(KV.Val, t, k, v, x), Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.setx(KV.Val, u, k, v, x), k), Some{KV.Item{v, x}}, Laws.entry_setx_same(KV.Val, u, k, v, x)))

def setx_one_point(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +v: KV.Val, +x: Nat, +j: String, c: Bool) -> {c == KV.str_eq(j, k) : Bool} -> Reflect(String, j, k, c) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, KV.setx(KV.Val, t, k, v, x), j) == KV.entry(KV.Val, KV.setx(KV.Val, u, k, v, x), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match c:
    case True{}:
      eb => ejk => e => setx_same(t, u, k, v, x, j, ejk)
    case False{}:
      +eb => ne => e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.setx(KV.Val, t, k, v, x), j), KV.entry(KV.Val, t, j), KV.entry(KV.Val, KV.setx(KV.Val, u, k, v, x), j), Laws.entry_setx_other(KV.Val, t, k, j, v, x, Laws.key_eq_false(j, k, Equal.sym(Bool, False{}, KV.str_eq(j, k), eb))),
                          Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, t, j), KV.entry(KV.Val, u, j), KV.entry(KV.Val, KV.setx(KV.Val, u, k, v, x), j), e, Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.setx(KV.Val, u, k, v, x), j), KV.entry(KV.Val, u, j), Laws.entry_setx_other(KV.Val, u, k, j, v, x, Laws.key_eq_false(j, k, Equal.sym(Bool, False{}, KV.str_eq(j, k), eb))))))

# MSETNX's and RENAME's writes, for a given verdict: a key with one entry
# in two tries has one entry after them
def msetnx_point(b: Bool, ps: List<&2, R.KVPair>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.msetnx(b, ps, t)), j) == KV.entry(KV.Val, T.db_of(T.msetnx(b, ps, u)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case True{}:
      e => e
    case False{}:
      mset_point(ps, t, u, j)

def ren_point(r: R.Ren, +nx: Bool, +s: String, +d: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.ren(r, nx, s, d, t)), j) == KV.entry(KV.Val, T.db_of(T.ren(r, nx, s, d, u)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match r:
    case R.RnNone{}:
      e => e
    case R.RnSame{}:
      e => e
    case R.RnHeld{}:
      e => e
    case R.RnMove{+v, +x}:
      e => del_one_point(KV.setx(KV.Val, t, d, v, x), KV.setx(KV.Val, u, d, v, x), s, j, KV.str_eq(j, s))({==})(str_refl(j, s))(setx_one_point(t, u, d, v, x, j, KV.str_eq(j, d))({==})(str_refl(j, d))(e))

# BITOP's value, in two tries that agree on its sources
def bitop_src_eq(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +now: Nat, h: {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>}) -> {R.bitop.src(t, now, k) == R.bitop.src(u, now, k) : String}:
  %read_eq(t, k, now) : {R.bitop.or_empty(_) == R.bitop.or_empty(KV.read(KV.Val, u, k, now)) : String}
  %read_eq(u, k, now) : {R.bitop.or_empty(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)) == R.bitop.or_empty(_) : String}
  %h : {R.bitop.or_empty(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)) == R.bitop.or_empty(Laws.live_val(KV.Val, _, now)) : String}
  {==}

def bitop_fold_eq(+op: R.BitK, srcs: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat, +acc: String) -> Agree(t, u, srcs) -> {R.bitop.fold(op, srcs, now, t, acc) == R.bitop.fold(op, srcs, now, u, acc) : String}:
  match srcs:
    case Nil{}:
      ag => {==}
    case Con{+k, +rest}:
      +ag => %bitop_src_eq(t, u, k, now, ag_head(t, u, k, rest, ag)) : {R.bitop.fold(op, rest, now, t, R.bitop.zip(op, acc, R.bitop.src(t, now, k), "")) == R.bitop.fold(op, rest, now, u, R.bitop.zip(op, acc, _, "")) : String}
             bitop_fold_eq(op, rest, t, u, now, R.bitop.zip(op, acc, R.bitop.src(t, now, k), ""))(ag_tail(t, u, k, rest, ag))

def bitop_val_eq(+op: R.BitK, srcs: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> Agree(t, u, srcs) -> {R.bitop.val(op, srcs, now, t) == R.bitop.val(op, srcs, now, u) : String}:
  match srcs:
    case Nil{}:
      ag => {==}
    case Con{+k, +rest}:
      +ag => %bitop_src_eq(t, u, k, now, ag_head(t, u, k, rest, ag)) : {R.bitop.fold(op, rest, now, t, R.bitop.first(op, R.bitop.src(t, now, k))) == R.bitop.fold(op, rest, now, u, R.bitop.first(op, _)) : String}
             bitop_fold_eq(op, rest, t, u, now, R.bitop.first(op, R.bitop.src(t, now, k)))(ag_tail(t, u, k, rest, ag))

# BITOP's verdict on its sources' types, in two tries that agree on them
def bitop_wrong_step(+k: String, -rest: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat, h: {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>}, ih: {R.bitop.wrong(rest, now, t) == R.bitop.wrong(rest, now, u) : Bool}) -> {Bool.or(R.is_coll(KV.read(KV.Val, t, k, now)), R.bitop.wrong(rest, now, t)) == Bool.or(R.is_coll(KV.read(KV.Val, u, k, now)), R.bitop.wrong(rest, now, u)) : Bool}:
  %read_eq(t, k, now) : {Bool.or(R.is_coll(_), R.bitop.wrong(rest, now, t)) == Bool.or(R.is_coll(KV.read(KV.Val, u, k, now)), R.bitop.wrong(rest, now, u)) : Bool}
  %read_eq(u, k, now) : {Bool.or(R.is_coll(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), R.bitop.wrong(rest, now, t)) == Bool.or(R.is_coll(_), R.bitop.wrong(rest, now, u)) : Bool}
  %h : {Bool.or(R.is_coll(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), R.bitop.wrong(rest, now, t)) == Bool.or(R.is_coll(Laws.live_val(KV.Val, _, now)), R.bitop.wrong(rest, now, u)) : Bool}
  %ih : {Bool.or(R.is_coll(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), R.bitop.wrong(rest, now, t)) == Bool.or(R.is_coll(Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now)), _) : Bool}
  {==}

def bitop_wrong_eq(srcs: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> Agree(t, u, srcs) -> {R.bitop.wrong(srcs, now, t) == R.bitop.wrong(srcs, now, u) : Bool}:
  match srcs:
    case Nil{}:
      ag => {==}
    case Con{+k, +rest}:
      +ag => bitop_wrong_step(k, rest, t, u, now, ag_head(t, u, k, rest, ag), bitop_wrong_eq(rest, t, u, now)(ag_tail(t, u, k, rest, ag)))

# BITOP's write, for a given value: a key with one entry in two tries has
# one entry after it
def bitop_point(e: Bool, +v: String, +d: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.bitop.t(e, v, d, t), j) == KV.entry(KV.Val, T.bitop.t(e, v, d, u), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match e:
    case True{}:
      h => del_one_point(t, u, d, j, KV.str_eq(j, d))({==})(str_refl(j, d))(h)
    case False{}:
      h => setx_one_point(t, u, d, KV.VStr{v}, 0n, j, KV.str_eq(j, d))({==})(str_refl(j, d))(h)

# BITOP's writes, for a given verdict on its sources' types
def bitop_go_point(w: Bool, +op: R.BitK, +srcs: List<&2, String>, +d: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat) -> Agree(t, u, srcs) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.bitop.go(w, op, srcs, d, t, now)), j) == KV.entry(KV.Val, T.db_of(T.bitop.go(w, op, srcs, d, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match w:
    case True{}:
      ag => e => e
    case False{}:
      ag => e => %bitop_val_eq(op, srcs, t, u, now)(ag) : {KV.entry(KV.Val, T.bitop.t(String.is_empty(R.bitop.val(op, srcs, now, t)), R.bitop.val(op, srcs, now, t), d, t), j) == KV.entry(KV.Val, T.bitop.t(String.is_empty(_), _, d, u), j) : Maybe<&2, KV.Item<KV.Val>>}
                 bitop_point(String.is_empty(R.bitop.val(op, srcs, now, t)), R.bitop.val(op, srcs, now, t), d, t, u, j)(e)

def bitop_go_rep(w: Bool, +op: R.BitK, +srcs: List<&2, String>, +d: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> Agree(t, u, srcs) -> {T.reply_of(T.bitop.go(w, op, srcs, d, t, now)) == T.reply_of(T.bitop.go(w, op, srcs, d, u, now)) : R.Reply}:
  match w:
    case True{}:
      ag => {==}
    case False{}:
      ag => %bitop_val_eq(op, srcs, t, u, now)(ag) : {T.reply_of(T.bitop(R.bitop.val(op, srcs, now, t), d, t)) == T.reply_of(T.bitop(_, d, u)) : R.Reply}
            {==}

# a keep of one key: a key with one entry in two tries has one entry
# after it
def keep_same(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +v: KV.Val, +j: String, +ejk: {j == k : String}, e: {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>}) -> {KV.entry(KV.Val, KV.keep(KV.Val, t, k, v), j) == KV.entry(KV.Val, KV.keep(KV.Val, u, k, v), j) : Maybe<&2, KV.Item<KV.Val>>}:
  %Equal.sym(String, j, k, ejk) : {KV.entry(KV.Val, KV.keep(KV.Val, t, k, v), _) == KV.entry(KV.Val, KV.keep(KV.Val, u, k, v), _) : Maybe<&2, KV.Item<KV.Val>>}
  keep_key(t, u, k, v)(entry_at(t, u, j, k, ejk, e))

def keep_one_point(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +v: KV.Val, +j: String, c: Bool) -> {c == KV.str_eq(j, k) : Bool} -> Reflect(String, j, k, c) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, KV.keep(KV.Val, t, k, v), j) == KV.entry(KV.Val, KV.keep(KV.Val, u, k, v), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match c:
    case True{}:
      eb => ejk => e => keep_same(t, u, k, v, j, ejk, e)
    case False{}:
      +eb => ne => e => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.keep(KV.Val, t, k, v), j), KV.entry(KV.Val, t, j), KV.entry(KV.Val, KV.keep(KV.Val, u, k, v), j), Laws.entry_keep_other(KV.Val, t, k, j, v, Laws.key_eq_false(j, k, Equal.sym(Bool, False{}, KV.str_eq(j, k), eb))),
                          Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, t, j), KV.entry(KV.Val, u, j), KV.entry(KV.Val, KV.keep(KV.Val, u, k, v), j), e, Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, KV.keep(KV.Val, u, k, v), j), KV.entry(KV.Val, u, j), Laws.entry_keep_other(KV.Val, u, k, j, v, Laws.key_eq_false(j, k, Equal.sym(Bool, False{}, KV.str_eq(j, k), eb))))))

# LMOVE's verdict, in two tries that agree on its keys
def mv_of_eq(-ms1: Maybe<&2, KV.Item<KV.Val>>, -ms2: Maybe<&2, KV.Item<KV.Val>>, -md1: Maybe<&2, KV.Item<KV.Val>>, -md2: Maybe<&2, KV.Item<KV.Val>>, +s: String, +d: String, +e: R.LEnds, +now: Nat, es: {ms1 == ms2 : Maybe<&2, KV.Item<KV.Val>>}, ed: {md1 == md2 : Maybe<&2, KV.Item<KV.Val>>}) -> {R.mv.of(R.ent.live(now, ms1), KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(e), R.ent.live(now, md1))) == R.mv.of(R.ent.live(now, ms2), KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(e), R.ent.live(now, md2))) : R.Mv}:
  %es : {R.mv.of(R.ent.live(now, ms1), KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(e), R.ent.live(now, md1))) == R.mv.of(R.ent.live(now, _), KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(e), R.ent.live(now, md2))) : R.Mv}
  %ed : {R.mv.of(R.ent.live(now, ms1), KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(e), R.ent.live(now, md1))) == R.mv.of(R.ent.live(now, ms1), KV.str_eq(s, d), R.mv.dst.ent(R.ends.fresh(e), R.ent.live(now, _))) : R.Mv}
  {==}

def mv_find_eq(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +s: String, +d: String, +e: R.LEnds, +now: Nat) -> Agree(t, u, [s, d]) -> {T.mv.find(t, s, d, e, now) == T.mv.find(u, s, d, e, now) : R.Mv}:
  +ag => mv_of_eq(KV.entry.at(KV.Val, t, s, KV.hash(s)), KV.entry.at(KV.Val, u, s, KV.hash(s)), KV.entry.at(KV.Val, t, d, KV.hash(d)), KV.entry.at(KV.Val, u, d, KV.hash(d)), s, d, e, now,
           at_agree(t, u, s, ag_head(t, u, s, [d], ag)),
           at_agree(t, u, d, ag_head(t, u, d, Nil{}, ag_tail(t, u, s, [d], ag))))

# LMOVE's writes, for a given verdict: a key with one entry in two tries
# has one entry after them
def mv_src_point(b: Bool, +s: String, +l: KV.Deq, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.mv.src(b, s, l, t), j) == KV.entry(KV.Val, T.mv.src(b, s, l, u), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case True{}:
      del_one_point(t, u, s, j, KV.str_eq(j, s))({==})(str_refl(j, s))
    case False{}:
      keep_one_point(t, u, s, KV.VColl{KV.CList{l}}, j, KV.str_eq(j, s))({==})(str_refl(j, s))

def mv_put_point(+s: String, +l: KV.Deq, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.mv.put(s, l, t), j) == KV.entry(KV.Val, T.mv.put(s, l, u), j) : Maybe<&2, KV.Item<KV.Val>>}:
  mv_src_point(Nat.is_eq(KV.deq.len(l), 0n), s, l, t, u, j)

def mv_self_point(p: KV.Pop, +e: R.LEnds, +s: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.mv.self(p, e, s, t)), j) == KV.entry(KV.Val, T.db_of(T.mv.self(p, e, s, u)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match p:
    case KV.Pop{+x, +l}:
      keep_one_point(t, u, s, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, l)}}, j, KV.str_eq(j, s))({==})(str_refl(j, s))
    case KV.PopNone{}:
      h => h

def mv_go_point(p: KV.Pop, +e: R.LEnds, +s: String, +d: String, dl: Maybe<&2, KV.Deq>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.mv.go(p, e, s, d, dl, t)), j) == KV.entry(KV.Val, T.db_of(T.mv.go(p, e, s, d, dl, u)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match p dl:
    case KV.Pop{+x, +l} Some{+q}:
      h => keep_one_point(T.mv.put(s, l, t), T.mv.put(s, l, u), d, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, q)}}, j, KV.str_eq(j, d))({==})(str_refl(j, d))(mv_put_point(s, l, t, u, j)(h))
    case KV.Pop{+x, +l} None{}:
      h => setx_one_point(T.mv.put(s, l, t), T.mv.put(s, l, u), d, KV.VColl{KV.CList{KV.deq.push(R.ends.to(e), x, KV.deq.empty())}}, 0n, j, KV.str_eq(j, d))({==})(str_refl(j, d))(mv_put_point(s, l, t, u, j)(h))
    case KV.PopNone{} _:
      h => h

def mv_do_point(m: R.Mv, +e: R.LEnds, +s: String, +d: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.mv.do(m, e, s, d, t)), j) == KV.entry(KV.Val, T.db_of(T.mv.do(m, e, s, d, u)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match m:
    case R.MvNone{}:
      h => h
    case R.MvWrong{}:
      h => h
    case R.MvSelf{+l, se}:
      mv_self_point(KV.deq.pop(R.ends.from(e), l), e, s, t, u, j)
    case R.MvOnto{+l, se, +q}:
      mv_go_point(KV.deq.pop(R.ends.from(e), l), e, s, d, Some{q}, t, u, j)
    case R.MvNew{+l, se}:
      mv_go_point(KV.deq.pop(R.ends.from(e), l), e, s, d, None{}, t, u, j)

# LMPOP's pick, in two tries that agree on its keys
def lmpop_head_eq(+k: String, -rest: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat, h: {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>}) -> {T.lmpop.head(Con{k, rest}, t, now) == T.lmpop.head(Con{k, rest}, u, now) : Bool}:
  %at_agree(t, u, k, h) : {Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, KV.entry.at(KV.Val, t, k, KV.hash(k)))) == Maybe.is_some(&2, KV.Item<KV.Val>, R.ent.live(now, _)) : Bool}
  {==}

def lmpop_first_at(+k: String, +rest: List<&2, String>, h: Bool, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> {T.lmpop.first(rest, T.lmpop.head(rest, t, now), t, now) == T.lmpop.first(rest, T.lmpop.head(rest, u, now), u, now) : Maybe<&2, String>} -> {T.lmpop.first(Con{k, rest}, h, t, now) == T.lmpop.first(Con{k, rest}, h, u, now) : Maybe<&2, String>}:
  match h:
    case True{}:
      ih => {==}
    case False{}:
      ih => ih

def lmpop_first_eq(ks: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> Agree(t, u, ks) -> {T.lmpop.first(ks, T.lmpop.head(ks, t, now), t, now) == T.lmpop.first(ks, T.lmpop.head(ks, u, now), u, now) : Maybe<&2, String>}:
  match ks:
    case Nil{}:
      ag => {==}
    case Con{+k, +rest}:
      +ag => %lmpop_head_eq(k, rest, t, u, now, ag_head(t, u, k, rest, ag)) : {T.lmpop.first(Con{k, rest}, T.lmpop.head(Con{k, rest}, t, now), t, now) == T.lmpop.first(Con{k, rest}, _, u, now) : Maybe<&2, String>}
             lmpop_first_at(k, rest, T.lmpop.head(Con{k, rest}, t, now), t, u, now)(lmpop_first_eq(rest, t, u, now)(ag_tail(t, u, k, rest, ag)))

# LMPOP's write, for a given pick: the pop of the key picked, as Upd runs
# it
def out_db_r(+k: String, r: R.Reply & KV.Trie<KV.Val>) -> {T.db_of(r) == T.db_of(T.lmpop.out(k, r)) : KV.Trie<KV.Val>}:
  (x, d) = r
  {==}

def lmpop_at_point(m: Maybe<&2, String>, +left: Bool, +n: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.lmpop.at(m, left, n, t, now)), j) == KV.entry(KV.Val, T.db_of(T.lmpop.at(m, left, n, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match m:
    case Some{+k}:
      e => %out_db_r(k, T.upd.run(t, k, R.UList{R.LWPopN{left, n}}, now)) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, T.db_of(T.lmpop.out(k, T.upd.run(u, k, R.UList{R.LWPopN{left, n}}, now))), j) : Maybe<&2, KV.Item<KV.Val>>}
           %out_db_r(k, T.upd.run(u, k, R.UList{R.LWPopN{left, n}}, now)) : {KV.entry(KV.Val, T.db_of(T.upd.run(t, k, R.UList{R.LWPopN{left, n}}, now)), j) == KV.entry(KV.Val, _, j) : Maybe<&2, KV.Item<KV.Val>>}
           point_key(R.Upd{k, R.UList{R.LWPopN{left, n}}}, t, u, j, now, {==}, KV.str_eq(j, k))({==})(str_refl(j, k))(e)
    case None{}:
      e => e

# a key's value there at now, in two tries that agree on it
def read_agree(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +k: String, +now: Nat, h: {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>}) -> {KV.read(KV.Val, t, k, now) == KV.read(KV.Val, u, k, now) : Maybe<&2, KV.Val>}:
  %read_eq(t, k, now) : {_ == KV.read(KV.Val, u, k, now) : Maybe<&2, KV.Val>}
  %read_eq(u, k, now) : {Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now) == _ : Maybe<&2, KV.Val>}
  %h : {Laws.live_val(KV.Val, KV.entry(KV.Val, t, k), now) == Laws.live_val(KV.Val, _, now) : Maybe<&2, KV.Val>}
  {==}

# the sets at the keys of a set operation, in two tries that agree on them
def sets_at_eq(ks: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> Agree(t, u, ks) -> {R.sets.at(ks, now, t) == R.sets.at(ks, now, u) : R.SGot}:
  match ks:
    case Nil{}:
      ag => {==}
    case Con{+k, +rest}:
      +ag => %Equal.sym(Maybe<&2, KV.Val>, KV.read(KV.Val, t, k, now), KV.read(KV.Val, u, k, now), read_agree(t, u, k, now, ag_head(t, u, k, rest, ag))) : {R.sget.one(_, R.sets.at(rest, now, t)) == R.sget.one(KV.read(KV.Val, u, k, now), R.sets.at(rest, now, u)) : R.SGot}
             %Equal.sym(R.SGot, R.sets.at(rest, now, t), R.sets.at(rest, now, u), sets_at_eq(rest, t, u, now)(ag_tail(t, u, k, rest, ag))) : {R.sget.one(KV.read(KV.Val, u, k, now), _) == R.sget.one(KV.read(KV.Val, u, k, now), R.sets.at(rest, now, u)) : R.SGot}
             {==}

# a STORE's write, for given members: the DEL of its destination, or the
# update SWNew of it
def sstore_of_point(xs: List<&2, String>, +d: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.sstore.of(xs, d, t, now)), j) == KV.entry(KV.Val, T.db_of(T.sstore.of(xs, d, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match xs:
    case Nil{}:
      e => %exec_del([d], t, now) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, T.db_of(T.exec(R.Del{[d]}, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
           %exec_del([d], u, now) : {KV.entry(KV.Val, del_all([d], t), j) == KV.entry(KV.Val, _, j) : Maybe<&2, KV.Item<KV.Val>>}
           del_point([d], t, u, j)(e)
    case Con{+x, +rest}:
      e => point_key(R.Upd{d, R.UMems{R.SWNew{x <> rest}}}, t, u, j, now, {==}, KV.str_eq(j, d))({==})(str_refl(j, d))(e)

def sstore_do_point(g: R.SGot, +op: R.SetK, +ks: List<&2, String>, +d: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.sstore.do(g, op, ks, d, t, now)), j) == KV.entry(KV.Val, T.db_of(T.sstore.do(g, op, ks, d, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match g:
    case R.SGot{+ss}:
      sstore_of_point(R.sop.members(op, ks, ss), d, t, u, j, now)
    case R.SGotWrong{}:
      e => e

# SMOVE's verdict, in two tries that agree on its keys
def smv_find_eq(+t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +s: String, +d: String, +w: R.SMem, +now: Nat) -> Agree(t, u, [s, d]) -> {T.smv.find(t, s, d, w, now) == T.smv.find(u, s, d, w, now) : R.Smv}:
  +ag => %at_agree(t, u, s, ag_head(t, u, s, [d], ag)) : {T.smv.find(t, s, d, w, now) == R.smv.find(R.ent.live(now, _), R.mv.dst.ent(R.smv.fresh(w), R.ent.live(now, KV.entry.at(KV.Val, u, d, KV.hash(d)))), KV.str_eq(s, d), R.smv.member(w)) : R.Smv}
         %at_agree(t, u, d, ag_head(t, u, d, Nil{}, ag_tail(t, u, s, [d], ag))) : {T.smv.find(t, s, d, w, now) == R.smv.find(R.ent.live(now, KV.entry.at(KV.Val, t, s, KV.hash(s))), R.mv.dst.ent(R.smv.fresh(w), R.ent.live(now, _)), KV.str_eq(s, d), R.smv.member(w)) : R.Smv}
         {==}

# SMOVE's writes, for a given verdict: the updates of its source and of
# its destination
def smove_do_point(f: R.Smv, +s: String, +d: String, +w: R.SMem, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.smove.do(f, s, d, w, t, now)), j) == KV.entry(KV.Val, T.db_of(T.smove.do(f, s, d, w, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match f:
    case R.SmvZero{}:
      e => e
    case R.SmvWrong{}:
      e => e
    case R.SmvSame{had}:
      e => e
    case R.SmvGo{}:
      e => point_key(R.Upd{d, R.UMems{R.smv.add(w)}}, T.db_of(T.upd.run(t, s, R.UMems{R.SWRem{[R.smv.member(w)]}}, now)), T.db_of(T.upd.run(u, s, R.UMems{R.SWRem{[R.smv.member(w)]}}, now)), j, now, {==}, KV.str_eq(j, d))({==})(str_refl(j, d))(
             point_key(R.Upd{s, R.UMems{R.SWRem{[R.smv.member(w)]}}}, t, u, j, now, {==}, KV.str_eq(j, s))({==})(str_refl(j, s))(e))

# the sorted sets (and sets) at the keys of a sorted-set operation, in
# two tries that agree on them
def zsrcs_at_eq(ks: List<&2, String>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> Agree(t, u, ks) -> {R.zsrcs.at(ks, now, t) == R.zsrcs.at(ks, now, u) : R.ZGot}:
  match ks:
    case Nil{}:
      ag => {==}
    case Con{+k, +rest}:
      +ag => %Equal.sym(Maybe<&2, KV.Val>, KV.read(KV.Val, t, k, now), KV.read(KV.Val, u, k, now), read_agree(t, u, k, now, ag_head(t, u, k, rest, ag))) : {R.zget.one(_, R.zsrcs.at(rest, now, t)) == R.zget.one(KV.read(KV.Val, u, k, now), R.zsrcs.at(rest, now, u)) : R.ZGot}
             %Equal.sym(R.ZGot, R.zsrcs.at(rest, now, t), R.zsrcs.at(rest, now, u), zsrcs_at_eq(rest, t, u, now)(ag_tail(t, u, k, rest, ag))) : {R.zget.one(KV.read(KV.Val, u, k, now), _) == R.zget.one(KV.read(KV.Val, u, k, now), R.zsrcs.at(rest, now, u)) : R.ZGot}
             {==}

# a STORE's write, for given elements: the DEL of its destination, or
# the update ZWNew of it
def zstore_of_point(xs: List<&2, KV.ZEl>, +d: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.zstore.of(xs, d, t, now)), j) == KV.entry(KV.Val, T.db_of(T.zstore.of(xs, d, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match xs:
    case Nil{}:
      e => %exec_del([d], t, now) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, T.db_of(T.exec(R.Del{[d]}, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
           %exec_del([d], u, now) : {KV.entry(KV.Val, del_all([d], t), j) == KV.entry(KV.Val, _, j) : Maybe<&2, KV.Item<KV.Val>>}
           del_point([d], t, u, j)(e)
    case Con{+x, +rest}:
      e => point_key(R.Upd{d, R.UZset{R.ZWNew{R.zopts.none(), R.zstore.pairs(x <> rest)}}}, t, u, j, now, {==}, KV.str_eq(j, d))({==})(str_refl(j, d))(e)

def zstore_ok_point(bad: Maybe<&2, R.Reply>, +op: R.ZSetK, ss: List<&2, R.ZSrc>, +d: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.zstore.ok(bad, op, ss, d, t, now)), j) == KV.entry(KV.Val, T.db_of(T.zstore.ok(bad, op, ss, d, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match bad:
    case Some{r}:
      e => e
    case None{}:
      zstore_of_point(R.zop.els(op, ss), d, t, u, j, now)

def zstore_do_point(g: R.ZGot, +op: R.ZSetK, +d: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.zstore.do(g, op, d, t, now)), j) == KV.entry(KV.Val, T.db_of(T.zstore.do(g, op, d, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match g:
    case R.ZGot{ss}:
      zstore_ok_point(R.zop.bad(op), op, ss, d, t, u, j, now)
    case R.ZGotWrong{}:
      e => e

def zrs_of_point(m: Maybe<&2, KV.Val>, q: R.ZQ, +d: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.zrs.of(m, q, d, t, now)), j) == KV.entry(KV.Val, T.db_of(T.zrs.of(m, q, d, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match m:
    case None{}:
      zstore_of_point(Nil{}, d, t, u, j, now)
    case Some{KV.VColl{KV.CZset{+z}}}:
      zstore_of_point(R.zq.run(q, z), d, t, u, j, now)
    case Some{KV.VColl{KV.CHash{h}}}:
      e => e
    case Some{KV.VColl{KV.CList{l}}}:
      e => e
    case Some{KV.VColl{KV.CMems{s}}}:
      e => e
    case Some{KV.VColl{KV.CStream{s}}}:
      e => e
    case Some{KV.VStr{w}}:
      e => e

# ZMPOP's write, for a given pick: the pop of the key picked, as Upd runs
# it
def zout_db_r(+k: String, r: R.Reply & KV.Trie<KV.Val>) -> {T.db_of(r) == T.db_of(T.zmpop.out(k, r)) : KV.Trie<KV.Val>}:
  (y, d) = r
  {==}

def zmpop_at_point(m: Maybe<&2, String>, +max: Bool, +c: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.zmpop.at(m, max, c, t, now)), j) == KV.entry(KV.Val, T.db_of(T.zmpop.at(m, max, c, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match m:
    case Some{+k}:
      e => %zout_db_r(k, T.upd.run(t, k, R.UZset{R.ZWPopN{max, c}}, now)) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, T.db_of(T.zmpop.out(k, T.upd.run(u, k, R.UZset{R.ZWPopN{max, c}}, now))), j) : Maybe<&2, KV.Item<KV.Val>>}
           %zout_db_r(k, T.upd.run(u, k, R.UZset{R.ZWPopN{max, c}}, now)) : {KV.entry(KV.Val, T.db_of(T.upd.run(t, k, R.UZset{R.ZWPopN{max, c}}, now)), j) == KV.entry(KV.Val, _, j) : Maybe<&2, KV.Item<KV.Val>>}
           point_key(R.Upd{k, R.UZset{R.ZWPopN{max, c}}}, t, u, j, now, {==}, KV.str_eq(j, k))({==})(str_refl(j, k))(e)
    case None{}:
      e => e

# any command, run on two tries that agree on the keys its writes depend
# on: a key j's entry after it depends only on j's entry before it
def point_cmd(c: R.Cmd, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +j: String, +now: Nat) -> Agree(t, u, Laws.deps(c)) -> {KV.entry(KV.Val, t, j) == KV.entry(KV.Val, u, j) : Maybe<&2, KV.Item<KV.Val>>} -> {KV.entry(KV.Val, T.db_of(T.exec(c, t, now)), j) == KV.entry(KV.Val, T.db_of(T.exec(c, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match c:
    case R.Ping{}:
      ag => e => e
    case R.Echo{m}:
      ag => e => e
    case R.Get{k}:
      ag => e => e
    case R.Set{+k, +v}:
      ag => point_key(R.Set{k, v}, t, u, j, now, {==}, KV.str_eq(j, k))({==})(str_refl(j, k))
    case R.Del{+ks}:
      ag => e => %exec_del(ks, t, now) : {KV.entry(KV.Val, _, j) == KV.entry(KV.Val, T.db_of(T.exec(R.Del{ks}, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
                 %exec_del(ks, u, now) : {KV.entry(KV.Val, del_all(ks, t), j) == KV.entry(KV.Val, _, j) : Maybe<&2, KV.Item<KV.Val>>}
                 del_point(ks, t, u, j)(e)
    case R.Exists{ks}:
      ag => e => e
    case R.IncrBy{+k, +by}:
      ag => point_key(R.IncrBy{k, by}, t, u, j, now, {==}, KV.str_eq(j, k))({==})(str_refl(j, k))
    case R.MGet{ks}:
      ag => e => e
    case R.MSet{+ps}:
      ag => mset_point(ps, t, u, j)
    case R.DbSize{}:
      ag => e => e
    case R.FlushDb{}:
      ag => e => {==}
    case R.Keys{p}:
      ag => e => e
    case R.Sort{k, o}:
      ag => e => e
    case R.Scan{a}:
      ag => e => e
    case R.Peek{k, o}:
      ag => e => e
    case R.Upd{+k, +op}:
      ag => point_key(R.Upd{k, op}, t, u, j, now, {==}, KV.str_eq(j, k))({==})(str_refl(j, k))
    case R.MSetNx{+ps}:
      ag => e => %live_agree(ps, t, u, now)(ag) : {KV.entry(KV.Val, T.db_of(T.msetnx(R.pairs.live(ps, now, t), ps, t)), j) == KV.entry(KV.Val, T.db_of(T.msetnx(_, ps, u)), j) : Maybe<&2, KV.Item<KV.Val>>}
                 msetnx_point(R.pairs.live(ps, now, t), ps, t, u, j)(e)
    case R.Rename{+s, +d, +nx}:
      ag => e => %ren_find_eq(t, u, s, d, nx, now)(ag) : {KV.entry(KV.Val, T.db_of(T.ren(T.ren.find(t, s, d, nx, now), nx, s, d, t)), j) == KV.entry(KV.Val, T.db_of(T.ren(_, nx, s, d, u)), j) : Maybe<&2, KV.Item<KV.Val>>}
                 ren_point(T.ren.find(t, s, d, nx, now), nx, s, d, t, u, j)(e)
    case R.BitOp{+op, +d, +srcs}:
      +ag => e => %bitop_wrong_eq(srcs, t, u, now)(ag) : {KV.entry(KV.Val, T.db_of(T.bitop.go(R.bitop.wrong(srcs, now, t), op, srcs, d, t, now)), j) == KV.entry(KV.Val, T.db_of(T.bitop.go(_, op, srcs, d, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
                  bitop_go_point(R.bitop.wrong(srcs, now, t), op, srcs, d, t, u, j, now)(ag)(e)
    case R.LMove{+s, +d, +w}:
      ag => e => %mv_find_eq(t, u, s, d, w, now)(ag) : {KV.entry(KV.Val, T.db_of(T.mv.do(T.mv.find(t, s, d, w, now), w, s, d, t)), j) == KV.entry(KV.Val, T.db_of(T.mv.do(_, w, s, d, u)), j) : Maybe<&2, KV.Item<KV.Val>>}
                 mv_do_point(T.mv.find(t, s, d, w, now), w, s, d, t, u, j)(e)
    case R.LMPop{+ks, +left, +n}:
      ag => e => %lmpop_first_eq(ks, t, u, now)(ag) : {KV.entry(KV.Val, T.db_of(T.lmpop.at(T.lmpop.first(ks, T.lmpop.head(ks, t, now), t, now), left, n, t, now)), j) == KV.entry(KV.Val, T.db_of(T.lmpop.at(_, left, n, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
                 lmpop_at_point(T.lmpop.first(ks, T.lmpop.head(ks, t, now), t, now), left, n, t, u, j, now)(e)
    case R.SOp{op, ks}:
      ag => e => e
    case R.SStore{+op, +d, +srcs}:
      ag => e => %sets_at_eq(srcs, t, u, now)(ag) : {KV.entry(KV.Val, T.db_of(T.sstore.do(R.sets.at(srcs, now, t), op, srcs, d, t, now)), j) == KV.entry(KV.Val, T.db_of(T.sstore.do(_, op, srcs, d, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
                 sstore_do_point(R.sets.at(srcs, now, t), op, srcs, d, t, u, j, now)(e)
    case R.SMv{+s, +d, +w}:
      ag => e => %smv_find_eq(t, u, s, d, w, now)(ag) : {KV.entry(KV.Val, T.db_of(T.smove.do(T.smv.find(t, s, d, w, now), s, d, w, t, now)), j) == KV.entry(KV.Val, T.db_of(T.smove.do(_, s, d, w, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
                 smove_do_point(T.smv.find(t, s, d, w, now), s, d, w, t, u, j, now)(e)
    case R.ZOp{op, ks}:
      ag => e => e
    case R.ZStore{+op, +d, +srcs}:
      ag => e => %zsrcs_at_eq(srcs, t, u, now)(ag) : {KV.entry(KV.Val, T.db_of(T.zstore.do(R.zsrcs.at(srcs, now, t), op, d, t, now)), j) == KV.entry(KV.Val, T.db_of(T.zstore.do(_, op, d, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
                 zstore_do_point(R.zsrcs.at(srcs, now, t), op, d, t, u, j, now)(e)
    case R.ZRangeStore{+d, +s, +q}:
      ag => e => %read_agree(t, u, s, now, ag_head(t, u, s, Nil{}, ag)) : {KV.entry(KV.Val, T.db_of(T.zrs.of(KV.read(KV.Val, t, s, now), q, d, t, now)), j) == KV.entry(KV.Val, T.db_of(T.zrs.of(_, q, d, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
                 zrs_of_point(KV.read(KV.Val, t, s, now), q, d, t, u, j, now)(e)
    case R.ZMPop{+ks, +max, +c}:
      ag => e => %lmpop_first_eq(ks, t, u, now)(ag) : {KV.entry(KV.Val, T.db_of(T.zmpop.at(T.lmpop.first(ks, T.lmpop.head(ks, t, now), t, now), max, c, t, now)), j) == KV.entry(KV.Val, T.db_of(T.zmpop.at(_, max, c, u, now)), j) : Maybe<&2, KV.Item<KV.Val>>}
                 zmpop_at_point(T.lmpop.first(ks, T.lmpop.head(ks, t, now), t, now), max, c, t, u, j, now)(e)
    case R.Own{o}:
      ag => e => e
    case R.Bad{r}:
      ag => e => e

# Commuting commands
# ==================
# A command changes a key's entry only as a function of that entry
# (point_cmd), and leaves alone the keys it does not write (frame); so a
# key that at most one of two commands writes holds the same after both,
# in either order (commute_at). A command's reply depends only on the
# entries of the keys it reads, or for DBSIZE, KEYS and SCAN on the whole
# trie, which a command that only reads leaves as it was; so it is the
# same after a command that writes none of those keys (reply_after). All
# run at one time now.

def and_true_false(a: Bool) -> {Bool.and(a, True{}) == False{} : Bool} -> {a == False{} : Bool}:
  match a:
    case True{}:
      e => Empty.absurd({True{} == False{} : Bool}, true_false(e))
    case False{}:
      e => {==}

# a command that writes none of ks leaves each of them with the entry it
# had
def frame_agree(+c: R.Cmd, +db: KV.Trie<KV.Val>, ks: List<&2, String>, +now: Nat) -> {Laws.writes_any(c, ks) == False{} : Bool} -> Agree(T.db_of(T.exec(c, db, now)), db, ks):
  match ks:
    case Nil{}:
      e => Unit{}
    case Con{+k, +rest}:
      +e => (t_frame(c, db, k, now, or_false_l(Laws.writes(c, k), Laws.writes_any(c, rest))(e)), frame_agree(c, db, rest, now)(or_false_r(Laws.writes(c, k), Laws.writes_any(c, rest))(e)))

# a key that c2 does not write holds after c1 then c2 as after c1, and
# after c2 then c1 as after c1 too, c2 writing no key c1's writes depend
# on; a key that c2 writes, c1 does not
def commute_at(+c1: R.Cmd, +c2: R.Cmd, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, d12: {Laws.spoils(c1, c2) == False{} : Bool}, d21: {Laws.spoils(c2, c1) == False{} : Bool}, b: Bool) -> {b == Laws.writes(c2, j) : Bool} -> {Bool.and(Laws.writes(c1, j), b) == False{} : Bool} -> {KV.entry(KV.Val, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), j) == KV.entry(KV.Val, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case False{}:
      eb => e =>
        +w2 = Equal.sym(Bool, False{}, Laws.writes(c2, j), eb)
        Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), j), KV.entry(KV.Val, T.db_of(T.exec(c1, db, now)), j), KV.entry(KV.Val, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), j), t_frame(c2, T.db_of(T.exec(c1, db, now)), j, now, w2),
          Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), j), KV.entry(KV.Val, T.db_of(T.exec(c1, db, now)), j), point_cmd(c1, T.db_of(T.exec(c2, db, now)), db, j, now)(frame_agree(c2, db, Laws.deps(c1), now)(d21))(t_frame(c2, db, j, now, w2))))
    case True{}:
      eb => e =>
        +w1 = and_true_false(Laws.writes(c1, j))(e)
        Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), j), KV.entry(KV.Val, T.db_of(T.exec(c2, db, now)), j), KV.entry(KV.Val, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), j), point_cmd(c2, T.db_of(T.exec(c1, db, now)), db, j, now)(frame_agree(c1, db, Laws.deps(c2), now)(d12))(t_frame(c1, db, j, now, w1)),
          Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), j), KV.entry(KV.Val, T.db_of(T.exec(c2, db, now)), j), t_frame(c1, T.db_of(T.exec(c2, db, now)), j, now, w1)))

def t_commute_reads(+c1: R.Cmd, +c2: R.Cmd, +db: KV.Trie<KV.Val>, +j: String, +now: Nat, e: {Bool.and(Laws.writes(c1, j), Laws.writes(c2, j)) == False{} : Bool}, +d: {Bool.or(Laws.spoils(c1, c2), Laws.spoils(c2, c1)) == False{} : Bool}) -> {KV.entry(KV.Val, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), j) == KV.entry(KV.Val, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), j) : Maybe<&2, KV.Item<KV.Val>>}:
  commute_at(c1, c2, db, j, now, or_false_l(Laws.spoils(c1, c2), Laws.spoils(c2, c1))(d), or_false_r(Laws.spoils(c1, c2), Laws.spoils(c2, c1))(d), Laws.writes(c2, j))({==})(e)

# A command's reply after another
# --------------------------------

def not_false(a: Bool) -> {Bool.not(a) == False{} : Bool} -> {a == True{} : Bool}:
  match a:
    case True{}:
      e => {==}
    case False{}:
      e => Empty.absurd({False{} == True{} : Bool}, true_false(e))

def exists_after(ks: List<&2, String>, +c2: R.Cmd, +db: KV.Trie<KV.Val>, +now: Nat) -> {Laws.writes_any(c2, ks) == False{} : Bool} -> {R.exists_keys(ks, now, T.db_of(T.exec(c2, db, now))) == R.exists_keys(ks, now, db) : Nat}:
  match ks:
    case Nil{}:
      e => {==}
    case Con{+k, +rest}:
      +e => %read_eq(T.db_of(T.exec(c2, db, now)), k, now) : {Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, _), 1n, 0n), R.exists_keys(rest, now, T.db_of(T.exec(c2, db, now)))) == Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, KV.read(KV.Val, db, k, now)), 1n, 0n), R.exists_keys(rest, now, db)) : Nat}
            %read_eq(db, k, now) : {Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, T.db_of(T.exec(c2, db, now)), k), now)), 1n, 0n), R.exists_keys(rest, now, T.db_of(T.exec(c2, db, now)))) == Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, _), 1n, 0n), R.exists_keys(rest, now, db)) : Nat}
            %t_frame(c2, db, k, now, or_false_l(Laws.writes(c2, k), Laws.writes_any(c2, rest))(e)) : {Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, T.db_of(T.exec(c2, db, now)), k), now)), 1n, 0n), R.exists_keys(rest, now, T.db_of(T.exec(c2, db, now)))) == Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, _, now)), 1n, 0n), R.exists_keys(rest, now, db)) : Nat}
            Equal.cong(Nat, Nat, z => Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, T.db_of(T.exec(c2, db, now)), k), now)), 1n, 0n), z), R.exists_keys(rest, now, T.db_of(T.exec(c2, db, now))), R.exists_keys(rest, now, db), exists_after(rest, c2, db, now)(or_false_r(Laws.writes(c2, k), Laws.writes_any(c2, rest))(e)))

def mget_after(ks: List<&2, String>, +c2: R.Cmd, +db: KV.Trie<KV.Val>, +now: Nat) -> {Laws.writes_any(c2, ks) == False{} : Bool} -> {R.mget_keys(ks, now, T.db_of(T.exec(c2, db, now))) == R.mget_keys(ks, now, db) : List<&2, R.Reply>}:
  match ks:
    case Nil{}:
      e => {==}
    case Con{+k, +rest}:
      +e => %read_eq(T.db_of(T.exec(c2, db, now)), k, now) : {R.i_getv(_) <> R.mget_keys(rest, now, T.db_of(T.exec(c2, db, now))) == R.i_getv(KV.read(KV.Val, db, k, now)) <> R.mget_keys(rest, now, db) : List<&2, R.Reply>}
            %read_eq(db, k, now) : {R.i_getv(Laws.live_val(KV.Val, KV.entry(KV.Val, T.db_of(T.exec(c2, db, now)), k), now)) <> R.mget_keys(rest, now, T.db_of(T.exec(c2, db, now))) == R.i_getv(_) <> R.mget_keys(rest, now, db) : List<&2, R.Reply>}
            %t_frame(c2, db, k, now, or_false_l(Laws.writes(c2, k), Laws.writes_any(c2, rest))(e)) : {R.i_getv(Laws.live_val(KV.Val, KV.entry(KV.Val, T.db_of(T.exec(c2, db, now)), k), now)) <> R.mget_keys(rest, now, T.db_of(T.exec(c2, db, now))) == R.i_getv(Laws.live_val(KV.Val, _, now)) <> R.mget_keys(rest, now, db) : List<&2, R.Reply>}
            Equal.cong(List<&2, R.Reply>, List<&2, R.Reply>, z => R.i_getv(Laws.live_val(KV.Val, KV.entry(KV.Val, T.db_of(T.exec(c2, db, now)), k), now)) <> z, R.mget_keys(rest, now, T.db_of(T.exec(c2, db, now))), R.mget_keys(rest, now, db), mget_after(rest, c2, db, now)(or_false_r(Laws.writes(c2, k), Laws.writes_any(c2, rest))(e)))

# deleting a key after deleting the keys of done
def del_snoc(done: List<&2, String>, -k: String, +x: KV.Trie<KV.Val>) -> {del_all(List.append(&2, String, done, [k]), x) == KV.del(KV.Val, del_all(done, x), k) : KV.Trie<KV.Val>}:
  match done:
    case Nil{}:
      {==}
    case Con{+d, +ds}:
      del_snoc(ds, k, KV.del(KV.Val, x, d))

# after the same deletes on both sides, a key c2 does not write has one
# entry in c2's trie and in the one before it
def del_agree(+c2: R.Cmd, +db: KV.Trie<KV.Val>, +done: List<&2, String>, +k: String, +now: Nat, +w: {Laws.writes(c2, k) == False{} : Bool}, b: Bool) -> {b == Laws.any_key(k, done) : Bool} -> {KV.entry(KV.Val, del_all(done, T.db_of(T.exec(c2, db, now))), k) == KV.entry(KV.Val, del_all(done, db), k) : Maybe<&2, KV.Item<KV.Val>>}:
  match b:
    case True{}:
      +eb => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, del_all(done, T.db_of(T.exec(c2, db, now))), k), None{}, KV.entry(KV.Val, del_all(done, db), k), del_all_effect(done, T.db_of(T.exec(c2, db, now)), k)(Equal.sym(Bool, True{}, Laws.any_key(k, done), eb)), Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, del_all(done, db), k), None{}, del_all_effect(done, db, k)(Equal.sym(Bool, True{}, Laws.any_key(k, done), eb))))
    case False{}:
      +eb => Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, del_all(done, T.db_of(T.exec(c2, db, now))), k), KV.entry(KV.Val, T.db_of(T.exec(c2, db, now)), k), KV.entry(KV.Val, del_all(done, db), k), del_all_frame(done, T.db_of(T.exec(c2, db, now)), k)(Equal.sym(Bool, False{}, Laws.any_key(k, done), eb)),
               Equal.trans(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, T.db_of(T.exec(c2, db, now)), k), KV.entry(KV.Val, db, k), KV.entry(KV.Val, del_all(done, db), k), t_frame(c2, db, k, now, w), Equal.sym(Maybe<&2, KV.Item<KV.Val>>, KV.entry(KV.Val, del_all(done, db), k), KV.entry(KV.Val, db, k), del_all_frame(done, db, k)(Equal.sym(Bool, False{}, Laws.any_key(k, done), eb)))))

# DEL counts the same keys after c2, when c2 writes none of them: the
# keys of done are deleted on both sides
def dcount(+c2: R.Cmd, +db: KV.Trie<KV.Val>, ks: List<&2, String>, +done: List<&2, String>, +now: Nat) -> {Laws.writes_any(c2, ks) == False{} : Bool} -> {del_count(ks, now, del_all(done, T.db_of(T.exec(c2, db, now)))) == del_count(ks, now, del_all(done, db)) : Nat}:
  match ks:
    case Nil{}:
      e => {==}
    case Con{+k, +rest}:
      +e =>
        +ag = del_agree(c2, db, done, k, now, or_false_l(Laws.writes(c2, k), Laws.writes_any(c2, rest))(e), Laws.any_key(k, done))({==})
        %ag : {Nat.add(del_count(rest, now, KV.del(KV.Val, del_all(done, T.db_of(T.exec(c2, db, now))), k)), Bool.pick(Nat, R.code.live(Laws.item_code(KV.Val, KV.entry(KV.Val, del_all(done, T.db_of(T.exec(c2, db, now))), k)), now), 1n, 0n)) == Nat.add(del_count(rest, now, KV.del(KV.Val, del_all(done, db), k)), Bool.pick(Nat, R.code.live(Laws.item_code(KV.Val, _), now), 1n, 0n)) : Nat}
        %del_snoc(done, k, T.db_of(T.exec(c2, db, now))) : {Nat.add(del_count(rest, now, _), Bool.pick(Nat, R.code.live(Laws.item_code(KV.Val, KV.entry(KV.Val, del_all(done, T.db_of(T.exec(c2, db, now))), k)), now), 1n, 0n)) == Nat.add(del_count(rest, now, KV.del(KV.Val, del_all(done, db), k)), Bool.pick(Nat, R.code.live(Laws.item_code(KV.Val, KV.entry(KV.Val, del_all(done, T.db_of(T.exec(c2, db, now))), k)), now), 1n, 0n)) : Nat}
        %del_snoc(done, k, db) : {Nat.add(del_count(rest, now, del_all(List.append(&2, String, done, [k]), T.db_of(T.exec(c2, db, now)))), Bool.pick(Nat, R.code.live(Laws.item_code(KV.Val, KV.entry(KV.Val, del_all(done, T.db_of(T.exec(c2, db, now))), k)), now), 1n, 0n)) == Nat.add(del_count(rest, now, _), Bool.pick(Nat, R.code.live(Laws.item_code(KV.Val, KV.entry(KV.Val, del_all(done, T.db_of(T.exec(c2, db, now))), k)), now), 1n, 0n)) : Nat}
        Equal.cong(Nat, Nat, z => Nat.add(z, Bool.pick(Nat, R.code.live(Laws.item_code(KV.Val, KV.entry(KV.Val, del_all(done, T.db_of(T.exec(c2, db, now))), k)), now), 1n, 0n)), del_count(rest, now, del_all(List.append(&2, String, done, [k]), T.db_of(T.exec(c2, db, now)))), del_count(rest, now, del_all(List.append(&2, String, done, [k]), db)), dcount(c2, db, rest, List.append(&2, String, done, [k]), now)(or_false_r(Laws.writes(c2, k), Laws.writes_any(c2, rest))(e)))

def del_reply_after(+ks: List<&2, String>, +c2: R.Cmd, +db: KV.Trie<KV.Val>, +now: Nat) -> {Laws.writes_any(c2, ks) == False{} : Bool} -> {T.reply_of(T.exec(R.Del{ks}, T.db_of(T.exec(c2, db, now)), now)) == T.reply_of(T.exec(R.Del{ks}, db, now)) : R.Reply}:
  e => %exec_del_r(ks, T.db_of(T.exec(c2, db, now)), now) : {_ == T.reply_of(T.exec(R.Del{ks}, db, now)) : R.Reply}
       %exec_del_r(ks, db, now) : {R.r_int(del_count(ks, now, T.db_of(T.exec(c2, db, now)))) == _ : R.Reply}
       Equal.cong(Nat, R.Reply, n => R.r_int(n), del_count(ks, now, T.db_of(T.exec(c2, db, now))), del_count(ks, now, db), dcount(c2, db, ks, Nil{}, now)(e))

# LMOVE's reply, for a given verdict, is the same in any trie
def mv_self_rep(p: KV.Pop, +e: R.LEnds, +s: String, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>) -> {T.reply_of(T.mv.self(p, e, s, t)) == T.reply_of(T.mv.self(p, e, s, u)) : R.Reply}:
  match p:
    case KV.Pop{x, l}:
      {==}
    case KV.PopNone{}:
      {==}

def mv_go_rep(p: KV.Pop, +e: R.LEnds, +s: String, +d: String, dl: Maybe<&2, KV.Deq>, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>) -> {T.reply_of(T.mv.go(p, e, s, d, dl, t)) == T.reply_of(T.mv.go(p, e, s, d, dl, u)) : R.Reply}:
  match p dl:
    case KV.Pop{x, l} Some{q}:
      {==}
    case KV.Pop{x, l} None{}:
      {==}
    case KV.PopNone{} _:
      {==}

def mv_do_rep(m: R.Mv, +e: R.LEnds, +s: String, +d: String, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>) -> {T.reply_of(T.mv.do(m, e, s, d, t)) == T.reply_of(T.mv.do(m, e, s, d, u)) : R.Reply}:
  match m:
    case R.MvNone{}:
      {==}
    case R.MvWrong{}:
      {==}
    case R.MvSelf{+l, se}:
      mv_self_rep(KV.deq.pop(R.ends.from(e), l), e, s, t, u)
    case R.MvOnto{+l, se, +q}:
      mv_go_rep(KV.deq.pop(R.ends.from(e), l), e, s, d, Some{q}, t, u)
    case R.MvNew{+l, se}:
      mv_go_rep(KV.deq.pop(R.ends.from(e), l), e, s, d, None{}, t, u)

# LMPOP's pick is one of its keys: two tries that agree on its keys agree
# on the key it picks
def AgreeAt(t: KV.Trie<KV.Val>, u: KV.Trie<KV.Val>, m: Maybe<&2, String>) -> Data:
  match m:
    case Some{k}:
      {KV.entry(KV.Val, t, k) == KV.entry(KV.Val, u, k) : Maybe<&2, KV.Item<KV.Val>>}
    case None{}:
      Unit

def first_agree(ks: List<&2, String>, h: Bool, +x: KV.Trie<KV.Val>, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> Agree(t, u, ks) -> AgreeAt(t, u, T.lmpop.first(ks, h, x, now)):
  match ks h:
    case Con{+k, +rest} True{}:
      ag => ag_head(t, u, k, rest, ag)
    case Con{+k, +rest} False{}:
      ag => first_agree(rest, T.lmpop.head(rest, x, now), x, t, u, now)(ag_tail(t, u, k, rest, ag))
    case Nil{} _:
      ag => Unit{}

def out_rep_r(+k: String, r: R.Reply & KV.Trie<KV.Val>) -> {R.lmpop.reply(k, T.reply_of(r)) == T.reply_of(T.lmpop.out(k, r)) : R.Reply}:
  (x, d) = r
  {==}

# LMPOP's reply, for a given pick, in two tries that agree on that key
def lmpop_at_rep(m: Maybe<&2, String>, +left: Bool, +n: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> AgreeAt(t, u, m) -> {T.reply_of(T.lmpop.at(m, left, n, t, now)) == T.reply_of(T.lmpop.at(m, left, n, u, now)) : R.Reply}:
  match m:
    case Some{+k}:
      h => %out_rep_r(k, T.upd.run(t, k, R.UList{R.LWPopN{left, n}}, now)) : {_ == T.reply_of(T.lmpop.out(k, T.upd.run(u, k, R.UList{R.LWPopN{left, n}}, now))) : R.Reply}
           %out_rep_r(k, T.upd.run(u, k, R.UList{R.LWPopN{left, n}}, now)) : {R.lmpop.reply(k, T.reply_of(T.upd.run(t, k, R.UList{R.LWPopN{left, n}}, now))) == _ : R.Reply}
           Equal.cong(R.Reply, R.Reply, z => R.lmpop.reply(k, z), T.reply_of(T.upd.run(t, k, R.UList{R.LWPopN{left, n}}, now)), T.reply_of(T.upd.run(u, k, R.UList{R.LWPopN{left, n}}, now)), loc_reply(R.Upd{k, R.UList{R.LWPopN{left, n}}}, t, u, now)({==})(h))
    case None{}:
      h => {==}

# a STORE of a set operation answers with the count of what it makes,
# whatever the trie it writes
def sstore_of_rep(xs: List<&2, String>, -d: String, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -now: Nat) -> {T.reply_of(T.sstore.of(xs, d, t, now)) == T.reply_of(T.sstore.of(xs, d, u, now)) : R.Reply}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, rest}:
      {==}

def sstore_do_rep(g: R.SGot, +op: R.SetK, +ks: List<&2, String>, -d: String, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -now: Nat) -> {T.reply_of(T.sstore.do(g, op, ks, d, t, now)) == T.reply_of(T.sstore.do(g, op, ks, d, u, now)) : R.Reply}:
  match g:
    case R.SGot{+ss}:
      sstore_of_rep(R.sop.members(op, ks, ss), d, t, u, now)
    case R.SGotWrong{}:
      {==}

# SMOVE's reply is its verdict's
def smove_do_rep(f: R.Smv, -s: String, -d: String, -w: R.SMem, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -now: Nat) -> {T.reply_of(T.smove.do(f, s, d, w, t, now)) == T.reply_of(T.smove.do(f, s, d, w, u, now)) : R.Reply}:
  match f:
    case R.SmvZero{}:
      {==}
    case R.SmvWrong{}:
      {==}
    case R.SmvSame{had}:
      {==}
    case R.SmvGo{}:
      {==}

# a STORE of a sorted-set operation, or of a range, answers with the
# count of what it makes, whatever the trie it writes
def zstore_of_rep(xs: List<&2, KV.ZEl>, -d: String, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -now: Nat) -> {T.reply_of(T.zstore.of(xs, d, t, now)) == T.reply_of(T.zstore.of(xs, d, u, now)) : R.Reply}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, rest}:
      {==}

def zstore_ok_rep(bad: Maybe<&2, R.Reply>, +op: R.ZSetK, ss: List<&2, R.ZSrc>, -d: String, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -now: Nat) -> {T.reply_of(T.zstore.ok(bad, op, ss, d, t, now)) == T.reply_of(T.zstore.ok(bad, op, ss, d, u, now)) : R.Reply}:
  match bad:
    case Some{r}:
      {==}
    case None{}:
      zstore_of_rep(R.zop.els(op, ss), d, t, u, now)

def zstore_do_rep(g: R.ZGot, +op: R.ZSetK, -d: String, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -now: Nat) -> {T.reply_of(T.zstore.do(g, op, d, t, now)) == T.reply_of(T.zstore.do(g, op, d, u, now)) : R.Reply}:
  match g:
    case R.ZGot{ss}:
      zstore_ok_rep(R.zop.bad(op), op, ss, d, t, u, now)
    case R.ZGotWrong{}:
      {==}

def zrs_of_rep(m: Maybe<&2, KV.Val>, q: R.ZQ, -d: String, -t: KV.Trie<KV.Val>, -u: KV.Trie<KV.Val>, -now: Nat) -> {T.reply_of(T.zrs.of(m, q, d, t, now)) == T.reply_of(T.zrs.of(m, q, d, u, now)) : R.Reply}:
  match m:
    case None{}:
      zstore_of_rep(Nil{}, d, t, u, now)
    case Some{KV.VColl{KV.CZset{+z}}}:
      zstore_of_rep(R.zq.run(q, z), d, t, u, now)
    case Some{KV.VColl{KV.CHash{h}}}:
      {==}
    case Some{KV.VColl{KV.CList{l}}}:
      {==}
    case Some{KV.VColl{KV.CMems{s}}}:
      {==}
    case Some{KV.VColl{KV.CStream{s}}}:
      {==}
    case Some{KV.VStr{w}}:
      {==}

def zout_rep_r(+k: String, r: R.Reply & KV.Trie<KV.Val>) -> {R.zmpop.reply(k, T.reply_of(r)) == T.reply_of(T.zmpop.out(k, r)) : R.Reply}:
  (y, d) = r
  {==}

# ZMPOP's reply, for a given pick, in two tries that agree on that key
def zmpop_at_rep(m: Maybe<&2, String>, +max: Bool, +c: String, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, +now: Nat) -> AgreeAt(t, u, m) -> {T.reply_of(T.zmpop.at(m, max, c, t, now)) == T.reply_of(T.zmpop.at(m, max, c, u, now)) : R.Reply}:
  match m:
    case Some{+k}:
      h => %zout_rep_r(k, T.upd.run(t, k, R.UZset{R.ZWPopN{max, c}}, now)) : {_ == T.reply_of(T.zmpop.out(k, T.upd.run(u, k, R.UZset{R.ZWPopN{max, c}}, now))) : R.Reply}
           %zout_rep_r(k, T.upd.run(u, k, R.UZset{R.ZWPopN{max, c}}, now)) : {R.zmpop.reply(k, T.reply_of(T.upd.run(t, k, R.UZset{R.ZWPopN{max, c}}, now))) == _ : R.Reply}
           Equal.cong(R.Reply, R.Reply, z => R.zmpop.reply(k, z), T.reply_of(T.upd.run(t, k, R.UZset{R.ZWPopN{max, c}}, now)), T.reply_of(T.upd.run(u, k, R.UZset{R.ZWPopN{max, c}}, now)), loc_reply(R.Upd{k, R.UZset{R.ZWPopN{max, c}}}, t, u, now)({==})(h))
    case None{}:
      h => {==}

# a command answers the same after c2 when c2 writes nothing it reads
def reply_after(c1: R.Cmd, +c2: R.Cmd, +db: KV.Trie<KV.Val>, +now: Nat) -> {Laws.disturbs(c2, c1) == False{} : Bool} -> {T.reply_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)) == T.reply_of(T.exec(c1, db, now)) : R.Reply}:
  match c1:
    case R.Ping{}:
      e => {==}
    case R.Echo{m}:
      e => {==}
    case R.Get{+k}:
      e => loc_reply(R.Get{k}, T.db_of(T.exec(c2, db, now)), db, now)({==})(t_frame(c2, db, k, now, e))
    case R.Set{k, v}:
      e => {==}
    case R.Del{+ks}:
      del_reply_after(ks, c2, db, now)
    case R.Exists{+ks}:
      e => Equal.cong(Nat, R.Reply, z => R.r_int(z), R.exists_keys(ks, now, T.db_of(T.exec(c2, db, now))), R.exists_keys(ks, now, db), exists_after(ks, c2, db, now)(e))
    case R.IncrBy{+k, +by}:
      e => loc_reply(R.IncrBy{k, by}, T.db_of(T.exec(c2, db, now)), db, now)({==})(t_frame(c2, db, k, now, e))
    case R.MGet{+ks}:
      e => Equal.cong(List<&2, R.Reply>, R.Reply, z => R.RArray{z}, R.mget_keys(ks, now, T.db_of(T.exec(c2, db, now))), R.mget_keys(ks, now, db), mget_after(ks, c2, db, now)(e))
    case R.MSet{ps}:
      e => {==}
    case R.DbSize{}:
      e => %Equal.sym(KV.Trie<KV.Val>, T.db_of(T.exec(c2, db, now)), db, t_reads_keep_db(c2, db, now, not_false(Laws.is_read(c2))(e))) : {T.reply_of(T.exec(R.DbSize{}, _, now)) == T.reply_of(T.exec(R.DbSize{}, db, now)) : R.Reply}
           {==}
    case R.FlushDb{}:
      e => {==}
    case R.Keys{p}:
      e => %Equal.sym(KV.Trie<KV.Val>, T.db_of(T.exec(c2, db, now)), db, t_reads_keep_db(c2, db, now, not_false(Laws.is_read(c2))(e))) : {T.reply_of(T.exec(R.Keys{p}, _, now)) == T.reply_of(T.exec(R.Keys{p}, db, now)) : R.Reply}
           {==}
    case R.Sort{k, o}:
      e => %Equal.sym(KV.Trie<KV.Val>, T.db_of(T.exec(c2, db, now)), db, t_reads_keep_db(c2, db, now, not_false(Laws.is_read(c2))(e))) : {T.reply_of(T.exec(R.Sort{k, o}, _, now)) == T.reply_of(T.exec(R.Sort{k, o}, db, now)) : R.Reply}
           {==}
    case R.Scan{a}:
      e => %Equal.sym(KV.Trie<KV.Val>, T.db_of(T.exec(c2, db, now)), db, t_reads_keep_db(c2, db, now, not_false(Laws.is_read(c2))(e))) : {T.reply_of(T.exec(R.Scan{a}, _, now)) == T.reply_of(T.exec(R.Scan{a}, db, now)) : R.Reply}
           {==}
    case R.Peek{+k, +o}:
      e => loc_reply(R.Peek{k, o}, T.db_of(T.exec(c2, db, now)), db, now)({==})(t_frame(c2, db, k, now, e))
    case R.Upd{+k, +op}:
      e => loc_reply(R.Upd{k, op}, T.db_of(T.exec(c2, db, now)), db, now)({==})(t_frame(c2, db, k, now, e))
    case R.MSetNx{+ps}:
      e => %live_agree(ps, T.db_of(T.exec(c2, db, now)), db, now)(frame_agree(c2, db, Laws.pair_keys(ps), now)(e)) : {T.reply_of(T.msetnx(R.pairs.live(ps, now, T.db_of(T.exec(c2, db, now))), ps, T.db_of(T.exec(c2, db, now)))) == T.reply_of(T.msetnx(_, ps, db)) : R.Reply}
           msetnx_rep(R.pairs.live(ps, now, T.db_of(T.exec(c2, db, now))), ps, T.db_of(T.exec(c2, db, now)), db)
    case R.Rename{+s, +d, +nx}:
      e => %ren_find_eq(T.db_of(T.exec(c2, db, now)), db, s, d, nx, now)(frame_agree(c2, db, [s, d], now)(e)) : {T.reply_of(T.ren(T.ren.find(T.db_of(T.exec(c2, db, now)), s, d, nx, now), nx, s, d, T.db_of(T.exec(c2, db, now)))) == T.reply_of(T.ren(_, nx, s, d, db)) : R.Reply}
           ren_rep(T.ren.find(T.db_of(T.exec(c2, db, now)), s, d, nx, now), nx, s, d, T.db_of(T.exec(c2, db, now)), db)
    case R.BitOp{+op, +d, +srcs}:
      +e => %bitop_wrong_eq(srcs, T.db_of(T.exec(c2, db, now)), db, now)(frame_agree(c2, db, srcs, now)(e)) : {T.reply_of(T.bitop.go(R.bitop.wrong(srcs, now, T.db_of(T.exec(c2, db, now))), op, srcs, d, T.db_of(T.exec(c2, db, now)), now)) == T.reply_of(T.bitop.go(_, op, srcs, d, db, now)) : R.Reply}
            bitop_go_rep(R.bitop.wrong(srcs, now, T.db_of(T.exec(c2, db, now))), op, srcs, d, T.db_of(T.exec(c2, db, now)), db, now)(frame_agree(c2, db, srcs, now)(e))
    case R.LMove{+s, +d, +w}:
      e => %mv_find_eq(T.db_of(T.exec(c2, db, now)), db, s, d, w, now)(frame_agree(c2, db, [s, d], now)(e)) : {T.reply_of(T.mv.do(T.mv.find(T.db_of(T.exec(c2, db, now)), s, d, w, now), w, s, d, T.db_of(T.exec(c2, db, now)))) == T.reply_of(T.mv.do(_, w, s, d, db)) : R.Reply}
           mv_do_rep(T.mv.find(T.db_of(T.exec(c2, db, now)), s, d, w, now), w, s, d, T.db_of(T.exec(c2, db, now)), db)
    case R.LMPop{+ks, +left, +n}:
      +e => %lmpop_first_eq(ks, T.db_of(T.exec(c2, db, now)), db, now)(frame_agree(c2, db, ks, now)(e)) : {T.reply_of(T.lmpop.at(T.lmpop.first(ks, T.lmpop.head(ks, T.db_of(T.exec(c2, db, now)), now), T.db_of(T.exec(c2, db, now)), now), left, n, T.db_of(T.exec(c2, db, now)), now)) == T.reply_of(T.lmpop.at(_, left, n, db, now)) : R.Reply}
            lmpop_at_rep(T.lmpop.first(ks, T.lmpop.head(ks, T.db_of(T.exec(c2, db, now)), now), T.db_of(T.exec(c2, db, now)), now), left, n, T.db_of(T.exec(c2, db, now)), db, now)(first_agree(ks, T.lmpop.head(ks, T.db_of(T.exec(c2, db, now)), now), T.db_of(T.exec(c2, db, now)), T.db_of(T.exec(c2, db, now)), db, now)(frame_agree(c2, db, ks, now)(e)))
    case R.SOp{+op, +ks}:
      +e => Equal.cong(R.SGot, R.Reply, z => R.sop.reply(op, ks, z), R.sets.at(ks, now, T.db_of(T.exec(c2, db, now))), R.sets.at(ks, now, db), sets_at_eq(ks, T.db_of(T.exec(c2, db, now)), db, now)(frame_agree(c2, db, ks, now)(e)))
    case R.SStore{+op, +d, +srcs}:
      +e => %sets_at_eq(srcs, T.db_of(T.exec(c2, db, now)), db, now)(frame_agree(c2, db, srcs, now)(e)) : {T.reply_of(T.sstore.do(R.sets.at(srcs, now, T.db_of(T.exec(c2, db, now))), op, srcs, d, T.db_of(T.exec(c2, db, now)), now)) == T.reply_of(T.sstore.do(_, op, srcs, d, db, now)) : R.Reply}
            sstore_do_rep(R.sets.at(srcs, now, T.db_of(T.exec(c2, db, now))), op, srcs, d, T.db_of(T.exec(c2, db, now)), db, now)
    case R.SMv{+s, +d, +w}:
      e => %smv_find_eq(T.db_of(T.exec(c2, db, now)), db, s, d, w, now)(frame_agree(c2, db, [s, d], now)(e)) : {T.reply_of(T.smove.do(T.smv.find(T.db_of(T.exec(c2, db, now)), s, d, w, now), s, d, w, T.db_of(T.exec(c2, db, now)), now)) == T.reply_of(T.smove.do(_, s, d, w, db, now)) : R.Reply}
           smove_do_rep(T.smv.find(T.db_of(T.exec(c2, db, now)), s, d, w, now), s, d, w, T.db_of(T.exec(c2, db, now)), db, now)
    case R.ZOp{+op, +ks}:
      +e => Equal.cong(R.ZGot, R.Reply, z => R.zop.reply(op, z), R.zsrcs.at(ks, now, T.db_of(T.exec(c2, db, now))), R.zsrcs.at(ks, now, db), zsrcs_at_eq(ks, T.db_of(T.exec(c2, db, now)), db, now)(frame_agree(c2, db, ks, now)(e)))
    case R.ZStore{+op, +d, +srcs}:
      +e => %zsrcs_at_eq(srcs, T.db_of(T.exec(c2, db, now)), db, now)(frame_agree(c2, db, srcs, now)(e)) : {T.reply_of(T.zstore.do(R.zsrcs.at(srcs, now, T.db_of(T.exec(c2, db, now))), op, d, T.db_of(T.exec(c2, db, now)), now)) == T.reply_of(T.zstore.do(_, op, d, db, now)) : R.Reply}
            zstore_do_rep(R.zsrcs.at(srcs, now, T.db_of(T.exec(c2, db, now))), op, d, T.db_of(T.exec(c2, db, now)), db, now)
    case R.ZRangeStore{+d, +s, +q}:
      +e => %read_agree(T.db_of(T.exec(c2, db, now)), db, s, now, ag_head(T.db_of(T.exec(c2, db, now)), db, s, Nil{}, frame_agree(c2, db, [s], now)(e))) : {T.reply_of(T.zrs.of(KV.read(KV.Val, T.db_of(T.exec(c2, db, now)), s, now), q, d, T.db_of(T.exec(c2, db, now)), now)) == T.reply_of(T.zrs.of(_, q, d, db, now)) : R.Reply}
            zrs_of_rep(KV.read(KV.Val, T.db_of(T.exec(c2, db, now)), s, now), q, d, T.db_of(T.exec(c2, db, now)), db, now)
    case R.ZMPop{+ks, +max, +c}:
      +e => %lmpop_first_eq(ks, T.db_of(T.exec(c2, db, now)), db, now)(frame_agree(c2, db, ks, now)(e)) : {T.reply_of(T.zmpop.at(T.lmpop.first(ks, T.lmpop.head(ks, T.db_of(T.exec(c2, db, now)), now), T.db_of(T.exec(c2, db, now)), now), max, c, T.db_of(T.exec(c2, db, now)), now)) == T.reply_of(T.zmpop.at(_, max, c, db, now)) : R.Reply}
            zmpop_at_rep(T.lmpop.first(ks, T.lmpop.head(ks, T.db_of(T.exec(c2, db, now)), now), T.db_of(T.exec(c2, db, now)), now), max, c, T.db_of(T.exec(c2, db, now)), db, now)(first_agree(ks, T.lmpop.head(ks, T.db_of(T.exec(c2, db, now)), now), T.db_of(T.exec(c2, db, now)), T.db_of(T.exec(c2, db, now)), db, now)(frame_agree(c2, db, ks, now)(e)))
    case R.Own{o}:
      e => {==}
    case R.Bad{r}:
      e => {==}

# A swap inside a batch
# ---------------------
# After c1 then c2 (A) and c2 then c1 (B), the rest of the batch runs on
# two tries where every key has one entry. tw(H, d) is the run H, newest
# first, on d; eq_at is the claim at one key after any such run, a
# top-level function called at whatever key a step needs.

# A key that c1 writes, c2 does not write (clash_at): a key DEL or MSET
# writes is one of their keys, which c2 does not write
def or_clash(+c2: R.Cmd, +j: String, +k: String, -rest: List<&2, String>, +w: {Laws.writes(c2, k) == False{} : Bool}, b: Bool) -> {b == KV.str_eq(j, k) : Bool} -> Reflect(String, j, k, b) -> {Bool.and(Laws.any_key(j, rest), Laws.writes(c2, j)) == False{} : Bool} -> {Bool.and(Bool.or(b, Laws.any_key(j, rest)), Laws.writes(c2, j)) == False{} : Bool}:
  match b:
    case True{}:
      eb => ejk => ih => %Equal.sym(String, j, k, ejk) : {Laws.writes(c2, _) == False{} : Bool}
                         w
    case False{}:
      eb => ne => ih => ih

def pair_clash(+c2: R.Cmd, +j: String, +k: String, -rest: List<&2, R.KVPair>, +w: {Laws.writes(c2, k) == False{} : Bool}, b: Bool) -> {b == KV.str_eq(j, k) : Bool} -> Reflect(String, j, k, b) -> {Bool.and(Laws.any_pair(j, rest), Laws.writes(c2, j)) == False{} : Bool} -> {Bool.and(Bool.or(b, Laws.any_pair(j, rest)), Laws.writes(c2, j)) == False{} : Bool}:
  match b:
    case True{}:
      eb => ejk => ih => %Equal.sym(String, j, k, ejk) : {Laws.writes(c2, _) == False{} : Bool}
                         w
    case False{}:
      eb => ne => ih => ih

def pairs_clash(+c2: R.Cmd, +j: String, ps: List<&2, R.KVPair>) -> {Laws.writes_pairs(c2, ps) == False{} : Bool} -> {Bool.and(Laws.any_pair(j, ps), Laws.writes(c2, j)) == False{} : Bool}:
  match ps:
    case Nil{}:
      e => {==}
    case Con{R.KP{+k, v}, +rest}:
      +e => pair_clash(c2, j, k, rest, or_false_l(Laws.writes(c2, k), Laws.writes_pairs(c2, rest))(e), KV.str_eq(j, k))({==})(str_refl(j, k))(pairs_clash(c2, j, rest)(or_false_r(Laws.writes(c2, k), Laws.writes_pairs(c2, rest))(e)))

# a command that only reads writes no key
def read_writes(c: R.Cmd, +j: String) -> {Laws.is_read(c) == True{} : Bool} -> {Laws.writes(c, j) == False{} : Bool}:
  match c:
    case R.Ping{}:
      e => {==}
    case R.Echo{m}:
      e => {==}
    case R.Get{k}:
      e => {==}
    case R.Set{k, v}:
      e => Empty.absurd({Laws.writes(R.Set{k, v}, j) == False{} : Bool}, false_true(e))
    case R.Del{ks}:
      e => Empty.absurd({Laws.writes(R.Del{ks}, j) == False{} : Bool}, false_true(e))
    case R.Exists{ks}:
      e => {==}
    case R.IncrBy{k, by}:
      e => Empty.absurd({Laws.writes(R.IncrBy{k, by}, j) == False{} : Bool}, false_true(e))
    case R.MGet{ks}:
      e => {==}
    case R.MSet{ps}:
      e => Empty.absurd({Laws.writes(R.MSet{ps}, j) == False{} : Bool}, false_true(e))
    case R.DbSize{}:
      e => {==}
    case R.FlushDb{}:
      e => Empty.absurd({Laws.writes(R.FlushDb{}, j) == False{} : Bool}, false_true(e))
    case R.Keys{p}:
      e => {==}
    case R.Sort{k, o}:
      e => {==}
    case R.Scan{a}:
      e => {==}
    case R.Peek{k, o}:
      e => {==}
    case R.Upd{k, op}:
      e => Empty.absurd({Laws.writes(R.Upd{k, op}, j) == False{} : Bool}, false_true(e))
    case R.MSetNx{ps}:
      e => Empty.absurd({Laws.writes(R.MSetNx{ps}, j) == False{} : Bool}, false_true(e))
    case R.Rename{s, d, nx}:
      e => Empty.absurd({Laws.writes(R.Rename{s, d, nx}, j) == False{} : Bool}, false_true(e))
    case R.BitOp{op, d, srcs}:
      e => Empty.absurd({Laws.writes(R.BitOp{op, d, srcs}, j) == False{} : Bool}, false_true(e))
    case R.LMove{op, d, srcs}:
      e => Empty.absurd({Laws.writes(R.LMove{op, d, srcs}, j) == False{} : Bool}, false_true(e))
    case R.LMPop{op, d, srcs}:
      e => Empty.absurd({Laws.writes(R.LMPop{op, d, srcs}, j) == False{} : Bool}, false_true(e))
    case R.SOp{op, ks}:
      e => {==}
    case R.SStore{op, d, srcs}:
      e => Empty.absurd({Laws.writes(R.SStore{op, d, srcs}, j) == False{} : Bool}, false_true(e))
    case R.SMv{s, d, w}:
      e => Empty.absurd({Laws.writes(R.SMv{s, d, w}, j) == False{} : Bool}, false_true(e))
    case R.ZOp{op, ks}:
      e => {==}
    case R.ZStore{op, d, srcs}:
      e => Empty.absurd({Laws.writes(R.ZStore{op, d, srcs}, j) == False{} : Bool}, false_true(e))
    case R.ZRangeStore{d, s, q}:
      e => Empty.absurd({Laws.writes(R.ZRangeStore{d, s, q}, j) == False{} : Bool}, false_true(e))
    case R.ZMPop{ks, max, c}:
      e => Empty.absurd({Laws.writes(R.ZMPop{ks, max, c}, j) == False{} : Bool}, false_true(e))
    case R.Own{o}:
      e => {==}
    case R.Bad{r}:
      e => {==}

def key_clash(+c2: R.Cmd, +j: String, +k: String, +w: {Laws.writes(c2, k) == False{} : Bool}, b: Bool) -> {b == KV.str_eq(j, k) : Bool} -> Reflect(String, j, k, b) -> {Bool.and(b, Laws.writes(c2, j)) == False{} : Bool}:
  match b:
    case True{}:
      eb => ejk => %Equal.sym(String, j, k, ejk) : {Laws.writes(c2, _) == False{} : Bool}
                   w
    case False{}:
      eb => ne => {==}

def any_clash(+c2: R.Cmd, +j: String, ks: List<&2, String>) -> {Laws.writes_any(c2, ks) == False{} : Bool} -> {Bool.and(Laws.any_key(j, ks), Laws.writes(c2, j)) == False{} : Bool}:
  match ks:
    case Nil{}:
      e => {==}
    case Con{+k, +rest}:
      +e => or_clash(c2, j, k, rest, or_false_l(Laws.writes(c2, k), Laws.writes_any(c2, rest))(e), KV.str_eq(j, k))({==})(str_refl(j, k))(any_clash(c2, j, rest)(or_false_r(Laws.writes(c2, k), Laws.writes_any(c2, rest))(e)))

# a key that c2 does not write in common with c1 is written by at most one
# of them
def clash_w_at(c1: R.Cmd, +c2: R.Cmd, +j: String) -> {Laws.clash_w(c2, c1) == False{} : Bool} -> {Bool.and(Laws.writes(c1, j), Laws.writes(c2, j)) == False{} : Bool}:
  match c1:
    case R.Ping{}:
      e => {==}
    case R.Echo{m}:
      e => {==}
    case R.Get{k}:
      e => {==}
    case R.Set{+k, +v}:
      e => key_clash(c2, j, k, e, KV.str_eq(j, k))({==})(str_refl(j, k))
    case R.Del{+ks}:
      any_clash(c2, j, ks)
    case R.Exists{ks}:
      e => {==}
    case R.IncrBy{+k, +by}:
      e => key_clash(c2, j, k, e, KV.str_eq(j, k))({==})(str_refl(j, k))
    case R.MGet{ks}:
      e => {==}
    case R.MSet{+ps}:
      pairs_clash(c2, j, ps)
    case R.DbSize{}:
      e => {==}
    case R.FlushDb{}:
      e => read_writes(c2, j)(not_false(Laws.is_read(c2))(e))
    case R.Keys{p}:
      e => {==}
    case R.Sort{k, o}:
      e => {==}
    case R.Scan{a}:
      e => {==}
    case R.Peek{k, o}:
      e => {==}
    case R.Upd{+k, +op}:
      e => key_clash(c2, j, k, e, KV.str_eq(j, k))({==})(str_refl(j, k))
    case R.MSetNx{+ps}:
      pairs_clash(c2, j, ps)
    case R.Rename{+s, +d, +nx}:
      any_clash(c2, j, [s, d])
    case R.BitOp{op, +d, srcs}:
      e => key_clash(c2, j, d, e, KV.str_eq(j, d))({==})(str_refl(j, d))
    case R.LMove{+s, +d, w}:
      any_clash(c2, j, [s, d])
    case R.LMPop{+ks, left, n}:
      any_clash(c2, j, ks)
    case R.SOp{op, ks}:
      e => {==}
    case R.SStore{op, +d, srcs}:
      e => key_clash(c2, j, d, e, KV.str_eq(j, d))({==})(str_refl(j, d))
    case R.SMv{+s, +d, w}:
      any_clash(c2, j, [s, d])
    case R.ZOp{op, ks}:
      e => {==}
    case R.ZStore{op, +d, srcs}:
      e => key_clash(c2, j, d, e, KV.str_eq(j, d))({==})(str_refl(j, d))
    case R.ZRangeStore{+d, s, q}:
      e => key_clash(c2, j, d, e, KV.str_eq(j, d))({==})(str_refl(j, d))
    case R.ZMPop{+ks, max, c}:
      any_clash(c2, j, ks)
    case R.Own{o}:
      e => {==}
    case R.Bad{r}:
      e => {==}

def clash_at(+c1: R.Cmd, +c2: R.Cmd, +j: String) -> {Laws.clash(c2, c1) == False{} : Bool} -> {Bool.and(Laws.writes(c1, j), Laws.writes(c2, j)) == False{} : Bool}:
  e => clash_w_at(c1, c2, j)(or_false_l(Laws.clash_w(c2, c1), Bool.or(Laws.spoils(c1, c2), Laws.spoils(c2, c1)))(e))

# two commands that do not clash write no key the other's writes depend on
def clash_sp(+c1: R.Cmd, +c2: R.Cmd, e: {Laws.clash(c2, c1) == False{} : Bool}) -> {Bool.or(Laws.spoils(c1, c2), Laws.spoils(c2, c1)) == False{} : Bool}:
  or_false_r(Laws.clash_w(c2, c1), Bool.or(Laws.spoils(c1, c2), Laws.spoils(c2, c1)))(e)

def tw(H: List<&2, R.Cmd>, d: KV.Trie<KV.Val>, +now: Nat) -> KV.Trie<KV.Val>:
  match H:
    case Nil{}:
      d
    case Con{+c, older}:
      T.db_of(T.exec(c, tw(older, d, now), now))

# right after the two, the keys of ks have one entry on both sides
def base_ag(+c1: R.Cmd, +c2: R.Cmd, +db: KV.Trie<KV.Val>, ks: List<&2, String>, +now: Nat, +e: {Laws.clash(c2, c1) == False{} : Bool}) -> Agree(T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), ks):
  match ks:
    case Nil{}:
      Unit{}
    case Con{+k, +rest}:
      (t_commute_reads(c1, c2, db, k, now, clash_at(c1, c2, k)(e), clash_sp(c1, c2, e)), base_ag(c1, c2, db, rest, now, e))

# a command run on two tries that agree on the keys its writes depend on,
# and on the keys of ks: they agree on ks after it
def step_ag(+c: R.Cmd, +t: KV.Trie<KV.Val>, +u: KV.Trie<KV.Val>, ks: List<&2, String>, +now: Nat, +agd: Agree(t, u, Laws.deps(c))) -> Agree(t, u, ks) -> Agree(T.db_of(T.exec(c, t, now)), T.db_of(T.exec(c, u, now)), ks):
  match ks:
    case Nil{}:
      agk => Unit{}
    case Con{+k, +rest}:
      +agk => (point_cmd(c, t, u, k, now)(agd)(ag_head(t, u, k, rest, agk)), step_ag(c, t, u, rest, now, agd)(ag_tail(t, u, k, rest, agk)))

# after any run H, the keys of ks have one entry on both sides
def eq_gen(+c1: R.Cmd, +c2: R.Cmd, +db: KV.Trie<KV.Val>, H: List<&2, R.Cmd>, +ks: List<&2, String>, +now: Nat, +e: {Laws.clash(c2, c1) == False{} : Bool}) -> Agree(tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), ks):
  match H:
    case Nil{}:
      base_ag(c1, c2, db, ks, now, e)
    case Con{+c, +older}:
      step_ag(c, tw(older, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), tw(older, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), ks, now, eq_gen(c1, c2, db, older, Laws.deps(c), now, e))(eq_gen(c1, c2, db, older, ks, now, e))

# and so every key has one entry on both sides
def eq_at(+c1: R.Cmd, +c2: R.Cmd, +db: KV.Trie<KV.Val>, +H: List<&2, R.Cmd>, +j: String, +now: Nat, +e: {Laws.clash(c2, c1) == False{} : Bool}) -> {KV.entry(KV.Val, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), j) == KV.entry(KV.Val, tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), j) : Maybe<&2, KV.Item<KV.Val>>}:
  ag_head(tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), j, Nil{}, eq_gen(c1, c2, db, H, [j], now, e))

def exists_tw(+c1: R.Cmd, +c2: R.Cmd, +db: KV.Trie<KV.Val>, +H: List<&2, R.Cmd>, +now: Nat, +e: {Laws.clash(c2, c1) == False{} : Bool}, ks: List<&2, String>) -> {R.exists_keys(ks, now, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now)) == R.exists_keys(ks, now, tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now)) : Nat}:
  match ks:
    case Nil{}:
      {==}
    case Con{+k, +rest}:
      %read_eq(tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), k, now) : {Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, _), 1n, 0n), R.exists_keys(rest, now, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now))) == Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, KV.read(KV.Val, tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), k, now)), 1n, 0n), R.exists_keys(rest, now, tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now))) : Nat}
      %read_eq(tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now), k, now) : {Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), k), now)), 1n, 0n), R.exists_keys(rest, now, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now))) == Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, _), 1n, 0n), R.exists_keys(rest, now, tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now))) : Nat}
      %eq_at(c1, c2, db, H, k, now, e) : {Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), k), now)), 1n, 0n), R.exists_keys(rest, now, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now))) == Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, _, now)), 1n, 0n), R.exists_keys(rest, now, tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now))) : Nat}
      Equal.cong(Nat, Nat, z => Nat.add(Bool.pick(Nat, Maybe.is_some(&2, KV.Val, Laws.live_val(KV.Val, KV.entry(KV.Val, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now), k), now)), 1n, 0n), z), R.exists_keys(rest, now, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now)), R.exists_keys(rest, now, tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now)), exists_tw(c1, c2, db, H, now, e, rest))

def mget_tw(+c1: R.Cmd, +c2: R.Cmd, +db: KV.Trie<KV.Val>, +H: List<&2, R.Cmd>, +now: Nat, +e: {Laws.clash(c2, c1) == False{} : Bool}, ks: List<&2, String>) -> {R.mget_keys(ks, now, tw(H, T.db_of(T.exec(c2, T.db_of(T.exec(c1, db, now)), now)), now)) == R.mget_keys(ks, now, tw(H, T.db_of(T.exec(c1, T.db_of(T.exec(c2, db, now)), now)), now)) : List<&2, R.Reply>}:
