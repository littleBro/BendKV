# acl.bend: users and their permissions, as Redis 7.0.15's ACL keeps them
# (acl.c). A user is enabled or not, has passwords (kept as their SHA-256)
# or takes any password (nopass), and has selectors: the root one, which
# the rules outside parentheses change, and the ones the rules in
# parentheses add. A selector allows commands, keys and channels; a call
# is allowed when one selector allows its command, every key it names and
# every channel it publishes or subscribes to.

import Base
import ./redis.bend as R
import ./resp.bend as P
import ./float.bend as F
import ./command.bend as K

# The tables
# ----------
# Generated by tools/gen_commands.py from what Redis 7.0.15 answers (ACL
# CAT, and the stats keys of src/redis.bend).

# BEGIN gen_commands: acl
# Redis 7.0.15's commands and subcommands, by ACL id: their full names
# in byte order
