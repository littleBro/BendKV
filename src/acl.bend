# SHA-256
# -------
# FIPS 180-4's SHA-256 of a string's bytes, written as 64 lowercase hex
# digits: what Redis keeps of a password (ACLHashPassword)

type H8 is Data:
  H8{a: U32, b: U32, c: U32, d: U32, e: U32, f: U32, g: U32, h: U32}

def sha.h0() -> H8:
  H8{1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225}

# the round constants, in order
def sha.k() -> List<&2, U32>:
  [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
   3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
   3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
   2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
   666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
   2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
   430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
   1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]

def sha.rotr(+x: U32, +n: Nat) -> U32:
  U32.or(U32.shrn(x, n), U32.shln(x, Nat.sub(32n, n)))

def sha.bs0(+x: U32) -> U32:
  U32.xor(U32.xor(sha.rotr(x, 2n), sha.rotr(x, 13n)), sha.rotr(x, 22n))

def sha.bs1(+x: U32) -> U32:
  U32.xor(U32.xor(sha.rotr(x, 6n), sha.rotr(x, 11n)), sha.rotr(x, 25n))

def sha.ss0(+x: U32) -> U32:
  U32.xor(U32.xor(sha.rotr(x, 7n), sha.rotr(x, 18n)), U32.shrn(x, 3n))

def sha.ss1(+x: U32) -> U32:
  U32.xor(U32.xor(sha.rotr(x, 17n), sha.rotr(x, 19n)), U32.shrn(x, 10n))

def sha.ch(+e: U32, +f: U32, +g: U32) -> U32:
  U32.xor(U32.and(e, f), U32.and(U32.not(e), g))

def sha.maj(+a: U32, +b: U32, +c: U32) -> U32:
  U32.xor(U32.xor(U32.and(a, b), U32.and(a, c)), U32.and(b, c))

# x divided by 256, k times
def sha.down(k: Nat, +x: Nat) -> Nat:
  match k:
    case 0n:
      x
    case 1n+p:
      sha.down(p, Nat.div(x, 256n))

# byte i of the padding after the n bytes of a message padded to t bytes:
# 0x80, zeros, then the message's length in bits, big-endian, in the last
# eight
def sha.pad(+n: Nat, +t: Nat, +i: Nat) -> U32:
  Bool.pick(U32, Nat.is_eq(i, n), 128,
    Bool.pick(U32, Nat.is_lt(Nat.add(i, 8n), t), 0,
      U32.from_nat(Nat.mod(sha.down(Nat.sub(Nat.sub(t, 1n), i), Nat.mul(n, 8n)), 256n))))

# byte i of s, of n bytes, padded to t
def sha.byte(+s: String, +n: Nat, +t: Nat, +i: Nat) -> U32:
  Bool.pick(U32, Nat.is_lt(i, n), String.code_at(s, i), sha.pad(n, t, i))

# the big-endian word at byte i
def sha.word(+s: String, +n: Nat, +t: Nat, +i: Nat) -> U32:
  U32.or(U32.or(U32.shln(sha.byte(s, n, t, i), 24n), U32.shln(sha.byte(s, n, t, Nat.add(i, 1n)), 16n)),
    U32.or(U32.shln(sha.byte(s, n, t, Nat.add(i, 2n)), 8n), sha.byte(s, n, t, Nat.add(i, 3n))))

# the k words from byte i put before ws, the last first
def sha.words(k: Nat, +s: String, +n: Nat, +t: Nat, +i: Nat, ws: List<&2, U32>) -> List<&2, U32>:
  match k:
    case 0n:
      ws
    case 1n+p:
      sha.words(p, s, n, t, Nat.add(i, 4n), sha.word(s, n, t, i) <> ws)

# the word i places before the newest of ws (newest first)
def sha.at(+ws: List<&2, U32>, i: Nat) -> U32:
  match ws i:
    case Nil{} _:
      0
    case Con{+w, rest} 0n:
      w
    case Con{w, rest} 1n+p:
      sha.at(rest, p)

# the schedule's next word, from the sixteen before it (newest first)
def sha.next(+ws: List<&2, U32>) -> U32:
  U32.add(U32.add(sha.ss1(sha.at(ws, 1n)), sha.at(ws, 6n)), U32.add(sha.ss0(sha.at(ws, 14n)), sha.at(ws, 15n)))

# the schedule's words 16 to 63 put before its first sixteen (newest first)
def sha.sched(k: Nat, ws: List<&2, U32>) -> List<&2, U32>:
  match k:
    case 0n:
      ws
    case 1n+p:
      +w = ws
      sha.sched(p, sha.next(w) <> w)

def sha.step(st: H8, +kw: U32) -> H8:
  match st:
    case H8{+a, +b, +c, d, +e, +f, +g, h}:
      +t1 = U32.add(U32.add(h, sha.bs1(e)), U32.add(sha.ch(e, f, g), kw))
      H8{U32.add(t1, U32.add(sha.bs0(a), sha.maj(a, b, c))), a, b, c, U32.add(d, t1), e, f, g}

# the 64 rounds of a block's schedule ws (in order) over st
def sha.rounds(ks: List<&2, U32>, ws: List<&2, U32>, st: H8) -> H8:
  match ks ws:
    case Con{k, kt} Con{w, wt}:
      sha.rounds(kt, wt, sha.step(st, U32.add(k, w)))
    case _ _:
      st

def sha.add(x: H8, y: H8) -> H8:
  match x y:
    case H8{a0, b0, c0, d0, e0, f0, g0, h0} H8{a1, b1, c1, d1, e1, f1, g1, h1}:
      H8{U32.add(a0, a1), U32.add(b0, b1), U32.add(c0, c1), U32.add(d0, d1), U32.add(e0, e1), U32.add(f0, f1), U32.add(g0, g1), U32.add(h0, h1)}

# the k blocks of s (n bytes, padded to t) from byte i, over st
def sha.blocks(k: Nat, +s: String, +n: Nat, +t: Nat, +i: Nat, st: H8) -> H8:
  match k:
    case 0n:
      st
    case 1n+p:
      +h = st
      +ws = List.reverse(&2, U32, sha.sched(48n, sha.words(16n, s, n, t, i, Nil{})))
      sha.blocks(p, s, n, t, Nat.add(i, 64n), sha.add(h, sha.rounds(sha.k(), ws, h)))

def sha.digit(+d: U32) -> String:
  String.from_list([Chr{Bool.pick(U32, U32.is_lt(d, 10), U32.add(d, 48), U32.add(d, 87))}])

# the k lowest hex digits of x put before acc
def sha.hex(k: Nat, +x: U32, acc: String) -> String:
  match k:
    case 0n:
      acc
    case 1n+p:
      sha.hex(p, U32.shrn(x, 4n), sha.digit(U32.and(x, 15)) ++ acc)

def sha.out(st: H8) -> String:
  match st:
    case H8{a, b, c, d, e, f, g, h}:
      sha.hex(8n, a, sha.hex(8n, b, sha.hex(8n, c, sha.hex(8n, d, sha.hex(8n, e, sha.hex(8n, f, sha.hex(8n, g, sha.hex(8n, h, ""))))))))

# SHA-256 of s's bytes (each char a byte), as 64 lowercase hex digits
def sha256(+s: String) -> String:
  +n = String.length(s)
  +t = Nat.mul(Nat.div(Nat.add(n, 72n), 64n), 64n)
  sha.out(sha.blocks(Nat.div(t, 64n), s, n, t, 0n, sha.h0()))


# Types
# -----

# a key pattern: what it allows (1 reading, 2 writing, 3 both) and its glob
type KPat is Data:
  KPat{rw: Nat, pat: String}

# the first arguments a selector allows a command it does not allow
# (+select|0): the command's id and the arguments, as each came first
type Firsts is Data:
  Firsts{id: Nat, args: List<&2, String>}

# a selector: whether +@all set the bit of commands to come (Redis's bit
# 1023: all), whether it allows every command (allc: +@all, and no
# command denied since), its commands' bits (32 a word, by id), the first
# arguments it allows, its command rules as given (Redis 7.2's: lowercase,
# each without the rules before it for the same name or its subcommands),
# whether it allows every key (allk), its key patterns, whether it allows
# every channel (allch), its channel patterns
type Sel is Data:
  Sel{all: Bool, allc: Bool, bits: List<&2, U32>, firsts: List<&2, Firsts>, rules: List<&2, String>, allk: Bool, keys: List<&2, KPat>, allch: Bool, chans: List<&2, String>}

# a user: its name, whether it is on, whether any password does
# (nopass), its payload flag (0 none, 1 sanitize-payload, 2
# skip-sanitize-payload), its passwords' SHA-256 in the order they came,
# and its selectors, the root first
type User is Data:
  User{name: String, on: Bool, nopass: Bool, pay: Nat, pass: List<&2, String>, sels: List<&2, Sel>}

# an entry of the ACL LOG: how many events it counts, why (command, key,
# channel or auth), where (toplevel or multi), what (the command's full
# name, the key, the channel, or AUTH as typed), the user, when it last
# counted one (ms since 1970), and its client's line (CLIENT LIST's) then
type Ent is Data:
  Ent{count: Nat, why: String, ctx: String, obj: String, user: String, at: Nat, info: String}

# the ACL: the default user, the other users in the order of their names,
# the log (newest first), the users DELUSER removed, whose clients are to
# close, the requirepass it last gave the default user (rp), and ACL
# GENPASS's secret key and count of the blocks it made
type Acl is Data:
  Acl{dflt: User, users: List<&2, User>, log: List<&2, Ent>, gone: List<&2, String>, rp: String, key: String, ctr: Nat, rcl: List<&2, Nat>}

# Small things
# ------------

def acl.nth(xs: List<&2, String>, i: Nat) -> String:
  match xs i:
    case Nil{} _:
      ""
    case Con{x, rest} 0n:
      x
    case Con{x, rest} 1n+p:
      acl.nth(rest, p)

# the same of a list read in place (a command line the check borrows)
def acl.arg(+xs: List<&2, String>, +i: Nat) -> String:
  match xs i:
    case Nil{} _:
      ""
    case Con{+x, +rest} 0n:
      x
    case Con{+x, +rest} 1n+p:
      acl.arg(rest, p)

def acl.find(ns: List<&2, String>, +n: String, +i: Nat) -> Maybe<&2, Nat>:
  match ns:
    case Nil{}:
      None{}
    case Con{x, rest}:
      Bool.pick(Maybe<&2, Nat>, String.eq(x, n), Some{i}, acl.find(rest, n, Nat.add(i, 1n)))

def acl.has(+x: String, xs: List<&2, String>) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{+y, rest}:
      Bool.or(String.eq(x, y), acl.has(x, rest))

def acl.has.nc(+x: String, xs: List<&2, String>) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{+y, rest}:
      Bool.or(String.eq(String.to_lower(x), String.to_lower(y)), acl.has.nc(x, rest))

# a command's full name by its id
def acl.name(+id: Nat) -> String:
  acl.nth(acl.names(), id)

# a command's id by its full name, case aside (Redis's ACLLookupCommand:
# a name with one '|' at most, its parent having subcommands)
def acl.id(+name: String) -> Maybe<&2, Nat>:
  acl.find(acl.names(), String.to_lower(name), 0n)

def acl.subs.of(ns: List<&2, String>, +p: String, +i: Nat) -> List<&2, Nat>:
  match ns:
    case Nil{}:
      Nil{}
    case Con{+x, rest}:
      +more = acl.subs.of(rest, p, Nat.add(i, 1n))
      Bool.pick(List<&2, Nat>, String.starts_with(x, p), i <> more, more)

# the ids of a command's subcommands
def acl.subs(+id: Nat) -> List<&2, Nat>:
  acl.subs.of(acl.names(), acl.name(id) ++ "|", 0n)

def acl.has.subs(+id: Nat) -> Bool:
  Bool.not(List.is_empty(&2, Nat, acl.subs(id)))

# a category's place in ACL CAT's list, case aside
def acl.cat(+name: String) -> Maybe<&2, Nat>:
  acl.find(acl.cats(), String.to_lower(name), 0n)

def acl.cat.name(+c: Nat) -> String:
  acl.nth(acl.cats(), c)

# whether a char is a blank (isspace) or NUL, as Redis's
# ACLStringHasSpaces refuses them in names and patterns
def acl.blank(+c: U32) -> Bool:
  Bool.or(Bool.or(U32.is_eq(c, 32), U32.is_eq(c, 0)), Bool.and(U32.is_ge(c, 9), U32.is_le(c, 13)))

def acl.spaced(s: String) -> Bool:
  match s:
    case SNil{}:
      False{}
    case SCon{Chr{+c}, t}:
      Bool.or(acl.blank(c), acl.spaced(t))

# the place of a string's last '|'
def acl.lastbar(s: String, +i: Nat, +at: Nat) -> Nat:
  match s:
    case SNil{}:
      at
    case SCon{Chr{+c}, t}:
      acl.lastbar(t, Nat.add(i, 1n), Bool.pick(Nat, U32.is_eq(c, 124), i, at))

# 64 lowercase hex digits, as Redis takes a password's hash (#, !)
def acl.hexy(s: String) -> Bool:
  match s:
    case SNil{}:
      True{}
    case SCon{Chr{+c}, t}:
      Bool.and(Bool.or(Bool.and(U32.is_ge(c, 48), U32.is_le(c, 57)), Bool.and(U32.is_ge(c, 97), U32.is_le(c, 102))), acl.hexy(t))

def acl.hash.ok(+s: String) -> Bool:
  Bool.and(Nat.is_eq(String.length(s), 64n), acl.hexy(s))

def acl.join(xs: List<&2, String>, +sep: String) -> String:
  match xs:
    case Nil{}:
      ""
    case Con{x, Nil{}}:
      x
    case Con{x, rest}:
      x ++ sep ++ acl.join(rest, sep)

def acl.drop(xs: List<&2, String>, +x: String) -> List<&2, String>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+y, rest}:
      +more = acl.drop(rest, x)
      Bool.pick(List<&2, String>, String.eq(x, y), more, y <> more)

# The bits of commands
# --------------------
# A word of 32 bits for 32 ids: twelve words cover the 366.

def bits.words(n: Nat, +w: U32) -> List<&2, U32>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      w <> bits.words(p, w)

def bits.none() -> List<&2, U32>:
  bits.words(12n, 0)

def bits.full() -> List<&2, U32>:
  bits.words(12n, 4294967295)

def bits.word(+bs: List<&2, U32>, i: Nat) -> U32:
  match bs i:
    case Nil{} _:
      0
    case Con{+w, rest} 0n:
      w
    case Con{w, rest} 1n+p:
      bits.word(rest, p)

def bits.get(+bs: List<&2, U32>, +id: Nat) -> Bool:
  U32.is_ne(U32.and(U32.shrn(bits.word(bs, Nat.div(id, 32n)), Nat.mod(id, 32n)), 1), 0)

def bits.put.w(on: Bool, +w: U32, +b: U32) -> U32:
  match on:
    case True{}:
      U32.or(w, b)
    case False{}:
      U32.and(w, U32.not(b))

def bits.put(bs: List<&2, U32>, i: Nat, +b: U32, +on: Bool) -> List<&2, U32>:
  match bs i:
    case Nil{} _:
      Nil{}
    case Con{w, rest} 0n:
      bits.put.w(on, w, b) <> rest
    case Con{w, rest} 1n+p:
      w <> bits.put(rest, p, b, on)

def bits.set(bs: List<&2, U32>, +id: Nat, +on: Bool) -> List<&2, U32>:
  bits.put(bs, Nat.div(id, 32n), U32.shln(1, Nat.mod(id, 32n)), on)

def bits.set.all(ids: List<&2, Nat>, +on: Bool, bs: List<&2, U32>) -> List<&2, U32>:
  match ids:
    case Nil{}:
      bs
    case Con{+id, rest}:
      bits.set.all(rest, on, bits.set(bs, id, on))

# Selectors
# ---------

# a selector with no permission, its channels as acl-pubsub-default says
# (allch: allchannels), as Redis's ACLCreateSelector makes one
def sel.new(+allch: Bool) -> Sel:
  Sel{False{}, False{}, bits.none(), Nil{}, Nil{}, False{}, Nil{}, allch, Nil{}}

def sel.allk(+s: Sel) -> Bool:
  match s:
    case Sel{all, allc, bits, firsts, rules, +allk, keys, allch, chans}:
      allk

def sel.allch(+s: Sel) -> Bool:
  match s:
    case Sel{all, allc, bits, firsts, rules, allk, keys, +allch, chans}:
      allch

def sel.chans(+s: Sel) -> List<&2, String>:
  match s:
    case Sel{all, allc, bits, firsts, rules, allk, keys, allch, +chans}:
      chans

def sel.keys.set(s: Sel, +allk: Bool) -> Sel:
  match s:
    case Sel{all, allc, bits, firsts, rules, k0, keys, allch, chans}:
      Sel{all, allc, bits, firsts, rules, allk, Nil{}, allch, chans}

def sel.chans.set(s: Sel, +allch: Bool) -> Sel:
  match s:
    case Sel{all, allc, bits, firsts, rules, allk, keys, c0, chans}:
      Sel{all, allc, bits, firsts, rules, allk, keys, allch, Nil{}}

# +@all (allcommands): every bit, the bit of commands to come, no first
# arguments and no rules; -@all (nocommands): none of them
def sel.cmds.set(s: Sel, +on: Bool) -> Sel:
  match s:
    case Sel{all, allc, bits, firsts, rules, allk, keys, allch, chans}:
      Sel{on, on, Bool.pick(List<&2, U32>, on, bits.full(), bits.none()), Nil{}, Nil{}, allk, keys, allch, chans}

def firsts.drop(fs: List<&2, Firsts>, +id: Nat) -> List<&2, Firsts>:
  match fs:
    case Nil{}:
      Nil{}
    case Con{Firsts{+i, args}, rest}:
      +more = firsts.drop(rest, id)
      Bool.pick(List<&2, Firsts>, Nat.is_eq(i, id), more, Firsts{i, args} <> more)

# x put among the first arguments of id, unless one is x, case aside
def firsts.add.at(fs: List<&2, Firsts>, +id: Nat, +x: String, found: Bool) -> List<&2, Firsts>:
  match fs:
    case Nil{}:
      Bool.pick(List<&2, Firsts>, found, Nil{}, [Firsts{id, [x]}])
    case Con{Firsts{+i, +args}, rest}:
      +hit = Nat.is_eq(i, id)
      +args2 = Bool.pick(List<&2, String>, Bool.and(hit, Bool.not(acl.has.nc(x, args))), List.append(&2, String, args, [x]), args)
      Firsts{i, args2} <> firsts.add.at(rest, id, x, Bool.or(found, hit))

def firsts.of(+fs: List<&2, Firsts>, +id: Nat) -> List<&2, String>:
  match fs:
    case Nil{}:
      Nil{}
    case Con{Firsts{+i, +args}, rest}:
      Bool.pick(List<&2, String>, Nat.is_eq(i, id), args, firsts.of(rest, id))

# a command allowed or denied, its subcommands with it, its first
# arguments dropped (Redis's ACLChangeSelectorPerm); a bit cleared takes
# away allc
def sel.perm(s: Sel, +id: Nat, +on: Bool) -> Sel:
  match s:
    case Sel{all, allc, bits, firsts, rules, allk, keys, allch, chans}:
      Sel{all, Bool.and(allc, on), bits.set.all(id <> acl.subs(id), on, bits), firsts.drop(firsts, id), rules, allk, keys, allch, chans}

def sel.perms(ids: List<&2, Nat>, +on: Bool, s: Sel) -> Sel:
  match ids:
    case Nil{}:
      s
    case Con{+id, rest}:
      sel.perms(rest, on, sel.perm(s, id, on))

def sel.first(s: Sel, +id: Nat, +x: String) -> Sel:
  match s:
    case Sel{all, allc, bits, firsts, rules, allk, keys, allch, chans}:
      Sel{all, allc, bits, firsts.add.at(firsts, id, x, False{}), rules, allk, keys, allch, chans}

# the rules without those for the name n or its subcommands, as Redis
# 7.2's ACLSelectorRemoveCommandRule leaves them
def rules.drop(rs: List<&2, String>, +n: String) -> List<&2, String>:
  match rs:
    case Nil{}:
      Nil{}
    case Con{+r, rest}:
      +body = String.drop(r, 1n)
      +more = rules.drop(rest, n)
      Bool.pick(List<&2, String>, Bool.or(String.eq(body, n), String.starts_with(body, n ++ "|")), more, r <> more)

# a rule put last, the rules before it for its name taken out
def sel.rule(s: Sel, +sign: String, +n: String) -> Sel:
  match s:
    case Sel{all, allc, bits, firsts, rules, allk, keys, allch, chans}:
      Sel{all, allc, bits, firsts, List.append(&2, String, rules.drop(rules, n), [sign ++ n]), allk, keys, allch, chans}

# a key pattern put among the patterns: one with the same glob gets its
# permissions or-ed in, in its place
def kpats.put(ks: List<&2, KPat>, +rw: Nat, +pat: String) -> List<&2, KPat>:
  match ks:
    case Nil{}:
      [KPat{rw, pat}]
    case Con{KPat{+r0, +p0}, +rest}:
      +same = String.eq(p0, pat)
      Bool.pick(List<&2, KPat>, same, KPat{Bool.pick(Nat, Nat.is_eq(r0, rw), r0, 3n), p0} <> rest, KPat{r0, p0} <> kpats.put(rest, rw, pat))

def sel.kpat(s: Sel, +rw: Nat, +pat: String) -> Sel:
  match s:
    case Sel{all, allc, bits, firsts, rules, allk, keys, allch, chans}:
      Sel{all, allc, bits, firsts, rules, False{}, kpats.put(keys, rw, pat), allch, chans}

def sel.chan(s: Sel, +pat: String) -> Sel:
  match s:
    case Sel{all, allc, bits, firsts, rules, allk, keys, allch, +chans}:
      Sel{all, allc, bits, firsts, rules, allk, keys, False{}, Bool.pick(List<&2, String>, acl.has(pat, chans), chans, List.append(&2, String, chans, [pat]))}

# A rule of a selector
# --------------------
# Redis's ACLSetSelector. Errors as Redis's errno: 1 ENOENT (an unknown
# command or category), 2 EINVAL (a syntax error), 3 EEXIST (a key pattern
# after allkeys), 4 EISDIR (a channel after allchannels), 5 ENODEV (a
# password to remove not there), 6 EBADMSG (a hash malformed), 7 ECHILD
# (a first argument of a subcommand).

type SelR is Data:
  SelOk{s: Sel}
  SelErr{e: Nat}

# a %...~ key rule read: its permissions R and W (each once, case
# aside) up to '~', then where its pattern starts; a rule with no '~'
# has the empty pattern (as Redis reads one)
type Pct is Data:
  PGo{i: Nat, rw: Nat}
  PEnd{rw: Nat, at: Nat}
  PBad{}

def pct.step(+c: U32, +i: Nat, +rw: Nat) -> Pct:
  +up = Bool.pick(U32, Bool.and(U32.is_ge(c, 97), U32.is_le(c, 122)), U32.sub(c, 32), c)
  Bool.pick(Pct, U32.is_eq(c, 126), PEnd{rw, Nat.add(i, 1n)},
    Bool.pick(Pct, Bool.and(U32.is_eq(up, 82), Nat.is_eq(Nat.mod(rw, 2n), 0n)), PGo{Nat.add(i, 1n), Nat.add(rw, 1n)},
      Bool.pick(Pct, Bool.and(U32.is_eq(up, 87), Nat.is_lt(rw, 2n)), PGo{Nat.add(i, 1n), Nat.add(rw, 2n)}, PBad{})))

def pct.run(fuel: Nat, +op: String, st: Pct) -> Pct:
  match fuel st:
    case 1n+f PGo{+i, +rw}:
      pct.run(f, op, pct.step(String.code_at(op, i), i, rw))
    case 0n PGo{+i, +rw}:
      PEnd{rw, i}
    case _ other:
      other

def pct.of(tilde: Bool, +op: String) -> Pct:
  match tilde:
    case True{}:
      PEnd{3n, 1n}
    case False{}:
      pct.run(Nat.sub(String.length(op), 1n), op, PGo{1n, 0n})

def sel.key.add(bad: Bool, +rw: Nat, +pat: String, s: Sel) -> SelR:
  match bad:
    case True{}:
      SelErr{2n}
    case False{}:
      SelOk{sel.kpat(s, rw, pat)}

# a pattern with no permission (%~) is refused, where Redis 7.0.15 takes
# it and then fails to describe it
def sel.key.at(p: Pct, +op: String, s: Sel) -> SelR:
  match p:
    case PEnd{+rw, +at}:
      +pat = String.drop(op, at)
      sel.key.add(Bool.or(Nat.is_eq(rw, 0n), acl.spaced(pat)), rw, pat, s)
    case _:
      SelErr{2n}

def sel.key.if(allk: Bool, +op: String, s: Sel) -> SelR:
  match allk:
    case True{}:
      SelErr{3n}
    case False{}:
      sel.key.at(pct.of(U32.is_eq(String.code_at(op, 0n), 126), op), op, s)

def sel.ch.add(bad: Bool, +pat: String, s: Sel) -> SelR:
  match bad:
    case True{}:
      SelErr{2n}
    case False{}:
      SelOk{sel.chan(s, pat)}

def sel.ch.if(allch: Bool, +op: String, s: Sel) -> SelR:
  match allch:
    case True{}:
      SelErr{4n}
    case False{}:
      +pat = String.drop(op, 1n)
      sel.ch.add(acl.spaced(pat), pat, s)

def sel.plus.id(m: Maybe<&2, Nat>, s: Sel) -> SelR:
  match m:
    case Some{+id}:
      SelOk{sel.rule(sel.perm(s, id, True{}), "+", acl.name(id))}
    case None{}:
      SelErr{1n}

# +cmd|x, cmd's id found: a subcommand's (ECHILD), x empty (EINVAL), a
# subcommand of cmd's, or else x a first argument cmd is allowed with
def sel.plus.k(k: Nat, +id: Nat, +x: String, +body: String, s: Sel) -> SelR:
  match k:
    case 0n:
      SelErr{7n}
    case 1n:
      SelErr{2n}
    case 2n:
      sel.plus.id(acl.id(body), s)
    case _:
      SelOk{sel.rule(sel.first(s, id, x), "+", String.to_lower(body))}

def sel.plus.cmd(m: Maybe<&2, Nat>, +x: String, +body: String, s: Sel) -> SelR:
  match m:
    case Some{+id}:
      +k = Bool.pick(Nat, String.contains(acl.name(id), "|"), 0n, Bool.pick(Nat, String.is_empty(x), 1n, Bool.pick(Nat, acl.has.subs(id), 2n, 3n)))
      sel.plus.k(k, id, x, body, s)
    case None{}:
      SelErr{1n}

def sel.plus.bar(bar: Bool, +body: String, s: Sel) -> SelR:
  match bar:
    case False{}:
      sel.plus.id(acl.id(body), s)
    case True{}:
      +i = acl.lastbar(body, 0n, 0n)
      sel.plus.cmd(acl.id(String.take(body, i)), String.drop(body, Nat.add(i, 1n)), body, s)

def sel.minus.id(m: Maybe<&2, Nat>, s: Sel) -> SelR:
  match m:
    case Some{+id}:
      SelOk{sel.rule(sel.perm(s, id, False{}), "-", acl.name(id))}
    case None{}:
      SelErr{1n}

def sel.cat.of(m: Maybe<&2, Nat>, +on: Bool, s: Sel) -> SelR:
  match m:
    case Some{+c}:
      SelOk{sel.rule(sel.perms(acl.cat.ids(c), on, s), Bool.pick(String, on, "+", "-"), "@" ++ acl.cat.name(c))}
    case None{}:
      SelErr{1n}

# what a rule is: 1 allkeys, 2 resetkeys, 3 allchannels, 4
# resetchannels, 5 allcommands, 6 nocommands, 7 a key pattern, 8 a
# channel, 9 +cmd, 10 -cmd, 11 +@cat or -@cat, 0 none
def sel.kind(+lo: String, +c0: U32, +c1: U32) -> Nat:
  Bool.pick(Nat, Bool.or(String.eq(lo, "allkeys"), String.eq(lo, "~*")), 1n,
  Bool.pick(Nat, String.eq(lo, "resetkeys"), 2n,
  Bool.pick(Nat, Bool.or(String.eq(lo, "allchannels"), String.eq(lo, "&*")), 3n,
  Bool.pick(Nat, String.eq(lo, "resetchannels"), 4n,
  Bool.pick(Nat, Bool.or(String.eq(lo, "allcommands"), String.eq(lo, "+@all")), 5n,
  Bool.pick(Nat, Bool.or(String.eq(lo, "nocommands"), String.eq(lo, "-@all")), 6n,
  Bool.pick(Nat, Bool.or(U32.is_eq(c0, 126), U32.is_eq(c0, 37)), 7n,
  Bool.pick(Nat, U32.is_eq(c0, 38), 8n,
  Bool.pick(Nat, Bool.and(U32.is_eq(c0, 43), U32.is_ne(c1, 64)), 9n,
  Bool.pick(Nat, Bool.and(U32.is_eq(c0, 45), U32.is_ne(c1, 64)), 10n,
  Bool.pick(Nat, Bool.and(Bool.or(U32.is_eq(c0, 43), U32.is_eq(c0, 45)), U32.is_eq(c1, 64)), 11n, 0n)))))))))))

def sel.rule.of(k: Nat, +op: String, s: Sel) -> SelR:
  match k:
    case 1n:
      SelOk{sel.keys.set(s, True{})}
    case 2n:
      SelOk{sel.keys.set(s, False{})}
    case 3n:
      SelOk{sel.chans.set(s, True{})}
    case 4n:
      SelOk{sel.chans.set(s, False{})}
    case 5n:
      SelOk{sel.cmds.set(s, True{})}
    case 6n:
      SelOk{sel.cmds.set(s, False{})}
    case 7n:
      +s0 = s
      sel.key.if(sel.allk(s0), op, s0)
    case 8n:
      +s0 = s
      sel.ch.if(sel.allch(s0), op, s0)
    case 9n:
      +body = String.drop(op, 1n)
      sel.plus.bar(String.contains(body, "|"), body, s)
    case 10n:
      sel.minus.id(acl.id(String.drop(op, 1n)), s)
    case 11n:
      sel.cat.of(acl.cat(String.drop(op, 2n)), U32.is_eq(String.code_at(op, 0n), 43), s)
    case _:
      SelErr{2n}

# a rule applied to a selector (Redis's ACLSetSelector)
def sel.apply(+op: String, s: Sel) -> SelR:
  sel.rule.of(sel.kind(String.to_lower(op), String.code_at(op, 0n), String.code_at(op, 1n)), op, s)

def sel.apply.all(ops: List<&2, String>, r: SelR) -> SelR:
  match ops r:
    case Con{+op, rest} SelOk{s}:
      sel.apply.all(rest, sel.apply(op, s))
    case _ other:
      other

def acl.words(m: Maybe<&2, List<&2, String>>) -> List<&2, String>:
  match m:
    case Some{ws}:
      ws
    case None{}:
      Nil{}

# a selector of a rule in parentheses: its words (sdssplitargs's) applied
# to a new selector, as Redis's aclCreateSelectorFromOpSet
def sel.of.set(+op: String, +allch: Bool) -> SelR:
  sel.apply.all(acl.words(P.split.args(String.slice(op, 1n, Nat.sub(String.length(op), 2n)))), SelOk{sel.new(allch)})

# Users
# -----

type UserR is Data:
  UserOk{u: User}
  UserErr{e: Nat}

# a user new to ACL SETUSER: off, no payload flag, no password, a root
# selector with no permission (Redis's ACLCreateUser)
def user.new(+name: String, +allch: Bool) -> User:
  User{name, False{}, False{}, 0n, Nil{}, [sel.new(allch)]}

def user.name(+u: User) -> String:
  match u:
    case User{+name, on, nopass, pay, pass, sels}:
      name

def user.on(+u: User) -> Bool:
  match u:
    case User{name, +on, nopass, pay, pass, sels}:
      on

def user.nopass(+u: User) -> Bool:
  match u:
    case User{name, on, +nopass, pay, pass, sels}:
      nopass

def user.pass(+u: User) -> List<&2, String>:
  match u:
    case User{name, on, nopass, pay, +pass, sels}:
      pass

def user.sels(+u: User) -> List<&2, Sel>:
  match u:
    case User{name, on, nopass, pay, pass, +sels}:
      sels

def user.root(+u: User) -> Sel:
  match u:
    case User{name, on, nopass, pay, pass, Con{+s, rest}}:
      s
    case _:
      sel.new(False{})

def user.set.on(u: User, +x: Bool) -> User:
  match u:
    case User{name, on, nopass, pay, pass, sels}:
      User{name, x, nopass, pay, pass, sels}

def user.set.pay(u: User, +x: Nat) -> User:
  match u:
    case User{name, on, nopass, pay, pass, sels}:
      User{name, on, nopass, x, pass, sels}

def user.set.pass(u: User, +np: Bool, ps: List<&2, String>) -> User:
  match u:
    case User{name, on, nopass, pay, pass, sels}:
      User{name, on, np, pay, ps, sels}

def user.set.sels(u: User, ss: List<&2, Sel>) -> User:
  match u:
    case User{name, on, nopass, pay, pass, sels}:
      User{name, on, nopass, pay, pass, ss}

def user.set.root(u: User, s: Sel) -> User:
  match u:
    case User{name, on, nopass, pay, pass, Con{r, rest}}:
      User{name, on, nopass, pay, pass, s <> rest}
    case User{name, on, nopass, pay, pass, Nil{}}:
      User{name, on, nopass, pay, pass, [s]}

def user.clearsels(u: User) -> User:
  match u:
    case User{name, on, nopass, pay, pass, Con{r, rest}}:
      User{name, on, nopass, pay, pass, [r]}
    case other:
      other

# a password's hash: the hash given (#, !) or the password's SHA-256
def pw.of(hashed: Bool, +x: String) -> String:
  match hashed:
    case True{}:
      x
    case False{}:
      sha256(x)

def user.add.pass(bad: Bool, +h: String, u: User) -> UserR:
  match bad:
    case True{}:
      UserErr{6n}
    case False{}:
      +u0 = u
      +ps = user.pass(u0)
      UserOk{user.set.pass(u0, False{}, Bool.pick(List<&2, String>, acl.has(h, ps), ps, List.append(&2, String, ps, [h])))}

def user.del.pass.if(found: Bool, +h: String, u: User) -> UserR:
  match found:
    case False{}:
      UserErr{5n}
    case True{}:
      +u0 = u
      UserOk{user.set.pass(u0, user.nopass(u0), acl.drop(user.pass(u0), h))}

def user.del.pass(bad: Bool, +h: String, u: User) -> UserR:
  match bad:
    case True{}:
      UserErr{6n}
    case False{}:
      +u0 = u
      user.del.pass.if(acl.has(h, user.pass(u0)), h, u0)

def user.sel.add(r: SelR, u: User) -> UserR:
  match r:
    case SelOk{s}:
      +u0 = u
      UserOk{user.set.sels(u0, List.append(&2, Sel, user.sels(u0), [s]))}
    case SelErr{e}:
      UserErr{e}

def user.root.of(r: SelR, u: User) -> UserR:
  match r:
    case SelOk{s}:
      UserOk{user.set.root(u, s)}
    case SelErr{e}:
      UserErr{e}

def user.ok.root(r: SelR) -> Sel:
  match r:
    case SelOk{s}:
      s
    case SelErr{e}:
      sel.new(False{})

# reset: resetpass, resetkeys, resetchannels (allchannels as
# acl-pubsub-default says), off, sanitize-payload, clearselectors, -@all
def user.reset(u: User, +allch: Bool) -> User:
  +u1 = user.clearsels(user.set.pay(user.set.on(user.set.pass(u, False{}, Nil{}), False{}), 1n))
  user.set.root(u1, sel.cmds.set(sel.chans.set(sel.keys.set(user.root(u1), False{}), allch), False{}))

# what a user's rule is: 1 on, 2 off, 3 skip-sanitize-payload, 4
# sanitize-payload, 5 nopass, 6 resetpass, 7 > or #, 8 < or !, 9 a
# selector in parentheses, 10 clearselectors, 11 reset, 12 empty, 0 a
# rule of the root selector
def user.kind(+lo: String, +op: String, +n: Nat) -> Nat:
  +c0 = String.code_at(op, 0n)
  Bool.pick(Nat, Nat.is_eq(n, 0n), 12n,
  Bool.pick(Nat, String.eq(lo, "on"), 1n,
  Bool.pick(Nat, String.eq(lo, "off"), 2n,
  Bool.pick(Nat, String.eq(lo, "skip-sanitize-payload"), 3n,
  Bool.pick(Nat, String.eq(lo, "sanitize-payload"), 4n,
  Bool.pick(Nat, String.eq(lo, "nopass"), 5n,
  Bool.pick(Nat, String.eq(lo, "resetpass"), 6n,
  Bool.pick(Nat, Bool.or(U32.is_eq(c0, 62), U32.is_eq(c0, 35)), 7n,
  Bool.pick(Nat, Bool.or(U32.is_eq(c0, 60), U32.is_eq(c0, 33)), 8n,
  Bool.pick(Nat, Bool.and(U32.is_eq(c0, 40), U32.is_eq(String.code_at(op, Nat.sub(n, 1n)), 41)), 9n,
  Bool.pick(Nat, String.eq(lo, "clearselectors"), 10n,
  Bool.pick(Nat, String.eq(lo, "reset"), 11n, 0n))))))))))))

def user.rule.of(k: Nat, +op: String, +allch: Bool, u: User) -> UserR:
  match k:
    case 1n:
      UserOk{user.set.on(u, True{})}
    case 2n:
      UserOk{user.set.on(u, False{})}
    case 3n:
      UserOk{user.set.pay(u, 2n)}
    case 4n:
      UserOk{user.set.pay(u, 1n)}
    case 5n:
      UserOk{user.set.pass(u, True{}, Nil{})}
    case 6n:
      UserOk{user.set.pass(u, False{}, Nil{})}
    case 7n:
      +hashed = U32.is_eq(String.code_at(op, 0n), 35)
      +x = String.drop(op, 1n)
      user.add.pass(Bool.and(hashed, Bool.not(acl.hash.ok(x))), pw.of(hashed, x), u)
    case 8n:
      +hashed = U32.is_eq(String.code_at(op, 0n), 33)
      +x = String.drop(op, 1n)
      user.del.pass(Bool.and(hashed, Bool.not(acl.hash.ok(x))), pw.of(hashed, x), u)
    case 9n:
      user.sel.add(sel.of.set(op, allch), u)
    case 10n:
      UserOk{user.clearsels(u)}
    case 11n:
      UserOk{user.reset(u, allch)}
    case 12n:
      UserOk{u}
    case _:
      +u0 = u
      user.root.of(sel.apply(op, user.root(u0)), u0)

# a rule applied to a user (Redis's ACLSetUser)
def user.apply(+op: String, +allch: Bool, u: User) -> UserR:
  user.rule.of(user.kind(String.to_lower(op), op, String.length(op)), op, allch, u)

# ACL SETUSER
# -----------

# Redis's ACLSetUserStringError
def acl.errno.text(+e: Nat) -> String:
  match e:
    case 1n:
      "Unknown command or category name in ACL"
    case 2n:
      "Syntax error"
    case 3n:
      "Adding a pattern after the * pattern (or the 'allkeys' flag) is not valid and does not have any effect. Try 'resetkeys' to start with an empty list of patterns"
    case 4n:
      "Adding a pattern after the * pattern (or the 'allchannels' flag) is not valid and does not have any effect. Try 'resetchannels' to start with an empty list of channels"
    case 5n:
      "The password you are trying to remove from the user does not exist"
    case 6n:
      "The password hash must be exactly 64 characters and contain only lowercase hexadecimal characters"
    case 7n:
      "Allowing first-arg of a subcommand is not supported"
    case _:
      "Wrong format"

# CR and LF as spaces, as Redis's addReplyErrorFormat writes them
def acl.oneline(s: String) -> String:
  match s:
    case SNil{}:
      SNil{}
    case SCon{Chr{+c}, t}:
      SCon{Chr{Bool.pick(U32, Bool.or(U32.is_eq(c, 13), U32.is_eq(c, 10)), 32, c)}, acl.oneline(t)}

# ACL SETUSER's arguments with the words of each selector put together
# (Redis's ACLMergeSelectorArguments): an argument that opens a
# parenthesis without closing it starts a selector, and the arguments up
# to one that ends with ')' join it, one space between them; an
# argument that opens again starts again. Merged: the rules, or the
# argument that opened a selector left open
type Merge is Data:
  MOut{rules: List<&2, String>, open: Maybe<&2, String>, start: String}

def merge.opens(+a: String) -> Bool:
  +n = String.length(a)
  Bool.and(U32.is_eq(String.code_at(a, 0n), 40), Bool.not(U32.is_eq(String.code_at(a, Nat.sub(n, 1n)), 41)))

def merge.closes(+a: String) -> Bool:
  U32.is_eq(String.code_at(a, Nat.sub(String.length(a), 1n)), 41)

def merge.in(m: Maybe<&2, String>, +a: String, +rs: List<&2, String>, +start: String) -> Merge:
  match m:
    case Some{x}:
      +y = x ++ " " ++ a
      Bool.pick(Merge, merge.closes(a), MOut{y <> rs, None{}, ""}, MOut{rs, Some{y}, start})
    case None{}:
      MOut{a <> rs, None{}, start}

def merge.step(+a: String, st: Merge) -> Merge:
  match st:
    case MOut{+rs, m, +start}:
      Bool.pick(Merge, merge.opens(a), MOut{rs, Some{a}, a}, merge.in(m, a, rs, start))

def merge.go(args: List<&2, String>, st: Merge) -> Merge:
  match args:
    case Nil{}:
      st
    case Con{+a, rest}:
      merge.go(rest, merge.step(a, st))

# the outcome of ACL SETUSER: the users after it, and whether the user
# was there before (its subscribers checked against its new channels:
# acl.keeps), or the error to answer
type SetR is Data:
  SetOk{a: Acl, old: Maybe<&2, User>}
  SetErr{msg: String}

# the rules applied in turn; the first that fails names itself
type Applied is Data:
  AOk{u: User}
  AErr{op: String, e: Nat}

def acl.applied(+op: String, r: UserR) -> Applied:
  match r:
    case UserOk{u}:
      AOk{u}
    case UserErr{e}:
      AErr{op, e}

def acl.apply.all(rs: List<&2, String>, +allch: Bool, r: Applied) -> Applied:
  match rs r:
    case Con{+op, rest} AOk{u}:
      acl.apply.all(rest, allch, acl.applied(op, user.apply(op, allch, u)))
    case _ other:
      other

def acl.name.ok(s: String) -> Bool:
  Bool.not(acl.spaced(s))

# the user of a name, or none
def users.find(us: List<&2, User>, +n: String) -> Maybe<&2, User>:
  match us:
    case Nil{}:
      None{}
    case Con{+u, rest}:
      Bool.pick(Maybe<&2, User>, String.eq(user.name(u), n), Some{u}, users.find(rest, n))

def acl.dflt(+a: Acl) -> User:
  match a:
    case Acl{+dflt, users, log, gone, rp, key, ctr, rcl}:
      dflt

def acl.users(+a: Acl) -> List<&2, User>:
  match a:
    case Acl{dflt, +users, log, gone, rp, key, ctr, rcl}:
      users

def acl.log(+a: Acl) -> List<&2, Ent>:
  match a:
    case Acl{dflt, users, +log, gone, rp, key, ctr, rcl}:
      log

def acl.gone(+a: Acl) -> List<&2, String>:
  match a:
    case Acl{dflt, users, log, +gone, rp, key, ctr, rcl}:
      gone

# a user of the ACL by name
def acl.user(+a: Acl, +n: String) -> Maybe<&2, User>:
  Bool.pick(Maybe<&2, User>, String.eq(n, "default"), Some{acl.dflt(a)}, users.find(acl.users(a), n))

# a user put among the others, in the order of their names (byte order)
def users.put(us: List<&2, User>, u: User) -> List<&2, User>:
  match us:
    case Nil{}:
      [u]
    case Con{+x, +rest}:
      +u0 = u
      +n = user.name(u0)
      +m = user.name(x)
      Bool.pick(List<&2, User>, String.eq(m, n), u0 <> rest, Bool.pick(List<&2, User>, String.is_lt(n, m), u0 <> x <> rest, x <> users.put(rest, u0)))

def users.del(us: List<&2, User>, +n: String) -> List<&2, User>:
  match us:
    case Nil{}:
      Nil{}
    case Con{+x, rest}:
      +more = users.del(rest, n)
      Bool.pick(List<&2, User>, String.eq(user.name(x), n), more, x <> more)

def acl.put(a: Acl, u: User) -> Acl:
  match a:
    case Acl{+dflt, +users, +log, +gone, +rp, +key, +ctr, +rcl}:
      +u0 = u
      Bool.pick(Acl, String.eq(user.name(u0), "default"), Acl{u0, users, log, gone, rp, key, ctr, rcl}, Acl{dflt, users.put(users, u0), log, gone, rp, key, ctr, rcl})

def acl.set.done(r: Applied, a: Acl, old: Maybe<&2, User>) -> SetR:
  match r:
    case AOk{u}:
      SetOk{acl.put(a, u), old}
    case AErr{op, +e}:
      SetErr{"ERR Error in ACL SETUSER modifier '" ++ acl.oneline(op) ++ "': " ++ acl.errno.text(e)}

def acl.set.base(m: Maybe<&2, User>, +n: String, +allch: Bool) -> User:
  match m:
    case Some{u}:
      u
    case None{}:
      user.new(n, allch)

def acl.set.merged(mg: Merge, a: Acl, +n: String, +allch: Bool) -> SetR:
  match mg:
    case MOut{rs, Some{x}, +start}:
      SetErr{"ERR Unmatched parenthesis in acl selector starting at '" ++ acl.oneline(start) ++ "'."}
    case MOut{rs, None{}, start}:
      +a0 = a
      +old = acl.user(a0, n)
      acl.set.done(acl.apply.all(List.reverse(&2, String, rs), allch, AOk{acl.set.base(old, n, allch)}), a0, old)

def acl.set.named(ok: Bool, a: Acl, +n: String, args: List<&2, String>, +allch: Bool) -> SetR:
  match ok:
    case False{}:
      SetErr{"ERR Usernames can't contain spaces or null characters"}
    case True{}:
      acl.set.merged(merge.go(args, MOut{Nil{}, None{}, ""}), a, n, allch)

# ACL SETUSER name rules: all of them applied, or none (Redis's
# ACLStringSetUser on a copy of the user); allch: acl-pubsub-default is
# allchannels
def acl.setuser(a: Acl, +n: String, args: List<&2, String>, +allch: Bool) -> SetR:
  acl.set.named(acl.name.ok(n), a, n, args, allch)

# The ACL from its start: the default user on, with no password, every
# key, channel and command (Redis's ACLInitDefaultUser), then
# requirepass as its password
def acl.dflt.of(+pass: String) -> User:
  +root = sel.cmds.set(sel.chans.set(sel.keys.set(sel.new(False{}), True{}), True{}), True{})
  User{"default", True{}, Nat.is_eq(String.length(pass), 0n), 0n, Bool.pick(List<&2, String>, Nat.is_eq(String.length(pass), 0n), Nil{}, [sha256(pass)]), [root]}

# key: GENPASS's secret, random hex digits the server read at its start
def acl.new(+pass: String, key: String) -> Acl:
  Acl{acl.dflt.of(pass), Nil{}, Nil{}, Nil{}, pass, key, 0n, Nil{}}

# requirepass set: the default user's passwords reset, then the new one
# or nopass (Redis's ACLUpdateDefaultUserPassword)
def acl.requirepass(a: Acl, +pass: String) -> Acl:
  match a:
    case Acl{dflt, users, log, gone, rp, key, ctr, rcl}:
      +none = Nat.is_eq(String.length(pass), 0n)
      Acl{user.set.pass(dflt, none, Bool.pick(List<&2, String>, none, Nil{}, [sha256(pass)])), users, log, gone, pass, key, ctr, rcl}

def acl.cfg.if(same: Bool, a: Acl, +pass: String) -> Acl:
  match same:
    case True{}:
      a
    case False{}:
      acl.requirepass(a, pass)

# after CONFIG SET: requirepass given to the default user when it changed
# (Redis applies a parameter only when its value changed)
def acl.cfg(a: Acl, +pass: String) -> Acl:
  match a:
    case Acl{dflt, users, log, gone, +rp, key, ctr, rcl}:
      acl.cfg.if(String.eq(rp, pass), Acl{dflt, users, log, gone, rp, key, ctr, rcl}, pass)

# whether a user takes a password: on, and nopass or the password's
# SHA-256 among its own (Redis's ACLCheckUserCredentials)
def user.login(+u: User, +pass: String) -> Bool:
  Bool.and(user.on(u), Bool.or(user.nopass(u), acl.has(sha256(pass), user.pass(u))))

def acl.login.of(m: Maybe<&2, User>, +pass: String) -> Bool:
  match m:
    case Some{+u}:
      user.login(u, pass)
    case None{}:
      False{}

def acl.login(+a: Acl, +name: String, +pass: String) -> Bool:
  acl.login.of(acl.user(a, name), pass)

# whether a client must authenticate: the default user is off, or has no
# nopass (Redis's authRequired, before the client's own state)
def acl.needs.auth(+a: Acl) -> Bool:
  +d = acl.dflt(a)
  Bool.or(Bool.not(user.nopass(d)), Bool.not(user.on(d)))

# whether a client is authenticated without AUTH: the default user is on
# and takes any password
def user.open(+u: User) -> Bool:
  match u:
    case User{name, +on, +nopass, pay, pass, sels}:
      Bool.and(nopass, on)

# (read in place: a getter's result would be shared with the server, and
# its next change would copy its state; session.bend: mm.open)
def acl.open(+a: Acl) -> Bool:
  match a:
    case Acl{+dflt, users, log, gone, rp, key, ctr, rcl}:
      user.open(dflt)

# whether the default user takes any password, on or off (AUTH with a
# password alone then refuses)
def acl.dflt.nopass(+a: Acl) -> Bool:
  user.nopass(acl.dflt(a))

def sel.free(+s: Sel) -> Bool:
  match s:
    case Sel{all, +allc, bits, firsts, rules, +allk, keys, +allch, chans}:
      Bool.and(allc, Bool.and(allk, allch))

# whether a user may run anything: its root selector allows every command,
# key and channel
def user.free(+u: User) -> Bool:
  sel.free(user.root(u))

# Restricted clients
# ------------------
# The ids of the connected clients whose user is not free (a user gone is
# not), which the server keeps here so that their batches run a command
# at a time, each one checked (server.bend, ACL): it puts a client among
# them, or out, when it logs in, when its user changes, and when it goes.

def acl.rcl(+a: Acl) -> List<&2, Nat>:
  match a:
    case Acl{dflt, users, log, gone, rp, key, ctr, +rcl}:
      rcl

def rcl.has(+id: Nat, +xs: List<&2, Nat>) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{+x, +rest}:
      Bool.or(Nat.is_eq(x, id), rcl.has(id, rest))

def acl.restricted(+a: Acl, +id: Nat) -> Bool:
  match a:
    case Acl{dflt, users, log, gone, rp, key, ctr, +rcl}:
      rcl.has(id, rcl)

def rcl.any(+xs: List<&2, Nat>) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{x, rest}:
      True{}

# whether some client is restricted (server.bend: Ps's bit 20)
def acl.any(+a: Acl) -> Bool:
  match a:
    case Acl{dflt, users, log, gone, rp, key, ctr, +rcl}:
      rcl.any(rcl)

def rcl.keep(same: Bool, +x: Nat, rest: List<&2, Nat>) -> List<&2, Nat>:
  match same:
    case True{}:
      rest
    case False{}:
      x <> rest

def rcl.drop(+id: Nat, xs: List<&2, Nat>) -> List<&2, Nat>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+x, rest}:
      rcl.keep(Nat.is_eq(x, id), x, rcl.drop(id, rest))

def rcl.put(free: Bool, +id: Nat, xs: List<&2, Nat>) -> List<&2, Nat>:
  match free:
    case True{}:
      rcl.drop(id, xs)
    case False{}:
      id <> rcl.drop(id, xs)

def acl.free.of(m: Maybe<&2, User>) -> Bool:
  match m:
    case Some{+u}:
      user.free(u)
    case None{}:
      False{}

# whether the user of name n is free
def acl.free(+a: Acl, +n: String) -> Bool:
  acl.free.of(acl.user(a, n))

def acl.client.of(free: Bool, +id: Nat, a: Acl) -> Acl:
  match a:
    case Acl{dflt, users, log, gone, rp, key, ctr, rcl}:
      Acl{dflt, users, log, gone, rp, key, ctr, rcl.put(free, id, rcl)}

# the client of id, as the user of name n now
def acl.client(a: Acl, +id: Nat, +n: String) -> Acl:
  +a0 = a
  acl.client.of(acl.free(a0, n), id, a0)

# the client of id gone (its connection's end, CLIENT KILL)
def acl.client.gone(a: Acl, +id: Nat) -> Acl:
  acl.client.of(True{}, id, a)

# the users DELUSER removed, forgotten once their clients are closed
def acl.gone.clear(a: Acl) -> Acl:
  match a:
    case Acl{dflt, users, log, gone, rp, key, ctr, rcl}:
      Acl{dflt, users, log, Nil{}, rp, key, ctr, rcl}

# ACL DELUSER
# -----------

# the users of names deleted: the count of those there, and the users
# after (their clients to close: gone); 'default' is refused before
type DelR is Data:
  DelOk{n: Nat, a: Acl}
  DelErr{msg: String}

def acl.some(m: Maybe<&2, User>) -> Bool:
  match m:
    case Some{u}:
      True{}
    case None{}:
      False{}

def acl.del.one(a: Acl, +n: String) -> Acl:
  match a:
    case Acl{+dflt, +users, +log, +gone, +rp, +key, +ctr, +rcl}:
      Bool.pick(Acl, acl.some(users.find(users, n)), Acl{dflt, users.del(users, n), log, n <> gone, rp, key, ctr, rcl}, Acl{dflt, users, log, gone, rp, key, ctr, rcl})

def acl.del.go(ns: List<&2, String>, +k: Nat, a: Acl) -> DelR:
  match ns:
    case Nil{}:
      DelOk{k, a}
    case Con{+n, rest}:
      +a0 = a
      acl.del.go(rest, Bool.pick(Nat, acl.some(users.find(acl.users(a0), n)), Nat.add(k, 1n), k), acl.del.one(a0, n))

def acl.deluser.if(dflt: Bool, a: Acl, ns: List<&2, String>) -> DelR:
  match dflt:
    case True{}:
      DelErr{"ERR The 'default' user cannot be removed"}
    case False{}:
      acl.del.go(ns, 0n, a)

# ACL DELUSER: 'default' among the names (exactly) is refused, whatever
# else there is
def acl.deluser(a: Acl, ns: List<&2, String>) -> DelR:
  +ns0 = ns
  acl.deluser.if(acl.has("default", ns0), a, ns0)

# How a user is described
# -----------------------
# As ACL GETUSER and ACL LIST describe one (Redis's ACLDescribeSelector
# and ACLDescribeUser); the command rules as Redis 7.2 keeps them: +@all
# or -@all, then the rules as given.

def kpat.show(+p: KPat) -> String:
  match p:
    case KPat{+rw, +pat}:
      Bool.pick(String, Nat.is_eq(rw, 3n), "~", Bool.pick(String, Nat.is_eq(rw, 1n), "%R~", "%W~")) ++ pat

def kpats.show(ks: List<&2, KPat>) -> List<&2, String>:
  match ks:
    case Nil{}:
      Nil{}
    case Con{+k, rest}:
      kpat.show(k) <> kpats.show(rest)

def chans.show(cs: List<&2, String>) -> List<&2, String>:
  match cs:
    case Nil{}:
      Nil{}
    case Con{c, rest}:
      ("&" ++ c) <> chans.show(rest)

# the selector's keys: ~* for every key, else its patterns
def sel.keys.desc(+s: Sel) -> List<&2, String>:
  match s:
    case Sel{all, allc, bits, firsts, rules, +allk, +keys, allch, chans}:
      Bool.pick(List<&2, String>, allk, ["~*"], kpats.show(keys))

# the selector's channels: &* for every channel, else its patterns
def sel.chans.desc(+s: Sel) -> List<&2, String>:
  match s:
    case Sel{all, allc, bits, firsts, rules, allk, keys, +allch, +chans}:
      Bool.pick(List<&2, String>, allch, ["&*"], chans.show(chans))

# the selector's command rules: +@all or -@all, then the rules as given
def sel.cmds.desc(+s: Sel) -> String:
  match s:
    case Sel{+all, allc, bits, firsts, +rules, allk, keys, allch, chans}:
      acl.join(Bool.pick(String, all, "+@all", "-@all") <> rules, " ")

# the selector as ACL LIST writes it: its keys, its channels
# (resetchannels before them unless it allows every one), its rules
def sel.desc(+s: Sel) -> String:
  +ch = Bool.pick(List<&2, String>, sel.allch(s), ["&*"], "resetchannels" <> sel.chans.desc(s))
  acl.join(List.append(&2, String, List.append(&2, String, sel.keys.desc(s), ch), [sel.cmds.desc(s)]), " ")

def sels.desc(ss: List<&2, Sel>) -> List<&2, String>:
  match ss:
    case Nil{}:
      Nil{}
    case Con{+s, rest}:
      ("(" ++ sel.desc(s) ++ ")") <> sels.desc(rest)

def user.flags(+u: User) -> List<&2, String>:
  match u:
    case User{name, +on, +nopass, +pay, pass, sels}:
      List.append(&2, String, [Bool.pick(String, on, "on", "off")],
        List.append(&2, String, Bool.pick(List<&2, String>, nopass, ["nopass"], Nil{}),
          Bool.pick(List<&2, String>, Nat.is_eq(pay, 2n), ["skip-sanitize-payload"], Bool.pick(List<&2, String>, Nat.is_eq(pay, 1n), ["sanitize-payload"], Nil{}))))

def hashes.show(ps: List<&2, String>) -> List<&2, String>:
  match ps:
    case Nil{}:
      Nil{}
    case Con{p, rest}:
      ("#" ++ p) <> hashes.show(rest)

# a user as ACL LIST shows it: "user", its name, its flags, its
# passwords' hashes, its root selector, then its other selectors in
# parentheses
def user.line(+u: User) -> String:
  match u:
    case User{+name, on, nopass, pay, +pass, +sels}:
      +rest = Bool.pick(List<&2, Sel>, List.is_empty(&2, Sel, sels), Nil{}, List.drop(&2, Sel, sels, 1n))
      acl.join(List.append(&2, String, ["user", name], List.append(&2, String, user.flags(u), List.append(&2, String, hashes.show(pass), (sel.desc(user.root(u)) <> sels.desc(rest))))), " ")

def bulks(xs: List<&2, String>) -> List<&2, R.Reply>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{x, rest}:
      R.RBulk{x} <> bulks(rest)

# a selector as ACL GETUSER shows it: commands, keys, channels
def sel.map(+s: Sel) -> List<&2, R.Reply>:
  [R.RBulk{"commands"}, R.RBulk{sel.cmds.desc(s)}, R.RBulk{"keys"}, R.RBulk{acl.join(sel.keys.desc(s), " ")}, R.RBulk{"channels"}, R.RBulk{acl.join(sel.chans.desc(s), " ")}]

def sels.maps(ss: List<&2, Sel>) -> List<&2, R.Reply>:
  match ss:
    case Nil{}:
      Nil{}
    case Con{+s, rest}:
      R.RMap{sel.map(s)} <> sels.maps(rest)

# ACL GETUSER: its flags, its passwords' hashes, its root selector's
# commands, keys and channels, then its other selectors
def user.reply(+u: User) -> R.Reply:
  +rest = List.drop(&2, Sel, user.sels(u), 1n)
  +root = sel.map(user.root(u))
  R.RMap{List.append(&2, R.Reply, [R.RBulk{"flags"}, R.RSet{bulks(user.flags(u))}, R.RBulk{"passwords"}, R.RArray{bulks(user.pass(u))}], List.append(&2, R.Reply, root, [R.RBulk{"selectors"}, R.RArray{sels.maps(rest)}]))}

def acl.getuser.of(m: Maybe<&2, User>) -> R.Reply:
  match m:
    case Some{+u}:
      user.reply(u)
    case None{}:
      R.RNull{}

def acl.getuser(+a: Acl, +n: String) -> R.Reply:
  acl.getuser.of(acl.user(a, n))

# all the users, in the order of their names (default among them)
def acl.all(+a: Acl) -> List<&2, User>:
  users.put(acl.users(a), acl.dflt(a))

def users.lines(us: List<&2, User>) -> List<&2, R.Reply>:
  match us:
    case Nil{}:
      Nil{}
    case Con{+u, rest}:
      R.RBulk{user.line(u)} <> users.lines(rest)

def users.names(us: List<&2, User>) -> List<&2, R.Reply>:
  match us:
    case Nil{}:
      Nil{}
    case Con{+u, rest}:
      R.RBulk{user.name(u)} <> users.names(rest)

# ACL LIST and ACL USERS
def acl.list(+a: Acl) -> R.Reply:
  R.RArray{users.lines(acl.all(a))}

def acl.usernames(+a: Acl) -> R.Reply:
  R.RArray{users.names(acl.all(a))}

# ACL CAT, with no category: the categories; with one: its commands and
# subcommands (in the order of their names, where Redis lists them in its
# table's hash order), or the error of a category not there
def ids.names(ids: List<&2, Nat>) -> List<&2, R.Reply>:
  match ids:
    case Nil{}:
      Nil{}
    case Con{+id, rest}:
      R.RBulk{acl.name(id)} <> ids.names(rest)

def acl.cat.reply(m: Maybe<&2, Nat>, +name: String) -> R.Reply:
  match m:
    case Some{+c}:
      R.RArray{ids.names(acl.cat.ids(c))}
    case None{}:
      R.RError{R.e_fmt("ERR Unknown category '" ++ String.take(R.cstr(name), 128n) ++ "'")}

def acl.cats.reply() -> R.Reply:
  R.RArray{bulks(acl.cats())}

# ACL GENPASS: (bits + 3) / 4 hex digits, from blocks of 64: the SHA-256
# of the secret key and a count that goes up by one a block, as Redis's
# getRandomHexChars hashes a secret seed with a counter
def acl.key(+a: Acl) -> String:
  match a:
    case Acl{dflt, users, log, gone, rp, +key, ctr, rcl}:
      key

def acl.ctr(+a: Acl) -> Nat:
  match a:
    case Acl{dflt, users, log, gone, rp, key, +ctr, rcl}:
      ctr

def genpass.go(k: Nat, +key: String, +c: Nat, acc: String) -> String:
  match k:
    case 0n:
      acc
    case 1n+p:
      genpass.go(p, key, Nat.add(c, 1n), acc ++ sha256(key ++ "." ++ Nat.show(c)))

def genpass.blocks(+bits: Nat) -> Nat:
  Nat.div(Nat.add(Nat.div(Nat.add(bits, 3n), 4n), 63n), 64n)

def acl.genpass(+a: Acl, +bits: Nat) -> String:
  String.take(genpass.go(genpass.blocks(bits), acl.key(a), acl.ctr(a), ""), Nat.div(Nat.add(bits, 3n), 4n))

# the ACL after a GENPASS of bits: its blocks counted
def acl.genpassed(a: Acl, +bits: Nat) -> Acl:
  match a:
    case Acl{dflt, users, log, gone, rp, key, +ctr, rcl}:
      Acl{dflt, users, log, gone, rp, key, Nat.add(ctr, genpass.blocks(bits)), rcl}

# The check
# ---------
# A call as Redis's ACLSelectorCheckCmd checks it: its command's id,
# whether it needs no permission (AUTH, HELLO, QUIT and RESET: Redis's
# CMD_NO_AUTH), its first argument and whether it has one, its keys with
# what each needs (0 any pattern, 1 read, 2 write, 3 both) and where it
# is, its channels and whether each is a pattern (PSUBSCRIBE's, which
# must be an allowed pattern itself) and where it is.

type KeyUse is Data:
  KeyUse{key: String, need: Nat, at: Nat}

type ChanUse is Data:
  ChanUse{ch: String, lit: Bool, at: Nat}

type Call is Data:
  Call{id: Nat, free: Bool, arg1: String, has1: Bool, keys: List<&2, KeyUse>, chans: List<&2, ChanUse>}

# allowed, or why not (1 the command, 2 a key, 4 a channel), where (the
# argument's index; 0 for the command), and what (the command's full
# name, the key, the channel)
type Verdict is Data:
  VOk{}
  VNo{why: Nat, at: Nat, obj: String}

def call.id(+c: Call) -> Nat:
  match c:
    case Call{+id, free, arg1, has1, keys, chans}:
      id

def call.keys(+c: Call) -> List<&2, KeyUse>:
  match c:
    case Call{id, free, arg1, has1, +keys, chans}:
      keys

def call.chans(+c: Call) -> List<&2, ChanUse>:
  match c:
    case Call{id, free, arg1, has1, keys, +chans}:
      chans

# whether the selector allows the call's command: every command, a call
# that needs none, the command's bit, or its first argument, case aside
def sel.cmd.ok(+s: Sel, +c: Call) -> Bool:
  match s c:
    case Sel{all, +allc, +bits, +firsts, rules, allk, keys, allch, chans} Call{+id, +free, +arg1, +has1, ks, cs}:
      Bool.or(Bool.or(allc, free), Bool.or(bits.get(bits, id), Bool.and(has1, acl.has.nc(arg1, firsts.of(firsts, id)))))

def kpat.ok(+p: KPat, +k: KeyUse) -> Bool:
  match p k:
    case KPat{+rw, +pat} KeyUse{+key, +need, at}:
      Bool.and(Bool.or(Nat.is_eq(need, 0n), Bool.or(Nat.is_eq(rw, 3n), Nat.is_eq(rw, need))), R.stringmatch(pat, key, False{}))

def kpats.ok(ps: List<&2, KPat>, +k: KeyUse) -> Bool:
  match ps:
    case Nil{}:
      False{}
    case Con{+p, rest}:
      Bool.or(kpat.ok(p, k), kpats.ok(rest, k))

# the first key the selector's patterns do not allow
def keys.fail(ks: List<&2, KeyUse>, +ps: List<&2, KPat>) -> Maybe<&2, KeyUse>:
  match ks:
    case Nil{}:
      None{}
    case Con{+k, rest}:
      Bool.pick(Maybe<&2, KeyUse>, kpats.ok(ps, k), keys.fail(rest, ps), Some{k})

def chan.ok(+lit: Bool, +ch: String, ps: List<&2, String>) -> Bool:
  match ps:
    case Nil{}:
      False{}
    case Con{+p, rest}:
      Bool.or(Bool.pick(Bool, lit, String.eq(p, ch), R.stringmatch(p, ch, False{})), chan.ok(lit, ch, rest))

def chans.fail(cs: List<&2, ChanUse>, +ps: List<&2, String>) -> Maybe<&2, ChanUse>:
  match cs:
    case Nil{}:
      None{}
    case Con{ChanUse{+ch, +lit, +at}, rest}:
      Bool.pick(Maybe<&2, ChanUse>, chan.ok(lit, ch, ps), chans.fail(rest, ps), Some{ChanUse{ch, lit, at}})

def sel.check.chan(m: Maybe<&2, ChanUse>) -> Verdict:
  match m:
    case Some{ChanUse{ch, lit, at}}:
      VNo{4n, at, ch}
    case None{}:
      VOk{}

def sel.chan.check(allch: Bool, +ps: List<&2, String>, +c: Call) -> Verdict:
  match allch:
    case True{}:
      VOk{}
    case False{}:
      sel.check.chan(chans.fail(call.chans(c), ps))

def sel.check.key(m: Maybe<&2, KeyUse>, +s: Sel, +c: Call) -> Verdict:
  match m:
    case Some{KeyUse{k, need, at}}:
      VNo{2n, at, k}
    case None{}:
      sel.chan.check(sel.allch(s), sel.chans(s), c)

def sel.keys.of(+s: Sel) -> List<&2, KPat>:
  match s:
    case Sel{all, allc, bits, firsts, rules, allk, +keys, allch, chans}:
      keys

def sel.key.check(allk: Bool, +s: Sel, +c: Call) -> Verdict:
  match allk:
    case True{}:
      sel.check.key(None{}, s, c)
    case False{}:
      sel.check.key(keys.fail(call.keys(c), sel.keys.of(s)), s, c)

def sel.check.cmd(ok: Bool, +s: Sel, +c: Call) -> Verdict:
  match ok:
    case False{}:
      VNo{1n, 0n, acl.name(call.id(c))}
    case True{}:
      sel.key.check(sel.allk(s), s, c)

# a call against one selector: its command, then its keys, then its
# channels; the first that fails
def sel.check(+s: Sel, +c: Call) -> Verdict:
  sel.check.cmd(sel.cmd.ok(s, c), s, c)

# the verdict to keep of two failed selectors: the higher reason, then the
# later argument (Redis's ACLCheckAllUserCommandPerm)
def verdict.max(a: Verdict, b: Verdict) -> Verdict:
  match a b:
    case VNo{+w0, +at0, o0} VNo{+w1, +at1, o1}:
      Bool.pick(Verdict, Bool.or(Nat.is_lt(w0, w1), Bool.and(Nat.is_eq(w0, w1), Nat.is_lt(at0, at1))), VNo{w1, at1, o1}, VNo{w0, at0, o0})
    case VOk{} other:
      other
    case other VOk{}:
      other

def verdict.ok(+v: Verdict) -> Bool:
  match v:
    case VOk{}:
      True{}
    case VNo{w, at, o}:
      False{}

def sels.check(ss: List<&2, Sel>, +c: Call, worst: Verdict) -> Verdict:
  match ss:
    case Nil{}:
      worst
    case Con{+s, rest}:
      +v = sel.check(s, c)
      Bool.pick(Verdict, verdict.ok(v), VOk{}, sels.check(rest, c, verdict.max(worst, v)))

# a call against a user: allowed when one of its selectors allows it.
# The worst verdict starts below every reason (0), so that the command's
# name is looked up only by a selector that refuses the command; a user
# has its root selector at least, and none would refuse the command.
def user.named(zero: Bool, v: Verdict, +c: Call) -> Verdict:
  match zero:
    case True{}:
      VNo{1n, 0n, acl.name(call.id(c))}
    case False{}:
      v

def user.verdict(v: Verdict, +c: Call) -> Verdict:
  match v:
    case VNo{+why, at, o}:
      user.named(Nat.is_eq(why, 0n), VNo{why, at, o}, c)
    case VOk{}:
      VOk{}

def user.check(+u: User, +c: Call) -> Verdict:
  user.verdict(sels.check(user.sels(u), c, VNo{0n, 0n, ""}), c)

# NOPERM's text for a call denied (processCommand's)
def verdict.err(+v: Verdict) -> String:
  match v:
    case VNo{+why, at, +obj}:
      Bool.pick(String, Nat.is_eq(why, 1n), "NOPERM this user has no permissions to run the '" ++ obj ++ "' command",
        Bool.pick(String, Nat.is_eq(why, 2n), "NOPERM this user has no permissions to access one of the keys used as arguments",
          "NOPERM this user has no permissions to access one of the channels used as arguments"))
    case VOk{}:
      ""

# EXEC's reason for a queued call denied since it was queued
def verdict.exec(+v: Verdict) -> String:
  match v:
    case VNo{+why, at, obj}:
      "NOPERM ACLs rules changed between the moment the transaction was accumulated and the EXEC call. This command is no longer allowed for the following reason: " ++
        Bool.pick(String, Nat.is_eq(why, 1n), "no permission to execute the command or subcommand",
          Bool.pick(String, Nat.is_eq(why, 2n), "no permission to touch the specified keys", "no permission to access one of the channels used as arguments"))
    case VOk{}:
      ""

# ACL DRYRUN's reply: OK, or why not as a bulk string
def verdict.dry(+v: Verdict) -> R.Reply:
  match v:
    case VOk{}:
      R.r_ok()
    case VNo{+why, at, +obj}:
      R.RBulk{Bool.pick(String, Nat.is_eq(why, 1n), "This user has no permissions to run the '" ++ obj ++ "' command",
        Bool.pick(String, Nat.is_eq(why, 2n), "This user has no permissions to access the '" ++ obj ++ "' key", "This user has no permissions to access the '" ++ obj ++ "' channel"))}

# the reason ACL LOG gives a verdict
def verdict.why(+v: Verdict) -> String:
  match v:
    case VNo{+why, at, obj}:
      Bool.pick(String, Nat.is_eq(why, 1n), "command", Bool.pick(String, Nat.is_eq(why, 2n), "key", "channel"))
    case VOk{}:
      ""

def verdict.obj(+v: Verdict) -> String:
  match v:
    case VNo{why, at, +obj}:
      obj
    case VOk{}:
      ""

# A call from its command line
# ----------------------------
# What Redis's check reads of a command line: its command or subcommand
# (lookupCommand: a subcommand by its first argument, an unknown one being
# no command), whose arity it must fit, its keys by the command's key
# specs or its own function, each needing to be read when its flags have
# access, written when they have insert, delete or update (and nothing
# else, any pattern matching it, when they have neither), and the
# channels PUBLISH and SPUBLISH send to and the subscriptions name.

type CallR is Data:
  CallOk{c: Call}
  CallNone{}
  CallArity{name: String}

def key.need(+fl: List<&2, String>) -> Nat:
  Nat.add(Bool.pick(Nat, K.has("access", fl), 1n, 0n), Bool.pick(Nat, Bool.or(K.has("insert", fl), Bool.or(K.has("delete", fl), K.has("update", fl))), 2n, 0n))

def uses.keys(ks: List<&2, K.KeyAt>, +argv: List<&2, String>) -> List<&2, KeyUse>:
  match ks:
    case Nil{}:
      Nil{}
    case Con{K.KeyAt{+at, +fl}, rest}:
      KeyUse{acl.arg(argv, at), key.need(fl), at} <> uses.keys(rest, argv)

def uses.keys.of(m: Maybe<&2, List<&2, K.KeyAt>>, +argv: List<&2, String>) -> List<&2, KeyUse>:
  match m:
    case Some{ks}:
      uses.keys(ks, argv)
    case None{}:
      Nil{}

# the channels of a subscription's arguments from i on (lit: PSUBSCRIBE's
# patterns)
def uses.subs(xs: List<&2, String>, +lit: Bool, +i: Nat) -> List<&2, ChanUse>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{x, rest}:
      ChanUse{x, lit, i} <> uses.subs(rest, lit, Nat.add(i, 1n))

# the same of a command line read in place, from its argument i on
def uses.subs.at(+xs: List<&2, String>, +lit: Bool, +i: Nat) -> List<&2, ChanUse>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+x, +rest}:
      ChanUse{x, lit, i} <> uses.subs.at(rest, lit, Nat.add(i, 1n))

# the channels of a call of kind k (K.acl.kind.key), its command line read
# in place: PUBLISH's first argument, or every argument of a subscription
def uses.first(+xs: List<&2, String>) -> List<&2, ChanUse>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+x, +rest}:
      [ChanUse{x, False{}, 1n}]

def uses.pub(+argv: List<&2, String>) -> List<&2, ChanUse>:
  match argv:
    case Nil{}:
      Nil{}
    case Con{+c, +rest}:
      uses.first(rest)

def uses.subs.from(+argv: List<&2, String>, +lit: Bool) -> List<&2, ChanUse>:
  match argv:
    case Nil{}:
      Nil{}
    case Con{+c, +rest}:
      uses.subs.at(rest, lit, 1n)

def uses.chans.key(+k: Nat, +argv: List<&2, String>) -> List<&2, ChanUse>:
  match k:
    case 1n:
      uses.pub(argv)
    case 2n:
      uses.subs.from(argv, False{})
    case 3n:
      uses.subs.from(argv, True{})
    case _:
      Nil{}

# 1 PUBLISH and SPUBLISH, 2 SUBSCRIBE and SSUBSCRIBE, 3 PSUBSCRIBE, 0 any
# other command
def chans.kind(+name: String) -> Nat:
  Bool.pick(Nat, Bool.or(String.eq(name, "publish"), String.eq(name, "spublish")), 1n,
    Bool.pick(Nat, Bool.or(String.eq(name, "subscribe"), String.eq(name, "ssubscribe")), 2n,
      Bool.pick(Nat, String.eq(name, "psubscribe"), 3n, 0n)))

def uses.chans.of(k: Nat, xs: List<&2, String>) -> List<&2, ChanUse>:
  match k:
    case 1n:
      List.take(&2, ChanUse, uses.subs(xs, False{}, 1n), 1n)
    case 2n:
      uses.subs(xs, False{}, 1n)
    case 3n:
      uses.subs(xs, True{}, 1n)
    case _:
      Nil{}

def uses.chans(+name: String, argv: List<&2, String>) -> List<&2, ChanUse>:
  match argv:
    case Con{c, rest}:
      uses.chans.of(chans.kind(name), rest)
    case Nil{}:
      Nil{}

# whether a command runs for every user (Redis's CMD_NO_AUTH)
def call.free(+name: String) -> Bool:
  Bool.or(Bool.or(String.eq(name, "auth"), String.eq(name, "hello")), Bool.or(String.eq(name, "quit"), String.eq(name, "reset")))

def call.id.of(m: Maybe<&2, Nat>) -> Nat:
  match m:
    case Some{i}:
      i
    case None{}:
      0n

def call.make(d: K.Desc, +argv: List<&2, String>) -> CallR:
  match d:
    case K.Desc{+name, arity, cats, +specs, +way, nokeys, info, docs}:
      +n = List.length(&2, String, argv)
      Bool.pick(CallR, K.arity.ok(arity, n),
        CallOk{Call{call.id.of(acl.id(name)), call.free(name), acl.nth(argv, 1n), Nat.is_le(2n, n), uses.keys.of(Bool.pick(Maybe<&2, List<&2, K.KeyAt>>, K.keys.has(way, specs), K.keys.find(way, specs, argv), None{}), argv), uses.chans(name, argv)}},
        CallArity{name})

def call.of.desc(m: Maybe<&2, K.Desc>, +argv: List<&2, String>) -> CallR:
  match m:
    case Some{d}:
      call.make(d, argv)
    case None{}:
      CallNone{}

def call.of(+argv: List<&2, String>) -> CallR:
  call.of.desc(K.desc.argv(argv), argv)

# The same of a call the server checks, by its INFO key (redis.bend: its
# code's key, which the parser found): its id (acl.of.key), arity and key
# specs (K.spec.key), with no walk of the table of commands, which builds
# every command's description and documentation (call.of, for ACL
# DRYRUN). The name the checks of AUTH's kin and of channels read is the
# command's, case aside.
def call.of.ok(ok: Bool, +id: Nat, +kind: Nat, +specs: List<&2, K.KSpec>, +way: K.KWay, +n: Nat, +argv: List<&2, String>) -> CallR:
  match ok:
    case True{}:
      CallOk{Call{id, Nat.is_eq(kind, 4n), acl.arg(argv, 1n), Nat.is_le(2n, n), uses.keys.of(Bool.pick(Maybe<&2, List<&2, K.KeyAt>>, K.keys.has(way, specs), K.keys.find(way, specs, argv), None{}), argv), uses.chans.key(kind, argv)}}
    case False{}:
      CallArity{acl.name(id)}

def call.of.spec(m: Maybe<&2, K.Ro>, +id: Nat, +kind: Nat, +argv: List<&2, String>) -> CallR:
  match m:
    case Some{K.Ro{arity, +specs, +way}}:
      +n = List.length(&2, String, argv)
      call.of.ok(K.arity.ok(arity, n), id, kind, specs, way, n, argv)
    case None{}:
      CallNone{}

def call.of.key(+key: Nat, +argv: List<&2, String>) -> CallR:
  call.of.spec(K.spec.key(key), acl.of.key(key), K.acl.kind.key(key), argv)

# a call of user u by its command line, as processCommand checks it once
# it has looked the command up: allowed, or why not. A command the
# parser refuses (unknown, or with a number of arguments its arity does
# not allow) is refused before, so it passes here; a user that is gone
# (ACL DELUSER, whose clients are closed) is allowed nothing.
def user.call.check(+u: User, +r: CallR) -> Verdict:
  match r:
    case CallOk{+c}:
      user.check(u, c)
    case _:
      VOk{}

def gone.call.check(+r: CallR) -> Verdict:
  match r:
    case CallOk{+c}:
      VNo{1n, 0n, acl.name(call.id(c))}
    case _:
      VOk{}

# where the user of name n is among us, from i (past the last when none)
def users.idx(+us: List<&2, User>, +n: String, +i: Nat) -> Nat:
  match us:
    case Nil{}:
      i
    case Con{+u, +rest}:
      Bool.pick(Nat, String.eq(user.name(u), n), i, users.idx(rest, n, Nat.add(i, 1n)))

# the call checked against the user at i among us, read in place
def users.call.at(+us: List<&2, User>, +i: Nat, +r: CallR) -> Verdict:
  match us i:
    case Nil{} _:
      gone.call.check(r)
    case Con{+u, +rest} 0n:
      user.call.check(u, r)
    case Con{+u, +rest} 1n+p:
      users.call.at(rest, p, r)

def acl.check.pick(d: Bool, +u: User, +us: List<&2, User>, +n: String, +r: CallR) -> Verdict:
  match d:
    case True{}:
      user.call.check(u, r)
    case False{}:
      users.call.at(us, users.idx(us, n, 0n), r)

def acl.check.in(+a: Acl, +n: String, +r: CallR) -> Verdict:
  match a:
    case Acl{+dflt, +users, log, gone, rp, key, ctr, rcl}:
      acl.check.pick(String.eq(n, "default"), dflt, users, n, r)

# a call of INFO key k of the user of name n (server.bend, ACL), the user
# found and checked in place: one that acl.user gave back would be copied
# out of the borrowed Acl, with the list of users, at every call
def acl.check(+a: Acl, +n: String, +k: Nat, +argv: List<&2, String>) -> Verdict:
  acl.check.in(a, n, call.of.key(k, argv))

# SORT's BY with a pattern and its GET read keys by pattern: a user gives
# them only through a selector that allows the call and may read every
# key, all keys or a read pattern that is * itself (sortCommandGeneric,
# ACLUserCheckCmdWithUnrestrictedKeyAccess)
def kpats.star(ks: List<&2, KPat>) -> Bool:
  match ks:
    case Nil{}:
      False{}
    case Con{KPat{+rw, +pat}, rest}:
      Bool.or(Bool.and(Nat.is_eq(Nat.mod(rw, 2n), 1n), String.eq(pat, "*")), kpats.star(rest))

def sels.sort.ok(ss: List<&2, Sel>, +c: Call) -> Bool:
  match ss:
    case Nil{}:
      False{}
    case Con{+s, rest}:
      Bool.or(Bool.and(verdict.ok(sel.check(s, c)), Bool.or(sel.allk(s), kpats.star(sel.keys.of(s)))), sels.sort.ok(rest, c))

# SORT's options, read in order as sortCommandGeneric reads them, by a
# user that may not read every key: st is what the argument x is (0 an
# option, 1 BY's pattern, 2 an argument passed over, 3 and 4 LIMIT's
# numbers), left how many arguments there are from x on. Each answers how
# the reading goes on (0), or ends: an error of SORT's own first (1, as a
# syntax error or a LIMIT that is not a number), BY's (2) or GET's (3).
def sort.word(+o: String) -> Nat:
  Bool.pick(Nat, Bool.or(R.is_word(o, "ASC"), Bool.or(R.is_word(o, "DESC"), R.is_word(o, "ALPHA"))), 1n,
    Bool.pick(Nat, R.is_word(o, "LIMIT"), 2n, Bool.pick(Nat, R.is_word(o, "STORE"), 3n,
      Bool.pick(Nat, R.is_word(o, "BY"), 4n, Bool.pick(Nat, R.is_word(o, "GET"), 5n, 0n)))))

def ll.is(l: R.LL) -> Bool:
  match l:
    case R.LL{neg, hi, lo}:
      True{}
    case R.LLBad{}:
      False{}

# an option o with la arguments after it (ro: SORT_RO, which has no STORE)
def sort.opt.out(+w: Nat, +la: Nat, +ro: Bool) -> Nat:
  match w:
    case 1n:
      0n
    case 2n:
      Bool.pick(Nat, Nat.is_le(2n, la), 0n, 1n)
    case 3n:
      Bool.pick(Nat, Bool.and(Nat.is_le(1n, la), Bool.not(ro)), 0n, 1n)
    case 4n:
      Bool.pick(Nat, Nat.is_le(1n, la), 0n, 1n)
    case 5n:
      Bool.pick(Nat, Nat.is_le(1n, la), 3n, 1n)
    case _:
      1n

def sort.opt.next(+w: Nat) -> Nat:
  match w:
    case 2n:
      3n
    case 3n:
      2n
    case 4n:
      1n
    case _:
      0n

def sort.acl.out(+st: Nat, +x: String, +left: Nat, +ro: Bool) -> Nat:
  match st:
    case 0n:
      sort.opt.out(sort.word(x), Nat.sub(left, 1n), ro)
    case 1n:
      Bool.pick(Nat, Nat.is_lt(String.find(x, '*', 0n), String.length(x)), 2n, 0n)
    case 2n:
      0n
    case _:
      Bool.pick(Nat, ll.is(R.ll.read(x)), 0n, 1n)

def sort.acl.next(+st: Nat, +x: String) -> Nat:
  match st:
    case 0n:
      sort.opt.next(sort.word(x))
    case 3n:
      4n
    case _:
      0n

def sort.acl.pick(+o: Nat, m: Maybe<&2, String>) -> Maybe<&2, String>:
  match o:
    case 0n:
      m
    case 2n:
      Some{"ERR BY option of SORT denied due to insufficient ACL permissions."}
    case 3n:
      Some{"ERR GET option of SORT denied due to insufficient ACL permissions."}
    case _:
      None{}

def sort.acl.go(args: List<&2, String>, +st: Nat, +left: Nat, +ro: Bool) -> Maybe<&2, String>:
  match args:
    case Nil{}:
      None{}
    case Con{+x, rest}:
      sort.acl.pick(sort.acl.out(st, x, left, ro), sort.acl.go(rest, sort.acl.next(st, x), Nat.sub(left, 1n), ro))

# SORT's error (or SORT_RO's) for a BY with a pattern or a GET of a user
# that may not read every key (u), none for any other call
def sort.acl.user(m: Maybe<&2, User>, r: CallR, +argv: List<&2, String>, +ro: Bool) -> Maybe<&2, String>:
  match m r:
    case Some{+u} CallOk{+c}:
      Bool.pick(Maybe<&2, String>, sels.sort.ok(user.sels(u), c), None{}, sort.acl.go(List.drop(&2, String, argv, 2n), 0n, Nat.sub(List.length(&2, String, argv), 2n), ro))
    case _ _:
      None{}

def sort.acl.if(on: Bool, +a: Acl, +n: String, +k: Nat, +argv: List<&2, String>, +ro: Bool) -> Maybe<&2, String>:
  match on:
    case True{}:
      sort.acl.user(acl.user(a, n), call.of.key(k, argv), argv, ro)
    case False{}:
      None{}

def acl.sort.err(+a: Acl, +n: String, +k: Nat, +argv: List<&2, String>) -> Maybe<&2, String>:
  +kind = K.acl.kind.key(k)
  sort.acl.if(Bool.or(Nat.is_eq(kind, 5n), Nat.is_eq(kind, 6n)), a, n, k, argv, Nat.is_eq(kind, 6n))

# ACL DRYRUN user command [arg ...]: the user, then the command, its
# arity, and the check (on or off alike, and nothing logged)
def dry.call(+u: User, r: CallR, +cmd: String) -> R.Reply:
  match r:
    case CallOk{c}:
      +c0 = c
      verdict.dry(user.check(u, c0))
    case CallNone{}:
      R.RError{R.e_fmt("ERR Command '" ++ R.cstr(cmd) ++ "' not found")}
    case CallArity{name}:
      R.RError{"ERR wrong number of arguments for '" ++ name ++ "' command"}

def dry.user(m: Maybe<&2, User>, +name: String, +argv: List<&2, String>) -> R.Reply:
  match m:
    case Some{+u}:
      dry.call(u, call.of(argv), acl.nth(argv, 0n))
    case None{}:
      R.RError{R.e_fmt("ERR User '" ++ R.cstr(name) ++ "' not found")}

def acl.dryrun(+a: Acl, args: List<&2, String>) -> R.Reply:
  match args:
    case Con{+name, +argv}:
      dry.user(acl.user(a, name), name, argv)
    case Nil{}:
      R.RError{"ERR wrong number of arguments for 'acl|dryrun' command"}

# Channels taken away
# -------------------
# ACL SETUSER of a user there, as Redis's ACLKillPubsubClientsIfNeeded:
# no client of it is looked at when one of its new selectors allows every
# channel, or when none of its old ones did and each old pattern is
# among the new ones; else each of its clients with a subscription keeps
# it only if each channel it subscribed to matches a new pattern and
# each pattern it subscribed to is one.

def sels.allch(ss: List<&2, Sel>) -> Bool:
  match ss:
    case Nil{}:
      False{}
    case Con{+s, rest}:
      Bool.or(sel.allch(s), sels.allch(rest))

def sels.chans(ss: List<&2, Sel>) -> List<&2, String>:
  match ss:
    case Nil{}:
      Nil{}
    case Con{+s, rest}:
      List.append(&2, String, sel.chans(s), sels.chans(rest))

def acl.all.in(xs: List<&2, String>, +ys: List<&2, String>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{+x, rest}:
      Bool.and(acl.has(x, ys), acl.all.in(rest, ys))

# whether the user's subscribers are to be looked at, after its change
def acl.revokes(+old: User, +new: User) -> Bool:
  +now = user.sels(new)
  Bool.and(Bool.not(sels.allch(now)), Bool.or(sels.allch(user.sels(old)), Bool.not(acl.all.in(sels.chans(user.sels(old)), sels.chans(now)))))

def acl.subs.ok(cs: List<&2, String>, +lit: Bool, +ps: List<&2, String>) -> Bool:
  match cs:
    case Nil{}:
      True{}
    case Con{+c, rest}:
      Bool.and(chan.ok(lit, c, ps), acl.subs.ok(rest, lit, ps))

# whether a subscriber of the user keeps its channels and patterns
def acl.keeps(+u: User, chs: List<&2, String>, pats: List<&2, String>) -> Bool:
  +ps = sels.chans(user.sels(u))
  Bool.or(sels.allch(user.sels(u)), Bool.and(acl.subs.ok(chs, False{}, ps), acl.subs.ok(pats, True{}, ps)))

# The ACL LOG
# -----------
# An event is counted by the entry among the ten newest with its reason,
# context, object and user, if it came within 60 s of it: that entry
# counts one more and goes first, with the event's time and client. Else
# the event is an entry of its own, first, the oldest dropped past max
# (acllog-max-len). Redis's addACLLogEntry.

def ent.same(+x: Ent, +e: Ent) -> Bool:
  match x e:
    case Ent{c0, +w0, +x0, +o0, +u0, +t0, i0} Ent{c1, +w1, +x1, +o1, +u1, +t1, i1}:
      Bool.and(Bool.and(Bool.and(String.eq(w0, w1), String.eq(x0, x1)), Bool.and(String.eq(o0, o1), String.eq(u0, u1))),
        Nat.is_le(Bool.pick(Nat, Nat.is_le(t0, t1), Nat.sub(t1, t0), Nat.sub(t0, t1)), 60000n))

def ent.bump(x: Ent, e: Ent) -> Ent:
  match x e:
    case Ent{c0, w0, x0, o0, u0, t0, i0} Ent{c1, w1, x1, o1, u1, t1, i1}:
      Ent{Nat.add(c0, 1n), w0, x0, o0, u0, t1, i1}

type Pick is Data:
  Pick{hit: Maybe<&2, Ent>, rest: List<&2, Ent>}

def pick.cons(x: Ent, p: Pick) -> Pick:
  match p:
    case Pick{hit, rest}:
      Pick{hit, x <> rest}

# the first of the k newest entries that counts e, taken out
def log.pick(k: Nat, +log: List<&2, Ent>, +e: Ent) -> Pick:
  match k log:
    case 1n+p Con{+x, +rest}:
      Bool.pick(Pick, ent.same(x, e), Pick{Some{x}, rest}, pick.cons(x, log.pick(p, rest, e)))
    case _ other:
      Pick{None{}, other}

def log.put(p: Pick, e: Ent, +max: Nat) -> List<&2, Ent>:
  match p:
    case Pick{Some{x}, rest}:
      ent.bump(x, e) <> rest
    case Pick{None{}, rest}:
      List.take(&2, Ent, e <> rest, max)

def acl.log.add(a: Acl, e: Ent, +max: Nat) -> Acl:
  match a:
    case Acl{dflt, users, +log, gone, rp, key, ctr, rcl}:
      +e0 = e
      Acl{dflt, users, log.put(log.pick(10n, log, e0), e0, max), gone, rp, key, ctr, rcl}

def acl.log.reset(a: Acl) -> Acl:
  match a:
    case Acl{dflt, users, log, gone, rp, key, ctr, rcl}:
      Acl{dflt, users, Nil{}, gone, rp, key, ctr, rcl}

# a Nat as a double
def acl.dbl(+n: Nat) -> F.Fl:
  F.fl.round(F.fmt.d(), False{}, F.big.of(n), F.fl.eb(), False{})

def ent.reply(e: Ent, +now: Nat) -> R.Reply:
  match e:
    case Ent{count, why, ctx, obj, user, +at, info}:
      +age = Bool.pick(Nat, Nat.is_le(at, now), Nat.sub(now, at), 0n)
      R.RMap{[R.RBulk{"count"}, R.RInt{R.IPos{count}}, R.RBulk{"reason"}, R.RBulk{why}, R.RBulk{"context"}, R.RBulk{ctx},
        R.RBulk{"object"}, R.RBulk{obj}, R.RBulk{"username"}, R.RBulk{user},
        R.RBulk{"age-seconds"}, R.RDbl{F.fl.show_g(F.fl.div(F.fmt.d(), acl.dbl(age), acl.dbl(1000n)))},
        R.RBulk{"client-info"}, R.RBulk{info}]}

def ents.reply(es: List<&2, Ent>, +now: Nat) -> List<&2, R.Reply>:
  match es:
    case Nil{}:
      Nil{}
    case Con{e, rest}:
      ent.reply(e, now) <> ents.reply(rest, now)

# ACL LOG count: the count newest entries, newest first
def acl.log.reply(+a: Acl, +n: Nat, +now: Nat) -> R.Reply:
  R.RArray{ents.reply(List.take(&2, Ent, acl.log(a), n), now)}

# a user's line, or "" for none (tests)
def acl.line.of(m: Maybe<&2, User>) -> String:
  match m:
    case Some{+u}:
      user.line(u)
    case None{}:
      "(none)"
