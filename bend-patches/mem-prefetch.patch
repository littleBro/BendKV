diff --git a/tests/base/mem_prefetch.bend b/tests/base/mem_prefetch.bend
new file mode 100644
index 0000000..120c08a
--- /dev/null
+++ b/tests/base/mem_prefetch.bend
@@ -0,0 +1,39 @@
+# Mem.prefetch(A, x, k) is k on every lane; on the C lane it also starts
+# loading x's node. Hinted here: a constructor of 17 fields, owned and
+# shared, list cells while a list is walked, Strings of one chunk, of
+# several and of up to 6 bytes (in the term word), numbers, and an empty
+# list. Expect the same sums on every lane.
+import Base
+
+type Big is Data:
+  Big{a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat, k: Nat, l: Nat, m: Nat, n: Nat, o: Nat, p: Nat, q: Nat}
+
+def big(n: Nat) -> Big:
+  Big{n, 1n, 2n, 3n, 4n, 5n, 6n, 7n, 8n, 9n, 10n, 11n, 12n, 13n, 14n, 15n, 16n}
+
+def first(+b: Big) -> Nat:
+  match b:
+    case Big{a, b1, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q}:
+      Nat.add(a, q)
+
+# the hashes of xs, each String and the rest of the list hinted first
+def walk(+xs: List<&2, String>, acc: U32) -> U32:
+  match xs:
+    case Nil{}:
+      Mem.prefetch(List<&2, String>, xs, acc)
+    case Con{x, +rest}:
+      +h = Mem.prefetch(String, x, String.hash(x))
+      walk(rest, Mem.prefetch(List<&2, String>, rest, U32.add(acc, h)))
+
+def strs() -> List<&2, String>:
+  Con{"abc", Con{"a String of one chunk, longer than six bytes", Con{"x" ++ String.repeat("y", 40n) ++ "z", Con{"", Nil{}}}}}
+
+def main() -> String:
+  +b = big(40n)
+  +c = b
+  +xs = strs()
+  +n = Mem.prefetch(Big, b, 7)
+  +m = Mem.prefetch(Big, c, Mem.prefetch(Nat, first(c), n))
+  U32.show(m) ++ "," ++ Nat.show(first(b)) ++ "," ++ U32.show(walk(xs, Mem.prefetch(U32, m, 0)))
+
+#|"7,56,1652566037"
