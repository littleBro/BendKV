+// Mem.prefetch(x, k) is k; it also starts loading the lines of x's node:
+// all of a constructor's fields, a buffer's first 64 bytes, a shared
+// node's seal. It reads no word, so it never waits.
+INLINE u64 mem_prefetch(DEV u64* H, Term t, u64 k) {
+#if !DEVICE
+  if (!term_triv(t)) {
+    uintptr_t p = (uintptr_t)&H[term_loc(t)];
+    u32       n = term_rfc(t) ? 1 : term_tag(t) == TAG_CTR
+      ? cid_arity((u32)term_aux(t)) : term_tag(t) == TAG_BUF ? 8 : 1;
+    for (uintptr_t a = p & ~(uintptr_t)63; a < p + 8 * (uintptr_t)n; a += 64) {
+      __builtin_prefetch((const void*)a);
+    }
+  }
+#endif
+  return k;
+}
