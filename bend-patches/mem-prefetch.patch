+# Mem
+# ---
+
+# Mem.prefetch(A, x, k) is k. On the C lane it also starts bringing the
+# heap node of x into the cache and waits for nothing, so that a read of
+# x soon after need not stall: a hint for overlapping the cache misses of
+# independent reads, with no effect on any value.
+def Mem.prefetch(-A: Data, +x: A, k: U32) -> U32:
+  k
+
