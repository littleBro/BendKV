+# Strings of one chunk and nothing after it (on the C lane, the chunk's
+# buffer term itself, a blob): slices 0 to 40 bytes long of a String of
+# several pieces, each read, compared, hashed, cut, matched char by char
+# owned and borrowed, joined on either side and with itself, upper-cased
+# and grown char by char past its room, owned and shared. Nat.show of a
+# long number is one too. Expect the same summary on every lane.
+import Base
+
+def flag(b: Bool) -> String:
+  match b:
+    case True{}:
+      "T"
+    case False{}:
+      "F"
+
+# chars taken off one by one, owned: how many are c
+def count(s: String, +c: Char, acc: Nat) -> Nat:
+  match s:
+    case SNil{}:
+      acc
+    case SCon{x, t}:
+      count(t, c, Nat.add(acc, Bool.pick(Nat, Char.is_eq(x, c), 1n, 0n)))
+
+# chars read in place, borrowed: their sum
+def sum(+s: String, acc: U32) -> U32:
+  match s:
+    case SNil{}:
+      acc
+    case SCon{Chr{x}, t}:
+      sum(t, U32.add(acc, x))
+
+# k chars put before s one by one
+def grow(k: Nat, s: String) -> String:
+  match k:
+    case 0n:
+      s
+    case 1n+j:
+      grow(j, SCon{'z', s})
+
+def sig(+p: String, +q: String) -> String:
+  +n = String.length(p)
+  +a = Nat.show(n) ++ "," ++ U32.show(String.hash(p)) ++ "," ++ flag(String.eq(p, q)) ++ flag(String.eq(q, p)) ++ flag(String.eq(p, "fghij")) ++ flag(String.eq(p, "fghijklmnopqrs"))
+  +b = U32.show(String.code_at(p, 0n)) ++ "," ++ U32.show(String.code_at(p, Nat.sub(n, 1n))) ++ "," ++ Nat.show(String.find(p, 'k', 0n)) ++ "," ++ Nat.show(String.find(p, 'k', 6n))
+  +c = String.slice(p, 1n, Nat.sub(n, 2n)) ++ "|" ++ String.take(p, 3n) ++ "|" ++ String.drop(p, 3n)
+  +d = Nat.show(count(p, 'g', 0n)) ++ "," ++ U32.show(sum(p, 0)) ++ "," ++ ("<" ++ p) ++ (p ++ ">") ++ (p ++ p)
+  +e = String.to_upper(p) ++ "," ++ p ++ "," ++ grow(3n, p) ++ "," ++ grow(9n, String.slice(q, 0n, n))
+  a ++ ";" ++ b ++ ";" ++ c ++ ";" ++ d ++ ";" ++ e ++ "\n"
+
+def sigs(i: Nat, +src: String, acc: String) -> String:
+  match i:
+    case 0n:
+      acc
+    case 1n++j:
+      sigs(j, src, sig(String.slice(src, 5n, j), String.slice(src, 31n, j)) ++ acc)
+
+def main() -> String:
+  +src = "abcdefghijklmnopqrstuvwxyz" ++ "abcdefghijklmnopqrstuvwxyz" ++ "0123456789"
+  +out = sigs(41n, src, "") ++ Nat.show(Nat.add(Nat.mul(123456n, 1000000n), 789012n)) ++ "," ++ String.to_upper(Nat.show(987654321n))
+  Nat.show(String.length(out)) ++ ":" ++ U32.show(String.hash(out)) ++ ":" ++ String.slice(out, 0n, 60n) ++ "~" ++ String.slice(out, Nat.sub(String.length(out), 60n), 60n)
+
