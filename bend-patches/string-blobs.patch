+
+// a view of a blob or of a blob view, k bytes further in (k below its
+// length)
+INLINE Term str_bview_of(u64* H, Term t, u32 k) {
+  if (term_tag(t) == 0) {
+    return t + ((u64)k << 40);
+  }
+  return term_make(0, (str_pos(t) + k) | (blk_cls(t) << 11), term_peek(H, t));
