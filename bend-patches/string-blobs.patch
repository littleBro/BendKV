+    u32 p = a & 0x7FF;
+    *n = (4u << (a >> 11)) - p;
+    return (u8*)(H + term_loc(t)) + p;
+  }
+  u32 p = str_pos(t);
+  *n = str_cap(t) - p;
+  return str_mem(H, t) + p;
