+// The size is a Nat, the whole 64-bit word: a cut at or past 4 GiB keeps
+// every byte below it. A size off_t cannot hold (an off_t of 32 bits)
+// fails with EOVERFLOW before the file is touched.
 Term file_truncate_run(Env e, Term* f, IoWork* w) {
   w->hand = (intptr_t)io_hand_v(f[0]);
-  w->word = (u32)f[1];
+  w->size = (u64)f[1];
+  if ((off_t)w->size < 0 || (u64)(off_t)w->size != w->size) {
+    w->code = EOVERFLOW;
+    return file_sync_pack(e, w);
+  }
   return io_work(w, file_truncate_call, file_sync_pack);
 }
 
@@ -49,3 +56,43 @@ static void __attribute__((constructor)) file_truncate_use(void) {
 }
 
 #endif
+
+#ifdef CID(File.sync_dir)
+
+#include <libgen.h>
+
+// The directory that holds the path, synced (fsync) on a helper thread, as
+// Redis's fsyncFileDir syncs it: a file just made there keeps its name
+// after a crash, which syncing the file alone does not promise. A host
+// that cannot open a directory to read (EISDIR) or sync one (EINVAL,
+// EBADF) answers done.
+static void file_sync_dir_call(IoWork* w) {
+  int fd = open(dirname(w->data), O_RDONLY);
+  if (fd < 0) {
+    w->code = errno == EISDIR ? 0 : (u32)errno;
+    return;
+  }
+  int n = fsync(fd);
+  w->code = n < 0 && errno != EINVAL && errno != EBADF ? (u32)errno : 0;
+  close(fd);
+}
+
+static Term file_sync_dir_pack(Env e, IoWork* w) {
+  free(w->data);
+  return io_res(e, w, term_pak(CID(Unit), 0));
+}
+
+Term file_sync_dir_run(Env e, Term* f, IoWork* w) {
+  w->data = io_cstr(e, f[0], &w->size);
+  if (io_nul(w->data, w->size)) {
+    w->code = EILSEQ;
+    return file_sync_dir_pack(e, w);
+  }
+  return io_work(w, file_sync_dir_call, file_sync_dir_pack);
+}
+
+static void __attribute__((constructor)) file_sync_dir_use(void) {
+  io_eff(CID(File.sync_dir), file_sync_dir_run);
+}
+
+#endif
