--- a/bend2/effs/file_sync.c
+++ b/bend2/effs/file_sync.c
@@ -35,12 +35,19 @@ static void __attribute__((constructor)) file_sync_use(void) {
 #ifdef CID(File.truncate)
 
 static void file_truncate_call(IoWork* w) {
-  io_sys_end(w, ftruncate((int)w->hand, (off_t)w->word));
+  io_sys_end(w, ftruncate((int)w->hand, (off_t)w->size));
