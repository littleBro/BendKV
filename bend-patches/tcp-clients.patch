+// The marks of channels (Chan.mark, Chan.marked): for each channel's row
+// (its handle's low 24 bits, the generation above them), the generation it
+// was marked under, a word and a time. They belong to the one computation
+// that marks and reads them (an actor, of the channels its clients'
+// answers go back on), so they take no lock; a row's mark under another
+// generation (the row freed and taken again since) reads as none.
+#if !DEVICE
+typedef struct ChanMark {
+  u64 gen;
+  u64 word;
+  u64 time;
+} ChanMark;
+
+static ChanMark* chan_marks;
+static u32       chan_marks_cap;
+
+OUTLINE void chan_marks_grow(u32 i) {
+  u32 cap = chan_marks_cap == 0 ? 64 : chan_marks_cap;
+  while (cap <= i) {
+    cap *= 2;
+  }
+  ChanMark* m = realloc(chan_marks, (size_t)cap * sizeof(ChanMark));
+  if (m == NULL) {
+    err_fail("host allocation failed");
+  }
+  memset(m + chan_marks_cap, 0, (size_t)(cap - chan_marks_cap) * sizeof(ChanMark));
+  chan_marks     = m;
+  chan_marks_cap = cap;
+}
+
+INLINE Term chan_mark(Term ch, u64 word, u64 time) {
+  u64 v = ((u64)term_aux(ch) << 40) | term_loc(ch);
+  u32 i = (u32)v & 0xFFFFFF;
+  if (i >= chan_marks_cap) {
+    chan_marks_grow(i);
+  }
+  chan_marks[i] = (ChanMark){ v >> 24, word, time };
+  return ch;
+}
+
+// the word in the low 16 bits, the time above them
+INLINE u64 chan_marked(Term ch) {
+  u64 v = ((u64)term_aux(ch) << 40) | term_loc(ch);
+  u32 i = (u32)v & 0xFFFFFF;
+  return i < chan_marks_cap && chan_marks[i].gen == v >> 24
+    ? (chan_marks[i].time << 16) | (chan_marks[i].word & 0xFFFF) : 0;
+}
+#endif
