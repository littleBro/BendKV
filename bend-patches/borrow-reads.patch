@@ -0,0 +1,113 @@
+# rfc (rfc_borrow_field): a field read out of a borrowed tree and owned
+# keeps its slot instead of owning the tree. pick walks a lent tree and
+# answers a field (kept where it escapes: slot_keep in the read's
+# segment); late answers it after a call (kept where it is read, from a
+# fact of the pass before); firsts merges a Maybe's field through the
+# arms of an unboxed match; grab hands one to a closure; many races 2^12
+# forked readers to keep one field. The tree is used again after every
+# read, so a lost count, a double free or a rooted word left owned shows
+# as a wrong sum or a "bend: error". Expect 3,ab12,4ab12,abcde,ab12,16384
+# on every lane.
+import Base
+
+type T is Data:
+  L{}
+  N{x: String, l: T, r: T}
+
+def len(s: String) -> U32:
+  match s:
+    case SNil{}:
+      0
+    case SCon{c, r}:
+      U32.add(1, len(r))
+
+def pick(n: Nat, t: T) -> String:
+  match n t:
+    case 0n N{x, l, r}:
+      x
+    case 1n+p N{x, l, r}:
+      pick(p, l)
+    case _ L{}:
+      ""
+
+def late.k(g: Bool, x: String) -> String:
+  match g:
+    case True{}:
+      x
+    case False{}:
+      "-"
+
+def late(n: U32, t: T) -> String:
+  match t:
+    case L{}:
+      ""
+    case N{+x, l, r}:
+      late.k(U32.is_gt(len(x), n), x)
+
+def lx(t: T) -> String:
+  match t:
+    case L{}:
+      ""
+    case N{+x, l, r}:
+      String.append(U32.show(len(x)), x)
+
+def firsts(xs: List<&2, Maybe<&2, String>>) -> String:
+  match xs:
+    case Nil{}:
+      ""
+    case h <> t:
+      match h:
+        case None{}:
+          firsts(t)
+        case Some{v}:
+          String.append(v, firsts(t))
+
+def grab(t: T) -> (U32 -> String) & U32:
+  match t:
+    case L{}:
+      (n => "", 0)
+    case N{x, l, r}:
+      (n => x, 1)
+
+def call(p: (U32 -> String) & U32) -> String:
+  (f, k) = p
+  f(k)
+
+def get(t: T) -> String:
+  match t:
+    case L{}:
+      ""
+    case N{x, l, r}:
+      x
+
+def many(d: Nat, +t: T) -> U32:
+  match d:
+    case 0n:
+      len(get(t))
+    case 1n++p:
+      a b = many(p, t) many(p, t)
+      U32.add(a, b)
+
+def build(n: Nat) -> T:
+  match n:
+    case 0n:
+      L{}
+    case 1n++p:
+      N{String.append("ab", Nat.show(n)), build(p), L{}}
+
+def sep(a: String, b: String) -> String:
+  String.append(a, String.append(",", b))
+
+def go(+t: T, +xs: List<&2, Maybe<&2, String>>) -> String:
+  a = U32.show(len(pick(9n, t)))
+  b = late(3, t)
+  c = lx(t)
+  d = firsts(xs)
+  e = call(grab(t))
+  f = U32.show(many(12n, t))
+  sep(a, sep(b, sep(c, sep(d, sep(e, f)))))
+
+def main() -> IO(Unit):
+  IO.print(go(build(12n), [Some{"a"}, None{}, Some{"bc"}, Some{String.append("d", "e")}]))
