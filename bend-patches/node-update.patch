+// t's node, owned by the caller alone: t's own if no one else holds it,
+// else a copy holding what ctr_take shares out to it. A match that keeps
+// the node as a spare reads its fields in place, and a rebuild of it
+// writes only the fields that change.
+OUTLINE u64 ctr_own_slow(Env e, Term t, u32 n) {
+  u64 nd = heap_alloc(e, cls_fit(n));
+  u64 sp = ctr_take(e, t, n, (THR Term*)(e.mem + nd));
+  if (sp != 0) {
+    heap_free(e, cls_fit(n), nd);
+    return sp;
+  }
+  return nd;
+}
+
+INLINE u64 ctr_own(Env e, Term t, u32 n) {
+  return term_rfc(t) ? ctr_own_slow(e, t, n) : term_loc(t);
+}
+
 // A field read out of a borrowed node to be owned (SEAL_LAZY): the node
 // keeps its reference and the reader gets its own, the field sealed in
 // place as span_fade seals it, by CAS as co-owners may race to seal it.
diff --git a/tests/rfc/node_update.bend b/tests/rfc/node_update.bend
new file mode 100644
index 0000000..a934e86
--- /dev/null
+++ b/tests/rfc/node_update.bend
@@ -0,0 +1,70 @@
+# rfc (rfc_node_update): a node rebuilt with one field changed under a
+# call keeps its node: the match holds it as a spare across the call,
+# saving it instead of the fields that pass through, and the rebuild
+# writes the changed field only. up rebuilds a path in a tree of four-way
+# nodes; t0 and t1 are shared, so their updates copy the path and leave
+# them as they were; many updates its own tree in place 200 times. A
+# field written to the wrong node, or a shared node changed, shows as a
+# wrong sum. Expect
+# 12800,12900,13900,12805,5451500 on every lane.
+import Base
+
+type T is Data:
+  L{v: U32}
+  N{a: T, b: T, c: T, d: T}
+
+def full(d: Nat, +x: U32) -> T:
+  match d:
+    case 0n:
+      L{x}
+    case 1n++e:
+      N{full(e, U32.add(x, 1)), full(e, U32.add(x, 2)), full(e, U32.add(x, 3)), full(e, U32.add(x, 4))}
+
+# the tree with the leaf on path p (2 bits a level, k the first) set to v
+def upd(d: Nat, t: T, k: U32, +p: U32, v: U32) -> T:
+  match d t k:
+    case 0n L{x} _:
+      L{U32.add(x, v)}
+    case 0n other _:
+      other
+    case 1n++e L{x} _:
+      L{U32.add(x, v)}
+    case 1n++e N{a, b, c, f} 0:
+      N{upd(e, a, U32.and(p, 3), U32.shrn(p, 2n), v), b, c, f}
+    case 1n++e N{a, b, c, f} 1:
+      N{a, upd(e, b, U32.and(p, 3), U32.shrn(p, 2n), v), c, f}
+    case 1n++e N{a, b, c, f} 2:
+      N{a, b, upd(e, c, U32.and(p, 3), U32.shrn(p, 2n), v), f}
+    case 1n++e N{a, b, c, f} _:
+      N{a, b, c, upd(e, f, U32.and(p, 3), U32.shrn(p, 2n), v)}
+
+def up(t: T, +p: U32, v: U32) -> T:
+  upd(5n, t, U32.and(p, 3), U32.shrn(p, 2n), v)
+
+def sum(+t: T) -> U32:
+  match t:
+    case L{v}:
+      v
+    case N{a, b, c, f}:
+      U32.add(U32.add(sum(a), sum(b)), U32.add(sum(c), sum(f)))
+
+def many(i: Nat, t: T, acc: U32) -> U32 & T:
+  match i:
+    case 0n:
+      (acc, t)
+    case 1n++j:
+      +t2 = up(t, U32.mul(U32.from_nat(i), 37), U32.from_nat(i))
+      many(j, t2, U32.add(acc, sum(t2)))
+
+def fst(r: U32 & T) -> U32:
+  (a, t) = r
+  a
+
+def main() -> String:
+  +t0 = full(5n, 0)
+  +t1 = up(t0, 7, 100)
+  +t2 = up(t1, 7, 1000)
+  +t3 = up(t0, 1023, 5)
+  U32.show(sum(t0)) ++ "," ++ U32.show(sum(t1)) ++ "," ++ U32.show(sum(t2)) ++ "," ++ U32.show(sum(t3)) ++ "," ++ U32.show(fst(many(200n, full(5n, 1), 0)))
+
+#|"12800,12900,13900,12805,5451500"
