+# The values the channel holds now, oldest first, at most max of them,
+# without waiting (none when it holds none), as that many Chan.recvs that
+# each find a value would take them: a receiver that got one value takes
+# the others that came meanwhile in one step, as an actor does to answer a
+# group of requests after one write to the disk.
+def Chan.drain(-A: Type, chan: Chan(A), max: U32) -> IO(List<&1, A>):
+  import "./effs/chan.c"
+  import "./effs/chan.js"
+
 # Chan.send of every pair at once, without waiting: two send_alls (or
 # sends) that share channels order their values alike on each. A waiting
 # receiver takes its value at once; the rest wait in the channel, past its
diff --git a/bend2/effs/chan.c b/bend2/effs/chan.c
index 717109c..95d67ca 100644
--- a/bend2/effs/chan.c
+++ b/bend2/effs/chan.c
@@ -205,6 +205,64 @@ static void __attribute__((constructor)) chan_recv_use(void) {
 
 #endif
 
+#ifdef CID(Chan.drain)
+
+// Values off the row while it has them, up to max: from its buffer (a
+// sender parked on a full one moves in as a value leaves), else from a
+// sender parked on a channel of no room. A shut row left empty is freed,
+// as Chan.recv frees it.
+static Term* chan_drain_locked(ChanRow* row, u32 max, Term* xs, u32* n, u32* cap, Term* one) {
+  while (row != NULL && *n < max) {
+    Term v;
+    if (row->size > 0) {
+      v = chan_take(row);
+    } else if (row->wait != NULL && row->wait->next->item != TERM_HOLE) {
+      v = chan_wake(row, chan_bool(true));
+    } else {
+      break;
+    }
+    if (*n == *cap) {
+      *cap *= 2;
+      Term* more = io_mem(malloc(*cap * sizeof(Term)));
+      memcpy(more, xs, *n * sizeof(Term));
+      if (xs != one) {
+        free(xs);
+      }
+      xs = more;
+    }
+    xs[*n] = v;
+    *n += 1;
+  }
+  if (row != NULL && row->shut && row->size == 0) {
+    chan_free(row);
+  }
+  return xs;
+}
+
+Term chan_drain_run(Env e, Term* f, IoWork* w) {
+  Term  one[64];
+  Term* xs  = one;
+  u32   n   = 0;
+  u32   cap = 64;
+  io_hold(&chan_lock);
+  xs = chan_drain_locked(chan_at(f[0]), (u32)f[1], xs, &n, &cap, one);
+  io_let(&chan_lock);
+  Term list = term_pak(CID(Nil), 0);
+  for (u32 i = n; i > 0; i -= 1) {
+    list = io_node(e, CID(Con), xs[i - 1], list);
+  }
+  if (xs != one) {
+    free(xs);
+  }
+  return list;
+}
+
+static void __attribute__((constructor)) chan_drain_use(void) {
+  io_eff(CID(Chan.drain), chan_drain_run);
+}
+
+#endif
+
