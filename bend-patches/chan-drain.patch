 }
 
+// Values off the row while it has them, up to max, as chan_recv takes
+// them, without waiting.
+function chan_drain(row, max) {
+  const got = [];
+  while (got.length < Number(max)) {
+    if (row.ring.length > 0) {
+      got.push(chan_take(row));
+    } else if (row.wait.length > 0 && row.wait[0].item !== CHAN_RECV) {
+      got.push(chan_wake(row, true));
+    } else {
+      break;
+    }
+  }
+  let xs = { $: CID(Nil) };
+  for (let i = got.length; i > 0; i -= 1) {
+    xs = { $: CID(Con), head: got[i - 1], tail: xs };
+  }
+  return xs;
+}
+
