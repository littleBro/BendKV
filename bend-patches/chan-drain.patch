diff --git a/tests/io/chan_drain.bend b/tests/io/chan_drain.bend
new file mode 100644
index 0000000..c7912d8
--- /dev/null
+++ b/tests/io/chan_drain.bend
@@ -0,0 +1,50 @@
+# io (io_chan_drain): Chan.drain takes the values a channel holds now,
+# oldest first, at most max of them, without waiting. Five values in a
+# channel of room 8: a drain of 3 takes 1 2 3, one of 10 takes 4 5, one
+# more takes none. With a channel of room 1 that holds 6 and a sender
+# parked behind it with 7, a drain takes 6, then 7 as it moves in; the
+# sender's next value, 8, comes once it runs again, after the drain. A
+# drain of a closed channel takes what is left in it.
+import Base
+
+def show(xs: List<&1, U32>) -> String:
+  match xs:
+    case Nil{}:
+      "."
+    case Con{x, rest}:
+      U32.show(x) ++ " " ++ show(rest)
+
+def sends(+c: Chan(U32), xs: List<&2, U32>) -> IO(Unit):
+  match xs:
+    case Nil{}:
+      IO.pure(Unit, Unit{})
+    case Con{x, rest}:
+      do IO<Unit>:
+        ok : Bool <- Chan.send(U32, c, x)
+        sends(c, rest)
+
+def main() -> IO(Unit):
+  do IO<Unit>:
+    +c : Chan(U32) <- Chan.new(U32, 8)
+    Unit <- sends(c, [1, 2, 3, 4, 5])
+    a : List<&1, U32> <- Chan.drain(U32, c, 3)
+    IO.print(show(a))
+    b : List<&1, U32> <- Chan.drain(U32, c, 10)
+    IO.print(show(b))
+    n : List<&1, U32> <- Chan.drain(U32, c, 10)
+    IO.print(show(n))
+    +d : Chan(U32) <- Chan.new(U32, 1)
+    Unit <- IO.spawn(Unit, sends(d, [6, 7, 8]))
+    Unit <- IO.sleep(50)
+    p : List<&1, U32> <- Chan.drain(U32, d, 10)
+    IO.print(show(p))
+    Unit <- sends(c, [9, 10])
+    Unit <- Chan.close(U32, c)
+    q : List<&1, U32> <- Chan.drain(U32, c, 10)
+    IO.print(show(q))
+
+#|1 2 3 .
+#|4 5 .
+#|.
+#|6 7 .
+#|9 10 .
