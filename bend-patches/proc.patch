diff --git a/bend2/effs/clock.c b/bend2/effs/clock.c
new file mode 100644
index 0000000..3a26af6
--- /dev/null
+++ b/bend2/effs/clock.c
@@ -0,0 +1,17 @@
+// IO
+// ==
+
+#include <sys/time.h>
+
+// The wall clock, as gettimeofday reads it: whole seconds since the Unix
+// epoch, and the microseconds past them. IO.now is the monotonic clock,
+// for spans; this one is for dates.
+Term io_clock_run(Env e, Term* f, IoWork* w) {
+  struct timeval tv;
+  gettimeofday(&tv, NULL);
+  return io_tup(e, (u32)tv.tv_sec, (u32)tv.tv_usec);
+}
+
+static void __attribute__((constructor)) io_clock_use(void) {
+  io_eff(CID(IO.clock), io_clock_run);
+}
diff --git a/bend2/effs/clock.js b/bend2/effs/clock.js
new file mode 100644
index 0000000..399268a
--- /dev/null
+++ b/bend2/effs/clock.js
@@ -0,0 +1,9 @@
+// IO
+// ==
+
+function io_clock() {
+  const us = Math.floor((performance.timeOrigin + performance.now()) * 1000);
+  return io_tup(Math.floor(us / 1000000) >>> 0, (us % 1000000) >>> 0);
+}
+
+io_eff(CID(IO.clock), io_clock);
diff --git a/bend2/effs/cwd.c b/bend2/effs/cwd.c
new file mode 100644
index 0000000..18f7c0c
--- /dev/null
+++ b/bend2/effs/cwd.c
@@ -0,0 +1,38 @@
+// IO
+// ==
+
+#include <unistd.h>
+
+// The process's working directory, as getcwd gives it (getcwd allocates a
+// buffer of the size the path needs).
+Term io_cwd_run(Env e, Term* f, IoWork* w) {
+  char* got = getcwd(NULL, 0);
+  if (got == NULL) {
+    return io_fail(e, (u32)errno, NULL);
+  }
+  Term t = io_done(e, io_str(e, got, strlen(got)));
+  free(got);
+  return t;
+}
+
+// Changes the working directory of the whole process: every thread's
+// relative paths resolve from the new one afterwards.
+Term io_chdir_run(Env e, Term* f, IoWork* w) {
+  u64   n    = 0;
+  char* path = io_cstr(e, f[0], &n);
+  int   bad  = io_nul(path, n);
+  int   got  = bad ? -1 : chdir(path);
+  u32   code = bad ? EINVAL : (u32)errno;
+  free(path);
+  return got == 0 ? io_done(e, term_pak(CID(Unit), 0))
+    : io_fail(e, code, NULL);
+}
+
+static void __attribute__((constructor)) io_cwd_use(void) {
+#ifdef CID(IO.cwd)
+  io_eff(CID(IO.cwd), io_cwd_run);
+#endif
+#ifdef CID(IO.chdir)
+  io_eff(CID(IO.chdir), io_chdir_run);
+#endif
+}
diff --git a/bend2/effs/cwd.js b/bend2/effs/cwd.js
new file mode 100644
index 0000000..2ebef73
--- /dev/null
+++ b/bend2/effs/cwd.js
@@ -0,0 +1,22 @@
+// IO
+// ==
+
+function io_cwd() {
+  try {
+    return io_done(process.cwd());
+  } catch (e) {
+    return io_fail(Math.abs(e.errno ?? 2));
+  }
+}
+
+function io_chdir(path) {
+  try {
+    process.chdir(path);
+    return io_done({ $: CID(Unit) });
+  } catch (e) {
+    return io_fail(Math.abs(e.errno ?? 2));
+  }
+}
+
+io_eff(CID(IO.cwd), io_cwd);
+io_eff(CID(IO.chdir), io_chdir);
