diff --git a/tests/io/proc.bend b/tests/io/proc.bend
new file mode 100644
index 0000000..ed145fd
--- /dev/null
+++ b/tests/io/proc.bend
@@ -0,0 +1,73 @@
+# io (io_proc): IO.pid is the process's id, above 0; IO.cwd is its working
+# directory and IO.chdir changes it: after a change to "/" the directory is
+# "/", and a file opened by a relative path is found from there; a change
+# to a directory not there fails with ENOENT and changes nothing. IO.clock
+# is the wall clock: seconds past 2020, microseconds under a million.
+import Base
+
+def check(name: String, ok: Bool) -> IO(Unit):
+  match ok:
+    case True{}:
+      IO.print(name)
+    case False{}:
+      IO.die(Unit, 1, "FAIL " ++ name)
+
+def cwd_is(r: Result<&1, &1, U32 & String, String>, want: String, name: String) -> IO(Unit):
+  match r:
+    case Done{d}:
+      check(name, String.eq(d, want))
+    case Fail{e}:
+      IO.die(Unit, 1, "FAIL " ++ name)
+
+def chdir_ok(r: Result<&1, &1, U32 & String, Unit>, name: String) -> IO(Unit):
+  match r:
+    case Done{u}:
+      IO.print(name)
+    case Fail{e}:
+      IO.die(Unit, 1, "FAIL " ++ name)
+
+def chdir_fails(r: Result<&1, &1, U32 & String, Unit>, want: U32, name: String) -> IO(Unit):
+  match r:
+    case Done{u}:
+      IO.die(Unit, 1, "FAIL " ++ name)
+    case Fail{e}:
+      (code, msg) = e
+      check(name, U32.is_eq(code, want))
+
+def opened(r: Result<&1, &1, U32 & String, File>, name: String) -> IO(Unit):
+  match r:
+    case Done{f}:
+      do IO<Unit>:
+        IO.print(name)
+        File.close(f)
+    case Fail{e}:
+      IO.die(Unit, 1, "FAIL " ++ name)
+
+def clock_ok(t: U32 & U32) -> IO(Unit):
+  (s, us) = t
+  check("the clock is past 2020", Bool.and(U32.is_lt(1577836800, s), U32.is_lt(us, 1000000)))
+
+def main() -> IO(Unit):
+  do IO<Unit>:
+    pid : U32 <- IO.pid()
+    check("a pid", U32.is_lt(0, pid))
+    r : Result<&1, &1, U32 & String, Unit> <- IO.chdir("/")
+    chdir_ok(r, "changed to /")
+    d : Result<&1, &1, U32 & String, String> <- IO.cwd()
+    cwd_is(d, "/", "the directory is /")
+    f : Result<&1, &1, U32 & String, File> <- File.open("etc/hostname", "r")
+    opened(f, "a relative path opens from /")
+    r : Result<&1, &1, U32 & String, Unit> <- IO.chdir("/no/such/dir/here")
+    chdir_fails(r, 2, "a missing directory is ENOENT")
+    d : Result<&1, &1, U32 & String, String> <- IO.cwd()
+    cwd_is(d, "/", "the directory is still /")
+    t : U32 & U32 <- IO.clock()
+    clock_ok(t)
+
+#|a pid
+#|changed to /
+#|the directory is /
+#|a relative path opens from /
+#|a missing directory is ENOENT
+#|the directory is still /
+#|the clock is past 2020
