+#ifdef CID(Chan.call)
+
+// x onto chan as Chan.send_all puts it (a closed channel drops it, after
+// the lock), then back's next value as Chan.recv takes it, parked on back
+// until it comes: both in one hold of chan_lock.
+Term chan_call_run(Env e, Term* f, IoWork* w) {
+  io_hold(&chan_lock);
+  ChanRow* row  = chan_at(f[0]);
+  bool     kept = row != NULL && !row->shut;
+  if (kept) {
+    chan_put(e, row, f[1]);
+  }
+  Term x = chan_recv_locked(e, f + 2, w);
+  io_let(&chan_lock);
+  if (!kept) {
+    term_drop(e, f[1]);
+  }
+  return x;
+}
+
+static void __attribute__((constructor)) chan_call_use(void) {
+  io_eff(CID(Chan.call), chan_call_run);
+}
+
+#endif
