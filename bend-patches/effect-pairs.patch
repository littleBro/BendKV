@@ -114,3 +114,30 @@ static void __attribute__((constructor)) tcp_recv_raw_use(void) {
 }
 
 #endif
+
+#ifdef CID(TCP.post_recv_raw)
+
+static Term tcp_post_recv_raw_more(Env e, IoWork* w) {
+  return tcp_recv_with(e, w, tcp_post_recv_raw_more, io_raw);
+}
+
+// data's bytes to this loop's writer, as TCP.post hands them (a Char past
+// 255 posts nothing), then a recv as TCP.recv_raw's
+Term tcp_post_recv_raw_run(Env e, Term* f, IoWork* w) {
+  u64   room = str_len(e.mem, f[1]) + 1;
+  char* buf  = io_mem(malloc(room));
+  u64   len  = 0;
+  if (io_cbuf_in(e, f[1], &len, IO_RAW, &buf, &room) == NULL || len == 0) {
+    free(buf);
+  } else {
+    io_post((int)io_hand_v(f[0]), buf, len);
+  }
+  Term g[2] = { f[0], f[2] };
+  return tcp_recv_start(e, g, w, tcp_post_recv_raw_more);
+}
+
+static void __attribute__((constructor)) tcp_post_recv_raw_use(void) {
+  io_eff(CID(TCP.post_recv_raw), tcp_post_recv_raw_run);
+}
+
+#endif
diff --git a/bend2/effs/tcp_recv.js b/bend2/effs/tcp_recv.js
index 86c3d2d..8087b0d 100644
--- a/bend2/effs/tcp_recv.js
+++ b/bend2/effs/tcp_recv.js
@@ -48,6 +48,39 @@ function tcp_recv_raw(socket, max, k) {
   return tcp_recv_with(socket, max, k, io_raw);
 }
 
+// TCP.post's send (one loop, no writer: the bytes go out as TCP.send_raw
+// sends them; a Char past 255 sends nothing), then tcp_recv_raw.
+function tcp_post_recv_raw(socket, data, max, k) {
+  let b = new Uint8Array(data.length);
+  for (let i = 0; i < data.length; i += 1) {
+    const c = data.charCodeAt(i);
+    if (c > 255) {
+      b = new Uint8Array(0);
+      break;
+    }
+    b[i] = c;
+  }
+  const sys = io_sys();
+  const again = sys.mac ? 35 : 11;
+  const go = (at) => {
+    while (at < b.length) {
+      const part = b.subarray(at);
+      const n = Number(sys.send(socket, sys.ptr(part), part.length, 0));
+      if (n < 0) {
+        if (sys.errno() === again) {
+          io_park_on(socket, true, k, () => go(at));
+          return undefined;
+        }
+        break;
+      }
+      at += n;
+    }
+    return tcp_recv_raw(socket, max, k);
+  };
+  return go(0);
+}
+
 io_eff(CID(TCP.recv), tcp_recv);
 io_eff(CID(TCP.recv_raw), tcp_recv_raw);
 io_eff(CID(TCP.recv_bytes), tcp_recv_bytes);
+io_eff(CID(TCP.post_recv_raw), tcp_post_recv_raw);
diff --git a/tests/io/chan_call.bend b/tests/io/chan_call.bend
new file mode 100644
index 0000000..85e0331
--- /dev/null
+++ b/tests/io/chan_call.bend
@@ -0,0 +1,50 @@
+# io (io_chan_call): Chan.call sends a value and waits for the answer on a
+# channel of its own, in one step. An actor doubles what it gets and
+# answers on the channel each request names. Three calls get 2, 4 and 6.
+# A call to a closed channel drops its value and waits on back: a value
+# sent there first is its answer.
+import Base
+
+type Ask is Data:
+  Ask{n: U32, back: Chan(U32)}
+
+@unsafe
+def actor(+c: Chan(Ask)) -> IO(Unit):
+  do IO<Unit>:
+    m : Maybe<&1, Ask> <- Chan.recv(Ask, c)
+    actor.go(c, m)
+
+@unsafe
+def actor.go(+c: Chan(Ask), m: Maybe<&1, Ask>) -> IO(Unit):
+  match m:
+    case None{}:
+      IO.pure(Unit, Unit{})
+    case Some{Ask{n, back}}:
+      do IO<Unit>:
+        ok : Bool <- Chan.send(U32, back, (n * 2 : U32))
+        actor(c)
+
+def got(m: Maybe<&1, U32>) -> String:
+  match m:
+    case None{}:
+      "none"
+    case Some{x}:
+      U32.show(x)
+
+@unsafe
+def main() -> IO(Unit):
+  do IO<Unit>:
+    +c : Chan(Ask) <- Chan.new(Ask, 4)
+    +b : Chan(U32) <- Chan.new(U32, 1)
+    Unit <- IO.spawn(Unit, actor(c))
+    x : Maybe<&1, U32> <- Chan.call(Ask, U32, c, Ask{1, b}, b)
+    y : Maybe<&1, U32> <- Chan.call(Ask, U32, c, Ask{2, b}, b)
+    z : Maybe<&1, U32> <- Chan.call(Ask, U32, c, Ask{3, b}, b)
+    IO.print(got(x) ++ " " ++ got(y) ++ " " ++ got(z))
+    Unit <- Chan.close(Ask, c)
+    ok : Bool <- Chan.send(U32, b, 7)
+    w : Maybe<&1, U32> <- Chan.call(Ask, U32, c, Ask{4, b}, b)
+    IO.print(got(w))
+
+#|2 4 6
+#|7
diff --git a/tests/io/tcp_post_recv.bend b/tests/io/tcp_post_recv.bend
new file mode 100644
index 0000000..188fc69
--- /dev/null
+++ b/tests/io/tcp_post_recv.bend
@@ -0,0 +1,104 @@
+# io (io_tcp_post_recv): TCP.post_recv_raw posts bytes and reads at once,
+# as TCP.post then TCP.recv_raw. A server answers each read with "re:"
+# and what it read, and reads on, in one step each time; a client asks
+# "ping" and "bye" the same way and prints the two answers.
+import Base
+
+def text(m: Socket & Result<&1, &1, U32 & String, String>) -> String:
+  (s, r) = m
+  match r:
+    case Done{x}:
+      x
+    case Fail{e}:
+      "fail"
+
+@unsafe
+def serve(m: Socket & Result<&1, &1, U32 & String, String>) -> IO(Unit):
+  (s, r) = m
+  match r:
+    case Done{x}:
+      serve.on(s, x)
+    case Fail{e}:
+      Socket.close(s)
+
+@unsafe
+def serve.on(s: Socket, x: String) -> IO(Unit):
+  match x:
+    case SNil{}:
+      Socket.close(s)
+    case SCon{c, t}:
+      do IO<Unit>:
+        m : Socket & Result<&1, &1, U32 & String, String> <- TCP.post_recv_raw(s, "re:" ++ SCon{c, t}, 64)
+        serve(m)
+
+@unsafe
+def server.go(p: Listener & Result<&1, &1, U32 & String, Socket>) -> IO(Unit):
+  (l2, ar) = p
+  do IO<Unit>:
+    a : Socket <- IO.pass(Socket, ar)
+    m : Socket & Result<&1, &1, U32 & String, String> <- TCP.recv_raw(a, 64)
+    Unit <- serve(m)
+    Listener.close(l2)
+
+@unsafe
+def server(l: Listener) -> IO(Unit):
+  do IO<Unit>:
+    p : Listener & Result<&1, &1, U32 & String, Socket> <- TCP.accept(l)
+    server.go(p)
+
+@unsafe
+def client.bye(m: Socket & Result<&1, &1, U32 & String, String>) -> IO(Unit):
+  (s, r) = m
+  match r:
+    case Done{x}:
+      do IO<Unit>:
+        n : Socket & Result<&1, &1, U32 & String, String> <- TCP.post_recv_raw(s, "bye", 64)
+        client.end(x, n)
+    case Fail{e}:
+      Socket.close(s)
+
+@unsafe
+def client.end(first: String, m: Socket & Result<&1, &1, U32 & String, String>) -> IO(Unit):
+  (s, r) = m
+  match r:
+    case Done{x}:
+      do IO<Unit>:
+        Unit <- IO.print(first ++ " " ++ x)
+        Socket.close(s)
+    case Fail{e}:
+      Socket.close(s)
+
+def tcp_retry(port: U32, r: Result<&1, &1, U32 & String, Listener>, rest: IO(Listener & U32)) ->
+  IO(Listener & U32):
+  match r:
+    case Done{l}:
+      IO.pure(Listener & U32, (l, port))
+    case Fail{e}:
+      rest
+
+def tcp_listen_any(tries: Nat, +port: U32) -> IO(Listener & U32):
+  match tries:
+    case 0n:
+      IO.die(Listener & U32, 1, "no free tcp port")
+    case 1n+t:
+      rest = tcp_listen_any(t, (port + 1 : U32))
+      do IO<Listener & U32>:
+        r : Result<&1, &1, U32 & String, Listener> <- TCP.listen("127.0.0.1", port)
+        tcp_retry(port, r, rest)
+
+@unsafe
+def main_go(b: Listener & U32) -> IO(Unit):
+  (l, port) = b
+  do IO<Unit>:
+    Unit <- IO.spawn(Unit, server(l))
+    c : Socket <- IO.try(Socket, TCP.connect("127.0.0.1", port))
+    m : Socket & Result<&1, &1, U32 & String, String> <- TCP.post_recv_raw(c, "ping", 64)
+    client.bye(m)
+
+@unsafe
+def main() -> IO(Unit):
+  do IO<Unit>:
+    b : Listener & U32 <- tcp_listen_any(32n, 19977)
+    main_go(b)
+
+#|re:ping re:bye
