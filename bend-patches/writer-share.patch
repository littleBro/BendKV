 // closes the fd, after what was posted before.
-#define IO_POSTS 4096
+//
+// The loop also sends posts itself, sharing the sends with the writer by
+// how busy each is. Each measures the share of its time it works, in
+// windows of IO_UTIL_WIN ns: the loop all but its waits for events, the
+// writer its sends. A loop less busy than its writer by more than
+// IO_POST_SLACK points sends (the writer is the bottleneck: many
+// connections without a pipeline, where a send costs more than the
+// request); else it posts (with a pipeline the loop is the bottleneck, and
+// the writer's core pays for the sends). While the writer sleeps the loop
+// sends too (ringing it is a futex call, and it wakes up later), but after
+// IO_POST_SOLO such sends in a row its next post rings the writer: the
+// load is back. The loop sends a post only if the writer has sent all that
+// was posted to fd before (ends[fd], the ring index past fd's last post, is
+// not ahead of the writer's head), so fd's bytes stay in order; bytes the
+// socket does not take at once go to the writer.
+#define IO_POSTS      4096
+#define IO_POST_SOLO  4
+#define IO_POST_SLACK 10
+#define IO_UTIL_WIN   200000
+
+static _Thread_local u64 io_idle;
+static _Thread_local u64 io_win;
+static _Thread_local u32 io_util;
+
+// the loop's busy share in percent, a window at a time: io_idle is what
+// it waited for events in the window that started at io_win
+static void io_util_at(u64 now) {
+  u64 span = now - io_win;
+  if (span >= IO_UTIL_WIN) {
+    io_util = io_idle >= span ? 0 : (u32)(100 - io_idle * 100 / span);
+    io_win  = now;
+    io_idle = 0;
+  }
+}
+
+static void io_idle_since(u64 t0) {
+  u64 now  = io_tick();
+  io_idle += now - t0;
+  io_util_at(now);
+}
 
