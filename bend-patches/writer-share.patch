+// the writer's busy share in percent, a window at a time: busy is the time
+// its sends took in the window that started at win
+static void io_writer_util(IoWriter* W, u64 now, u64* win, u64* busy) {
+  u64 span = now - *win;
+  if (span >= IO_UTIL_WIN) {
+    __atomic_store_n(&W->util, (u32)(*busy >= span ? 100 : *busy * 100 / span), __ATOMIC_RELAXED);
+    *win  = now;
+    *busy = 0;
+  }
+}
