+# A walker that reads a tree (it calls itself, takes a tree, builds none
+# of its nodes) borrows it from a caller that owns it at its last use in
+# a tail call: the caller holds it, calls the walker and drops it after.
+# The tree here is shared (read three times), so a walker that owned it
+# would copy each node it reads, as keys did once fresh made all own its
+# tree; mirror rebuilds it and owns its own.
+import Base
+
+type T is Data:
+  Lf{}
+  Nd{k: Nat, l: T, r: T}
+
+def pow2(+d: Nat) -> Nat:
+  match d:
+    case 0n:
+      1n
+    case 1n+p:
+      +x = pow2(p)
+      Nat.add(x, x)
+
+# a complete tree of depth d whose keys, in order, are lo to lo + 2^d - 2
+def gen(+d: Nat, +lo: Nat) -> T:
+  match d:
+    case 0n:
+      Lf{}
+    case 1n+p:
+      +m = Nat.add(lo, Nat.sub(pow2(p), 1n))
+      Nd{m, gen(p, lo), gen(p, Nat.add(m, 1n))}
+
+# the keys of t in order, before acc
+def keys(+t: T, acc: List<&2, Nat>) -> List<&2, Nat>:
+  match t:
+    case Lf{}:
+      acc
+    case Nd{+k, +l, +r}:
+      keys(l, k <> keys(r, acc))
+
+# a caller that owns its tree and passes it at its last use, in a tail call
+def all(t: T) -> List<&2, Nat>:
+  keys(t, Nil{})
+
+# a caller that gives all a tree made for it, in a tail call: all owns its
+# tree for every caller
+def fresh(+d: Nat) -> List<&2, Nat>:
+  all(gen(d, 0n))
+
+def mirror(t: T) -> T:
+  match t:
+    case Lf{}:
+      Lf{}
+    case Nd{k, l, r}:
+      Nd{k, mirror(r), mirror(l)}
+
+def sum(xs: List<&2, Nat>, +acc: Nat) -> Nat:
+  match xs:
+    case Nil{}:
+      acc
+    case x <> rest:
+      sum(rest, Nat.add(acc, x))
+
+def head(xs: List<&2, Nat>) -> Nat:
+  match xs:
+    case Nil{}:
+      0n
+    case x <> rest:
+      x
+
+def line(+xs: List<&2, Nat>) -> String:
+  +n = List.length(&2, Nat, xs)
+  String.append(Nat.show(n), String.append(" ", String.append(Nat.show(head(xs)), String.append(" ", Nat.show(sum(xs, 0n))))))
+
+def main() -> IO(Unit):
+  +t = gen(10n, 0n)
+  a = all(t)
+  b = all(t)
+  c = all(mirror(t))
+  d = all(gen(3n, 5n))
+  e = fresh(4n)
+  IO.print(String.append(line(a), String.append("\n", String.append(line(b), String.append("\n", String.append(line(c), String.append("\n", String.append(line(d), String.append("\n", line(e))))))))))
+
