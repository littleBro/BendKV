+// A walker that reads: a def that calls itself, whose parameter i is a
+// tree (a datatype with a node of two or more subtrees of its own type),
+// and that builds none of that datatype's nodes. A caller that owns what it
+// passes there at its last use lends it and drops it after the call
+// (tail_lends), rather than give it: a walker that owned its tree would
+// own each node it reads, and copy each node another value shares, as a
+// persistent tree's versions share their subtrees; one that rebuilds the
+// tree takes its nodes over.
+function walk_reads(k: Name, i: number): boolean {
+  return memo(FL.rdrs, k + "~" + i, () => {
+    if (!done_live(FL.book.tlds[k])) {
+      return false;
+    }
+    const adt = ty_adt(fun_of(k).live[i]?.[2] ?? null);
+    const dt = adt && FL.book.tlds[adt.k];
+    if (dt?.$ !== "ADT" || !dt.c.some((c) => tele_unbind(c.T).doms
+      .filter(([, , A]) => ty_adt(A)?.k === adt!.k).length >= 2)) {
+      return false;
+    }
+    let self = false;
+    let builds = false;
+    term_any(fun_of(k).h!, (s) => {
+      self ||= term_spine(s).k === k;
+      builds ||= s.$ === "Ctr" && Bend.book_fam(FL.book, s.k) === adt!.k;
+      return false;
+    });
+    return self && !builds;
+  });
+}
+
+// A tail call that passes a walker that reads a value the caller owns, at
+// its last use, is held instead (r = f(..); r), so that the walker borrows
+// it; not one into the caller's own loop, whose tail calls stay jumps.
+function tail_lends(sc: Scope, ck: Spine): boolean {
+  const k = ck.k!;
+  const sd = sc.seg.def.split("$")[0];
+  if (k === sd || k === sc.def || loop_of(sd).includes(k)
+    || loop_of(sc.def).includes(k)) {
+    return false;
+  }
+  const brw = brw_of(k);
+  const xs = ck.xs.map(term_strip);
+  return xs.some((x, i) => {
+    if (x.$ !== "Var" || !brw[i] || !walk_reads(k, i)) {
+      return false;
+    }
+    const p = probe_of(x);
+    const bd = sc.uses.get(p);
+    return bd !== undefined && !val_brw(sc, bd.val)
+      && xs.filter((y) => y.$ === "Var" && probe_of(y) === p).length === 1;
+  });
+}
