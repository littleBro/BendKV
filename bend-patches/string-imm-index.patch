@@ -0,0 +1,14 @@
+# String.code_at of Strings short enough to live in one word (up to six
+# bytes, made here by slices): each byte by its index, and 2^32-1 past
+# the end, as for any String. "123" at 0, 2 and 3; "abcdef" at 5 and 6;
+# "" at 0.
+import Base
+
+def main() -> String:
+  +s = "x123" ++ "zabcdef"
+  +a = String.slice(s, 1n, 3n)
+  +b = String.slice(s, 5n, 6n)
+  +c = String.slice(s, 0n, 0n)
+  U32.show(String.code_at(a, 0n)) ++ "," ++ U32.show(String.code_at(a, 2n)) ++ "," ++ U32.show(String.code_at(a, 3n)) ++ "," ++ U32.show(String.code_at(b, 5n)) ++ "," ++ U32.show(String.code_at(b, 6n)) ++ "," ++ U32.show(String.code_at(c, 0n))
+
+#|"49,51,4294967295,102,4294967295,4294967295"
