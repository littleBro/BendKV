+// String.hash_at: String.hash of the n chars of s from index i on
+FAR u64 str_hash_at(u64* H, Term s, u64 i, u64 n) {
+  u32       h = 2166136261u;
+  u64       m;
+  const u8* q = str_flat_at(H, s, i, &m);
+  if (q != NULL) {
+    for (u64 k = 0; k < n && k < m; k += 1) {
+      h = (h ^ q[k]) * 16777619u;
+    }
+    return h;
+  }
+  for (u64 k = 0; k < n; k += 1) {
+    u64 c = str_code_at(H, s, i + k);
+    if (c == 4294967295u) {
+      break;
+    }
+    h = (h ^ (u32)c) * 16777619u;
+  }
+  return h;
+}
+
+// String.digits_at: how many decimal digits run in s from index i on
+INLINE u64 str_digits_at(u64* H, Term s, u64 i) {
+  u64       m;
+  const u8* q = str_flat_at(H, s, i, &m);
+  u64       k = 0;
+  if (q != NULL) {
+    while (k < m && (u8)(q[k] - '0') <= 9) {
+      k += 1;
+    }
+    return k;
+  }
+  while (str_code_at(H, s, i + k) - 48 <= 9) {
+    k += 1;
+  }
+  return k;
+}
+
+FAR u64 str_dec_line_far(u64* H, Term s, u64 i) {
+  u64 k = 0;
+  u64 v = 0;
+  u64 c;
+  for (; (c = str_code_at(H, s, i + k)) - 48 <= 9; k += 1) {
+    if (k == 10) {
+      return 0;
+    }
+    v = v * 10 + (c - 48);
+  }
+  if (c == 4294967295u) {
+    return 1;
+  }
+  if (k == 0 || c != 13) {
+    return 0;
+  }
+  u64 d = str_code_at(H, s, i + k + 1);
+  return d == 4294967295u ? 1 : d == 10 ? v << 4 | (k + 2) : 0;
+}
+
+// String.dec_line_at as one word: the number of the line of 1 to 10
+// decimal digits at index i of s over 4 bits of the line's length with its
+// "\r\n" (3 to 12); a word of 0 when s holds no such line there, of 1 when
+// s ends before that is known
+INLINE u64 str_dec_line_at(u64* H, Term s, u64 i) {
+  u64       m;
+  const u8* q = str_flat_at(H, s, i, &m);
+  u64       k = 0;
+  u64       v = 0;
+  if (q == NULL) {
+    return str_dec_line_far(H, s, i);
+  }
+  for (; k < m && (u8)(q[k] - '0') <= 9; k += 1) {
+    if (k == 10) {
+      return 0;
+    }
+    v = v * 10 + (u8)(q[k] - '0');
+  }
+  if (k + 2 <= m) {
+    return k > 0 && q[k] == '\r' && q[k + 1] == '\n' ? v << 4 | (k + 2) : 0;
+  }
+  return k < m && (k == 0 || q[k] != '\r') ? 0 : 1;
+}
+
+// String.dec_at: the number the n chars of s from index i on spell in
+// decimal, each its code point less 48, as Nats (nat_chk)
+INLINE u64 str_dec_at(Env e, Term s, u64 i, u64 n) {
+  u64       m;
+  const u8* q = str_flat_at(e.mem, s, i, &m);
+  u64       v = 0;
+  if (q != NULL) {
+    for (u64 k = 0; k < n && k < m; k += 1) {
+      v = nat_chk(e, v * 10 + (u32)(q[k] - 48u));
+    }
+    return v;
+  }
+  for (u64 k = 0; k < n; k += 1) {
+    u64 c = str_code_at(e.mem, s, i + k);
+    if (c == 4294967295u) {
+      break;
+    }
+    v = nat_chk(e, v * 10 + (u32)((u32)c - 48u));
+  }
+  return v;
+}
