   String.take(String.drop(s, i), n)
 
+# String.hash of s's n chars from index i on: the C runtime reads them
+# where they lie, without the slice
+def String.hash_at(s: String, i: Nat, n: Nat) -> U32:
+  String.hash(String.slice(s, i, n))
+
+def String.digits.go(s: String, +n: Nat) -> Nat:
+  match s:
+    case SNil{}:
+      n
+    case SCon{Chr{x}, t}:
+      Bool.pick(Nat, U32.is_le(U32.sub(x, 48), 9), String.digits.go(t, 1n+n), n)
+
+# how many decimal digits ('0' to '9') run in s from index i on
+def String.digits_at(s: String, i: Nat) -> Nat:
+  String.digits.go(String.drop(s, i), 0n)
+
+def String.dec_line.cr(cr: Bool, s: String, n: Nat) -> Nat:
+  match cr s:
+    case False{} _:
+      0n
+    case True{} SNil{}:
+      1n
+    case True{} SCon{Chr{x}, _}:
+      Bool.pick(Nat, U32.is_eq(x, 10), 2n+n, 0n)
+
+def String.dec_line.end(s: String, n: Nat) -> Nat:
+  match s n:
+    case SNil{} _:
+      1n
+    case SCon{_, _} 0n:
+      0n
+    case SCon{Chr{x}, t} 1n+k:
+      String.dec_line.cr(U32.is_eq(x, 13), t, 1n+k)
+
+def String.dec_line.of(ok: Bool, v: Nat, r: Nat) -> Nat & Nat:
+  match ok r:
+    case False{} _:
+      (0n, 0n)
+    case True{} 0n:
+      (0n, 0n)
+    case True{} 1n:
+      (0n, 1n)
+    case True{} 2n+k:
+      (v, 2n+k)
+
+def String.dec.go(n: Nat, s: String, acc: Nat) -> Nat:
+  match n s:
+    case 0n _:
+      acc
+    case 1n+m SNil{}:
+      acc
+    case 1n+m SCon{Chr{x}, t}:
+      String.dec.go(m, t, Nat.add(Nat.mul(acc, 10n), U32.to_nat(U32.sub(x, 48))))
+
+# the number s's n chars from index i on spell in decimal (fewer where s
+# ends first): each adds its code point less 48, the value of a digit
+def String.dec_at(s: String, i: Nat, n: Nat) -> Nat:
+  String.dec.go(n, String.drop(s, i), 0n)
+
+# the line of 1 to 10 decimal digits at index i of s, ended by "\r\n": its
+# number and its length with the "\r\n" (3 to 12); a length of 0 when s
+# holds no such line there (no digit, more than 10, another char), of 1
+# when s ends before that is known, each with a number of 0
+def String.dec_line_at(+s: String, +i: Nat) -> Nat & Nat:
+  +n = String.digits_at(s, i)
+  String.dec_line.of(Nat.is_le(n, 10n), String.dec_at(s, i, n), String.dec_line.end(String.drop(s, Nat.add(i, n)), n))
+
 def String.get(s: String, n: Nat) -> Maybe<&2, Char>:
   match s n:
     case SNil{} _:
