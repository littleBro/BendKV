+// A field may be raw in a shared node when the program seals lazily
+// (SEAL_LAZY, a CPU-only program): its constructors skip rfc_seal, so a
+// value pays for a redirect only once it is shared. The first co-owner to
+// take the node seals the field in place: a redirect of count 2 (the
+// node's and its own), installed by CAS, as other co-owners may race to
+// seal the same field; a loser frees its redirect and bumps the winner's.
+// Sealed, a field never changes again, so ctr_take reads it back after
+// the fade and only then lets the node go.
 OUTLINE void span_fade(Env e, Term t, u64 src, u32 n) {
   for (u32 j = 0; j < n; j += 1) {
+#if SEAL_LAZY && !DEVICE
+    Term f = atomic_load_explicit((_Atomic u64*)&e.mem[src + j],
+      memory_order_acquire);
+#else
     Term f = e.mem[src + j];
+#endif
     if (term_rfc(f)) {
       rfc_bump(e, term_loc(f), 1);
     } else if (!term_triv(f)) {
+#if SEAL_LAZY && !DEVICE
+      if (term_tag(f) == TAG_CTR) {
+        Term w = rfc_wrap(e, f, 2);
+        Term x = f;
+        if (!atomic_compare_exchange_strong_explicit(
+            (_Atomic u64*)&e.mem[src + j], &x, w,
+            memory_order_acq_rel, memory_order_acquire)) {
+          heap_free(e, 0, term_loc(w));
+          rfc_bump(e, term_loc(x), 1);
+        }
+      } else {
+        err_post(e.mem, ERR_RFCS);
+      }
+#else
       err_post(e.mem, ERR_RFCS);
+#endif
     }
   }
+#if !(SEAL_LAZY && !DEVICE)
   term_drop(e, t);
+#endif
 }
 
