+# FNV-1a over the code points: a 32-bit hash for tables keyed by Strings
+def String.hash.go(s: String, h: U32) -> U32:
+  match s:
+    case SNil{}:
+      h
+    case SCon{c, t}:
+      String.hash.go(t, U32.mul(U32.xor(h, Char.to_u32(c)), 16777619))
+
+def String.hash(s: String) -> U32:
+  String.hash.go(s, 2166136261)
+
+# the code point of s's char at index i, or 4294967295 past its end
+def String.code_at(s: String, i: Nat) -> U32:
+  match s i:
+    case SNil{} _:
+      4294967295
+    case SCon{Chr{x}, t} 0n:
+      x
+    case SCon{h, t} 1n+p:
+      String.code_at(t, p)
+
+def String.find.go(s: String, +c: Char, +i: Nat, +k: Nat) -> Nat:
+  match s:
+    case SNil{}:
+      k
+    case SCon{h, t}:
+      Bool.pick(Nat, Bool.and(Nat.is_le(i, k), Char.is_eq(h, c)), k, String.find.go(t, c, i, 1n+k))
+
+# the index of the first c in s at or after index i, or s's length
+def String.find(s: String, +c: Char, i: Nat) -> Nat:
+  String.find.go(s, c, i, 0n)
