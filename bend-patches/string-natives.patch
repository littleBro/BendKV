+
+// A recv's buffer, kept for the next recv on this thread: one malloc and
+// free of the max (64 KiB, say) per recv let glibc trim and regrow the
+// heap's top (brk), and fault its pages back in.
+static _Thread_local char* tcp_rbuf;
+static _Thread_local u64   tcp_rcap;
+
+static char* tcp_rbuf_take(u64 n) {
+  if (tcp_rbuf != NULL && tcp_rcap >= n) {
+    char* p  = tcp_rbuf;
+    tcp_rbuf = NULL;
+    return p;
+  }
+  return io_mem(malloc((size_t)n));
+}
+
+static void tcp_rbuf_give(char* p, u64 n) {
+  if (tcp_rbuf == NULL || tcp_rcap < n) {
+    free(tcp_rbuf);
+    tcp_rbuf = p;
+    tcp_rcap = n;
+  } else {
+    free(p);
+  }
+}
