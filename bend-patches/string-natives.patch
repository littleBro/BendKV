+# String by index, and String ops the C lane specializes: code_at, find
+# and slice on a String of more than one piece; eq and ++ with a literal
+# on either side; Nat.show before a String; to_upper of a String no one
+# else holds and of one that is shared
+import Base
+
+def show_find(+s: String, +c: Char, i: Nat) -> String:
+  Nat.show(String.find(s, c, i))
+
+def flag(b: Bool) -> String:
+  match b:
+    case True{}:
+      "T"
+    case False{}:
+      "F"
+
+def main() -> String:
+  +s = "hello\r\nworld\r\n" ++ "tail"
+  +a = U32.show(String.code_at(s, 0n)) ++ "," ++ U32.show(String.code_at(s, 5n)) ++ "," ++ U32.show(String.code_at(s, 17n)) ++ "," ++ U32.show(String.code_at(s, 18n))
+  +b = show_find(s, '\r', 0n) ++ "," ++ show_find(s, '\r', 6n) ++ "," ++ show_find(s, 'z', 0n) ++ "," ++ show_find(s, 'w', 7n) ++ "," ++ show_find(s, 'w', 8n)
+  +c = String.slice(s, 7n, 5n) ++ "|" ++ String.slice(s, 12n, 10n) ++ "|" ++ String.slice(s, 30n, 3n) ++ "|" ++ String.slice(s, 0n, 0n)
+  +w = String.slice(s, 7n, 5n)
+  +d = flag(String.eq(w, "world")) ++ flag(String.eq("world", w)) ++ flag(String.eq(w, "worl")) ++ flag(String.eq(w, "")) ++ flag(String.eq(String.slice(s, 0n, 0n), ""))
+  +e = Nat.show(String.length(w)) ++ "/" ++ Nat.show(12345678n) ++ "\r\n" ++ w
+  +u = String.to_upper(String.slice(s, 0n, 5n)) ++ "," ++ String.to_upper(w) ++ "," ++ w
+  a ++ ";" ++ b ++ ";" ++ c ++ ";" ++ d ++ ";" ++ e ++ ";" ++ u
+
+#|"104,13,108,4294967295;5,12,18,7,18;world|\r\ntail||;TTFFT;5/12345678\r\nworld;HELLO,WORLD,world"
