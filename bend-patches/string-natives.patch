+static u64 str_sole_last(u64* H, Term s) {
+  u64 last = 0;
+  for (Term t = s; !str_nil(t); t = H[last + 1]) {
+    if (str_imm(t) || term_rfc(t) || term_loc(t) < HEAP_OFF) {
+      return 0;
+    }
+    last = term_loc(t);
+  }
+  return last;
+}
+
+// s's first len chars, all below 256, before tail; up maps a..z to A..Z.
+// The first chunk keeps room bytes below them for str_prepend to fill.
+static Term str_copy(Env e, Term s, u64 len, Term tail, u32 up, u32 room) {
+  if (len == 0) {
+    return tail;
+  }
+  if (len <= STR_IMM_MAX && room == 0 && str_nil(tail)) {
+    u8 b[STR_IMM_MAX];
+    str_put(e.mem, s, b, len);
+    for (u32 q = 0; up && q < len; q += 1) {
+      b[q] -= (u8)((b[q] >= 97 && b[q] <= 122) << 5);
+    }
+    return str_imm_make(b, (u32)len);
+  }
+  u64*   H    = e.mem;
+  u32    full = 4u << STR_MAX;
+  u64    nch  = (len + full - 1) / full;
+  Term   out  = tail;
+  u64    prev = 0;
+  u32    i    = 0;
+  StrRun r;
+  str_run(H, s, &r);
+  for (u64 k = 0; k < nch; k += 1) {
+    u32  m  = (u32)(k == 0 ? len - (nch - 1) * full : full);
+    u32  c  = str_cls_for(k == 0 && m + room < full ? m + room : m);
+    u32  at = (4u << c) - m;
+    Term ch = str_chunk(e, c, at, tail);
+    u64  nd = term_loc(ch);
+    u8*  d  = str_mem(H, H[nd]) + at;
+    for (u32 j = 0; j < m;) {
+      u32 w = r.n - i < m - j ? r.n - i : m - j;
+      if (r.p != NULL) {
+        memcpy(d + j, r.p + i, w);
+      } else {
+        d[j] = (u8)r.c;
+      }
+      for (u32 q = j; up && q < j + w; q += 1) {
+        d[q] -= (u8)((d[q] >= 97 && d[q] <= 122) << 5);
+      }
+      j += w;
+      i += w;
+      if (i == r.n) {
+        str_run(H, r.t, &r);
+        i = 0;
+      }
+    }
+    if (prev != 0) {
+      H[prev + 1] = ch;
+    } else {
+      out = ch;
+    }
+    prev = nd;
+  }
+  return out;
+}
+
+// s's first len chars before tail, any char
+static Term str_copy_wide(Env e, Term s, u64 len, Term tail, u32 up) {
+  u32    one[64];
+  u32*   cs = len <= 64 ? one : (u32*)malloc(len * sizeof(u32));
+  u64    k  = 0;
+  StrRun r;
+  if (cs == NULL) {
+    err_post(e.mem, ERR_HEAP);
+    return tail;
+  }
+  for (Term t = s; k < len && str_run(e.mem, t, &r); t = r.t) {
+    for (u32 j = 0; j < r.n && k < len; j += 1) {
+      u32 c = r.p != NULL ? r.p[j] : r.c;
+      cs[k++] = up && c >= 97 && c <= 122 ? c - 32 : c;
+    }
+  }
+  while (k > 0) {
+    k -= 1;
+    tail = str_cons(e, cs[k], tail);
+  }
+  if (cs != one) {
+    free(cs);
+  }
+  return tail;
+}
+
+INLINE Term str_copy_any(Env e, Term s, u64 max, Term tail, u32 up) {
+  u32 wide = 0;
+  u64 len  = str_scan(e.mem, s, max, &wide);
+  return wide ? str_copy_wide(e, s, len, tail, up)
+    : str_copy(e, s, len, tail, up, 0);
+}
+
+// the room below a sole chunk b's bytes (str_cons writes there); 0 for
+// anything else
+INLINE u32 str_room(u64* H, Term b) {
+  if ((b >> 40) != STR_KEY) {
+    return 0;
+  }
+  Term bb = H[term_loc(b)];
+  return (bb >> 56) == TAG_BUF ? str_pos(bb) : 0;
+}
+
+// moves a sole chunk b's start len bytes down into its room; where they go
+INLINE u8* str_room_take(u64* H, Term b, u32 len) {
+  u64  n  = term_loc(b);
+  Term bb = H[n];
+  u32  p  = str_pos(bb) - len;
+  H[n] = str_at(bb, p);
+  return str_mem(H, bb) + p;
+}
+
+// the room a chunk that str_prepend starts keeps: what follows a String
+// being built from its end (a reply, a batch of replies) goes there
+#define STR_ROOM 256
+
+// s's chars before b, which s gives up: in the room of a sole chunk b if
+// they fit, as str_cons writes one, else in a new chunk
+static Term str_prepend(Env e, Term s, Term b) {
+  u64* H    = e.mem;
+  u32  wide = 0;
+  u64  len  = str_scan(H, s, ~0ull, &wide);
+  Term out  = 0;
+  if (!wide && (b >> 40) == STR_KEY) {
+    u64  n  = term_loc(b);
+    Term bb = H[n];
+    u32  p  = str_pos(bb);
+    if ((bb >> 56) == TAG_BUF && len <= p) {
+      str_put(H, s, (u8*)(H + term_loc(bb)) + p - len, len);
+      H[n] = str_at(bb, p - (u32)len);
+      out  = b;
+    }
+  }
+  if (out == 0) {
+    out = wide ? str_copy_wide(e, s, len, b, 0)
+      : str_copy(e, s, len, b, 0, STR_ROOM);
+  }
+  term_sink(e, s);
+  return out;
+}
+
+// a's nodes no one shares (on the heap, down from a) keep their bytes and
+// take b, after what follows them (a shared or static rest) went before it
+FAR Term str_append_far(Env e, Term a, Term b) {
+  u64* H    = e.mem;
+  u64  last = 0;
+  Term t    = a;
+  while (!str_nil(t) && !str_imm(t) && !term_rfc(t)
+    && term_loc(t) >= HEAP_OFF) {
+    last = term_loc(t);
+    t    = H[last + 1];
+  }
+  if (!str_nil(t)) {
+    b = str_prepend(e, t, b);
+  }
+  if (last == 0) {
+    return b;
+  }
+  H[last + 1] = b;
+  return a;
+}
+
+// n bytes from s to d, apart: up to 16 as two overlapping words or
+// halves, not a call
+INLINE void str_mov(u8* d, const u8* s, u64 n) {
+  if (n > 16) {
+    memcpy(d, s, n);
+  } else if (n >= 8) {
+    u64 x;
+    u64 y;
+    memcpy(&x, s, 8);
+    memcpy(&y, s + n - 8, 8);
+    memcpy(d, &x, 8);
+    memcpy(d + n - 8, &y, 8);
+  } else if (n >= 4) {
+    u32 x;
+    u32 y;
+    memcpy(&x, s, 4);
+    memcpy(&y, s + n - 4, 4);
+    memcpy(d, &x, 4);
+    memcpy(d + n - 4, &y, 4);
+  } else if (n > 0) {
+    u8 x = s[0];
+    u8 y = s[n >> 1];
+    u8 z = s[n - 1];
+    d[0]      = x;
+    d[n >> 1] = y;
+    d[n - 1]  = z;
+  }
+}
+
+// an a that fits in b's room goes there, and b stays one chunk: a chunk's
+// one run or a few cells (a literal), the cases a reply is built of
+INLINE Term str_append(Env e, Term a, Term b) {
+  u64* H    = e.mem;
+  u32  room = str_room(H, b);
+  if (room != 0 && !str_nil(a)) {
+    u8*    d = NULL;
+    StrRun r;
+    if (term_tag(a) == 0 || str_buf(a)) {
+      str_run(H, a, &r);
+      if (str_nil(r.t) && r.n <= room) {
+        d = str_room_take(H, b, r.n);
+        str_mov(d, r.p, r.n);
+      }
+    } else {
+      u8   tmp[16];
+      u32  len = 0;
+      Term t   = a;
+      while (len < 16 && !str_nil(t) && term_tag(t) != 0 && !str_buf(t)) {
+        u64 n = str_node(H, t);
+        if (H[n] > 255) {
+          break;
+        }
+        tmp[len++] = (u8)H[n];
+        t = H[n + 1];
+      }
+      if (str_nil(t) && len <= room) {
+        d = str_room_take(H, b, len);
+        str_mov(d, tmp, len);
+      }
+    }
+    if (d != NULL) {
+      term_sink(e, a);
+      return b;
+    }
+  }
+  return str_append_far(e, a, b);
+}
+
+// a ++ b for a literal a, whose bytes the compiler gives as s[0..n): in
+// b's room when they fit, else as str_append_far takes a static String
+INLINE Term str_append_lit(Env e, Term a, const char* s, u32 n, Term b) {
+  if (str_room(e.mem, b) >= n) {
+    memcpy(str_room_take(e.mem, b, n), s, n);
+    return b;
+  }
+  return str_append_far(e, a, b);
+}
+
+// a borrowed s (a view too), as the readers below; past NAT_IMM the
+// definition fail-stops building the successor
+FAR u64 str_len_far(u64* H, Term s) {
+  u32 wide = 0;
+  u64 len  = str_scan(H, s, ~0ull, &wide);
+  if (len > NAT_IMM) {
+    err_post(H, ERR_NATS);
+    return NAT_IMM;
+  }
+  return len;
+}
+
+// one chunk (or a view into one) is its run's length
+INLINE u64 str_len(u64* H, Term s) {
+  if (str_imm(s)) {
+    return str_imm_len(s);
+  }
+  if (!str_nil(s) && (term_tag(s) == 0 || str_buf(s))) {
+    u64 n = str_node(H, s);
+    if (str_nil(H[n + 1])) {
+      Term b = H[n];
+      return str_cap(b) - (term_tag(s) == 0 ? (u32)term_aux(s) : str_pos(b));
+    }
+  }
+  return str_len_far(H, s);
+}
+
+FAR u64 str_eq_far(u64* H, Term a, Term b) {
+  StrRun x;
+  StrRun y;
+  u32    i  = 0;
+  u32    j  = 0;
+  bool   eq = true;
+  bool   hx = str_run(H, a, &x);
+  bool   hy = str_run(H, b, &y);
+  while (eq && hx && hy) {
+    if (x.p != NULL && y.p != NULL) {
+      u32 w = x.n - i < y.n - j ? x.n - i : y.n - j;
+      eq = memcmp(x.p + i, y.p + j, w) == 0;
+      i += w;
+      j += w;
+    } else {
+      eq = (x.p != NULL ? x.p[i] : x.c) == (y.p != NULL ? y.p[j] : y.c);
+      i += 1;
+      j += 1;
+    }
+    if (i == x.n) {
+      hx = str_run(H, x.t, &x);
+      i  = 0;
+    }
+    if (j == y.n) {
+      hy = str_run(H, y.t, &y);
+      j  = 0;
+    }
+  }
+  return eq && !hx && !hy;
+}
+
+// a borrowed s's bytes when they are one run: an immediate's (copied to
+// *w), or one chunk's or a view's into one with nothing after it; else NULL
+INLINE const u8* str_one_run(u64* H, Term s, u64* w, u32* n) {
+  if (str_imm(s)) {
+    *w = s & STR_IMM_BYTES;
+    *n = str_imm_len(s);
+    return (const u8*)w;
+  }
+  if (!str_nil(s) && (term_tag(s) == 0 || str_buf(s))) {
+    u64 nd = str_node(H, s);
+    if (str_nil(H[nd + 1])) {
+      Term b = H[nd];
+      u32  p = term_tag(s) == 0 ? (u32)term_aux(s) : str_pos(b);
+      *n = str_cap(b) - p;
+      return str_mem(H, b) + p;
+    }
+  }
+  return NULL;
+}
+
+// two borrowed Strings of one run each (a key against a stored key) are
+// one compare of lengths and bytes
+INLINE u64 str_eq(u64* H, Term a, Term b) {
+  u64       wa;
+  u64       wb;
+  u32       m;
+  u32       n;
+  const u8* p = str_one_run(H, a, &wa, &m);
+  const u8* q = p == NULL ? NULL : str_one_run(H, b, &wb, &n);
+  if (q != NULL) {
+    return m == n && memcmp(p, q, m) == 0;
+  }
+  return str_eq_far(H, a, b);
+}
+
+// a borrowed s (a view too) against a literal lt, whose bytes the compiler
+// gives as l[0..n): one chunk's run is compared directly (inlined, so the
+// compare of n bytes is a few loads)
+static inline __attribute__((always_inline))
+u64 str_eq_lit(u64* H, Term s, const char* l, u32 n, Term lt) {
+  if (str_imm(s)) {
+    u64 w = s & STR_IMM_BYTES;
+    return str_imm_len(s) == n && memcmp(&w, l, n) == 0;
+  }
+  if (!str_nil(s) && (term_tag(s) == 0 || str_buf(s))) {
+    u64 nd = str_node(H, s);
+    if (str_nil(H[nd + 1])) {
+      Term b = H[nd];
+      u32  p = term_tag(s) == 0 ? (u32)term_aux(s) : str_pos(b);
+      return str_cap(b) - p == n && memcmp(str_mem(H, b) + p, l, n) == 0;
+    }
+  }
+  return str_eq(H, s, lt);
+}
+
+// against a literal of at most 6 bytes, which the compiler gives as the
+// immediate w it would be: an immediate s is equal to it if it is w
+INLINE u64 str_eq_imm(u64* H, Term s, Term w, Term lt) {
+  return str_imm(s) ? s == w : str_eq(H, s, lt);
+}
+
+FAR Term str_take_n(Env e, Term s, u64 n) {
+  StrRun r;
+  if (n > 0 && n <= STR_IMM_MAX && str_run(e.mem, s, &r) && r.p != NULL
+    && r.n >= n) {
+    return str_imm_make(r.p, (u32)n);
+  }
+  if (n > 0 && str_run(e.mem, s, &r) && r.p != NULL && r.n >= n) {
+    u32  c  = str_cls_for(n);
+    u32  at = (4u << c) - (u32)n;
+    Term ch = str_chunk(e, c, at, term_pak(CID(SNil), 0));
+    str_mov(str_mem(e.mem, e.mem[term_loc(ch)]) + at, r.p, n);
+    return ch;
+  }
+  return str_copy_any(e, s, n, term_pak(CID(SNil), 0), 0);
+}
+
+// as str_take_slow takes a char: a sole owner's nodes go to the free list,
+// a co-owner's chunk is taken as ctr_take does and pointed past n
+FAR Term str_drop_n(Env e, Term s, u64 n) {
+  Term t = s;
+  while (n > 0 && !str_nil(t)) {
+    if (str_imm(t)) {
+      return n < str_imm_len(t) ? str_imm_drop(t, (u32)n)
+        : term_pak(CID(SNil), 0);
+    }
+    Term f[2];
+    bool buf = str_buf(t);
+    u64  nd  = ctr_take(e, t, 2, f);
+    if (buf) {
+      Term b   = f[0];
+      u32  p   = str_pos(b);
+      u64  len = str_cap(b) - p;
+      if (n < len) {
+        nd = nd ? nd : heap_alloc(e, 1);
+        e.mem[nd]     = str_at(b, p + (u32)n);
+        e.mem[nd + 1] = f[1];
+        return term_ctr(STR_CID, nd);
+      }
+      n -= len;
+      if (term_rfc(b)) {
+        term_drop(e, b);
+      } else {
+        heap_free(e, buf_wcls(blk_cls(b)), term_loc(b));
+      }
+    } else {
+      n -= 1;
+    }
+    spare_free(e, cls_fit(2), nd);
+    t = f[1];
+  }
+  return t;
+}
+
+// a sole s's bytes and cells change in place
+FAR Term str_upper_far(Env e, Term s) {
+  u64* H    = e.mem;
+  bool sole = str_sole_last(H, s) != 0;
+  for (Term t = s; sole && !str_nil(t); t = H[term_loc(t) + 1]) {
+    sole = !str_buf(t) || (H[term_loc(t)] >> 56) == TAG_BUF;
+  }
+  if (!sole) {
+    Term out = str_copy_any(e, s, ~0ull, term_pak(CID(SNil), 0), 1);
+    term_sink(e, s);
+    return out;
+  }
+  StrRun r;
+  for (Term t = s; str_run(H, t, &r); t = r.t) {
+    u64 n = term_loc(t);
+    if (r.p == NULL) {
+      H[n] -= (H[n] >= 97 && H[n] <= 122) << 5;
+    }
+    for (u32 j = 0; r.p != NULL && j < r.n; j += 1) {
+      u8* q = (u8*)r.p + j;
+      *q -= (u8)((*q >= 97 && *q <= 122) << 5);
+    }
+  }
+  return s;
+}
+
+// the code point at index i of a borrowed s (a view too), 2^32-1 past its
+// end: one chunk's byte directly, else run by run
+FAR u64 str_code_at_far(u64* H, Term s, u64 i) {
+  StrRun r;
+  for (Term t = s; str_run(H, t, &r); t = r.t) {
+    if (i < r.n) {
+      return r.p != NULL ? r.p[i] : r.c;
+    }
+    i -= r.n;
+  }
+  return 4294967295u;
+}
+
+// a sole chunk with its own buffer: its bytes at H[buf][pos..cap), or NULL
+INLINE const u8* str_sole_run(u64* H, Term s, u32* n) {
+  if ((s >> 40) == STR_KEY) {
+    Term b = H[term_loc(s)];
+    if ((b >> 56) == TAG_BUF) {
+      u32 p = str_pos(b);
+      *n = str_cap(b) - p;
+      return (const u8*)(H + term_loc(b)) + p;
+    }
+  }
+  return NULL;
+}
+
+// a sole chunk with its own buffer, and nothing after it, in place; an
+// immediate is a new one
+INLINE Term str_upper(Env e, Term s) {
+  if (str_imm(s)) {
+    u64 w = s;
+    for (u32 i = 0; i < str_imm_len(s); i += 1) {
+      u32 c = (u8)(s >> (8 * i));
+      w -= (u64)((c - 97u < 26u) << 5) << (8 * i);
+    }
+    return w;
+  }
+  u32 n;
+  u8* q = (u8*)str_sole_run(e.mem, s, &n);
+  if (q == NULL || !str_nil(e.mem[term_loc(s) + 1])) {
+    return str_upper_far(e, s);
+  }
+  for (u32 j = 0; j < n; j += 1) {
+    q[j] -= (u8)(((u32)q[j] - 97u < 26u) << 5);
+  }
+  return s;
+}
+
+INLINE u64 str_code_at(u64* H, Term s, u64 i) {
+  u32       n;
+  const u8* q = str_sole_run(H, s, &n);
+  if (q != NULL && i < n && str_nil(H[term_loc(s) + 1])) {
+    return q[i];
+  }
+  return str_code_at_far(H, s, i);
+}
+
+// the index of the first c at or after index i of a borrowed s, or its
+// length: memchr a run at a time
+FAR u64 str_find_far(u64* H, Term s, u64 c, u64 i) {
+  u64    k = 0;
+  StrRun r;
+  for (Term t = s; str_run(H, t, &r); t = r.t) {
+    if (k + r.n > i) {
+      u64 at = i > k ? i - k : 0;
+      if (r.p == NULL) {
+        if (r.c == c) {
+          return k;
+        }
+      } else if (c < 256) {
+        const u8* q = memchr(r.p + at, (int)c, r.n - at);
+        if (q != NULL) {
+          return k + (u64)(q - r.p);
+        }
+      }
+    }
+    k += r.n;
+  }
+  return k;
+}
+
+// the n chars from index i of a borrowed s, copied: one run's bytes
+// directly, else from a view of the run where they start
+FAR Term str_slice_far(Env e, Term s, u64 i, u64 n) {
+  u64*   H = e.mem;
+  StrRun r;
+  for (Term t = s; n > 0 && str_run(H, t, &r); t = r.t) {
+    if (i >= r.n) {
+      i -= r.n;
+      continue;
+    }
+    if (r.p != NULL && r.n - i >= n && n <= STR_IMM_MAX) {
+      return str_imm_make(r.p + i, (u32)n);
+    }
+    if (r.p != NULL && r.n - i >= n) {
+      u32  c  = str_cls_for(n);
+      u32  at = (4u << c) - (u32)n;
+      Term ch = str_chunk(e, c, at, term_pak(CID(SNil), 0));
+      memcpy(str_mem(H, H[term_loc(ch)]) + at, r.p + i, n);
+      return ch;
+    }
+    Term v = t;
+    if (str_imm(t)) {
+      v = str_imm_drop(t, (u32)i);
+    } else if (r.p != NULL) {
+      u64 nd = str_node(H, t);
+      u32 p0 = term_tag(t) == 0 ? (u32)term_aux(t) : str_pos(H[nd]);
+      v      = term_make(0, p0 + (u32)i, nd);
+    }
+    return str_copy_any(e, v, n, term_pak(CID(SNil), 0), 0);
+  }
+  return term_pak(CID(SNil), 0);
+}
+
+INLINE u64 str_find(u64* H, Term s, u64 c, u64 i) {
+  u32       n;
+  const u8* q = str_sole_run(H, s, &n);
+  if (q != NULL && c < 256 && str_nil(H[term_loc(s) + 1])) {
+    const u8* f = i < n ? memchr(q + i, (int)c, n - i) : NULL;
+    return f != NULL ? (u64)(f - q) : n;
+  }
+  return str_find_far(H, s, c, i);
+}
+
+INLINE Term str_slice(Env e, Term s, u64 i, u64 n) {
+  u32       m;
+  const u8* q = str_sole_run(e.mem, s, &m);
+  if (q != NULL && n > 0 && i < m && n <= m - i && n <= STR_IMM_MAX) {
