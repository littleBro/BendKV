@@ -0,0 +1,145 @@
+# io (io_tcp_raw): TCP.send_raw and TCP.recv_raw carry bytes as they are,
+# one Char (0..255) each, in a String. The client sends "O", the two bytes
+# of "á" (C3 A1), 255 and 0; the server reads 2 bytes, which split the
+# "á", then the rest, and every byte survives. Then 5000 bytes go out in
+# one send and come back over reads of at most 4096, past a chunk's 2048;
+# their count and sum survive. A Char past 255 fails with EINVAL (22)
+# before any byte is sent.
+import Base
+
+def codes_line(s: String) -> String:
+  match s:
+    case "":
+      ""
+    case SCon{c, ""}:
+      U32.show(Char.to_u32(c))
+    case SCon{c, rest}:
+      U32.show(Char.to_u32(c)) ++ " " ++ codes_line(rest)
+
+def count(s: String, n: U32, k: U32) -> U32 & U32:
+  match s:
+    case "":
+      (n, k)
+    case SCon{c, rest}:
+      count(rest, (n + 1 : U32), (k + Char.to_u32(c) : U32))
+
+def bulk.go(n: Nat, acc: String) -> String:
+  match n:
+    case 0n:
+      acc
+    case 1n++p:
+      bulk.go(p, SCon{Char.from_u32(U32.mod(U32.from_nat(p), 256)), acc})
+
+def recv_go(m: Socket & Result<&1, &1, U32 & String, String>) -> IO(Socket):
+  (s, r) = m
+  do IO<Socket>:
+    xs : String <- IO.pass(String, r)
+    u : Unit <- IO.print(codes_line(xs))
+    return s
+
+def recv_done(nk: U32 & U32, s: Socket) -> IO(Socket):
+  (n, k) = nk
+  do IO<Socket>:
+    u : Unit <- IO.print(U32.show(n) ++ " " ++ U32.show(k))
+    return s
+
+def count_on(xs: String, nk: U32 & U32) -> U32 & U32:
+  (n, k) = nk
+  count(xs, n, k)
+
+def recv_got(m: Socket & Result<&1, &1, U32 & String, String>, nk: U32 & U32, next: Socket -> U32 & U32 -> IO(Socket)) -> IO(Socket):
+  (s, r) = m
+  match r:
+    case Done{xs}:
+      next(s, count_on(xs, nk))
+    case Fail{e}:
+      recv_done(nk, s)
+
+def recv_if(more: Bool, s: Socket, nk: U32 & U32, next: Socket -> U32 & U32 -> IO(Socket)) -> IO(Socket):
+  match more:
+    case True{}:
+      do IO<Socket>:
+        r : Socket & Result<&1, &1, U32 & String, String> <- TCP.recv_raw(s, 4096)
+        recv_got(r, nk, next)
+    case False{}:
+      recv_done(nk, s)
+
+def recv_loop(fuel: Nat, s: Socket, nk: U32 & U32) -> IO(Socket):
+  match fuel:
+    case 0n:
+      recv_done(nk, s)
+    case 1n+f:
+      (+n, k) = nk
+      recv_if(U32.is_lt(n, 5000), s, (n, k), s2 => nk2 => recv_loop(f, s2, nk2))
+
+def send_go(m: Socket & Result<&1, &1, U32 & String, Unit>) -> IO(Socket):
+  (s, r) = m
+  do IO<Socket>:
+    u : Unit <- IO.pass(Unit, r)
+    return s
+
+def send_bad(m: Socket & Result<&1, &1, U32 & String, Unit>) -> IO(Socket):
+  (s, r) = m
+  match r:
+    case Done{u}:
+      do IO<Socket>:
+        v : Unit <- IO.print("unexpected send")
+        return s
+    case Fail{(code, message)}:
+      do IO<Socket>:
+        v : Unit <- IO.print(U32.show(code))
+        return s
+
+def talk(c: Socket, p: Listener & Result<&1, &1, U32 & String, Socket>) -> IO(Unit):
+  (l2, ar) = p
+  do IO<Unit>:
+    a  : Socket <- IO.pass(Socket, ar)
+    s1 : Socket & Result<&1, &1, U32 & String, Unit> <- TCP.send_raw(c, "O\u{C3}\u{A1}\u{FF}\u{0}")
+    c1 : Socket <- send_go(s1)
+    r1 : Socket & Result<&1, &1, U32 & String, String> <- TCP.recv_raw(a, 2)
+    a1 : Socket <- recv_go(r1)
+    r2 : Socket & Result<&1, &1, U32 & String, String> <- TCP.recv_raw(a1, 64)
+    a2 : Socket <- recv_go(r2)
+    s2 : Socket & Result<&1, &1, U32 & String, Unit> <- TCP.send_raw(c1, bulk.go(5000n, ""))
+    c2 : Socket <- send_go(s2)
+    a3 : Socket <- recv_loop(64n, a2, (0, 0))
+    s3 : Socket & Result<&1, &1, U32 & String, Unit> <- TCP.send_raw(c2, "a\u{100}")
+    c3 : Socket <- send_bad(s3)
+    x  : Unit <- Socket.close(a3)
+    y  : Unit <- Socket.close(c3)
+    Listener.close(l2)
+
+def main_go(b: Listener & U32) -> IO(Unit):
+  (l, port) = b
+  do IO<Unit>:
+    c : Socket <- IO.try(Socket, TCP.connect("127.0.0.1", port))
+    p : Listener & Result<&1, &1, U32 & String, Socket> <- TCP.accept(l)
+    talk(c, p)
+
+def tcp_retry(port: U32, r: Result<&1, &1, U32 & String, Listener>, rest: IO(Listener & U32)) ->
+  IO(Listener & U32):
+  match r:
+    case Done{l}:
+      IO.pure(Listener & U32, (l, port))
+    case Fail{e}:
+      rest
+
+def tcp_listen_any(tries: Nat, +port: U32) -> IO(Listener & U32):
+  match tries:
+    case 0n:
+      IO.die(Listener & U32, 1, "no free tcp port")
+    case 1n+t:
+      rest = tcp_listen_any(t, (port + 1 : U32))
+      do IO<Listener & U32>:
+        r : Result<&1, &1, U32 & String, Listener> <- TCP.listen("127.0.0.1", port)
+        tcp_retry(port, r, rest)
+
+def main() -> IO(Unit):
+  do IO<Unit>:
+    b : Listener & U32 <- tcp_listen_any(32n, 19957)
+    main_go(b)
+
