   chan_mark: { C: "chan_mark($0, $1, $2)",
     JS: "($0.mark = [$1 & 0xFFFF, $2], $0)", brw: [false, false, false] },
   chan_marked: { C: ["chan_marked($0)", "($1 & 0xFFFF)", "($1 >> 16)"],
