index 568111a..21ee444 100644
--- a/bend2/base.bend
+++ b/bend2/base.bend
@@ -2780,6 +2780,17 @@ def Mem.touch(k: U32, +i: U32, +v: U32) -> U32:
 def Mem.cell(+i: U32) -> U32:
   0
 
+# Clock.us(k) is 0. On the C and JS lanes it reads the host's monotonic
+# clock once k is known, in microseconds mod 2^32 (it wraps every 71
+# minutes: the span between two readings is their difference mod 2^32).
+# k orders the reading: it comes after the work k was computed from, as a
+# computation times its own steps without an effect's round trip, giving
+# each reading a word of what the step before it made. No law reads the
+# clock: its values are the compiled lanes' alone.
+@unsafe
+def Clock.us(+k: U32) -> U32:
+  0
+
