 #endif
 
+// The clock of Clock.us: the monotonic clock in microseconds, mod 2^32
+// (clock_gettime, which the vDSO answers without a system call). The word
+// it is given orders the reading after the work it was computed from.
+#if !DEVICE
+INLINE u64 clock_us(u64 k) {
+  (void)k;
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return (u32)((u64)ts.tv_sec * 1000000u + (u64)ts.tv_nsec / 1000u);
+}
+#endif
+
 // The marks of channels (Chan.mark, Chan.marked): for each channel's row
 // (its handle's low 24 bits, the generation above them), the generation it
 // was marked under, a word and a time. They belong to the one computation
diff --git a/tests/run/clock_us.bend b/tests/run/clock_us.bend
new file mode 100644
index 0000000..4c7b861
--- /dev/null
+++ b/tests/run/clock_us.bend
@@ -0,0 +1,24 @@
+# run (clock_us): Clock.us(k) reads the monotonic clock, in microseconds
+# mod 2^32, once k is known. Two readings around a walk of a list, the
+# second given a word of the walk's sum, are ordered by it: the span
+# between them, their difference mod 2^32, is under a second.
+import Base
+
+def sum(+xs: List<&2, Nat>, acc: Nat) -> Nat:
+  match xs:
+    case Nil{}:
+      acc
+    case Con{x, +rest}:
+      sum(rest, Nat.add(acc, x))
+
+def main() -> IO(Unit):
+  +a = Clock.us(0)
+  +xs = List.range(Nat.add(100000n, U32.to_nat(U32.and(a, 0))))
+  +n = sum(xs, 0n)
+  +b = Clock.us(U32.from_nat(n))
+  do IO<Unit>:
+    Unit <- IO.print(Nat.show(n))
+    IO.print(Bool.show(U32.is_lt(U32.sub(b, a), 1000000)))
+
+#|4999950000
+#|True
