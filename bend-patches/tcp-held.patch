new file mode 100644
index 0000000..d47d0d2
--- /dev/null
+++ b/bend2/effs/tcp_abort.js
@@ -0,0 +1,13 @@
+// TCP
+// ===
+
+// sock set to close abortively (SO_LINGER on, a time of 0), as
+// tcp_abort.c sets it: an int pair, on and the time
+function tcp_abort(socket) {
+  const sys = io_sys();
+  const l = new Int32Array([1, 0]);
+  return io_tup(socket, sys.setsockopt(Number(socket), sys.mac ? 0xffff : 1,
+    sys.mac ? 0x80 : 13, sys.ptr(l), 8) === 0);
+}
+
+io_eff(CID(TCP.abort), tcp_abort);
