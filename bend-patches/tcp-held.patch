--- /dev/null
+++ b/bend2/effs/tcp_held.c
@@ -0,0 +1,13 @@
+// TCP
+// ===
+
+// The bytes posted to sock that its loop's writer holds (io_post_bytes):
+// what the socket has had no room for, which its peer has not read
+Term tcp_held_run(Env e, Term* f, IoWork* w) {
+  (void)w;
+  return io_tup(e, f[0], (Term)io_post_bytes((int)io_hand_v(f[0])));
+}
+
+static void __attribute__((constructor)) tcp_held_use(void) {
+  io_eff(CID(TCP.held), tcp_held_run);
+}
