diff --git a/bend2/effs/tcp_abort.c b/bend2/effs/tcp_abort.c
new file mode 100644
index 0000000..180c0c9
--- /dev/null
+++ b/bend2/effs/tcp_abort.c
@@ -0,0 +1,15 @@
+// TCP
+// ===
+
+// sock set to close abortively (SO_LINGER on, a time of 0), so that its
+// close resets the connection whatever its buffers hold
+Term tcp_abort_run(Env e, Term* f, IoWork* w) {
+  (void)w;
+  struct linger l  = { 1, 0 };
+  bool          ok = setsockopt((int)io_hand_v(f[0]), SOL_SOCKET, SO_LINGER, &l, sizeof l) == 0;
+  return io_tup(e, f[0], term_pak(ok ? CID(True) : CID(False), 0));
+}
+
+static void __attribute__((constructor)) tcp_abort_use(void) {
+  io_eff(CID(TCP.abort), tcp_abort_run);
+}
