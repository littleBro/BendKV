   chan_marked: { C: ["chan_marked($0)", "($1 & 0xFFFF)", "($1 >> 16)"],
@@ -4763,6 +4769,33 @@ INLINE u64 mem_prefetch(DEV u64* H, Term t, u64 k) {
   return k;
 }
 
+// The cells of Mem.touch and Mem.cell: 2^20 words outside the heap, made
+// on the first touch (zero pages until written), indexed by an index's low
+// 20 bits. They belong to the one computation that touches and reads them
+// (an actor, of when each of its keys was last used), so they take no lock.
+#if !DEVICE
+static u32* mem_cells;
+
+OUTLINE void mem_cells_make(void) {
+  mem_cells = calloc(1u << 20, sizeof(u32));
+  if (mem_cells == NULL) {
+    err_fail("host allocation failed");
+  }
+}
+
+INLINE u64 mem_touch(u64 k, u64 i, u64 v) {
+  if (mem_cells == NULL) {
+    mem_cells_make();
+  }
+  mem_cells[i & 0xFFFFF] = (u32)v;
+  return k;
+}
+
+INLINE u64 mem_cell(u64 i) {
+  return mem_cells == NULL ? 0 : mem_cells[i & 0xFFFFF];
+}
+#endif
+
 // The marks of channels (Chan.mark, Chan.marked): for each channel's row
 // (its handle's low 24 bits, the generation above them), the generation it
 // was marked under, a word and a time. They belong to the one computation
diff --git a/tests/run/mem_cells.bend b/tests/run/mem_cells.bend
new file mode 100644
index 0000000..0af7fb2
--- /dev/null
+++ b/tests/run/mem_cells.bend
@@ -0,0 +1,21 @@
+# run (mem_cells): Mem.touch keeps a word per index's low 20 bits, which
+# Mem.cell reads back; a word never touched reads 0, and an index past 2^20
+# names the word of its low 20 bits. A touch gives back its first argument,
+# through which the touches are ordered.
+import Base
+
+def touches(+k: U32) -> U32:
+  Mem.touch(Mem.touch(Mem.touch(k, 5, 50), 6, 60), 1048581, 70)
+
+def main() -> IO(Unit):
+  +k = touches(9)
+  do IO<Unit>:
+    Unit <- IO.print(U32.show(k))
+    Unit <- IO.print(U32.show(Mem.cell(5)))
+    Unit <- IO.print(U32.show(Mem.cell(6)))
+    IO.print(U32.show(Mem.cell(7)))
+
+#|9
+#|70
+#|60
+#|0
