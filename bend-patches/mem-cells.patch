diff --git a/bend2/base.bend b/bend2/base.bend
index b436ab8..b3eb165 100644
--- a/bend2/base.bend
+++ b/bend2/base.bend
@@ -2536,6 +2536,21 @@ def List.show(~a: Quant, ~A: Kind(a), ~f: A -> String, xs: List<a, A>) ->
 def Mem.prefetch(-A: Data, +x: A, k: U32) -> U32:
   k
 
+# Mem.touch(k, i, v) is k, and Mem.cell(i) is 0. On the C and JS lanes
+# they also keep 2^20 words outside the heap: touch sets the word of i's
+# low 20 bits to v, and cell reads it back (0 for one never set). The
+# words belong to the one computation that touches and reads them, as an
+# actor keeps when each of its keys was last used (a word per key's hash),
+# so a touch costs a store, not a value threaded through every call. No
+# law reads a word: these values are the compiled lanes' alone.
+@unsafe
+def Mem.touch(k: U32, +i: U32, +v: U32) -> U32:
+  k
+
+@unsafe
+def Mem.cell(+i: U32) -> U32:
+  0
+
