diff --git a/tests/rfc/str_variant.bend b/tests/rfc/str_variant.bend
new file mode 100644
index 0000000..330169d
--- /dev/null
+++ b/tests/rfc/str_variant.bend
@@ -0,0 +1,141 @@
+# rfc (rfc_str_variant): a datatype with one constructor whose one field
+# is a String boxes that constructor as the String itself (str_var). A
+# list of V holds each VStr as its String, and a match tells it from the
+# other constructors, packed words (VNum, VNone) and nodes (VPair), by
+# their tags. The strings are empty, immediate, of one chunk and of
+# several. size matches the values owned, tags lent, rec unboxes them into
+# a record; J, a recursive datatype, is matched as a box; main prints
+# both. A VStr read as a node, or a string taken for VNone, shows as a
+# wrong sum; a double free or a lost count as a "bend: error". Expect
+# on every lane:
+#| (75, 164, 22981, 5, [VStr{""}, VStr{"abc"}, VNum{7}, VPair{"x", "yz"}, VNone{}, VStr{"abcd"}], JArr{[JStr{"a"}, JArr{[JStr{""}]}, JStr{"0123456789"}]})
+import Base
+
+type V is Data:
+  VStr{s: String}
+  VNum{n: U32}
+  VPair{a: String, b: String}
+  VNone{}
+
+type J is Data:
+  JStr{s: String}
+  JArr{xs: List<&2, J>}
+
+def len(s: String) -> U32:
+  match s:
+    case SNil{}:
+      0
+    case SCon{c, r}:
+      U32.add(1, len(r))
+
+def long(n: Nat, acc: String) -> String:
+  match n:
+    case 0n:
+      acc
+    case 1n++m:
+      long(m, String.append(acc, "0123456789"))
+
+def vals() -> List<&2, V>:
+  [VStr{""}, VStr{"abc"}, VNum{7}, VStr{"exactly"}, VPair{"x", "yz"}, VNone{}, VStr{long(5n, "")}, VStr{String.append("ab", "cd")}]
+
+# owned matches
+def size(v: V) -> U32:
+  match v:
+    case VStr{s}:
+      len(s)
+    case VNum{n}:
+      n
+    case VPair{a, b}:
+      U32.add(len(a), len(b))
+    case VNone{}:
+      1
+
+def sizes(xs: List<&2, V>) -> U32:
+  match xs:
+    case Nil{}:
+      0
+    case h <> t:
+      U32.add(size(h), sizes(t))
+
+# lent matches: a digit per value, newest last
+def tag(+v: V) -> U32:
+  match v:
+    case VStr{+s}:
+      U32.add(1, U32.mul(len(s), 0))
+    case VNum{n}:
+      2
+    case VPair{+a, +b}:
+      3
+    case VNone{}:
+      0
+
+def tags(+xs: List<&2, V>, acc: U32) -> U32:
+  match xs:
+    case Nil{}:
+      acc
+    case h <> t:
+      tags(t, U32.add(U32.mul(acc, 4), tag(h)))
+
+# a value unboxed into a record and back
+type R is Data:
+  R{v: V, k: U32}
+
+def rec(xs: List<&2, V>) -> List<&2, R>:
+  match xs:
+    case Nil{}:
+      []
+    case Con{+h, t}:
+      R{h, size(h)} <> rec(t)
+
+def rsum(rs: List<&2, R>) -> U32:
+  match rs:
+    case Nil{}:
+      0
+    case R{v, k} <> t:
+      U32.add(U32.add(k, size(v)), rsum(t))
+
+def strs(+xs: List<&2, V>) -> U32:
+  match xs:
+    case Nil{}:
+      0
+    case VStr{+s} <> t:
+      U32.add(1, strs(t))
+    case h <> t:
+      strs(t)
+
+def keep.k(big: Bool, s: String, rest: List<&2, V>) -> List<&2, V>:
+  match big:
+    case True{}:
+      rest
+    case False{}:
+      VStr{s} <> rest
+
+# the values but the strings longer than 6 bytes
+def keep(xs: List<&2, V>) -> List<&2, V>:
+  match xs:
+    case Nil{}:
+      []
+    case VStr{+s} <> t:
+      keep.k(U32.is_gt(len(s), 6), s, keep(t))
+    case h <> t:
+      h <> keep(t)
+
+def jsizes(xs: List<&2, J>) -> U32:
+  match xs:
+    case Nil{}:
+      0
+    case JStr{s} <> t:
+      U32.add(U32.add(1, len(s)), jsizes(t))
+    case JArr{ys} <> t:
+      U32.add(jsizes(ys), jsizes(t))
+
+def jsize(j: J) -> U32:
+  jsizes([j])
+
+def jval() -> J:
+  JArr{[JStr{"a"}, JArr{[JStr{""}]}, JStr{long(1n, "")}]}
+
+def main() -> U32 & U32 & U32 & U32 & List<&2, V> & J:
+  +xs = vals()
+  +j = jval()
+  (U32.add(sizes(xs), U32.mul(100, 0)), U32.add(rsum(rec(xs)), jsize(j)), tags(xs, 0), strs(xs), keep(xs), j)
