+// sized first by their lengths, so it is allocated once.
+Term tcp_post_list_run(Env e, Term* f, IoWork* w) {
+  Term  l    = f[1];
+  u64   room = 1;
+  u64   len  = 0;
+  bool  ok   = true;
+  for (Term t = l; term_aux(t) == CID(Con);) {
+    u64 nd = term_peek(e.mem, t);
+    room  += str_len(e.mem, e.mem[nd]);
+    t      = e.mem[nd + 1];
+  }
+  char* buf = io_mem(malloc(room));
+  while (term_aux(l) == CID(Con)) {
+    Term fb[2];
+    spare_free(e, cls_fit(2), ctr_take(e, l, 2, fb));
+    ok = io_cbuf_add(e, fb[0], &len, IO_RAW, &buf, &room) != NULL && ok;
+    l  = fb[1];
+  }
+  term_drop(e, l);
+  if (!ok || len == 0) {
+    free(buf);
+  } else {
+    io_post((int)io_hand_v(f[0]), buf, len);
+  }
+  return f[0];
