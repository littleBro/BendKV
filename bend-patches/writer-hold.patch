--- /dev/null
+++ b/tests/io/tcp_post_stall.bend
@@ -0,0 +1,204 @@
+# io (io_tcp_post_stall): a socket whose peer stops reading holds up only
+# its own posts. One poster posts 8 MB to a1, whose peer c1 reads nothing
+# yet (twice what the loopback's buffers take), then 5,000 short posts
+# (more than a block of the writer's queue) and a close; another posts the
+# 8 MB to a2 and closes it. A timer fires meanwhile; c2 gets a2's bytes
+# and its end, then c1 gets a1's, in order, and its end. On the C lane
+# the writer used to wait on a1's full socket, a2's bytes waited behind
+# it, and once 4,096 posts waited the loop waited for room in the writer's
+# ring, its timers too. Elsewhere a post waits for its own socket, so each
+# poster is a computation of its own.
+import Base
+
+def dbl(n: Nat, s: String) -> String:
+  match n:
+    case 0n:
+      s
+    case 1n+p:
+      +x = s
+      dbl(p, x ++ x)
+
+def post_smalls(n: Nat, +k: Nat, s: Socket) -> IO(Socket):
+  match n:
+    case 0n:
+      IO.pure(Socket, s)
+    case 1n+p:
+      do IO<Socket>:
+        s2 : Socket <- TCP.post(s, Nat.show(k) ++ ",")
+        post_smalls(p, 1n+k, s2)
+
+def poster1(a: Socket, big: String) -> IO(Unit):
+  do IO<Unit>:
+    a2 : Socket <- TCP.post(a, big)
+    a3 : Socket <- post_smalls(5000n, 0n, a2)
+    Socket.close(a3)
+
+def poster2(a: Socket, big: String) -> IO(Unit):
+  do IO<Unit>:
+    a2 : Socket <- TCP.post(a, big)
+    Socket.close(a2)
+
+# s read until left more bytes came (a read at most 65,536 of them), or
+# its end: how many did not come. Only String.length looks at them, which
+# is native on both lanes.
+def skip.more(eof: Bool, s: Socket, left: Nat, next: Socket -> Nat -> IO(Socket & Nat)) -> IO(Socket & Nat):
+  match eof:
+    case True{}:
+      IO.pure(Socket & Nat, (s, left))
+    case False{}:
+      next(s, left)
+
+def skip.got(m: Socket & Result<&1, &1, U32 & String, String>, +left: Nat, next: Socket -> Nat -> IO(Socket & Nat)) -> IO(Socket & Nat):
+  (s, r) = m
+  match r:
+    case Done{+xs}:
+      skip.more(String.is_empty(xs), s, Nat.sub(left, String.length(xs)), next)
+    case Fail{e}:
+      IO.pure(Socket & Nat, (s, left))
+
+def skip.go(done: Bool, s: Socket, +left: Nat, next: Socket -> Nat -> IO(Socket & Nat)) -> IO(Socket & Nat):
+  match done:
+    case True{}:
+      IO.pure(Socket & Nat, (s, left))
+    case False{}:
+      do IO<Socket & Nat>:
+        m : Socket & Result<&1, &1, U32 & String, String> <- TCP.recv_raw(s, U32.from_nat(Nat.min(65536n, left)))
+        skip.got(m, left, next)
+
+def skip(fuel: Nat, s: Socket, +left: Nat) -> IO(Socket & Nat):
+  match fuel:
+    case 0n:
+      IO.pure(Socket & Nat, (s, left))
+    case 1n+f:
+      skip.go(Nat.is_eq(left, 0n), s, left, s2 => l2 => skip(f, s2, l2))
+
+# s read until want's bytes came, whether they were want's (a few bytes)
+def tail.more(same: Bool, s: Socket, want: String, next: Socket -> String -> IO(Socket & Bool)) -> IO(Socket & Bool):
+  match same:
+    case True{}:
+      next(s, want)
+    case False{}:
+      IO.pure(Socket & Bool, (s, False{}))
+
+def tail.got(m: Socket & Result<&1, &1, U32 & String, String>, +want: String, next: Socket -> String -> IO(Socket & Bool)) -> IO(Socket & Bool):
+  (s, r) = m
+  match r:
+    case Done{+xs}:
+      +k = String.length(xs)
+      tail.more(Bool.and(Bool.not(String.is_empty(xs)), String.eq(xs, String.take(want, k))), s, String.drop(want, k), next)
+    case Fail{e}:
+      IO.pure(Socket & Bool, (s, False{}))
+
+def tail.go(done: Bool, s: Socket, +want: String, next: Socket -> String -> IO(Socket & Bool)) -> IO(Socket & Bool):
+  match done:
+    case True{}:
+      IO.pure(Socket & Bool, (s, True{}))
+    case False{}:
+      do IO<Socket & Bool>:
+        m : Socket & Result<&1, &1, U32 & String, String> <- TCP.recv_raw(s, U32.from_nat(String.length(want)))
+        tail.got(m, want, next)
+
+def tail(fuel: Nat, s: Socket, +want: String) -> IO(Socket & Bool):
+  match fuel:
+    case 0n:
+      IO.pure(Socket & Bool, (s, False{}))
+    case 1n+f:
+      tail.go(String.is_empty(want), s, want, s2 => w2 => tail(f, s2, w2))
+
+def at_end.got(m: Socket & Result<&1, &1, U32 & String, String>, ok: Bool) -> IO(Socket & Bool):
+  (s, r) = m
+  match r:
+    case Done{xs}:
+      IO.pure(Socket & Bool, (s, Bool.and(ok, String.is_empty(xs))))
+    case Fail{e}:
+      IO.pure(Socket & Bool, (s, False{}))
+
+def at_end(t: Socket & Bool, ok: Bool) -> IO(Socket & Bool):
+  (s, same) = t
+  do IO<Socket & Bool>:
+    m : Socket & Result<&1, &1, U32 & String, String> <- TCP.recv_raw(s, 1)
+    at_end.got(m, Bool.and(ok, same))
+
+def read_tail(k: Socket & Nat, last: String) -> IO(Socket & Bool):
+  (s, left) = k
+  do IO<Socket & Bool>:
+    t : Socket & Bool <- tail(100n, s, last)
+    at_end(t, Nat.is_eq(left, 0n))
+
+# c read whole: n bytes, last the last of them, then its end
+def read_all(c: Socket, n: Nat, +last: String) -> IO(Socket & Bool):
+  do IO<Socket & Bool>:
+    k : Socket & Nat <- skip(100000n, c, Nat.sub(n, String.length(last)))
+    read_tail(k, last)
+
+def said(ok: Bool) -> String:
+  match ok:
+    case True{}:
+      "in order"
+    case False{}:
+      "WRONG"
+
+def report(name: String, n: Nat, d: Socket & Bool) -> IO(Unit):
+  (s, ok) = d
+  do IO<Unit>:
+    Unit <- IO.print(name ++ " " ++ Nat.show(n) ++ " " ++ said(ok))
+    Socket.close(s)
+
+def talk(c1: Socket, a1: Socket, c2: Socket, m2: Listener & Result<&1, &1, U32 & String, Socket>) -> IO(Unit):
+  (l, r2) = m2
+  +big = dbl(17n, "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-")
+  do IO<Unit>:
+    a2 : Socket <- IO.pass(Socket, r2)
+    Unit <- IO.spawn(Unit, poster1(a1, big))
+    Unit <- IO.sleep(5)
+    Unit <- IO.spawn(Unit, poster2(a2, big))
+    Unit <- IO.sleep(5)
+    Unit <- IO.print("tick")
+    d2 : Socket & Bool <- read_all(c2, 8257536n, "RSTUVWXYZ-")
+    Unit <- report("c2", 8257536n, d2)
+    d1 : Socket & Bool <- read_all(c1, 8281426n, "4998,4999,")
+    Unit <- report("c1", 8281426n, d1)
+    Listener.close(l)
+
+def two(c1: Socket, m1: Listener & Result<&1, &1, U32 & String, Socket>, +port: U32) -> IO(Unit):
+  (l, r1) = m1
+  do IO<Unit>:
+    a1 : Socket <- IO.pass(Socket, r1)
+    c2 : Socket <- IO.try(Socket, TCP.connect("127.0.0.1", port))
+    m2 : Listener & Result<&1, &1, U32 & String, Socket> <- TCP.accept(l)
+    talk(c1, a1, c2, m2)
+
+def main_go(b: Listener & U32) -> IO(Unit):
+  (l, port) = b
+  +p = port
+  do IO<Unit>:
+    c1 : Socket <- IO.try(Socket, TCP.connect("127.0.0.1", p))
+    m1 : Listener & Result<&1, &1, U32 & String, Socket> <- TCP.accept(l)
+    two(c1, m1, p)
+
+def tcp_retry(port: U32, r: Result<&1, &1, U32 & String, Listener>, rest: IO(Listener & U32)) ->
+  IO(Listener & U32):
+  match r:
+    case Done{l}:
+      IO.pure(Listener & U32, (l, port))
+    case Fail{e}:
+      rest
+
+def tcp_listen_any(tries: Nat, +port: U32) -> IO(Listener & U32):
+  match tries:
+    case 0n:
+      IO.die(Listener & U32, 1, "no free tcp port")
+    case 1n+t:
+      rest = tcp_listen_any(t, (port + 1 : U32))
+      do IO<Listener & U32>:
+        r : Result<&1, &1, U32 & String, Listener> <- TCP.listen("127.0.0.1", port)
+        tcp_retry(port, r, rest)
+
+def main() -> IO(Unit):
+  do IO<Unit>:
+    b : Listener & U32 <- tcp_listen_any(32n, 19927)
+    main_go(b)
+
