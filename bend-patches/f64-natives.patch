+    || (u64)(end - text) != n || v != v || (errno == ERANGE
+      && (v == HUGE_VAL || v == -HUGE_VAL || v == 0));
+  free(text);
+  return bad ? 0x7FF8000000000000ull : f64_bits(e, v);
+}
