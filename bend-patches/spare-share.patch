+// wrap it (term_keep of a raw word), so the node gets the word back, the
+// one a re-read after a call takes and a rebuild that skips its slot
+// keeps; else they would hold the raw word the wrap now owns.
+function fld_put(sc: Scope, w: string): void {
+  const f = sc.fld.get(w);
+  if (f === undefined || !sc.spares.some((s) => !s.z && s.name === f.sp)) {
+    return;
+  }
+  const px = sc.perm;
+  const at = px !== null && f.sp === px.sp ? perm_at(sc, px.k, f.j) : f.j;
+  file_push(sc, `e.mem[${f.sp} + ${at}] = ${w};`);
+}
