+# appended to log (kept from the first call; "" for the standard output).
+# A SIGINT while a shutdown is asked for (a signal taken since the last
+# call with done not 0) ends the process with code 1, after "You insist...
+# exiting now." and the removal of temp-<pid>.rdb from the working
+# directory. done not 0 says the shutdown asked for failed, as Redis's
+# cancelShutdown does; it gives 0, and a signal taken waits for the next
+# call. The JS lane traps nothing and gives 0.
+def IO.signal(log: String, done: U32) -> IO(U32):
+  import "./effs/io_signal.c"
+  import "./effs/io_signal.js"
+
