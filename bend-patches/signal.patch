+
+#|0 0
diff --git a/tests/io/io_signal_raise.c b/tests/io/io_signal_raise.c
new file mode 100644
index 0000000..60a93a4
--- /dev/null
+++ b/tests/io/io_signal_raise.c
@@ -0,0 +1,12 @@
+#include <signal.h>
+
+// The signal n sent to the program itself: raise delivers it to the
+// calling thread, so its handler has run when raise returns.
+static Term raise_sig_run(Env e, Term* f, IoWork* w) {
+  (void)w;
+  return (Term)(u32)raise((int)(u32)f[0]);
+}
+
+static void __attribute__((constructor)) raise_sig_use(void) {
+  io_eff(CID(raise.sig), raise_sig_run);
+}
