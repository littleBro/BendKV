+# rfc (rfc_digit_select): a match on a digit (an enum of fieldless
+# constructors) whose arms take field off + i of a node for digit i and
+# differ in nothing else compiles to one arm that reads field off + x and
+# builds with slots off and off + x swapped. get walks a tree of four-way
+# nodes without owning it; put rebuilds a path under a call (its
+# continuation saves the digit) and grows a node where a path meets a leaf
+# or an empty subtree (arms that only build); tag sits before the subtrees,
+# so off is 1. odd's arm for D2 differs, so its match stays a chain. t0 and
+# t1 are shared, so their updates copy the path and leave them as they
+# were. A field read or written at the wrong slot shows as a wrong sum.
+# Expect 3130,3230,4230,3135,28845,26617,39503 on every lane.
+import Base
+
+type D is Data:
+  D0{}
+  D1{}
+  D2{}
+  D3{}
+
+type T is Data:
+  E{}
+  L{v: U32}
+  N{tag: U32, a: T, b: T, c: T, d: T}
+
+def dig.of(n: U32) -> D:
+  match n:
+    case 0:
+      D0{}
+    case 1:
+      D1{}
+    case 2:
+      D2{}
+    case _:
+      D3{}
+
+def dig(+p: U32) -> D:
+  dig.of(U32.and(p, 3))
+
+def full(d: Nat, +x: U32) -> T:
+  match d:
+    case 0n:
+      L{x}
+    case 1n++e:
+      N{x, full(e, U32.add(x, 1)), full(e, U32.add(x, 2)), full(e, U32.add(x, 3)), full(e, U32.add(x, 4))}
+
+# the leaf on path p (2 bits a level, x the first digit), 0 when none
+def get(d: Nat, +t: T, x: D, +p: U32) -> U32:
+  match d t x:
+    case 0n L{v} _:
+      v
+    case 1n++e N{g, a, b, c, f} D0{}:
+      get(e, a, dig(p), U32.shrn(p, 2n))
+    case 1n++e N{g, a, b, c, f} D1{}:
+      get(e, b, dig(p), U32.shrn(p, 2n))
+    case 1n++e N{g, a, b, c, f} D2{}:
+      get(e, c, dig(p), U32.shrn(p, 2n))
+    case 1n++e N{g, a, b, c, f} D3{}:
+      get(e, f, dig(p), U32.shrn(p, 2n))
+    case _ _ _:
+      0
+
+# get, but the leaves under digit 2 count 1000 more
+def odd(d: Nat, +t: T, x: D, +p: U32) -> U32:
+  match d t x:
+    case 0n L{v} _:
+      v
+    case 1n++e N{g, a, b, c, f} D0{}:
+      odd(e, a, dig(p), U32.shrn(p, 2n))
+    case 1n++e N{g, a, b, c, f} D1{}:
+      odd(e, b, dig(p), U32.shrn(p, 2n))
+    case 1n++e N{g, a, b, c, f} D2{}:
+      U32.add(1000, odd(e, c, dig(p), U32.shrn(p, 2n)))
+    case 1n++e N{g, a, b, c, f} D3{}:
+      odd(e, f, dig(p), U32.shrn(p, 2n))
+    case _ _ _:
+      0
+
+# the tree with the leaf on path p set to v plus what was there; a node
+# where a leaf belongs stays (an arm that returns the node it matched
+# makes put own its tree, so the path is rebuilt in place)
+def put(d: Nat, t: T, x: D, +p: U32, v: U32) -> T:
+  match d t x:
+    case 0n L{w} _:
+      L{U32.add(w, v)}
+    case 0n E{} _:
+      L{v}
+    case 0n other _:
+      other
+    case 1n++e N{g, a, b, c, f} D0{}:
+      N{g, put(e, a, dig(p), U32.shrn(p, 2n), v), b, c, f}
+    case 1n++e N{g, a, b, c, f} D1{}:
+      N{g, a, put(e, b, dig(p), U32.shrn(p, 2n), v), c, f}
+    case 1n++e N{g, a, b, c, f} D2{}:
+      N{g, a, b, put(e, c, dig(p), U32.shrn(p, 2n), v), f}
+    case 1n++e N{g, a, b, c, f} D3{}:
+      N{g, a, b, c, put(e, f, dig(p), U32.shrn(p, 2n), v)}
+    case 1n++e other D0{}:
+      N{7, put(e, E{}, dig(p), U32.shrn(p, 2n), v), E{}, E{}, E{}}
+    case 1n++e other D1{}:
+      N{7, E{}, put(e, E{}, dig(p), U32.shrn(p, 2n), v), E{}, E{}}
+    case 1n++e other D2{}:
+      N{7, E{}, E{}, put(e, E{}, dig(p), U32.shrn(p, 2n), v), E{}}
+    case 1n++e other D3{}:
+      N{7, E{}, E{}, E{}, put(e, E{}, dig(p), U32.shrn(p, 2n), v)}
+
+def up(t: T, +p: U32, v: U32) -> T:
+  put(4n, t, dig(p), U32.shrn(p, 2n), v)
+
+def at(+t: T, +p: U32) -> U32:
+  get(4n, t, dig(p), U32.shrn(p, 2n))
+
+# leaves plus tags
+def sum(+t: T) -> U32:
+  match t:
+    case E{}:
+      0
+    case L{v}:
+      v
+    case N{g, a, b, c, f}:
+      U32.add(g, U32.add(U32.add(sum(a), sum(b)), U32.add(sum(c), sum(f))))
+
+# the leaves on paths 0..i-1, read by get and by odd
+def reads(i: Nat, +t: T, acc: U32) -> U32:
+  match i:
+    case 0n:
+      acc
+    case 1n++j:
+      +p = U32.from_nat(j)
+      reads(j, t, U32.add(acc, U32.add(at(t, p), odd(4n, t, dig(p), U32.shrn(p, 2n)))))
+
+def many(i: Nat, t: T, acc: U32) -> U32 & T:
+  match i:
+    case 0n:
+      (acc, t)
+    case 1n++j:
+      +t2 = up(t, U32.mul(U32.from_nat(i), 37), U32.from_nat(i))
+      many(j, t2, U32.add(acc, U32.and(sum(t2), 255)))
+
+def fst(r: U32 & T) -> U32:
+  (a, t) = r
+  a
+
+def main() -> String:
+  +t0 = full(4n, 0)
+  +t1 = up(t0, 7, 100)
+  +t2 = up(t1, 7, 1000)
+  +t3 = up(t0, 255, 5)
+  +t4 = up(L{3}, 6, 9)
+  U32.show(sum(t0)) ++ "," ++ U32.show(sum(t1)) ++ "," ++ U32.show(sum(t2)) ++ "," ++ U32.show(sum(t3)) ++ "," ++ U32.show(U32.add(sum(t4), reads(40n, t2, 0))) ++ "," ++ U32.show(U32.add(at(t4, 6), reads(40n, t3, 0))) ++ "," ++ U32.show(fst(many(300n, up(E{}, 1, 1), 0)))
+
+#|"3130,3230,4230,3135,28845,26617,39503"
