+// Digit select
+// ============
+
+// A match on a digit (an enum of fieldless constructors) whose arm i takes
+// field off + i of a node matched above and differs from arm 0 in nothing
+// else: arm i is arm 0 with fields off and off + i swapped, as variables
+// and as slots of each node of that constructor it builds (sel_same). Arm
+// 0 then serves every digit x: it reads field off + x (sel_bind), builds
+// with slots off and off + x swapped (perm_at), and its continuations save
+// x (emit_fork). A trie's walk takes no indirect jump on the digit, and a
+// rebuild returns to one continuation. An arm that could make a closure or
+// a fork is left alone (sel_plain): neither would carry x.
+
+function sel_find(sc: Scope, ctrs: [Name, HTerm][], lay: Lay) {
+  const ks = Object.keys(lay.arms ?? {});
+  const n = ks.length;
+  if (n < 3 || ctrs.length !== n || sc.perm !== null || str_pack() === false
+    || ctrs.some(([k]) => !ks.includes(k) || lay.arms![k].length > 0)) {
+    return null;
+  }
+  const arm = (i: number) => ctrs.find(([k]) => ks.indexOf(k) === i)![1];
+  const h = arm(0);
+  const reads = new Map<string, { k: Name; ps: Of<"Var">[] }>();
+  for (const [p, b] of sc.uses) {
+    const s = b.val.ws.length === 1 ? sc.src.get(b.val.ws[0]) : undefined;
+    if (s !== undefined) {
+      const r = reads.get(s.pre) ?? { k: s.k, ps: [] };
+      r.ps[s.j] = p;
+      reads.set(s.pre, r);
+    }
+  }
+  for (const [pre, { k, ps }] of reads) {
+    if (lay_node(k).arms![k].some((l) => l.ks.length !== 1)) {
+      continue;
+    }
+    for (let off = 0; off + n <= ps.length; off += 1) {
+      const fs = [...Array(n)].map((_, i) => ps[off + i]);
+      if (fs.every((p) => p !== undefined) && sel_plain(h)
+        && fs.slice(1).every((p, i) =>
+          sel_same(h, arm(i + 1), fs[0].i, p.i, k, off, off + i + 1))) {
+        const sp = sc.fld.get(sc.uses.get(fs[0])!.val.ws[0])?.sp ?? null;
+        return { h, pre, ps: fs,
+          perm: { k, off, n, x: "", sp, def: sc.def } as Perm };
+      }
+    }
+  }
+  for (const k of sel_ctrs(h, n)) {
+    const m = lay_node(k).arms![k].length;
+    for (let off = 0; off + n <= m; off += 1) {
+      if (sel_plain(h) && [...Array(n - 1)].every((_, i) =>
+        sel_same(h, arm(i + 1), -1, -1, k, off, off + i + 1))) {
+        return { h, pre: "", ps: [] as Of<"Var">[],
+          perm: { k, off, n, x: "", sp: null, def: sc.def } as Perm };
+      }
+    }
+  }
+  return null;
+}
+
+// The constructors of at least n one-word fields an arm builds: a digit
+// select with no field to read (an arm that only builds, as a walk into an
+// empty trie does) permutes the slots of one of them.
+function sel_ctrs(h: HTerm, n: number): Name[] {
+  const ks = new Set<Name>();
+  const go = (t: HTerm): void => {
+    const s = Bend.term_force(t);
+    switch (s.$) {
+      case "App":
+        return (go(s.f), go(s.x));
+      case "Mat":
+        return (go(s.h), go(s.m));
+      case "Lam":
+      case "Let":
+        if (s.$ === "Let") {
+          s.v.forEach(go);
+        }
+        return go(term_open(s).b);
+      case "Ann":
+        return go(s.x);
+      case "Ctr": {
+        const arms = FL.book.ctrs[s.k] ? lay_node(s.k).arms![s.k] : [];
+        if (arms.length >= n && arms.every((l) => l.ks.length === 1)) {
+          ks.add(s.k);
+        }
+        return s.x.forEach(go);
+      }
+    }
+  };
+  go(h);
+  return [...ks];
+}
+
+// Field off + i (fields ps from pre) re-read for digit x: off + x for
+// field off, off for field off + x.
+function sel_bind(sc: Scope, ps: Of<"Var">[], pre: string): void {
+  const p = sc.perm!;
+  ps.forEach((v, i) => {
+    const b = sc.uses.get(v)!;
+    const w = b.val.ws[0];
+    const at = perm_at(sc, p.k, p.off + i);
+    const nw = emit_hold(sc, [`${pre}${at}]`], "f", b.val.lay.ks)[0];
+    const cp = <V>(m: Map<string, V>) => m.has(w) && m.set(nw, m.get(w)!);
+    cp(sc.brwl);
+    cp(sc.path);
+    cp(sc.orig);
+    cp(sc.fld);
+    const sl = sc.slot.get(w);
+    if (sl !== undefined) {
+      sc.slot.set(nw, { ...sl, at: sl.at.replace(/\d+$/, `(${at})`) });
+    }
+    sc.uses.set(v, { ...b, val: val_new([nw], b.val.lay) });
+  });
+}
+
+// Whether an arm makes no closure (no function in a value's place) and at
+// most one call to a def that is not flat, so no fork.
+function sel_plain(h: HTerm): boolean {
+  let calls = 0;
+  const val = (t: HTerm): boolean => {
+    const s = Bend.term_strip(t);
+    return s.$ !== "Lam" && s.$ !== "Mat" && go(t);
+  };
+  const go = (t: HTerm): boolean => {
+    const s = Bend.term_force(t);
+    switch (s.$) {
+      case "App":
+      case "Ref": {
+        const ck = term_spine(s);
+        calls += Number(ck.k !== null && (ck.k === CLO_APPLY || ck.b === true
+          || !flat_of(ck.k)));
+        const hd = Bend.term_strip(ck.t);
+        return calls <= 1 && (hd.$ !== "Mat" || go(hd))
+          && ck.all.every(val);
+      }
+      case "Mat":
+        return go(s.h) && go(s.m);
+      case "Lam":
+        return go(term_open(s).b);
+      case "Let":
+        return s.v.length === 1 && s.v.every(val) && go(term_open(s).b);
+      case "Ctr":
+        return s.x.every(val);
+      case "Ann":
+        return go(s.x);
+      default:
+        return true;
+    }
+  };
+  return go(h);
+}
+
+// Whether b is a with the variables (probes) p and q swapped and, in each
+// k node a builds, fields i and j swapped. Binders of a and b pair up.
+function sel_same(a: HTerm, b: HTerm, p: number, q: number, k: Name,
+  i: number, j: number): boolean {
+  const bound = new Map<number, number>();
+  const ds = ctr_tail(FL.book.ctrs[k]);
+  const go = (a: HTerm, b: HTerm): boolean => {
+    a = Bend.term_force(a);
+    b = Bend.term_force(b);
+    if (a.$ !== b.$) {
+      return false;
+    }
+    const y = b as typeof a;
+    switch (a.$) {
+      case "Var": {
+        const v = (y as Of<"Var">).i;
+        return bound.has(a.i) ? bound.get(a.i) === v
+          : (a.i === p ? q : a.i === q ? p : a.i) === v;
+      }
+      case "Ref":
+        return a.k === (y as Of<"Ref">).k && a.b === (y as Of<"Ref">).b;
+      case "Lit":
+        return a.k === (y as Of<"Lit">).k && a.v === (y as Of<"Lit">).v;
+      case "App":
+        return go(a.f, (y as Of<"App">).f) && go(a.x, (y as Of<"App">).x);
+      case "Ann":
+        return go(a.x, (y as Of<"Ann">).x) && go(a.T, (y as Of<"Ann">).T);
+      case "Ctr": {
+        const c = y as Of<"Ctr">;
+        const lv = a.x.map((_, n) => n).filter((n) =>
+          a.k !== k || !ds[n] || dom_live(ds[n]));
+        const sw = (n: number) => a.k !== k ? n
+          : n === lv[i] ? lv[j] : n === lv[j] ? lv[i] : n;
+        return a.k === c.k && a.x.length === c.x.length
+          && c.x.every((t, n) => go(a.x[sw(n)], t));
+      }
+      case "Mat": {
+        const m = y as Of<"Mat">;
+        return a.k === m.k && go(a.h, m.h) && go(a.m, m.m);
+      }
+      case "Lam":
+      case "Let": {
+        const oa = term_open(a);
+        const ob = term_open(y as typeof a);
+        if (a.$ === "Let" && (a.v.length !== (y as Of<"Let">).v.length
+          || !a.v.every((t, n) => go(t, (y as Of<"Let">).v[n])))) {
+          return false;
+        }
+        oa.ps.forEach((v, n) => bound.set(v.i, ob.ps[n].i));
+        return go(oa.b, ob.b);
+      }
+      case "All": {
+        const v = probe(a.k);
+        const z = y as Of<"All">;
+        return a.q.$ === z.q.$ && go(a.A, z.A) && go(a.B(v), z.B(v));
+      }
+      case "ADT": {
+        const z = y as Of<"ADT">;
+        return a.k === z.k && a.x.length === z.x.length
+          && a.x.every((t, n) => go(t, z.x[n]));
+      }
+      case "Typ":
+        return go(a.g, (y as Of<"Typ">).g);
+      case "Qua":
+        return a.q.$ === (y as Of<"Qua">).q.$;
+      case "Hol":
+        return a.k === (y as Of<"Hol">).k;
+      case "Qnt":
+      case "Rfl":
+      case "Efq":
+        return true;
+      default:
+        return false;
+    }
+  };
+  return go(a, b);
+}
