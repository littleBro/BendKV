diff --git a/tests/base/value_reads.bend b/tests/base/value_reads.bend
new file mode 100644
index 0000000..e2818b3
--- /dev/null
+++ b/tests/base/value_reads.bend
@@ -0,0 +1,28 @@
+# String.take of a String's whole length is the String: on the C lane a
+# String in the term word (up to six bytes) gives back the word itself,
+# and a longer one a copy. Mem.prefetch of Strings of one chunk, of 7,
+# 100 and 300 bytes, owned and shared, hints the lines of their bytes and
+# is k. Each check is "1" when the copy equals the String, then its first
+# two chars. Expect the same on every lane.
+import Base
+
+def whole(+s: String) -> String:
+  String.take(s, String.length(s))
+
+def check(+s: String) -> String:
+  +w = whole(s)
+  Bool.pick(String, String.eq(w, s), "1", "0") ++ String.take(w, 2n)
+
+def main() -> String:
+  +s = "x0123456789" ++ String.repeat("y", 300n)
+  +a = String.slice(s, 1n, 0n)
+  +b = String.slice(s, 1n, 3n)
+  +c = String.slice(s, 1n, 6n)
+  +d = String.slice(s, 1n, 7n)
+  +e = String.slice(s, 1n, 100n)
+  +f = String.slice(s, 1n, 300n)
+  +g = f
+  +k = Mem.prefetch(String, e, Mem.prefetch(String, f, Mem.prefetch(String, g, Mem.prefetch(String, d, 7))))
+  check(a) ++ "," ++ check(b) ++ "," ++ check(c) ++ "," ++ check(d) ++ "," ++ check(e) ++ "," ++ check(f) ++ "," ++ U32.show(k) ++ "," ++ Nat.show(String.length(whole(g)))
+
+#|"1,101,101,101,101,101,7,300"
