+  __atomic_store_n(&W->tail, t + 1, __ATOMIC_SEQ_CST);
+  if (__atomic_load_n(&W->sleep, __ATOMIC_SEQ_CST)) {
+    pthread_mutex_lock(&W->lock);
+    pthread_cond_signal(&W->bell);
+    pthread_mutex_unlock(&W->lock);
