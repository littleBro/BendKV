+static void io_post(int fd, char* buf, u64 len) {
+  IoWriter* W = io_me->post;
+  if (W == NULL) {
+    pthread_t tid;
+    W = io_mem(calloc(1, sizeof(IoWriter)));
+    pthread_mutex_init(&W->lock, NULL);
+    pthread_cond_init(&W->bell, NULL);
