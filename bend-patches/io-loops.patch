+// TCP
+// ===
+
+// The bytes go to this loop's writer thread (io_post), which sends them in
+// order; the socket comes back at once. A Char past 255 sends nothing.
+Term tcp_post_run(Env e, Term* f, IoWork* w) {
+  u64   room = str_len(e.mem, f[1]) + 1;
+  char* buf  = io_mem(malloc(room));
+  u64   len  = 0;
+  if (io_cbuf_in(e, f[1], &len, IO_RAW, &buf, &room) == NULL) {
+    free(buf);
+  } else {
+    io_post((int)io_hand_v(f[0]), buf, len);
+  }
+  return f[0];
+}
+
+static void __attribute__((constructor)) tcp_post_use(void) {
+  io_eff(CID(TCP.post), tcp_post_run);
+}
diff --git a/bend2/effs/tcp_post.js b/bend2/effs/tcp_post.js
new file mode 100644
index 0000000..2707647
--- /dev/null
+++ b/bend2/effs/tcp_post.js
@@ -0,0 +1,35 @@
+// TCP
+// ===
+
+// One loop here, and no writer: the bytes go out as TCP.send_raw sends them,
+// and the socket comes back once they have. A Char past 255 sends nothing.
+function tcp_post(socket, data, k) {
+  const b = new Uint8Array(data.length);
+  for (let i = 0; i < data.length; i += 1) {
+    const c = data.charCodeAt(i);
+    if (c > 255) {
+      return socket;
+    }
+    b[i] = c;
+  }
+  const sys = io_sys();
+  const again = sys.mac ? 35 : 11;
+  const go = (at) => {
+    while (at < b.length) {
+      const part = b.subarray(at);
+      const n = Number(sys.send(socket, sys.ptr(part), part.length, 0));
+      if (n < 0) {
+        if (sys.errno() === again) {
+          io_park_on(socket, true, k, () => go(at));
+          return undefined;
+        }
+        return socket;
+      }
+      at += n;
+    }
+    return socket;
+  };
+  return go(0);
+}
+
+io_eff(CID(TCP.post), tcp_post);
