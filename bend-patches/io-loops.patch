+static void* io_writer_run(void* arg) {
+  IoWriter* W = arg;
+  for (;;) {
+    u32 h = W->head;
+    if (h != __atomic_load_n(&W->tail, __ATOMIC_ACQUIRE)) {
+      io_post_do(&W->ring[h % IO_POSTS]);
+      __atomic_store_n(&W->head, h + 1, __ATOMIC_RELEASE);
+      continue;
