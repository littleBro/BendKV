+    }
+    pthread_mutex_lock(&W->lock);
+    __atomic_store_n(&W->sleep, 1, __ATOMIC_SEQ_CST);
+    while (__atomic_load_n(&W->tail, __ATOMIC_SEQ_CST) == h) {
+      pthread_cond_wait(&W->bell, &W->lock);
+    }
+    __atomic_store_n(&W->sleep, 0, __ATOMIC_SEQ_CST);
+    pthread_mutex_unlock(&W->lock);
