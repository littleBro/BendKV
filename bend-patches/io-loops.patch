+
+static void io_post_do(IoPost* p) {
+  if (p->buf == NULL) {
+    close(p->fd);
+    return;
+  }
+  u64 at = 0;
+  while (at < p->len) {
+    ssize_t n = send(p->fd, p->buf + at, p->len - at, MSG_NOSIGNAL);
+    if (n > 0) {
+      at += (u64)n;
+    } else if (n < 0 && errno == EAGAIN) {
+      struct pollfd q = { p->fd, POLLOUT, 0 };
+      poll(&q, 1, 100);
+    } else if (!(n < 0 && errno == EINTR)) {
+      break;
+    }
+  }
+  free(p->buf);
