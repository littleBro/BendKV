+    u64  until = io_tick() + 50000;
+    bool more  = false;
+    for (u32 n = 1; !more; n += 1) {
+      more = __atomic_load_n(&W->tail, __ATOMIC_ACQUIRE) != h;
+      if (!more && (n & 31) == 0 && io_tick() >= until) {
+        break;
