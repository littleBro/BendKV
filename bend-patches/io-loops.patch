diff --git a/tests/io/chan_send_all.bend b/tests/io/chan_send_all.bend
new file mode 100644
index 0000000..97d8f77
--- /dev/null
+++ b/tests/io/chan_send_all.bend
@@ -0,0 +1,138 @@
+# io (io_chan_send_all): Chan.send_all puts several values on their
+# channels at once, without waiting. Two values go past a room of one
+# and a third onto a channel with no room, and come out in order (1 2
+# 3). A receiver parked before the send takes its value at once (7). A
+# closed channel drops its value. Last, two computations on loops 1 and
+# 2 each send 100 pairs, one value on x and one on y at a time: the
+# values come out of x and y in the same order (same).
+import Base
+
+law got:
+  for m: Maybe<&1, U32>
+  U32
+
+def got(m):
+  match m:
+    case None{}:
+      0
+    case Some{value}:
+      value
+
+law show:
+  for +c: Chan(U32)
+  IO(Unit)
+
+def show(c):
+  do IO<Unit>:
+    m : Maybe<&1, U32> <- Chan.recv(U32, c)
+    IO.print(U32.show(got(m)))
+
+law pairs:
+  for n: Nat
+  for +x: Chan(U32)
+  for +y: Chan(U32)
+  for +k: U32
+  for +done: Chan(U32)
+  IO(Unit)
+
+def pairs(n, x, y, k, done):
+  match n:
+    case 0n:
+      do IO<Unit>:
+        Bool <- Chan.send(U32, done, k)
+        return Unit{}
+    case 1n+p:
+      do IO<Unit>:
+        Unit <- Chan.send_all(U32, [(x, k), (y, k)])
+        pairs(p, x, y, k, done)
+
+law drain:
+  for n: Nat
+  for +c: Chan(U32)
+  for acc: List<&2, U32>
+  IO(List<&2, U32>)
+
+def drain(n, c, acc):
+  match n:
+    case 0n:
+      IO.pure(List<&2, U32>, acc)
+    case 1n+p:
+      do IO<List<&2, U32>>:
+        m : Maybe<&1, U32> <- Chan.recv(U32, c)
+        drain(p, c, got(m) <> acc)
+
+law same:
+  for xs: List<&2, U32>
+  for ys: List<&2, U32>
+  Bool
+
+def same(xs, ys):
+  match xs ys:
+    case Nil{} Nil{}:
+      True{}
+    case Con{a, as} Con{b, bs}:
+      Bool.and(U32.is_eq(a, b), same(as, bs))
+    case _ _:
+      False{}
+
+law verdict:
+  for b: Bool
+  String
+
+def verdict(b):
+  match b:
+    case True{}:
+      "same"
+    case False{}:
+      "differ"
+
+law main.go:
+  for +a: Chan(U32)
+  for +b: Chan(U32)
+  for +c: Chan(U32)
+  for +d: Chan(U32)
+  for +x: Chan(U32)
+  for +y: Chan(U32)
+  for +done: Chan(U32)
+  IO(U32)
+
+def main.go(a, b, c, d, x, y, done):
+  do IO<U32>:
+    Unit <- Chan.send_all(U32, [(a, 1), (a, 2), (b, 3)])
+    Unit <- show(a)
+    Unit <- show(a)
+    Unit <- show(b)
+    Unit <- IO.spawn(Unit, show(c))
+    Unit <- IO.sleep(20)
+    Unit <- Chan.send_all(U32, [(c, 7)])
+    Unit <- Chan.close(U32, d)
+    Unit <- Chan.send_all(U32, [(d, 9)])
+    Unit <- IO.sleep(20)
+    Unit <- IO.spawn_on(Unit, 1, pairs(100n, x, y, 1, done))
+    Unit <- IO.spawn_on(Unit, 2, pairs(100n, x, y, 2, done))
+    Maybe<&1, U32> <- Chan.recv(U32, done)
+    Maybe<&1, U32> <- Chan.recv(U32, done)
+    xs : List<&2, U32> <- drain(200n, x, Nil{})
+    ys : List<&2, U32> <- drain(200n, y, Nil{})
+    Unit <- IO.print(verdict(same(xs, ys)))
+    return 0
+
+law main:
+  IO(U32)
+
+def main():
+  do IO<U32>:
+    a : Chan(U32) <- Chan.new(U32, 1)
+    b : Chan(U32) <- Chan.new(U32, 0)
+    c : Chan(U32) <- Chan.new(U32, 0)
+    d : Chan(U32) <- Chan.new(U32, 1)
+    x : Chan(U32) <- Chan.new(U32, 4)
+    y : Chan(U32) <- Chan.new(U32, 4)
+    done : Chan(U32) <- Chan.new(U32, 2)
+    main.go(a, b, c, d, x, y, done)
+
+#|1
+#|2
+#|3
+#|7
+#|same
diff --git a/tests/io/spawn_on_loops.bend b/tests/io/spawn_on_loops.bend
new file mode 100644
index 0000000..1e028a7
--- /dev/null
+++ b/tests/io/spawn_on_loops.bend
@@ -0,0 +1,135 @@
+# io (io_spawn_on_loops): computations on several event loops talk
+# over channels. Three workers on loops 1, 2 and 3 each send k * 10
+# into one channel; main sums what it receives (60). An echo on loop 2
+# answers each of main's 100 values with its successor, so each round
+# wakes a waiter on the other loop (5050). A relay on loop 3 spawns its
+# sender back on loop 0 (7). Last, a waiter on loop 1 prints late once
+# main closes its channel: the process ends with that loop's last
+# computation, after main has answered.
+import Base
+
+law work:
+  for +c: Chan(U32)
+  for k: U32
+  IO(Unit)
+
+def work(c, k):
+  do IO<Unit>:
+    Bool <- Chan.send(U32, c, (k * 10 : U32))
+    return Unit{}
+
+law echo.got:
+  for +b: Chan(U32)
+  for rest: IO(Unit)
+  for m: Maybe<&1, U32>
+  IO(Unit)
+
+def echo.got(b, rest, m):
+  match m:
+    case None{}:
+      IO.pure(Unit, Unit{})
+    case Some{value}:
+      do IO<Unit>:
+        Bool <- Chan.send(U32, b, (value + 1 : U32))
+        rest
+
+law echo:
+  for +a: Chan(U32)
+  for +b: Chan(U32)
+  for n: Nat
+  IO(Unit)
+
+def echo(a, b, n):
+  match n:
+    case 0n:
+      IO.pure(Unit, Unit{})
+    case 1n+p:
+      rest = echo(a, b, p)
+      IO.bind(Maybe<&1, U32>, Unit, Chan.recv(U32, a), echo.got(b, rest))
+
+law got:
+  for m: Maybe<&1, U32>
+  U32
+
+def got(m):
+  match m:
+    case None{}:
+      0
+    case Some{value}:
+      value
+
+law drive:
+  for n: Nat
+  for +a: Chan(U32)
+  for +b: Chan(U32)
+  for +i: U32
+  for acc: U32
+  IO(U32)
+
+def drive(n, a, b, i, acc):
+  match n:
+    case 0n:
+      IO.pure(U32, acc)
+    case 1n+p:
+      do IO<U32>:
+        Bool <- Chan.send(U32, a, i)
+        r : Maybe<&1, U32> <- Chan.recv(U32, b)
+        drive(p, a, b, (i + 1 : U32), (acc + got(r) : U32))
+
+law relay:
+  for +d: Chan(U32)
+  IO(Unit)
+
+def relay(d):
+  IO.spawn_on(Unit, 0, work(d, 0))
+
+law late:
+  for +z: Chan(U32)
+  IO(Unit)
+
+def late(z):
+  do IO<Unit>:
+    Maybe<&1, U32> <- Chan.recv(U32, z)
+    IO.print("late")
+
+law main.go:
+  for +c: Chan(U32)
+  for +a: Chan(U32)
+  for +b: Chan(U32)
+  for +z: Chan(U32)
+  IO(U32)
+
+def main.go(c, a, b, z):
+  do IO<U32>:
+    Unit <- IO.spawn_on(Unit, 1, work(c, 1))
+    Unit <- IO.spawn_on(Unit, 2, work(c, 2))
+    Unit <- IO.spawn_on(Unit, 3, work(c, 3))
+    x : Maybe<&1, U32> <- Chan.recv(U32, c)
+    y : Maybe<&1, U32> <- Chan.recv(U32, c)
+    w : Maybe<&1, U32> <- Chan.recv(U32, c)
+    Unit <- IO.print(U32.show((got(x) + got(y) + got(w) : U32)))
+    Unit <- IO.spawn_on(Unit, 2, echo(a, b, 100n))
+    s : U32 <- drive(100n, a, b, 0, 0)
+    Unit <- IO.print(U32.show(s))
+    Unit <- IO.spawn_on(Unit, 3, relay(c))
+    v : Maybe<&1, U32> <- Chan.recv(U32, c)
+    Unit <- IO.print(U32.show((got(v) + 7 : U32)))
+    Unit <- IO.spawn_on(Unit, 1, late(z))
+    Unit <- Chan.close(U32, z)
+    return 0
+
+law main:
+  IO(U32)
+
+def main():
+  do IO<U32>:
+    c : Chan(U32) <- Chan.new(U32, 4)
+    a : Chan(U32) <- Chan.new(U32, 0)
+    b : Chan(U32) <- Chan.new(U32, 0)
+    z : Chan(U32) <- Chan.new(U32, 0)
+    main.go(c, a, b, z)
+
+#|60
+#|5050
+#|7
+#|late
diff --git a/tests/io/tcp_post.bend b/tests/io/tcp_post.bend
new file mode 100644
index 0000000..86f18ed
--- /dev/null
+++ b/tests/io/tcp_post.bend
@@ -0,0 +1,100 @@
+# io (io_tcp_post): TCP.post hands bytes over and returns the socket at
+# once; they go out in order, and a Socket.close right after the posts
+# closes the socket only once they are sent. The client posts "hel", "lo",
+# a String with a Char past 255 (nothing goes out for it) and 5000 bytes,
+# then closes; the server reads to the end and finds all 5005 bytes, in
+# order (their first five and their sum).
+import Base
+
+def count(s: String, n: U32, k: U32) -> U32 & U32:
+  match s:
+    case "":
+      (n, k)
+    case SCon{c, rest}:
+      count(rest, (n + 1 : U32), (k + Char.to_u32(c) : U32))
+
+def bulk.go(n: Nat, acc: String) -> String:
+  match n:
+    case 0n:
+      acc
+    case 1n++p:
+      bulk.go(p, SCon{Char.from_u32(U32.mod(U32.from_nat(p), 256)), acc})
+
+def count_on(xs: String, nk: U32 & U32) -> U32 & U32:
+  (n, k) = nk
+  count(xs, n, k)
+
+def done(nk: U32 & U32, head: String, s: Socket) -> IO(Unit):
+  (n, k) = nk
+  do IO<Unit>:
+    Unit <- IO.print(String.take(head, 5n) ++ " " ++ U32.show(n) ++ " " ++ U32.show(k))
+    Socket.close(s)
+
+def step(eof: Bool, s: Socket, xs: String, nk: U32 & U32, head: String, next: Socket -> U32 & U32 -> String -> IO(Unit)) -> IO(Unit):
+  match eof:
+    case True{}:
+      done(nk, head, s)
+    case False{}:
+      +x = xs
+      next(s, count_on(x, nk), head ++ x)
+
+def got(m: Socket & Result<&1, &1, U32 & String, String>, nk: U32 & U32, head: String, next: Socket -> U32 & U32 -> String -> IO(Unit)) -> IO(Unit):
+  (s, r) = m
+  match r:
+    case Done{+xs}:
+      step(String.is_empty(xs), s, xs, nk, head, next)
+    case Fail{e}:
+      done(nk, head, s)
+
+def drain(fuel: Nat, s: Socket, nk: U32 & U32, head: String) -> IO(Unit):
+  match fuel:
+    case 0n:
+      done(nk, head, s)
+    case 1n+f:
+      do IO<Unit>:
+        m : Socket & Result<&1, &1, U32 & String, String> <- TCP.recv_raw(s, 4096)
+        got(m, nk, head, s2 => nk2 => h2 => drain(f, s2, nk2, h2))
+
+def talk(c: Socket, p: Listener & Result<&1, &1, U32 & String, Socket>) -> IO(Unit):
+  (l2, ar) = p
+  do IO<Unit>:
+    a  : Socket <- IO.pass(Socket, ar)
+    c1 : Socket <- TCP.post(c, "hel")
+    c2 : Socket <- TCP.post(c1, "lo")
+    c3 : Socket <- TCP.post(c2, "a\u{100}")
+    c4 : Socket <- TCP.post(c3, bulk.go(5000n, ""))
+    Unit <- Socket.close(c4)
+    Unit <- drain(64n, a, (0, 0), "")
+    Listener.close(l2)
+
+def main_go(b: Listener & U32) -> IO(Unit):
+  (l, port) = b
+  do IO<Unit>:
+    c : Socket <- IO.try(Socket, TCP.connect("127.0.0.1", port))
+    p : Listener & Result<&1, &1, U32 & String, Socket> <- TCP.accept(l)
+    talk(c, p)
+
+def tcp_retry(port: U32, r: Result<&1, &1, U32 & String, Listener>, rest: IO(Listener & U32)) ->
+  IO(Listener & U32):
+  match r:
+    case Done{l}:
+      IO.pure(Listener & U32, (l, port))
+    case Fail{e}:
+      rest
+
+def tcp_listen_any(tries: Nat, +port: U32) -> IO(Listener & U32):
+  match tries:
+    case 0n:
+      IO.die(Listener & U32, 1, "no free tcp port")
+    case 1n+t:
+      rest = tcp_listen_any(t, (port + 1 : U32))
+      do IO<Listener & U32>:
+        r : Result<&1, &1, U32 & String, Listener> <- TCP.listen("127.0.0.1", port)
+        tcp_retry(port, r, rest)
+
+def main() -> IO(Unit):
+  do IO<Unit>:
+    b : Listener & U32 <- tcp_listen_any(32n, 19987)
+    main_go(b)
+
+#|hello 5005 629872
