new file mode 100644
index 0000000..08d1aac
--- /dev/null
+++ b/bend2/effs/io_notify.c
@@ -0,0 +1,46 @@
+// IO
+// ==
+
+#include <stddef.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#endif
+
+// msg as one datagram to the unix socket NOTIFY_SOCKET names, as sd_notify
+// sends one: a path, or a name in the abstract namespace after an '@'
+// (its first byte NUL, the address as long as the name). True when the
+// datagram went out whole; False when NOTIFY_SOCKET is not set, is neither
+// a path nor an abstract name, does not fit sun_path, or the send failed.
+Term io_notify_run(Env e, Term* f, IoWork* w) {
+  const char* to  = getenv("NOTIFY_SOCKET");
+  size_t      n   = to == NULL ? 0 : strlen(to);
+  u64         len;
+  char*       msg = io_cstr(e, f[0], &len);
+  bool        ok  = false;
+  struct sockaddr_un at;
+  if (n > 1 && n < sizeof(at.sun_path) && (to[0] == '/' || to[0] == '@')) {
+    memset(&at, 0, sizeof(at));
+    at.sun_family = AF_UNIX;
+    memcpy(at.sun_path, to, n);
+    if (to[0] == '@') {
+      at.sun_path[0] = 0;
+    }
+    int fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+    if (fd >= 0) {
+      fcntl(fd, F_SETFD, FD_CLOEXEC);
+      socklen_t size = (socklen_t)(offsetof(struct sockaddr_un, sun_path) + n);
+      ok = sendto(fd, msg, len, MSG_NOSIGNAL, (struct sockaddr*)&at, size)
+        == (ssize_t)len;
+      close(fd);
+    }
+  }
+  free(msg);
+  return term_pak(ok ? CID(True) : CID(False), 0);
+}
+
+static void __attribute__((constructor)) io_notify_use(void) {
+  io_eff(CID(IO.notify), io_notify_run);
+}
diff --git a/bend2/effs/io_notify.js b/bend2/effs/io_notify.js
new file mode 100644
index 0000000..40db156
--- /dev/null
+++ b/bend2/effs/io_notify.js
@@ -0,0 +1,34 @@
+// IO
+// ==
+
+// msg as one datagram to the unix socket NOTIFY_SOCKET names, as
+// io_notify.c sends it; True when it went out whole
+function io_notify(msg) {
+  const to = process.env.NOTIFY_SOCKET ?? "";
+  const sys = io_sys();
+  const room = sys.mac ? 104 : 108;
+  const path = new TextEncoder().encode(to);
+  if (path.length < 2 || path.length >= room
+    || (to[0] !== "/" && to[0] !== "@")) {
+    return false;
+  }
+  const at = new Uint8Array(2 + room);
+  at.set(sys.mac ? [2 + room, 1] : [1, 0]);
+  at.set(path, 2);
+  if (to[0] === "@") {
+    at[2] = 0;
+  }
+  const fd = sys.socket(1, 2, 0);
+  if (fd < 0) {
+    return false;
+  }
+  const bytes = new TextEncoder().encode(msg);
+  const room0 = new Uint8Array(Math.max(1, bytes.length));
+  room0.set(bytes);
+  const sent = sys.sendto(fd, sys.ptr(room0), bytes.length, 0, sys.ptr(at),
+    2 + path.length);
+  sys.close(fd);
+  return Number(sent) === bytes.length;
+}
+
+io_eff(CID(IO.notify), io_notify);
