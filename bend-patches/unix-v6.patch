+# io (io_notify): IO.notify sends nothing and answers False where the
+# environment names no NOTIFY_SOCKET, as a program not started by systemd
+# finds it (the test runner sets none). Its send to a socket is tested by
+# its users: BendKV's start, against a socket of the test's own.
+import Base
+
+def flag(b: Bool) -> String:
+  match b:
+    case True{}:
+      "T"
+    case False{}:
+      "F"
+
+law main:
+  IO(U32)
+
+def main():
+  do IO<U32>:
+    k : Bool <- IO.notify("READY=1\n")
+    p : Unit <- IO.print(flag(k))
+    return 0
+
+#|F
