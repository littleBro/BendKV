+  (void)w;
+  u64 len;
+  char* name = io_cstr(e, f[0], &len);
+  struct sockaddr_un at;
+  int fd = -1;
+  if (len > 1 && len < sizeof(at.sun_path)) {
+    memset(&at, 0, sizeof(at));
+    at.sun_family = AF_UNIX;
+    memcpy(at.sun_path, name, len);
+    if (name[0] == '@') {
+      at.sun_path[0] = 0;
+    } else {
+      unlink(name);
+    }
+    fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+    socklen_t size = (socklen_t)(offsetof(struct sockaddr_un, sun_path) + len);
+    if (fd >= 0 && bind(fd, (struct sockaddr*)&at, size) == 0) {
+      setenv("NOTIFY_SOCKET", name, 1);
+    } else if (fd >= 0) {
+      close(fd);
+      fd = -1;
+    }
+  }
+  free(name);
+  return (Term)(u32)fd;
+}
+
+// The datagram fd got (at most 255 bytes, waiting 1 s), then the socket
+// closed and NOTIFY_SOCKET unset; "" for none.
+static Term notify_got_run(Env e, Term* f, IoWork* w) {
+  (void)w;
+  int fd = (int)(u32)f[0];
+  char buf[256];
+  struct timeval tv = { 1, 0 };
+  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+  ssize_t n = recv(fd, buf, sizeof(buf) - 1, 0);
+  close(fd);
+  unsetenv("NOTIFY_SOCKET");
+  buf[n > 0 ? n : 0] = 0;
+  return io_str(e, buf, strlen(buf));
+}
+
+static void __attribute__((constructor)) notify_peer_use(void) {
+  io_eff(CID(notify.peer), notify_peer_run);
+  io_eff(CID(notify.got), notify_got_run);
+}
diff --git a/tests/io/tcp_listen_unix.bend b/tests/io/tcp_listen_unix.bend
new file mode 100644
index 0000000..fed9037
--- /dev/null
+++ b/tests/io/tcp_listen_unix.bend
@@ -0,0 +1,67 @@
+# io (io_tcp_listen_unix): TCP.listen_unix binds a Listener on a unix
+# socket's path; a second one on the path an earlier listener left fails
+# (EADDRINUSE, 98) until the path is removed (File.unlink), as Redis's
+# initServer removes it before it listens; a path with nothing in it, or
+# too long for sun_path, fails (EINVAL, 22). The path is the process's
+# own, removed at the end. TCP.listen takes an IPv6 address: a malformed
+# one fails (EINVAL), and "::1" (port 0: any free one) listens where the
+# host has IPv6 and fails with EAFNOSUPPORT (97) where it has none, which
+# prints "v6" either way.
+import Base
+
+def shown(r: Result<&1, &1, U32 & String, Listener>) -> IO(Unit):
+  match r:
+    case Done{l}:
+      do IO<Unit>:
+        x : Unit <- Listener.close(l)
+        IO.print("ok")
+    case Fail{e}:
+      (c, m) = e
+      IO.print("fail " ++ U32.show(c))
+
+def v6(r: Result<&1, &1, U32 & String, Listener>) -> IO(Unit):
+  match r:
+    case Done{l}:
+      do IO<Unit>:
+        x : Unit <- Listener.close(l)
+        IO.print("v6")
+    case Fail{e}:
+      (+c, m) = e
+      IO.print(Bool.pick(String, U32.is_eq(c, 97), "v6", "v6 fail " ++ U32.show(c)))
+
+def run(+p: String) -> IO(Unit):
+  do IO<Unit>:
+    u0 : Result<&1, &1, U32 & String, Unit> <- File.unlink(p)
+    a : Result<&1, &1, U32 & String, Listener> <- TCP.listen_unix(p, 448)
+    x : Unit <- shown(a)
+    b : Result<&1, &1, U32 & String, Listener> <- TCP.listen_unix(p, 0)
+    y : Unit <- shown(b)
+    u1 : Result<&1, &1, U32 & String, Unit> <- File.unlink(p)
+    b2 : Result<&1, &1, U32 & String, Listener> <- TCP.listen_unix(p, 0)
+    y2 : Unit <- shown(b2)
+    u2 : Result<&1, &1, U32 & String, Unit> <- File.unlink(p)
+    c : Result<&1, &1, U32 & String, Listener> <- TCP.listen_unix("", 0)
+    z : Unit <- shown(c)
+    d : Result<&1, &1, U32 & String, Listener> <- TCP.listen_unix("/tmp/" ++ String.repeat("x", 200n), 0)
+    w : Unit <- shown(d)
+    f : Result<&1, &1, U32 & String, Listener> <- TCP.listen("::1::", 0)
+    v : Unit <- shown(f)
+    g : Result<&1, &1, U32 & String, Listener> <- TCP.listen("::1", 0)
+    v6(g)
+
+law main:
+  IO(U32)
+
+def main():
+  do IO<U32>:
+    pid : U32 <- IO.pid()
+    x : Unit <- run("/tmp/bend-io-listen-unix-" ++ U32.show(pid) ++ ".sock")
+    return 0
+
+#|ok
+#|fail 98
+#|ok
+#|fail 22
+#|fail 22
+#|fail 22
+#|v6
