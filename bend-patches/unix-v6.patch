+# lane can bind a datagram socket of a unix name): a path, then an
+# abstract name after an '@' (its first byte NUL, the address as long as
+# the name), each read whole; with NOTIFY_SOCKET unset again, IO.notify
+# answers False.
+import Base
+
+def notify.peer(name: String) -> IO(U32):
+  import "./io_notify_peer.c"
+
+def notify.got(fd: U32) -> IO(String):
+  import "./io_notify_peer.c"
+
+def flag(b: Bool) -> String:
+  match b:
+    case True{}:
+      "T"
+    case False{}:
+      "F"
+
+def one(+name: String) -> IO(Unit):
+  do IO<Unit>:
+    fd : U32 <- notify.peer(name)
+    k : Bool <- IO.notify("READY=1\nSTATUS=up\n")
+    got : String <- notify.got(fd)
+    IO.print(flag(k) ++ " " ++ flag(String.eq(got, "READY=1\nSTATUS=up\n")))
+
+def main() -> IO(Unit):
+  do IO<Unit>:
+    +pid : U32 <- IO.pid()
+    a : Unit <- one("/tmp/bend-io-notify-" ++ U32.show(pid) ++ ".sock")
+    u : Result<&1, &1, U32 & String, Unit> <- File.unlink("/tmp/bend-io-notify-" ++ U32.show(pid) ++ ".sock")
+    b : Unit <- one("@bend-io-notify-" ++ U32.show(pid))
+    k : Bool <- IO.notify("READY=1\n")
+    IO.print(flag(k))
+
+#|T T
+#|T T
+#|F
