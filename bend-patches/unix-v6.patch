+# io (io_tcp_listen_unix): TCP.listen_unix binds a Listener on a unix
+# socket's path, and binds it again over the socket an earlier listener
+# left there (it removes the path first, as Redis's initServer does); a
+# path with nothing in it, or too long for sun_path, fails (EINVAL, 22).
+# TCP.listen takes an IPv6 address: a malformed one fails (EINVAL), and
+# "::1" listens where the host has IPv6 and fails with EAFNOSUPPORT (97)
+# where it has none, which prints "v6" either way.
+import Base
+
+def shown(r: Result<&1, &1, U32 & String, Listener>) -> IO(Unit):
+  match r:
+    case Done{l}:
+      do IO<Unit>:
+        x : Unit <- Listener.close(l)
+        IO.print("ok")
+    case Fail{e}:
+      (c, m) = e
+      IO.print("fail " ++ U32.show(c))
+
+def v6(r: Result<&1, &1, U32 & String, Listener>) -> IO(Unit):
+  match r:
+    case Done{l}:
+      do IO<Unit>:
+        x : Unit <- Listener.close(l)
+        IO.print("v6")
+    case Fail{e}:
+      (+c, m) = e
+      IO.print(Bool.pick(String, U32.is_eq(c, 97), "v6", "v6 fail " ++ U32.show(c)))
+
+law main:
+  IO(U32)
+
+def main():
+  do IO<U32>:
+    a : Result<&1, &1, U32 & String, Listener> <- TCP.listen_unix("/tmp/bend-io-listen-unix.sock", 448)
+    x : Unit <- shown(a)
+    b : Result<&1, &1, U32 & String, Listener> <- TCP.listen_unix("/tmp/bend-io-listen-unix.sock", 0)
+    y : Unit <- shown(b)
+    c : Result<&1, &1, U32 & String, Listener> <- TCP.listen_unix("", 0)
+    z : Unit <- shown(c)
+    d : Result<&1, &1, U32 & String, Listener> <- TCP.listen_unix("/tmp/" ++ String.repeat("x", 200n), 0)
+    w : Unit <- shown(d)
+    f : Result<&1, &1, U32 & String, Listener> <- TCP.listen("::1::", 19302)
+    v : Unit <- shown(f)
+    g : Result<&1, &1, U32 & String, Listener> <- TCP.listen("::1", 19303)
+    u : Unit <- v6(g)
+    return 0
+
+#|ok
+#|ok
+#|fail 22
