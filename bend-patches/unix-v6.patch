diff --git a/bend2/effs/tcp_listen_unix.c b/bend2/effs/tcp_listen_unix.c
new file mode 100644
index 0000000..d0c8294
--- /dev/null
+++ b/bend2/effs/tcp_listen_unix.c
@@ -0,0 +1,54 @@
+// TCP
+// ===
+
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+// A listener on a unix socket at path, as Redis's anetUnixServer makes one:
+// the path removed first (a socket a run before left there, as initServer
+// unlinks it, whether that works or not), bound, given perm's mode when
+// perm is not 0 (whether chmod works or not, as Redis does), listening, and
+// non-blocking. A path that holds a NUL, or does not fit sun_path, is
+// refused (EINVAL). TCP.accept takes its connections as a TCP listener's.
+Term tcp_listen_unix_run(Env e, Term* f, IoWork* w) {
+  struct sockaddr_un at;
+  u64 len;
+  char* path = io_cstr(e, f[0], &len);
+  if (io_nul(path, len) || len == 0 || len >= sizeof(at.sun_path)) {
+    free(path);
+    return io_fail(e, EINVAL, NULL);
+  }
+  memset(&at, 0, sizeof(at));
+  at.sun_family = AF_UNIX;
+  memcpy(at.sun_path, path, len);
+  unlink(path);
+  int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (fd < 0) {
+    uint32_t code = (uint32_t)errno;
+    free(path);
+    return io_fail(e, code, NULL);
+  }
+  if (bind(fd, (struct sockaddr*)&at, sizeof(at)) < 0) {
+    uint32_t code = (uint32_t)errno;
+    close(fd);
+    free(path);
+    return io_fail(e, code, NULL);
+  }
+  if ((u32)f[1] != 0) {
+    (void)chmod(path, (mode_t)(u32)f[1]);
+  }
+  free(path);
+  if (listen(fd, 512) < 0
+    || fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK) < 0) {
+    uint32_t code = (uint32_t)errno;
+    close(fd);
+    return io_fail(e, code, NULL);
+  }
+  io_fd_new(fd);
+  return io_done(e, io_hand(fd));
+}
+
+static void __attribute__((constructor)) tcp_listen_unix_use(void) {
+  io_eff(CID(TCP.listen_unix), tcp_listen_unix_run);
+}
diff --git a/bend2/effs/tcp_listen_unix.js b/bend2/effs/tcp_listen_unix.js
new file mode 100644
index 0000000..97aa8e4
--- /dev/null
+++ b/bend2/effs/tcp_listen_unix.js
@@ -0,0 +1,41 @@
+// TCP
+// ===
+
+// A listener on a unix socket at path, as tcp_listen_unix.c makes one: the
+// path removed first, bound, given perm's mode when perm is not 0, then
+// listening and non-blocking; a path with a NUL, or too long, is refused
+function tcp_listen_unix(path, perm) {
+  const sys = io_sys();
+  const name = new TextEncoder().encode(path);
+  const room = sys.mac ? 104 : 108;
+  if (name.length === 0 || name.length >= room || name.includes(0)) {
+    return io_fail(22);
+  }
+  const at = new Uint8Array(2 + room);
+  at.set(sys.mac ? [2 + room, 1] : [1, 0]);
+  at.set(name, 2);
+  const cpath = new Uint8Array(name.length + 1);
+  cpath.set(name);
+  sys.unlink(sys.ptr(cpath));
+  const fd = sys.socket(1, 1, 0);
+  if (fd < 0) {
+    return io_fail(sys.errno());
+  }
+  if (sys.bind(fd, sys.ptr(at), at.length) < 0) {
+    const code = sys.errno();
+    sys.close(fd);
+    return io_fail(code);
+  }
+  if ((Number(perm) >>> 0) !== 0) {
+    sys.chmod(sys.ptr(cpath), Number(perm) >>> 0);
+  }
+  if (sys.listen(fd, 512) < 0
+    || sys.fcntl(fd, 4, sys.fcntl(fd, 3, 0) | (sys.mac ? 4 : 0x800)) < 0) {
+    const code = sys.errno();
+    sys.close(fd);
+    return io_fail(code);
+  }
+  return io_done(fd);
+}
+
+io_eff(CID(TCP.listen_unix), tcp_listen_unix);
